pipeline {
  agent any
  environment {
    VERSION = "1.0.0.${BUILD_NUMBER}"
    SOLUTION = "src/PhuThuongStickyRice.sln"
    CONFIGURATION = "Release"
  }
  stages {
    stage('Restore') {
      steps {
        sh 'dotnet --info'
        sh "dotnet restore ${SOLUTION}"
      }
    }
    stage('Build') {
      steps {
        echo "BUILD_NUMBER: ${BUILD_NUMBER}"
        echo "VERSION: ${VERSION}"
        sh "dotnet build ${SOLUTION} --configuration ${CONFIGURATION} --no-restore -p:Version=${VERSION}"
      }
    }
    stage('Test') {
      steps {
        sh "dotnet test ${SOLUTION} --configuration ${CONFIGURATION} --no-build"
      }
    }
  }
}
