@inject NavigationManager NavigationManager
@inject PhuThuongStickyRice.Web.Components.Shop.Services.CartState CartState
@inject PhuThuongStickyRice.Web.Components.Admin.Services.Wave4Service Wave4Service
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@implements IDisposable

@using PhuThuongStickyRice.Web.Shared

@if (_maintenanceChecked && _maintenanceMode && !_isExemptRoute)
{
    @* Item 111/176: friendly maintenance page for public routes, in the
       landing template style (Lora, #763434, cream). *@
    <style>
        .maint-screen {
            min-height: 100vh;
            background: #F5E9D4;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            font-family: 'Nunito', Arial, sans-serif;
        }
        .maint-card {
            background: #fffdf8;
            border: 3px double #9C682C;
            border-radius: 28px 8px 28px 8px;
            max-width: 560px;
            width: 100%;
            text-align: center;
            padding: 3rem 2rem;
            box-shadow: 0 10px 40px rgba(111, 7, 7, 0.12);
        }
        .maint-icon { font-size: 4.5rem; }
        .maint-title {
            font-family: 'Lora', Georgia, serif;
            color: #763434;
            font-size: 2rem;
            margin: 1rem 0 0.5rem;
        }
        .maint-msg { color: #6b5b4a; font-size: 1.1rem; }
        .maint-btn {
            background: #6F0707;
            color: #fff;
            border: none;
            border-radius: 999px;
            padding: 0.7rem 2.2rem;
            font-weight: 700;
            cursor: pointer;
        }
        .maint-btn:disabled { opacity: 0.6; cursor: default; }
    </style>
    <div class="maint-screen">
        <div class="maint-card">
            <div class="maint-icon" aria-hidden="true">🚧</div>
            <h1 class="maint-title">Quán đang bảo trì</h1>
            <p class="maint-msg">@(_maintenanceMessage ?? "Cửa hàng đang bảo trì, vui lòng quay lại sau nhé.")</p>
            <div class="mt-4">
                <button class="maint-btn" @onclick="RecheckAsync" disabled="@_rechecking">
                    @(_rechecking ? "Đang kiểm tra..." : "Thử lại")
                </button>
            </div>
            <div class="mt-3">
                <a href="/login" style="color:#9C682C;">Đăng nhập quản trị</a>
            </div>
        </div>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(PhuThuongStickyRice.Web.Components.Core.Components.ConfirmDialog).Assembly}">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        Bạn cần đăng nhập quản trị. <a href="/login?returnUrl=@(Uri.EscapeDataString(NavigationManager.Uri))">Đăng nhập</a>
                    </NotAuthorized>
                </AuthorizeRouteView>
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(MainLayout)">
                    <div class="text-center py-5">
                        <div style="font-size: 4rem;" aria-hidden="true">🍚</div>
                        <h2 class="mt-3" style="font-family: 'Cormorant Garamond', Georgia, serif; color: #7a1b2e;">
                            Không tìm thấy trang
                        </h2>
                        <p class="text-muted">Địa chỉ bạn vừa mở không tồn tại hoặc đã bị di chuyển.</p>
                        <div class="mt-4">
                            <a class="btn btn-outline-secondary mr-2" href="/">Về trang chủ</a>
                            <a class="btn btn-primary" style="background-color: #7a1b2e; border-color: #7a1b2e;" href="/shop">Đặt món ngay</a>
                        </div>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    private bool _maintenanceChecked;
    private bool _maintenanceMode;
    private string _maintenanceMessage;
    private bool _isExemptRoute;
    private bool _rechecking;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateExemptRoute();
        await CheckStatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore the persisted cart from localStorage now that
            // JS interop is available.
            await CartState.InitializeAsync();
            // GL4: bật chống ảnh gãy toàn site (chỉ 1 lần).
            try { await JSRuntime.InvokeVoidAsync("ptInitImageGuard"); } catch { }
        }
    }

    private void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateExemptRoute();
        StateHasChanged();
    }

    /// <summary>
    /// Item 111/176: /login, /admin/*, /bep and /cho (in-shop waiting
    /// screen) keep working during maintenance.
    /// </summary>
    private void UpdateExemptRoute()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        _isExemptRoute = path == "/login"
            || path == "/cho"
            || path.StartsWith("/admin")
            || path.StartsWith("/bep");
    }

    private async Task CheckStatusAsync()
    {
        try
        {
            var status = await Wave4Service.GetSystemStatusAsync();
            _maintenanceMode = status.MaintenanceMode;
            _maintenanceMessage = status.MaintenanceMessage;
        }
        catch (Exception)
        {
            // API unreachable — fail open (never block the shop on a status check).
            _maintenanceMode = false;
        }
        finally
        {
            _maintenanceChecked = true;
        }
    }

    private async Task RecheckAsync()
    {
        _rechecking = true;
        try
        {
            await CheckStatusAsync();
        }
        finally
        {
            _rechecking = false;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
