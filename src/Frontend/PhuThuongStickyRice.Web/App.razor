@inject NavigationManager NavigationManager
@inject PhuThuongStickyRice.Web.Components.Shop.Services.CartState CartState
@inject PhuThuongStickyRice.Web.Components.Admin.Services.Wave4Service Wave4Service
@implements IDisposable

@using PhuThuongStickyRice.Web.Shared

@if (_maintenanceChecked && _maintenanceMode && !_isExemptRoute)
{
    @* Item 111: friendly maintenance page for public routes. *@
    <div class="container text-center py-5">
        <div style="font-size: 4rem;" aria-hidden="true">🚧</div>
        <h2 class="mt-3" style="font-family: 'Cormorant Garamond', Georgia, serif; color: #7a1b2e;">
            Xôi Phú Thượng đang bảo trì
        </h2>
        <p class="text-muted">@(_maintenanceMessage ?? "Cửa hàng đang bảo trì, vui lòng quay lại sau.")</p>
        <div class="mt-4">
            <button class="btn btn-outline-secondary" @onclick="RecheckAsync" disabled="@_rechecking">
                @(_rechecking ? "Đang kiểm tra..." : "Thử lại")
            </button>
            <a class="btn btn-link" href="/login">Đăng nhập quản trị</a>
        </div>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(PhuThuongStickyRice.Web.Components.Core.Components.ConfirmDialog).Assembly}">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        Bạn cần đăng nhập quản trị. <a href="/login?returnUrl=@(Uri.EscapeDataString(NavigationManager.Uri))">Đăng nhập</a>
                    </NotAuthorized>
                </AuthorizeRouteView>
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(MainLayout)">
                    <div class="text-center py-5">
                        <div style="font-size: 4rem;" aria-hidden="true">🍚</div>
                        <h2 class="mt-3" style="font-family: 'Cormorant Garamond', Georgia, serif; color: #7a1b2e;">
                            Không tìm thấy trang
                        </h2>
                        <p class="text-muted">Địa chỉ bạn vừa mở không tồn tại hoặc đã bị di chuyển.</p>
                        <div class="mt-4">
                            <a class="btn btn-outline-secondary mr-2" href="/">Về trang chủ</a>
                            <a class="btn btn-primary" style="background-color: #7a1b2e; border-color: #7a1b2e;" href="/shop">Đặt món ngay</a>
                        </div>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    private bool _maintenanceChecked;
    private bool _maintenanceMode;
    private string _maintenanceMessage;
    private bool _isExemptRoute;
    private bool _rechecking;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateExemptRoute();
        await CheckStatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore the persisted cart from localStorage now that
            // JS interop is available.
            await CartState.InitializeAsync();
        }
    }

    private void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateExemptRoute();
        StateHasChanged();
    }

    /// <summary>
    /// Item 111: /login, /admin/* and /bep keep working during maintenance.
    /// </summary>
    private void UpdateExemptRoute()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        _isExemptRoute = path == "/login"
            || path.StartsWith("/admin")
            || path.StartsWith("/bep");
    }

    private async Task CheckStatusAsync()
    {
        try
        {
            var status = await Wave4Service.GetSystemStatusAsync();
            _maintenanceMode = status.MaintenanceMode;
            _maintenanceMessage = status.MaintenanceMessage;
        }
        catch (Exception)
        {
            // API unreachable — fail open (never block the shop on a status check).
            _maintenanceMode = false;
        }
        finally
        {
            _maintenanceChecked = true;
        }
    }

    private async Task RecheckAsync()
    {
        _rechecking = true;
        try
        {
            await CheckStatusAsync();
        }
        finally
        {
            _rechecking = false;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
