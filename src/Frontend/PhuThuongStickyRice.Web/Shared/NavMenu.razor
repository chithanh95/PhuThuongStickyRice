@using Microsoft.AspNetCore.Components.Authorization
@using PhuThuongStickyRice.Web.Services
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject JwtTokenManager TokenManager
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject CartState CartState
@inject PhuThuongStickyRice.Web.Components.Shop.Services.ShopI18n ShopI18n
@implements IDisposable

<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand" href="">Xôi Phú Thượng</a>
    <button class="btn btn-sm btn-outline-light ml-auto mr-2" @onclick="ToggleLang" title="English / Tiếng Việt">
        @(_langLabel)
    </button>
    <button class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <ul class="nav flex-column">
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="shop">
                <span class="oi oi-cart" aria-hidden="true"></span> Đặt xôi
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="cart">
                <span class="oi oi-basket" aria-hidden="true"></span> Giỏ hàng
                @if (CartState.TotalQuantity > 0)
                {
                    <span class="badge badge-pill badge-danger ml-1">@CartState.TotalQuantity</span>
                }
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="track-order">
                <span class="oi oi-magnifying-glass" aria-hidden="true"></span> Tra cứu đơn hàng
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="dat-tiec">
                <span class="oi oi-people" aria-hidden="true"></span> Đặt tiệc số lượng lớn
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="binh-chon-mon-moi">
                <span class="oi oi-thumb-up" aria-hidden="true"></span> Bình chọn món mới
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="dat-dinh-ky">
                <span class="oi oi-calendar" aria-hidden="true"></span> Đặt xôi định kỳ
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="faq">
                <span class="oi oi-question-mark" aria-hidden="true"></span> Hỏi đáp
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="ho-tro">
                <span class="oi oi-envelope-closed" aria-hidden="true"></span> Hỗ trợ
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="nhom">
                <span class="oi oi-people" aria-hidden="true"></span> Đặt món nhóm
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="anh-khach-hang">
                <span class="oi oi-camera-slr" aria-hidden="true"></span> Ảnh khách hàng
            </NavLink>
        </li>
        <AuthorizeView>
            <Authorized>
        @* Item 126: cashier sees orders / POS / customers. *@
        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Cashier"))
        {
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        <span class="oi oi-clipboard" aria-hidden="true"></span> Đơn hàng
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="customers">
                        <span class="oi oi-people" aria-hidden="true"></span> Khách hàng
                    </NavLink>
                </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="ban-hang">
                <span class="oi oi-cart" aria-hidden="true"></span> 🧾 Bán hàng tại quầy
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="ket-ca">
                <span class="oi oi-dollar" aria-hidden="true"></span> 💵 Kết ca
            </NavLink>
        </li>
        }
        @* Item 126: kitchen display for Kitchen or Admin. *@
        @if (context.User.IsInRole("Kitchen") || context.User.IsInRole("Admin"))
        {
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="bep">
                        <span class="oi oi-fire" aria-hidden="true"></span> Màn hình bếp
                    </NavLink>
                </li>
        }
        @* Item 126: everything else is Admin-only (incl. lợi nhuận / thanh toán / tính năng). *@
        @if (context.User.IsInRole("Admin"))
        {
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="products">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Sản phẩm
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/landing">
                        <span class="oi oi-wrench" aria-hidden="true"></span> Cài đặt landing
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/shop-settings">
                        <span class="oi oi-dollar" aria-hidden="true"></span> Cài đặt bán hàng
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/discounts">
                        <span class="oi oi-tags" aria-hidden="true"></span> Mã giảm giá
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/toppings">
                        <span class="oi oi-plus" aria-hidden="true"></span> Topping ăn kèm
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/combos">
                        <span class="oi oi-layers" aria-hidden="true"></span> Combo gia đình
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/danh-gia">
                        <span class="oi oi-heart" aria-hidden="true"></span> Đánh giá
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/bai-viet">
                        <span class="oi oi-document" aria-hidden="true"></span> Bài viết
                    </NavLink>
                </li>
<li class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/khuyen-mai">
                        <span class="oi oi-bolt" aria-hidden="true"></span> Giờ vàng
                    </NavLink>
                </li>
<li class="nav-item px-3">
            <NavLink class="nav-link" href="admin/doi-soat-momo">
                <span class="oi oi-loop-circular" aria-hidden="true"></span> 🔁 Đối soát MoMo
            </NavLink>
        </li>
        <li class="nav-item px-3">
            @* Wave 6c (item 31): daily payment-channel reconciliation. *@
            <NavLink class="nav-link" href="admin/doi-soat-ngay">
                <span class="oi oi-bar-chart" aria-hidden="true"></span> 📊 Đối soát ngày
            </NavLink>
        </li>
        }
        @if (!(context.User.IsInRole("Admin") || context.User.IsInRole("Cashier") || context.User.IsInRole("Kitchen")))
        {
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="tai-khoan">
                    <span class="oi oi-person" aria-hidden="true"></span> Tài khoản của tôi
                </NavLink>
            </li>
        }
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="doi-mat-khau">
                <span class="oi oi-key" aria-hidden="true"></span> Đổi mật khẩu
            </NavLink>
        </li>
        <li class="nav-item px-3">
                    <a class="nav-link" @onclick="SignOut" href="javascript:void(0)">
                        <span class="oi oi-account-logout" aria-hidden="true"></span> Đăng xuất
                    </a>
                </li>
    </Authorized>
            <NotAuthorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="dang-nhap">
                        <span class="oi oi-person" aria-hidden="true"></span> Đăng nhập / Đăng ký
                    </NavLink>
                </li>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="oi oi-account-login" aria-hidden="true"></span> Đăng nhập quản trị
                    </NavLink>
                </li>
            </NotAuthorized>
        </AuthorizeView>
    </ul>
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private string _langLabel = "EN";

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += OnCartChanged;
        ShopI18n.OnChange += OnLangChanged;
        await ShopI18n.InitializeAsync();
        UpdateLangLabel();
    }

    private void OnLangChanged() => InvokeAsync(() =>
    {
        UpdateLangLabel();
        StateHasChanged();
    });

    private void UpdateLangLabel()
    {
        _langLabel = ShopI18n.IsEnglish ? "VI" : "EN";
    }

    private async Task ToggleLang()
    {
        await ShopI18n.SetLangAsync(ShopI18n.IsEnglish ? "vi" : "en");
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task SignOut()
    {
        await TokenManager.ClearTokenAsync();
        AuthStateProvider.NotifyUserLogout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        CartState.OnChange -= OnCartChanged;
        ShopI18n.OnChange -= OnLangChanged;
    }
}
