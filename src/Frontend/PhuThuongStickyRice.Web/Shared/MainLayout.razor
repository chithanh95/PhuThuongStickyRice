@inherits LayoutComponentBase
@using PhuThuongStickyRice.Web.Components.Core.Components
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Landing.Services
@using System.Linq
@using System.Threading.Tasks
@inject ShopSettingsService ShopSettingsService
@inject LandingService LandingService
@inject IJSRuntime JSRuntime

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <div class="top-row px-4">
        <AuthorizeView>
            <Authorized>
                <span>Xin chào, @context.User.Identity.Name</span>
            </Authorized>
        </AuthorizeView>
        <a href="/shop">Đặt xôi</a>
        @* Theme toggle — icon = trạng thái hiện tại (tối→🌙, sáng→☀️). *@
        <button class="theme-toggle" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">@(_isDark ? "🌙" : "☀️")</button>
    </div>

    <div class="content px-4">
        @Body
    </div>

    <ShopFooter />
</div>

<Toast />

@* Wave 6b (item 27): floating hotline/Zalo buttons, mobile-only. *@
@if (!string.IsNullOrEmpty(_callNumber) || !string.IsNullOrEmpty(_zaloNumber))
{
    <div class="floating-contact">
        @if (!string.IsNullOrEmpty(_callNumber))
        {
            <a class="fc-btn fc-call" href="tel:@_callNumber" title="Gọi ngay cho quán">📞<span>Gọi ngay</span></a>
        }
        @if (!string.IsNullOrEmpty(_zaloNumber))
        {
            <a class="fc-btn fc-zalo" href="https://zalo.me/@_zaloNumber" target="_blank" rel="noopener" title="Chat Zalo với quán">💬<span>Zalo</span></a>
        }
    </div>
}

<style>
    .floating-contact {
        display: none;
    }
    .theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.1rem;
        line-height: 1;
        margin-left: 0.75rem;
        padding: 0.25rem;
    }
    @@media (max-width: 767.98px) {
        .floating-contact {
            display: flex;
            position: fixed;
            right: 10px;
            bottom: 84px;
            z-index: 1080;
            flex-direction: column;
            gap: 8px;
        }

        .fc-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            /* Vùng bấm tối thiểu 44px cho người lớn tuổi — pill nổi vẫn gọn */
            min-height: 44px;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,.25);
        }

        .fc-btn:hover {
            color: #fff;
            text-decoration: none;
            opacity: .92;
        }

        .fc-call {
            background: #34c38f; /* UIUX-1019 A3: xanh lá Lexa (trước #28a745 Bootstrap) */
        }

        .fc-zalo {
            background: #0068ff;
        }
    }
</style>

@code {
    private string _callNumber;
    private string _zaloNumber;
    private bool _isDark;

    private async Task ToggleTheme()
    {
        // 2026-10-19: toggle NHỊ PHÂN Sáng↔Tối — 1 lần bấm = đổi giao diện ngay.
        // (ptToggleTheme xoay vòng 3 chế độ sáng→tối→tự động→sáng, ban đêm "tự động"
        // = tối nên cứ 2 lần bấm mới thấy đổi 1 lần trong khi nút hiển thị nhị phân.)
        try
        {
            _isDark = !_isDark;
            await JSRuntime.InvokeVoidAsync("ptSetTheme", "pt-theme", _isDark ? "dark" : "light");
        }
        // Bỏ qua lỗi JS interop có chủ ý: hàm JS đã tự đổi class CSS nên giao diện luôn đúng;
        // _isDark chỉ dùng để vẽ icon nút bấm — nếu JS chưa sẵn sàng (prerender) thì giữ nguyên, không báo user.
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        // Dark mode: sync toggle icon with saved theme (JS already applied the class pre-paint).
        // Đồng bộ icon theme với lựa chọn đã lưu trong localStorage: khi prerender hoặc JS lỗi,
        // giữ giá trị mặc định là an toàn nên bỏ qua lỗi, không chặn render trang.
        // Dùng ptIsDark để icon đúng cả khi giá trị cũ đang là 'auto' theo giờ.
        try { _isDark = await JSRuntime.InvokeAsync<bool>("ptIsDark", "pt-theme"); } catch { }

        string hotline = null;
        string zalo = null;
        try
        {
            var settings = await ShopSettingsService.GetPublicAsync();
            hotline = NormalizePhone(settings?.Hotline);
            zalo = NormalizePhone(settings?.ZaloPhone);
        }
        catch
        {
            // Fail-soft: the buttons simply stay hidden.
        }

        string fallback = null;
        if (string.IsNullOrEmpty(hotline) || string.IsNullOrEmpty(zalo))
        {
            try
            {
                var landing = await LandingService.GetContentAsync();
                fallback = NormalizePhone(landing?.ContactPhone);
            }
            catch
            {
            }
        }

        _callNumber = string.IsNullOrEmpty(hotline) ? fallback : hotline;
        _zaloNumber = string.IsNullOrEmpty(zalo) ? fallback : zalo;
    }

    private static string NormalizePhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return null;
        }

        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return digits.Length >= 9 ? digits : null;
    }
}
