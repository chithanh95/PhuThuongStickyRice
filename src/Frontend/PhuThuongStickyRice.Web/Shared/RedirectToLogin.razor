@inject NavigationManager Navigation

@* Chuyển thẳng về trang đăng nhập (kèm returnUrl) thay vì bắt người dùng
   bấm link — dùng trong App.razor cho khối NotAuthorized khi CHƯA đăng
   nhập (kể cả trường hợp token đã hết hạn bị provider coi là anonymous). *@

@code {
    /// <summary>
    /// Ngay khi render là điều hướng về /dang-nhap với returnUrl là trang
    /// hiện tại — đăng nhập xong DangNhap tự đưa người dùng quay lại đây.
    /// </summary>
    protected override void OnInitialized()
    {
        var returnUrl = Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"/dang-nhap?returnUrl={returnUrl}");
    }
}
