@page "/login"
@layout PhuThuongStickyRice.Web.Components.Core.Layouts.EmptyLayout
@using System.Linq
@using System.Net.Http.Json
@using PhuThuongStickyRice.Web.ConfigurationOptions
@using PhuThuongStickyRice.Web.Services
@inject IHttpClientFactory HttpClientFactory
@inject AppSettings AppSettings
@inject JwtTokenManager TokenManager
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject PhuThuongStickyRice.Web.Components.Admin.Services.PermissionService PermissionService

<h3>Đăng nhập quản trị</h3>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }
                <div class="form-group">
                    <label>Tên đăng nhập / Email</label>
                    <input class="form-control" @bind="_username" placeholder="admin@phuthuong.vn"
                           disabled="@_awaitingTwoFactor" />
                </div>
                <div class="form-group">
                    <label>Mật khẩu</label>
                    <input type="password" class="form-control" @bind="_password" placeholder="Mật khẩu"
                           disabled="@_awaitingTwoFactor" />
                </div>
                @if (_awaitingTwoFactor)
                {
                    <div class="alert alert-info">
                        <small>Mật khẩu đúng. Nhập mã 6 số từ ứng dụng Authenticator để hoàn tất đăng nhập.</small>
                    </div>
                    <div class="form-group">
                        <label>Mã xác thực 2 bước</label>
                        <input class="form-control" @bind="_twoFactorCode" maxlength="6" inputmode="numeric"
                               placeholder="123456" />
                    </div>
                }
                <button class="btn btn-primary btn-block" @onclick="LoginAsync" disabled="@_loggingIn">
                    @(_loggingIn ? "Đang đăng nhập..." : _awaitingTwoFactor ? "Xác nhận mã 2FA" : "Đăng nhập")
                </button>
                @if (_awaitingTwoFactor)
                {
                    <button class="btn btn-link btn-block mt-1" @onclick="BackToLogin">← Quay lại nhập mật khẩu</button>
                }
                @if (_showHint)
                {
                    <div class="alert alert-warning alert-dismissible mt-3 mb-0" role="alert">
                        <small>Tài khoản mặc định lần đầu: <strong>admin@phuthuong.vn</strong> / <strong>Admin@123</strong> — hãy đổi mật khẩu ngay sau khi đăng nhập lần đầu.</small>
                        <button type="button" class="close" aria-label="Ẩn" @onclick="DismissHint">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _username;
    private string _password;
    private string _error;
    private bool _loggingIn;
    private string _returnUrl;
    private bool _showHint = true;
    private const string HintDismissedKey = "phuthuong.login-hint.dismissed";

    // Item 98: 2FA step state; item 99: IP warning handoff to the dashboard.
    private bool _awaitingTwoFactor;
    private string _twoFactorToken;
    private string _twoFactorCode;
    private const string IpWarningKey = "phuthuong.last-login-ip-warning";

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = GetQueryValue(Navigation.Uri, "returnUrl");

        try
        {
            var dismissed = await JSRuntime.InvokeAsync<string>("localStorage.getItem", HintDismissedKey);
            _showHint = dismissed != "1";
        }
        catch (Exception)
        {
            _showHint = true;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(string.IsNullOrWhiteSpace(_returnUrl) ? DefaultLanding(authState) : _returnUrl);
        }
    }

    /// <summary>Customers land on the storefront; staff land on the dashboard.</summary>
    private static string DefaultLanding(Microsoft.AspNetCore.Components.Authorization.AuthenticationState authState)
    {
        var user = authState.User;
        if (user.IsInRole("Admin") || user.IsInRole("Cashier") || user.IsInRole("Kitchen"))
        {
            return "/dashboard";
        }

        return "/";
    }

    private async Task DismissHint()
    {
        _showHint = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", HintDismissedKey, "1");
        }
        catch (Exception)
        {
        }
    }

    private void BackToLogin()
    {
        _awaitingTwoFactor = false;
        _twoFactorToken = null;
        _twoFactorCode = null;
        _error = null;
    }

    private async Task LoginAsync()
    {
        _error = null;

        if (_awaitingTwoFactor)
        {
            await VerifyTwoFactorAsync();
            return;
        }

        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Vui lòng nhập tên đăng nhập và mật khẩu.";
            return;
        }

        _loggingIn = true;
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(AppSettings.ResourceServer.Endpoint.TrimEnd('/') + "/");
            var response = await client.PostAsJsonAsync("api/auth/login", new
            {
                UsernameOrEmail = _username.Trim(),
                Password = _password
            });

            if (!response.IsSuccessStatusCode)
            {
                // Item 100: the server returns 423 + a Vietnamese message when locked.
                _error = (int)response.StatusCode == 423
                    ? await response.Content.ReadAsStringAsync()
                    : response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                        ? "Tên đăng nhập hoặc mật khẩu không đúng."
                        : "Đăng nhập thất bại. Vui lòng thử lại.";
                return;
            }

            var login = await response.Content.ReadFromJsonAsync<LoginResponse>();

            // Item 98: password OK but 2FA is enabled — go to the code step.
            if (login.RequiresTwoFactor)
            {
                _twoFactorToken = login.TwoFactorToken;
                _awaitingTwoFactor = true;
                _error = null;
                return;
            }

            await FinishLoginAsync(login);
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _loggingIn = false;
        }
    }

    /// <summary>Item 98: verifies the 6-digit TOTP code to complete login.</summary>
    private async Task VerifyTwoFactorAsync()
    {
        if (string.IsNullOrWhiteSpace(_twoFactorCode))
        {
            _error = "Vui lòng nhập mã 6 số từ ứng dụng Authenticator.";
            return;
        }

        _loggingIn = true;
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(AppSettings.ResourceServer.Endpoint.TrimEnd('/') + "/");
            var response = await client.PostAsJsonAsync("api/auth/2fa/verify", new
            {
                TwoFactorToken = _twoFactorToken,
                Code = _twoFactorCode.Trim()
            });

            if (!response.IsSuccessStatusCode)
            {
                _error = (int)response.StatusCode == 423
                    ? await response.Content.ReadAsStringAsync()
                    : response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                        ? "Mã xác thực 2FA không đúng."
                        : "Đăng nhập thất bại. Vui lòng thử lại.";
                return;
            }

            var login = await response.Content.ReadFromJsonAsync<LoginResponse>();
            await FinishLoginAsync(login);
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _loggingIn = false;
        }
    }

    /// <summary>Stores the JWT and hands any new-IP warning to the dashboard.</summary>
    private async Task FinishLoginAsync(LoginResponse login)
    {
        await TokenManager.StoreTokenAsync(login.AccessToken, login.ExpiresAt);
        AuthStateProvider.NotifyUserAuthentication();
        // Item 155: drop any cached permissions from a previous session.
        PermissionService.ClearCache();
        var isStaff = login.Roles != null
            && login.Roles.Any(r => r == "Admin" || r == "Cashier" || r == "Kitchen");
        if (!isStaff && string.IsNullOrWhiteSpace(_returnUrl))
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Item 99: dashboard shows a warning banner for a never-seen IP.
        try
        {
            if (login.NewIpWarning && !string.IsNullOrWhiteSpace(login.NewIpAddress))
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", IpWarningKey, login.NewIpAddress);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", IpWarningKey);
            }
        }
        catch (Exception)
        {
        }

        Navigation.NavigateTo(string.IsNullOrWhiteSpace(_returnUrl) ? "/dashboard" : _returnUrl);
    }

    private static string GetQueryValue(string uri, string key)
    {
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return null;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            if (string.Equals(Uri.UnescapeDataString(pair.Substring(0, eq)), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
            }
        }

        return null;
    }

    private sealed class LoginResponse
    {
        public string AccessToken { get; set; }

        public DateTimeOffset ExpiresAt { get; set; }

        public string UserName { get; set; }

        public string Email { get; set; }

        public string[] Roles { get; set; }

        public bool RequiresTwoFactor { get; set; }

        public string TwoFactorToken { get; set; }

        public bool NewIpWarning { get; set; }

        public string NewIpAddress { get; set; }
    }
}
