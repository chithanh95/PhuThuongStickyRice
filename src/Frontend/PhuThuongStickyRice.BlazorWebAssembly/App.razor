@inject NavigationManager NavigationManager

@using PhuThuongStickyRice.BlazorWebAssembly.Shared

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(PhuThuongStickyRice.Blazor.Modules.Core.Components.ConfirmDialog).Assembly}">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    Bạn cần đăng nhập quản trị. <a href="/login?returnUrl=@(Uri.EscapeDataString(NavigationManager.Uri))">Đăng nhập</a>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

