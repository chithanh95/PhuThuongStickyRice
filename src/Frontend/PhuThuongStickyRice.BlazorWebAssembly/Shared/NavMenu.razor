@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private string _langLabel = "EN";

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += OnCartChanged;
        ShopI18n.OnChange += OnLangChanged;
        await ShopI18n.InitializeAsync();
        UpdateLangLabel();
    }

    private void OnLangChanged() => InvokeAsync(() =>
    {
        UpdateLangLabel();
        StateHasChanged();
    });

    private void UpdateLangLabel()
    {
        _langLabel = ShopI18n.IsEnglish ? "VI" : "EN";
    }

    private async Task ToggleLang()
    {
        await ShopI18n.SetLangAsync(ShopI18n.IsEnglish ? "vi" : "en");
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task SignOut()
    {
        await TokenManager.ClearTokenAsync();
        AuthStateProvider.NotifyUserLogout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        CartState.OnChange -= OnCartChanged;
        ShopI18n.OnChange -= OnLangChanged;
    }
}
