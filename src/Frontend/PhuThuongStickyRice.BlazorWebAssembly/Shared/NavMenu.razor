        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="faq">
                <span class="oi oi-question-mark" aria-hidden="true"></span> Hỏi đáp
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="ho-tro">
                <span class="oi oi-envelope-closed" aria-hidden="true"></span> Hỗ trợ
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="nhom">
                <span class="oi oi-people" aria-hidden="true"></span> Đặt món nhóm
            </NavLink>
        </li>
        <AuthorizeView>
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard
