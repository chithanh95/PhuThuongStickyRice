
@if (ShowDialog)
{
    @* A11y-1610: aria-modal + aria-labelledby (trỏ tới #titleLabel) để trình đọc
       màn hình biết đây là hộp thoại modal và đọc đúng tiêu đề.
       UIUX-1019 Agent4: @onkeydown để đóng dialog bằng phím Escape —
       người dùng bàn phím cần cách thoát chuẩn, không phải tab tới nút Đóng. *@
    <div class="modal fade show d-block" id="exampleModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="titleLabel" @onkeydown="HandleKeyDown">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="titleLabel">@Title</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Đóng" @onclick="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        @Message
                    </div>
                    <button type="submit" @onclick="@HandleValidSubmit" class="btn btn-primary" disabled="@_submitting">@YesText</button>
                    <button type="button" class="btn btn-outline-primary" @onclick="@Close">@NoText</button>

                </div>
            </div>
        </div>
    </div>
}