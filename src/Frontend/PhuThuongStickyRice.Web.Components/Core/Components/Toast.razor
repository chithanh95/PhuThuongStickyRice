@using PhuThuongStickyRice.Web.Components.Core.Services
@inject ToastService Toasts
@implements IDisposable

<div class="toast-container" aria-live="polite">
    @* UIUX-1020 Agent4 (a11y): toast trước đây luôn hiện icon check xanh lá
       dù tin nhắn là cảnh báo ("tạm ngưng nhận đơn", "tạm hết món") — người dùng
       nhìn icon tưởng thành công. Giờ icon theo loại toast; Warning dùng
       role="alert" để trình đọc màn hình thông báo ngay thay vì chờ lượt đọc. *@
    @foreach (var toast in _toasts)
    {
        <div class="toast show mb-2 toast-@toast.Kind.ToString().ToLower()" @key="toast.Id"
             role="@(toast.Kind == ToastKind.Warning ? "alert" : "status")">
            <div class="d-flex align-items-center">
                <i class="fa-solid @ToastIconClass(toast.Kind) mr-2" aria-hidden="true"></i>
                <div class="mr-3">
                    @toast.Message
                    @if (!string.IsNullOrWhiteSpace(toast.LinkText) && !string.IsNullOrWhiteSpace(toast.LinkUrl))
                    {
                        <a href="@toast.LinkUrl" class="ml-2"><strong>@toast.LinkText</strong></a>
                    }
                </div>
                <button type="button" class="ml-auto close" aria-label="Đóng" @onclick="() => Dismiss(toast.Id)">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new List<ToastMessage>();

    /// <summary>Thời gian toast tự ẩn sau khi hiện (giây).</summary>
    private static readonly TimeSpan AutoDismissDelay = TimeSpan.FromSeconds(3);

    // Bug-hunt 2026-10-19: guard dispose (cùng pattern HangCho.razor/Faq.razor) —
    // AutoDismissAsync chạy sau 3s, nếu user đã rời trang thì component đã dispose,
    // gọi Dismiss → InvokeAsync(StateHasChanged) trên renderer đã hủy.
    private bool _disposed;

    protected override void OnInitialized()
    {
        Toasts.OnShow += HandleShow;
    }

    private void HandleShow(ToastMessage toast)
    {
        _toasts.Add(toast);
        InvokeAsync(StateHasChanged);
        _ = AutoDismissAsync(toast.Id);
    }

    private async Task AutoDismissAsync(Guid id)
    {
        await Task.Delay(AutoDismissDelay);
        if (_disposed) return;
        Dismiss(id);
    }

    /// <summary>Icon theo loại toast — phân biệt bằng HÌNH DẠNG icon (không chỉ
    /// màu sắc) để người mù màu vẫn nhận biết: check = thành công, tam giác
    /// cảnh báo = lỗi/cảnh báo nghiệp vụ, chữ "i" = thông tin.</summary>
    private static string ToastIconClass(ToastKind kind) => kind switch
    {
        ToastKind.Warning => "fa-triangle-exclamation",
        ToastKind.Info => "fa-circle-info",
        _ => "fa-circle-check",
    };

    private void Dismiss(Guid id)
    {
        if (_toasts.RemoveAll(x => x.Id == id) > 0)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Toasts.OnShow -= HandleShow;
    }
}
