@* Component chọn ngôn ngữ dùng ảnh cờ (hiển thị được trên mọi thiết bị, kể cả Windows).
   Dùng chung cho landing + shop, mobile + PC. *@
@inject NavigationManager Navigation
@inject AppI18n AppI18n

<div class="lang-selector @(Compact ? "lang-compact" : "")">
    @* UIUX-1019 Agent4 (a11y): ảnh cờ chỉ mang tính trang trí — nút đã có
       aria-label, menu item đã có text tên ngôn ngữ, nên alt="" để trình đọc
       màn hình không đọc trùng ("Language / Ngôn ngữ, vi"). *@
    <button type="button" class="lang-btn" @ref="_toggleButton" @onclick="ToggleOpen" aria-label="Language / Ngôn ngữ"
            aria-haspopup="menu" aria-expanded="@_open" @onkeydown="HandleToggleKeyDown">
        <img src="@FlagUrl(AppI18n.CurrentLanguage)" alt="" class="lang-flag" aria-hidden="true" />
        <span class="lang-caret">▾</span>
    </button>
    @if (_open)
    {
        <div class="lang-menu" role="menu" @onkeydown="HandleMenuKeyDown">
            @foreach (var lang in Langs)
            {
                <button type="button" class="lang-item @(AppI18n.CurrentLanguage == lang.Code ? "active" : "")"
                        @onclick="() => SelectLang(lang.Code)" role="menuitem"
                        aria-current="@(AppI18n.CurrentLanguage == lang.Code ? "true" : null)">
                    <img src="@FlagUrl(lang.Code)" alt="" class="lang-flag" aria-hidden="true" />
                    <span class="lang-name">@lang.Name</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool Compact { get; set; }

    private bool _open;

    private record LangOption(string Code, string Flag, string Name);
    private static readonly LangOption[] Langs = new[]
    {
        new LangOption("vi", "vn", "Tiếng Việt"),
        new LangOption("en", "gb", "English"),
        new LangOption("zh", "cn", "中文"),
        new LangOption("ja", "jp", "日本語"),
    };

    private static string FlagUrl(string code)
    {
        var flag = Langs.FirstOrDefault(l => l.Code == code)?.Flag ?? "vn";
        return $"/images/flags/{flag}.png";
    }

    private void ToggleOpen() => _open = !_open;

    // UIUX-1020 Agent4 (a11y): role="menu" ngụ ý hành vi menu của ARIA APG —
    // người dùng bàn phím phải thoát được bằng Escape. Trước đây menu mở là
    // không có cách nào đóng bằng bàn phím (phải Tab ra ngoài từng item hoặc
    // click chuột). Escape đóng menu + trả focus về nút bật/tắt để vị trí đọc
    // không bị "lạc" giữa trang.
    private ElementReference _toggleButton;

    private async Task HandleMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
            await _toggleButton.FocusAsync();
        }
    }

    // Escape khi focus đang ở nút toggle cũng đóng menu (nếu đang mở) — đối
    // xứng với hành vi trong menu, tránh trường hợp mở menu rồi Shift+Tab quay
    // lại nút mà không đóng được.
    private Task HandleToggleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _open)
        {
            _open = false;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task SelectLang(string code)
    {
        _open = false;
        if (AppI18n.CurrentLanguage == code) return;
        await AppI18n.SetLanguageAsync(code);
        // Reload để áp dụng ngôn ngữ cho toàn trang.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
