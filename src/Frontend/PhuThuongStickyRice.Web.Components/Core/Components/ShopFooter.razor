@using PhuThuongStickyRice.Web.Components.Landing.Models
@using PhuThuongStickyRice.Web.Components.Landing.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject LandingService LandingService
@inject AppI18n AppI18n
@implements IDisposable

<footer class="sg-footer">
    <div class="sg-container">
        <div class="sg-footer-grid">
            <div class="sg-footer-col">
                <h3 class="sg-footer-brand">Xôi Phú Thượng</h3>
                <p class="sg-footer-about">@(string.IsNullOrWhiteSpace(_content?.FooterAboutText) ? "Gói xôi nóng hổi mỗi sáng từ làng nghề Phú Thượng — dẻo thơm, đúng vị Hà Nội." : _content.FooterAboutText)</p>
                @if (!string.IsNullOrWhiteSpace(_content?.ContactAddress))
                {
                    @* UIUX-1019 Agent4 (a11y): emoji bọc aria-hidden để trình đọc màn hình
                       không đọc tên emoji ("pushpin", "telephone"...). *@
                    <p class="sg-footer-line"><span aria-hidden="true">📍</span> @_content.ContactAddress</p>
                }
            </div>
            <div class="sg-footer-col">
                <h4 class="sg-footer-h">@AppI18n.T("footer.explore")</h4>
                <a href="/">@AppI18n.T("nav.about")</a>
                <a href="/shop">@AppI18n.T("nav.menu")</a>
                <a href="/dat-so-luong-lon">@AppI18n.T("nav.bulk_order")</a>
                <a href="/dat-tiec">@AppI18n.T("nav.party_order")</a>
                <a href="/nhuong-quyen">@AppI18n.T("nav.franchise")</a>
                <a href="/faq">@AppI18n.T("footer.faq")</a>
            </div>
            <div class="sg-footer-col">
                <h4 class="sg-footer-h">@AppI18n.T("footer.contact_us")</h4>
                @if (!string.IsNullOrWhiteSpace(_content?.ContactPhone))
                {
                    <a class="sg-footer-hotline" href="tel:@_content.ContactPhone"><span aria-hidden="true">📞</span> @_content.ContactPhone</a>
                }
                @if (!string.IsNullOrWhiteSpace(_content?.ContactEmail))
                {
                    @* UIUX-1019 Agent4 (polish): email thành link mailto để bấm được trên mobile. *@
                    <p class="sg-footer-line"><span aria-hidden="true">✉️</span> <a href="mailto:@_content.ContactEmail">@_content.ContactEmail</a></p>
                }
            </div>
        </div>
        <div class="sg-bottom-bar">@(string.IsNullOrWhiteSpace(_content?.FooterCopyrightText) ? "© 2026 Xôi Phú Thượng — Thổi hồn vào từng gói xôi" : _content.FooterCopyrightText)</div>
    </div>
</footer>

@code {
    private LandingContentModel _content;

    protected override async Task OnInitializedAsync()
    {
        AppI18n.OnChange -= OnLangChanged;
        AppI18n.OnChange += OnLangChanged;
        try
        {
            _content = await LandingService.GetContentAsync();
        }
        catch
        {
            // Fail-soft: footer renders without contact info.
        }
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AppI18n.OnChange -= OnLangChanged;
    }
}
