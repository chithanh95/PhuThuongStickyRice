@page "/error"
<PageTitle>Đã có lỗi xảy ra — Xôi Phú Thượng</PageTitle>

<div class="sg-error-wrap" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 48px 16px;">
    <div style="text-align: center; max-width: 520px;">
        <div style="font-size: 4rem; margin-bottom: 16px;">😞</div>
        <h1 style="font-family: Georgia, serif; color: #7a1b2e; margin-bottom: 12px;">Đã có lỗi xảy ra</h1>
        <p style="color: #4a2b1a; margin-bottom: 24px;">Xin lỗi, đã có sự cố. Vui lòng thử lại hoặc về trang chủ.</p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/" class="sg-btn sg-btn-solid" style="padding: 12px 28px; border-radius: 6px; text-decoration: none;">Về trang chủ</a>
            <a href="/shop" class="sg-btn sg-btn-outline" style="padding: 12px 28px; border-radius: 6px; text-decoration: none;">Đặt món</a>
        </div>
    </div>
</div>
