@page "/error"
@layout PhuThuongStickyRice.Web.Components.Core.Layouts.ShopLayout
<PageTitle>Đã có lỗi xảy ra — Xôi Huyền</PageTitle>

<div class="sg-error-wrap">
    <div class="sg-error-body">
        <div class="sg-error-icon" aria-hidden="true">😞</div>
        @* UIUX 21:35 A4-fix4: emoji trang trí — ẩn khỏi screen reader (h1 "Đã có lỗi xảy ra" đã đủ nghĩa), tránh đọc "disappointed face". *@
        <h1 class="sg-error-title">Đã có lỗi xảy ra</h1>
        <p class="sg-error-text">Xin lỗi, đã có sự cố. Vui lòng thử lại hoặc về trang chủ.</p>
        <div class="sg-error-actions">
            <a href="/" class="sg-error-btn-primary">Về trang chủ</a>
            <a href="/shop" class="sg-error-btn-outline">Đặt món</a>
        </div>
    </div>
</div>
