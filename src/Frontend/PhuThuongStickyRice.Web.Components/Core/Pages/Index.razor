    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JSRuntime.InvokeVoidAsync("ptInitCtaParallax"); } catch { }
            try { await JSRuntime.InvokeVoidAsync("ptInitReveal"); } catch { }
            try { await JSRuntime.InvokeVoidAsync("ptInitCountdown"); } catch { }
            try { await JSRuntime.InvokeVoidAsync("ptInitBackToTop"); } catch { }
            try
            {
                var coldWeatherResult = await JSRuntime.InvokeAsync<string>("ptCheckColdWeather");
                if (!string.IsNullOrEmpty(coldWeatherResult))
                {
                    _coldTemp = coldWeatherResult;
                    _showColdBanner = true;
                    StateHasChanged();
                }
            }
            catch { }
            try
            {
                var lastOrder = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "pt-last-order");
                if (!string.IsNullOrEmpty(lastOrder) && DateTime.TryParse(lastOrder, out var d) && (DateTime.Now - d).TotalDays >= 7)
                {
                    _showReorderBanner = true;
                    StateHasChanged();
                }
            }
            catch { }
            try
            {
                var ids = await JSRuntime.InvokeAsync<string[]>("ptGetRecentViews");
                if (ids != null && ids.Length > 0)
                {
                    _recentlyViewed = _allProducts.Where(p => ids.Contains(p.Id.ToString())).ToList();
                    StateHasChanged();
                }
            }
            catch { }
        }
        if (firstRender && !_popupChecked && _content.PopupActive && _promoPopupEnabled)
        {
            _popupChecked = true;
            try
            {
                var seen = await JSRuntime.InvokeAsync<string>("localStorage.getItem", PopupSeenKey);
                if (string.IsNullOrEmpty(seen))
                {
                    _showPopup = true;
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
            }
        }
    }

