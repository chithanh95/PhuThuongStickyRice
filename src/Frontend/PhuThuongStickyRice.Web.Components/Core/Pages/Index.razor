    private async Task ToggleChat()
    {
        _chatOpen = !_chatOpen;
        if (_chatOpen && string.IsNullOrEmpty(_chatSession))
        {
            _chatSession = Guid.NewGuid().ToString("N");
            try { await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pt-chat", _chatSession); } catch { }
        }
        if (_chatOpen) await LoadChatHistory();
    }

    private async Task LoadChatHistory()
    {
        try
        {
            _chatMessages = await LandingService.GetChatMessagesAsync(_chatSession) ?? new List<ChatMessageModel>();
        }
        catch { }
    }

    private async Task SendChat()
    {
        if (string.IsNullOrWhiteSpace(_chatInput)) return;
        var msg = _chatInput.Trim();
        _chatInput = "";
        _chatMessages.Add(new ChatMessageModel { Sender = "customer", Message = msg, CreatedAt = DateTime.Now });
        // 61: thử parse ý định đặt hàng
        try
        {
            var parsed = await LandingService.ParseOrderAsync(msg);
            if (parsed != null && parsed.IsOrderIntent && parsed.Items?.Count > 0)
            {
                _chatOrder = parsed;
                _chatMessages.Add(new ChatMessageModel { Sender = "shop", Message = $"Quán hiểu bạn muốn đặt: {string.Join(", ", parsed.Items.Select(i => $"{i.Quantity} {i.ProductName}"))}. Nhập SĐT và bấm xác nhận nhé!", CreatedAt = DateTime.Now });
                StateHasChanged();
                return;
            }
        }
        catch { }
        try { await LandingService.SendChatAsync(_chatSession, msg); } catch { }
    }

