    private string GreetingByHour
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour >= 5 && hour < 10) return "☀️ Chào buổi sáng! Xôi nóng vừa ra lò.";
            if (hour >= 10 && hour < 14) return "🍱 Xôi trưa dẻo thơm, ăn là no tới chiều.";
            if (hour >= 14 && hour < 18) return "🌤️ Xế chiều thèm xôi? Quán còn nóng hổi.";
            // 2026-10-19: bỏ câu chào ban đêm ("đặt xôi sáng mai... giao nóng")
            // theo yêu cầu user — quán KHÔNG có người giao hàng, cũng không nhận
            // đặt trước. Trả rỗng, markup sẽ không render dòng này.
            return "";
        }
    }

    private IEnumerable<ShopProductModel> SearchedProducts(IEnumerable<ShopProductModel> source)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return source;
        var term = _searchTerm.Trim().ToLower();
        return source.Where(p => (p.Name ?? "").ToLower().Contains(term));
    }

    private string MaskPhone(string phone)
    {
        var digits = NormalizePhoneDigits(phone);
        if (digits.Length < 5) return "Khách hàng";
        return digits.Substring(0, 3) + "***" + digits.Substring(digits.Length - 2);
    }

