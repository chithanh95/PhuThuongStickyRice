        try
        {
            var settings = await ShopSettingsService.GetPublicAsync();
            _shopSettings = settings;
            if (settings != null)
            {
                var (isOpen, text) = ShopHours.StatusText(settings.OpenTime, settings.CloseTime);
                _openNow = isOpen;
                _openStatusText = text;
                // Landing item 18: tracking.
                try { await JSRuntime.InvokeVoidAsync("ptInitTracking", settings.FacebookPixelId, settings.GoogleAnalyticsId); } catch { }
            }
        }
        catch (Exception)
        {
        }

        try
        {
            _policies = await PolicyService.GetPublicListAsync()
                ?? new List<PolicyPageSummaryModel>();
        }
        catch (Exception)
        {
            _policies = new List<PolicyPageSummaryModel>();
        }

        try
        {
            _content = await LandingService.GetContentAsync() ?? new LandingContentModel();
        }
        catch (Exception)
        {
            _loadFailed = true;
            _content = new LandingContentModel();
        }

        try
        {
            var flags = await Wave4Service.GetFeatureFlagMapAsync();
            _promoPopupEnabled = flags == null || !flags.TryGetValue("promo-popup", out var on) || on;
        }
        catch (Exception)
        {
        }

        try
        {
            var paged = await ShopService.GetProductsAsync();
            _allProducts = paged?.Items ?? new List<ShopProductModel>();
        }
        catch (Exception)
        {
        }

        // Landing conversion features: reviews, stats, gallery, FAQ (fail-soft).
        try { _reviews = await LandingService.GetPublicReviewsAsync() ?? new List<PhuThuongStickyRice.Web.Components.Admin.Models.PublicReviewModel>(); } catch { }
        try { _stats = await LandingService.GetStatsAsync() ?? new LandingStatsModel(); } catch { }
        try { _gallery = await LandingService.GetGalleryAsync() ?? new List<GalleryPhotoModel>(); } catch { }
        try { _faqs = await LandingService.GetFaqsAsync() ?? new List<FaqPublicModel>(); } catch { }
        try
        {
            var holidays = await LandingService.GetUpcomingHolidaysAsync();
            _nextHoliday = holidays?.Where(h => (h.HolidayDate.Date - DateTime.Now.Date).TotalDays is >= 0 and <= 14)
                .OrderBy(h => h.HolidayDate).FirstOrDefault();
        }
        catch { }

        try
        {
            var ids = await ShopService.GetBestSellerIdsAsync();
            if (ids != null) _bestSellerIds = new HashSet<Guid>(ids);
        }
        catch (Exception)
        {
        }

        try
        {
            _combos = (await ShopService.GetCombosAsync())
                ?.Where(c => c.IsActive).ToList() ?? new List<ComboModel>();
        }
        catch (Exception)
        {
            _combos = new List<ComboModel>();
