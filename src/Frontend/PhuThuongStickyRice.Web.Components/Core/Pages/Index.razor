        {
            try
            {
                var holidays = await LandingService.GetUpcomingHolidaysAsync();
                // MinBy tương đương OrderBy(...).FirstOrDefault() nhưng chỉ duyệt 1 lần O(n),
                // không tốn chi phí sắp xếp cả danh sách.
                _nextHoliday = holidays?.Where(h => (h.HolidayDate.Date - DateTime.Now.Date).TotalDays is >= 0 and <= 14)
                    .MinBy(h => h.HolidayDate);
