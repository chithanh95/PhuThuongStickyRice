    /// <param name="phone">SĐT thô do khách nhập.</param>
    /// <returns>Chuỗi chỉ gồm chữ số.</returns>
    private static string NormalizePhoneDigits(string phone) =>
        new string((phone ?? "").Where(char.IsDigit).ToArray());

    /// <summary>Vẽ chuỗi sao ★/☆ từ điểm đánh giá, kẹp rating trong khoảng 1–5.</summary>
    private static string Stars(int rating)
    {
        // Kẹp rating vào [1,5] trước khi vẽ sao để chuỗi luôn đủ 5 ký tự.
        var clampedRating = Math.Max(1, Math.Min(5, rating));
        return new string('★', clampedRating) + new string('☆', 5 - clampedRating);
    }

