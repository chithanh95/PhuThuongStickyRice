    private async Task SubmitDishPollVote(Guid pollId)
    {
        _voteMsg = null;
        var digits = NormalizePhoneDigits(_votePhone);
        if (digits.Length < MinPhoneDigits) { _voteMsg = "Nhập SĐT để bình chọn."; return; }
        try
        {
            if (await LandingService.SubmitPollVoteAsync(pollId, digits))
            {
                _polls = await LandingService.GetPollsAsync() ?? new List<DishPollModel>();
                _voteMsg = "Đã ghi nhận bình chọn của bạn!";
            }
            else _voteMsg = "Bạn đã bình chọn món này rồi.";
        }
        catch { _voteMsg = "Chưa bình chọn được, thử lại nhé."; }
    }



