        if (digits.Length < 9) { Toasts.Show("Nhập SĐT để đặt hàng."); return; }
        foreach (var item in _chatOrder.Items)
        {
            var p = _allProducts.FirstOrDefault(x => x.Id == item.ProductId);
            if (p != null) CartState.Add(p, item.Quantity);
        }
        try { JSRuntime.InvokeVoidAsync("localStorage.setItem", "pt-checkout-phone", digits); } catch { }
        _chatOrder = null;
        Navigation.NavigateTo("/checkout");
    }

