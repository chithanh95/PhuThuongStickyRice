@page "/"
@layout PhuThuongStickyRice.Web.Components.Core.Layouts.EmptyLayout
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Landing.Models
@using PhuThuongStickyRice.Web.Components.Landing.Services
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject LandingService LandingService
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject PolicyService PolicyService
@inject CartState CartState
@inject ToastService Toasts
@inject PhuThuongStickyRice.Web.Components.Admin.Services.Wave4Service Wave4Service
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject NavigationManager Navigation

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito:wght@400;600;700;800&display=swap&subset=vietnamese" rel="stylesheet" />

@if (_loadFailed)
{
    <div class="sg-loadfail">
        <div class="sg-loadfail-card">
            <div class="sg-loadfail-face">😞</div>
            <h2>Không kết nối được tới máy chủ</h2>
            <p>Kiểm tra mạng rồi thử lại.</p>
            <button class="sg-btn sg-btn-solid" @onclick="RetryLoad">Thử lại</button>
        </div>
    </div>
}
else
{
<div class="sg-page">

<!-- FLASH BANNER (admin-controlled) -->
@if (!_bannerDismissed && _content.FlashBannerActive && !string.IsNullOrWhiteSpace(_content.FlashBannerText))
{
    <div class="sg-flash" role="alert">
        <span>⚡ @_content.FlashBannerText</span>
        <button type="button" class="sg-flash-close" aria-label="Đóng" @onclick="() => _bannerDismissed = true">×</button>
    </div>
}

<!-- 1. HEADER -->
<header class="sg-header">
    <div class="sg-header-inner">
        <a class="sg-logo" href="/">
            <span class="sg-logo-main">Xôi Phú Thượng</span>
            <span class="sg-logo-sub">Vietnamese Cuisine</span>
        </a>
        <input type="checkbox" id="sg-nav-toggle" class="sg-nav-checkbox" />
        <nav class="sg-nav">
            <a href="#gioi-thieu">Giới thiệu</a>
            <a href="#mon-dac-trung">Món đặc trưng</a>
            <a href="#thuc-don">Thực đơn</a>
            <a href="#lien-he">Liên hệ</a>
        </nav>
        <div class="sg-header-right">
            <button class="sg-theme-toggle" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">
                @(_isDark ? "☀️" : "🌙")
            </button>
            <AuthorizeView>
                <Authorized>
                    <a class="sg-account" href="/tai-khoan" title="Tài khoản của tôi">👤 @context.User.Identity?.Name</a>
                </Authorized>
                <NotAuthorized>
                    <a class="sg-account" href="/dang-nhap">Đăng nhập</a>
                </NotAuthorized>
            </AuthorizeView>
            @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
            {
                <a class="sg-hotline" href="tel:@_content.ContactPhone">📞 @_content.ContactPhone</a>
            }
            else
            {
                <a class="sg-hotline" href="/shop">Đặt xôi ngay</a>
            }
            <label for="sg-nav-toggle" class="sg-hamburger" aria-label="Menu"><span></span><span></span><span></span></label>
        </div>
    </div>
</header>

<!-- 2. HERO -->
<section class="sg-hero" style="@HeroBgStyle">
    <div class="sg-hero-overlay"></div>
    <div class="sg-hero-inner">
        <p class="sg-hero-eyebrow">Làng nghề Phú Thượng · Hà Nội</p>
        <h1 class="sg-hero-title">@HeroTitleText</h1>
        <p class="sg-hero-tag">@HeroTaglineText</p>
        @if (!string.IsNullOrEmpty(_openStatusText))
        {
            <p class="sg-hero-open @(_openNow ? "is-open" : "is-closed")">@_openStatusText</p>
        }
        <div class="sg-hero-cta">
            <a href="/shop" class="sg-btn sg-btn-solid sg-btn-lg">Đặt xôi ngay</a>
            <a href="#thuc-don" class="sg-btn sg-btn-ghost sg-btn-lg">Xem thực đơn</a>
        </div>
    </div>
    <a class="sg-scroll" href="#gioi-thieu" aria-label="Cuộn xuống">
        <span class="sg-scroll-mouse"><span class="sg-scroll-wheel"></span></span>
        <span class="sg-scroll-text">Cuộn xuống</span>
    </a>
</section>

<!-- 3. GIỚI THIỆU -->
<section class="sg-section" id="gioi-thieu">
    <div class="sg-container">
        <p class="sg-poem">Dẻo thơm hạt nếp đầu ngày,<br />Gói xôi nóng hổi trao tay người thương.</p>
        <div class="sg-intro-grid">
            <div class="sg-intro-text">
                <p class="sg-eyebrow">Giới thiệu</p>
                <h2 class="sg-h2">@StoryTitleText</h2>
                <p class="sg-lead">@StoryBodyText</p>
                <a href="/shop" class="sg-btn sg-btn-outline">Đặt xôi ngay →</a>
            </div>
            <div class="sg-intro-img">
                <img loading="lazy" src="@Img(_content.HeroImageUrl, "_content/PhuThuongStickyRice.Web.Components/images/xoi-gac.jpg")" alt="Xôi Phú Thượng" />
            </div>
        </div>
    </div>
</section>

<!-- 4. TRẢI NGHIỆM -->
<section class="sg-section sg-why">
    <div class="sg-container">
        <div class="sg-sec-head">
            <p class="sg-eyebrow">Trải nghiệm</p>
            <h2 class="sg-h2">Vì sao chọn Xôi Phú Thượng</h2>
        </div>
        <div class="sg-why-grid">
            <div class="sg-why-card">
                <div class="sg-why-icon">🌾</div>
                <h3>Nếp cái hoa vàng</h3>
                <p>Chọn gạo nếp cái hoa vàng hạt mẩy, ngâm đủ giờ để xôi dẻo thơm mà không nát.</p>
            </div>
            <div class="sg-why-card">
                <div class="sg-why-icon">🎋</div>
                <h3>Đồ bằng chõ tre</h3>
                <p>Xôi được đồ trong chõ tre truyền thống của làng nghề, giữ trọn hương nếp mới.</p>
            </div>
            <div class="sg-why-card">
                <div class="sg-why-icon">🛵</div>
                <h3>Giao nóng mỗi sáng</h3>
                <p>Xôi ra lò từ 5h sáng, gói lá chuối, giao nóng hổi đến tay bạn.</p>
            </div>
        </div>
    </div>
</section>

<!-- 5. MÓN XÔI ĐẶC TRƯNG -->
<section class="sg-section" id="mon-dac-trung">
    <div class="sg-container">
        <div class="sg-sec-head">
            <p class="sg-eyebrow">Món xôi đặc trưng</p>
            <h2 class="sg-h2">Những gói xôi được yêu thích nhất</h2>
        </div>
        @if (OrdersPaused)
        {
            <p class="sg-paused">⏸ Quán tạm ngưng nhận đơn @PauseReasonText</p>
        }
        <div class="sg-dish-grid">
            @if (_allProducts == null)
            {
                <p class="sg-muted"><em>Đang tải món ngon...</em></p>
            }
            else if (SignatureProducts.Count == 0)
            {
                <p class="sg-muted"><em>Hiện chưa có món nào.</em></p>
            }
            else
            {
                @foreach (var product in SignatureProducts)
                {
                    <div class="sg-dish-card" @key="product.Id">
                        <div class="sg-dish-imgwrap">
                            @if (IsBestSeller(product))
                            {
                                <span class="sg-badge">Bán chạy</span>
                            }
                            @if (IsSoldOut(product))
                            {
                                <span class="sg-badge sg-badge-out">Tạm hết</span>
                            }
                            <img loading="lazy" src="@ProductImage(product)" alt="@product.Name" />
                        </div>
                        <div class="sg-dish-body">
                            <h3 class="sg-dish-name">@product.Name</h3>
                            <div class="sg-dish-price">@FormatPrice(product.Price)<small>@UnitSuffix(product)</small></div>
                            <button class="sg-btn sg-btn-solid sg-btn-block" @onclick="() => AddToCart(product)" disabled="@(OrdersPaused || IsSoldOut(product))">
                                @(IsSoldOut(product) ? "Tạm hết" : "Thêm vào giỏ")
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="sg-center">
            <a href="/shop" class="sg-btn sg-btn-outline">Xem tất cả món →</a>
        </div>
    </div>
</section>

<!-- 6. CÂU CHUYỆN LÀNG NGHỀ -->
<section class="sg-section sg-story">
    <div class="sg-container sg-story-inner">
        <p class="sg-eyebrow">Câu chuyện</p>
        <h2 class="sg-h2">Làng nghề Phú Thượng</h2>
        <p>Phú Thượng là làng nghề nấu xôi lâu đời ven sông Hồng của Hà Nội. Từ tờ mờ sáng, khắp làng đã thơm mùi nếp mới đồ trong chõ tre — mùi thơm ấy theo chân các gánh xôi đi khắp phố phường Thủ đô, trở thành ký ức của bao thế hệ người Hà Nội.</p>
        <p>Chúng tôi giữ đúng cách làm của làng: gạo ngon, đồ hai lửa, gói lá chuối. Không vội vàng, không đường tắt — chỉ có gói xôi nóng hổi, dẻo thơm như ngày xưa.</p>
    </div>
</section>

<!-- 7. BANNER ĐẶT XÔI -->
<section class="sg-cta" style="@CtaBgStyle">
    <div class="sg-cta-overlay"></div>
    <div class="sg-cta-inner">
        <p class="sg-cta-eyebrow">Giao nóng mỗi sáng</p>
        <h2 class="sg-cta-title">Đặt xôi ngay</h2>
        <p class="sg-cta-sub">Đặt online hoặc gọi hotline — quán chuẩn bị trong 15 phút.</p>
        <div class="sg-cta-btns">
            <a href="/shop" class="sg-btn sg-btn-solid sg-btn-lg">Đặt xôi ngay →</a>
            @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
            {
                <a href="tel:@_content.ContactPhone" class="sg-btn sg-btn-ghost sg-btn-lg">📞 @_content.ContactPhone</a>
            }
        </div>
    </div>
</section>

<!-- 8. THỰC ĐƠN -->
<section class="sg-section" id="thuc-don">
    <div class="sg-container">
        <div class="sg-sec-head">
            <p class="sg-eyebrow">Thực đơn</p>
            <h2 class="sg-h2">@MenuTitleText</h2>
        </div>
        <div class="sg-tabs" role="tablist">
            <button class="sg-tab @(_menuTab == "xoi" ? "active" : "")" @onclick='() => _menuTab = "xoi"'>Xôi truyền thống</button>
            <button class="sg-tab @(_menuTab == "combo" ? "active" : "")" @onclick='() => _menuTab = "combo"'>Combo tiết kiệm</button>
            <button class="sg-tab @(_menuTab == "tiec" ? "active" : "")" @onclick='() => _menuTab = "tiec"'>Đặt tiệc &amp; Cúng giỗ</button>
        </div>

        @if (_menuTab == "xoi")
        {
            <div class="sg-dish-grid">
                @foreach (var product in XoiProducts)
                {
                    <div class="sg-dish-card" @key="product.Id">
                        <div class="sg-dish-imgwrap">
                            @if (IsSoldOut(product))
                            {
                                <span class="sg-badge sg-badge-out">Tạm hết</span>
                            }
                            <img loading="lazy" src="@ProductImage(product)" alt="@product.Name" />
                        </div>
                        <div class="sg-dish-body">
                            <h3 class="sg-dish-name">@product.Name</h3>
                            <div class="sg-dish-price">@FormatPrice(product.Price)<small>@UnitSuffix(product)</small></div>
                            <button class="sg-btn sg-btn-solid sg-btn-block" @onclick="() => AddToCart(product)" disabled="@(OrdersPaused || IsSoldOut(product))">
                                @(IsSoldOut(product) ? "Tạm hết" : "Thêm vào giỏ")
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_menuTab == "combo")
        {
            @if (_combos.Count == 0)
            {
                <p class="sg-muted sg-center"><em>Hiện chưa có combo nào — mời bạn xem các món xôi.</em></p>
            }
            <div class="sg-dish-grid">
                @foreach (var combo in _combos)
                {
                    <div class="sg-dish-card" @key="combo.Id">
                        <div class="sg-dish-body sg-combo-body">
                            <h3 class="sg-dish-name">@combo.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(combo.Description))
                            {
                                <p class="sg-combo-desc">@combo.Description</p>
                            }
                            @if (combo.Items != null && combo.Items.Count > 0)
                            {
                                <p class="sg-combo-items">@combo.Items.Count món trong combo</p>
                            }
                            <div class="sg-dish-price">@FormatPrice(combo.Price)</div>
                            <button class="sg-btn sg-btn-solid sg-btn-block" @onclick="() => AddComboToCart(combo)" disabled="@OrdersPaused">
                                Thêm combo vào giỏ
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sg-tiec-grid">
                <a class="sg-tiec-card" href="/dat-tiec">
                    <div class="sg-tiec-icon">🎉</div>
                    <h3>Đặt tiệc</h3>
                    <p>Xôi tiệc, cỗ bàn số lượng lớn — báo giá trong ngày.</p>
                    <span class="sg-tiec-link">Đặt tiệc →</span>
                </a>
                <a class="sg-tiec-card" href="/cung-gio">
                    <div class="sg-tiec-icon">🕯️</div>
                    <h3>Cúng giỗ</h3>
                    <p>Mâm xôi cúng đầy đặn, trang trọng cho ngày giỗ.</p>
                    <span class="sg-tiec-link">Đặt mâm cúng →</span>
                </a>
                <a class="sg-tiec-card" href="/dat-cung">
                    <div class="sg-tiec-icon">🙏</div>
                    <h3>Xôi cúng Rằm &amp; mùng 1</h3>
                    <p>Đặt trước xôi cúng mỗi tháng, có nhắc lịch tự động.</p>
                    <span class="sg-tiec-link">Đặt xôi cúng →</span>
                </a>
            </div>
        }
    </div>
</section>

<!-- 9. ĐẶT TRƯỚC -->
<section class="sg-section sg-book" id="dat-xoi">
    <div class="sg-container">
        <div class="sg-book-grid">
            <div class="sg-book-info">
                <p class="sg-eyebrow">Đặt trước</p>
                <h2 class="sg-h2">Đặt xôi số lượng lớn</h2>
                <p class="sg-lead">Để lại thông tin — quán gọi lại xác nhận trong 15 phút.</p>
                <ul class="sg-book-contact">
                    @if (!string.IsNullOrWhiteSpace(_content.ContactAddress))
                    {
                        <li>📍 @_content.ContactAddress</li>
                    }
                    @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
                    {
                        <li>📞 <a href="tel:@_content.ContactPhone">@_content.ContactPhone</a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(_content.ContactEmail))
                    {
                        <li>✉️ @_content.ContactEmail</li>
                    }
                </ul>
            </div>
            <form class="sg-book-form" @onsubmit="SubmitBooking">
                <label class="sg-field">
                    <span>Tên của bạn *</span>
                    <input @bind="_bookName" placeholder="Nguyễn Văn A" maxlength="100" />
                </label>
                <label class="sg-field">
                    <span>Số điện thoại *</span>
                    <input @bind="_bookPhone" placeholder="090..." inputmode="tel" maxlength="15" />
                </label>
                <div class="sg-field-row">
                    <label class="sg-field">
                        <span>Số lượng (gói)</span>
                        <input type="number" @bind="_bookQty" min="1" max="1000" />
                    </label>
                </div>
                <label class="sg-field">
                    <span>Ghi chú</span>
                    <textarea @bind="_bookNotes" rows="3" placeholder="Giao lúc mấy giờ, địa chỉ..." maxlength="500"></textarea>
                </label>
                @if (!string.IsNullOrEmpty(_bookError))
                {
                    <p class="sg-form-error">@_bookError</p>
                }
                @if (_bookSent)
                {
                    <p class="sg-form-ok">✓ Đặt thành công! Quán sẽ gọi xác nhận.</p>
                }
                else
                {
                    <button type="submit" class="sg-btn sg-btn-solid sg-btn-block" disabled="@_bookSending">
                        @(_bookSending ? "Đang gửi..." : "Gửi đặt trước")
                    </button>
                }
            </form>
        </div>
    </div>
</section>

<!-- 10. FOOTER -->
<footer class="sg-footer" id="lien-he">
    <div class="sg-container">
        <div class="sg-footer-grid">
            <div class="sg-footer-col">
                <h3 class="sg-footer-brand">Xôi Phú Thượng</h3>
                <p class="sg-footer-about">Gói xôi nóng hổi mỗi sáng từ làng nghề Phú Thượng — dẻo thơm, đúng vị Hà Nội.</p>
                @if (!string.IsNullOrWhiteSpace(_content.ContactAddress))
                {
                    <p class="sg-footer-line">📍 @_content.ContactAddress</p>
                }
            </div>
            <div class="sg-footer-col">
                <h4 class="sg-footer-h">Khám phá</h4>
                <a href="#gioi-thieu">Giới thiệu</a>
                <a href="#mon-dac-trung">Món đặc trưng</a>
                <a href="#thuc-don">Thực đơn</a>
                <a href="/shop">Đặt xôi online</a>
                <a href="/dat-tiec">Đặt tiệc</a>
                <a href="/nhuong-quyen">Nhượng quyền</a>
            </div>
            <div class="sg-footer-col">
                <h4 class="sg-footer-h">Liên hệ</h4>
                @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
                {
                    <a class="sg-footer-hotline" href="tel:@_content.ContactPhone">📞 @_content.ContactPhone</a>
                }
                @if (!string.IsNullOrWhiteSpace(_content.ContactEmail))
                {
                    <p class="sg-footer-line">✉️ @_content.ContactEmail</p>
                }
                <a href="/faq">Câu hỏi thường gặp</a>
            </div>
        </div>
        @if (_policies.Count > 0)
        {
            <div class="sg-policy-bar">
                @foreach (var p in _policies)
                {
                    <a href="/chinh-sach/@p.Slug">@p.Title</a>
                }
            </div>
        }
        <div class="sg-bottom-bar">&copy; 2026 Xôi Phú Thượng &mdash; Thổi hồn vào từng gói xôi</div>
    </div>
</footer>

<!-- NÚT CỐ ĐỊNH -->
<div class="sg-fixed-btns">
    <a class="sg-fb-btn" href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">f</a>
    <a class="sg-zalo-btn" href="@ZaloUrl" target="_blank" rel="noopener" aria-label="Chat Zalo" title="Chat Zalo">Z</a>
    @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
    {
        <a class="sg-call-btn" href="tel:@_content.ContactPhone" aria-label="Gọi ngay" title="Gọi ngay">
            <span class="oi oi-phone" aria-hidden="true"></span>
        </a>
    }
</div>

<!-- POPUP KHUYẾN MÃI (admin-controlled) -->
@if (_showPopup)
{
    <div class="sg-popup-overlay" @onclick="DismissPopup">
        <div class="sg-popup" @onclick:stopPropagation>
            <button type="button" class="sg-popup-close" aria-label="Đóng" @onclick="DismissPopup">×</button>
            @if (!string.IsNullOrWhiteSpace(_content.PopupImageUrl))
            {
                <img loading="lazy" src="@Img(_content.PopupImageUrl, null)" alt="@_content.PopupTitle" class="sg-popup-img" />
            }
            <h3 class="sg-popup-title">@_content.PopupTitle</h3>
            <p class="sg-popup-body">@_content.PopupBody</p>
            <a href="/shop" class="sg-btn sg-btn-solid sg-btn-block">Đặt ngay →</a>
        </div>
    </div>
}

</div> @* /.sg-page *@
<PhuThuongStickyRice.Web.Components.Shop.Components.UpsellPopup
    Visible="@_upsellVisible"
    Products="@_upsellProducts"
    AddedProductName="@_upsellAddedName"
    OnAdd="AddUpsell"
    OnClose="CloseUpsell" />
} @* /_loadFailed else *@

@code {
    private LandingContentModel _content = new LandingContentModel();
    private List<ShopProductModel> _allProducts = new List<ShopProductModel>();
    private List<ComboModel> _combos = new List<ComboModel>();

    // Menu tabs: "xoi" | "combo" | "tiec".
    private string _menuTab = "xoi";

    // Upsell popup state.
    private bool _upsellVisible;
    private string _upsellAddedName;
    private List<ShopProductModel> _upsellProducts = new List<ShopProductModel>();

    // Best-seller ids (fail-soft) for the "Bán chạy" badges.
    private HashSet<Guid> _bestSellerIds = new HashSet<Guid>();

    private bool IsBestSeller(ShopProductModel p) =>
        p != null && (_bestSellerIds.Contains(p.Id) || p.IsSignature);

    private static bool IsXoi(ShopProductModel p) =>
        (p?.Code ?? "").StartsWith("XOI", StringComparison.OrdinalIgnoreCase);

    private static bool IsSoldOut(ShopProductModel p) =>
        !string.Equals(p?.Status, "Active", StringComparison.OrdinalIgnoreCase);

    /// <summary>Signature dishes: best sellers / signature first, max 6.</summary>
    private List<ShopProductModel> SignatureProducts =>
        _allProducts
            .Where(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => _bestSellerIds.Contains(p.Id) || p.IsSignature)
            .ThenBy(p => p.SortOrder)
            .ThenBy(p => p.Name)
            .Take(6)
            .ToList();

