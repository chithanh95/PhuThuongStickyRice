    // 63: yêu thích
    private string _favPhone = "";
    private async Task ToggleFavorite(ShopProductModel p)
    {
        var digits = new string((_favPhone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length < 9)
        {
            // Lưu local nếu chưa có SĐT
            try
            {
                var key = "pt-fav-local";
                var cur = await JSRuntime.InvokeAsync<string>("localStorage.getItem", key) ?? "";
                var ids = cur.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
                var id = p.Id.ToString();
                if (ids.Contains(id)) ids.Remove(id); else ids.Add(id);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", key, string.Join(",", ids));
                _favorites = new HashSet<Guid>(ids.Where(x => Guid.TryParse(x, out _)).Select(Guid.Parse));
            }
            catch { }
            return;
        }
        try
        {
            if (_favorites.Contains(p.Id)) { await LandingService.RemoveFavoriteAsync(digits, p.Id); _favorites.Remove(p.Id); }
            else { await LandingService.AddFavoriteAsync(digits, p.Id); _favorites.Add(p.Id); }
        }
        catch { }
    }


