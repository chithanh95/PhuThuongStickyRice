    private static List<string> AllImageUrls(string imageUrlsJson)
    {
        var list = new List<string>();
        if (string.IsNullOrWhiteSpace(imageUrlsJson)) return list;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(imageUrlsJson);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) return list;
            foreach (var imageElement in doc.RootElement.EnumerateArray())
            {
                var imageUrl = imageElement.GetString();
                if (!string.IsNullOrWhiteSpace(imageUrl)) list.Add(imageUrl);
            }
        }
        // Parse JSON danh sách ảnh: dữ liệu hỏng hoặc không phải mảng thì trả list rỗng
        // (hiển thị placeholder) thay vì làm vỡ cả trang — bỏ qua lỗi có chủ ý.
        catch { }
        return list;
    }

