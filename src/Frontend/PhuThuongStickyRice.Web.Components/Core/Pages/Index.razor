@code {
    private LandingContentModel _content = new LandingContentModel();
    private List<ShopProductModel> _allProducts = new List<ShopProductModel>();
    private List<ComboModel> _combos = new List<ComboModel>();

    // Menu tabs: "xoi" | "combo" | "tiec".
    private string _menuTab = "xoi";

    // Upsell popup state.
    private bool _upsellVisible;
    private string _upsellAddedName;
    private List<ShopProductModel> _upsellProducts = new List<ShopProductModel>();

    // Best-seller ids (fail-soft) for the "Bán chạy" badges.
    private HashSet<Guid> _bestSellerIds = new HashSet<Guid>();

    private static bool IsXoi(ShopProductModel p) =>
        (p?.Code ?? "").StartsWith("XOI", StringComparison.OrdinalIgnoreCase);

    private static bool IsSoldOut(ShopProductModel p) =>
        !string.Equals(p?.Status, "Active", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// bug-hunt 2026-10-19: port từ Shop.razor (item 164) — true khi giờ hiện
    /// tại của trình duyệt nằm trong một khung giờ bán của món, hoặc món không
    /// đặt khung giờ. Fail-open khi JSON lỗi để không chặn bán nhầm.
    /// </summary>
    private static bool IsInSaleHours(ShopProductModel product)
    {
        var json = product?.AvailableHoursJson;
        if (string.IsNullOrWhiteSpace(json))
        {
            return true;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return true;
            }

            var now = DateTime.Now.TimeOfDay;
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind != System.Text.Json.JsonValueKind.Object)
                {
                    continue;
                }

                if (el.TryGetProperty("from", out var fromEl)
                    && el.TryGetProperty("to", out var toEl)
                    && TimeSpan.TryParse(fromEl.GetString(), out var from)
                    && TimeSpan.TryParse(toEl.GetString(), out var to)
                    && now >= from && now < to)
                {
                    return true;
                }
            }

            return false;
        }
        catch (System.Text.Json.JsonException)
        {
            return true;
        }
    }

    /// <summary>bug-hunt 2026-10-19: port từ Shop.razor (item 165) — true khi đã hết suất bán hôm nay.</summary>
    private static bool IsDailyLimitReached(ShopProductModel p) =>
        p?.RemainingToday.HasValue == true && p.RemainingToday.Value <= 0;

    /// <summary>
    /// bug-hunt 2026-10-19: nút "Thêm vào giỏ" ở trang chủ chỉ bật khi đặt
    /// được — cùng luật với CanOrder ở /shop: quán không tạm ngưng, món còn
    /// hàng, đang trong giờ bán, chưa hết suất hôm nay. Trước đây trang chủ
    /// chỉ check Tạm hết nên món "Hết suất hôm nay"/ngoài giờ bán vẫn cho vào
    /// giỏ, ra checkout mới bị server từ chối (EnsureDailyLimitsAsync).
    /// </summary>
    private bool CanOrder(ShopProductModel product) =>
        !OrdersPaused && !IsSoldOut(product) && IsInSaleHours(product) && !IsDailyLimitReached(product);

    /// <summary>Nhãn nút giải thích TẠI SAO không đặt được (mirror AddButtonLabel ở /shop).</summary>
    private static string AddButtonLabel(ShopProductModel product)
    {
        if (IsSoldOut(product))
        {
            return "Tạm hết";
        }

        if (!IsInSaleHours(product))
        {
            return "Chưa tới giờ bán";
        }

        if (IsDailyLimitReached(product))
        {
            return "Hết suất hôm nay";
        }

        return "Thêm vào giỏ";
    }

