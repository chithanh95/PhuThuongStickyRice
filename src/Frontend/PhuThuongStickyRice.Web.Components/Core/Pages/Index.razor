@page "/"
<PageTitle>Xôi Phú Thượng — Xôi ngon Hà Nội, đặt xôi online</PageTitle>
@layout PhuThuongStickyRice.Web.Components.Core.Layouts.EmptyLayout
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Landing.Models
@using PhuThuongStickyRice.Web.Components.Landing.Services
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject LandingService LandingService
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject PolicyService PolicyService
@inject CartState CartState
@inject ToastService Toasts
@inject PhuThuongStickyRice.Web.Components.Admin.Services.AdminSystemService AdminSystemService
@inject ShopEngagementService ShopEngagementService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AppI18n AppI18n
@inject FunnelService Funnel
@implements IDisposable

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito:wght@400;600;700;800&display=swap&subset=vietnamese" rel="stylesheet" />

@if (_loadFailed)
{
    <div class="sg-loadfail">
        <div class="sg-loadfail-card">
            <div class="sg-loadfail-face">😞</div>
            <h2>Không kết nối được tới máy chủ</h2>
            <p>Kiểm tra mạng rồi thử lại.</p>
            <button class="sg-btn sg-btn-solid" @onclick="RetryLoad">Thử lại</button>
        </div>
    </div>
}
else
{
<div class="sg-page">

<!-- FLASH BANNER (admin-controlled) -->
@if (!_bannerDismissed && _content.FlashBannerActive && !string.IsNullOrWhiteSpace(_content.FlashBannerText))
{
    <div class="sg-flash" role="alert">
        <span>⚡ @_content.FlashBannerText</span>
        <button type="button" class="sg-flash-close" aria-label="Đóng" @onclick="() => _bannerDismissed = true">×</button>
    </div>
}

<!-- COUNTDOWN KHUYẾN MÃI (item 4) -->
@if (_content.PromoCountdownActive && _content.PromoCountdownEnd > DateTime.Now)
{
    <div class="sg-countdown-bar">
        <span class="sg-countdown-text">🔥 @_content.PromoCountdownText</span>
        <span class="sg-countdown-timer" data-end="@CountdownEndIso">
            <b data-cd="d">0</b> ngày <b data-cd="h">00</b>:<b data-cd="m">00</b>:<b data-cd="s">00</b>
        </span>
    </div>
}

<!-- NHẮC ĐẶT LẠI (item 41) -->
@if (_showReorderBanner)
{
    <div class="sg-reorder-bar">
        🍚 Thèm xôi chưa bạn? Đã 1 tuần rồi đó — <a href="/shop">đặt lại 1 chạm →</a>
        <button @onclick="() => _showReorderBanner = false" aria-label="Đóng">×</button>
    </div>
}

<!-- BANNER LỄ/TẾT (item 20) -->
@if (_nextHoliday != null)
{
    <div class="sg-holiday-bar">
        🎉 @_nextHoliday.Reason — @_nextHoliday.HolidayDate.ToString("dd/MM"): Đặt xôi cúng sớm để quán chuẩn bị chu đáo!
        <a href="/shop">Đặt ngay →</a>
    </div>
}

<!-- BANNER THỜI TIẾT (item 26) -->
@if (_showColdBanner)
{
    <div class="sg-weather-bar">
        🥶 Trời lạnh @(_coldTemp)°C — xôi nóng hổi giao ngay cho ấm bụng! <a href="/shop">Đặt ngay →</a>
    </div>
}

<!-- BANNER OFF-PEAK (item 48) -->
@if (_offpeak != null && _offpeak.IsNow && _offpeak.DiscountAmount > 0)
{
    <div class="sg-offpeak-bar">
        ⏰ Khung giờ vắng khách (@_offpeak.StartHour h – @_offpeak.EndHour h): giảm ngay @_offpeak.DiscountAmount.ToString("N0")đ mỗi đơn! <a href="/shop">Đặt ngay →</a>
    </div>
}

<!-- 1. HEADER -->
<header class="sg-header">
    <div class="sg-header-inner">
        <a class="sg-logo" href="/">
            <span class="sg-logo-main">Xôi Phú Thượng</span>
            <span class="sg-logo-sub">Vietnamese Cuisine</span>
        </a>
        <input type="checkbox" id="sg-nav-toggle" class="sg-nav-checkbox" />
        <nav class="sg-nav">
            <a href="#gioi-thieu">@AppI18n.Translate("nav.about")</a>
            <a href="/shop">@AppI18n.Translate("nav.signature")</a>
            <a href="#thuc-don">@AppI18n.Translate("nav.menu")</a>
            <a href="/dat-so-luong-lon">@AppI18n.Translate("nav.bulk_order")</a>
            <a href="#lien-he">@AppI18n.Translate("nav.contact")</a>
        </nav>
        <div class="sg-header-right">
            <div class="sg-lang-dropdown">
                <LanguageSelector Compact="true" />
            </div>
            <button class="sg-theme-toggle" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">
                @(_isDark ? "🌙" : "☀️")
            </button>
            @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
            {
                <a class="sg-hotline" href="tel:@_content.ContactPhone">📞 @_content.ContactPhone</a>
            }
            else
            {
                <a class="sg-hotline" href="/shop">@AppI18n.Translate("nav.order_now")</a>
            }
            <label for="sg-nav-toggle" class="sg-hamburger" aria-label="Menu"><span></span><span></span><span></span></label>
        </div>
    </div>
</header>

<main id="main-content" tabindex="-1">
<!-- 2. HERO -->
<section class="sg-hero" style="@HeroBgStyle">
    <div class="sg-hero-overlay"></div>
    <div class="sg-hero-inner">
        <p class="sg-hero-eyebrow">Làng nghề Phú Thượng · Hà Nội</p>
        <h1 class="sg-hero-title">@HeroTitleText</h1>
        <p class="sg-hero-tag">@HeroTaglineText</p>
        @if (!string.IsNullOrEmpty(GreetingByHour))
        {
            <p class="sg-hero-greet">@GreetingByHour</p>
        }
        @if (!string.IsNullOrEmpty(_openStatusText))
        {
            <p class="sg-hero-open @(_openNow ? "is-open" : "is-closed")">@_openStatusText</p>
        }
        <div class="sg-hero-cta">
            <a href="/shop" class="sg-btn sg-btn-solid sg-btn-lg">@T("Đặt xôi ngay", "Order now")</a>
            <a href="#thuc-don" class="sg-btn sg-btn-ghost sg-btn-lg">@T("Xem thực đơn", "View menu")</a>
        </div>
        @* LD2: lối tắt đặt theo nhu cầu *@
        <div class="sg-hero-quicklinks">
            <a href="/dat-tiec">@T("Đặt tiệc", "Party catering")</a>
            <span aria-hidden="true">·</span>
            <a href="/dat-so-luong-lon">@T("Đặt số lượng lớn", "Bulk order")</a>
        </div>
    </div>
    <a class="sg-scroll" href="#gioi-thieu" aria-label="Cuộn xuống">
        <span class="sg-scroll-mouse"><span class="sg-scroll-wheel"></span></span>
        <span class="sg-scroll-text">Cuộn xuống</span>
    </a>
</section>

<!-- BADGE CHẤT LƯỢNG + SỐ LIỆU (items 6, 7) -->
<div class="sg-trustbar">
    <div class="sg-container">
        <div class="sg-badges">
            <span class="sg-qbadge">🌾 Gạo nếp cái hoa vàng</span>
            <span class="sg-qbadge">🔥 Đồ 2 lửa đúng làng nghề</span>
            <span class="sg-qbadge">🚫 Không chất bảo quản</span>
        </div>
        @if (_stats != null && (_stats.TotalOrders > 0 || _stats.ReviewCount > 0))
        {
            <div class="sg-stats">
                <div class="sg-stat"><strong>@_stats.TotalOrders.ToString("N0")</strong><span>đơn đã giao</span></div>
                <div class="sg-stat"><strong>@_stats.AvgRating.ToString("0.0")/5</strong><span>điểm đánh giá</span></div>
                <div class="sg-stat"><strong>@_stats.ReviewCount.ToString("N0")</strong><span>lượt đánh giá</span></div>
            </div>
        }
        @* LD3: 3 đánh giá thật ngay dưới hero — chỉ hiện khi DB có review *@
        @if (_reviews != null && _reviews.Count > 0)
        {
            <div class="sg-trust-reviews">
                @foreach (var review in _reviews.Take(3))
                {
                    <div class="sg-trust-review">
                        <div class="sg-review-stars">@(new string('★', Math.Max(1, Math.Min(5, review.Rating))))@(new string('☆', 5 - Math.Max(1, Math.Min(5, review.Rating))))</div>
                        <p class="sg-trust-review-text">"@review.Comment"</p>
                        <p class="sg-trust-review-name">— @(string.IsNullOrWhiteSpace(review.MaskedCustomerPhone) ? MaskPhone(review.CustomerPhone) : review.MaskedCustomerPhone)</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- 3. GIỚI THIỆU -->
<section class="sg-section" id="gioi-thieu">
    <div class="sg-container">
        <p class="sg-poem">Dẻo thơm hạt nếp đầu ngày,<br />Gói xôi nóng hổi trao tay người thương.</p>
        <div class="sg-intro-grid">
            <div class="sg-intro-text">
                <p class="sg-eyebrow">Giới thiệu</p>
                <h2 class="sg-h2">@StoryTitleText</h2>
                <p class="sg-lead">@StoryBodyText</p>
                <a href="/shop" class="sg-btn sg-btn-outline">Đặt xôi ngay →</a>
            </div>
            <div class="sg-intro-img sg-reveal">
                <img loading="lazy" src="@Img(_content.HeroImageUrl, PlaceholderImage)" alt="Xôi Phú Thượng" />
                <div class="sg-intro-badge">
                    <strong>100+ năm</strong>
                    <span>Làng nghề Phú Thượng</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. TRẢI NGHIỆM -->
<section class="sg-section sg-why">
    <div class="sg-container">
        <div class="sg-sec-head">
            <p class="sg-eyebrow">Trải nghiệm</p>
            <h2 class="sg-h2">Vì sao chọn Xôi Phú Thượng</h2>
        </div>
        <div class="sg-why-grid">
            <div class="sg-why-card">
                <div class="sg-why-icon">🌾</div>
                <h3>Nếp cái hoa vàng</h3>
                <p>Chọn gạo nếp cái hoa vàng hạt mẩy, ngâm đủ giờ để xôi dẻo thơm mà không nát.</p>
            </div>
            <div class="sg-why-card">
                <div class="sg-why-icon">🎋</div>
                <h3>Đồ bằng chõ tre</h3>
                <p>Xôi được đồ trong chõ tre truyền thống của làng nghề, giữ trọn hương nếp mới.</p>
            </div>
            <div class="sg-why-card">
                <div class="sg-why-icon">🔥</div>
                <h3>Ra lò mỗi sáng</h3>
                <p>Xôi ra lò từ 5h sáng, gói lá chuối giữ nóng hổi.</p>
            </div>
        </div>
    </div>
</section>

<!-- VIDEO MÓN ĂN (item 11) -->
@if (!string.IsNullOrWhiteSpace(_content.VideoUrl))
{
    <section class="sg-section sg-video-sec">
        <div class="sg-container sg-video-inner">
            <p class="sg-eyebrow">Xem tận mắt</p>
            <h2 class="sg-h2">@(string.IsNullOrWhiteSpace(_content.VideoTitle) ? "Xôi nóng hổi mỗi sáng" : _content.VideoTitle)</h2>
            <div class="sg-video-wrap sg-reveal">
                <video controls preload="none" poster="@Img(_content.HeroImageUrl, null)">
                    <source src="@_content.VideoUrl" type="video/mp4" />
                </video>
            </div>
        </div>
    </section>
}

<!-- 6. CÂU CHUYỆN LÀNG NGHỀ -->
<section class="sg-section sg-story">
    <div class="sg-container sg-story-inner">
        <p class="sg-eyebrow">Câu chuyện</p>
        <h2 class="sg-h2">Làng nghề Phú Thượng</h2>
        <p>Phú Thượng là làng nghề nấu xôi lâu đời ven sông Hồng của Hà Nội. Từ tờ mờ sáng, khắp làng đã thơm mùi nếp mới đồ trong chõ tre — mùi thơm ấy theo chân các gánh xôi đi khắp phố phường Thủ đô, trở thành ký ức của bao thế hệ người Hà Nội.</p>
        <p>Chúng tôi giữ đúng cách làm của làng: gạo ngon, đồ hai lửa, gói lá chuối. Không vội vàng, không đường tắt — chỉ có gói xôi nóng hổi, dẻo thơm như ngày xưa.</p>
    </div>
</section>

<!-- TIMELINE LÀNG NGHỀ (item 8) -->
<section class="sg-section sg-timeline-sec">
    <div class="sg-container">
        <p class="sg-eyebrow">Hành trình</p>
        <h2 class="sg-h2">Hơn 100 năm giữ lửa</h2>
        <div class="sg-timeline">
            <div class="sg-tl-item sg-reveal">
                <div class="sg-tl-dot"></div>
                <div class="sg-tl-card">
                    <strong>Đầu thế kỷ 20</strong>
                    <p>Người Phú Thượng đã nổi tiếng với nghề đồ xôi, gánh hàng rong khắp Hà Nội.</p>
                </div>
            </div>
            <div class="sg-tl-item sg-reveal">
                <div class="sg-tl-dot"></div>
                <div class="sg-tl-card">
                    <strong>1980 – 2000</strong>
                    <p>Xôi Phú Thượng thành thương hiệu, có mặt trong mâm cỗ cưới hỏi khắp Thủ đô.</p>
                </div>
            </div>
            <div class="sg-tl-item sg-reveal">
                <div class="sg-tl-dot"></div>
                <div class="sg-tl-card">
                    <strong>Hôm nay</strong>
                    <p>Giữ nguyên cách làm của làng, phục vụ hàng nghìn suất xôi mỗi tháng — cả online lẫn tại quán.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ĐÁNH GIÁ KHÁCH HÀNG (item 5) -->
@if (_reviews != null && _reviews.Count > 0)
{
    <section class="sg-section sg-reviews-sec">
        <div class="sg-container">
            <p class="sg-eyebrow">Khách nói gì</p>
            <h2 class="sg-h2">Đánh giá thật từ khách hàng</h2>
            <div class="sg-review-track" id="sg-reviews">
                @foreach (var review in _reviews.Take(12))
                {
                    <div class="sg-review-card sg-reveal">
                        <div class="sg-review-stars">@(new string('★', Math.Max(1, Math.Min(5, review.Rating))))@(new string('☆', 5 - Math.Max(1, Math.Min(5, review.Rating))))</div>
                        <p class="sg-review-text">"@review.Comment"</p>
                        <p class="sg-review-name">— @(string.IsNullOrWhiteSpace(review.MaskedCustomerPhone) ? MaskPhone(review.CustomerPhone) : review.MaskedCustomerPhone)</p>
                        @if (!string.IsNullOrWhiteSpace(review.AdminReply))
                        {
                            <p class="sg-review-reply">💬 Quán: @review.AdminReply</p>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- VIDEO REVIEW KHÁCH/KOL (item 38) -->
@if (!string.IsNullOrWhiteSpace(_content.ReviewVideoUrl))
{
    <section class="sg-section sg-video-sec">
        <div class="sg-container sg-video-inner">
            <p class="sg-eyebrow">Khách review</p>
            <h2 class="sg-h2">@(string.IsNullOrWhiteSpace(_content.ReviewVideoTitle) ? "Khách nói gì về xôi quán" : _content.ReviewVideoTitle)</h2>
            <div class="sg-video-wrap sg-reveal">
                <video controls preload="none">
                    <source src="@_content.ReviewVideoUrl" type="video/mp4" />
                </video>
            </div>
        </div>
    </section>
}

<!-- GALLERY ẢNH KHÁCH CHECK-IN (item 12) -->
@if (_gallery != null && _gallery.Count > 0)
{
    <section class="sg-section sg-gallery-sec">
        <div class="sg-container">
            <p class="sg-eyebrow">Check-in</p>
            <h2 class="sg-h2">Khách hàng của quán</h2>
            <div class="sg-gallery-grid">
                @foreach (var photo in _gallery.Take(8))
                {
                    <figure class="sg-g-item sg-reveal">
                        <img loading="lazy" decoding="async" src="@photo.ImageUrl" alt="@photo.Caption" />
                        @if (!string.IsNullOrWhiteSpace(photo.Caption))
                        {
                            <figcaption>@photo.Caption</figcaption>
                        }
                    </figure>
                }
            </div>
        </div>
    </section>
}

<!-- 7. BANNER ĐẶT XÔI -->
<section class="sg-cta" id="cta-dat-xoi">
    <div class="sg-cta-bg" style="@CtaBgStyle"></div>
    <div class="sg-cta-overlay"></div>
    <div class="sg-cta-inner">
        <p class="sg-cta-eyebrow">Giao nóng mỗi sáng</p>
        <h2 class="sg-cta-title">Đặt xôi ngay</h2>
        <p class="sg-cta-sub">Đặt online hoặc gọi hotline — quán chuẩn bị trong 15 phút.</p>
        <div class="sg-cta-btns">
            <a href="/shop" class="sg-btn sg-btn-solid sg-btn-lg">Đặt xôi ngay →</a>
            @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
            {
                <a href="tel:@_content.ContactPhone" class="sg-btn sg-btn-ghost sg-btn-lg">📞 @_content.ContactPhone</a>
            }
        </div>
    </div>
</section>

<!-- 8. THỰC ĐƠN -->
<section class="sg-section" id="thuc-don">
    <div class="sg-container">
        <div class="sg-sec-head">
            <p class="sg-eyebrow">Thực đơn</p>
            <h2 class="sg-h2">@MenuTitleText</h2>
            <div class="sg-search-wrap">
                <input class="sg-search" @bind="_searchTerm" @bind:event="oninput" placeholder="🔍 Tìm món: gấc, xéo, ngũ sắc..." aria-label="Tìm món ăn" />
            </div>
        </div>
        <div class="sg-tabs" role="tablist">
            <button class="sg-tab @(_menuTab == "xoi" ? "active" : "")" @onclick='() => _menuTab = "xoi"'>Xôi truyền thống</button>
            <button class="sg-tab @(_menuTab == "combo" ? "active" : "")" @onclick='() => _menuTab = "combo"'>Combo tiết kiệm</button>
            <button class="sg-tab @(_menuTab == "tiec" ? "active" : "")" @onclick='() => _menuTab = "tiec"'>Đặt tiệc &amp; Cúng giỗ</button>
        </div>

        @if (_menuTab == "xoi")
        {
            <div class="sg-price-filter">
                <button class="@(_priceFilter == "all" ? "active" : "")" aria-pressed="@(_priceFilter == "all")" @onclick='() => _priceFilter = "all"'>Tất cả</button>
                <button class="@(_priceFilter == "under30" ? "active" : "")" aria-pressed="@(_priceFilter == "under30")" @onclick='() => _priceFilter = "under30"'>Dưới 30k</button>
                <button class="@(_priceFilter == "30to50" ? "active" : "")" aria-pressed="@(_priceFilter == "30to50")" @onclick='() => _priceFilter = "30to50"'>30k – 50k</button>
                <button class="@(_priceFilter == "over50" ? "active" : "")" aria-pressed="@(_priceFilter == "over50")" @onclick='() => _priceFilter = "over50"'>Trên 50k</button>
            </div>
            <div class="sg-dish-grid">
                @foreach (var product in FilteredMenuProducts())
                {
                    <div class="sg-dish-card sg-reveal" @key="product.Id">
                        <div class="sg-dish-imgwrap">
                            @if (IsSoldOut(product))
                            {
                                <span class="sg-badge sg-badge-out">Tạm hết</span>
                            }
                            else if (IsMorningDish)
                            {
                                <span class="sg-badge sg-badge-morning">🌅 Xôi sáng</span>
                            }
                            <img loading="lazy" decoding="async" src="@ProductImage(product)" alt="@product.Name" />
                            @if (CanOrder(product))
                            {
                                <div class="sg-dish-quick">
                                    <button @onclick="() => AddToCart(product)">+ Thêm nhanh</button>
                                </div>
                            }
                        </div>
                        <div class="sg-dish-body">
                            <h3 class="sg-dish-name">@product.Name</h3>
                            @* bug-hunt 2026-10-19: hiện giá KM (giá thực trả khi bấm Thêm vào giỏ) thay vì giá gốc. *@
                            <div class="sg-dish-price">@FormatPrice(ShopProductModel.EffectivePrice(product, product.Price))<small>@UnitSuffix(product)</small></div>
                            <button class="sg-btn sg-btn-solid sg-btn-block" @onclick="() => AddToCart(product)" disabled="@(!CanOrder(product))">
                                @AddButtonLabel(product)
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_menuTab == "combo")
        {
            @if (_combos.Count == 0)
            {
                <p class="sg-muted sg-center"><em>Hiện chưa có combo nào — mời bạn xem các món xôi.</em></p>
            }
            <div class="sg-dish-grid">
                @foreach (var combo in _combos)
                {
                    <div class="sg-dish-card sg-reveal" @key="combo.Id">
                        <div class="sg-dish-body sg-combo-body">
                            <h3 class="sg-dish-name">@combo.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(combo.Description))
                            {
                                <p class="sg-combo-desc">@combo.Description</p>
                            }
                            @if (combo.Items != null && combo.Items.Count > 0)
                            {
                                <p class="sg-combo-items">@combo.Items.Count món trong combo</p>
                            }
                            <div class="sg-dish-price">@FormatPrice(combo.Price)</div>
                            <button class="sg-btn sg-btn-solid sg-btn-block" @onclick="() => AddComboToCart(combo)" disabled="@OrdersPaused">
                                Thêm combo vào giỏ
