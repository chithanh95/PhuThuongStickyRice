    private static List<string> AllImageUrls(string imageUrlsJson)
    {
        var list = new List<string>();
        if (string.IsNullOrWhiteSpace(imageUrlsJson)) return list;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(imageUrlsJson);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) return list;
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                var s = el.GetString();
                if (!string.IsNullOrWhiteSpace(s)) list.Add(s);
            }
        }
        catch { }
        return list;
    }

    private static string FirstImageUrl(string imageUrlsJson)
    {
        if (string.IsNullOrWhiteSpace(imageUrlsJson))
        {
            return null;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(imageUrlsJson);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return null;
            }

            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var url = el.GetString()?.Trim();
                    if (!string.IsNullOrEmpty(url))
                    {
                        return url;
                    }
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return null;
    }

