@code {
    private LandingContentModel _content = new LandingContentModel();
    private List<ShopProductModel> _allProducts = new List<ShopProductModel>();
    private List<ComboModel> _combos = new List<ComboModel>();

    // Menu tabs: "xoi" | "combo" | "tiec".
    private string _menuTab = "xoi";

    // Upsell popup state.
    private bool _upsellVisible;
    private string _upsellAddedName;
    private List<ShopProductModel> _upsellProducts = new List<ShopProductModel>();

    // Best-seller ids (fail-soft) for the "Bán chạy" badges.
    private HashSet<Guid> _bestSellerIds = new HashSet<Guid>();

    private bool IsBestSeller(ShopProductModel p) =>
        p != null && (_bestSellerIds.Contains(p.Id) || p.IsSignature);

    private static bool IsXoi(ShopProductModel p) =>
        (p?.Code ?? "").StartsWith("XOI", StringComparison.OrdinalIgnoreCase);

    private static bool IsSoldOut(ShopProductModel p) =>
        !string.Equals(p?.Status, "Active", StringComparison.OrdinalIgnoreCase);

    /// <summary>Signature dishes: best sellers / signature first, max 6.</summary>
    private List<ShopProductModel> SignatureProducts =>
        _allProducts
            .Where(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => _bestSellerIds.Contains(p.Id) || p.IsSignature)
            .ThenBy(p => p.SortOrder)
            .ThenBy(p => p.Name)
            .Take(6)
            .ToList();

    /// <summary>All active xôi products for the "Xôi truyền thống" tab.</summary>
    private List<ShopProductModel> XoiProducts =>
        _allProducts
            .Where(p => IsXoi(p) && string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.SortOrder)
            .ThenBy(p => p.Name)
            .ToList();

    /// <summary>Zalo chat link: zalo.me/&lt;phone&gt; when a hotline is configured.</summary>
    private string ZaloUrl
    {
        get
        {
            var digits = new string((_content.ContactPhone ?? "").Where(char.IsDigit).ToArray());
            return string.IsNullOrEmpty(digits) ? "https://zalo.me/" : $"https://zalo.me/{digits}";
        }
    }

    private bool _loadFailed;

    private void RetryLoad()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

    // Flash banner + promo popup state.
    private bool _bannerDismissed;
    private bool _showPopup;
    private bool _popupChecked;
    private const string PopupSeenKey = "phuthuong.popup.seen";
    private bool _promoPopupEnabled = true;

    // Open-hours badge in the hero (fail-safe).
    private string _openStatusText;
    private bool _openNow;

    // Pause-orders state (fail-soft).
    private ShopSettingModel _shopSettings;
    private bool OrdersPaused => _shopSettings != null && !_shopSettings.AcceptingOrders;

    private string PauseReasonText =>
        _shopSettings != null && !string.IsNullOrWhiteSpace(_shopSettings.PausedReason)
            ? $": {_shopSettings.PausedReason}"
            : ".";

    // Policy links for the footer (fail-soft).
    private List<PolicyPageSummaryModel> _policies = new List<PolicyPageSummaryModel>();

    // Booking form (đặt xôi nhanh) — posts a quote request (api/quotes).

    // Landing conversion features (items 1-20).
