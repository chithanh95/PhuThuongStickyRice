    // LD1: giỏ hàng thay đổi (thêm/xóa từ tab khác) → cập nhật nút giỏ nổi.
    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    // LD4: đếm ngược chốt đơn, tính từ giờ mở/đóng trong shop settings.
    // - Quán đang mở: đếm tới giờ đóng (kịp giao sáng nay).
    // - Quán đã nghỉ: đếm tới giờ giao sáng mai (giờ mở + 30 phút).
    // Fail-soft: không tính được thì ẩn.
    private string _cutoffText;
    private System.Threading.Timer _cutoffTimer;

    private void UpdateCutoffText()
    {
        _cutoffText = null;
        try
        {
            if (_shopSettings == null || !_shopSettings.AcceptingOrders) return;
            var now = ShopHours.NowInVietnam();
            var open = ShopHours.ParseOpen(_shopSettings.OpenTime);
            var close = ShopHours.ParseClose(_shopSettings.CloseTime);
            var isOpen = ShopHours.IsOpen(_shopSettings.OpenTime, _shopSettings.CloseTime, now);
            if (isOpen)
            {
                var remain = close - now;
                if (remain <= TimeSpan.Zero) return;
                _cutoffText = T(
                    $"Đặt trong {(int)remain.TotalHours} giờ {remain.Minutes:D2} phút để kịp giao sáng nay",
                    $"Order within {(int)remain.TotalHours}h {remain.Minutes:D2}m for delivery this morning");
            }
            else
            {
                // Giao sáng: giờ mở + 30 phút (mặc định 6:30).
                var delivery = open.Add(TimeSpan.FromMinutes(30));
                var nowVn = DateTimeOffset.UtcNow.AddHours(7).DateTime;
                var target = nowVn.Date.Add(delivery);
                var isTomorrow = false;
                if (target <= nowVn)
                {
                    target = target.AddDays(1);
                    isTomorrow = true;
                }
                var remain = target - nowVn;
                if (remain <= TimeSpan.Zero || remain.TotalHours > 24) return;
                var deliveryLabel = $"{(int)delivery.TotalHours}h{delivery.Minutes:D2}";
                _cutoffText = T(
                    $"Đặt trong {(int)remain.TotalHours} giờ {remain.Minutes:D2} phút để kịp giao {deliveryLabel} {(isTomorrow ? "sáng mai" : "sáng nay")}",
                    $"Order within {(int)remain.TotalHours}h {remain.Minutes:D2}m for {deliveryLabel} delivery {(isTomorrow ? "tomorrow morning" : "this morning")}");
            }
        }
        catch { _cutoffText = null; }
    }

    private async Task PrintMenu()
    {
        try { await JSRuntime.InvokeVoidAsync("ptPrintMenu"); } catch { }
    }

    private async Task TrackView(Guid productId)
    {
        try { await JSRuntime.InvokeVoidAsync("ptPushRecentView", productId.ToString()); } catch { }
    }

    private async Task ShareDish(ShopProductModel p)
    {
        await TrackView(p.Id);
        try
        {
            var url = Navigation.BaseUri.TrimEnd('/') + "/shop?ref=landing";
            var res = await JSRuntime.InvokeAsync<string>("ptShare", p.Name, $"Xôi Phú Thượng - {p.Name} {p.Price:N0}đ", url);
            if (res == "copied") Toasts.Show("Đã copy link món ăn!");
        }
        catch { }
    }

    private async Task SubmitSubscribe()
    {
        _subMsg = null;
        if (_subDone) return;
        var digits = new string((_subPhone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length < 9)
        {
            _subMsg = "Vui lòng nhập số điện thoại hợp lệ.";
            return;
        }
        _subSending = true;
        try
        {
            if (await LandingService.SubscribeAsync(digits))
            {
                _subDone = true;
            }
            else
            {
                _subMsg = "Chưa gửi được, vui lòng thử lại.";
            }
        }
        catch
        {
            _subMsg = "Chưa gửi được, vui lòng thử lại.";
        }
        _subSending = false;
    }

    private bool IsMorningDish => DateTime.Now.Hour >= 5 && DateTime.Now.Hour < 10;

    private IEnumerable<ShopProductModel> FilteredMenuProducts()
    {
        var q = SearchedProducts(XoiProducts).AsEnumerable();
        return _priceFilter switch
        {
            "under30" => q.Where(p => p.Price < 30000),
            "30to50" => q.Where(p => p.Price >= 30000 && p.Price <= 50000),
            "over50" => q.Where(p => p.Price > 50000),
            _ => q,
        };
    }

    private string CountdownEndIso => _content.PromoCountdownEnd?.ToString("o");

    private string T(string vi, string en) => AppI18n.CurrentLang == "en" ? en : vi;

    private string GreetingByHour
    {
        get
        {
            var h = DateTime.Now.Hour;
            if (h >= 5 && h < 10) return "☀️ Chào buổi sáng! Xôi nóng vừa ra lò.";
            if (h >= 10 && h < 14) return "🍱 Xôi trưa dẻo thơm, ăn là no tới chiều.";
            if (h >= 14 && h < 18) return "🌤️ Xế chiều thèm xôi? Quán còn nóng hổi.";
            return "🌙 Đặt xôi sáng mai từ bây giờ, mai giao nóng.";
        }
    }

    private IEnumerable<ShopProductModel> SearchedProducts(IEnumerable<ShopProductModel> source)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return source;
        var t = _searchTerm.Trim().ToLower();
        return source.Where(p => (p.Name ?? "").ToLower().Contains(t));
    }

    private string MaskPhone(string phone)
    {
        var d = new string((phone ?? "").Where(char.IsDigit).ToArray());
        if (d.Length < 5) return "Khách hàng";
        return d.Substring(0, 3) + "***" + d.Substring(d.Length - 2);
    }

    public void Dispose()
    {
        AppI18n.OnChange -= OnLangChanged;
        CartState.OnChange -= OnCartChanged;
        try { _cutoffTimer?.Dispose(); } catch { }
    }
