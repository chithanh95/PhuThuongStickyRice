    protected override async Task OnInitializedAsync()
    {
        try { _isDark = await JSRuntime.InvokeAsync<string>("ptGetTheme") == "dark"; } catch { }

        try
        {
            var settings = await ShopSettingsService.GetPublicAsync();
            _shopSettings = settings;
            if (settings != null)
            {
                var (isOpen, text) = ShopHours.StatusText(settings.OpenTime, settings.CloseTime);
                _openNow = isOpen;
                _openStatusText = text;
            }
        }
        catch (Exception)
        {
        }

        try
        {
            _policies = await PolicyService.GetPublicListAsync()
                ?? new List<PolicyPageSummaryModel>();
        }
        catch (Exception)
        {
            _policies = new List<PolicyPageSummaryModel>();
        }

        try
        {
            _content = await LandingService.GetContentAsync() ?? new LandingContentModel();
        }
        catch (Exception)
        {
            _loadFailed = true;
            _content = new LandingContentModel();
        }

        try
        {
            var flags = await Wave4Service.GetFeatureFlagMapAsync();
            _promoPopupEnabled = flags == null || !flags.TryGetValue("promo-popup", out var on) || on;
        }
        catch (Exception)
        {
        }

        try
        {
            var paged = await ShopService.GetProductsAsync();
            _allProducts = paged?.Items ?? new List<ShopProductModel>();
        }
        catch (Exception)
        {
            _loadFailed = true;
            _allProducts = new List<ShopProductModel>();
        }

        try
        {
            var ids = await ShopService.GetBestSellerIdsAsync();
            if (ids != null) _bestSellerIds = new HashSet<Guid>(ids);
        }
        catch (Exception)
        {
        }

        try
        {
            _combos = (await ShopService.GetCombosAsync())
                ?.Where(c => c.IsActive).ToList() ?? new List<ComboModel>();
        }
        catch (Exception)
        {
            _combos = new List<ComboModel>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_popupChecked && _content.PopupActive && _promoPopupEnabled)
        {
            _popupChecked = true;
            try
            {
                var seen = await JSRuntime.InvokeAsync<string>("localStorage.getItem", PopupSeenKey);
                if (string.IsNullOrEmpty(seen))
                {
                    _showPopup = true;
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
            }
        }
    }

    private async Task DismissPopup()
    {
        _showPopup = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", PopupSeenKey, "1");
        }
        catch (Exception)
        {
        }
    }

    /// <summary>Add one item to the cart.</summary>
    private void AddToCart(ShopProductModel product)
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.");
            return;
        }
        if (IsSoldOut(product))
        {
            Toasts.Show($"'{product?.Name}' tạm hết, vui lòng chọn món khác.");
            return;
        }
        CartState.Add(product, 1);

        // Upsell: xôi → suggest Chả cốm / Chả giò.
        if (IsXoi(product))
        {
            var upsells = _allProducts
                .Where(p => !IsXoi(p) && string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Code == "CHA-COM" ? 0 : p.Code == "CHA-GIO" ? 1 : 2)
                .ThenBy(p => p.Price)
                .Take(4)
                .ToList();
            if (upsells.Count > 0)
            {
                _upsellProducts = upsells;
                _upsellAddedName = product.Name;
                _upsellVisible = true;
                return;
            }
        }

        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void AddComboToCart(ComboModel combo)
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.");
            return;
        }
        CartState.AddCombo(combo);
        Toasts.Show($"Đã thêm {combo.Name} vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void AddUpsell(ShopProductModel product)
    {
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void CloseUpsell()
