@page "/"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Landing.Models
@using PhuThuongStickyRice.Web.Components.Landing.Services
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject LandingService LandingService
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject PolicyService PolicyService
@inject CartState CartState
@inject ToastService Toasts
@inject PhuThuongStickyRice.Web.Components.Admin.Services.Wave4Service Wave4Service
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject NavigationManager Navigation

@* Wave 6d (item 38): friendly full-page error when the initial API load
   fails, reusing the PWA offline.html visual language. *@
@if (_loadFailed)
{
    <div class="card" style="background: #f5ebcd; border: none;">
        <div class="card-body text-center py-5">
            <div style="font-size: 4rem;">😞</div>
            <h2 style="font-family: Georgia, serif; color: #7a1b2e;">Không kết nối được tới máy chủ</h2>
            <p class="mb-4" style="color: #4a2b1a;">Kiểm tra mạng rồi thử lại.</p>
            <button class="btn" style="background: #7a1b2e; color: #fff; padding: 12px 28px; border-radius: 6px;" @onclick="RetryLoad">Thử lại</button>
        </div>
    </div>
}
else
{

<!-- 0. FLASH BANNER (item 94) -->
@if (!_bannerDismissed && _content.FlashBannerActive && !string.IsNullOrWhiteSpace(_content.FlashBannerText))
{
    <div class="rw-flash" role="alert">
        <span>⚡ @_content.FlashBannerText</span>
        <button type="button" class="rw-flash-close" aria-label="Đóng" @onclick="() => _bannerDismissed = true">×</button>
    </div>
}

<!-- 1. STICKY HEADER -->
<header class="rw-header">
    <nav class="rw-nav">
        <a href="#gioi-thieu">Giới thiệu</a>
        <a href="#thuc-don">Thực đơn</a>
        <a href="#danh-gia">Đánh giá</a>
        <a href="#lien-he">Liên hệ</a>
    </nav>
    <a class="rw-logo" href="/">
        <span class="rw-logo-main">Xôi Phú Thượng</span>
        <span class="rw-logo-sub">Vietnamese Sticky Rice</span>
    </a>
    @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
    {
        <a class="rw-hotline" href="tel:@_content.ContactPhone">Hotline: @_content.ContactPhone</a>
    }
    else
    {
        <a class="rw-hotline" href="/shop">Đặt xôi ngay</a>
    }
</header>

<!-- 2. HERO -->
<section class="rw-hero">
    <div class="rw-hero-inner">
        <div class="rw-hero-text">
            @if (!string.IsNullOrEmpty(_openStatusText))
            {
                <div class="rw-openbadge @(_openNow ? "is-open" : "is-closed")">@_openStatusText</div>
            }
            <p class="rw-hero-kicker">Xôi Phú Thượng &bull; Vietnamese Cuisine</p>
            <h1 class="rw-hero-title">@_content.HeroTitle</h1>
            <p class="rw-hero-tag">@_content.HeroTagline</p>
            <div class="rw-hero-cta">
                <a href="/shop" class="rw-btn rw-btn-brick">@_content.HeroButtonText</a>
                <a href="#thuc-don" class="rw-btn rw-btn-ghost">Xem thực đơn</a>
            </div>
        </div>
        <div class="rw-hero-imgwrap">
            <img loading="lazy" src="@Img(_content.HeroImageUrl, "_content/PhuThuongStickyRice.Web.Components/images/xoi-gac.svg")"
                 alt="Xôi Phú Thượng" class="rw-hero-img" />
        </div>
    </div>
</section>

<!-- 3. GIỚI THIỆU -->
<section class="rw-section" id="gioi-thieu">
    <div class="rw-sec-head">
        <h2 class="rw-sec-title">@_content.StoryTitle</h2>
        <div class="rw-sec-div"><span></span><em>Xoi Phu Thuong Vietnamese Cuisine</em><span></span></div>
    </div>
    <div class="rw-about-imgs">
        <img loading="lazy" src="@Img(_content.MenuImage1Url, "_content/PhuThuongStickyRice.Web.Components/images/xoi-gac.svg")" alt="@_content.MenuLabel1" />
        <img loading="lazy" src="@Img(_content.MenuImage2Url, "_content/PhuThuongStickyRice.Web.Components/images/xoi-xeo.svg")" alt="@_content.MenuLabel2" />
        <img loading="lazy" src="@Img(_content.MenuImage3Url, "_content/PhuThuongStickyRice.Web.Components/images/xoi-ngu-sac.svg")" alt="@_content.MenuLabel3" />
    </div>
    <p class="rw-about-text">@_content.StoryBody</p>
    <div class="rw-center">
        <a href="/shop" class="rw-btn rw-btn-brick">Đặt xôi ngay</a>
    </div>
</section>

<!-- 4. THỰC ĐƠN -->
<section class="rw-section rw-section-white" id="thuc-don">
    <div class="rw-sec-head">
        <h2 class="rw-sec-title">@_content.MenuTitle</h2>
        <div class="rw-sec-div"><span></span><em>Thực đơn hôm nay</em><span></span></div>
        @if (_todaySold > 0)
        {
            <p class="rw-today-sold">🔥 Hôm nay đã bán @_todaySold gói xôi</p>
        }
    </div>
    <div class="rw-dish-grid">
        @if (_quickProducts == null)
        {
            <p class="rw-muted"><em>Đang tải món ngon...</em></p>
        }
        else if (_quickProducts.Count == 0)
        {
            <p class="rw-muted"><em>Hiện chưa có món nào.</em></p>
        }
        else
        {
            @foreach (var product in _quickProducts)
            {
                <div class="rw-dish-card" @key="product.Id">
                    <div class="rw-dish-imgwrap">
                        <img loading="lazy" src="@ProductImage(product.Code)" alt="@product.Name" />
                    </div>
                    <div class="rw-dish-body">
                        <h3 class="rw-dish-name">@product.Name</h3>
                        <div class="rw-dish-price">@FormatPrice(product.Price)</div>
                        <button class="rw-btn rw-btn-brick rw-dish-btn" @onclick="() => QuickAdd(product)">Thêm vào giỏ</button>
                    </div>
                </div>
            }
        }
    </div>
    <div class="rw-center rw-menu-labels">
        <span class="rw-oval">@_content.MenuLabel1</span>
        <span class="rw-oval">@_content.MenuLabel2</span>
        <span class="rw-oval">@_content.MenuLabel3</span>
    </div>
    <div class="rw-center">
        <a href="/shop" class="rw-btn rw-btn-brick">@_content.HeroButtonText</a>
        <a href="/cart" class="rw-btn rw-btn-outline">Xem giỏ hàng →</a>
    </div>
</section>

<!-- 5. ĐÁNH GIÁ -->
@if (!string.IsNullOrWhiteSpace(_content.ReviewsEmbedHtml))
{
    <section class="rw-reviews-embed">
        @((MarkupString)_content.ReviewsEmbedHtml)
    </section>
}
@if (_publicReviews != null && _publicReviews.Count > 0)
{
    <section class="rw-section" id="danh-gia">
        <div class="rw-sec-head">
            <h2 class="rw-sec-title">Khách hàng nói gì</h2>
            <div class="rw-sec-div"><span></span><em>Đánh giá thật từ đơn hàng</em><span></span></div>
        </div>
        <div class="rw-review-grid">
            @foreach (var r in _publicReviews)
            {
                <div class="rw-review-card" @key="r.OrderNumber">
                    <div class="rw-stars">
                        @(new string('★', r.Rating))<span>@(new string('★', 5 - r.Rating))</span>
                    </div>
                    <p class="rw-review-text">@r.Comment</p>
                    @if (!string.IsNullOrWhiteSpace(r.AdminReply))
                    {
                        <p class="rw-review-reply"><strong>Quán trả lời:</strong> @r.AdminReply</p>
                    }
                    <div class="rw-review-who">— SĐT @MaskPhone(r.CustomerPhone)</div>
                </div>
            }
        </div>
    </section>
}

<!-- 6. TIN TỨC -->
<section class="rw-section rw-section-white">
    <div class="rw-sec-head">
        <h2 class="rw-sec-title">@_content.NewsTitle</h2>
        <div class="rw-sec-div"><span></span><em>Tin tức &amp; câu chuyện</em><span></span></div>
    </div>
    <div class="rw-news-grid">
        @if (_articles != null && _articles.Count > 0)
        {
            @foreach (var item in _articles)
            {
                <div class="rw-news-card" @key="item.Id">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img loading="lazy" src="@Img(item.ImageUrl, null)" alt="@item.Title" class="rw-news-img" />
                    }
                    <h3 class="rw-news-title">@item.Title</h3>
                    <p class="rw-news-body">@item.Body</p>
                    <div class="rw-news-date">@item.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                </div>
            }
        }
        else
        {
            @foreach (var item in _content.NewsItems)
            {
                <div class="rw-news-card" @key="item.Title">
                    <h3 class="rw-news-title">@item.Title</h3>
                    <p class="rw-news-body">@item.Body</p>
                    <div class="rw-news-date">@item.Source</div>
                </div>
            }
        }
    </div>
</section>

<!-- 6b. VIDEO -->
@if (!string.IsNullOrWhiteSpace(VideoEmbedUrl))
{
    <section class="rw-section">
        @if (!string.IsNullOrWhiteSpace(_content.VideoTitle))
        {
            <div class="rw-sec-head">
                <h2 class="rw-sec-title">@_content.VideoTitle</h2>
                <div class="rw-sec-div"><span></span><em>Video</em><span></span></div>
            </div>
        }
        <div class="rw-video-frame">
            <iframe src="@VideoEmbedUrl" title="@_content.VideoTitle"
                    frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    </section>
}

<!-- 7. ĐẶT XÔI NGAY (form) -->
<section class="rw-section rw-book" id="lien-he">
    <div class="rw-sec-head">
        <h2 class="rw-sec-title">Đặt xôi ngay</h2>
        <div class="rw-sec-div rw-sec-div-light"><span></span><em>Để lại thông tin, quán gọi lại xác nhận</em><span></span></div>
    </div>
    <div class="rw-book-grid">
        <form class="rw-book-form" @onsubmit="SubmitBooking">
            <label class="rw-field">
                <span>Tên của bạn *</span>
                <input @bind="_bookName" placeholder="Nguyễn Văn A" maxlength="100" />
            </label>
            <label class="rw-field">
                <span>Số điện thoại *</span>
                <input @bind="_bookPhone" placeholder="090..." inputmode="tel" maxlength="15" />
            </label>
            <label class="rw-field">
                <span>Số lượng (gói)</span>
                <input type="number" @bind="_bookQty" min="1" max="1000" />
            </label>
            <label class="rw-field">
                <span>Ghi chú</span>
                <textarea @bind="_bookNotes" rows="3" placeholder="Giao lúc mấy giờ, địa chỉ..." maxlength="500"></textarea>
            </label>
            @if (!string.IsNullOrEmpty(_bookError))
            {
                <p class="rw-book-error">@_bookError</p>
            }
            @if (_bookSent)
            {
                <p class="rw-book-ok">✓ Cảm ơn bạn! Quán sẽ gọi lại xác nhận đơn ngay.</p>
            }
            else
            {
                <button type="submit" class="rw-btn rw-btn-orange" disabled="@_bookSending">
                    @(_bookSending ? "Đang gửi..." : "Gửi")
                </button>
            }
        </form>
        <div class="rw-book-side">
            <div class="rw-book-logo">Xôi Phú Thượng<small>Vietnamese Sticky Rice</small></div>
            <p class="rw-book-note">Chúng tôi hân hạnh được phục vụ quý khách.</p>
            <ul class="rw-contact-list">
                @if (!string.IsNullOrWhiteSpace(_content.ContactAddress))
                {
                    <li><span class="oi oi-home" aria-hidden="true"></span> @_content.ContactAddress</li>
                }
                @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
                {
                    <li><span class="oi oi-phone" aria-hidden="true"></span> @_content.ContactPhone</li>
                }
                @if (!string.IsNullOrWhiteSpace(_content.ContactEmail))
                {
                    <li><span class="oi oi-envelope-closed" aria-hidden="true"></span> @_content.ContactEmail</li>
                }
            </ul>
        </div>
    </div>
</section>

<!-- 8. FOOTER -->
<footer class="rw-footer">
    <div class="rw-foot-grid">
        <div class="rw-foot-col">
            <h3 class="rw-foot-title">@_content.FooterTitle</h3>
            <ul class="rw-contact-list">
                @if (!string.IsNullOrWhiteSpace(_content.ContactAddress))
                {
                    <li><span class="oi oi-home" aria-hidden="true"></span> @_content.ContactAddress</li>
                }
                @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
                {
                    <li><span class="oi oi-phone" aria-hidden="true"></span> @_content.ContactPhone</li>
                }
                @if (!string.IsNullOrWhiteSpace(_content.ContactEmail))
                {
                    <li><span class="oi oi-envelope-closed" aria-hidden="true"></span> @_content.ContactEmail</li>
                }
            </ul>
            <a href="/shop" class="rw-btn rw-btn-brick">@_content.FooterButtonText</a>
        </div>
        <div class="rw-foot-col">
            <div class="rw-foot-imgs">
                <img loading="lazy" src="_content/PhuThuongStickyRice.Web.Components/images/xoi-do.svg" alt="Xôi đỗ" />
                <img loading="lazy" src="_content/PhuThuongStickyRice.Web.Components/images/xoi-vo.svg" alt="Xôi vò" />
                <img loading="lazy" src="_content/PhuThuongStickyRice.Web.Components/images/xoi-xeo.svg" alt="Xôi xéo" />
                <img loading="lazy" src="_content/PhuThuongStickyRice.Web.Components/images/xoi-gac.svg" alt="Xôi gấc" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_content.MapEmbedUrl))
        {
            <div class="rw-foot-col">
                <div class="rw-map">
                    <iframe src="@_content.MapEmbedUrl" title="Bản đồ" frameborder="0"
                            allowfullscreen loading="lazy"></iframe>
                </div>
            </div>
        }
    </div>
    @if (_policies.Count > 0)
    {
        <div class="rw-policy-bar">
            @foreach (var p in _policies)
            {
                <a href="/chinh-sach/@p.Slug">@p.Title</a>
            }
            <a href="/faq">Câu hỏi thường gặp</a>
        </div>
    }
    <div class="rw-bottom-bar">&copy; 2026 Xôi Phú Thượng &mdash; Thổi hồn vào từng gói xôi</div>
</footer>

<!-- 9. PROMO POPUP (item 94) -->
@if (_showPopup)
{
    <div class="rw-popup-overlay" @onclick="DismissPopup">
        <div class="rw-popup" @onclick:stopPropagation>
            <button type="button" class="rw-popup-close" aria-label="Đóng" @onclick="DismissPopup">×</button>
            @if (!string.IsNullOrWhiteSpace(_content.PopupImageUrl))
            {
                <img loading="lazy" src="@Img(_content.PopupImageUrl, null)" alt="@_content.PopupTitle" class="rw-popup-img" />
            }
            <h3 class="rw-popup-title">@_content.PopupTitle</h3>
            <p class="rw-popup-body">@_content.PopupBody</p>
            <a href="/shop" class="rw-btn rw-btn-brick">Đặt ngay →</a>
        </div>
    </div>
}
} @* /_loadFailed else *@

@code {
    private LandingContentModel _content = new LandingContentModel();
    private List<ShopProductModel> _quickProducts;
    private long _todaySold;

    // Wave 6d (item 38): initial API load failed → full-page error state.
    private bool _loadFailed;

    /// <summary>Wave 6d (item 38): full reload after a failed initial load.</summary>
    private void RetryLoad()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

    // Item 93: news CMS articles (latest 3 published).
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.ArticleModel> _articles;

    // Item 87: public order reviews.
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.PublicReviewModel> _publicReviews;

    // Item 94: flash banner + promo popup state.
    private bool _bannerDismissed;
    private bool _showPopup;
    private bool _popupChecked;
    private const string PopupSeenKey = "phuthuong.popup.seen";

    // Item 105: promo-popup feature flag.
    private bool _promoPopupEnabled = true;

    // Wave 6a (item 22): open-hours display in the hero.
    private string _openStatusText;
    private bool _openNow;

    // Wave 6b (item 28): policy pages for the footer links (fail-soft).
    private List<PolicyPageSummaryModel> _policies = new List<PolicyPageSummaryModel>();

    /// <summary>
    /// Converts a YouTube watch/share URL to an embed URL.
    /// Returns null when no video is configured.
    /// </summary>
    private string VideoEmbedUrl
    {
        get
        {
            var url = (_content.VideoUrl ?? "").Trim();
            if (string.IsNullOrEmpty(url))
            {
                return null;
            }

            if (url.Contains("/embed/"))
            {
                return url;
            }

            // youtu.be/VIDEO_ID
            var shortIdx = url.IndexOf("youtu.be/", StringComparison.OrdinalIgnoreCase);
            if (shortIdx >= 0)
            {
                var id = url.Substring(shortIdx + "youtu.be/".Length).Split('?', '&')[0];
                return $"https://www.youtube.com/embed/{id}";
            }

            // youtube.com/watch?v=VIDEO_ID
            var vIdx = url.IndexOf("v=", StringComparison.OrdinalIgnoreCase);
            if (vIdx >= 0)
            {
                var id = url.Substring(vIdx + 2).Split('?', '&')[0];
                return $"https://www.youtube.com/embed/{id}";
            }

            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Wave 6a (item 22): open-hours badge in the hero (fail-safe —
        // the landing works fine with the built-in defaults).
        try
        {
            var settings = await ShopSettingsService.GetAsync();
            if (settings != null)
            {
                var (isOpen, text) = ShopHours.StatusText(settings.OpenTime, settings.CloseTime);
                _openNow = isOpen;
                _openStatusText = text;
            }
        }
        catch (Exception)
        {
        }

        // Wave 6b (item 28): policy links for the footer (fail-soft).
        try
        {
            _policies = await PolicyService.GetPublicListAsync()
                ?? new List<PolicyPageSummaryModel>();
        }
        catch (Exception)
        {
            _policies = new List<PolicyPageSummaryModel>();
        }

        try
        {
            _content = await LandingService.GetContentAsync() ?? new LandingContentModel();
        }
        catch (Exception)
        {
            // Wave 6d (item 38): landing content is the critical load.
            _loadFailed = true;
            _content = new LandingContentModel();
        }

        // Item 93: published articles; NewsItems JSON stays as fallback.
        try
        {
            _articles = (await LandingService.GetArticlesAsync())
                ?.Take(3).ToList() ?? new List<PhuThuongStickyRice.Web.Components.Admin.Models.ArticleModel>();
        }
        catch (Exception)
        {
            _articles = new List<PhuThuongStickyRice.Web.Components.Admin.Models.ArticleModel>();
        }

        // Item 87: public reviews (hidden reviews are excluded server-side).
        try
        {
            _publicReviews = (await LandingService.GetPublicReviewsAsync())
                ?.Take(6).ToList() ?? new List<PhuThuongStickyRice.Web.Components.Admin.Models.PublicReviewModel>();
        }
        catch (Exception)
        {
            _publicReviews = new List<PhuThuongStickyRice.Web.Components.Admin.Models.PublicReviewModel>();
        }

        // Item 105: promo-popup feature flag (fail open).
        try
        {
            var flags = await Wave4Service.GetFeatureFlagMapAsync();
            _promoPopupEnabled = flags == null || !flags.TryGetValue("promo-popup", out var on) || on;
        }
        catch (Exception)
        {
        }

        try
        {
            var paged = await ShopService.GetProductsAsync();
            _quickProducts = (paged.Items ?? new List<ShopProductModel>()).Take(3).ToList();
        }
        catch (Exception)
        {
            // Wave 6d (item 38): quick-order strip needs products.
            _loadFailed = true;
            _quickProducts = new List<ShopProductModel>();
        }

        try
        {
            _todaySold = await ShopService.GetTodaySoldAsync();
        }
        catch (Exception)
        {
            _todaySold = 0;
        }
    }

    /// <summary>
    /// Item 94: shows the promo popup once per session. localStorage can only
    /// be touched after the first render (server-side prerendering safety).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_popupChecked && _content.PopupActive && _promoPopupEnabled)
        {
            _popupChecked = true;
            try
            {
                var seen = await JSRuntime.InvokeAsync<string>("localStorage.getItem", PopupSeenKey);
                if (string.IsNullOrEmpty(seen))
                {
                    _showPopup = true;
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                // localStorage unavailable — skip the popup silently.
            }
        }
    }

    private async Task DismissPopup()
    {
        _showPopup = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", PopupSeenKey, "1");
        }
        catch (Exception)
        {
        }
    }

    /// <summary>Masks a phone number for public display (090•…•5678).</summary>
    private static string MaskPhone(string phone)
    {
        var digits = new string((phone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length < 6)
        {
            return phone;
        }

        return $"{digits.Substring(0, 3)}•…•{digits.Substring(digits.Length - 4)}";
    }

    /// <summary>Add one item to the cart from the quick-order strip.</summary>
    private void QuickAdd(ShopProductModel product)
    {
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

    /// <summary>SVG placeholder per product code (matches the shop page).</summary>
    private static string ProductImage(string code)
    {
        var slug = (code ?? "").ToLowerInvariant()
            .Replace("xoi-", "xoi-")
            .Replace("_", "-");
        var file = slug switch
        {
            "xoi-gac" => "xoi-gac.svg",
            "xoi-do" => "xoi-do.svg",
            "xoi-xeo" => "xoi-xeo.svg",
            "xoi-vo" => "xoi-vo.svg",
            "xoi-ns" => "xoi-ngu-sac.svg",
            "xoi-ngu-sac" => "xoi-ngu-sac.svg",
            _ => "xoi-gac.svg"
        };
        return $"_content/PhuThuongStickyRice.Web.Components/images/{file}";
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    /// <summary>Uploaded image URL if set, otherwise the SVG placeholder.</summary>
    private string Img(string uploadedUrl, string fallbackSvg) =>
        !string.IsNullOrWhiteSpace(uploadedUrl)
            ? LandingService.ResolveImageUrl(uploadedUrl)
            : fallbackSvg;

    private bool HasFooterBg => !string.IsNullOrWhiteSpace(_content.FooterBackgroundUrl);

    private string FooterBgStyle => HasFooterBg
        ? $"background-image: url('{LandingService.ResolveImageUrl(_content.FooterBackgroundUrl)}');"
        : null;

    // Booking form (đặt xôi nhanh) — posts a quote request (api/quotes).
    private string _bookName = "";
    private string _bookPhone = "";
    private int _bookQty = 10;
    private string _bookNotes = "";
    private bool _bookSending;
    private bool _bookSent;
    private string _bookError;

    private async Task SubmitBooking()
    {
        _bookError = null;
        if (_bookSent) return;
        var digits = new string((_bookPhone ?? "").Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(_bookName) || digits.Length < 9)
        {
            _bookError = "Vui lòng nhập tên và số điện thoại hợp lệ.";
            return;
        }
        _bookSending = true;
        try
        {
            await ShopService.CreateQuoteAsync(new QuoteRequestModel
            {
                CustomerName = _bookName.Trim(),
                CustomerPhone = digits,
                Quantity = _bookQty > 0 ? _bookQty : 10,
                Notes = _bookNotes?.Trim()
            });
            _bookSent = true;
        }
        catch
        {
            _bookError = "Gửi chưa thành công, vui lòng thử lại hoặc gọi hotline cho quán.";
        }
        _bookSending = false;
    }
}
