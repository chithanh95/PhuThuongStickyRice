<!-- 9. ĐẶT TRƯỚC -->
<section class="sg-section sg-book" id="dat-xoi">
    <div class="sg-container">
        <div class="sg-book-grid">
            <div class="sg-book-info">
                <p class="sg-eyebrow">Đặt trước</p>
                <h2 class="sg-h2">Đặt xôi số lượng lớn</h2>
                <p class="sg-lead">Để lại thông tin — quán gọi lại xác nhận trong 15 phút.</p>
                <ul class="sg-book-contact">
                    @if (!string.IsNullOrWhiteSpace(_content.ContactAddress))
                    {
                        <li>📍 @_content.ContactAddress</li>
                    }
                    @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
                    {
                        <li>📞 <a href="tel:@_content.ContactPhone">@_content.ContactPhone</a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(_content.ContactEmail))
                    {
                        <li>✉️ @_content.ContactEmail</li>
                    }
                </ul>
            </div>
            <form class="sg-book-form" @onsubmit="SubmitBooking">
                <label class="sg-field">
                    <span>Tên của bạn *</span>
                    <input @bind="_bookName" placeholder="Nguyễn Văn A" maxlength="100" />
                </label>
                <label class="sg-field">
                    <span>Số điện thoại *</span>
                    <input @bind="_bookPhone" placeholder="090..." inputmode="tel" maxlength="15" />
                </label>
                <div class="sg-field-row">
                    <label class="sg-field">
                        <span>Món xôi</span>
                        <select @bind="_bookProductId">
                            <option value="@Guid.Empty">— Chọn món —</option>
                            @foreach (var p in _allProducts)
                            {
                                <option value="@p.Id">@p.Name — @p.Price.ToString("N0")đ</option>
                            }
                        </select>
                    </label>
                    <label class="sg-field sg-field-qty">
                        <span>Số lượng</span>
                        <input type="number" @bind="_bookQty" min="1" max="1000" />
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(_bookError))
                {
                    <p class="sg-form-error">@_bookError</p>
                }
                @if (_bookSent)
                {
                    <p class="sg-form-ok">✓ Đặt thành công! Quán sẽ gọi xác nhận.</p>
                }
                else
                {
                    <button type="submit" class="sg-btn sg-btn-solid sg-btn-block" disabled="@_bookSending">
                        @(_bookSending ? "Đang gửi..." : "Gửi đặt trước")
