    private async Task SubmitBooking()
    {
        _bookError = null;
        if (_bookSent) return;
        var digits = new string((_bookPhone ?? "").Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(_bookName) || digits.Length < 9)
        {
            _bookError = "Vui lòng nhập tên và số điện thoại hợp lệ.";
            return;
        }
        _bookSending = true;
        try
        {
            var product = _allProducts.FirstOrDefault(p => p.Id == _bookProductId);
            await ShopService.CreateQuoteAsync(new QuoteRequestModel
            {
                CustomerName = _bookName.Trim(),
                CustomerPhone = digits,
                Quantity = _bookQty > 0 ? _bookQty : 10,
                Notes = product != null ? $"Món: {product.Name}" : null,
                QuoteType = "Landing"
            });
            _bookSent = true;
        }
        catch
        {
            _bookError = "Gửi chưa thành công, vui lòng thử lại hoặc gọi hotline cho quán.";
        }
        _bookSending = false;
    }

    private async Task DoSpin()
    {
        _spinError = null; _spinResult = null;
        var digits = new string((_spinPhone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length < 9) { _spinError = "Nhập SĐT để quay nhé."; return; }
        _spinning = true;
        try
        {
            _spinResult = await LandingService.SpinAsync(digits);
            if (_spinResult != null && !_spinResult.Success) _spinError = _spinResult.Message;
        }
        catch { _spinError = "Chưa quay được, thử lại nhé."; }
        _spinning = false;
    }

