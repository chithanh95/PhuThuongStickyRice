    private async Task SubmitSubscribe()
    {
        _subMsg = null;
        if (_subDone) return;
        var digits = NormalizePhoneDigits(_subPhone);
        if (digits.Length < MinPhoneDigits)
        {
            _subMsg = "Vui lòng nhập số điện thoại hợp lệ.";
            return;
        }
        _subSending = true;
        try
        {
            if (await LandingService.SubscribeAsync(digits))
            {
                _subDone = true;
            }
            else
            {
                _subMsg = "Chưa gửi được, vui lòng thử lại.";
            }
        }
        catch
        {
            _subMsg = "Chưa gửi được, vui lòng thử lại.";
        }
        _subSending = false;
    }

    private bool IsMorningDish => DateTime.Now.Hour >= 5 && DateTime.Now.Hour < 10;

    private IEnumerable<ShopProductModel> FilteredMenuProducts()
    {
        var searchedProducts = SearchedProducts(XoiProducts).AsEnumerable();
        return _priceFilter switch
        {
            "under30" => searchedProducts.Where(p => p.Price < PriceBandLow),
            "30to50" => searchedProducts.Where(p => p.Price >= PriceBandLow && p.Price <= PriceBandHigh),
            "over50" => searchedProducts.Where(p => p.Price > PriceBandHigh),
            _ => searchedProducts,
        };
    }

