    /// <summary>Primary gallery photo when uploaded; otherwise the SVG placeholder per product code.</summary>
    private static string ProductImage(ShopProductModel product)
    {
        var first = FirstImageUrl(product?.ImageUrlsJson);
        if (!string.IsNullOrEmpty(first))
        {
            return first;
        }

        var slug = (product?.Code ?? "").ToLowerInvariant().Replace("_", "-");
        var file = slug switch
        {
            "xoi-gac" => "xoi-gac.jpg",
            "xoi-do" => "xoi-do.jpg",
            "xoi-xeo" => "xoi-xeo.jpg",
            "xoi-vo" => "xoi-vo.jpg",
            "xoi-lac" => "xoi-lac.jpg",
            "xoi-gac-kg" => "xoi-gac.jpg",
            "xoi-do-kg" => "xoi-do.jpg",
            "xoi-xeo-kg" => "xoi-xeo.jpg",
            "xoi-vo-kg" => "xoi-vo.jpg",
            "xoi-lac-kg" => "xoi-lac.jpg",
            "xoi-ns" => "xoi-ngu-sac.svg",
            "xoi-ngu-sac" => "xoi-ngu-sac.svg",
            _ => "xoi-gac.jpg"
        };
        return $"_content/PhuThuongStickyRice.Web.Components/images/{file}";
    }

    private static string FirstImageUrl(string imageUrlsJson)
    {
        if (string.IsNullOrWhiteSpace(imageUrlsJson))
        {
            return null;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(imageUrlsJson);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return null;
            }

            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var url = el.GetString()?.Trim();
                    if (!string.IsNullOrEmpty(url))
                    {
                        return url;
                    }
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return null;
    }

