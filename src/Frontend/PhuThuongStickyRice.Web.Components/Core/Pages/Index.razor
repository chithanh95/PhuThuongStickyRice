    /// <summary>Add one item to the cart.</summary>
    private void AddToCart(ShopProductModel product)
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.", kind: ToastKind.Warning);
            return;
        }
        if (IsSoldOut(product))
        {
            Toasts.Show($"'{product?.Name}' tạm hết, vui lòng chọn món khác.", kind: ToastKind.Warning);
            return;
        }
        // bug-hunt 2026-10-19: guard phòng thủ như /shop — món vừa hết suất
        // hoặc ra khỏi giờ bán sau khi trang đã load (nút đã disable nhưng
        // event cũ vẫn có thể lọt).
        if (!IsInSaleHours(product))
        {
            Toasts.Show($"'{product?.Name}' chưa tới giờ bán, bạn quay lại sau nhé.", kind: ToastKind.Warning);
            return;
        }
        if (IsDailyLimitReached(product))
        {
            Toasts.Show($"'{product?.Name}' đã hết suất hôm nay, vui lòng quay lại ngày mai.", kind: ToastKind.Warning);
            return;
        }
        CartState.Add(product, 1);

        // Upsell: xôi → suggest Chả cốm / Chả giò.
        if (IsXoi(product))
        {
            // bug-hunt 2026-10-19: lọc upsell bằng CanOrder như bản /shop —
            // trước đây chỉ lọc Status == "Active" nên popup vẫn gợi ý món đã
            // "Hết suất hôm nay" hoặc ngoài giờ bán.
            var upsells = _allProducts
                .Where(p => !IsXoi(p) && CanOrder(p))
                .OrderBy(p => p.Code == UpsellCodeChaCom ? 0 : p.Code == UpsellCodeChaGio ? 1 : 2)
                .ThenBy(p => p.Price)
                .Take(MaxUpsellSuggestions)
                .ToList();
            if (upsells.Count > 0)
            {
                _upsellProducts = upsells;
                _upsellAddedName = product.Name;
                _upsellVisible = true;
                return;
            }
        }

        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void AddComboToCart(ComboModel combo)
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.", kind: ToastKind.Warning);
            return;
        }
        CartState.AddCombo(combo);
        Toasts.Show($"Đã thêm {combo.Name} vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void AddUpsell(ShopProductModel product)
    {
        // bug-hunt 2026-10-19: guard phòng thủ như bản /shop — món vừa hết
        // suất/giờ bán sau khi popup đã mở thì từ chối thay vì cho vào giỏ.
        if (!CanOrder(product))
        {
            Toasts.Show("Món này vừa hết suất hoặc chưa tới giờ bán, bạn chọn món khác nhé.", kind: ToastKind.Warning);
            return;
        }
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

