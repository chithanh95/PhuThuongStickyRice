    private async Task ToggleChat()
    {
        _chatOpen = !_chatOpen;
        if (_chatOpen && string.IsNullOrEmpty(_chatSession))
        {
            _chatSession = Guid.NewGuid().ToString("N");
            try { await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pt-chat", _chatSession); } catch { }
        }
        if (_chatOpen) await LoadChatHistory();
    }

    private async Task LoadChatHistory()
    {
        try
        {
            _chatMessages = await LandingService.GetChatMessagesAsync(_chatSession) ?? new List<ChatMessageModel>();
        }
        catch { }
    }

    private async Task SendChat()
    {
        if (string.IsNullOrWhiteSpace(_chatInput)) return;
        var userMessage = _chatInput.Trim();
        _chatInput = "";
        _chatMessages.Add(new ChatMessageModel { Sender = "customer", Message = userMessage, CreatedAt = DateTime.Now });
        // 61: thử parse ý định đặt hàng
        try
        {
            var parsed = await LandingService.ParseOrderAsync(userMessage);
            if (parsed != null && parsed.IsOrderIntent && parsed.Items?.Count > 0)
            {
                _chatOrder = parsed;
                _chatMessages.Add(new ChatMessageModel { Sender = "shop", Message = $"Quán hiểu bạn muốn đặt: {string.Join(", ", parsed.Items.Select(i => $"{i.Quantity} {i.ProductName}"))}. Nhập SĐT và bấm xác nhận nhé!", CreatedAt = DateTime.Now });
                StateHasChanged();
                return;
            }
        }
        catch { }
        try { await LandingService.SendChatAsync(_chatSession, userMessage); } catch { }
    }








    private void ConfirmChatOrder()
    {
        if (_chatOrder?.Items == null || _chatOrder.Items.Count == 0) return;
        var digits = NormalizePhoneDigits(_chatPhone);
        if (digits.Length < MinPhoneDigits) { Toasts.Show("Nhập SĐT để đặt hàng.", kind: ToastKind.Warning); return; }
        // bug-hunt 2026-10-20: đường chat-order từng bypass guard CanOrder —
        // món "Hết suất hôm nay"/ngoài giờ bán vẫn lọt thẳng vào giỏ rồi sang
        // checkout (AddToCart/AddUpsell đã guard từ fix 2026-10-19).
        var added = 0;
        var skipped = 0;
        foreach (var item in _chatOrder.Items)
        {
            var product = _allProducts.FirstOrDefault(x => x.Id == item.ProductId);
            if (product == null) continue;
            if (!CanOrder(product)) { skipped++; continue; }
            CartState.Add(product, item.Quantity);
            added++;
        }
        if (added == 0)
        {
            Toasts.Show("Các món trong đơn chat hiện không đặt được (hết suất hoặc chưa tới giờ bán).", kind: ToastKind.Warning);
            return;
        }
        try { JSRuntime.InvokeVoidAsync("localStorage.setItem", "pt-checkout-phone", digits); } catch { }
        _chatOrder = null;
        if (skipped > 0) Toasts.Show("Một số món đã hết suất hoặc chưa tới giờ bán nên không thêm vào giỏ.", kind: ToastKind.Warning);
        Navigation.NavigateTo("/checkout");
    }


