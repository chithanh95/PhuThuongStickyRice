    protected override async Task OnInitializedAsync()
    {
        _isDark = await ShopTheme.ReadIsDarkAsync(JSRuntime);
        AppLocalizationService.OnChange -= OnLangChanged;
        AppLocalizationService.OnChange += OnLangChanged;
        CartState.OnChange -= OnCartChanged;
        CartState.OnChange += OnCartChanged;
        await AppLocalizationService.InitializeAsync();
        Funnel.Track(FunnelService.Events.LandingView, new Uri(Navigation.Uri).AbsolutePath);

        // perf-hunt 2026-10-19 (run 20:25): 17 HTTP request độc lập → chạy song
        // song bằng Task.WhenAll thay vì tuần tự (landing là trang truy cập nhiều
        // nhất; thời gian load ≈ 1 round-trip chậm nhất thay vì cộng dồn 17).
        // Mỗi request giữ try/catch fail-soft riêng như cũ; HttpClient thread-safe;
        // các task ghi vào field khác nhau nên không race.
        await Task.WhenAll(
            LoadSettingsAsync(),
            LoadPoliciesAsync(),
            LoadContentAsync(),
            LoadFeatureFlagsAsync(),
            LoadProductsAsync(),
            LoadReviewsAsync(),
            LoadStatsAsync(),
            LoadGalleryAsync(),
            LoadFaqsAsync(),
            LoadArticlesAsync(),
            LoadOffPeakAsync(),
            LoadPollsAsync(),
            LoadCoursesAsync(),
            LoadMarketplaceLinksAsync(),
            LoadUpcomingHolidaysAsync(),
            LoadCombosAsync());

        // Các xử lý phụ thuộc settings (sync/JS) chạy sau khi settings đã có —
        // giữ nguyên logic cũ, chỉ đổi vị trí (trước đây chạy trước các request khác).
        try
        {
            var settings = _shopSettings;
            if (settings != null)
            {
                var (isOpen, text) = ShopHours.StatusText(settings.OpenTime, settings.CloseTime);
                _openNow = isOpen;
                _openStatusText = text;
                // Landing item 18: tracking.
                try { await JSRuntime.InvokeVoidAsync("ptInitTracking", settings.FacebookPixelId, settings.GoogleAnalyticsId); } catch { }
            }
        }
        catch (Exception)
        {
        }
        // perf-hunt 2026-10-19: settings đã load ở đầu OnInitializedAsync vào
        // _shopSettings — dùng lại, không gọi HTTP GET api/shop-settings/public lần 2.
        try { _mapsUrl = _shopSettings?.GoogleMapsUrl; } catch { }

        // 17 loader fail-soft đã tách thành private method phía dưới để
        // OnInitializedAsync chỉ còn luồng chính (~60 dòng), behavior giữ nguyên.
    }

