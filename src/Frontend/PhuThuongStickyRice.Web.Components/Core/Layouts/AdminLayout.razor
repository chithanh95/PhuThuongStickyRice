@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PhuThuongStickyRice.Web.Components.Admin.Services.AdminUtilityService UtilityService
@using PhuThuongStickyRice.Web.Components.Admin.Models
@implements IDisposable

<link href="_content/PhuThuongStickyRice.Web.Components/css/admin-lexa.css" rel="stylesheet" />

<div class="lx-admin">
    <div class="lx-wrapper @(_navOpen ? "lx-hnav-open" : "")">
        @* ============ TOPBAR (full width, fixed) ============ *@
        <header class="lx-topbar">
            <div class="lx-brand-box">
                <a class="lx-logo-text" href="/dashboard">
                    <span class="lx-logo-clock"><span class="oi oi-clock" aria-hidden="true"></span></span>
                    Xôi Phú Thượng
                </a>
            </div>
            <div class="lx-topbar-left">
                <button class="lx-icon-btn lx-hamburger" @onclick="ToggleNav" title="Menu">
                    <span class="oi oi-menu" aria-hidden="true"></span>
                </button>
                <button class="lx-btn-create" title="Tạo mới">
                    Tạo mới <span class="oi oi-chevron-bottom" aria-hidden="true" style="font-size:11px"></span>
                </button>
            </div>
            <div class="lx-topbar-right">
                <a class="lx-icon-btn" href="/shop" target="_blank" rel="noopener" title="Xem cửa hàng (giao diện khách)">
                    <span class="oi oi-external-link" aria-hidden="true"></span>
                </a>
                <button class="lx-icon-btn" @onclick="ToggleTheme" title="Chế độ tối/sáng">
                    <span aria-hidden="true">@(_isDark ? "☀️" : "🌙")</span>
                </button>
                <div class="lx-dropdown lx-search-wrap">
                    <div class="lx-search">
                        <input placeholder="Tìm chức năng, đơn, món, khách..." value="@_search"
                               @oninput="OnSearchInput" @onfocus="() => _searchFocused = true" @onfocusout="OnSearchBlur" />
                        <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                    </div>
                    @if (_searchFocused && _search.Trim().Length >= 2)
                    {
                        <div class="lx-dropdown-menu lx-search-menu">
                            @if (_searching)
                            {
                                <div class="lx-search-empty"><em>Đang tìm...</em></div>
                            }
                            else if (_searchResult != null && _searchResult.HasAny)
                            {
                                @if (_searchResult.Orders.Count > 0)
                                {
                                    <div class="lx-search-group-label">🧾 Đơn hàng</div>
                                    @foreach (var r in _searchResult.Orders)
                                    {
                                        <button class="lx-search-item" @onclick="() => GoSearch(r.Link)">
                                            <span class="oi oi-cart" aria-hidden="true"></span>
                                            <span><span class="t">@r.Title</span><br /><span class="s">@r.Subtitle</span></span>
                                        </button>
                                    }
                                }
                                @if (_searchResult.Products.Count > 0)
                                {
                                    <div class="lx-search-group-label">🍚 Món ăn</div>
                                    @foreach (var r in _searchResult.Products)
                                    {
                                        <button class="lx-search-item" @onclick="() => GoSearch(r.Link)">
                                            <span class="oi oi-tag" aria-hidden="true"></span>
                                            <span><span class="t">@r.Title</span><br /><span class="s">@r.Subtitle</span></span>
                                        </button>
                                    }
                                }
                                @if (_searchResult.Customers.Count > 0)
                                {
                                    <div class="lx-search-group-label">👤 Khách hàng</div>
                                    @foreach (var r in _searchResult.Customers)
                                    {
                                        <button class="lx-search-item" @onclick="() => GoSearch(r.Link)">
                                            <span class="oi oi-person" aria-hidden="true"></span>
                                            <span><span class="t">@r.Title</span><br /><span class="s">@r.Subtitle</span></span>
                                        </button>
                                    }
                                }
                            }
                            else if (_searchResult != null)
                            {
                                <div class="lx-search-empty">Không tìm thấy đơn/món/khách nào.</div>
                            }
                        </div>
                    }
                </div>
                <button class="lx-icon-btn" title="Toàn màn hình" @onclick="ToggleFullscreen">
                    <span class="oi oi-fullscreen-enter" aria-hidden="true"></span>
                </button>
                <div class="lx-dropdown">
                    <button class="lx-icon-btn" @onclick="ToggleNotifications" title="Thông báo">
                        <span class="oi oi-bell" aria-hidden="true"></span>
                        @if (UnreadCount > 0)
                        {
                            <span class="lx-dot">@UnreadCount</span>
                        }
                    </button>
                    @if (_notifOpen)
                    {
                        <div class="lx-dropdown-menu lx-notif-menu">
                            <div class="d-flex justify-content-between align-items-center px-2 py-1">
                                <strong>Thông báo</strong>
                                <button class="btn btn-link btn-sm p-0" @onclick="MarkAllRead">Đánh dấu đã đọc</button>
                            </div>
                            @if (_notifications == null)
                            {
                                <div class="lx-search-empty"><em>Đang tải...</em></div>
                            }
                            else if (_notifications.Count == 0)
                            {
                                <div class="lx-search-empty">🎉 Không có cảnh báo nào.</div>
                            }
                            else
                            {
                                @foreach (var n in _notifications)
                                {
                                    <button class="lx-search-item @(_readNotifIds.Contains(n.Id) ? "" : "lx-notif-unread")"
                                            @onclick="() => OpenNotification(n)">
                                        <span aria-hidden="true">@KindIcon(n.Kind)</span>
                                        <span><span class="t">@n.Title</span><br /><span class="s">@n.Detail</span></span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="lx-dropdown lx-user-wrap">
                    <button class="lx-avatar" @onclick="ToggleUserMenu" title="Tài khoản">
                        <AuthorizeView>
                            <Authorized>@UserInitial(context.User.Identity?.Name)</Authorized>
                            <NotAuthorized>A</NotAuthorized>
                        </AuthorizeView>
                    </button>
                    <span class="lx-user-name">
                        <AuthorizeView>
                            <Authorized>@context.User.Identity?.Name</Authorized>
                            <NotAuthorized>Admin</NotAuthorized>
                        </AuthorizeView>
                    </span>
                    @if (_userMenuOpen)
                    {
                        <div class="lx-dropdown-menu">
                            <a class="lx-dropdown-item" href="/doi-mat-khau" @onclick="CloseUserMenu">
                                <span class="oi oi-key" aria-hidden="true"></span> Đổi mật khẩu
                            </a>
                            <button class="lx-dropdown-item" @onclick="SignOut">
                                <span class="oi oi-account-logout" aria-hidden="true"></span> Đăng xuất
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        @* ============ HORIZONTAL NAV (below topbar, Lexa horizontal style) ============ *@
        @* Hover vào nhóm trên desktop thì thả dropdown; mobile bấm hamburger để mở dọc. *@
        <nav class="lx-hnav" aria-label="Menu quản trị">
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <div class="lx-hnav-search">
                    <span class="lx-hnav-label">Kết quả tìm kiếm</span>
                    @foreach (var item in FilteredItems)
                    {
                        <a class="lx-hnav-link @IsActive(item.Href)" href="@item.Href" @onclick="CloseNavMobile">
                            <span class="oi @item.Icon" aria-hidden="true"></span>
                            <span>@item.Label</span>
                        </a>
                    }
                    @if (!FilteredItems.Any())
                    {
                        <span class="lx-hnav-label">Không tìm thấy mục nào</span>
                    }
                </div>
            }
            else
            {
                @foreach (var (group, items) in VisibleMenu())
                {
                    <div class="lx-hnav-group @(IsGroupActive(group) ? "active" : "") @(IsGroupOpen(group.Key) ? "open" : "")">
                        <button type="button" class="lx-hnav-toggle" @onclick="() => ToggleGroup(group.Key)" aria-haspopup="true">
                            <span class="oi @group.Icon" aria-hidden="true"></span>
                            <span class="lx-hnav-text">@group.Label</span>
                            <span class="oi oi-chevron-bottom lx-hnav-caret" aria-hidden="true"></span>
                        </button>
                        <div class="lx-hnav-drop">
                            @foreach (var item in items)
                            {
                                <a class="lx-hnav-link @IsActive(item.Href)" href="@item.Href" @onclick="CloseNavMobile">
                                    <span class="oi @item.Icon" aria-hidden="true"></span>
                                    <span class="lx-hnav-text">@item.Label</span>
                                    @if (!string.IsNullOrEmpty(item.Badge))
                                    {
                                        <span class="lx-nav-badge @item.BadgeClass">@item.Badge</span>
                                    }
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </nav>
        <div class="lx-backdrop" @onclick="CloseNavMobile"></div>

        @* ============ MAIN ============ *@
        <div class="lx-main">
            <div class="lx-content">
                <div class="lx-page-head">
                    <div>
                        <h1 class="lx-page-title">@_pageTitle</h1>
                        <p class="lx-breadcrumb">
                            <a href="/dashboard">Xôi Phú Thượng</a><span class="sep">/</span><span>@_pageGroup</span><span class="sep">/</span><span class="current">@_pageTitle</span>
                        </p>
                    </div>
                </div>
                @Body
            </div>

            <footer class="lx-footer">&copy; 2026 Xôi Phú Thượng &mdash; Crafted with care.</footer>
        </div>
    </div>
</div>

@code {
    private bool _navOpen;
    private bool _isDark;

    private async Task ToggleTheme()
    {
        try
        {
            var theme = await JS.InvokeAsync<string>("ptToggleTheme");
            _isDark = theme == "dark";
        }
        catch { }
    }
    private bool _userMenuOpen;
    private string _search = "";

    @* Item 157: global search (debounced). *@
    private bool _searchFocused;
    private bool _searching;
    private GlobalSearchResultModel _searchResult;
    private System.Threading.CancellationTokenSource _searchCts;

    @* Item 158: notification center. *@
    private bool _notifOpen;
    private List<NotificationModel> _notifications;
    private readonly HashSet<string> _readNotifIds = new();
    private const string NotifReadKey = "pt-notif-read";

    private int UnreadCount => _notifications?.Count(n => !_readNotifIds.Contains(n.Id)) ?? 0;

    private static string UserInitial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "A" : name.Trim().Substring(0, 1).ToUpperInvariant();
    private string _pageTitle = "Bảng điều khiển";
    private string _pageGroup = "Tổng quan";

    private readonly HashSet<string> _openGroups = new();

    private List<MenuGroup> MenuGroups = new()
    {
        new("overview", "Tổng quan", "oi-dashboard", new()
        {
            new("/dashboard", "Dashboard", "oi-dashboard", roles: "Admin,Cashier"),
            new("/orders", "Đơn hàng", "oi-cart", roles: "Admin,Cashier"),
            new("/admin/quotes", "Đơn đặt tiệc", "oi-calendar"),
            new("/customers", "Khách hàng", "oi-people"),
        }),
        new("sales", "Bán hàng", "oi-tag", new()
        {
            new("/products", "Sản phẩm", "oi-tag"),
        }),
        new("ops", "Vận hành", "oi-cog", new()
        {
            new("/admin/lich-nghi", "Lịch nghỉ lễ/Tết", "oi-calendar"),
            new("/admin/mau-tin-nhan", "Mẫu tin nhắn", "oi-chat"),
        }),
        new("content", "Nội dung", "oi-image", new()
        {
            new("/admin/landing", "Landing page", "oi-image"),
            new("/admin/bai-viet", "Bài viết", "oi-copywriting"),
            new("/admin/danh-gia", "Đánh giá", "oi-star"),
        }),
        new("finance", "Tài chính", "oi-dollar", new()
        {
            new("/admin/bao-cao", "Báo cáo doanh thu", "oi-graph"),
            new("/admin/bao-cao-gio", "Báo cáo theo giờ", "oi-clock"),
            new("/admin/du-bao", "Dự báo doanh thu", "oi-pulse"),
            new("/admin/lai-gop", "Báo cáo lãi gộp", "oi-bar-chart"),
            new("/admin/doi-soat-momo", "Đối soát MoMo", "oi-transfer"),
            new("/admin/doi-soat-ngay", "Đối soát ngày", "oi-data-transfer-download"),
        }),
        new("system", "Hệ thống", "oi-wrench", new()
        {
            new("/admin/shop-settings", "Cài đặt cửa hàng", "oi-cog"),
            new("/admin/nhan-vien", "Nhân viên", "oi-people"),
            new("/admin/phan-quyen", "Phân quyền", "oi-lock-locked"),
            new("/admin/nhat-ky", "Nhật ký nhân viên", "oi-list"),
        }),
    };

    private IEnumerable<MenuItem> FilteredItems =>
        MenuGroups.SelectMany(g => g.Items)
            .Where(i => IsVisible(i) && i.Label.Contains(_search, StringComparison.OrdinalIgnoreCase));

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; }
    private System.Security.Claims.ClaimsPrincipal _user;

    private bool IsVisible(MenuItem item)
    {
        if (_user == null) return false;
        return item.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(r => _user.IsInRole(r.Trim()));
    }

    private IEnumerable<(MenuGroup Group, List<MenuItem> Items)> VisibleMenu()
    {
        foreach (var g in MenuGroups)
        {
            var items = g.Items.Where(IsVisible).ToList();
            if (items.Count > 0) yield return (g, items);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Dark mode: sync toggle icon with saved theme (JS already applied the class pre-paint).
        try { _isDark = await JS.InvokeAsync<string>("ptGetTheme") == "dark"; } catch { }
        try
        {
            _user = (await AuthStateTask)?.User;
        }
        catch
        {
            _user = new System.Security.Claims.ClaimsPrincipal();
        }
        Navigation.LocationChanged += OnLocationChanged;
        UpdatePageHead();
        // Mở sẵn nhóm chứa trang hiện tại
        var group = MenuGroups.FirstOrDefault(g => g.Items.Any(i => IsVisible(i) && IsHrefActive(i.Href)));
        if (group != null) _openGroups.Add(group.Key);
        else _openGroups.Add("overview");

        // Item 158: badge count on the bell — load once per page load.
        await LoadReadIdsAsync();
        if (_user != null && (_user.IsInRole("Admin") || _user.IsInRole("Cashier")))
        {
            await LoadNotificationsAsync();
        }
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        UpdatePageHead();
        _notifOpen = false;
        _searchFocused = false;
        var group = MenuGroups.FirstOrDefault(g => g.Items.Any(i => IsHrefActive(i.Href)));
        if (group != null) _openGroups.Add(group.Key);
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePageHead()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        foreach (var g in MenuGroups)
        {
            var item = g.Items.FirstOrDefault(i =>
                string.Equals(i.Href, path, StringComparison.OrdinalIgnoreCase));
            if (item != null)
            {
                _pageTitle = item.Label;
                _pageGroup = g.Label;
                return;
            }
        }
        _pageTitle = "Bảng điều khiển";
        _pageGroup = "Tổng quan";
    }

    private bool IsHrefActive(string href)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        return string.Equals(href.TrimEnd('/'), path, StringComparison.OrdinalIgnoreCase);
    }

    private string IsActive(string href) => IsHrefActive(href) ? "active" : "";

    private bool IsGroupOpen(string key) => _openGroups.Contains(key);

    private bool IsGroupActive(MenuGroup group) =>
        group.Items.Any(i => IsVisible(i) && IsHrefActive(i.Href));

    private void ToggleGroup(string key)
    {
        if (!_openGroups.Remove(key)) _openGroups.Add(key);
    }

    private void ToggleNav() => _navOpen = !_navOpen;
    private void CloseNavMobile() => _navOpen = false;
    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void CloseUserMenu() => _userMenuOpen = false;

    @* ============ Item 157: global search (debounce 300ms, min 2 chars) ============ *@
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new System.Threading.CancellationTokenSource();
        var token = _searchCts.Token;
        _searchResult = null;
        if (_search.Trim().Length < 2)
        {
            StateHasChanged();
            return;
        }
        try
        {
            await Task.Delay(300, token);
            token.ThrowIfCancellationRequested();
            _searching = true;
            StateHasChanged();
            _searchResult = await UtilityService.SearchAsync(_search.Trim());
        }
        catch (OperationCanceledException) { }
        catch { _searchResult = null; }
        finally { _searching = false; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearchBlur()
    {
        // Delay so a click on a result still registers before hiding.
        await Task.Delay(250);
        _searchFocused = false;
        await InvokeAsync(StateHasChanged);
    }

    private void GoSearch(string link)
    {
        _searchFocused = false;
        _search = "";
        _searchResult = null;
        Navigation.NavigateTo(link);
    }

    @* ============ Item 158: notification center ============ *@
    private static string KindIcon(string kind) => kind switch
    {
        "urgent" => "🚨",
        "warning" => "⚠️",
        _ => "ℹ️"
    };

    private async Task LoadNotificationsAsync()
    {
        try
        {
            _notifications = await UtilityService.GetNotificationsAsync() ?? new List<NotificationModel>();
        }
        catch { _notifications = new List<NotificationModel>(); }
    }

    private async Task LoadReadIdsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", NotifReadKey);
            if (!string.IsNullOrEmpty(json))
            {
                var ids = System.Text.Json.JsonSerializer.Deserialize<string[]>(json);
                if (ids != null) foreach (var id in ids) _readNotifIds.Add(id);
            }
        }
        catch { }
    }

    private async Task SaveReadIdsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", NotifReadKey,
                System.Text.Json.JsonSerializer.Serialize(_readNotifIds.ToArray()));
        }
        catch { }
    }

    private async Task ToggleNotifications()
    {
        _notifOpen = !_notifOpen;
        if (_notifOpen && _notifications == null)
        {
            await LoadNotificationsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkAllRead()
    {
        if (_notifications != null)
            foreach (var n in _notifications) _readNotifIds.Add(n.Id);
        await SaveReadIdsAsync();
    }

    private async Task OpenNotification(NotificationModel n)
    {
        _readNotifIds.Add(n.Id);
        await SaveReadIdsAsync();
        _notifOpen = false;
        Navigation.NavigateTo(n.Link);
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"(function(){if(!document.fullscreenElement){document.documentElement.requestFullscreen&&document.documentElement.requestFullscreen();}else{document.exitFullscreen&&document.exitFullscreen();}})()");
        }
        catch { }
    }

    private async Task SignOut()
    {
        _userMenuOpen = false;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token");
            await JS.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token_expires");
        }
        catch { }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        try { _searchCts?.Cancel(); _searchCts?.Dispose(); } catch { }
    }

    private sealed class MenuGroup
    {
        public MenuGroup(string key, string label, string icon, List<MenuItem> items)
        { Key = key; Label = label; Icon = icon; Items = items; }
        public string Key { get; }
        public string Label { get; }
        public string Icon { get; }
        public List<MenuItem> Items { get; }
    }

    private sealed class MenuItem
    {
        public MenuItem(string href, string label, string icon, string badge = null, string badgeClass = "b-primary", string roles = "Admin")
        { Href = href; Label = label; Icon = icon; Badge = badge; BadgeClass = badgeClass; Roles = roles; }
        public string Href { get; }
        public string Label { get; }
        public string Icon { get; }
        public string Badge { get; }
        public string BadgeClass { get; }
        /// <summary>Comma-separated roles allowed to see this item.</summary>
        public string Roles { get; }
    }
}
