@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PhuThuongStickyRice.Web.Components.Admin.Services.AdminSearchNotificationService SearchNotificationService
@inject PhuThuongStickyRice.Web.Components.Core.Services.ToastService Toasts
@using PhuThuongStickyRice.Web.Components.Admin.Models
@implements IDisposable

<link href="_content/PhuThuongStickyRice.Web.Components/css/admin-lexa.css" rel="stylesheet" />

<div class="lx-admin">
    <a href="#lx-main-content" class="a11y-skip-link">Bỏ qua tới nội dung chính</a>
    <div class="lx-wrapper @(_collapsed ? "lx-collapsed" : "") @(_mobileOpen ? "lx-mobile-open" : "")">
        @* ============ SIDEBAR TRÁI (Lexa style, fixed) ============ *@
        <aside class="lx-sidebar" aria-label="Menu quản trị">
            <div class="lx-brand-box">
                <a class="lx-logo-text" href="/dashboard">
                    <span class="lx-logo-clock"><span class="fa-solid fa-clock" aria-hidden="true"></span></span>
                    <span class="lx-brand-name">Xôi Phú Thượng</span>
                </a>
            </div>
            <nav class="lx-hnav">
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <div class="lx-hnav-search">
                        <span class="lx-hnav-label">Kết quả tìm kiếm</span>
                        @foreach (var menuItem in FilteredItems)
                        {
                            <a class="lx-hnav-link @IsActive(menuItem.Href)" href="@menuItem.Href" @onclick="CloseNavMobile"
                               aria-current="@(IsActive(menuItem.Href) == "active" ? "page" : null)">
                                <i class="@menuItem.Icon" aria-hidden="true"></i>
                                <span class="lx-hnav-text">@menuItem.Label</span>
                            </a>
                        }
                        @if (!FilteredItems.Any())
                        {
                            <span class="lx-hnav-label">Không tìm thấy mục nào</span>
                        }
                    </div>
                }
                else
                {
                    @foreach (var (group, menuItems) in VisibleMenu())
                    {
                        <div class="lx-hnav-group @(IsGroupActive(group) ? "active" : "") @(IsGroupOpen(group.Key) ? "open" : "")">
                            <button type="button" class="lx-hnav-toggle" @onclick="() => ToggleGroup(group.Key)" aria-haspopup="true"
                                    aria-expanded="@IsGroupOpen(group.Key)">
                                <i class="@group.Icon" aria-hidden="true"></i>
                                <span class="lx-hnav-text">@group.Label</span>
                                <span class="fa-solid fa-chevron-down lx-hnav-caret" aria-hidden="true"></span>
                            </button>
                            <div class="lx-hnav-drop">
                                @foreach (var menuItem in menuItems)
                                {
                                    <a class="lx-hnav-link @IsActive(menuItem.Href)" href="@menuItem.Href" @onclick="CloseNavMobile"
                                       aria-current="@(IsActive(menuItem.Href) == "active" ? "page" : null)">
                                        <i class="@menuItem.Icon" aria-hidden="true"></i>
                                        <span class="lx-hnav-text">@menuItem.Label</span>
                                        @if (!string.IsNullOrEmpty(menuItem.Badge))
                                        {
                                            <span class="lx-nav-badge @menuItem.BadgeClass">@menuItem.Badge</span>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
            </nav>
        </aside>

        @* ============ TOPBAR (trắng, bên phải sidebar) ============ *@
        <header class="lx-topbar">
            <div class="lx-topbar-left">
                <button class="lx-icon-btn lx-hamburger" @onclick="ToggleNav" title="Menu" aria-label="Mở hoặc đóng menu điều hướng">
                    <span class="fa-solid fa-bars" aria-hidden="true"></span>
                </button>
                <button class="lx-btn-create" title="Tạo mới" aria-label="Tạo mới">
                    Tạo mới <span class="fa-solid fa-chevron-down" aria-hidden="true" style="font-size:11px"></span>
                </button>
            </div>
            <div class="lx-topbar-right">
                <a class="lx-icon-btn" href="/shop" target="_blank" rel="noopener" title="Xem cửa hàng (giao diện khách)" aria-label="Xem cửa hàng (giao diện khách) — mở tab mới">
                    <span class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></span>
                </a>
                <button class="lx-icon-btn" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">
                    @* 2026-10-19: icon = trạng thái hiện tại (tối→🌙, sáng→☀️) theo yêu cầu user. *@
                    <span aria-hidden="true">@(_isDark ? "🌙" : "☀️")</span>
                </button>
                <div class="lx-dropdown lx-search-wrap">
                    <div class="lx-search">
                        <input placeholder="Tìm chức năng, đơn, món, khách..." aria-label="Tìm kiếm chức năng, đơn hàng, món ăn, khách hàng" value="@_search"
                               @oninput="OnSearchInput" @onfocus="() => _searchFocused = true" @onfocusout="OnSearchBlur" />
                        <span class="fa-solid fa-magnifying-glass" aria-hidden="true"></span>
                    </div>
                    @if (_searchFocused && _search.Trim().Length >= 2)
                    {
                        <div class="lx-dropdown-menu lx-search-menu">
                            @if (_searching)
                            {
                                <div class="lx-search-empty"><em>Đang tìm...</em></div>
                            }
                            else if (_searchResult != null && _searchResult.HasAny)
                            {
                                @if (_searchResult.Orders.Count > 0)
                                {
                                    <div class="lx-search-group-label">🧾 Đơn hàng</div>
                                    @foreach (var orderResult in _searchResult.Orders)
                                    {
                                        <button class="lx-search-item" @onclick="() => NavigateToSearchResult(orderResult.Link)">
                                            <span class="fa-solid fa-cart-shopping" aria-hidden="true"></span>
                                            <span><span class="t">@orderResult.Title</span><br /><span class="s">@orderResult.Subtitle</span></span>
                                        </button>
                                    }
                                }
                                @if (_searchResult.Products.Count > 0)
                                {
                                    <div class="lx-search-group-label">🍚 Món ăn</div>
                                    @foreach (var productResult in _searchResult.Products)
                                    {
                                        <button class="lx-search-item" @onclick="() => NavigateToSearchResult(productResult.Link)">
                                            <span class="fa-solid fa-tag" aria-hidden="true"></span>
                                            <span><span class="t">@productResult.Title</span><br /><span class="s">@productResult.Subtitle</span></span>
                                        </button>
                                    }
                                }
                                @if (_searchResult.Customers.Count > 0)
                                {
                                    <div class="lx-search-group-label">👤 Khách hàng</div>
                                    @foreach (var customerResult in _searchResult.Customers)
                                    {
                                        <button class="lx-search-item" @onclick="() => NavigateToSearchResult(customerResult.Link)">
                                            <span class="fa-solid fa-user" aria-hidden="true"></span>
                                            <span><span class="t">@customerResult.Title</span><br /><span class="s">@customerResult.Subtitle</span></span>
                                        </button>
                                    }
                                }
                            }
                            else if (_searchResult != null)
                            {
                                <div class="lx-search-empty">Không tìm thấy đơn/món/khách nào.</div>
                            }
                        </div>
                    }
                </div>
                <div class="lx-dropdown lx-lang-wrap">
                    <button class="lx-lang-btn" @onclick="ToggleLangMenu" title="Ngôn ngữ" aria-label="Ngôn ngữ — chọn ngôn ngữ hiển thị"
                            aria-expanded="@_langMenuOpen" aria-haspopup="true">
                        <img src="/images/flags/@(_lang == "en" ? "gb" : "vn").png" alt="" class="lx-flag" />
                        <span>@(_lang == "en" ? "English" : "Tiếng Việt")</span>
                        <span class="fa-solid fa-chevron-down" aria-hidden="true" style="font-size:10px"></span>
                    </button>
                    @if (_langMenuOpen)
                    {
                        <div class="lx-dropdown-backdrop" @onclick="() => _langMenuOpen = false"></div>
                        <div class="lx-dropdown-menu lx-lang-menu">
                            <button class="lx-dropdown-item" @onclick='() => SetLang("vi")'>
                                <img src="/images/flags/vn.png" alt="" class="lx-flag" /> Tiếng Việt
                            </button>
                            <button class="lx-dropdown-item" @onclick='() => SetLang("en")'>
                                <img src="/images/flags/gb.png" alt="" class="lx-flag" /> English
                            </button>
                        </div>
                    }
                </div>
                <button class="lx-icon-btn" title="Toàn màn hình" aria-label="Bật hoặc tắt toàn màn hình" @onclick="ToggleFullscreen">
                    <span class="fa-solid fa-expand" aria-hidden="true"></span>
                </button>
                <div class="lx-dropdown">
                    <button class="lx-icon-btn @(_bellRinging ? "lx-bell-ring" : "")" @onclick="ToggleNotifications" title="Thông báo" aria-label="Thông báo — xem danh sách thông báo">
                        <span class="fa-solid fa-bell" aria-hidden="true"></span>
                        @if (UnreadCount > 0)
                        {
                            <span class="lx-dot">@UnreadCount</span>
                        }
                    </button>
                    @if (_notifOpen)
                    {
                        <div class="lx-dropdown-backdrop" @onclick="() => _notifOpen = false"></div>
                        <div class="lx-dropdown-menu lx-notif-menu">
                            <div class="d-flex justify-content-between align-items-center px-2 py-1">
                                <strong>Thông báo</strong>
                                <button class="btn btn-link btn-sm p-0" @onclick="MarkAllRead">Đánh dấu đã đọc</button>
                            </div>
                            @if (_notifications == null)
                            {
                                <div class="lx-search-empty"><em>Đang tải...</em></div>
                            }
                            else if (_notifications.Count == 0)
                            {
                                <div class="lx-search-empty">🎉 Không có cảnh báo nào.</div>
                            }
                            else
                            {
                                @foreach (var notification in _notifications)
                                {
                                    <button class="lx-search-item @(_readNotifIds.Contains(notification.Id) ? "" : "lx-notif-unread")"
                                            @onclick="() => OpenNotification(notification)">
                                        <span aria-hidden="true">@KindIcon(notification.Kind)</span>
                                        <span><span class="t">@notification.Title</span><br /><span class="s">@notification.Detail</span></span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="lx-dropdown lx-user-wrap">
                    <button class="lx-avatar" @onclick="ToggleUserMenu" title="Tài khoản" aria-label="Tài khoản — mở menu người dùng"
                            aria-expanded="@_userMenuOpen" aria-haspopup="true">
                        <AuthorizeView>
                            <Authorized>@UserInitial(context.User.Identity?.Name)</Authorized>
                            <NotAuthorized>A</NotAuthorized>
                        </AuthorizeView>
                    </button>
                    <span class="lx-user-name">
                        <AuthorizeView>
                            <Authorized>@context.User.Identity?.Name</Authorized>
                            <NotAuthorized>Admin</NotAuthorized>
                        </AuthorizeView>
                    </span>
                    @if (_userMenuOpen)
                    {
                        <div class="lx-dropdown-backdrop" @onclick="CloseUserMenu"></div>
                        <div class="lx-dropdown-menu">
                            <a class="lx-dropdown-item" href="/admin/ho-so" @onclick="CloseUserMenu">
                                <span class="fa-solid fa-user" aria-hidden="true"></span> Hồ sơ
                            </a>
                            <a class="lx-dropdown-item" href="/admin/doi-mat-khau" @onclick="CloseUserMenu">
                                <span class="fa-solid fa-key" aria-hidden="true"></span> Đổi mật khẩu
                            </a>
                            <button class="lx-dropdown-item" @onclick="SignOut">
                                <span class="fa-solid fa-right-from-bracket" aria-hidden="true"></span> Đăng xuất
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <div class="lx-backdrop" @onclick="CloseNavMobile"></div>

        @* ============ MAIN ============ *@
        <div class="lx-main" id="lx-main-content" tabindex="-1">
            <div class="lx-content">
                @Body
            </div>

            <footer class="lx-footer">&copy; 2026 Xôi Phú Thượng &mdash; Crafted with care.</footer>
        </div>
    </div>

    @* Toast notifications (top-right, auto-dismiss)
       UIUX-1019 Agent4 (a11y): aria-live="polite" để trình đọc màn hình thông báo
       khi toast xuất hiện (trước đây div trần, người khiếm thị không biết có thông báo). *@
    <div class="lx-toast-container" aria-live="polite">
        @foreach (var toast in _toasts)
        {
            <div class="lx-toast show" @key="toast.Id" role="status">
                <div class="lx-toast-body">
                    <i class="fa-solid fa-circle-check me-3"></i>
                    <span>@toast.Message</span>
                </div>
                <button type="button" class="lx-toast-close" @onclick="() => DismissToast(toast.Id)" aria-label="Đóng">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool _collapsed;      // desktop: thu gọn sidebar còn icon
    private bool _mobileOpen;     // mobile: mở sidebar dạng drawer
    private bool _isDark;

    private async Task ToggleTheme()
    {
        // 2026-10-19: toggle NHỊ PHÂN Sáng↔Tối — 1 lần bấm = đổi giao diện ngay.
        // Trước đây gọi ptToggleTheme xoay vòng 3 chế độ (sáng→tối→tự động→sáng)
        // trong khi nút hiển thị nhị phân (☀️/🌙): ban đêm "tự động" cũng = tối nên
        // cứ 2 lần bấm mới thấy đổi 1 lần, user tưởng nút bị liệt.
        try
        {
            _isDark = !_isDark;
            await JS.InvokeVoidAsync("ptSetTheme", "pt-theme-admin", _isDark ? "dark" : "light");
        }
        catch { }
    }
    private bool _userMenuOpen;
    private string _search = "";

    @* Item 157: global search (debounced). *@
    private bool _searchFocused;
    private bool _searching;
    private GlobalSearchResultModel _searchResult;
    private System.Threading.CancellationTokenSource _searchCts;

    @* Item 158: notification center. *@
    private bool _notifOpen;
    private bool _langMenuOpen;
    private string _lang = "vi";
    private bool _bellRinging;

    @* Toast notifications (top-right auto-dismiss). *@
    private readonly List<PhuThuongStickyRice.Web.Components.Core.Services.ToastMessage> _toasts = new();
    private List<NotificationModel> _notifications;
    private readonly HashSet<string> _readNotifIds = new();
    private const string NotifReadKey = "pt-notif-read";

    private int UnreadCount => _notifications?.Count(n => !_readNotifIds.Contains(n.Id)) ?? 0;

    private static string UserInitial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "A" : name.Trim().Substring(0, 1).ToUpperInvariant();
    private readonly HashSet<string> _openGroups = new();

    private List<MenuGroup> MenuGroups = new()
    {
        new("overview", "Tổng quan", "fa-solid fa-gauge", new()
        {
            new("/dashboard", "Dashboard", "fa-solid fa-gauge", roles: "Admin,Cashier"),
            new("/orders", "Đơn hàng", "fa-solid fa-cart-shopping", roles: "Admin,Cashier"),
            new("/admin/kanban-don", "Kanban đơn hàng", "fa-solid fa-table-columns", roles: "Admin,Cashier,Kitchen"),
            new("/admin/quotes", "Đơn đặt tiệc", "fa-solid fa-calendar-days"),
            new("/customers", "Khách hàng", "fa-solid fa-users"),
        }),
        new("sales", "Bán hàng", "fa-solid fa-tag", new()
        {
            new("/products", "Sản phẩm", "fa-solid fa-tag"),
            new("/admin/khuyen-mai", "Khuyến mãi", "fa-solid fa-ticket"),
            new("/admin/ma-giam-gia", "Mã giảm giá", "fa-solid fa-tag"),
            new("/admin/chi-nhanh", "Chi nhánh", "fa-solid fa-store"),
        }),
        new("ops", "Vận hành", "fa-solid fa-gear", new()
        {
            new("/admin/lich-nghi", "Lịch nghỉ lễ/Tết", "fa-solid fa-calendar-days"),
            new("/admin/lich-tong-hop", "Lịch tổng hợp", "fa-solid fa-calendar-days"),
            new("/admin/chat-noi-bo", "Chat nội bộ", "fa-solid fa-comments", roles: "Admin,Cashier,Kitchen"),
            new("/admin/mau-tin-nhan", "Mẫu tin nhắn", "fa-solid fa-comments"),
        }),
        new("content", "Nội dung", "fa-solid fa-image", new()
        {
            new("/admin/landing", "Landing page", "fa-solid fa-image"),
            new("/admin/bai-viet", "Bài viết", "fa-solid fa-pen-to-square"),
            new("/admin/danh-gia", "Đánh giá", "fa-solid fa-star"),
        }),
        new("finance", "Tài chính", "fa-solid fa-dollar-sign", new()
        {
            new("/admin/bao-cao", "Báo cáo doanh thu", "fa-solid fa-chart-line"),
            new("/admin/bao-cao-gio", "Báo cáo theo giờ", "fa-solid fa-clock"),
            new("/admin/du-bao", "Dự báo doanh thu", "fa-solid fa-wave-square"),
            new("/admin/lai-gop", "Báo cáo lãi gộp", "fa-solid fa-chart-column"),
            new("/admin/doi-soat-momo", "Đối soát MoMo", "fa-solid fa-arrow-right-arrow-left"),
            new("/admin/doi-soat-ngay", "Đối soát ngày", "fa-solid fa-download"),
            new("/admin/funnel", "Phễu khách hàng", "fa-solid fa-chart-line"),
        }),
        new("system", "Hệ thống", "fa-solid fa-wrench", new()
        {
            new("/admin/shop-settings", "Cài đặt cửa hàng", "fa-solid fa-gear"),
            new("/admin/nhan-vien", "Nhân viên", "fa-solid fa-users"),
            new("/admin/phan-quyen", "Phân quyền", "fa-solid fa-lock"),
            new("/admin/nhat-ky", "Nhật ký nhân viên", "fa-solid fa-list"),
        }),
    };

    private IEnumerable<MenuItem> FilteredItems =>
        MenuGroups.SelectMany(g => g.Items)
            .Where(i => IsVisible(i) && i.Label.Contains(_search, StringComparison.OrdinalIgnoreCase));

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; }
    private System.Security.Claims.ClaimsPrincipal _user;

    private bool IsVisible(MenuItem item)
    {
        if (_user == null) return false;
        return item.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(r => _user.IsInRole(r.Trim()));
    }

    private IEnumerable<(MenuGroup Group, List<MenuItem> Items)> VisibleMenu()
    {
        foreach (var menuGroup in MenuGroups)
        {
            var visibleItems = menuGroup.Items.Where(IsVisible).ToList();
            if (visibleItems.Count > 0) yield return (menuGroup, visibleItems);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Toast: subscribe to show notifications top-right + bell.
        Toasts.OnShow += OnToastShow;

        // Dark mode: sync toggle icon with saved theme (JS already applied the class pre-paint).
        // Dùng ptIsDark để icon đúng cả khi giá trị cũ đang là 'auto' theo giờ.
        try { _isDark = await JS.InvokeAsync<bool>("ptIsDark", "pt-theme-admin"); } catch { }
        try
        {
            _user = (await AuthStateTask)?.User;
        }
        catch
        {
            _user = new System.Security.Claims.ClaimsPrincipal();
        }
        Navigation.LocationChanged += OnLocationChanged;
        // Mở sẵn nhóm chứa trang hiện tại
        var group = MenuGroups.FirstOrDefault(g => g.Items.Any(i => IsVisible(i) && IsHrefActive(i.Href)));
        if (group != null) _openGroups.Add(group.Key);
        else _openGroups.Add("overview");

        // Item 158: badge count on the bell — load once per page load.
        await LoadReadIdsAsync();
        if (_user != null && (_user.IsInRole("Admin") || _user.IsInRole("Cashier")))
        {
            await LoadNotificationsAsync();
        }
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        _notifOpen = false;
        _searchFocused = false;
        var group = MenuGroups.FirstOrDefault(g => g.Items.Any(i => IsHrefActive(i.Href)));
        if (group != null) _openGroups.Add(group.Key);
        InvokeAsync(StateHasChanged);
    }

    private bool IsHrefActive(string href)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        return string.Equals(href.TrimEnd('/'), path, StringComparison.OrdinalIgnoreCase);
    }

    private string IsActive(string href) => IsHrefActive(href) ? "active" : "";

    private bool IsGroupOpen(string key) => _openGroups.Contains(key);

    private bool IsGroupActive(MenuGroup group) =>
        group.Items.Any(i => IsVisible(i) && IsHrefActive(i.Href));

    private void ToggleGroup(string key)
    {
        if (!_openGroups.Remove(key)) _openGroups.Add(key);
    }

    private async Task ToggleNav()
    {
        bool isMobile = false;
        try { isMobile = await JS.InvokeAsync<bool>("eval", "window.innerWidth < 992"); } catch { }
        if (isMobile) _mobileOpen = !_mobileOpen;
        else _collapsed = !_collapsed;
    }
    private void CloseNavMobile() => _mobileOpen = false;
    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void CloseUserMenu() => _userMenuOpen = false;

    @* ============ Item 157: global search (debounce 300ms, min 2 chars) ============ *@
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new System.Threading.CancellationTokenSource();
        var token = _searchCts.Token;
        _searchResult = null;
        if (_search.Trim().Length < 2)
        {
            StateHasChanged();
            return;
        }
        try
        {
            await Task.Delay(300, token);
            token.ThrowIfCancellationRequested();
            _searching = true;
            StateHasChanged();
            _searchResult = await SearchNotificationService.SearchAsync(_search.Trim());
        }
        catch (OperationCanceledException) { }
        catch { _searchResult = null; }
        finally { _searching = false; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearchBlur()
    {
        // Delay so a click on a result still registers before hiding.
        await Task.Delay(250);
        _searchFocused = false;
        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToSearchResult(string link)
    {
        _searchFocused = false;
        _search = "";
        _searchResult = null;
        Navigation.NavigateTo(link);
    }

    @* ============ Item 158: notification center ============ *@
    private static string KindIcon(string kind) => kind switch
    {
        "urgent" => "🚨",
        "warning" => "⚠️",
        _ => "ℹ️"
    };

    private async Task LoadNotificationsAsync()
    {
        try
        {
            _notifications = await SearchNotificationService.GetNotificationsAsync() ?? new List<NotificationModel>();
        }
        catch { _notifications = new List<NotificationModel>(); }
    }

    private async Task LoadReadIdsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", NotifReadKey);
            if (!string.IsNullOrEmpty(json))
            {
                var ids = System.Text.Json.JsonSerializer.Deserialize<string[]>(json);
                if (ids != null) foreach (var id in ids) _readNotifIds.Add(id);
            }
        }
        catch { }
    }

    private async Task SaveReadIdsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", NotifReadKey,
                System.Text.Json.JsonSerializer.Serialize(_readNotifIds.ToArray()));
        }
        catch { }
    }

    private void ToggleLangMenu()
    {
        _langMenuOpen = !_langMenuOpen;
        _notifOpen = false;
        _userMenuOpen = false;
    }

    private void SetLang(string lang)
    {
        _lang = lang;
        _langMenuOpen = false;
    }

    private async Task ToggleNotifications()
    {
        _notifOpen = !_notifOpen;
        if (_notifOpen && _notifications == null)
        {
            await LoadNotificationsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkAllRead()
    {
        if (_notifications != null)
            foreach (var notification in _notifications) _readNotifIds.Add(notification.Id);
        await SaveReadIdsAsync();
    }

    private async Task OpenNotification(NotificationModel notification)
    {
        _readNotifIds.Add(notification.Id);
        await SaveReadIdsAsync();
        _notifOpen = false;
        Navigation.NavigateTo(notification.Link);
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"(function(){if(!document.fullscreenElement){document.documentElement.requestFullscreen&&document.documentElement.requestFullscreen();}else{document.exitFullscreen&&document.exitFullscreen();}})()");
        }
        catch { }
    }

    private async Task SignOut()
    {
        _userMenuOpen = false;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token");
            await JS.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token_expires");
        }
        catch { }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Toasts.OnShow -= OnToastShow;
        try { _searchCts?.Cancel(); _searchCts?.Dispose(); } catch { }
    }

    private void OnToastShow(PhuThuongStickyRice.Web.Components.Core.Services.ToastMessage toast)
    {
        _toasts.Add(toast);
        // Add to notification center + ring the bell.
        _notifications ??= new List<NotificationModel>();
        _notifications.Insert(0, new NotificationModel
        {
            Id = toast.Id.ToString(),
            Title = toast.Message,
            Detail = DateTime.Now.ToString("HH:mm dd/MM/yyyy"),
            Kind = "success"
        });
        _bellRinging = true;
        StateHasChanged();
        // Auto-dismiss after 4 seconds.
        _ = AutoDismissToastAsync(toast.Id, 4000, dismissBell: true);
        // Stop bell ringing after 1.5s.
        _ = AutoDismissToastAsync(toast.Id, 1500, dismissBell: false);
    }

    /// <summary>
    /// Fire-and-forget có kiểm soát: chờ rồi gỡ toast qua InvokeAsync (đúng Blazor sync context).
    /// Dùng async/await thay cho ContinueWith để exception không bị nuốt thầm lặng
    /// (ví dụ component đã dispose khi timer chạy xong) và code dễ đọc hơn.
    /// </summary>
    private async Task AutoDismissToastAsync(Guid toastId, int delayMs, bool dismissBell)
    {
        try
        {
            await Task.Delay(delayMs);
            await InvokeAsync(() =>
            {
                if (dismissBell)
                {
                    _toasts.RemoveAll(t => t.Id == toastId);
                }
                _bellRinging = false;
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // Component có thể đã dispose khi timer chạy xong — bỏ qua an toàn.
        }
    }

    private void DismissToast(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

