@inherits LayoutComponentBase
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Landing.Services
@using PhuThuongStickyRice.Web.Components.Landing.Models
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject ShopSettingsService ShopSettingsService
@inject LandingService LandingService
@inject CartState CartState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppLocalizationService AppLocalizationService
@implements IDisposable

@* Layout dành cho KHÁCH: header sạch, không sidebar, không mục admin.
   Luồng khách: Trang chủ (/) → Thực đơn (/shop) → Giỏ hàng (/cart) → Đặt hàng (/checkout). *@

<div class="shp-page">
    <a href="#shp-main-content" class="a11y-skip-link">Bỏ qua tới nội dung chính</a>
    <header class="shp-header">
        <div class="shp-header-inner">
            @if (!IsShopHome)
            {
                <button type="button" class="shp-back" @onclick="NavigateBack" title="Quay lại" aria-label="Quay lại trang trước">←</button>
            }
            <a class="shp-logo" href="/">
                <img class="shp-logo-img" src="/images/logo-round.png" alt="Logo Xôi Huyền" />
                <span class="shp-logo-text">
                    <span class="shp-logo-main">Xôi Huyền</span>
                    <span class="shp-logo-sub">Làng nghề Hà Nội</span>
                </span>
            </a>

            <button class="shp-hamburger" @onclick="() => _menuOpen = !_menuOpen" aria-label="Menu" aria-expanded="@_menuOpen" aria-controls="shp-nav-menu">
                <span></span><span></span><span></span>
            </button>

            <nav class="shp-nav @(_menuOpen ? "open" : "")" id="shp-nav-menu">
                <a href="/" class="@NavActive("/")" aria-current="@(NavActive("/") == "active" ? "page" : null)">@AppLocalizationService.Translate("nav.home")</a>
                <a href="/shop" class="@NavActive("/shop")" aria-current="@(NavActive("/shop") == "active" ? "page" : null)">@AppLocalizationService.Translate("nav.menu")</a>
                <a href="/dat-so-luong-lon" class="@NavActive("/dat-so-luong-lon")" aria-current="@(NavActive("/dat-so-luong-lon") == "active" ? "page" : null)">@AppLocalizationService.Translate("nav.bulk_order")</a>
                <a href="#lien-he" class="">@AppLocalizationService.Translate("nav.contact")</a>
                <a href="/dang-nhap" class="shp-nav-login">👤 @AppLocalizationService.Translate("common.login")</a>
            </nav>

            <div class="shp-header-right">
                @* GL3: language dropdown cờ quốc gia, đồng bộ mọi màn hình. *@
                <LanguageSelector Compact="true" />
                @if (!string.IsNullOrEmpty(_hotline))
                {
                    <a class="shp-hotline" href="tel:@_hotline" title="Gọi cho quán">
                        📞 @_hotline
                    </a>
                }
                <a class="shp-cart" href="/cart" title="@AppLocalizationService.Translate("common.cart")"
                   aria-label="@($"{AppLocalizationService.Translate("common.cart")} ({CartState.TotalQuantity})")">
                    <span aria-hidden="true">🛒</span>
                    @if (CartState.TotalQuantity > 0)
                    {
                        <span class="shp-cart-badge">@CartState.TotalQuantity</span>
                    }
                </a>
                @* #196: Chữ lớn cho người lớn tuổi. *@
                <button type="button" class="shp-theme-toggle" @onclick="ToggleLargeText" title="Chữ lớn" aria-label="Chế độ chữ lớn" aria-pressed="@_isLargeText">
                    <span class="shp-text-size-icon">A+</span>
                </button>
                @* Dark mode NHỊ PHÂN Sáng↔Tối giống hệt landing (ShopTheme):
                   1 lần bấm = đổi giao diện ngay. Trước đây ShopLayout xoay vòng
                   3 chế độ Sáng→Tối→Tự động (thiết kế #197) trong khi landing là
                   nhị phân — user báo 2026-10-20 shop/cart/checkout "lỗi sáng tối
                   không giống landing": ban đêm bấm từ Tối sang Tự động chỉ đổi
                   icon mà màn vẫn đen. Bỏ hẳn chế độ Tự động ở khu shop.
                   UIUX-1019 Agent4 (a11y): aria-label động theo _themeTitle để trình đọc
                   màn hình biết trạng thái HIỆN TẠI và hành động KẾ TIẾP. *@
                <button type="button" class="shp-theme-toggle" @onclick="ToggleTheme" title="@_themeTitle" aria-label="@_themeTitle">
                    @_themeIcon
                </button>
                <a class="shp-order-btn" href="/cart">@AppLocalizationService.Translate("shop.order_now")</a>

                <AuthorizeView>
                    <Authorized>
                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Cashier") || context.User.IsInRole("Kitchen"))
                        {
                            <a class="shp-account shp-admin-link" href="/dashboard" title="Khu vực quản trị">
                                🛠️ Vào trang quản trị
                            </a>
                        }
                        else
                        {
                            <div class="shp-user">
                                <a class="shp-account" href="/tai-khoan" title="Tài khoản mua hàng của bạn">
                                    👤 Xin chào, @(context.User.Identity?.Name ?? "bạn")
                                </a>
                                <button type="button" class="shp-logout" @onclick="SignOut" title="@AppLocalizationService.Translate("shop.logout")">@AppLocalizationService.Translate("shop.logout")</button>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a class="shp-account" href="/dang-nhap" title="Đăng nhập / đăng ký tài khoản mua hàng">
                            👤 @AppLocalizationService.Translate("common.login")
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main class="shp-main" id="shp-main-content" tabindex="-1">
        @Body
    </main>

    <footer class="shp-footer" id="lien-he">
        <div class="shp-footer-inner">
            <div class="shp-footer-col">
                <img class="shp-footer-logo-img" src="/images/logo-round.png" alt="Logo Xôi Huyền" />
                <div class="shp-logo-main">Xôi Huyền</div>
                <p>Xôi dẻo thơm chuẩn vị làng nghề Phú Thượng, Hà Nội.<br />Đồ mỗi sáng, nóng hổi.</p>
                @if (!string.IsNullOrEmpty(_address))
                {
                    <p>📍 @_address</p>
                }
            </div>
            <div class="shp-footer-col">
                <h4>Khám phá</h4>
                <a href="/">Trang chủ</a>
                <a href="/shop">Thực đơn</a>
                <a href="/dat-so-luong-lon">Đặt số lượng lớn &amp; định kỳ</a>
                <a href="/track-order">Tra cứu đơn hàng</a>
            </div>
            <div class="shp-footer-col">
                <h4>Liên hệ</h4>
                @if (!string.IsNullOrEmpty(_hotline))
                {
                    <p>📞 Hotline: <a href="tel:@_hotline">@_hotline</a></p>
                }
                @if (!string.IsNullOrEmpty(_email))
                {
                    <p>✉️ @_email</p>
                }
                <a class="shp-admin-login" href="/login">🔐 Đăng nhập quản trị</a>
            </div>
        </div>
        <div class="shp-copyright">&copy; 2026 Xôi Huyền. All rights reserved.</div>
    </footer>
</div>

@code {
    private bool _menuOpen;
    private string _hotline;
    private string _address;
    private string _email;
    // Trạng thái tối THỰC TẾ đang hiển thị — dùng chung ShopTheme với
    // landing (Index) và các trang auth: nhị phân Sáng↔Tối, không còn
    // trạng thái "auto" riêng của ShopLayout như trước.
    private bool _isDark;
    private bool _isLargeText;

    // 2026-10-19: icon = TRẠNG THÁI HIỆN TẠI (user yêu cầu): đang tối hiện 🌙,
    // đang sáng hiện ☀️ — trước đây icon chỉ "hành động kế tiếp" (tối hiện ☀️)
    // khiến user thấy sai ("mặt trời nhưng lại là màu tối").
    private string _themeIcon => _isDark ? "🌙" : "☀️";

    private string _themeTitle => _isDark
        ? "Đang: Tối — bấm để chuyển Sáng"
        : "Đang: Sáng — bấm để chuyển Tối";

    // Giống hệt landing: lật cờ rồi áp ngay qua ShopTheme (ptSetTheme) —
    // 1 lần bấm là giao diện đổi ngay, không qua trạng thái trung gian.
    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await ShopTheme.ApplyAsync(JSRuntime, _isDark);
    }

    private async Task ToggleLargeText()
    {
        try
        {
            _isLargeText = await JSRuntime.InvokeAsync<bool>("ptToggleLargeText");
            StateHasChanged();
        }
        catch { }
    }

    private async Task NavigateBack()
    {
        try { await JSRuntime.InvokeVoidAsync("history.back"); }
        catch { Navigation.NavigateTo("/shop"); }
    }

    private bool IsShopHome =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Equals("shop", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("ptApplyTheme", ThemeStorageKeys.Shop);
                await JSRuntime.InvokeVoidAsync("ptApplyLargeText");
                // Đọc trạng thái tối THỰC TẾ (ptIsDark xử lý cả giá trị 'auto'
                // còn lưu từ trước: tự quy về sáng/tối theo giờ như landing).
                _isDark = await ShopTheme.ReadIsDarkAsync(JSRuntime);
                _isLargeText = await JSRuntime.InvokeAsync<bool>("ptGetLargeText");
                StateHasChanged();
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += OnCartChanged;
        AppLocalizationService.OnChange += OnLangChanged;
        // Đóng menu hamburger mobile sau khi chuyển trang — trước đây menu
        // vẫn mở nguyên, che nội dung trang mới trên màn hình nhỏ.
        Navigation.LocationChanged += OnLocationChanged;
        await AppLocalizationService.InitializeAsync();

        // perf-hunt 2026-10-20: 2 call độc lập chạy song song (mỗi cái tự
        // fail-soft trong helper, không ném) — cắt ~1 HTTP round-trip khi
        // cả 2 cache client-side (TTL 2') cùng hết hạn. Logic fallback
        // hotline (ưu tiên settings, thiếu mới lấy landing) giữ nguyên,
        // chỉ chuyển từ "đọc sau await tuần tự" sang "đọc sau WhenAll".
        var settingsTask = GetShopSettingsSafeAsync();
        var landingTask = GetLandingContentSafeAsync();
        await Task.WhenAll(settingsTask, landingTask);
        var settings = await settingsTask;
        var landing = await landingTask;

        string hotline = NormalizePhone(settings?.Hotline);
        if (string.IsNullOrEmpty(hotline)) hotline = NormalizePhone(landing?.ContactPhone);
        _hotline = hotline;
        _address = landing?.ContactAddress;
        _email = landing?.ContactEmail;
    }

    /// <summary>Đọc settings công khai, lỗi thì trả null (không chặn layout).</summary>
    private async Task<ShopSettingModel> GetShopSettingsSafeAsync()
    {
        try { return await ShopSettingsService.GetPublicAsync(); }
        catch { return null; }
    }

    /// <summary>Đọc nội dung landing, lỗi thì trả null (không chặn layout).</summary>
    private async Task<LandingContentModel> GetLandingContentSafeAsync()
    {
        try { return await LandingService.GetContentAsync(); }
        catch { return null; }
    }

    private static string NormalizePhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return null;
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return string.IsNullOrEmpty(digits) ? null : digits;
    }

    private string NavActive(string href)
    {
        try
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return string.Equals(path, href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? "active" : "";
        }
        catch { return ""; }
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOut()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token_expires");
        }
        catch { }
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        if (_menuOpen)
        {
            _menuOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        CartState.OnChange -= OnCartChanged;
        AppLocalizationService.OnChange -= OnLangChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
