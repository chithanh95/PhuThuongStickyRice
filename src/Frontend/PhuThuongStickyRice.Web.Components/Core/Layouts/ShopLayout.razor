@inherits LayoutComponentBase
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Landing.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject ShopSettingsService ShopSettingsService
@inject LandingService LandingService
@inject CartState CartState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AppI18n AppI18n
@implements IDisposable

@* Layout dành cho KHÁCH: header sạch, không sidebar, không mục admin.
   Luồng khách: Trang chủ (/) → Thực đơn (/shop) → Giỏ hàng (/cart) → Đặt hàng (/checkout). *@

<div class="shp-page">
    <a href="#shp-main-content" class="a11y-skip-link">Bỏ qua tới nội dung chính</a>
    <header class="shp-header">
        <div class="shp-header-inner">
            @if (!IsShopHome)
            {
                <button type="button" class="shp-back" @onclick="NavigateBack" title="Quay lại" aria-label="Quay lại trang trước">←</button>
            }
            <a class="shp-logo" href="/">
                <span class="shp-logo-main">Xôi Phú Thượng</span>
                <span class="shp-logo-sub">Làng nghề Hà Nội</span>
            </a>

            <button class="shp-hamburger" @onclick="() => _menuOpen = !_menuOpen" aria-label="Menu" aria-expanded="@_menuOpen" aria-controls="shp-nav-menu">
                <span></span><span></span><span></span>
            </button>

            <nav class="shp-nav @(_menuOpen ? "open" : "")" id="shp-nav-menu">
                <a href="/" class="@NavActive("/")" aria-current="@(NavActive("/") == "active" ? "page" : null)">@AppI18n.Translate("nav.home")</a>
                <a href="/shop" class="@NavActive("/shop")" aria-current="@(NavActive("/shop") == "active" ? "page" : null)">@AppI18n.Translate("nav.menu")</a>
                <a href="/dat-so-luong-lon" class="@NavActive("/dat-so-luong-lon")" aria-current="@(NavActive("/dat-so-luong-lon") == "active" ? "page" : null)">@AppI18n.Translate("nav.bulk_order")</a>
                <a href="#lien-he" class="">@AppI18n.Translate("nav.contact")</a>
                <a href="/dang-nhap" class="shp-nav-login">👤 @AppI18n.Translate("common.login")</a>
            </nav>

            <div class="shp-header-right">
                @* GL3: language dropdown cờ quốc gia, đồng bộ mọi màn hình. *@
                <LanguageSelector Compact="true" />
                @if (!string.IsNullOrEmpty(_hotline))
                {
                    <a class="shp-hotline" href="tel:@_hotline" title="Gọi cho quán">
                        📞 @_hotline
                    </a>
                }
                <a class="shp-cart" href="/cart" title="@AppI18n.Translate("common.cart")"
                   aria-label="@($"{AppI18n.Translate("common.cart")} ({CartState.TotalQuantity})")">
                    <span aria-hidden="true">🛒</span>
                    @if (CartState.TotalQuantity > 0)
                    {
                        <span class="shp-cart-badge">@CartState.TotalQuantity</span>
                    }
                </a>
                @* #196: Chữ lớn cho người lớn tuổi. *@
                <button type="button" class="shp-theme-toggle" @onclick="ToggleLargeText" title="Chữ lớn" aria-label="Chế độ chữ lớn" aria-pressed="@_isLargeText">
                    <span style="font-weight:bold;font-size:1.1em;">A+</span>
                </button>
                @* #197: Dark mode 3 chế độ Sáng/Tối/Tự động — đồng bộ với landing.
                   UIUX-1019 Agent4 (a11y): aria-label động theo _themeTitle để trình đọc
                   màn hình biết trạng thái HIỆN TẠI và hành động KẾ TIẾP (trước đây label
                   tĩnh "Chế độ sáng/tối/tự động", người khiếm thị không biết đang ở chế độ nào). *@
                <button type="button" class="shp-theme-toggle" @onclick="ToggleTheme" title="@_themeTitle" aria-label="@_themeTitle">
                    @_themeIcon
                </button>
                <a class="shp-order-btn" href="/cart">@AppI18n.Translate("shop.order_now")</a>

                <AuthorizeView>
                    <Authorized>
                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Cashier") || context.User.IsInRole("Kitchen"))
                        {
                            <a class="shp-account shp-admin-link" href="/dashboard" title="Khu vực quản trị">
                                🛠️ Vào trang quản trị
                            </a>
                        }
                        else
                        {
                            <div class="shp-user">
                                <a class="shp-account" href="/tai-khoan" title="Tài khoản mua hàng của bạn">
                                    👤 Xin chào, @(context.User.Identity?.Name ?? "bạn")
                                </a>
                                <button type="button" class="shp-logout" @onclick="SignOut" title="@AppI18n.Translate("shop.logout")">@AppI18n.Translate("shop.logout")</button>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a class="shp-account" href="/dang-nhap" title="Đăng nhập / đăng ký tài khoản mua hàng">
                            👤 @AppI18n.Translate("common.login")
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main class="shp-main" id="shp-main-content" tabindex="-1">
        @Body
    </main>

    <footer class="shp-footer" id="lien-he">
        <div class="shp-footer-inner">
            <div class="shp-footer-col">
                <div class="shp-logo-main">Xôi Phú Thượng</div>
                <p>Xôi dẻo thơm chuẩn vị làng nghề Phú Thượng, Hà Nội.<br />Đồ mỗi sáng, nóng hổi.</p>
                @if (!string.IsNullOrEmpty(_address))
                {
                    <p>📍 @_address</p>
                }
            </div>
            <div class="shp-footer-col">
                <h4>Khám phá</h4>
                <a href="/">Trang chủ</a>
                <a href="/shop">Thực đơn</a>
                <a href="/dat-so-luong-lon">Đặt số lượng lớn &amp; định kỳ</a>
                <a href="/track-order">Tra cứu đơn hàng</a>
            </div>
            <div class="shp-footer-col">
                <h4>Liên hệ</h4>
                @if (!string.IsNullOrEmpty(_hotline))
                {
                    <p>📞 Hotline: <a href="tel:@_hotline">@_hotline</a></p>
                }
                @if (!string.IsNullOrEmpty(_email))
                {
                    <p>✉️ @_email</p>
                }
                <a class="shp-admin-login" href="/login">🔐 Đăng nhập quản trị</a>
            </div>
        </div>
        <div class="shp-copyright">&copy; 2026 Xôi Phú Thượng. All rights reserved.</div>
    </footer>
</div>

@code {
    private bool _menuOpen;
    private string _hotline;
    private string _address;
    private string _email;
    private string _theme = "light"; // light | dark | auto
    private bool _isLargeText;

    // 2026-10-19: icon = TRẠNG THÁI HIỆN TẠI (user yêu cầu): đang tối hiện 🌙,
    // đang sáng hiện ☀️ — trước đây icon chỉ "hành động kế tiếp" (tối hiện ☀️)
    // khiến user thấy sai ("mặt trời nhưng lại là màu tối").
    private string _themeIcon => _theme switch
    {
        "dark" => "🌙",
        "auto" => "🌓",
        _ => "☀️",
    };

    private string _themeTitle => _theme switch
    {
        "dark" => "Đang: Tối — bấm để chuyển Tự động",
        "auto" => "Đang: Tự động theo giờ — bấm để chuyển Sáng",
        _ => "Đang: Sáng — bấm để chuyển Tối",
    };

    private bool _isDark => _theme == "dark" || _theme == "auto"; // for backwards compat checks

    private async Task ToggleTheme()
    {
        try
        {
            _theme = await JS.InvokeAsync<string>("ptToggleTheme", "pt-theme-shop");
            StateHasChanged();
        }
        catch { }
    }

    private async Task ToggleLargeText()
    {
        try
        {
            _isLargeText = await JS.InvokeAsync<bool>("ptToggleLargeText");
            StateHasChanged();
        }
        catch { }
    }

    private async Task NavigateBack()
    {
        try { await JS.InvokeVoidAsync("history.back"); }
        catch { Navigation.NavigateTo("/shop"); }
    }

    private bool IsShopHome =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Equals("shop", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("ptApplyTheme", "pt-theme-shop");
                await JS.InvokeVoidAsync("ptApplyLargeText");
                _theme = await JS.InvokeAsync<string>("ptGetTheme", "pt-theme-shop") ?? "light";
                _isLargeText = await JS.InvokeAsync<bool>("ptGetLargeText");
                StateHasChanged();
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += OnCartChanged;
        AppI18n.OnChange += OnLangChanged;
        await AppI18n.InitializeAsync();

        string hotline = null, address = null, email = null;
        try
        {
            var settings = await ShopSettingsService.GetPublicAsync();
            hotline = NormalizePhone(settings?.Hotline);
        }
        catch { }

        try
        {
            var landing = await LandingService.GetContentAsync();
            if (string.IsNullOrEmpty(hotline)) hotline = NormalizePhone(landing?.ContactPhone);
            address = landing?.ContactAddress;
            if (string.IsNullOrEmpty(email)) email = landing?.ContactEmail;
        }
        catch { }

        _hotline = hotline;
        _address = address;
        _email = email;
    }

    private static string NormalizePhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return null;
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return string.IsNullOrEmpty(digits) ? null : digits;
    }

    private string NavActive(string href)
    {
        try
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return string.Equals(path, href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? "active" : "";
        }
        catch { return ""; }
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private async Task SetLanguage(string language) => await AppI18n.SetLanguageAsync(language);

    private async Task SignOut()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token");
            await JS.InvokeVoidAsync("localStorage.removeItem", "phuthuong_access_token_expires");
        }
        catch { }
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        CartState.OnChange -= OnCartChanged;
        AppI18n.OnChange -= OnLangChanged;
    }
}
