@page "/products"
@attribute [Authorize]
@using System

<div class="lx-page-head">
    <h4 class="lx-page-title">Sản phẩm</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Sản phẩm</li>
    </ol>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center mb-3">
            <h4 class="card-title mb-0">Danh sách sản phẩm</h4>

            <div class="d-flex flex-wrap ml-md-auto mt-2 mt-md-0">
                <button type="button" class="btn btn-secondary mr-2 mb-1" @onclick="ExportAsPdf">
                    Xuất PDF
                </button>
                <button type="button" class="btn btn-secondary mr-2 mb-1" @onclick="ExportAsCsv">
                    Xuất CSV
                </button>
                @if (HasPermission("products.edit"))
                {
                    <button class="btn btn-primary mb-1" @onclick="QuickAddProduct">
                        Thêm sản phẩm
                    </button>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(ToggleError))
        {
            <div class="alert alert-danger">@ToggleError</div>
        }
        @if (!string.IsNullOrEmpty(_reorderMessage))
        {
            <div class="alert alert-success">@_reorderMessage</div>
        }
        @if (!string.IsNullOrEmpty(_reorderError))
        {
            <div class="alert alert-danger">@_reorderError</div>
        }
        @if (_orderChanged)
        {
            <div class="alert alert-info d-flex align-items-center justify-content-between">
                <span>↕️ Bạn đã đổi thứ tự món. Nhấn <strong>Lưu thứ tự</strong> để áp dụng lên trang bán hàng.</span>
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveOrderAsync" disabled="@_reordering">
                    @(_reordering ? "Đang lưu..." : "Lưu thứ tự")
                </button>
            </div>
        }
        <div class="table-responsive">

            @if (Products == null)
            {
                <p><em>Đang tải...</em></p>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 36px;" title="Kéo thả để sắp xếp thứ tự hiển thị"></th>
                            <th>Tên món</th>
                            <th>Mã</th>
                            <th class="text-right">Giá (₫)</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Products)
                        {
                            <tr @key="product.Id"
                                draggable="true"
                                @ondragstart="() => OnDragStart(product)"
                                @ondragover:preventDefault="true"
                                @ondrop="() => OnDrop(product)"
                                @ondragend="OnDragEnd"
                                class="@(_draggedProduct?.Id == product.Id ? "table-active" : null)">
                                <td class="text-muted" style="cursor: grab; font-size: 18px;" title="Kéo để sắp xếp">☰</td>
                                <td>
                                    <a href="@($"/products/{product.Id}")">@product.Name</a>
                                    @if (product.IsNew)
                                    {
                                        <span class="badge badge-success ml-1">Món mới</span>
                                    }
                                    @if (product.IsSignature)
                                    {
                                        <span class="badge badge-warning ml-1">Signature</span>
                                    }
                                    @if (IsOutOfSeason(product))
                                    {
                                        <span class="badge badge-secondary ml-1" title="Ngoài khung thời gian bán theo mùa — web không hiển thị món này">Hết mùa</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(product.Category))
                                    {
                                        <br /><small class="text-muted">@product.Category</small>
                                    }
                                </td>
                                <td>@product.Code</td>
                                <td class="text-right">@product.Price.ToString("N0")<small class="text-muted">₫/@(string.Equals(product.Unit, "kg", StringComparison.OrdinalIgnoreCase) ? "kg" : "suất")</small></td>
                                <td>
                                    @if (product.Status == "Active")
                                    {
                                        <span class="badge badge-success">Đang bán</span>
                                    }
                                    else if (product.Status == "Inactive")
                                    {
                                        <span class="badge badge-secondary">Hết hàng</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dark">@product.Status</span>
                                    }
                                </td>
                                <td class="text-right text-nowrap">
                                    @if (HasPermission("products.edit"))
                                    {
                                        <button @onclick="(() => ToggleAvailability(product))" class="btn btn-sm lx-btn-icon btn-outline-warning" title="Bật/tắt bán (hết hàng)">
                                            <i class="fas @(product.Status == "Active" ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    }
                                    @if (HasPermission("products.edit"))
                                    {
                                        <button @onclick="(() => EditProduct(product))" class="btn btn-sm lx-btn-icon btn-primary" title="Sửa"><i class="fas fa-pen"></i></button>
                                    }
                                    @if (HasPermission("products.delete"))
                                    {
                                        <button @onclick="(() => DeleteProduct(product))" class="btn btn-sm lx-btn-icon btn-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<ConfirmDialog @ref="DeleteDialog" Title="Xóa sản phẩm" YesText="Có" NoText="Không" ConfirmEventCallback="ConfirmedDeleteProduct">
    <Message>
        Bạn có chắc muốn xóa sản phẩm: <strong>@DeletingProduct.Name</strong>?
    </Message>
</ConfirmDialog>
