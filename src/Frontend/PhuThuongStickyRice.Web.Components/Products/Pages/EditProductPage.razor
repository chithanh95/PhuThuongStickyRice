@page "/products/edit/{ProductId:guid}"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Products.Components

@if (IsNotFound)
{
    <div class="text-center py-5">
        <div class="lx-empty-icon" aria-hidden="true">🍚</div>
        <h2 class="mt-3">Không tìm thấy sản phẩm</h2>
        <p class="text-muted">Sản phẩm này không tồn tại hoặc đã bị xóa.</p>
        <div class="mt-4">
            <a class="btn btn-outline-secondary" href="/products">Quay lại danh sách</a>
        </div>
    </div>
}
else
{
<div class="lx-page-head">
    <h4 class="lx-page-title">Sửa sản phẩm</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li><a href="/products">Sản phẩm</a></li>
        <li class="current">Sửa sản phẩm</li>
    </ol>
</div>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Thông tin sản phẩm</h4>
        <AddEditProduct Product="Product"></AddEditProduct>
    </div>
    <div class="card-footer">
        <NavLink class="btn btn-outline-secondary" href="products">
            <i class="fa-solid fa-chevron-left"></i> Quay lại
        </NavLink>
    </div>
</div>

@* Item 148: change history ("ai sửa gì, khi nào"). *@
<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">🕘 Lịch sử thay đổi</h4>
        @if (_changeLog == null)
        {
            <p><em>Đang tải...</em></p>
        }
        else if (_changeLog.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có thay đổi nào được ghi nhận.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Người sửa</th>
                            <th>Nội dung thay đổi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _changeLog)
                        {
                            <tr @key="log.Id">
                                <td class="text-nowrap">@log.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(string.IsNullOrWhiteSpace(log.ChangedBy) ? "—" : log.ChangedBy)</td>
                                <td>
                                    <strong>@log.FieldName</strong>:
                                    <span class="text-muted">@DisplayValue(log.OldValue)</span>
                                    →
                                    <span>@DisplayValue(log.NewValue)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
}
