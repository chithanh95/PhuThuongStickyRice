@page "/products/{ProductId:guid}"
@attribute [Authorize]

@if (NotFound)
{
    <div class="text-center py-5">
        <div style="font-size: 4rem;" aria-hidden="true">🍚</div>
        <h2 class="mt-3">Không tìm thấy sản phẩm</h2>
        <p class="text-muted">Sản phẩm này không tồn tại hoặc đã bị xóa.</p>
        <div class="mt-4">
            <a class="btn btn-outline-secondary" href="/products">Quay lại danh sách</a>
        </div>
    </div>
}
else if (Product == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
<div class="card">
    <div class="card-header">
        Chi tiết sản phẩm: @Product.Name
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <div class="row">
                    <div class="col-md-4">Tên món:</div>
                    <div class="col-md-8">@Product.Name</div>
                </div>
                <div class="row">
                    <div class="col-md-4">Mã:</div>
                    <div class="col-md-8">@Product.Code?.ToUpper()</div>
                </div>
                <div class="row">
                    <div class="col-md-4">Mô tả:</div>
                    <div class="col-md-8">@Product.Description</div>
                </div>
                <div class="row">
                    <div class="col-md-4">Giá:</div>
                    <div class="col-md-8">

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <img class="center-block img-fluid"
                     style="max-width:200px; margin:2px;"
                     src="/images/logo.png"
                     title="@Product.Name" />
            </div>
        </div>
    </div>

    <div class="card-footer">
        <NavLink class="btn btn-outline-secondary" href="products">
            <i class="fa fa-chevron-left"></i> Quay lại
        </NavLink>
        &nbsp;
        <button @onclick="@(()=> NavManager.NavigateTo($"/products/edit/{ProductId}"))" class="btn btn-primary" title="Sửa">Sửa</button>
    </div>
</div>
}
