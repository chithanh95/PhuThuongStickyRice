@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject CatalogAdminService CatalogService
@inject PhuThuongStickyRice.Web.Components.Admin.Services.AdminSystemService AdminSystemService
@inject PhuThuongStickyRice.Web.Components.Core.Services.ToastService Toasts

<EditForm Model="Product" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-danger py-2" />


    <div class="form-group row">
        <label for="productName" class="col-sm-2 col-form-label">Tên món: </label>
        <div class="col-sm-10">
            <InputText id="productName" class="form-control" @bind-Value="Product.Name" placeholder="Nhập tên món"></InputText>
        </div>
    </div>

    <div class="form-group row">
        <label for="code" class="col-sm-2 col-form-label">Mã: </label>
        <div class="col-sm-10">
            <InputText id="code" class="form-control" @bind-Value="Product.Code" placeholder="Nhập mã (VD: xoi-gac)"></InputText>
        </div>
    </div>

    <div class="form-group row">
        <label for="price" class="col-sm-2 col-form-label">Giá (₫): </label>
        <div class="col-sm-10">
            <InputNumber id="price" class="form-control" @bind-Value="Product.Price" placeholder="VD: 35000"></InputNumber>
        </div>
    </div>

    <div class="form-group row">
        <label for="unit" class="col-sm-2 col-form-label">Đơn vị tính: </label>
        <div class="col-sm-10">
            <InputSelect id="unit" class="form-control" @bind-Value="Product.Unit">
                <option value="suất">Suất (bán theo suất)</option>
                <option value="kg">Kg (bán theo cân — giá nhập là giá 1kg)</option>
            </InputSelect>
            <small class="form-text text-muted">Món bán theo cân: giá là giá mỗi kg, khách chọn gói 500g/1kg ở mục size.</small>
        </div>
    </div>

    <div class="form-group row">
        <label for="costprice" class="col-sm-2 col-form-label">Giá vốn (₫): </label>
        <div class="col-sm-10">
            <InputNumber id="costprice" class="form-control" @bind-Value="Product.CostPrice" placeholder="VD: 20000"></InputNumber>
            <small class="form-text text-muted">Dùng để tính lợi nhuận trên mỗi món.</small>
        </div>
    </div>

    @* Item 256: giá khuyến mãi — để 0 hoặc trống là không KM. *@
    <div class="form-group row">
        <label for="promoprice" class="col-sm-2 col-form-label">Giá KM (₫): </label>
        <div class="col-sm-10">
            <InputNumber id="promoprice" class="form-control" @bind-Value="Product.PromoPrice" placeholder="VD: 28000 (để trống = không KM)"></InputNumber>
            <small class="form-text text-muted">Khi có giá KM nhỏ hơn giá bán, card món hiện "giá gốc → giá KM" cho khách thấy.</small>
        </div>
    </div>

    <div class="form-group row">
        <label for="description" class="col-sm-2 col-form-label">Mô tả: </label>
        <div class="col-sm-10">
            <InputText id="description" class="form-control" @bind-Value="Product.Description" placeholder="Nhập mô tả"></InputText>
        </div>
    </div>

    <div class="form-group row">
        <label for="category" class="col-sm-2 col-form-label">Danh mục: </label>
        <div class="col-sm-10">
            <InputSelect id="category" class="form-control" @bind-Value="Product.Category">
                <option value="">-- Chọn danh mục --</option>
                <option value="Xôi mặn">Xôi mặn</option>
                <option value="Xôi ngọt">Xôi ngọt</option>
                <option value="Combo">Combo</option>
                <option value="Topping">Topping</option>
                <option value="Đồ uống">Đồ uống</option>
            </InputSelect>
        </div>
    </div>

    <div class="form-group row">
        <label for="branch" class="col-sm-2 col-form-label">Chi nhánh: </label>
        <div class="col-sm-10">
            <InputSelect id="branch" class="form-control" @bind-Value="Product.BranchId">
                <option value="">-- Tất cả chi nhánh --</option>
                @if (_branches != null)
                {
                    @foreach (var branch in _branches)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                }
            </InputSelect>
            <small class="form-text text-muted">Để trống = bán tại mọi chi nhánh.</small>
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Huy hiệu: </label>
        <div class="col-sm-10">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="badge-new" @bind="Product.IsNew" />
                <label class="form-check-label" for="badge-new">Món mới</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="badge-signature" @bind="Product.IsSignature" />
                <label class="form-check-label" for="badge-signature">Signature</label>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-2 col-form-label">Ảnh món: </label>
        <div class="col-sm-10">
            @if (!string.IsNullOrEmpty(_imageUrl))
            {
                <div class="mb-2 text-center" style="width: 150px;">
                    <img src="@AdminCommerceService.ResolveImageUrl(_imageUrl)" alt="Ảnh món" class="img-thumbnail" style="width: 140px; height: 140px; object-fit: cover;"
                         onerror="this.onerror=null; this.src='data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTQwIiBoZWlnaHQ9IjE0MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTQwIiBoZWlnaHQ9IjE0MCIgZmlsbD0iI2YwZjBmMCIvPjx0ZXh0IHg9IjcwIiB5PSI3NSIgdGV4dC1hbmNob3I9Im1pZGRsZSIgZmlsbD0iIzk5OSIgZm9udC1zaXplPSIxNCI+Tm8gaW1hZ2U8L3RleHQ+PC9zdmc+';" />
                    <div class="mt-1">
                        <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="RemoveImage">Xóa</button>
                    </div>
                </div>
            }
            <label for="product-images-input" class="lx-dropzone">
                <div class="lx-dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                <div class="lx-dropzone-text">Thả ảnh vào đây hoặc bấm để chọn.</div>
                <div class="lx-dropzone-hint">Ảnh tự nén trước khi tải lên.</div>
            </label>
            <input type="file" id="product-images-input" accept="image/*" style="position:absolute; width:1px; height:1px; opacity:0; overflow:hidden;" @onchange="OnImagesSelected" />
            @if (_uploadingImages)
            {
                <div class="text-muted mt-1">Đang tải ảnh lên...</div>
            }
            @if (!string.IsNullOrEmpty(_imageError))
            {
                <div class="alert alert-danger mt-2 py-1">@_imageError</div>
            }
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Đang lưu..." : "Lưu")</button>
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="alert alert-danger mt-2 py-2">@_saveError</div>
            }
        </div>
    </div>
</EditForm>

@if (Product.Id != Guid.Empty)
{
    <hr />
    <h5>Size (Nhỏ / Vừa / Lớn)</h5>
    <p class="text-muted"><small>Mỗi size có giá bán riêng. Không có size = bán theo giá gốc ở trên.</small></p>

    @if (!string.IsNullOrEmpty(_sizeError))
    {
        <div class="alert alert-danger">@_sizeError</div>
    }

    @if (_sizes == null)
    {
        <p><em>Đang tải sizes...</em></p>
    }
    else if (_sizes.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr><th>Tên size</th><th class="text-right">Giá (₫)</th><th>Thứ tự</th><th></th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var size in _sizes)
                    {
                        <tr @key="size.Id">
                            <td>@size.Name</td>
                            <td class="text-right">@size.Price.ToString("N0")</td>
                            <td>@size.SortOrder</td>
                            <td>
                                @if (size.IsActive)
                                {
                                    <span class="badge badge-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Ẩn</span>
                                }
                            </td>
                            <td class="text-right">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditSize(size)">Sửa</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSizeAsync(size)">Xóa</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">@(_editingSizeId == null ? "Thêm size" : "Sửa size")</div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Tên size</label>
                    <input class="form-control" @bind="_sizeForm.Name" placeholder="VD: Nhỏ / Vừa / Lớn" />
                </div>
                <div class="form-group col-md-3">
                    <label>Giá (₫)</label>
                    <input type="number" min="0" step="1000" class="form-control" @bind="_sizeForm.Price" />
                </div>
                <div class="form-group col-md-2">
                    <label>Thứ tự</label>
                    <input type="number" class="form-control" @bind="_sizeForm.SortOrder" />
                </div>
                <div class="form-group col-md-3 d-flex align-items-end">
                    <div class="custom-control custom-switch mb-2">
                        <input type="checkbox" class="custom-control-input" id="size-active" @bind="_sizeForm.IsActive" />
                        <label class="custom-control-label" for="size-active">Đang bán</label>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary" @onclick="SaveSizeAsync" disabled="@_savingSize">
                @(_savingSize ? "Đang lưu..." : (_editingSizeId == null ? "Thêm size" : "Cập nhật"))
            </button>
            @if (_editingSizeId != null)
            {
                <button class="btn btn-outline-secondary ml-2" @onclick="CancelEditSize">Hủy</button>
            }
        </div>
    </div>
}

@code {
    // Size-option state (only for existing products).
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel> _sizes;
    private PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel _sizeForm
        = new PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel();
    private Guid? _editingSizeId;
    private bool _savingSize;
    private string _sizeError;

    // Item 109: branch picker.
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel> _branches;

    protected override async Task OnParametersSetAsync()
    {
        // Items 164/166: load the hours + gallery editors from the product.
        SyncFromProduct();

        if (Product?.Id != Guid.Empty)
        {
            await LoadSizesAsync();
        }

        if (_branches == null)
        {
            try
            {
                _branches = await AdminSystemService.GetBranchesAsync();
            }
            catch (Exception)
            {
                _branches = new List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel>();
            }
        }
    }

    private bool HasTag(string tag)
    {
        var tags = (Product.Tags ?? "").Split(',', ';', ' ')
            .Select(x => x.Trim().ToLowerInvariant());
        return tags.Contains(tag);
    }

    private void ToggleTag(string tag, bool on)
    {
        var tags = (Product.Tags ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().ToLowerInvariant())
            .Where(x => x.Length > 0 && x != tag)
            .ToList();
        if (on)
        {
            tags.Add(tag);
        }

        Product.Tags = tags.Count == 0 ? null : string.Join(",", tags);
    }

    private async Task LoadSizesAsync()
    {
        try
        {
            _sizes = await CatalogService.GetSizeOptionsAsync(Product.Id);
        }
        catch (Exception)
        {
            _sizeError = "Không tải được danh sách size.";
            _sizes = new List<PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel>();
        }
    }

    private void StartEditSize(PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel s)
    {
        _editingSizeId = s.Id;
        _sizeForm = new PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel
        {
            Name = s.Name,
            Price = s.Price,
            SortOrder = s.SortOrder,
            IsActive = s.IsActive,
            ProductId = s.ProductId
        };
        _sizeError = null;
    }

    private void CancelEditSize()
    {
        _editingSizeId = null;
        _sizeForm = new PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel();
    }

    private async Task SaveSizeAsync()
    {
        _sizeError = null;
        _savingSize = true;
        try
        {
            _sizeForm.ProductId = Product.Id;
            if (_editingSizeId == null)
            {
                await CatalogService.CreateSizeOptionAsync(_sizeForm);
            }
            else
            {
                await CatalogService.UpdateSizeOptionAsync(_editingSizeId.Value, _sizeForm);
            }

            CancelEditSize();
            await LoadSizesAsync();
        }
        catch (Exception)
        {
            _sizeError = "Lưu size thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _savingSize = false;
        }
    }

    private async Task DeleteSizeAsync(PhuThuongStickyRice.Web.Components.Admin.Models.ProductSizeOptionModel s)
    {
        try
        {
            await CatalogService.DeleteSizeOptionAsync(s.Id);
            await LoadSizesAsync();
        }
        catch (Exception)
        {
            _sizeError = "Xóa size thất bại. Vui lòng thử lại.";
        }
    }
}
