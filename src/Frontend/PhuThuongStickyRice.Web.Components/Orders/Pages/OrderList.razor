    private RenderFragment ConfirmPaymentButton(OrderModel order) => builder =>
    {
        if (order.PaymentStatus != "PendingConfirmation")
        {
            return;
        }

        // Item 155: "Đã nhận tiền" needs orders.confirm-payment.
        if (!HasPermission("orders.confirm-payment"))
        {
            return;
        }

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", "btn btn-sm btn-outline-success mr-1");
        builder.AddAttribute(2, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ConfirmPayment(order)));
        builder.AddContent(3, "Đã nhận tiền");
        builder.CloseElement();
    };

    /// <summary>
    /// Item 163: "💵 Đã thu tiền" — 1-click cash-collection marking for
    /// orders that are not cancelled and not yet collected. Shown next to
    /// the status buttons; collected orders show a badge instead.
    /// </summary>
    private RenderFragment CollectCashButton(OrderModel order) => builder =>
    {
        if (order.CashCollected)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge badge-success");
            builder.AddAttribute(2, "title",
                order.CashCollectedAt.HasValue
                    ? $"Thu lúc {order.CashCollectedAt.Value.ToLocalTime():HH:mm dd/MM/yyyy}"
                    : null);
            builder.AddContent(3, "💵 Đã thu");
            builder.CloseElement();
            return;
        }

        if (order.Status == "Cancelled")
        {
            return;
        }

        // Item 155: reuses orders.confirm-payment (cash handling).
        if (!HasPermission("orders.confirm-payment"))
        {
            return;
        }

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", "btn btn-sm btn-outline-success mr-1");
        builder.AddAttribute(2, "title", "Đánh dấu đã thu tiền mặt");
        builder.AddAttribute(3, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => CollectCash(order)));
        builder.AddContent(4, "💵 Thu tiền");
        builder.CloseElement();
    };

    /// <summary>Item 163: marks cash as collected, then reloads the page.</summary>
    private async Task CollectCash(OrderModel order)
    {
        try
        {
            await OrderService.MarkCashCollectedAsync(order.Id);
            await LoadOrders(_page);
        }
        catch (Exception ex)
        {
            _shipperMessage = "Lỗi: " + ex.Message;
        }
    }

    private bool _copyingMessage;
    private string _copyMessageFeedback;

    /// <summary>
    /// Item 162: renders the message template for the order's current
    /// status and copies it to the clipboard (JS interop). The template
    /// names can be managed at /admin/mau-tin-nhan.
    /// </summary>
    private async Task CopyMessageAsync(OrderModel order)
    {
        _copyingMessage = true;
        _copyMessageFeedback = null;
        try
        {
            var preview = await OrderService.GetMessagePreviewAsync(order.Id, order.Status);
            if (string.IsNullOrWhiteSpace(preview?.Message))
            {
                _copyMessageFeedback = "Không có nội dung mẫu.";
                return;
            }

            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", preview.Message);
            _copyMessageFeedback = "Đã copy vào clipboard — dán vào Zalo/tin nhắn để gửi tay.";
        }
        catch (Exception ex)
        {
            _copyMessageFeedback = "Lỗi: " + ex.Message;
        }
        finally
        {
            _copyingMessage = false;
        }
    }

    private static RenderFragment PaymentInfo(OrderModel order) => builder =>
    {
        var method = order.PaymentMethod switch
        {
            "Cod" => "COD",
            "BankTransfer" => "VietQR",
            "MoMo" => "MoMo",
            _ => order.PaymentMethod
        };
        var (css, label) = order.PaymentStatus switch
        {
            "Unpaid" => ("badge badge-warning", "Chưa thanh toán"),
            "PendingConfirmation" => ("badge badge-info", "Chờ xác nhận"),
            "Paid" => ("badge badge-success", "Đã thanh toán"),
            "Failed" => ("badge badge-danger", "Thất bại"),
            _ => ("badge badge-light", order.PaymentStatus)
        };
        builder.OpenElement(0, "div");
        builder.AddContent(1, method);
        builder.CloseElement();
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", css);
        builder.AddContent(4, label);
        builder.CloseElement();
    };

    private RenderFragment NextStatusButtons(OrderModel order) => builder =>
    {
        var next = order.Status switch
        {
            "Pending" => new[] { "Confirmed", "Cancelled" },
            "Confirmed" => new[] { "Preparing", "Cancelled" },
            "Preparing" => new[] { "Delivering", "Cancelled" },
            "Delivering" => new[] { "Completed", "Cancelled" },
            _ => System.Array.Empty<string>()
        };

        // Item 155: cancelling needs orders.cancel; other transitions need
        // orders.confirm. Buttons without permission are hidden; the API
        // re-checks server-side.
        var seq = 0;
        foreach (var s in next)
        {
            var status = s;
            var requiredKey = status == "Cancelled" ? "orders.cancel" : "orders.confirm";
            if (!HasPermission(requiredKey))
            {
                continue;
            }

            var css = status == "Cancelled" ? "btn btn-sm btn-outline-danger mr-1" : "btn btn-sm btn-outline-primary mr-1";
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", css);
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OnStatusButtonClick(order, status)));
            builder.AddContent(seq++, ButtonLabel(status));
            builder.CloseElement();
        }
    };

    private static string ButtonLabel(string status) => status switch
    {
        "Confirmed" => "Xác nhận",
        "Preparing" => "Chuẩn bị",
        "Delivering" => "Giao hàng",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Hủy",
        _ => status
    };

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    /// <summary>Wave 6c (item 34): Vietnamese labels for the timeline.</summary>
    private static string StatusLabel(string status) => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "Preparing" => "Đang chuẩn bị",
        "Delivering" => "Đang giao",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        _ => status
    };

    private static System.Collections.Generic.Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new System.Collections.Generic.Dictionary<string, string>(System.StringComparer.OrdinalIgnoreCase);
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return result;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            result[Uri.UnescapeDataString(pair.Substring(0, eq))] =
                Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
        }

        return result;
    }

    /// <summary>Fulfillment badge: "Shipper lấy" / "Tự lấy" / legacy "Giao".</summary>
    private static RenderFragment FulfillmentBadge(string fulfillment, System.DateTime? pickedUpAt) => builder =>
    {
        var (css, label) = fulfillment switch
        {
            "ShipperPickup" => ("badge badge-info", pickedUpAt.HasValue ? "🛵 Đã lấy hàng" : "🛵 Shipper lấy"),
            "Pickup" => ("badge badge-secondary", "🏪 Tự lấy"),
            _ => ("badge badge-light", "Giao")
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css + " mt-1");
        builder.AddContent(2, label);
        builder.CloseElement();
    };

    private static RenderFragment StatusBadge(string status) => builder =>
    {
        var css = status switch
        {
            "Pending" => "badge badge-warning",
            "Confirmed" => "badge badge-info",
            "Preparing" => "badge badge-primary",
            "Delivering" => "badge badge-secondary",
            "Completed" => "badge badge-success",
            "Cancelled" => "badge badge-danger",
            _ => "badge badge-light"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, status);
        builder.CloseElement();
    };
