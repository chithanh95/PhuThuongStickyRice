    /// <param name="order">Đơn cần mở/đóng chi tiết.</param>
    private async Task ToggleDetail(OrderModel order)
    {
        var opening = _expandedOrderId != order.Id;
        _expandedOrderId = opening ? order.Id : null;
        _noteMessage = null;
        _statusHistory = null;

        if (opening)
        {
