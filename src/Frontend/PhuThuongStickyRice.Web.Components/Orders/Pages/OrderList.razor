@* Item 233: modal chọn lý do khi nhân viên hủy đơn. *@
@if (_cancelTarget != null)
{
    <div class="modal d-block ol-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true" aria-label="Chọn lý do hủy đơn" @onkeydown="CancelModalKeyDown">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title mb-0">Hủy đơn @_cancelTarget.OrderNumber</h6>
                    <button type="button" class="close" aria-label="Đóng" @onclick="CloseCancelModal"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body py-2">
                    <p class="mb-2">Chọn lý do hủy (bắt buộc) để báo cáo:</p>
                    @foreach (var reason in CancelReasons)
                    {
                        <div class="form-check mb-2" @key="reason">
                            <input class="form-check-input" type="radio" name="adminCancelReason"
                                   id="acr-@reason.GetHashCode()" value="@reason"
                                   checked="@(_cancelReason == reason)"
                                   @onchange="() => _cancelReason = reason" />
                            <label class="form-check-label" for="acr-@reason.GetHashCode()">@reason</label>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_cancelReasonError))
                    {
                        <div class="alert alert-danger mt-2 mb-0" role="alert">@_cancelReasonError</div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCancelModal">Không hủy</button>
                    <button type="button" class="btn btn-danger ol-btn-confirm" @onclick="ConfirmCancelModal" disabled="@_cancelling">
                        @(_cancelling ? "Đang hủy..." : "Xác nhận hủy đơn")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Item 233: lý do hủy đơn cho nhân viên chọn — đồng bộ với backend.
    /// </summary>
    private static readonly string[] CancelReasons = new[]
    {
        "Đổi ý", "Đặt nhầm món", "Chờ quá lâu", "Món hết hàng", "Lý do khác"
    };

    private OrderModel _cancelTarget;
    private string _cancelReason;
    private string _cancelReasonError;
    private bool _cancelling;

    // Luồng hủy đơn của admin (item 233): lý do hủy là BẮT BUỘC để phục vụ báo cáo
    // lý do hủy; state modal được reset mỗi lần mở/đóng để không rò rỉ đơn cũ.
    private void OpenCancelModal(OrderModel order)
    {
        _cancelTarget = order;
        _cancelReason = null;
        _cancelReasonError = null;
    }

    private void CloseCancelModal()
    {
        _cancelTarget = null;
        _cancelReason = null;
        _cancelReasonError = null;
    }

    /// <summary>
    /// UIUX-1020 Agent4 (a11y): đóng modal bằng phím Escape — @onkeydown đặt trên
    /// lớp phủ modal, sự kiện bàn phím bubble từ các control bên trong lên đây.
    /// JS shortcut handler hiện tại không xử lý Escape cho modal (trên radio chỉ
    /// blur, trên nút thì bỏ qua) nên người dùng bàn phím phải có lối thoát chuẩn.
    /// </summary>
    private void ShortcutHelpKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _showShortcutHelp = false;
    }

    /// <summary>Đóng modal chọn lý do hủy đơn khi bấm Escape (xem <see cref="ShortcutHelpKeyDown"/>).</summary>
    private void CancelModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseCancelModal();
    }

    private async Task ConfirmCancelModal()
    {
        if (_cancelTarget == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            _cancelReasonError = "Vui lòng chọn một lý do hủy đơn.";
            return;
        }

        _cancelling = true;
        try
        {
            await ChangeStatus(_cancelTarget, "Cancelled", _cancelReason);
            CloseCancelModal();
        }
        finally
        {
            _cancelling = false;
        }
    }
    private PagedResult<OrderModel> _paged;
    private int _page = 1;

    // Item 155: fine-grained permission keys of the current user.
    private System.Collections.Generic.HashSet<string> _permissions =
        new(System.StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Item 155: kiểm tra quyền chi tiết của user hiện tại. Nút thiếu quyền bị ẩn
    /// hẳn (không chỉ mờ) để staff không thấy chức năng mình không được dùng.
    /// </summary>
    /// <param name="key">Mã quyền (vd "orders.confirm", "orders.cancel").</param>
    /// <returns>true khi user có quyền.</returns>
    private bool HasPermission(string key) => _permissions.Contains(key);
    private string _searchTerm;
    private string _statusFilter;
    private string _shipperFilter;

    // Item 163: cash-collection filter ("", "collected", "uncollected").
    private string _cashFilter;

    // Item 130 (đúng): only VIP customers' orders.
    private bool _vipOnly;

    // Wave 6c (item 35): date-range filter.
    private DateTime? _fromDate;
    private DateTime? _toDate;

    // Wave 6c (item 32): export state.
    private bool _exporting;

    private Guid? _expandedOrderId;
    private System.Threading.Timer _searchTimer;

    // Wave 6c (item 33): internal note editor.
    private string _adminNoteDraft;
    private bool _savingNote;
    private string _noteMessage;

    /// <summary>Lỗi từ các thao tác đổi trạng thái / xác nhận thanh toán (bug hunt 2026-10-19).</summary>
    private string _actionError;

    // Wave 6c (item 34): status timeline of the expanded order.
    private List<OrderStatusHistoryModel> _statusHistory;
    private bool _historyLoading;

    // Item 82: shippers for the filter dropdown and assignment.
    // Message gắn theo từng đơn: message gán shipper của đơn A không hiển thị
    // sang đơn B đang mở, và lỗi hiển thị màu đỏ (text-danger) thay vì xanh.
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.ShipperModel> _shippers;
    private Guid? _shipperMessageOrderId;
    private string _shipperMessage;
    private bool _shipperMessageIsError;

    /// <summary>
    /// Hiện thông báo gán shipper cho đúng đơn đã thao tác.
    /// </summary>
    private void ShowShipperMessage(Guid orderId, string message, bool isError)
    {
        _shipperMessageOrderId = orderId;
        _shipperMessage = message;
        _shipperMessageIsError = isError;
    }

    // Item 141: keyboard shortcuts.
    private DotNetObjectReference<OrderList> _shortcutsRef;
    private bool _shortcutsStarted;
    private int _selectedIndex = -1;
    private bool _showShortcutHelp;

    // Item 142: duplicate-phone groups.
    private List<DuplicateOrderGroupModel> _duplicateGroups;
    private bool _showDuplicates;
    private bool _duplicatesDismissed;
    private bool _merging;
    private string _mergeMessage;
    private bool _mergeIsError;
    private readonly System.Collections.Generic.Dictionary<string, System.Guid> _mergePrimary = new System.Collections.Generic.Dictionary<string, System.Guid>();

    // Thứ tự chuẩn của luồng đơn hàng (dùng cho filter và các chuyển trạng thái hợp lệ).
    private static readonly string[] Statuses =
        { "Pending", "Confirmed", "Preparing", "Delivering", "Completed", "Cancelled" };

    /// <summary>
    /// Tải quyền, nhận deep link (?status=, ?searchTerm=, ?fromDate=, ?toDate=),
    /// tải danh sách shipper và trang đơn đầu tiên, rồi load nền nhóm đơn trùng SĐT.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Support deep links like /orders?status=Pending or /orders?searchTerm=090...
        // Bug-hunt 2026-10-19: ParseQuery dùng Uri.UnescapeDataString — URL chứa
        // % sai định dạng (vd /orders?status=%zz) sẽ ném exception; bọc try để
        // trang /orders không crash về error boundary với deep link hỏng
        // (cùng pattern đã dùng ở Cart/TrackOrder/MoMoSimulator/Checkout).
        System.Collections.Generic.Dictionary<string, string> query;
        try
        {
            query = ParseQuery(Navigation.Uri);
        }
        catch (Exception)
        {
            query = new System.Collections.Generic.Dictionary<string, string>(
                System.StringComparer.OrdinalIgnoreCase);
        }
        if (query.TryGetValue("status", out var status) && !string.IsNullOrWhiteSpace(status))
        {
            _statusFilter = status;
        }

        if (query.TryGetValue("searchTerm", out var searchTerm) && !string.IsNullOrWhiteSpace(searchTerm))
        {
            _searchTerm = searchTerm;
        }

        // Wave 6c (item 35): deep links like /orders?fromDate=2026-10-01.
        if (query.TryGetValue("fromDate", out var fromDate) && DateTime.TryParse(fromDate, out var fd))
        {
            _fromDate = fd.Date;
        }

        if (query.TryGetValue("toDate", out var toDate) && DateTime.TryParse(toDate, out var td))
        {
            _toDate = td.Date;
        }

        // perf-hunt 2026-10-19 (run 22:35): 3 loader độc lập chạy song song
        // (cắt ~2 round-trip khi mở trang /orders). Mỗi loader fail-soft riêng
        // như cũ, ghi field riêng nên không race; LoadOrders không dùng
        // _permissions/_shippers nên không phụ thuộc thứ tự.
        var permissionsTask = LoadPermissionsAsync();
        var shippersTask = LoadShippersAsync();
        var ordersTask = LoadOrders(1);
        await Task.WhenAll(permissionsTask, shippersTask, ordersTask);

        // Item 142: load duplicate-phone groups (best effort — never blocks the page).
        _ = LoadDuplicateGroupsAsync();
    }

    /// <summary>
    /// Item 155: fine-grained permissions gate the sensitive buttons.
    /// Failure to load = no permissions (buttons hidden, APIs re-check).
    /// </summary>
    private async Task LoadPermissionsAsync()
    {
        try
        {
            _permissions = await PermissionService.GetMyPermissionsAsync();
        }
        catch
        {
            _permissions = new System.Collections.Generic.HashSet<string>(
                System.StringComparer.OrdinalIgnoreCase);
        }
    }

    /// <summary>Tải danh sách shipper cho bộ lọc/gán đơn (fail-soft).</summary>
    private async Task LoadShippersAsync()
    {
        try
        {
            _shippers = await AdminOperationsService.GetShippersAsync(false)
                ?? new List<PhuThuongStickyRice.Web.Components.Admin.Models.ShipperModel>();
        }
        catch (Exception)
        {
            _shippers = new List<PhuThuongStickyRice.Web.Components.Admin.Models.ShipperModel>();
        }
    }

    /// <summary>
    /// Item 141: gắn listener phím tắt 1 lần duy nhất sau lần render đầu.
    /// Fail-soft — trang vẫn chạy bình thường nếu JS interop lỗi.
    /// </summary>
    /// <param name="firstRender">true ở lần render đầu tiên.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Item 141: attach the keyboard-shortcut listener once.
        if (firstRender && !_shortcutsStarted)
        {
            _shortcutsStarted = true;
            try
            {
                _shortcutsRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("interop.orderShortcuts.start", _shortcutsRef);
            }
            catch (Exception)
            {
                // Shortcuts are a nice-to-have; the page works without them.
            }
        }
    }

    /// <summary>Dừng listener phím tắt JS và giải phóng DotNetObjectReference + timer tìm kiếm.</summary>
    /// <returns>Task dispose bất đồng bộ.</returns>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("interop.orderShortcuts.stop");
        }
        catch (Exception)
        {
        }

        _shortcutsRef?.Dispose();
        _searchTimer?.Dispose();
    }

    /// <summary>
    /// Id shipper đang lọc (parse từ dropdown). Guid.Empty = bỏ lọc.
    /// </summary>
    private Guid? ShipperFilterId
    {
        get
        {
            if (Guid.TryParse(_shipperFilter, out var id) && id != Guid.Empty)
            {
                return id;
            }

            return null;
        }
    }

    /// <summary>
    /// Tải trang đơn hàng hiện tại. Bọc try/catch ngay tại đây (thay vì từng call site)
    /// vì loader này được gọi từ rất nhiều nơi không có guard: filter, phân trang,
    /// timer debounce tìm kiếm, <see cref="ClearDateFilter"/> và <c>OnInitializedAsync</c>.
    /// ApiClientBase dùng EnsureSuccessStatusCode() nên API trả 401/500/mất mạng sẽ ném
    /// exception — nếu không bắt, cả trang /orders rơi vào error boundary và staff mất
    /// hết filter đang xem. Khi lỗi, giữ dữ liệu cũ và hiện alert đỏ đầu trang để thử lại.
    /// </summary>
    private async Task LoadOrders(int page)
    {
        _page = page < 1 ? 1 : page;
        _selectedIndex = -1; // Item 141: reset keyboard selection on reload.
        // Item 163: cash-collection filter.
        bool? cashCollected = _cashFilter switch
        {
            "collected" => true,
            "uncollected" => false,
            _ => null
        };
        try
        {
            _paged = await OrderService.GetOrdersAsync(_page, 20, _searchTerm, _statusFilter, ShipperFilterId, _fromDate, _toDate, cashCollected, _vipOnly);
            _actionError = null;
        }
        catch (Exception ex)
        {
            _actionError = "Tải danh sách đơn thất bại: " + ex.Message;
        }
    }

    /// <summary>Wave 6c (item 35): clears the date-range filter.</summary>
    private async Task ClearDateFilter()
    {
        _fromDate = null;
        _toDate = null;
        await LoadOrders(1);
    }

    /// <summary>Wave 6c (item 32): downloads the Excel export with the current filters.
    /// SH5: truyền đủ cashCollected + vipOnly để file khớp danh sách đang xem.</summary>
    private async Task ExportExcel()
    {
        _exporting = true;
        try
        {
            var token = await OrderService.GetAccessToken();
            bool? cashCollected = _cashFilter switch
            {
                "collected" => true,
                "uncollected" => false,
                _ => null
            };
            var url = OrderService.GetExportOrdersUrl(_searchTerm, _statusFilter, ShipperFilterId, _fromDate, _toDate, cashCollected, _vipOnly);
            var day = _toDate?.Date ?? _fromDate?.Date ?? DateTime.Now.Date;
            await JSRuntime.InvokeVoidAsync("interop.downloadFile", url, token, $"don-hang-{day:yyyy-MM-dd}.xlsx");
        }
        finally
        {
            _exporting = false;
        }
    }

    /// <summary>
    /// Tìm kiếm debounce 500ms: mỗi lần gõ hủy timer cũ, chỉ tải lại khi khách
    /// ngừng gõ — tránh gọi API liên tục theo từng ký tự.
    /// </summary>
    private void OnSearchChanged()
    {
        _searchTimer?.Dispose();
        _searchTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => await LoadOrders(1));
        }, null, 500, System.Threading.Timeout.Infinite);
    }

    /// <summary>
    /// Item 141: handles keyboard shortcuts forwarded by
    /// interop.orderShortcuts. Ignored while typing (handled in JS).
    /// </summary>
    [JSInvokable]
    public async Task OnShortcutKey(string action)
    {
        switch (action)
        {
            case "next":
                MoveSelection(1);
                break;
            case "prev":
                MoveSelection(-1);
                break;
            case "open":
                var opened = GetSelectedOrder();
                if (opened != null)
                {
                    await ToggleDetail(opened);
                    StateHasChanged();
                }
                break;
            case "confirm":
                var pending = GetSelectedOrder();
                if (pending != null && pending.Status == "Pending")
                {
                    await ChangeStatus(pending, "Confirmed");
                }
                break;
            case "prepare":
                var confirmed = GetSelectedOrder();
                if (confirmed != null && confirmed.Status == "Confirmed")
                {
                    await ChangeStatus(confirmed, "Preparing");
                }
                break;
            case "cancel":
                var cancellable = GetSelectedOrder();
                if (cancellable != null
                    && (cancellable.Status == "Pending" || cancellable.Status == "Confirmed"))
                {
                    // Item 233: mở modal chọn lý do thay vì confirm trình duyệt.
                    OpenCancelModal(cancellable);
                }
                break;
            case "search":
                await JSRuntime.InvokeVoidAsync("interop.focusElementById", "orderSearchInput");
                break;
            case "help":
                _showShortcutHelp = !_showShortcutHelp;
                StateHasChanged();
                break;
        }
    }

    /// <summary>
    /// Đơn đang được chọn bằng phím tắt (j/k); null khi chưa có đơn nào
    /// trong trang hoặc con trỏ ngoài phạm vi. Gom chung điều kiện lặp lại
    /// trong mọi nhánh của <see cref="OnShortcutKey"/>.
    /// </summary>
    private OrderModel GetSelectedOrder()
    {
        var items = _paged?.Items;
        if (items != null && _selectedIndex >= 0 && _selectedIndex < items.Count)
        {
            return items[_selectedIndex];
        }

        return null;
    }

    /// <summary>Di chuyển con trỏ phím tắt theo delta, kẹp trong phạm vi trang.</summary>
    private void MoveSelection(int delta)
    {
        var items = _paged?.Items;
        if (items == null || items.Count == 0)
        {
            return;
        }

        _selectedIndex = System.Math.Clamp(_selectedIndex + delta, 0, items.Count - 1);
        StateHasChanged();
    }

    /// <summary>Item 142: loads duplicate-phone groups in the background.</summary>
    private async Task LoadDuplicateGroupsAsync()
    {
        try
        {
            _duplicateGroups = await OrderService.GetDuplicateOrdersAsync()
                ?? new List<DuplicateOrderGroupModel>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            _duplicateGroups = new List<DuplicateOrderGroupModel>();
        }
    }

    /// <summary>
    /// Item 142: merges one duplicate group into the chosen primary order
    /// (oldest by default). Always asks for confirmation first.
    /// </summary>
    private async Task MergeGroup(DuplicateOrderGroupModel group)
    {
        _mergeMessage = null;
        _mergeIsError = false;

        if (group?.Orders == null || group.Orders.Count < 2)
        {
            return;
        }

        var primaryId = _mergePrimary.TryGetValue(group.Phone, out var pid)
            ? pid
            : group.Orders[0].Id;
        var primary = group.Orders.FirstOrDefault(o => o.Id == primaryId) ?? group.Orders[0];
        var others = group.Orders.Where(o => o.Id != primary.Id).ToList();

        var ok = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Gộp {others.Count} đơn vào đơn {primary.OrderNumber}?\n" +
            "Các món sẽ được cộng dồn, các đơn còn lại bị hủy (có ghi chú). Không thể hoàn tác.");
        if (!ok)
        {
            return;
        }

        _merging = true;
        try
        {
            var merged = await OrderService.MergeOrdersAsync(primary.Id, others.Select(o => o.Id).ToList());
            _mergeMessage = $"Đã gộp thành công vào đơn {merged.OrderNumber} — tổng mới {FormatPrice(merged.TotalAmount)}.";
            await LoadOrders(_page);
            await LoadDuplicateGroupsAsync();
        }
        catch (Exception ex)
        {
            _mergeMessage = "Lỗi: " + ex.Message;
            _mergeIsError = true;
        }
        finally
        {
            _merging = false;
        }
    }

