@page "/orders"
@attribute [Authorize(Roles = "Admin,Cashier")]
@implements System.IAsyncDisposable
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Orders.Services
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject PhuThuongStickyRice.Web.Components.Admin.Services.AdminOperationsService AdminOperationsService
@inject PhuThuongStickyRice.Web.Components.Admin.Services.PermissionService PermissionService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime


<div class="lx-page-head">
    <h4 class="lx-page-title">Quản lý đơn hàng</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Đơn hàng</li>
    </ol>
</div>

@if (!string.IsNullOrEmpty(_actionError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_actionError
        <button type="button" class="close" @onclick="() => _actionError = null" aria-label="Đóng">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">Bộ lọc đơn hàng</h4>
        <div class="form-row">
            <div class="col-md-4">
                <input id="orderSearchInput" class="form-control" placeholder="Tìm mã đơn / tên / SĐT... (phím /)"
                       @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
            </div>
            <div class="col-md-3">
                <select class="form-control" @bind="_statusFilter" @bind:after="() => LoadOrders(1)" aria-label="Lọc đơn hàng theo trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Pending">Chờ xác nhận</option>
                    <option value="Confirmed">Đã xác nhận</option>
                    <option value="Preparing">Đang chuẩn bị</option>
                    <option value="Delivering">Đang giao</option>
                    <option value="Completed">Hoàn thành</option>
                    <option value="Cancelled">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-control" @bind="_shipperFilter" @bind:after="() => LoadOrders(1)" aria-label="Lọc đơn hàng theo shipper">
                    <option value="">Tất cả shipper</option>
                    @if (_shippers != null)
                    {
                        @foreach (var s in _shippers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-control" @bind="_cashFilter" @bind:after="() => LoadOrders(1)" title="Lọc theo trạng thái thu tiền">
                    <option value="">Thu tiền: tất cả</option>
                    <option value="uncollected">💵 Chưa thu tiền</option>
                    <option value="collected">✅ Đã thu tiền</option>
                </select>
            </div>
            @* Item 130 (đúng): chỉ hiện đơn của khách VIP. *@
            <div class="col-md-2 d-flex align-items-center">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="vipOnlyFilter"
                           @bind="_vipOnly" @bind:after="() => LoadOrders(1)" />
                    <label class="form-check-label font-weight-bold text-warning" for="vipOnlyFilter">👑 Chỉ VIP</label>
                </div>
            </div>
        </div>
        @* Wave 6c (item 35): date-range filter. *@
        <div class="form-row mt-2">
            <div class="col-md-2 col-6">
                <label class="mb-1"><small class="text-muted">Từ ngày</small></label>
                <input type="date" class="form-control" @bind="_fromDate" @bind:after="() => LoadOrders(1)" />
            </div>
            <div class="col-md-2 col-6">
                <label class="mb-1"><small class="text-muted">Đến ngày</small></label>
                <input type="date" class="form-control" @bind="_toDate" @bind:after="() => LoadOrders(1)" />
            </div>
            <div class="col-md-8 d-flex align-items-end justify-content-end">
                @if (_fromDate.HasValue || _toDate.HasValue)
                {
                    <button class="btn btn-sm btn-outline-secondary mr-2" @onclick="ClearDateFilter">✕ Xóa lọc ngày</button>
                }
                @* Wave 6c (item 32): Excel export honoring all filters. *@
                <button class="btn btn-sm btn-success" @onclick="ExportExcel" disabled="@_exporting">
                    @(_exporting ? "Đang xuất..." : "📥 Xuất Excel")
                </button>
                <button class="btn btn-sm btn-outline-secondary ml-2" @onclick="() => _showShortcutHelp = true" title="Xem phím tắt (phím ?)">
                    ⌨ Phím tắt
                </button>
            </div>
        </div>
    </div>
</div>

@* Item 142: duplicate-phone warning banner + review panel. *@
@if (_duplicateGroups != null && _duplicateGroups.Count > 0 && !_duplicatesDismissed)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center">
        <span>⚠️ Có <strong>@_duplicateGroups.Count</strong> nhóm đơn trùng SĐT trong 30 phút qua — có thể khách đặt nhầm 2 lần.</span>
        <div class="mt-2 mt-md-0">
            <button class="btn btn-sm btn-warning mr-2" @onclick="() => _showDuplicates = !_showDuplicates">
                @(_showDuplicates ? "Ẩn" : "Xem & xử lý")
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _duplicatesDismissed = true">Bỏ qua</button>
        </div>
    </div>
}

@if (_showDuplicates && _duplicateGroups != null && _duplicateGroups.Count > 0)
{
    <div class="card mb-3 border-warning">
        <div class="card-body">
            <h4 class="card-title text-warning">⚠️ Đơn trùng SĐT — kiểm tra & gộp</h4>
            @if (!string.IsNullOrEmpty(_mergeMessage))
            {
                <div class="alert @(_mergeIsError ? "alert-danger" : "alert-success") py-2">@_mergeMessage</div>
            }
            @foreach (var group in _duplicateGroups)
            {
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                            <strong>📞 @group.Phone <small class="text-muted">— @group.CustomerName</small></strong>
                            <button class="btn btn-sm btn-primary" @onclick="() => MergeGroup(group)" disabled="@_merging">
                                @(_merging ? "Đang gộp..." : "🔀 Gộp đơn (giữ đơn đầu)")
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:34px" title="Đơn giữ lại sau khi gộp">Giữ</th>
                                        <th>Mã đơn</th>
                                        <th>Giờ đặt</th>
                                        <th>Món</th>
                                        <th class="text-right">Tổng</th>
                                        <th>Trạng thái</th>
                                        <th>Thanh toán</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var gi = 0; gi < group.Orders.Count; gi++)
                                    {
                                        var go = group.Orders[gi];
                                        var isPrimary = _mergePrimary.TryGetValue(group.Phone, out var pid)
                                            ? pid == go.Id
                                            : gi == 0;
                                        <tr class="@(isPrimary ? "table-success" : "")">
                                            <td>
                                                <input type="radio" name="primary-@group.Phone" checked="@isPrimary"
                                                       @onchange="() => _mergePrimary[group.Phone] = go.Id"
                                                       title="Chọn đơn giữ lại" />
                                            </td>
                                            <td><strong>@go.OrderNumber</strong></td>
                                            <td><small>@go.CreatedAt.ToLocalTime().ToString("HH:mm")</small></td>
                                            <td><small>@string.Join(", ", go.Lines.Select(l => $"{l.ProductName}×{l.Quantity}"))</small></td>
                                            <td class="text-right"><small><strong>@FormatPrice(go.TotalAmount)</strong></small></td>
                                            <td><small>@StatusLabel(go.Status)</small></td>
                                            <td><small>@PaymentStatusLabel(go.PaymentStatus)</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Các món của đơn còn lại sẽ được cộng vào đơn giữ lại; đơn còn lại bị hủy với ghi chú “gộp vào đơn …”. Luôn cần bạn bấm nút — hệ thống không tự gộp.</small>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_paged == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Danh sách đơn hàng</h4>
            <div class="table-responsive">
                <table class="table table-hover mb-0 lx-table-sticky-first">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Địa chỉ</th>
                            <th class="text-right">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thanh toán</th>
                            <th>Shipper</th>
                            <th>Ngày đặt</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowIndex = 0; }
                        @foreach (var order in _paged.Items)
                        {
                            var idx = rowIndex++;
                            <tr @key="order.Id" class="@(_selectedIndex == idx ? "table-primary" : null)">
                                <td>
                                    <a href="javascript:void(0)" @onclick="() => ToggleDetail(order)">
                                        <strong>@order.OrderNumber</strong>
                                    </a>
                                    @if (order.RequiresDeposit)
                                    {
                                        <span class="badge badge-warning ml-1" title="Đơn chuyển khoản cần đặt cọc">Cần cọc</span>
                                    }
                                    @if (order.IsGift)
                                    {
                                        <span class="badge badge-info ml-1" title="Gói quà">🎁</span>
                                    }
                                    @* Wave 6c (item 33): internal-note indicator. *@
                                    @if (!string.IsNullOrWhiteSpace(order.AdminNote))
                                    {
                                        <span class="ml-1" title="Ghi chú nội bộ: @order.AdminNote">📝</span>
                                    }
                                    @* Pre-order badge: đặt trước theo giờ. *@
                                    @if (order.ScheduledFor.HasValue)
                                    {
                                        <span class="badge badge-primary ml-1" title="Đơn đặt trước">📅 @order.ScheduledFor.Value.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                    }
                                    @* Item 130 (đúng): VIP priority badge. *@
                                    @if (order.IsVip)
                                    {
                                        <span class="badge badge-warning ml-1" title="Khách VIP — ưu tiên xử lý">👑 VIP ưu tiên</span>
                                    }
                                    <br />@FulfillmentBadge(order.FulfillmentMethod, order.PickedUpAt)
                                </td>
                                <td>
                                    @order.CustomerName<br /><small class="text-muted">@order.CustomerPhone</small>
                                    @* Item 149: customer tags visible while processing the order. *@
                                    @if (order.CustomerTags != null && order.CustomerTags.Count > 0)
                                    {
                                        <br />
                                        @foreach (var tag in order.CustomerTags)
                                        {
                                            <span class="badge mr-1" style="background-color: @(string.IsNullOrWhiteSpace(tag.Color) ? "#6c757d" : tag.Color); color: #fff;">@tag.TagName</span>
                                        }
                                    }
                                </td>
                                <td><small>@order.CustomerAddress</small></td>
                                <td class="text-right"><strong>@FormatPrice(order.TotalAmount)</strong></td>
                                <td>@StatusBadge(order.Status)</td>
                                <td>@PaymentInfo(order)</td>
                                <td><small>@order.ShipperName</small></td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td class="text-right">@NextStatusButtons(order) @ConfirmPaymentButton(order) @CollectCashButton(order)</td>
                            </tr>
                            @if (_expandedOrderId == order.Id)
                            {
                                <tr>
                                    <td colspan="9" class="bg-light">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                                            <strong>Chi tiết đơn @order.OrderNumber</strong>
                                            <div>
                                                <a class="btn btn-sm btn-outline-secondary mr-1" href="@($"/orders/print/{order.Id}")" target="_blank">🖨 In hóa đơn</a>
                                                <a class="btn btn-sm btn-outline-secondary mr-1" href="@($"/orders/nhan/{order.Id}")" target="_blank">🏷 In tem</a>
                                                @* Item 162: copy the rendered message template for the current status. *@
                                                <button class="btn btn-sm btn-outline-info" @onclick="() => CopyMessageAsync(order)" disabled="@_copyingMessage" title="Copy mẫu tin nhắn theo trạng thái hiện tại — gửi tay qua Zalo/tin nhắn">
                                                    📋 @(_copyingMessage ? "Đang copy..." : "Copy tin nhắn")
                                                </button>
                                                @if (!string.IsNullOrEmpty(_copyMessageFeedback))
                                                {
                                                    <small class="text-muted d-block mt-1">@_copyMessageFeedback</small>
                                                }
                                            </div>
                                        </div>
                                        @if (order.Status == "Delivering" && _shippers != null)
                                        {
                                            <div class="form-row align-items-center mb-2">
                                                <div class="col-md-4">
                                                    <select class="form-control form-control-sm"
                                                            value="@(order.ShipperId?.ToString() ?? "")"
                                                            @onchange="(e) => AssignShipper(order, e.Value?.ToString())">
                                                        <option value="">— Gán shipper —</option>
                                                        @foreach (var s in _shippers)
                                                        {
                                                            <option value="@s.Id">@s.Name — @s.Phone</option>
                                                        }
                                                    </select>
                                                </div>
                                                @if (!string.IsNullOrEmpty(_shipperMessage))
                                                {
                                                    <div class="col-md-8"><small class="text-success">@_shipperMessage</small></div>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.CustomerEmail))
                                        {
                                            <div>Email: @order.CustomerEmail</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.Notes))
                                        {
                                            <div><em>Ghi chú: @order.Notes</em></div>
                                        }
                                        @* Wave 6a (item 23): scheduled delivery slot. *@
                                        @if (!string.IsNullOrWhiteSpace(order.DeliverySlot))
                                        {
                                            <div>🕖 Giờ giao hẹn: <strong>@order.DeliverySlot</strong></div>
                                        }
                                        @* Shipper pickup info + "Xác nhận đã lấy hàng". *@
                                        @if (order.FulfillmentMethod == "ShipperPickup")
                                        {
                                            <div class="mt-1">
                                                🛵 <strong>Shipper đến lấy tại quán</strong>
                                                @if (!string.IsNullOrWhiteSpace(order.PickupShipperName) || !string.IsNullOrWhiteSpace(order.PickupShipperPhone))
                                                {
                                                    <span class="text-muted"> — @order.PickupShipperName@(!string.IsNullOrWhiteSpace(order.PickupShipperPhone) ? $" ({order.PickupShipperPhone})" : "")</span>
                                                }
                                            </div>
                                            @if (order.PickedUpAt.HasValue)
                                            {
                                                <div class="text-success">✅ Đã lấy hàng lúc <strong>@order.PickedUpAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</strong></div>
                                            }
                                            @if (order.ScheduledFor.HasValue)
                                            {
                                                <div class="mt-1">📅 <strong>Đơn đặt trước</strong> — giờ lấy hẹn: <strong class="text-primary">@order.ScheduledFor.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
                                            }
                                            else if (order.Status != "Cancelled" && order.Status != "Completed")
                                            {
                                                <div class="form-row align-items-end mt-2">
                                                    <div class="col-md-4">
                                                        <label class="mb-1"><small class="text-muted">Tên shipper (tùy chọn)</small></label>
                                                        <input class="form-control form-control-sm" @bind="_pickupShipperName" placeholder="Tên shipper" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="mb-1"><small class="text-muted">SĐT shipper (tùy chọn)</small></label>
                                                        <input class="form-control form-control-sm" @bind="_pickupShipperPhone" placeholder="SĐT shipper" />
                                                    </div>
                                                    <div class="col-md-5">
                                                        @* Item 155: confirming pickup needs orders.confirm. *@
                                                        @if (HasPermission("orders.confirm"))
                                                        {
                                                            <button class="btn btn-sm btn-success" @onclick="() => MarkPickedUp(order)" disabled="@_markingPickedUp">
                                                                @(_markingPickedUp ? "Đang xác nhận..." : "✅ Xác nhận đã lấy hàng")
                                                            </button>
                                                        }
                                                        @if (!string.IsNullOrEmpty(_pickupMessage))
                                                        {
                                                            <small class="@(_pickupIsError ? "text-danger" : "text-success") ml-2">@_pickupMessage</small>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else if (order.FulfillmentMethod == "Pickup")
                                        {
                                            <div class="mt-1">🏪 <strong>Khách tự đến lấy tại quán</strong></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.RecipientName))
                                        {
                                            <div>Người nhận: <strong>@order.RecipientName</strong> — @order.RecipientPhone</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.TaxCode))
                                        {
                                            <div>Hóa đơn VAT: @order.CompanyName (MST: @order.TaxCode)</div>
                                        }
                                        @if (order.IsGift)
                                        {
                                            <div>🎁 Gói quà@(!string.IsNullOrWhiteSpace(order.GiftMessage) ? $": {order.GiftMessage}" : "")</div>
                                        }
                                        @if (order.RequiresDeposit)
                                        {
                                            <div><span class="badge badge-warning">Cần đặt cọc — xác nhận qua nút “Đã thanh toán” sau khi nhận cọc</span></div>
                                        }
                                        @if (order.LoyaltyDiscount > 0 || order.TierDiscount > 0)
                                        {
                                            <div class="text-success">
                                                <small>
                                                    @if (order.TierDiscount > 0)
                                                    {
                                                        <span>Ưu đãi hạng: −@FormatPrice(order.TierDiscount) </span>
                                                    }
                                                    @if (order.LoyaltyDiscount > 0)
                                                    {
                                                        <span>Đổi @order.LoyaltyPointsRedeemed điểm: −@FormatPrice(order.LoyaltyDiscount)</span>
                                                    }
                                                </small>
                                            </div>
                                        }
                                        @* Wave 6c (item 33): internal note editor (admin only). *@
                                        <div class="mt-2">
                                            <label class="mb-1"><small class="text-muted font-weight-bold">📝 Ghi chú nội bộ (chỉ nhân viên thấy)</small></label>
                                            <div class="form-row">
                                                <div class="col-md-10">
                                                    <textarea class="form-control form-control-sm" rows="2"
                                                              placeholder="Ghi chú cho nhân viên..."
                                                              @bind="_adminNoteDraft"></textarea>
                                                </div>
                                                <div class="col-md-2">
                                                    <button class="btn btn-sm btn-primary btn-block" @onclick="() => SaveAdminNote(order)"
                                                            disabled="@_savingNote">Lưu</button>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(_noteMessage))
                                            {
                                                <small class="text-success">@_noteMessage</small>
                                            }
                                        </div>
                                        @* Wave 6c (item 34): status timeline. *@
                                        @if (_historyLoading)
                                        {
                                            <div class="mt-2"><small class="text-muted">Đang tải lịch sử trạng thái...</small></div>
                                        }
                                        else if (_statusHistory != null && _statusHistory.Count > 0)
                                        {
                                            <div class="mt-3">
                                                <strong><small>Lịch sử trạng thái</small></strong>
                                                <ul class="list-unstyled mt-1 mb-0 timeline">
                                                    <li class="timeline-item">
                                                        <small class="text-muted">@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                                        <span class="badge badge-light ml-1">Đặt đơn</span>
                                                        <small class="text-muted">— @order.CustomerName</small>
                                                    </li>
                                                    @foreach (var h in _statusHistory)
                                                    {
                                                        <li class="timeline-item">
                                                            <small class="text-muted">@h.At.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                                            <span class="badge badge-secondary ml-1">@StatusLabel(h.FromStatus)</span>
                                                            <span>→</span>
                                                            <span class="badge badge-info">@StatusLabel(h.ToStatus)</span>
                                                            @if (!string.IsNullOrWhiteSpace(h.ByUser))
                                                            {
                                                                <small class="text-muted">— @h.ByUser</small>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        <table class="table table-hover table-sm mt-2 mb-0">
                                            <thead>
                                                <tr><th>Món</th><th class="text-right">Đơn giá</th><th class="text-right">SL</th><th class="text-right">Thành tiền</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in order.Lines)
                                                {
                                                    <tr>
                                                        <td>
                                                            @line.ProductName
                                                            @* Wave 6a (item 24): per-item note. *@
                                                            @if (!string.IsNullOrWhiteSpace(line.Note))
                                                            {
                                                                <br /><small class="text-info">📝 @line.Note</small>
                                                            }
                                                        </td>
                                                        <td class="text-right">@FormatPrice(line.UnitPrice)</td>
                                                        <td class="text-right">@line.Quantity</td>
                                                        <td class="text-right">@FormatPrice(line.LineTotal)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="3" class="text-right text-muted">Tạm tính</td>
                                                    <td class="text-right text-muted">@FormatPrice(order.Subtotal)</td>
                                                </tr>
                                                @if (order.DiscountAmount > 0)
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-right text-success">
                                                            Giảm giá @(!string.IsNullOrWhiteSpace(order.DiscountCode) ? $"({order.DiscountCode})" : "")
                                                        </td>
                                                        <td class="text-right text-success">−@FormatPrice(order.DiscountAmount)</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td colspan="3" class="text-right text-muted">Phí giao hàng</td>
                                                    <td class="text-right text-muted">@(order.DeliveryFee > 0 ? FormatPrice(order.DeliveryFee) : "Miễn phí")</td>
                                                </tr>
                                                <tr>
                                                    <td colspan="3" class="text-right"><strong>Tổng cộng</strong></td>
                                                    <td class="text-right"><strong>@FormatPrice(order.TotalAmount)</strong></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span>Tổng: @_paged.TotalCount đơn</span>
                <div>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="() => LoadOrders(_page - 1)">Trước</button>
                    <span class="mx-2">Trang @_page</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadOrders(_page + 1)">Sau</button>
                </div>
            </div>
        </div>
    </div>
}

