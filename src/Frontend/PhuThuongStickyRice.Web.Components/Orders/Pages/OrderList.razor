            // Prefill the pickup-shipper confirmation fields.
            _pickupShipperName = order.PickupShipperName;
            _pickupShipperPhone = order.PickupShipperPhone;
            _pickupMessage = null;
            _pickupIsError = false;

            // Wave 6c (item 34): load the status timeline for this order.
            _historyLoading = true;
            try
            {
                _statusHistory = await OrderService.GetStatusHistoryAsync(order.Id)
                    ?? new List<OrderStatusHistoryModel>();
            }
            catch (Exception)
            {
                _statusHistory = new List<OrderStatusHistoryModel>();
            }
            finally
            {
                _historyLoading = false;
            }
        }
