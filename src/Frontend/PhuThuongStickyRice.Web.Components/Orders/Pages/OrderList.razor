    <div class="modal d-block ol-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true" aria-label="Bảng phím tắt xử lý đơn" @onclick="() => _showShortcutHelp = false" @onkeydown="ShortcutHelpKeyDown">
