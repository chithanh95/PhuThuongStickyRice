@page "/orders/nhan/{OrderId:guid}"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Orders.Services
@using Microsoft.JSInterop
@inject OrderService OrderService
@inject IJSRuntime JSRuntime

<style>
    /* Sticky-label sheet: each label ~80mm x 50mm with page breaks. */
    .label-sheet { display: flex; flex-wrap: wrap; gap: 4mm; }
    .label {
        width: 80mm;
        min-height: 50mm;
        border: 1.5px dashed #333;
        border-radius: 2mm;
        padding: 3mm 4mm;
        page-break-inside: avoid;
        break-inside: avoid;
        font-family: Arial, sans-serif;
    }
    .label-dish { font-size: 15pt; font-weight: bold; line-height: 1.2; }
    .label-sub { font-size: 10pt; margin-top: 1mm; }
    .label-note { font-size: 10pt; font-weight: bold; color: #b00; margin-top: 1mm; }
    .label-order { font-size: 11pt; font-weight: bold; margin-top: 2mm; border-top: 1px solid #999; padding-top: 1mm; }

    @@media print {
        .no-print { display: none !important; }
        body { margin: 0; }
        @@page { size: A4; margin: 8mm; }
        .label-sheet { gap: 3mm; }
    }
</style>

<div class="no-print d-flex align-items-center justify-content-between mb-3">
    <h3>🏷 In tem dán</h3>
    <div>
        <button class="btn btn-primary mr-2" @onclick="PrintAsync">🖨 In ngay</button>
        <a class="btn btn-outline-secondary" href="/orders">← Đơn hàng</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger no-print">@_error</div>
}
else if (_order == null)
{
    <p class="no-print"><em>Đang tải đơn hàng...</em></p>
}
else
{
    <p class="no-print text-muted">
        Đơn <strong>@_order.OrderNumber</strong> — @_order.CustomerName (@_order.CustomerPhone)
        — in <strong>@TotalLabels</strong> tem (@_order.Lines.Sum(x => x.Quantity) gói).
        Mỗi gói 1 tem, khổ 80×50mm.
    </p>

    <div class="label-sheet">
        @foreach (var line in _order.Lines)
        {
            @for (var i = 0; i < line.Quantity; i++)
            {
                <div class="label" @key="@($"{line.ProductId}-{i}")">
                    <div class="label-dish">@line.ProductName</div>
                    @if (!string.IsNullOrWhiteSpace(line.SizeName))
                    {
                        <div class="label-sub">Size: @line.SizeName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(line.ToppingNames))
                    {
                        <div class="label-sub">Topping: @line.ToppingNames</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(line.Note))
                    {
                        <div class="label-note">📝 @line.Note</div>
                    }
                    <div class="label-order">#@_order.OrderNumber</div>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private OrderModel _order;
    private string _error;
    private bool _printed;

    private int TotalLabels => _order?.Lines.Sum(x => x.Quantity) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _order = await OrderService.GetByIdAsync(OrderId);
        }
        catch (Exception)
        {
            _error = "Không tải được đơn hàng.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-print once the labels are rendered.
        if (firstRender && _order != null && !_printed)
        {
            _printed = true;
            await PrintAsync();
        }
    }

    private async Task PrintAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception)
        {
        }
    }
}
