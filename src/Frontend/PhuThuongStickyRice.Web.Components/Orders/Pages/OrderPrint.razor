@page "/orders/print/{id:guid}"
@attribute [Authorize]
@using System
@using static PhuThuongStickyRice.Web.Components.Core.Helpers.PriceFormatter;
@using Microsoft.JSInterop
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Orders.Services
@inject OrderService OrderService
@inject IJSRuntime JSRuntime

<div class="print-page">
    <div class="d-print-none mb-3">
        <a class="btn btn-outline-secondary" href="/orders">← Quay lại đơn hàng</a>
        <button class="btn btn-primary ml-2" @onclick="Print">🖨 In hóa đơn</button>
    </div>

    @if (_order == null)
    {
        <p><em>Đang tải...</em></p>
    }
    else
    {
        <div class="invoice">
            <div class="text-center mb-4">
                <h2 class="invoice-shop">XÔI HUYỀN</h2>
                <p class="mb-1">Xôi làng nghề — dẻo thơm mỗi sáng</p>
                <p class="text-muted">Ngõ 277 Xuân Đỉnh, Từ Liêm, Hà Nội — 0389 245 468</p>
                <h4 class="mt-3">HÓA ĐƠN BÁN HÀNG</h4>
            </div>

            <table class="invoice-info">
                <tr><td><strong>Mã đơn:</strong></td><td><strong>@_order.OrderNumber</strong></td>
                    <td><strong>Ngày:</strong></td><td>@_order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                <tr><td><strong>Khách hàng:</strong></td><td>@_order.CustomerName</td>
                    <td><strong>SĐT:</strong></td><td>@_order.CustomerPhone</td></tr>
                <tr><td><strong>Địa chỉ:</strong></td><td colspan="3">@_order.CustomerAddress</td></tr>
                @if (!string.IsNullOrWhiteSpace(_order.Notes))
                {
                    <tr><td><strong>Ghi chú:</strong></td><td colspan="3">@_order.Notes</td></tr>
                }
                @if (!string.IsNullOrWhiteSpace(_order.DeliverySlot))
                {
                    <tr><td><strong>Giờ giao:</strong></td><td colspan="3">🕖 @_order.DeliverySlot</td></tr>
                }
                @if (!string.IsNullOrWhiteSpace(_order.RecipientName))
                {
                    <tr><td><strong>Người nhận:</strong></td><td>@_order.RecipientName</td>
                        <td><strong>SĐT nhận:</strong></td><td>@_order.RecipientPhone</td></tr>
                }
                @if (!string.IsNullOrWhiteSpace(_order.TaxCode))
                {
                    <tr><td><strong>Công ty:</strong></td><td>@_order.CompanyName</td>
                        <td><strong>MST:</strong></td><td>@_order.TaxCode</td></tr>
                }
                @if (_order.IsGift)
                {
                    <tr><td><strong>Gói quà:</strong></td><td colspan="3">Có@(!string.IsNullOrWhiteSpace(_order.GiftMessage) ? $" — {_order.GiftMessage}" : "")</td></tr>
                }
                <tr><td><strong>Thanh toán:</strong></td><td>@PaymentLabel(_order.PaymentMethod)</td>
                    <td><strong>Trạng thái:</strong></td><td>@_order.PaymentStatus</td></tr>
            </table>

            <table class="invoice-lines">
                <thead>
                    <tr><th scope="col">#</th><th scope="col">Món</th><th scope="col" class="r">Đơn giá</th><th scope="col" class="r">SL</th><th scope="col" class="r">Thành tiền</th></tr>
                </thead>
                <tbody>
                    @{
                        var lineNumber = 0;
                    }
                    @foreach (var line in _order.Lines)
                    {
                        lineNumber++;
                        <tr>
                            <td>@lineNumber</td>
                            <td>
                                @line.ProductName
                                @if (!string.IsNullOrWhiteSpace(line.Note))
                                {
                                    <br /><small>📝 @line.Note</small>
                                }
                            </td>
                            <td class="r">@FormatPrice(line.UnitPrice)</td>
                            <td class="r">@line.Quantity</td>
                            <td class="r">@FormatPrice(line.LineTotal)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="4" class="r">Tạm tính</td><td class="r">@FormatPrice(_order.Subtotal)</td></tr>
                    @if (_order.PromotionDiscountAmount > 0)
                    {
                        <tr><td colspan="4" class="r">🏷 Khuyến mãi giờ vàng @(!string.IsNullOrWhiteSpace(_order.PromotionName) ? $"({_order.PromotionName})" : "")</td>
                            <td class="r">−@FormatPrice(_order.PromotionDiscountAmount)</td></tr>
                    }
                    @if (_order.DiscountAmount > 0)
                    {
                        <tr><td colspan="4" class="r">Giảm giá @(!string.IsNullOrWhiteSpace(_order.DiscountCode) ? $"({_order.DiscountCode})" : "")</td>
                            <td class="r">−@FormatPrice(_order.DiscountAmount)</td></tr>
                    }
                    @if (_order.TierDiscount > 0)
                    {
                        <tr><td colspan="4" class="r">Ưu đãi hạng thành viên</td>
                            <td class="r">−@FormatPrice(_order.TierDiscount)</td></tr>
                    }
                    @if (_order.LoyaltyDiscount > 0)
                    {
                        <tr><td colspan="4" class="r">Đổi @_order.LoyaltyPointsRedeemed điểm</td>
                            <td class="r">−@FormatPrice(_order.LoyaltyDiscount)</td></tr>
                    }
                    @if (_order.GiftFee > 0)
                    {
                        <tr><td colspan="4" class="r">Phí gói quà</td>
                            <td class="r">+@FormatPrice(_order.GiftFee)</td></tr>
                    }
                    <tr><td colspan="4" class="r">Phí giao hàng</td>
                        <td class="r">@(_order.DeliveryFee > 0 ? FormatPrice(_order.DeliveryFee) : "Miễn phí")</td></tr>
                    <tr class="total"><td colspan="4" class="r"><strong>TỔNG CỘNG</strong></td>
                        <td class="r"><strong>@FormatPrice(_order.TotalAmount)</strong></td></tr>
                </tfoot>
            </table>

            <div class="invoice-sign">
                <div>Người bán<br /><br /><br />(Ký, ghi rõ họ tên)</div>
                <div>Người mua<br /><br /><br />(Ký, ghi rõ họ tên)</div>
            </div>

            <p class="text-center text-muted mt-4"><small>Cảm ơn quý khách! Hẹn gặp lại.</small></p>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private OrderModel _order;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _order = await OrderService.GetByIdAsync(Id);
        }
        catch (Exception)
        {
            _order = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _order != null)
        {
            await Print();
        }
    }

    private async Task Print()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception)
        {
        }
    }

    private static string PaymentLabel(string method) => method switch
    {
        "Cod" => "Tiền mặt (COD)",
        "BankTransfer" => "Chuyển khoản",
        "MoMo" => "Ví MoMo",
        _ => method
    };

}
