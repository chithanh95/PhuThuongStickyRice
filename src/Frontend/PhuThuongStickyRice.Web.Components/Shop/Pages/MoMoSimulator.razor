@page "/momo-simulator"
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using static PhuThuongStickyRice.Web.Components.Core.Helpers.PriceFormatter;
@inject ShopService ShopService
@inject AdminSystemService AdminSystemService
@inject NavigationManager Navigation

<h3>MoMo — Trang thanh toán giả lập <span class="badge badge-warning">TEST</span></h3>

<div class="alert alert-warning">
    <strong>Đây là trang giả lập MoMo (chế độ TEST).</strong>
    Không có tiền thật nào được trừ. Sau này khi shop có tài khoản doanh nghiệp MoMo, khách sẽ được đưa tới trang thanh toán thật của MoMo thay vì trang này.
</div>

@if (!_momoEnabled)
{
    <div class="alert alert-secondary">Chức năng thanh toán MoMo đang tắt. Vui lòng quay lại trang đặt hàng và chọn hình thức thanh toán khác.</div>
}
else if (string.IsNullOrEmpty(_orderId))
{
    <div class="alert alert-danger">Thiếu thông tin thanh toán (orderId). Vui lòng quay lại trang đặt hàng.</div>
}
else if (_done)
{
    <div class="alert @(_success ? "alert-success" : "alert-danger")">
        @(_success ? "Thanh toán MoMo thành công (TEST)!" : "Thanh toán MoMo thất bại (TEST).")
    </div>
    <a class="btn btn-primary" href="/track-order?orderNumber=@Uri.EscapeDataString(_orderNumber ?? "")">Xem đơn hàng</a>
}
else
{
    <div class="card">
        <div class="card-body">
            <p>
                Mã đơn hàng: <strong>@_orderNumber</strong><br />
                Số tiền: <strong class="text-danger">@FormatPrice(_amount)</strong>
            </p>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }
            <div class="d-flex flex-wrap">
                <button class="btn btn-success mr-2 mb-2" @onclick="() => SubmitMoMoCallbackAsync(true)" disabled="@_submitting">
                    @(_submitting ? "Đang xử lý..." : "Thanh toán thành công (TEST)")
                </button>
                <button class="btn btn-outline-danger mb-2" @onclick="() => SubmitMoMoCallbackAsync(false)" disabled="@_submitting">
                    Thanh toán thất bại (TEST)
                </button>
            </div>
        </div>
    </div>
}

@code {
    // codequality-team 2026-10-20 run-0245 Agent2-CleanCode: FormatPrice dùng chung từ Core.Helpers.PriceFormatter — xóa bản copy local trong file này.
    private string _orderId;
    private string _orderNumber;
    private long _amount;
    private string _requestId;
    private string _signature;
    private bool _momoEnabled;
    private bool _submitting;
    private bool _done;
    private bool _success;
    private string _error;

    /// <summary>
    /// Cờ "momo-payments" (mặc định TẮT): đang tắt thì trang giả lập chỉ
    /// hiện thông báo, không cho bấm thanh toán. Fail-closed như checkout —
    /// và backend cũng chặn callback nên trang này không xác nhận được gì.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var flags = await AdminSystemService.GetFeatureFlagMapAsync();
            _momoEnabled = flags != null && flags.TryGetValue("momo-payments", out var enabled) && enabled;
        }
        catch (Exception)
        {
            _momoEnabled = false;
        }
    }

    protected override void OnInitialized()
    {
        // Bug-hunt 2026-10-19: ParseQuery dùng Uri.UnescapeDataString —
        // URL chứa % sai định dạng (vd /momo-simulator?orderId=%zz) sẽ ném
        // exception; bọc try để trang không crash về error boundary
        // (pattern đã dùng ở Cart.razor và TrackOrder.razor).
        System.Collections.Generic.Dictionary<string, string> query;
        try
        {
            query = ParseQuery(Navigation.Uri);
        }
        catch (Exception)
        {
            return;
        }

        query.TryGetValue("orderId", out _orderId);
        query.TryGetValue("orderNumber", out _orderNumber);
        query.TryGetValue("requestId", out _requestId);
        query.TryGetValue("signature", out _signature);
        if (query.TryGetValue("amount", out var amountText))
        {
            long.TryParse(amountText, out _amount);
        }
    }

    private async Task SubmitMoMoCallbackAsync(bool success)
    {
        // Guard cứng chống bấm đúp ở đầu handler (tester A, 2026-10-22) —
        // không chỉ dựa vào disabled của nút như trước.
        if (_submitting) return;
        _error = null;
        _submitting = true;
        try
        {
            await ShopService.MoMoCallbackAsync(new MoMoCallbackModel
            {
                OrderId = _orderId,
                RequestId = _requestId,
                Amount = _amount,
                OrderInfo = $"Thanh toan don hang {_orderNumber} - Xoi Phu Thuong",
                ResultCode = success ? 0 : 1,
                Message = success ? "Simulated success" : "Simulated failure",
                SimulatedSignature = _signature,
                Simulated = true
            });
            _success = success;
            _done = true;
        }
        catch (Exception)
        {
            _error = "Không gửi được kết quả thanh toán. Vui lòng thử lại.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static System.Collections.Generic.Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new System.Collections.Generic.Dictionary<string, string>(System.StringComparer.OrdinalIgnoreCase);
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return result;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            result[Uri.UnescapeDataString(pair.Substring(0, eq))] =
                Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
        }

        return result;
    }
}
