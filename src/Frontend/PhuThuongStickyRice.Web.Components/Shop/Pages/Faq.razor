@page "/faq"
<PageTitle>Câu hỏi thường gặp — Xôi Huyền</PageTitle>
@using System
@using System.Linq
@using System.Threading
@using System.Collections.Generic
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopEngagementService ShopEngagementService
@inject PolicyService PolicyService
@inject PhuThuongStickyRice.Web.Components.Shop.Services.ShopSettingsService ShopSettingsService
@implements IDisposable

<h1>Câu hỏi thường gặp</h1>

<div class="input-group mb-3 faq-search">
    <input class="form-control" @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp"
           placeholder="Tìm kiếm câu hỏi..." aria-label="Tìm kiếm câu hỏi" />
    <div class="input-group-append">
        <button class="btn btn-outline-secondary" @onclick="Search">Tìm</button>
    </div>
</div>

@if (_loading)
{
    <p><em>Đang tải...</em></p>
}
else if (_faqs == null || _faqs.Count == 0)
{
    <div class="alert alert-info">Chưa có câu hỏi nào. <a href="/ho-tro">Gửi câu hỏi cho shop</a>.</div>
}
else
{
    <div class="faq-list">
        @foreach (var faq in _faqs)
        {
            var isOpen = _expandedId == faq.Id;
            <div class="card mb-2" @key="faq.Id">
                <div class="card-header p-2">
                    <button class="btn btn-link btn-block text-left p-1" type="button"
                            id="@($"faq-q-{faq.Id}")" aria-expanded="@isOpen" aria-controls="@($"faq-a-{faq.Id}")"
                            @onclick="() => Toggle(faq.Id)">
                        <strong>@(isOpen ? "▾" : "▸") @faq.Question</strong>
                    </button>
                </div>
                @if (isOpen)
                {
                    <div class="card-body" id="@($"faq-a-{faq.Id}")" role="region" aria-labelledby="@($"faq-q-{faq.Id}")">@faq.Answer</div>
                }
            </div>
        }
    </div>
}

@* Wave 6b (item 28): cross-link FAQ ↔ policy pages. *@
@if (_policies.Count > 0)
{
    <hr />
    <p class="text-muted">
        Xem thêm:
        @foreach (var p in _policies)
        {
            <a class="mr-3" href="/chinh-sach/@p.Slug">@p.Title</a>
        }
    </p>
}

@* FQ3: chưa giải đáp được → hotline + Zalo. *@
<div class="card mt-4 faq-contact">
    <div class="card-body text-center">
        <h2>Chưa giải đáp được?</h2>
        <p class="text-muted">Liên hệ trực tiếp, shop trả lời nhanh trong giờ mở cửa.</p>
        <div>
            @if (!string.IsNullOrWhiteSpace(_hotline))
            {
                <a class="btn btn-danger mr-2 mb-2" href="tel:@_hotlineDigits">📞 @_hotline</a>
            }
            @if (!string.IsNullOrWhiteSpace(_zaloUrl))
            {
                <a class="btn btn-success mb-2" href="@_zaloUrl" target="_blank" rel="noopener">💬 Chat Zalo</a>
            }
        </div>
    </div>
</div>

@code {
    private List<FaqItemModel> _faqs = new List<FaqItemModel>();
    private List<PolicyPageSummaryModel> _policies = new List<PolicyPageSummaryModel>();
    private string _searchTerm;
    private bool _loading = true;
    private Timer _debounceTimer;
    // Bug-hunt 2026-10-19: async-void debounce callback có thể chạy sau khi
    // component đã dispose (gõ tìm kiếm rồi rời trang trong 400ms) →
    // StateHasChanged sau dispose, unhandled → crash trắng app.
    // Guard chống StateHasChanged sau dispose (mẫu chuẩn cho timer/debounce).
    private bool _disposed;
    private Guid _expandedId;

    // FQ3: hotline + Zalo từ shop settings.
    private string _hotline;
    private string _hotlineDigits;
    private string _zaloUrl;

    protected override async Task OnInitializedAsync()
    {
        // perf-hunt 2026-10-19 (run 22:35): 3 loader độc lập chạy song song
        // (cắt ~2 round-trip khi mở trang /hoi-dap). Mỗi loader fail-soft
        // riêng như cũ, ghi field riêng nên không race.
        var faqsTask = LoadAsync(null);
        var policiesTask = LoadPoliciesAsync();
        var contactTask = LoadContactAsync();
        await Task.WhenAll(faqsTask, policiesTask, contactTask);
    }

    /// <summary>Wave 6b (item 28): cross-link tới trang chính sách (fail-soft).</summary>
    private async Task LoadPoliciesAsync()
    {
        try
        {
            _policies = await PolicyService.GetPublicListAsync()
                ?? new List<PolicyPageSummaryModel>();
        }
        catch (Exception)
        {
            _policies = new List<PolicyPageSummaryModel>();
        }
    }

    /// <summary>FQ3: hotline / Zalo từ shop settings (fail-soft — block ẩn khi không có).</summary>
    private async Task LoadContactAsync()
    {
        try
        {
            var settings = await ShopSettingsService.GetPublicAsync();
            var phone = !string.IsNullOrWhiteSpace(settings?.ZaloPhone) ? settings.ZaloPhone : settings?.Hotline;
            _hotline = settings?.Hotline;
            _hotlineDigits = _hotline == null ? null : new string(_hotline.Where(char.IsDigit).ToArray());
            if (!string.IsNullOrWhiteSpace(phone))
            {
                var digits = new string(phone.Where(char.IsDigit).ToArray());
                if (digits.StartsWith("0"))
                    digits = "84" + digits.Substring(1);
                else if (!digits.StartsWith("84"))
                    digits = "84" + digits;
                var text = Uri.EscapeDataString("Chào quán, mình có câu hỏi cần tư vấn");
                _zaloUrl = $"https://zalo.me/{digits}?text={text}";
            }
        }
        catch (Exception)
        {
        }
    }

    private void Toggle(Guid id)
    {
        _expandedId = _expandedId == id ? Guid.Empty : id;
    }

    private async Task LoadAsync(string term)
    {
        _loading = true;
        try
        {
            _faqs = await ShopEngagementService.GetFaqsAsync(term) ?? new List<FaqItemModel>();
        }
        catch (Exception)
        {
            _faqs = new List<FaqItemModel>();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchKeyUp()
    {
        // Debounce: wait 400ms after the user stops typing before searching.
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(async _ =>
        {
            if (_disposed) return;
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                await LoadAsync(_searchTerm);
                StateHasChanged();
            });
        }, null, 400, Timeout.Infinite);
    }

    private async Task Search()
    {
        _debounceTimer?.Dispose();
        await LoadAsync(_searchTerm);
    }

    public void Dispose()
    {
        _disposed = true;
        _debounceTimer?.Dispose();
    }
}
