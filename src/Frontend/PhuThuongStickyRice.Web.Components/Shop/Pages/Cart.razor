@* Trang giỏ hàng: hiển thị các dòng hàng, đổi số lượng (về 0 là xóa dòng), thanh
   freeship, gợi ý "Thường được mua cùng", mang SĐT sang /checkout (?phone=)
   và gộp món từ link chia sẻ giỏ (?share=). *@
@page "/cart"
<PageTitle>Giỏ hàng — Xôi Phú Thượng</PageTitle>
@using System
@using static PhuThuongStickyRice.Web.Components.Core.Helpers.PriceFormatter;
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.JSInterop
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Shop.Components
@using PhuThuongStickyRice.Web.Components.Core.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject CartState CartState
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject ToastService Toasts
@inject AdminCommerceService AdminCommerceService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppI18n AppI18n
@inject FunnelService Funnel
@implements IDisposable

<h1>@AppI18n.Translate("common.cart")</h1>

@if (CartState.Items.Count == 0)
{
    <div class="alert alert-info">
        @AppI18n.Translate("shop.cart_empty") <a href="/shop">@AppI18n.Translate("shop.cart_browse")</a>
    </div>

    @* Item 123: giỏ trống → gợi ý món bán chạy để cứu phiên thoát. *@
    @if (_suggestions != null && _suggestions.Count > 0)
    {
        @* A11y-1019: h5 -> h2 (class .h5 giữ nguyên kiểu dáng Bootstrap) —
           trước đây h1 nhảy thẳng xuống h5, trình đọc màn hình mất cấu trúc. *@
        <h2 class="h5 mt-3 mb-2">🔥 Món bán chạy — thêm nhanh vào giỏ</h2>
        <div class="row cart-empty-suggest">
            @foreach (var s in _suggestions.Take(SuggestionCount))
            {
                <div class="col-6 col-md-3 mb-3" @key="s.Id">
                    <div class="card h-100">
                        <img src="@SuggestionImage(s)" alt="@s.Name" loading="lazy"
                             class="card-img-top cart-suggest-img"
                             onerror="this.onerror=null;this.style.display='none';" />
                        <div class="card-body p-2 text-center">
                            <div class="font-weight-bold cart-suggest-name">@s.Name</div>
                            @* bug-hunt 2026-10-19: hiện giá KM (giá thực trả khi bấm Thêm) thay vì giá gốc. *@
                            <div class="text-danger font-weight-bold">@FormatPrice(ShopProductModel.EffectivePrice(s, s.Price))</div>
                            <button class="btn btn-sm btn-primary mt-1 w-100"
                                    @onclick="() => QuickAddSuggestion(s)">
                                <i class="fa-solid fa-plus"></i> Thêm
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @* bug-hunt 2026-10-20: bỏ thanh "miễn phí giao hàng" — quán KHÔNG giao
       hàng (khách tự đến lấy hoặc tự book shipper, phí ship luôn 0 theo
       ComputeDeliveryFee), hiển thị "được miễn phí giao hàng" gây hiểu nhầm
       quán có dịch vụ giao hàng. Cùng treatment với checkout (bỏ dòng
       "−DeliveryFee" ảo). Ngưỡng FreeShipThreshold chỉ còn ý nghĩa với
       legacy Delivery, không áp cho đơn Pickup/ShipperPickup hiện tại. *@

    <div class="table-responsive">
        <table class="table cart-lines">
            <thead>
                @* A11y-20261020: scope="col" — trình đọc màn hình liên kết đúng
                   ô dữ liệu với tên cột (Sản phẩm/Đơn giá/Thành tiền/Số lượng)
                   khi điều hướng bảng bằng bàn phím. *@
                <tr>
                    <th scope="col">@AppI18n.Translate("shop.product")</th>
                    <th scope="col" class="text-right">@AppI18n.Translate("shop.unit_price")</th>
                    <th scope="col" class="text-right">@AppI18n.Translate("shop.line_total")</th>
                    <th scope="col" class="text-center">@AppI18n.Translate("common.quantity")</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cartItem in CartState.Items)
                {
                    <tr @key="cartItem.LineKey">
                        <td>
                            <div class="cart-item-main">
                                <img class="cart-item-img" src="@CartItemImage(cartItem)" alt="@cartItem.ProductName" loading="lazy"
                                     onerror="this.onerror=null;this.style.display='none';" />
                                <div class="cart-item-info">
                                    <strong>@cartItem.ProductName</strong>
                            @if (cartItem.IsCombo)
                            {
                                <span class="badge badge-warning ml-1">COMBO</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(cartItem.SizeName))
                            {
                                <br /><small class="text-muted">Size: @cartItem.SizeName</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(cartItem.ToppingNames))
                            {
                                <br /><small class="text-muted">@AppI18n.Translate("shop.toppings_label"): @cartItem.ToppingNames</small>
                            }
                            @* BA cart: bỏ mã sản phẩm nội bộ (XOI-DO...) — khách không cần thấy. *@
                            @* Wave 6a (item 24): per-item note ("ghi chú món"). *@
                            <br />
                            <input class="form-control form-control-sm mt-1 cart-item-note"
                                   maxlength="500" placeholder="@AppI18n.Translate("shop.item_note_placeholder")"
                                   aria-label="Ghi chú cho món @cartItem.ProductName"
                                   value="@cartItem.Note"
                                   @onchange="(e) => CartState.UpdateNote(cartItem.LineKey, e.Value?.ToString())" />
                                </div>
                            </div>
                        </td>
                        <td class="text-right">@FormatPrice(cartItem.UnitPrice)</td>
                        <td class="text-right"><strong>@FormatPrice(cartItem.LineTotal)</strong></td>
                        <td class="text-center">
                            <QuantitySpinner Value="@cartItem.Quantity"
                                             ValueChanged="@(q => CartState.UpdateQuantity(cartItem.LineKey, q))"
                                             Min="0" Max="99" />
                        </td>
                        <td class="text-right">
                            @* A11y-1610: aria-label kèm tên món — trước đây mọi dòng đều đọc
                               chung chung là "Xóa", người dùng bàn phím không biết xóa món nào. *@
                            <button class="btn btn-sm btn-danger" @onclick="() => CartState.Remove(cartItem.LineKey)" aria-label="Xóa @cartItem.ProductName khỏi giỏ hàng">@AppI18n.Translate("common.delete")</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right"><strong>@AppI18n.Translate("common.total"):</strong></td>
                    <td class="text-right"><strong class="text-danger cart-total-amount">@FormatPrice(CartState.TotalAmount)</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    @* GH2: optional phone — carried over to checkout (?phone=) and saved for next time. *@
    <div class="form-group gh-cart-phone mb-3">
        <label for="cart-phone"><small class="text-muted">📱 SĐT của bạn <span class="text-muted">(tùy chọn — tự điền sẵn ở bước thanh toán)</span></small></label>
        <input id="cart-phone" class="form-control" inputmode="tel" placeholder="0901234567"
               value="@_phone" @oninput="OnPhoneInput" maxlength="11" />
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 cart-actions">
        <div>
            <a class="btn btn-secondary mb-2 mr-2" href="/shop">@AppI18n.Translate("shop.continue_shopping")</a>
        </div>
        <button class="btn btn-success btn-lg mb-2 cart-checkout-flow" @onclick="NavigateToCheckout">
            @AppI18n.Translate("common.checkout") (@CartState.TotalQuantity)
        </button>
    </div>

    @* Mobile: thanh thanh toán sticky dưới cùng — gọn hơn nút full-width. *@
    <div class="cart-sticky-checkout">
        <div class="cart-sticky-total">
            <small class="text-muted">@AppI18n.Translate("common.total")</small>
            <strong class="text-danger">@FormatPrice(CartState.TotalAmount)</strong>
        </div>
        <button class="btn btn-success" @onclick="NavigateToCheckout">
            @AppI18n.Translate("common.checkout") →
        </button>
    </div>
    <div class="cart-sticky-spacer" aria-hidden="true"></div>

    @if (_suggestions != null && _suggestions.Count > 0)
    {
        <div class="card mt-2 cart-upsell">
            <div class="card-header">@AppI18n.Translate("shop.suggested_sides")</div>
            <div class="card-body">
                <div class="row">
                    @foreach (var s in _suggestions)
                    {
                        <div class="col-12 col-sm-6 col-lg-4 mb-2" @key="s.Id">
                            <div class="d-flex align-items-center justify-content-between border rounded p-2">
                                <div class="d-flex align-items-center">
                                    <img src="@SuggestionImage(s)" alt="@s.Name" loading="lazy"
                                         class="cart-upsell-thumb"
                                         onerror="this.onerror=null;this.style.display='none';" />
                                    <div>
                                        <strong>@s.Name</strong><br />
                                        @* bug-hunt 2026-10-19: hiện giá KM (giá thực trả khi bấm Thêm) thay vì giá gốc. *@
                                        <span class="text-danger">@FormatPrice(ShopProductModel.EffectivePrice(s, s.Price))</span>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-primary" @onclick="() => QuickAddSuggestion(s)" aria-label="Thêm @s.Name vào giỏ hàng">@AppI18n.Translate("shop.add")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<ShopProductModel> _suggestions;
    private const int SuggestionCount = 3;
    private const string SideDishKeyword = "kèm";
    private const string PlaceholderImage = "data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iI2YwZjBmMCIvPjx0ZXh0IHg9IjUwIiB5PSI1NSIgdGV4dC1hbmNob3I9Im1pZGRsZSIgZmlsbD0iIzk5OSIgZm9udC1zaXplPSIxMiI+Tm8gaW1hZ2U8L3RleHQ+PC9zdmc+";

    /// <summary>
    /// Ảnh 1 dòng giỏ: dùng ảnh thật của món, chưa có thì ảnh placeholder SVG
    /// (không hardcode ảnh món nào — rule chung: ảnh lấy từ setting DB).
    /// </summary>
    /// <param name="cartItem">Dòng giỏ hàng.</param>
    /// <returns>URL ảnh món hoặc ảnh placeholder.</returns>
    private string CartItemImage(CartItemModel cartItem)
    {
        if (!string.IsNullOrWhiteSpace(cartItem?.ImageUrl))
            return cartItem.ImageUrl;
        return PlaceholderImage;
    }

    /// <summary>Ảnh gợi ý "Thường được mua cùng": ảnh đầu của món qua ResolveImageUrl, fallback placeholder.</summary>
    /// <param name="s">Món được gợi ý.</param>
    /// <returns>URL ảnh tuyệt đối hoặc ảnh placeholder.</returns>
    private string SuggestionImage(ShopProductModel s)
    {
        var first = CartState.FirstImageUrl(s?.ImageUrlsJson);
        if (!string.IsNullOrEmpty(first))
            return AdminCommerceService.ResolveImageUrl(first);
        return PlaceholderImage;
    }

    // GH2: optional phone carried over to checkout.
    private const string PhoneStorageKey = "phuthuong.phone.v1";
    // Số lượng tối đa cho 1 dòng khi gộp giỏ được chia sẻ (tránh giỏ phình quá lớn).
    private const int MaxQuantityPerLine = 99;
    private string _phone;

    // Bug-hunt 2026-10-19: guard cho ReloadSuggestionsAsync fire-and-forget.
    private bool _disposed;

    // Snapshot of the cart's product-id set the suggestions were built from;
    // OnCartChanged only refetches when this changes (quantity changes don't).
    private string _lastSuggestionCartKey = string.Empty;

    /// <summary>
    /// Tải danh sách giỏ, gộp món từ link chia sẻ, gợi ý mua cùng
    /// và prefill SĐT từ lần ghé trước (fail-soft — không chặn giỏ khi lỗi).
    /// (Ngưỡng freeship đã bỏ khỏi giỏ — quán không giao hàng.)
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        AppI18n.OnChange += OnLangChanged;
        await AppI18n.InitializeAsync();
        Funnel.Track(FunnelService.Events.CartView, new Uri(Navigation.Uri).AbsolutePath);
        CartState.OnChange += OnCartChanged;
        await MergeSharedCartAsync();

        // perf-hunt 2026-10-19 (run 22:35): 2 loader độc lập chạy song song
        // (cắt ~1-2 round-trip khi mở trang /cart). Gợi ý phụ thuộc giỏ SAU
        // khi merge nên vẫn đứng sau MergeSharedCartAsync; SĐT lưu local
        // fail-soft riêng nên không race.
        // (bug-hunt 2026-10-20: bỏ LoadSettingsAsync — ngưỡng freeship không
        // còn dùng ở giỏ vì quán không giao hàng.)
        var suggestionsTask = LoadSuggestionsAsync();
        var phoneTask = LoadPhoneAsync();
        await Task.WhenAll(suggestionsTask, phoneTask);
    }

    /// <summary>GH2: điền sẵn SĐT từ lần ghé trước (fail-soft).</summary>
    private async Task LoadPhoneAsync()
    {
        try
        {
            _phone = await JSRuntime.InvokeAsync<string>("localStorage.getItem", PhoneStorageKey);
        }
        catch (Exception)
        {
            _phone = null;
        }
    }

    /// <summary>
    /// Giỏ thay đổi: chỉ tải lại gợi ý khi TẬP ID món thay đổi (không tải lại khi
    /// chỉ đổi số lượng — tiết kiệm 2 API call mỗi lần bấm +/-).
    /// </summary>
    private void OnCartChanged()
    {
        // Suggestion list ("Thường được mua cùng") only depends on the SET of
        // product ids in the cart — quantity changes never alter it. Reloading
        // on every +/- click wastes 2 API calls per click (products + best-sellers),
        // so only reload when the product-id set actually changes.
        var key = string.Join(",", CartState.Items.Select(x => x.ProductId).OrderBy(g => g));
        if (key != _lastSuggestionCartKey)
        {
            _lastSuggestionCartKey = key;
            _ = ReloadSuggestionsAsync();
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Reloads "Thường được mua cùng" and re-renders AFTER the load
    /// completes, so the suggestion list is never one interaction behind
    /// the cart (a fire-and-forget reload + immediate StateHasChanged left
    /// the old list on screen until the next unrelated render).
    /// </summary>
    private async Task ReloadSuggestionsAsync()
    {
        await LoadSuggestionsAsync();
        // Bug-hunt 2026-10-19: fire-and-forget — khách rời trang /cart trong
        // lúc API đang bay thì InvokeAsync sau Dispose sẽ ném exception
        // (cùng pattern _disposed của Toast.razor / Faq.razor / HangCho.razor).
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Thêm nhanh 1 món từ gợi ý "Thường được mua cùng" vào giỏ kèm toast xác nhận.</summary>
    /// <param name="product">Món được gợi ý.</param>
    private void QuickAddSuggestion(ShopProductModel product)
    {
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} vào giỏ");
    }

    /// <summary>Lưu tạm SĐT nhập ở ô checkout vào state (dùng khi sang /checkout).</summary>
    /// <param name="e">Giá trị ô nhập SĐT.</param>
    private void OnPhoneInput(ChangeEventArgs e)
    {
        _phone = e.Value?.ToString();
    }

    /// <summary>
    /// GH2: saves the phone for next time and carries it to checkout (?phone=).
    /// </summary>
    private void NavigateToCheckout()
    {
        var phone = (_phone ?? "").Trim();
        try
        {
            _ = JSRuntime.InvokeVoidAsync("localStorage.setItem", PhoneStorageKey, phone);
        }
        catch (Exception)
        {
        }

        var url = string.IsNullOrWhiteSpace(phone)
            ? "/checkout"
            : $"/checkout?phone={Uri.EscapeDataString(phone)}";
        Navigation.NavigateTo(url);
    }

    /// <summary>
    /// GH3: "Thường được mua cùng" — best-sellers not already in the cart
    /// (same best-seller ordering as Shop.razor), backfilled with side
    /// dishes when fewer than 3 best-sellers are available.
    /// </summary>
    private async Task LoadSuggestionsAsync()
    {
        // perf-hunt 2026-10-19 (run 22:35): 2 API độc lập chạy song song —
        // danh sách món và thứ hạng bán chạy không phụ thuộc nhau, map theo
        // id sau khi cả hai về. Semantics giữ nguyên bản cũ: products lỗi →
        // gợi ý rỗng; bestIds lỗi → backfill món kèm.
        var productsTask = ShopService.GetProductsAsync();
        var bestIdsTask = ShopService.GetBestSellerIdsAsync();

        var inCart = new HashSet<Guid>(CartState.Items.Select(x => x.ProductId));
        List<ShopProductModel> available;
        try
        {
            var paged = await productsTask;
            available = (paged.Items ?? new List<ShopProductModel>())
                .Where(p => !inCart.Contains(p.Id))
                .ToList();
        }
        catch (Exception)
        {
            // Quan sát nốt bestIdsTask để không trôi exception không ai await.
            try { await bestIdsTask; } catch (Exception) { }
            _suggestions = new List<ShopProductModel>();
            return;
        }

        try
        {
            var picks = await PickBestSellersAsync(available, bestIdsTask);
            BackfillWithSideDishes(picks, available);
            _suggestions = picks;
        }
        catch (Exception)
        {
            _suggestions = new List<ShopProductModel>();
        }
    }

    /// <summary>
    /// Chọn tối đa <see cref="SuggestionCount"/> món theo thứ hạng bán chạy.
    /// Thứ hạng là nice-to-have: lỗi thì bỏ qua, để BackfillWithSideDishes bổ sung sau.
    /// </summary>
    private static async Task<List<ShopProductModel>> PickBestSellersAsync(
        List<ShopProductModel> available, Task<List<Guid>> bestIdsTask)
    {
        var picks = new List<ShopProductModel>();
        try
        {
            var bestIds = await bestIdsTask ?? new List<Guid>();
            var byId = available.ToDictionary(p => p.Id);
            foreach (var id in bestIds)
            {
                if (picks.Count >= SuggestionCount)
                {
                    break;
                }

                if (byId.TryGetValue(id, out var p))
                {
                    picks.Add(p);
                }
            }
        }
        catch (Exception)
        {
            // Best-seller ranking is nice-to-have — fall through to the backfill.
        }
        return picks;
    }

    /// <summary>
    /// Bổ sung cho đủ <see cref="SuggestionCount"/> gợi ý: ưu tiên món kèm, rồi xếp theo tên.
    /// </summary>
    private static void BackfillWithSideDishes(List<ShopProductModel> picks, List<ShopProductModel> available)
    {
        if (picks.Count >= SuggestionCount)
        {
            return;
        }

        var pickedIds = new HashSet<Guid>(picks.Select(p => p.Id));
        picks.AddRange(available
            .Where(p => !pickedIds.Contains(p.Id))
            .OrderByDescending(p => (p.Category ?? "").Contains(SideDishKeyword) ? 1 : 0)
            .ThenBy(p => p.Name)
            .Take(SuggestionCount - picks.Count));
    }

    /// <summary>
    /// Gộp giỏ từ link chia sẻ (?share=...): giải mã payload rồi thêm từng món
    /// vào giỏ. Xong thì xóa param share khỏi URL để F5 không cộng trùng.
    /// </summary>
    private async Task MergeSharedCartAsync()
    {
        // Bug-hunt 2026-10-19: ParseQuery dùng Uri.UnescapeDataString —
        // URL chứa % sai định dạng (vd /cart?share=%zz) sẽ ném exception;
        // bọc try để trang /cart không crash với link hỏng.
        Dictionary<string, string> query;
        try
        {
            query = ParseQuery(Navigation.Uri);
        }
        catch (Exception)
        {
            return;
        }

        if (!query.TryGetValue("share", out var share) || string.IsNullOrWhiteSpace(share))
        {
            return;
        }

        var payload = DecodeSharePayload(share);
        if (payload == null)
        {
            return;
        }

        var added = await AddSharedPayloadToCartAsync(payload);
        if (added > 0)
        {
            Toasts.Show($"Đã thêm {added} món từ link chia sẻ vào giỏ");
            // Remove the share param so a refresh doesn't re-add.
            Navigation.NavigateTo("/cart", forceLoad: false);
        }
    }

    /// <summary>
    /// Giải mã payload link chia sẻ: base64 URL-safe (- thay +, _ thay /), thêm dấu
    /// = đệm cho đủ bội số của 4 (quy tắc base64) rồi decode UTF-8.
    /// </summary>
    /// <param name="share">Giá trị param share trong URL.</param>
    /// <returns>Chuỗi payload "guid:qty;guid:qty;...", hoặc null nếu sai định dạng.</returns>
    private static string DecodeSharePayload(string share)
    {
        try
        {
            var padded = share.Replace('-', '+').Replace('_', '/');
            padded = padded.PadRight(padded.Length + (4 - padded.Length % 4) % 4, '=');
            return System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(padded));
        }
        catch (Exception)
        {
            // Malformed share payload — ignore.
            return null;
        }
    }

    /// <summary>
    /// Thêm từng món trong payload chia sẻ vào giỏ: mỗi mục "productId:qty",
    /// bỏ qua mục sai định dạng hoặc món không còn bán.
    /// </summary>
    /// <param name="payload">Chuỗi payload đã giải mã.</param>
    /// <returns>Số món đã thêm thành công.</returns>
    private async Task<int> AddSharedPayloadToCartAsync(string payload)
    {
        var added = 0;
        foreach (var part in payload.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = part.Split(':');
            if (pieces.Length != 2
                || !Guid.TryParseExact(pieces[0], "N", out var productId)
                || !int.TryParse(pieces[1], out var qty)
                || qty < 1)
            {
                continue;
            }

            try
            {
                var product = await ShopService.GetProductAsync(productId);
                if (product != null && product.Status == "Active")
                {
                    CartState.Add(product, Math.Min(qty, MaxQuantityPerLine));
                    added++;
                }
            }
            catch (Exception)
            {
                // Invalid / unavailable product id — skip it.
            }
        }

        return added;
    }

    /// <summary>
    /// Parse query string thành dictionary (không phân biệt hoa/thường).
    /// Dùng để nhận ?share= từ link chia sẻ giỏ.
    /// </summary>
    /// <param name="uri">URL đầy đủ của trang.</param>
    /// <returns>Các cặp key=value của query string.</returns>
    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return result;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            result[Uri.UnescapeDataString(pair.Substring(0, eq))] =
                Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
        }

        return result;
    }

    /// <summary>Re-render khi người dùng đổi ngôn ngữ (AppI18n.OnChange).</summary>
    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _disposed = true;
        CartState.OnChange -= OnCartChanged;
        AppI18n.OnChange -= OnLangChanged;
    }
}
