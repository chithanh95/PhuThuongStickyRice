@page "/cart"
<PageTitle>Giỏ hàng — Xôi Phú Thượng</PageTitle>
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.JSInterop
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject CartState CartState
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppI18n AppI18n
@inject FunnelService Funnel
@implements IDisposable

<h1>@AppI18n.T("common.cart")</h1>

@if (!string.IsNullOrEmpty(_shareMessage))
{
    <div class="alert alert-success">@_shareMessage</div>
}
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (CartState.Items.Count == 0)
{
    <div class="alert alert-info">
        @AppI18n.T("shop.cart_empty") <a href="/shop">@AppI18n.T("shop.cart_browse")</a>
    </div>
}
else
{
    @* GH1: freeship progress bar — hidden when the shop hasn't configured a threshold. *@
    @if (_freeShipThreshold > 0)
    {
        var ghRemaining = _freeShipThreshold - CartState.TotalAmount;
        var ghPct = ghRemaining <= 0 ? 100 : Math.Min(100, (int)Math.Round(CartState.TotalAmount / _freeShipThreshold * 100));
        <div class="gh-freeship mb-3">
            @if (ghRemaining <= 0)
            {
                <div class="alert alert-success mb-0 py-2">🎉 Đơn của bạn được <strong>miễn phí giao hàng</strong>!</div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <small>Còn <strong class="text-danger">@FormatPrice(ghRemaining)</strong> nữa được miễn phí giao hàng</small>
                    <small class="text-muted">@ghPct%</small>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-success progress-bar-striped" role="progressbar"
                         style="width: @ghPct%" aria-valuenow="@ghPct" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            }
        </div>
    }

    <div class="table-responsive">
        <table class="table cart-lines">
            <thead>
                <tr>
                    <th>@AppI18n.T("shop.product")</th>
                    <th class="text-right">@AppI18n.T("shop.unit_price")</th>
                    <th class="text-center">@AppI18n.T("common.quantity")</th>
                    <th class="text-right">@AppI18n.T("shop.line_total")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in CartState.Items)
                {
                    <tr @key="item.LineKey">
                        <td>
                            <strong>@item.ProductName</strong>
                            @if (item.IsCombo)
                            {
                                <span class="badge badge-warning ml-1">COMBO</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.SizeName))
                            {
                                <br /><small class="text-muted">Size: @item.SizeName</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ToppingNames))
                            {
                                <br /><small class="text-muted">@AppI18n.T("shop.toppings_label"): @item.ToppingNames</small>
                            }
                            @* BA cart: bỏ mã sản phẩm nội bộ (XOI-DO...) — khách không cần thấy. *@
                            @* Wave 6a (item 24): per-item note ("ghi chú món"). *@
                            <br />
                            <input class="form-control form-control-sm mt-1" style="max-width: 230px;"
                                   maxlength="500" placeholder="@AppI18n.T("shop.item_note_placeholder")"
                                   value="@item.Note"
                                   @onchange="(e) => CartState.UpdateNote(item.LineKey, e.Value?.ToString())" />
                        </td>
                        <td class="text-right">@FormatPrice(item.UnitPrice)</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQuantity(item, -1)">−</button>
                            <span class="mx-2">@item.Quantity</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQuantity(item, 1)">+</button>
                        </td>
                        <td class="text-right"><strong>@FormatPrice(item.LineTotal)</strong></td>
                        <td class="text-right">
                            <button class="btn btn-sm btn-danger" @onclick="() => CartState.Remove(item.LineKey)">@AppI18n.T("common.delete")</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right"><strong>@AppI18n.T("common.total"):</strong></td>
                    <td class="text-right"><strong class="text-danger" style="font-size: 1.2rem;">@FormatPrice(CartState.TotalAmount)</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    @* GH2: optional phone — carried over to checkout (?phone=) and saved for next time. *@
    <div class="form-group gh-cart-phone mb-3" style="max-width: 340px;">
        <label for="cart-phone"><small class="text-muted">📱 SĐT của bạn <span class="text-muted">(tùy chọn — tự điền sẵn ở bước thanh toán)</span></small></label>
        <input id="cart-phone" class="form-control" inputmode="tel" placeholder="0901234567"
               value="@_phone" @oninput="OnPhoneInput" maxlength="11" />
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 cart-actions">
        <div>
            <a class="btn btn-secondary mb-2 mr-2" href="/shop">@AppI18n.T("shop.continue_shopping")</a>
            <button class="btn btn-outline-primary mb-2" @onclick="ShareCartAsync" disabled="@_sharing">
                @(_sharing ? AppI18n.T("shop.creating_link") : AppI18n.T("shop.share_cart"))
            </button>
        </div>
        <button class="btn btn-success btn-lg mb-2 cart-checkout-flow" @onclick="GoToCheckout">
            @AppI18n.T("common.checkout") (@CartState.TotalQuantity)
        </button>
    </div>

    @* Mobile: thanh thanh toán sticky dưới cùng — gọn hơn nút full-width. *@
    <div class="cart-sticky-checkout">
        <div class="cart-sticky-total">
            <small class="text-muted">@AppI18n.T("common.total")</small>
            <strong class="text-danger">@FormatPrice(CartState.TotalAmount)</strong>
        </div>
        <button class="btn btn-success" @onclick="GoToCheckout">
            @AppI18n.T("common.checkout") →
        </button>
    </div>
    <div class="cart-sticky-spacer" aria-hidden="true"></div>

    @if (_suggestions != null && _suggestions.Count > 0)
    {
        <div class="card mt-2">
            <div class="card-header">@AppI18n.T("shop.suggested_sides")</div>
            <div class="card-body">
                <div class="row">
                    @foreach (var s in _suggestions)
                    {
                        <div class="col-12 col-md-4 mb-2" @key="s.Id">
                            <div class="d-flex align-items-center justify-content-between border rounded p-2">
                                <div>
                                    <strong>@s.Name</strong><br />
                                    <span class="text-danger">@FormatPrice(s.Price)</span>
                                </div>
                                <button class="btn btn-sm btn-primary" @onclick="() => QuickAddSuggestion(s)">@AppI18n.T("shop.add")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<ShopProductModel> _suggestions;
    private string _error;
    private string _shareMessage;
    private bool _sharing;

    // GH1: freeship progress bar (0 = not configured → hidden).
    private decimal _freeShipThreshold;

    // GH2: optional phone carried over to checkout.
    private const string PhoneStorageKey = "phuthuong.phone.v1";
    private string _phone;

    protected override async Task OnInitializedAsync()
    {
        AppI18n.OnChange += OnLangChanged;
        await AppI18n.InitializeAsync();
        Funnel.Track(FunnelService.Events.CartView, new Uri(Navigation.Uri).AbsolutePath);
        CartState.OnChange += OnCartChanged;
        await MergeSharedCartAsync();
        await LoadSuggestionsAsync();

        // GH1: freeship threshold (fail-soft — the bar hides when unset).
        try
        {
            var settings = await ShopSettingsService.GetPublicAsync();
            _freeShipThreshold = settings?.FreeShipThreshold ?? 0;
        }
        catch (Exception)
        {
            _freeShipThreshold = 0;
        }

        // GH2: prefill the phone from the last visit (fail-soft).
        try
        {
            _phone = await JSRuntime.InvokeAsync<string>("localStorage.getItem", PhoneStorageKey);
        }
        catch (Exception)
        {
            _phone = null;
        }
    }

    private void OnCartChanged()
    {
        _ = LoadSuggestionsAsync();
        InvokeAsync(StateHasChanged);
    }

    private void ChangeQuantity(CartItemModel item, int delta)
    {
        CartState.UpdateQuantity(item.LineKey, item.Quantity + delta);
    }

    private void QuickAddSuggestion(ShopProductModel product)
    {
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} vào giỏ");
    }

    private void OnPhoneInput(ChangeEventArgs e)
    {
        _phone = e.Value?.ToString();
    }

    /// <summary>
    /// GH2: saves the phone for next time and carries it to checkout (?phone=).
    /// </summary>
    private void GoToCheckout()
    {
        var phone = (_phone ?? "").Trim();
        try
        {
            _ = JSRuntime.InvokeVoidAsync("localStorage.setItem", PhoneStorageKey, phone);
        }
        catch (Exception)
        {
        }

        var url = string.IsNullOrWhiteSpace(phone)
            ? "/checkout"
            : $"/checkout?phone={Uri.EscapeDataString(phone)}";
        Navigation.NavigateTo(url);
    }

    /// <summary>
    /// GH3: "Thường được mua cùng" — best-sellers not already in the cart
    /// (same best-seller ordering as Shop.razor), backfilled with side
    /// dishes when fewer than 3 best-sellers are available.
    /// </summary>
    private async Task LoadSuggestionsAsync()
    {
        try
        {
            var inCart = new HashSet<Guid>(CartState.Items.Select(x => x.ProductId));
            var paged = await ShopService.GetProductsAsync();
            var available = (paged.Items ?? new List<ShopProductModel>())
                .Where(p => !inCart.Contains(p.Id))
                .ToList();

            var picks = new List<ShopProductModel>();
            try
            {
                var bestIds = await ShopService.GetBestSellerIdsAsync() ?? new List<Guid>();
                var byId = available.ToDictionary(p => p.Id);
                foreach (var id in bestIds)
                {
                    if (picks.Count >= 3)
                    {
                        break;
                    }

                    if (byId.TryGetValue(id, out var p))
                    {
                        picks.Add(p);
                    }
                }
            }
            catch (Exception)
            {
                // Best-seller ranking is nice-to-have — fall through to the backfill.
            }

            if (picks.Count < 3)
            {
                var pickedIds = new HashSet<Guid>(picks.Select(p => p.Id));
                picks.AddRange(available
                    .Where(p => !pickedIds.Contains(p.Id))
                    .OrderByDescending(p => (p.Category ?? "").Contains("kèm") ? 1 : 0)
                    .ThenBy(p => p.Name)
                    .Take(3 - picks.Count));
            }

            _suggestions = picks;
        }
        catch (Exception)
        {
            _suggestions = new List<ShopProductModel>();
        }
    }

    /// <summary>
    /// Copies a shareable cart link: /cart?share=&lt;base64 of "id:qty;id:qty"&gt;.
    /// </summary>
    private async Task ShareCartAsync()
    {
        _shareMessage = null;
        _error = null;

        if (CartState.Items.Count == 0)
        {
            return;
        }

        _sharing = true;
        try
        {
            var payload = string.Join(";",
                CartState.Items
                    .Where(x => !x.IsCombo)
                    .Select(x => $"{x.ProductId:N}:{x.Quantity}"));
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(payload))
                .Replace('+', '-').Replace('/', '_').TrimEnd('=');
            var link = $"{Navigation.BaseUri.TrimEnd('/')}/cart?share={base64}";

            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);
            _shareMessage = "Đã sao chép link giỏ hàng! Gửi link này cho bạn bè để họ đặt cùng.";
        }
        catch (Exception)
        {
            _error = "Không sao chép được link. Vui lòng thử lại.";
        }
        finally
        {
            _sharing = false;
        }
    }

    /// <summary>
    /// On page load, merges ?share= items into the cart (product ids are
    /// validated against the API).
    /// </summary>
    private async Task MergeSharedCartAsync()
    {
        var query = ParseQuery(Navigation.Uri);
        if (!query.TryGetValue("share", out var share) || string.IsNullOrWhiteSpace(share))
        {
            return;
        }

        try
        {
            var padded = share.Replace('-', '+').Replace('_', '/');
            padded = padded.PadRight(padded.Length + (4 - padded.Length % 4) % 4, '=');
            var payload = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(padded));

            var added = 0;
            foreach (var part in payload.Split(';', StringSplitOptions.RemoveEmptyEntries))
            {
                var pieces = part.Split(':');
                if (pieces.Length != 2
                    || !Guid.TryParseExact(pieces[0], "N", out var productId)
                    || !int.TryParse(pieces[1], out var qty)
                    || qty < 1)
                {
                    continue;
                }

                try
                {
                    var product = await ShopService.GetProductAsync(productId);
                    if (product != null && product.Status == "Active")
                    {
                        CartState.Add(product, Math.Min(qty, 99));
                        added++;
                    }
                }
                catch (Exception)
                {
                    // Invalid / unavailable product id — skip it.
                }
            }

            if (added > 0)
            {
                Toasts.Show($"Đã thêm {added} món từ link chia sẻ vào giỏ");
                // Remove the share param so a refresh doesn't re-add.
                Navigation.NavigateTo("/cart", forceLoad: false);
            }
        }
        catch (Exception)
        {
            // Malformed share payload — ignore.
        }
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return result;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            result[Uri.UnescapeDataString(pair.Substring(0, eq))] =
                Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
        }

        return result;
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartState.OnChange -= OnCartChanged;
        AppI18n.OnChange -= OnLangChanged;
    }
}
