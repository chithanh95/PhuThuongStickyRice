                                <tr>
                                    <td class="text-success" colspan="3">🏷 Khuyến mãi giờ vàng (@_activePromotion.Name) −@_activePromotion.DiscountPercent%</td>
                                    <td class="text-right text-success">−@FormatPrice(_promotionDiscountPreview)</td>
                                </tr>
                            }
                            @if (_discountAmount > 0)
