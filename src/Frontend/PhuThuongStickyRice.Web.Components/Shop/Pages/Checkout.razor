    /// <summary>Loyalty-points redemption preview.</summary>
    private decimal _redeemDiscountPreview
    {
        get
        {
            var unit = _shopSettings.PointsRedeemUnit;
            var value = _shopSettings.PointsRedeemValue;
            if (_redeemPoints <= 0 || unit <= 0 || value <= 0)
            {
                return 0;
            }

            return (_redeemPoints / unit) * value;
        }
    }

    private decimal _giftFeePreview => _order.IsGift ? Math.Max(0, _shopSettings.GiftFee) : 0;

    /// <summary>Deposit preview for large bank-transfer orders.</summary>
    private decimal _depositPreview
    {
        get
        {
            if (_order.PaymentMethod != "BankTransfer" || _shopSettings.DepositThreshold <= 0)
            {
                return 0;
            }

            var total = _grandTotal;
            return total >= _shopSettings.DepositThreshold
                ? Math.Round(total * _shopSettings.DepositPercent / 100, 0)
                : 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shopSettings = await ShopSettingsService.GetPublicAsync() ?? new ShopSettingModel();
        }
        catch (Exception)
        {
            _shopSettings = new ShopSettingModel();
        }

        // Item 91: happy-hour promotion preview (auto-applied server-side).
        try
        {
            _activePromotion = await AdminOperationsService.GetActivePromotionAsync();
        }
        catch (Exception)
        {
            _activePromotion = null;
        }

        // Item 105: feature flags (fail open — a status check must never
        // block checkout).
        try
        {
            var flags = await AdminSystemService.GetFeatureFlagMapAsync();
            _giftWrapEnabled = GetFlag(flags, "gift-wrap", true);
            _referralsEnabled = GetFlag(flags, "referrals", true);
            _luckySpinEnabled = GetFlag(flags, "lucky-spin", true);
        }
        catch (Exception)
        {
        }

        // Item 109: active branches for the branch picker.
        try
        {
            _branches = await AdminSystemService.GetActiveBranchesAsync();
        }
        catch (Exception)
        {
            _branches = new System.Collections.Generic.List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel>();
        }

        // Customer account: load saved addresses for quick-select.
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                _savedAddresses = await CustomerAddressService.GetMineAsync();
                var phone = authState.User.Identity.Name;
                if (IsValidPhone(phone) && string.IsNullOrWhiteSpace(_order.CustomerPhone))
                {
                    _order.CustomerPhone = phone;
                }

                // Item 90: prefill the customer's taste preferences into the
                // order note (editable — the customer can change it).
                try
                {
                    var profile = await CustomerProfileService.GetMyAsync();
                    if (string.IsNullOrWhiteSpace(_order.Notes))
                    {
                        var tasteNote = BuildTasteNote(profile);
                        if (!string.IsNullOrWhiteSpace(tasteNote))
                        {
                            _order.Notes = tasteNote;
                        }
                    }
                }
                catch (Exception) { }
            }
        }
        catch (Exception)
        {
            _savedAddresses = new List<CustomerAddressModel>();
        }

        RefreshMinOrderState();

        // GH2: phone carried over from the cart (?phone=) — prefill and run
        // the last-order auto-fill (fail-soft).
        try
        {
            var query = ParseQuery(Navigation.Uri);
            if (string.IsNullOrWhiteSpace(_order.CustomerPhone)
                && query.TryGetValue("phone", out var carriedPhone)
                && IsValidPhone(carriedPhone))
            {
                _order.CustomerPhone = carriedPhone.Trim();
                await DoPhoneLookupAsync();
            }
        }
        catch (Exception)
        {
        }

        // Item 139: tự động áp mã giảm giá tốt nhất (fail-soft — không
        // bao giờ chặn checkout).
        try
        {
            var query = ParseQuery(Navigation.Uri);
            if (query.TryGetValue("code", out var carriedCode)
                && !string.IsNullOrWhiteSpace(carriedCode)
                && string.IsNullOrWhiteSpace(_discountCodeInput))
            {
                // Item 143: mã giảm giá mang từ banner ở /shop.
                _discountCodeInput = carriedCode.Trim();
                await ApplyDiscount();
            }
            else if (_subtotal > 0 && string.IsNullOrWhiteSpace(_discountCodeInput))
            {
                await AutoApplyBestDiscountAsync();
            }
        }
        catch (Exception)
        {
        }

        // Wave 6b (item 30): pause/hours notice for the submit button.
        RefreshOrderingState();
        CartState.OnChange += OnCartChanged;
        AppI18n.OnChange += OnLangChanged;
        await AppI18n.InitializeAsync();
        Funnel.Track(FunnelService.Events.CheckoutView, new Uri(Navigation.Uri).AbsolutePath);
    }

    private static bool GetFlag(System.Collections.Generic.Dictionary<string, bool> flags, string key, bool fallback)
    {
        return flags != null && flags.TryGetValue(key, out var enabled) ? enabled : fallback;
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return result;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            result[Uri.UnescapeDataString(pair.Substring(0, eq))] =
                Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
        }

        return result;
    }

    /// <summary>Item 109: branch picker.</summary>
    private void OnBranchChanged(ChangeEventArgs e)
    {
        _branchId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null;
