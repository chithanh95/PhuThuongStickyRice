    private void OnCartChanged()
    {
        // Item 97: the cart content changed, so this is no longer the same
        // logical order — drop the idempotency key so a later submit mints a
        // fresh one instead of deduping against the previous cart.
        _order.IdempotencyKey = null;
        RefreshMinOrderState();
        _ = RefreshAppliedDiscountAsync();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Giữ mã giảm giá đồng bộ với giỏ hàng: khách có thể đổi số lượng ngay
    /// trên checkout SAU khi đã áp mã. Nếu giữ nguyên _discountAmount cũ,
    /// preview sẽ trừ sai so với số tiền server thực thu. Re-validate mã
    /// với subtotal mới (fail-soft); mã không còn hợp lệ thì gỡ kèm thông báo.
    /// </summary>
    private async Task RefreshAppliedDiscountAsync()
    {
        if (string.IsNullOrEmpty(_appliedCode) || _applyingDiscount)
        {
            return;
        }

        _applyingDiscount = true;
        try
        {
            var result = await DiscountService.ValidateAsync(_appliedCode, _subtotal, _order.CustomerPhone);
            if (result.Valid)
            {
                _discountAmount = result.DiscountAmount;
                _isFreeship = result.IsFreeship;
            }
            else
            {
                _discountMessage = $"Mã {_appliedCode} không còn đủ điều kiện với giỏ hàng mới, đã gỡ khỏi đơn.";
                _discountAmount = 0;
                _appliedCode = null;
                _isFreeship = false;
            }
        }
        catch (Exception)
        {
            // Fail-soft: giữ nguyên mức đã áp; server sẽ tính lại khi đặt hàng.
        }
        finally
        {
            _applyingDiscount = false;
            RefreshMinOrderState();
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Wave 6a (item 25): quantity steppers on the checkout order summary.
    /// Reducing to 0 removes the line; totals update live via OnCartChanged.
    /// </summary>
    private void ChangeQty(CartItemModel item, int delta)
    {
        CartState.UpdateQuantity(item.LineKey, item.Quantity + delta);
    }

    private void RefreshMinOrderState()
    {
        _minOrderBlocked = _shopSettings.MinOrderAmount > 0 && _subtotal < _shopSettings.MinOrderAmount;
    }

    /// <summary>
    /// Wave 6b (item 30): pause toggle + open-hours check for the checkout
    /// notice and the disabled submit button. Mirrors the server gate in
    /// OrderAppService.CreateAsync.
    /// </summary>
    private void RefreshOrderingState()
    {
        _orderingBlocked = false;
        _closedNotice = null;

        if (!_shopSettings.AcceptingOrders)
        {
            _orderingBlocked = true;
            _closedNotice = _shopSettings.IsHolidayPaused && !string.IsNullOrWhiteSpace(_shopSettings.PausedReason)
                ? _shopSettings.PausedReason
                : string.IsNullOrWhiteSpace(_shopSettings.PausedReason)
                    ? "Quán đang tạm ngừng nhận đơn. Vui lòng quay lại sau."
                    : $"Quán tạm ngưng nhận đơn: {_shopSettings.PausedReason}";
            return;
        }

        if (!ShopHours.IsOpen(_shopSettings.OpenTime, _shopSettings.CloseTime))
        {
            var open = ShopHours.ParseOpen(_shopSettings.OpenTime);
            var close = ShopHours.ParseClose(_shopSettings.CloseTime);
            _orderingBlocked = true;
            _closedNotice = $"Quán chỉ nhận đơn từ {open.Hours}:{open.Minutes:D2} đến {close.Hours}:{close.Minutes:D2}. " +
                            "Vui lòng quay lại trong giờ mở cửa.";
        }
    }

    /// <summary>VietQR image URL built from the shop's bank config + this order.</summary>
    private string QrUrl
    {
        get
        {
            if (_bankInfo == null || _placedOrder == null)
            {
                return string.Empty;
            }

            var template = string.IsNullOrWhiteSpace(_bankInfo.QrTemplate) || _bankInfo.QrTemplate == "xxx"
                ? "compact2"
                : _bankInfo.QrTemplate;
            var amount = (long)_placedOrder.TotalAmount;
            return $"https://img.vietqr.io/image/{_bankInfo.BankId}-{_bankInfo.AccountNumber}-{template}.png"
                + $"?amount={amount}&addInfo={Uri.EscapeDataString(_placedOrder.OrderNumber)}"
                + $"&accountName={Uri.EscapeDataString(_bankInfo.AccountName ?? string.Empty)}";
        }
    }

    /// <summary>
    /// GH2/TT2: while the user types the phone, wait 600ms after the last
    /// keystroke before looking up (debounce).
    /// </summary>
    private async Task OnPhoneInputAsync(ChangeEventArgs e)
    {
        _order.CustomerPhone = e.Value?.ToString();
        _phoneLookupCts?.Cancel();
        _phoneLookupCts?.Dispose();
        _phoneLookupCts = new System.Threading.CancellationTokenSource();
        var token = _phoneLookupCts.Token;
        try
        {
            await Task.Delay(600, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!token.IsCancellationRequested)
        {
            await DoPhoneLookupAsync();
        }
    }

    /// <summary>
    /// Blur: run the pending lookup immediately instead of waiting out the debounce.
    /// </summary>
    private async Task LookupLastOrderAsync()
    {
        _phoneLookupCts?.Cancel();
        await DoPhoneLookupAsync();
    }

    /// <summary>
    /// Loads the loyalty summary, wallet balance and last-order name for the
    /// entered phone. Auto-filled fields never overwrite text the user
    /// already typed.
    /// </summary>
    private async Task DoPhoneLookupAsync()
    {
        var phone = (_order.CustomerPhone ?? "").Trim();
        if (phone == _suggestedPhone || !IsValidPhone(phone))
        {
            return;
        }

        _suggestedPhone = phone;
        _lookingUpPhone = true;
        StateHasChanged();

        try
        {
            // Loyalty summary (points, tier, referral code) for the phone.
            try
            {
                _loyalty = await ShopEngagementService.GetLoyaltyByPhoneAsync(phone);
                _redeemPoints = 0;
                _redeemPointsInput = 0;
                _redeemMessage = null;
            }
            catch (Exception)
            {
                _loyalty = null;
            }

            // Item 140: wallet balance for this phone (enables the ví option).
            try
            {
                var wallet = await AdminCommerceService.GetWalletBalanceAsync(phone);
                _walletBalance = wallet?.Balance ?? 0;
            }
            catch (Exception)
            {
                _walletBalance = 0;
            }

            // TT2: auto-fill the name from the most recent order — never
            // overwrite a name the user already typed. (This checkout has no
            // delivery-address field: the shop doesn't deliver — the order is
            // ShipperPickup or customer Pickup.)
            try
            {
                var last = await ShopService.GetLastOrderInfoAsync(phone);
                if (last != null
                    && string.IsNullOrWhiteSpace(_order.CustomerName)
                    && !string.IsNullOrWhiteSpace(last.CustomerName))
                {
                    _order.CustomerName = last.CustomerName;
                }
            }
            catch (Exception)
            {
            }
        }
        finally
        {
            _lookingUpPhone = false;
            StateHasChanged();
        }
    }

    private async Task ApplyDiscount()
    {
        _discountMessage = null;
        var code = (_discountCodeInput ?? "").Trim();
        if (string.IsNullOrEmpty(code))
        {
            _discountAmount = 0;
            _appliedCode = null;
            _isFreeship = false;
            _discountMessage = "Vui lòng nhập mã giảm giá.";
            return;
        }

        _applyingDiscount = true;
        try
        {
            var result = await DiscountService.ValidateAsync(code, _subtotal, _order.CustomerPhone);
            if (result.Valid)
            {
                _discountAmount = result.DiscountAmount;
                _appliedCode = code.ToUpperInvariant();
                _isFreeship = result.IsFreeship;
                _discountMessage = result.Message;
            }
            else
            {
                _discountAmount = 0;
                _appliedCode = null;
                _isFreeship = false;
                _discountMessage = result.Message;
            }
        }
        catch (Exception)
        {
            _discountAmount = 0;
            _appliedCode = null;
            _isFreeship = false;
            _discountMessage = "Không kiểm tra được mã giảm giá. Vui lòng thử lại.";
        }
        finally
        {
            _applyingDiscount = false;
            RefreshMinOrderState();
        }
    }

    /// <summary>
    /// Item 139: tự áp mã giảm tiền công khai tốt nhất (không xét freeship
    /// vì đã có luồng riêng). Fail-soft — không bao giờ chặn checkout.
    /// </summary>
    private async Task AutoApplyBestDiscountAsync()
    {
        try
        {
            // perf-hunt 2026-10-19: server chọn mã giảm tiền tốt nhất trong 1
            // round-trip (POST api/discounts/best), thay cho GET active + N lần
            // ValidateAsync tuần tự trên hot path checkout. Server dùng đúng
            // logic CheckUsable/ComputeDiscount của ValidateAsync nên kết quả
            // giống hệt vòng lặp cũ (bỏ freeship, hòa thì giữ mã mới nhất).
            var best = await DiscountService.EvaluateBestAsync(_subtotal, _order.CustomerPhone);
            var bestCode = best?.Code;
            var bestAmount = best?.DiscountAmount ?? 0;

            if (!string.IsNullOrWhiteSpace(bestCode)
                && bestAmount > 0
                && string.IsNullOrWhiteSpace(_discountCodeInput))
            {
                _discountCodeInput = bestCode;
                await ApplyDiscount();
                if (!string.IsNullOrWhiteSpace(_appliedCode))
                {
                    // UX người già: câu đơn giản, ghi rõ số tiền tiết kiệm.
                    _autoAppliedNote = $"Đã tự dùng mã {_appliedCode} giúp bạn tiết kiệm {FormatPrice(bestAmount)}";
                }
            }
        }
        catch (Exception)
        {
        }
    }

    /// <summary>
    /// Item 139: ẩn ghi chú tự áp mã khi khách sửa/xóa mã thủ công.
    /// </summary>
    private void ClearAutoAppliedNote()
    {
        _autoAppliedNote = null;
    }

    private void ApplyRedeem()
    {
        _redeemMessage = null;
        var unit = _shopSettings.PointsRedeemUnit;
        var balance = _loyalty?.Points ?? 0;

        if (unit <= 0 || balance < unit)
        {
            _redeemPoints = 0;
            _redeemMessage = "Bạn chưa đủ điểm để đổi.";
            return;
        }

        var requested = _redeemPointsInput;
        if (requested < unit)
        {
            _redeemPoints = 0;
            _redeemMessage = $"Cần ít nhất {unit} điểm để đổi.";
            return;
        }

        if (requested > balance)
        {
            _redeemPoints = 0;
            _redeemMessage = $"Bạn chỉ có {balance} điểm.";
            return;
        }

        // Round down to whole steps.
        _redeemPoints = (requested / unit) * unit;
        _redeemMessage = $"Đổi {_redeemPoints} điểm → giảm {FormatPrice(_redeemDiscountPreview)}.";
    }

    private bool ValidateFields()
    {
        _nameError = string.IsNullOrWhiteSpace(_order.CustomerName) ? "Vui lòng nhập họ tên." : null;
        _phoneError = !IsValidPhone(_order.CustomerPhone) ? "Số điện thoại không đúng định dạng (VD: 0901234567)." : null;
        _emailError = !string.IsNullOrWhiteSpace(_order.CustomerEmail) && !IsValidEmail(_order.CustomerEmail)
            ? "Email không đúng định dạng. Bạn có thể để trống nếu không có email."
            : null;
        _addressError = null;
        _recipientNameError = _orderForSomeoneElse && string.IsNullOrWhiteSpace(_order.RecipientName)
            ? "Vui lòng nhập tên người nhận."
            : null;
        _recipientPhoneError = _orderForSomeoneElse && !IsValidPhone(_order.RecipientPhone)
            ? "SĐT người nhận không đúng định dạng."
            : null;
        _taxCodeError = _showVat && string.IsNullOrWhiteSpace(_order.TaxCode)
            ? "Vui lòng nhập mã số thuế."
            : null;
        _companyNameError = _showVat && string.IsNullOrWhiteSpace(_order.CompanyName)
            ? "Vui lòng nhập tên công ty."
            : null;

        return _nameError == null && _phoneError == null && _emailError == null && _addressError == null
            && _recipientNameError == null && _recipientPhoneError == null
            && _taxCodeError == null && _companyNameError == null;
    }



    private async Task PlaceOrder()
    {
        _error = null;

        DateTime? scheduledFor = null; // Luôn nhận ngay — đã bỏ đặt trước theo giờ.

        if (!ValidateFields())
        {
            _error = "Vui lòng kiểm tra lại các thông tin được đánh dấu.";
            return;
        }

        if (_minOrderBlocked)
        {
            _error = $"Đơn hàng tối thiểu {FormatPrice(_shopSettings.MinOrderAmount)}. Vui lòng thêm món vào giỏ.";
            return;
        }

        // Wave 6b (item 30): client-side guard; the server is the real gate.
        if (_orderingBlocked)
        {
            _error = _closedNotice ?? "Quán đang tạm ngừng nhận đơn.";
            return;
        }

        _submitting = true;
        try
        {
            _order.DiscountCode = _appliedCode;
            _order.FulfillmentMethod = _fulfillment;
            _order.RedeemPoints = _redeemPoints;
            _order.BranchId = _branchId;

            // No delivery slot — the shop does not deliver.
            _order.DeliverySlot = null;

            // Pre-order scheduled pickup time (local → server normalizes to UTC).
            _order.ScheduledFor = scheduledFor;

            // Item 133: order source captured at shop entry.
            _order.Source = CartState.Source;

            // Item 97: one idempotency key per logical order, reused across
            // retries. Minting a fresh key per submit attempt defeated the
            // server-side dedupe: a retry after a timeout/reconnect created a
            // DUPLICATE order (double wallet charge, double loyalty redeem,
            // double discount usage). The key is reset when the cart changes
            // (OnCartChanged) or after the order succeeds, so a changed cart
            // never reuses a stale key.
            if (string.IsNullOrEmpty(_order.IdempotencyKey))
            {
                _order.IdempotencyKey = Guid.NewGuid().ToString("D");
            }

            // Item 96: reCAPTCHA v3 token when enabled in shop settings.
            _order.RecaptchaToken = null;
            if (!string.IsNullOrWhiteSpace(_shopSettings.RecaptchaSiteKey))
            {
                try
                {
                    _order.RecaptchaToken = await JSRuntime.InvokeAsync<string>(
                        "interop.recaptchaToken", _shopSettings.RecaptchaSiteKey);
                }
                catch (Exception)
                {
                    _order.RecaptchaToken = null;
                }
            }
            if (_fulfillment == "Pickup" || _fulfillment == "ShipperPickup")
            {
                _order.CustomerAddress = null;
            }

            if (!_orderForSomeoneElse)
            {
                _order.RecipientName = null;
                _order.RecipientPhone = null;
            }

            if (!_showVat)
            {
                _order.TaxCode = null;
                _order.CompanyName = null;
            }

            if (!_order.IsGift)
            {
                _order.GiftMessage = null;
            }

            _order.Lines = CartState.Items
                .Select(x => new CreateOrderLineModel
                {
                    ProductId = x.ProductId,
                    Quantity = x.Quantity,
                    SizeOptionId = x.SizeOptionId,
                    ToppingIds = x.ToppingIds ?? new System.Collections.Generic.List<Guid>(),
                    IsCombo = x.IsCombo,
                    // Wave 6a (item 24): per-item note persists to the order line.
                    Note = x.Note
                })
                .ToList();

            _placedOrder = await ShopService.CreateOrderAsync(_order);
            // Item 97: order accepted — drop the key so a later new checkout
            // mints a fresh one (CartState.Clear below also triggers
            // OnCartChanged, which resets it as well).
            _order.IdempotencyKey = null;
            Funnel.Track(FunnelService.Events.OrderPlaced, new Uri(Navigation.Uri).AbsolutePath);
            CartState.Clear();
            CartState.OnChange -= OnCartChanged;

            // TT4: jump straight to order tracking for payment methods that
            // need no further action on this screen (Cod / Wallet). The
            // success toast confirms the order; the order number is prefilled
            // in the track-order lookup.
            var needsPaymentUi = _placedOrder.PaymentMethod == "BankTransfer"
                || _placedOrder.PaymentMethod == "MoMo";
            Toasts.Show($"🎉 Đặt hàng thành công! Mã đơn của bạn: {_placedOrder.OrderNumber}");
            if (!needsPaymentUi)
            {
                Navigation.NavigateTo(
                    $"/track-order?orderNumber={Uri.EscapeDataString(_placedOrder.OrderNumber)}");
                return;
            }

            if (_placedOrder.PaymentMethod == "BankTransfer")
            {
                try
                {
                    _bankInfo = await ShopService.GetBankTransferInfoAsync();
                }
                catch (Exception)
                {
                    // Bank info is nice-to-have here; the track-order page
                    // shows the same info. Fall back to the placeholder box.
                    _bankInfo = new BankTransferInfoModel();
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message.Contains("tối thiểu") || ex.Message.Contains("Mã")
                ? ex.Message
                : "Đặt hàng thất bại. Vui lòng kiểm tra lại thông tin và thử lại.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task MarkTransferred()
    {
        _transferMessage = null;
        _transferError = null;
        _markingTransferred = true;
        try
        {
            var updated = await ShopService.MarkTransferredAsync(_placedOrder.Id, _placedOrder.CustomerPhone);
            _placedOrder.PaymentStatus = updated.PaymentStatus;
            _transferMessage = "Đã ghi nhận bạn đã chuyển khoản. Shop sẽ xác nhận thanh toán sớm.";
        }
        catch (Exception)
        {
            _transferError = "Không ghi nhận được. Vui lòng thử lại hoặc liên hệ shop.";
        }
        finally
        {
            _markingTransferred = false;
        }
    }

    private async Task PayWithMoMo()
    {
        _momoError = null;
        _payingMoMo = true;
        try
        {
            var result = await ShopService.CreateMoMoPaymentAsync(_placedOrder.Id);
            // forceLoad: PayUrl ngoài (MoMo production) — NavigateTo URI ngoài
