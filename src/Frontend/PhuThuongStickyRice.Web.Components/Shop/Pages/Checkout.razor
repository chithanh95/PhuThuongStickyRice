    private string _fulfillment = "ShipperPickup";

    // Pre-order (đặt trước theo giờ): false = nhận ngay (ASAP).

    // Per-field validation messages.
    private string _nameError;
    private string _phoneError;
    private string _emailError;
    private string _addressError;
    private string _recipientNameError;
    private string _recipientPhoneError;
    private string _taxCodeError;
    private string _companyNameError;

    // Recipient / VAT / gift.
    private bool _orderForSomeoneElse;
    private bool _showVat;

    // Item 105: feature flags (UI gating; backend enforces too).
    private bool _giftWrapEnabled = true;
    private bool _referralsEnabled = true;
    private bool _luckySpinEnabled = true;

    // Item 109: branch selection.
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel> _branches;
    private Guid? _branchId;

    // Item 120: freeship voucher state.
    private bool _isFreeship;

    // Loyalty.
    private LoyaltyAccountModel _loyalty;
    private int _redeemPointsInput;
    private int _redeemPoints;
    private string _redeemMessage;

    // Lucky spin.
    private static readonly string[] _spinSegments = { "5%", "10%", "15%", "Miễn ship", "20k", "May mắn" };
    private static readonly string[] _spinSegmentKeys = { "Percent5", "Percent10", "Percent15", "FreeShip", "Cash20k", "Miss" };
    private string _wheelStyle = string.Empty;
    private SpinResultModel _spinResult;
    private bool _spinning;
    private string _spinError;

    // Address auto-fill from phone history.
    private string _suggestedPhone;

    // GH2/TT2: debounced phone lookup (cancels when the user keeps typing).
    private System.Threading.CancellationTokenSource _phoneLookupCts;
    private bool _lookingUpPhone;

    // Discount state.
    private string _discountCodeInput;
    private string _appliedCode;
