@page "/checkout"
@using System
@using System.Linq
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@implements IDisposable
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject DiscountService DiscountService
@inject Wave2Service Wave2Service
@inject Wave3Service Wave3Service
@inject Wave4Service Wave4Service
@inject Wave5Service Wave5Service
@inject CartState CartState
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject ShopI18n I18n

<h3>@I18n.T("checkout")</h3>

@if (_placedOrder != null)
{
    <div class="alert alert-success">
        <h4>Đặt hàng thành công!</h4>
        <p>Mã đơn hàng của bạn: <strong>@_placedOrder.OrderNumber</strong></p>
        <table class="table table-sm mb-2">
            <tbody>
                <tr><td>@I18n.T("subtotal")</td><td class="text-right">@FormatPrice(_placedOrder.Subtotal)</td></tr>
                @if (_placedOrder.PromotionDiscountAmount > 0)
                {
                    <tr>
                        <td>🏷 Khuyến mãi giờ vàng @(!string.IsNullOrWhiteSpace(_placedOrder.PromotionName) ? $"({_placedOrder.PromotionName})" : "")</td>
                        <td class="text-right text-success">−@FormatPrice(_placedOrder.PromotionDiscountAmount)</td>
                    </tr>
                }
                @if (_placedOrder.DiscountAmount > 0)
                {
                    <tr>
                        <td>@I18n.T("discount") @(!string.IsNullOrWhiteSpace(_placedOrder.DiscountCode) ? $"({_placedOrder.DiscountCode})" : "")</td>
                        <td class="text-right text-success">−@FormatPrice(_placedOrder.DiscountAmount)</td>
                    </tr>
                }
                @if (_placedOrder.TierDiscount > 0)
                {
                    <tr>
                        <td>Ưu đãi hạng thành viên</td>
                        <td class="text-right text-success">−@FormatPrice(_placedOrder.TierDiscount)</td>
                    </tr>
                }
                @if (_placedOrder.LoyaltyDiscount > 0)
                {
                    <tr>
                        <td>Đổi @_placedOrder.LoyaltyPointsRedeemed điểm</td>
                        <td class="text-right text-success">−@FormatPrice(_placedOrder.LoyaltyDiscount)</td>
                    </tr>
                }
                @if (_placedOrder.GiftFee > 0)
                {
                    <tr>
                        <td>🎁 Phí gói quà</td>
                        <td class="text-right">+@FormatPrice(_placedOrder.GiftFee)</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(_placedOrder.TaxCode))
                {
                    <tr>
                        <td>Hóa đơn VAT</td>
                        <td class="text-right"><small>@_placedOrder.CompanyName<br />MST: @_placedOrder.TaxCode</small></td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(_placedOrder.RecipientName))
                {
                    <tr>
                        <td>Người nhận</td>
                        <td class="text-right"><small>@_placedOrder.RecipientName<br />@_placedOrder.RecipientPhone</small></td>
                    </tr>
                }
                @if (_placedOrder.RequiresDeposit)
                {
                    <tr>
                        <td>💰 Cần đặt cọc (@_shopSettings.DepositPercent%)</td>
                        <td class="text-right"><strong class="text-warning">@FormatPrice(_placedOrder.TotalAmount * _shopSettings.DepositPercent / 100)</strong></td>
                    </tr>
                }
                @if (_placedOrder.FulfillmentMethod == "Pickup")
                {
                    <tr><td>Nhận hàng</td><td class="text-right text-success">Tự đến lấy tại quán</td></tr>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_placedOrder.DeliverySlot))
                    {
                        <tr>
                            <td>Giờ giao</td>
                            <td class="text-right"><strong>🕖 @_placedOrder.DeliverySlot</strong></td>
                        </tr>
                    }
                    @if (_placedOrder.DeliveryFee > 0)
                    {
                        <tr><td>@I18n.T("delivery_fee")</td><td class="text-right">@FormatPrice(_placedOrder.DeliveryFee)</td></tr>
                    }
                    else
                    {
                        <tr><td>@I18n.T("delivery_fee")</td><td class="text-right text-success">Miễn phí</td></tr>
                    }
                }
                <tr>
                    <td><strong>Tổng tiền</strong></td>
                    <td class="text-right"><strong class="text-danger">@FormatPrice(_placedOrder.TotalAmount)</strong></td>
                </tr>
            </tbody>
        </table>
        <p>Chúng tôi sẽ liên hệ với bạn qua số <strong>@_placedOrder.CustomerPhone</strong> để xác nhận.</p>
        <p>
            <a class="btn btn-outline-primary btn-sm" href="/track-order?orderNumber=@Uri.EscapeDataString(_placedOrder.OrderNumber)">Tra cứu đơn hàng</a>
            <a class="btn btn-primary btn-sm ml-2" href="/shop">Tiếp tục mua hàng</a>
        </p>
    </div>

    @* Item 105: lucky spin is feature-flagged (backend enforces too). *@
    @if (!_placedOrder.LuckySpinUsed && _luckySpinEnabled)
    {
        <div class="card mb-3">
            <div class="card-header">🎡 Quay may mắn — nhận voucher cho đơn tiếp theo</div>
            <div class="card-body text-center">
                <div class="spin-wheel-wrap">
                    <div class="spin-pointer">▼</div>
                    <div class="spin-wheel" style="@_wheelStyle">
                        @for (var i = 0; i < _spinSegments.Length; i++)
                        {
                            <span class="spin-label" style="@SpinLabelStyle(i)">@_spinSegments[i]</span>
                        }
                    </div>
                </div>
                @if (_spinResult == null)
                {
                    <button class="btn btn-warning mt-3" @onclick="DoSpin" disabled="@_spinning">
                        @(_spinning ? "Đang quay..." : "🎡 Quay ngay")
                    </button>
                    @if (!string.IsNullOrEmpty(_spinError))
                    {
                        <div class="alert alert-danger mt-2">@_spinError</div>
                    }
                }
                else
                {
                    <div class="alert @(_spinResult.Code == null ? "alert-secondary" : "alert-success") mt-3">
                        <strong>@_spinResult.PrizeLabel</strong>
                        @if (_spinResult.Code != null)
                        {
                            <div class="mt-2">
                                Mã voucher của bạn:
                                <strong class="h5 text-danger">@_spinResult.Code</strong>
                                <small class="d-block text-muted">
                                    HSD: @_spinResult.ExpiresAt?.ToLocalTime().ToString("dd/MM/yyyy") —
                                    dùng 1 lần cho số @_placedOrder.CustomerPhone
                                </small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (_placedOrder.PaymentMethod == "Cod")
    {
        <div class="alert alert-info">
            <strong>Thanh toán khi nhận hàng (COD):</strong> bạn sẽ trả tiền mặt cho shipper khi nhận hàng.
        </div>
    }
    else if (_placedOrder.PaymentMethod == "Wallet")
    {
        <div class="alert alert-success">
            <strong>💰 Đã thanh toán bằng ví</strong> (@_placedOrder.TotalAmount.ToString("N0") ₫ đã trừ khỏi số dư của bạn).
        </div>
    }
    else if (_placedOrder.PaymentMethod == "BankTransfer")
    {
        <div class="card mb-3">
            <div class="card-header">Chuyển khoản ngân hàng</div>
            <div class="card-body">
                @if (_bankInfo == null)
                {
                    <p><em>Đang tải thông tin chuyển khoản...</em></p>
                }
                else if (!_bankInfo.IsConfigured)
                {
                    <div class="alert alert-warning">
                        <strong>QR sẽ hiện khi shop cấu hình ngân hàng.</strong>
                        <p class="mb-0">Tạm thời bạn vui lòng chuyển khoản với nội dung: <strong>@_placedOrder.OrderNumber</strong> rồi bấm “Tôi đã chuyển khoản” bên dưới để shop xác nhận.</p>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-5 text-center">
                            <img src="@QrUrl" alt="QR chuyển khoản" style="max-width: 260px; width: 100%;" />
                            <p class="text-muted mt-2"><small>Quét mã để chuyển khoản nhanh</small></p>
                        </div>
                        <div class="col-md-7">
                            <table class="table table-sm">
                                <tr><td><strong>Ngân hàng</strong></td><td>@_bankInfo.BankName</td></tr>
                                <tr><td><strong>Số tài khoản</strong></td><td><strong>@_bankInfo.AccountNumber</strong></td></tr>
                                <tr><td><strong>Chủ tài khoản</strong></td><td>@_bankInfo.AccountName</td></tr>
                                <tr><td><strong>Số tiền</strong></td><td><strong class="text-danger">@FormatPrice(_placedOrder.TotalAmount)</strong></td></tr>
                                <tr><td><strong>Nội dung</strong></td><td><strong>@_placedOrder.OrderNumber</strong></td></tr>
                            </table>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_transferMessage))
                {
                    <div class="alert alert-success">@_transferMessage</div>
                }
                @if (!string.IsNullOrEmpty(_transferError))
                {
                    <div class="alert alert-danger">@_transferError</div>
                }

                @if (_placedOrder.PaymentStatus == "Unpaid")
                {
                    <button class="btn btn-success" @onclick="MarkTransferred" disabled="@_markingTransferred">
                        @(_markingTransferred ? "Đang gửi..." : "Tôi đã chuyển khoản")
                    </button>
                    <p class="text-muted mt-2"><small>Sau khi bạn bấm nút này, shop sẽ xác nhận và trang tra cứu đơn hàng sẽ hiện “Đã thanh toán”.</small></p>
                }
                else if (_placedOrder.PaymentStatus == "PendingConfirmation")
                {
                    <div class="alert alert-info mb-0">Đã ghi nhận bạn đã chuyển khoản. Shop đang xác nhận thanh toán.</div>
                }
                else if (_placedOrder.PaymentStatus == "Paid")
                {
                    <div class="alert alert-success mb-0">Thanh toán thành công! Cảm ơn bạn.</div>
                }
            </div>
        </div>
    }
    else if (_placedOrder.PaymentMethod == "MoMo")
    {
        <div class="card mb-3">
            <div class="card-header">Thanh toán qua MoMo <span class="badge badge-warning">TEST</span></div>
            <div class="card-body">
                @if (_placedOrder.PaymentStatus == "Paid")
                {
                    <div class="alert alert-success mb-0">Thanh toán MoMo thành công! Cảm ơn bạn.</div>
                }
                else if (_placedOrder.PaymentStatus == "Failed")
                {
                    <div class="alert alert-danger">Thanh toán MoMo thất bại. Bạn có thể thử lại.</div>
                    <button class="btn btn-primary" @onclick="PayWithMoMo" disabled="@_payingMoMo">
                        @(_payingMoMo ? "Đang xử lý..." : "Thử thanh toán MoMo lại")
                    </button>
                }
                else
                {
                    <p>Đơn hàng của bạn sẽ được thanh toán qua ví MoMo (chế độ test — chưa trừ tiền thật).</p>
                    @if (!string.IsNullOrEmpty(_momoError))
                    {
                        <div class="alert alert-danger">@_momoError</div>
                    }
                    <button class="btn btn-primary" @onclick="PayWithMoMo" disabled="@_payingMoMo">
                        @(_payingMoMo ? "Đang xử lý..." : "Thanh toán MoMo")
                    </button>
                }
            </div>
        </div>
    }
}
else if (CartState.Items.Count == 0)
{
    <div class="alert alert-info">
        Giỏ hàng đang trống. <a href="/shop">Xem các món xôi</a>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_minOrderBlocked)
    {
        <div class="alert alert-warning">
            Đơn hàng tối thiểu <strong>@FormatPrice(_shopSettings.MinOrderAmount)</strong>.
            Vui lòng thêm món vào giỏ để tiếp tục.
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">@I18n.T("your_info")</div>
                <div class="card-body">
                    <div class="form-group">
                        <label>Hình thức nhận hàng *</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="fulfillment" id="fm-delivery"
                                   checked="@(_fulfillment == "Delivery")" @onchange="@(() => _fulfillment = "Delivery")" />
                            <label class="form-check-label" for="fm-delivery">🛵 Giao tận nơi</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="fulfillment" id="fm-pickup"
                                   checked="@(_fulfillment == "Pickup")" @onchange="@(() => _fulfillment = "Pickup")" />
                            <label class="form-check-label" for="fm-pickup">🏪 Tự đến lấy tại quán <small class="text-success">(miễn phí ship)</small></label>
                        </div>
                    </div>
                    @* Wave 6a (item 23): delivery time slot — giao ngay or hẹn giờ. *@
                    @if (_fulfillment == "Delivery")
                    {
                        <div class="form-group">
                            <label>Thời gian giao hàng *</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="deliverySlot" id="ds-now"
                                       checked="@(_deliverySlotMode == "now")" @onchange='() => _deliverySlotMode = "now"' />
                                <label class="form-check-label" for="ds-now">🛵 Giao ngay</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="deliverySlot" id="ds-scheduled"
                                       checked="@(_deliverySlotMode == "scheduled")" @onchange='() => _deliverySlotMode = "scheduled"' />
                                <label class="form-check-label" for="ds-scheduled">🕖 Hẹn giờ</label>
                            </div>
                            @if (_deliverySlotMode == "scheduled")
                            {
                                @if (_deliverySlots.Count > 0)
                                {
                                    <select class="form-control mt-2 @FieldClass(_slotError)" @bind="_selectedSlot">
                                        <option value="">— Chọn khung giờ —</option>
                                        @foreach (var s in _deliverySlots)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <div class="alert alert-warning py-2 mt-2 mb-0">
                                        <small>Hết khung giờ hôm nay — bạn vui lòng chọn “🛵 Giao ngay”.</small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_slotError))
                                {
                                    <small class="text-danger">@_slotError</small>
                                }
                            }
                        </div>
                    }
                    @* Item 109: branch picker. *@
                    @if (_branches != null && _branches.Count > 0)
                    {
                        <div class="form-group">
                            <label>Chi nhánh <small class="text-muted">(tùy chọn)</small></label>
                            <select class="form-control" @onchange="OnBranchChanged">
                                <option value="">— Không chọn —</option>
                                @foreach (var b in _branches)
                                {
                                    <option value="@b.Id" selected="@(_branchId == b.Id)">@b.Name</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-group">
                        <label>@I18n.T("full_name") *</label>
                        <input class="form-control @FieldClass(_nameError)" @bind="_order.CustomerName" placeholder="Nguyễn Văn A" />
                        @if (!string.IsNullOrEmpty(_nameError))
                        {
                            <small class="text-danger">@_nameError</small>
                        }                    </div>
                    <div class="form-group">
                        <label>@I18n.T("phone") *</label>
                        <input class="form-control @FieldClass(_phoneError)" @bind="_order.CustomerPhone"
                               @onblur="LookupLastOrderAsync" placeholder="0901234567" />
                        @if (!string.IsNullOrEmpty(_phoneError))
                        {
                            <small class="text-danger">@_phoneError</small>
                        }
                        @if (_addressSuggestion != null)
                        {
                            <div class="alert alert-info py-2 mt-2">
                                <small>
                                    Đã tìm thấy địa chỉ cũ của số này.
                                    <button type="button" class="btn btn-sm btn-outline-primary ml-1" @onclick="UseSuggestedAddress">
                                        Dùng địa chỉ cũ: @_addressSuggestion.CustomerAddress
                                    </button>
                                    <button type="button" class="close" aria-label="Bỏ qua" @onclick="DismissSuggestion">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </small>
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <label>Email (tùy chọn — để nhận mail xác nhận đơn)</label>
                        <input class="form-control @FieldClass(_emailError)" @bind="_order.CustomerEmail" placeholder="ban@example.com" />
                        @if (!string.IsNullOrEmpty(_emailError))
                        {
                            <small class="text-danger">@_emailError</small>
                        }
                    </div>
                    @if (_fulfillment == "Delivery")
                    {
                        <div class="form-group">
                            <label>@I18n.T("address") *</label>
                            <textarea class="form-control @FieldClass(_addressError)" @bind="_order.CustomerAddress" rows="3"
                                      placeholder="Số nhà, đường, phường..."></textarea>
                            @if (!string.IsNullOrEmpty(_addressError))
                            {
                                <small class="text-danger">@_addressError</small>
                            }
                            @* Item 119: address book quick-select chips. *@
                            @if (_addresses != null && _addresses.Count > 0)
                            {
                                <div class="mt-2">
                                    <small class="text-muted d-block mb-1">📒 Địa chỉ đã lưu:</small>
                                    @foreach (var a in _addresses)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info mr-1 mb-1"
                                                @onclick="() => UseSavedAddress(a)" title="@a.Address">
                                            @a.Label
                                        </button>
                                    }
                                </div>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-1" @onclick="SaveCurrentAddressAsync"
                                    disabled="@_savingAddress">
                                @(_savingAddress ? "Đang lưu..." : "💾 Lưu địa chỉ này")
                            </button>
                            @if (!string.IsNullOrEmpty(_addressSavedMessage))
                            {
                                <small class="text-success d-block mt-1">@_addressSavedMessage</small>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <small>🏪 Bạn sẽ tự đến lấy tại quán — không cần nhập địa chỉ, <strong>miễn phí ship</strong>.</small>
                        </div>
                    }
                    <div class="form-group">
                        <label>@I18n.T("note")</label>
                        <textarea class="form-control" @bind="_order.Notes" rows="2"
                                  placeholder="Ví dụ: giao giờ hành chính..."></textarea>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="recipient-toggle"
                               @bind="_orderForSomeoneElse" />
                        <label class="form-check-label" for="recipient-toggle">Người nhận khác người đặt</label>
                    </div>
                    @if (_orderForSomeoneElse)
                    {
                        <div class="form-group">
                            <label>Tên người nhận *</label>
                            <input class="form-control @FieldClass(_recipientNameError)" @bind="_order.RecipientName"
                                   placeholder="Tên người nhận hàng" />
                            @if (!string.IsNullOrEmpty(_recipientNameError))
                            {
                                <small class="text-danger">@_recipientNameError</small>
                            }
                        </div>
                        <div class="form-group">
                            <label>SĐT người nhận *</label>
                            <input class="form-control @FieldClass(_recipientPhoneError)" @bind="_order.RecipientPhone"
                                   placeholder="0901234567" />
                            @if (!string.IsNullOrEmpty(_recipientPhoneError))
                            {
                                <small class="text-danger">@_recipientPhoneError</small>
                            }
                        </div>
                    }
                    <div class="card mb-2">
                        <div class="card-header p-2">
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _showVat = !_showVat">
                                @(_showVat ? "▾" : "▸") Cần hóa đơn VAT
                            </button>
                        </div>
                        @if (_showVat)
                        {
                            <div class="card-body p-2">
                                <div class="form-group mb-2">
                                    <label>Mã số thuế *</label>
                                    <input class="form-control @FieldClass(_taxCodeError)" @bind="_order.TaxCode"
                                           placeholder="0101234567" />
                                    @if (!string.IsNullOrEmpty(_taxCodeError))
                                    {
                                        <small class="text-danger">@_taxCodeError</small>
                                    }
                                </div>
                                <div class="form-group mb-1">
                                    <label>Tên công ty *</label>
                                    <input class="form-control @FieldClass(_companyNameError)" @bind="_order.CompanyName"
                                           placeholder="Công ty TNHH ..." />
                                    @if (!string.IsNullOrEmpty(_companyNameError))
                                    {
                                        <small class="text-danger">@_companyNameError</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @* Item 105: gift-wrap is feature-flagged. *@
                    @if (_giftWrapEnabled)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="gift-toggle"
                                   @bind="_order.IsGift" />
                            <label class="form-check-label" for="gift-toggle">
                                🎁 Gói quà (+@FormatPrice(_shopSettings.GiftFee))
                            </label>
                        </div>
                        @if (_order.IsGift)
                        {
                            <div class="form-group">
                                <label>Lời nhắn trên thiệp</label>
                                <textarea class="form-control" @bind="_order.GiftMessage" rows="2"
                                          placeholder="Ví dụ: Chúc mừng sinh nhật!"></textarea>
                            </div>
                        }
                    }
                    <div class="form-group">
                        <label>@I18n.T("payment_method") *</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pm-cod"
                                   checked="@(_order.PaymentMethod == "Cod")" @onchange="@(() => _order.PaymentMethod = "Cod")" />
                            <label class="form-check-label" for="pm-cod">@I18n.T("pay_cod")</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pm-bank"
                                   checked="@(_order.PaymentMethod == "BankTransfer")" @onchange="@(() => _order.PaymentMethod = "BankTransfer")" />
                            <label class="form-check-label" for="pm-bank">@I18n.T("pay_bank")</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pm-momo"
                                   checked="@(_order.PaymentMethod == "MoMo")" @onchange="@(() => _order.PaymentMethod = "MoMo")" />
                            <label class="form-check-label" for="pm-momo">@I18n.T("pay_momo") <span class="badge badge-warning">TEST</span></label>
                        </div>
                        @* Item 140: wallet payment — shown when the balance covers the total. *@
                        @if (_walletBalance >= _estimatedTotal && _estimatedTotal > 0)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="pm-wallet"
                                       checked="@(_order.PaymentMethod == "Wallet")" @onchange="@(() => _order.PaymentMethod = "Wallet")" />
                                <label class="form-check-label" for="pm-wallet">
                                    💰 @I18n.T("pay_wallet") <small class="text-muted">(số dư @_walletBalance.ToString("N0") ₫)</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Đơn hàng của bạn</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Món</th><th class="text-center">SL</th><th class="text-right">Thành tiền</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in CartState.Items)
                            {
                                <tr @key="item.LineKey">
                                    <td>
                                        @item.ProductName
                                        @if (item.IsCombo)
                                        {
                                            <span class="badge badge-warning ml-1">COMBO</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.SizeName))
                                        {
                                            <br /><small class="text-muted">Size: @item.SizeName</small>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.ToppingNames))
                                        {
                                            <br /><small class="text-muted">Ăn kèm: @item.ToppingNames</small>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <br /><small class="text-info">📝 @item.Note</small>
                                        }
                                    </td>
                                    <td class="text-center" style="white-space: nowrap;">
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => ChangeQty(item, -1)" title="Bớt 1">−</button>
                                        <span class="mx-2">@item.Quantity</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => ChangeQty(item, 1)" title="Thêm 1">+</button>
                                    </td>
                                    <td class="text-right">@FormatPrice(item.LineTotal)</td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted" colspan="2">@I18n.T("subtotal")</td>
                                <td class="text-right text-muted">@FormatPrice(_subtotal)</td>
                            </tr>
                            @if (_activePromotion != null)
                            {
                                <tr>
                                    <td class="text-success" colspan="2">🏷 Khuyến mãi giờ vàng (@_activePromotion.Name) −@_activePromotion.DiscountPercent%</td>
                                    <td class="text-right text-success">−@FormatPrice(_promotionDiscountPreview)</td>
                                </tr>
                            }
                            @if (_discountAmount > 0)
                            {
                                <tr>
                                    <td class="text-success" colspan="2">Giảm giá (@_appliedCode)</td>
                                    <td class="text-right text-success">−@FormatPrice(_discountAmount)</td>
                                </tr>
                            }
                            @if (_isFreeship)
                            {
                                <tr>
                                    <td class="text-success" colspan="2">🚚 Miễn phí ship (@_appliedCode)</td>
                                    <td class="text-right text-success">−@FormatPrice(_shopSettings.DeliveryFee)</td>
                                </tr>
                            }
                            @if (_tierDiscountPreview > 0)
                            {
                                <tr>
                                    <td class="text-success" colspan="2">Ưu đãi hạng @_loyalty.Tier (@_loyalty.TierDiscountPercent%)</td>
                                    <td class="text-right text-success">−@FormatPrice(_tierDiscountPreview)</td>
                                </tr>
                            }
                            @if (_redeemDiscountPreview > 0)
                            {
                                <tr>
                                    <td class="text-success" colspan="2">Đổi @_redeemPoints điểm</td>
                                    <td class="text-right text-success">−@FormatPrice(_redeemDiscountPreview)</td>
                                </tr>
                            }
                            @if (_giftFeePreview > 0)
                            {
                                <tr>
                                    <td class="text-muted" colspan="2">🎁 Phí gói quà</td>
                                    <td class="text-right text-muted">+@FormatPrice(_giftFeePreview)</td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted" colspan="2">
                                    Phí giao hàng
                                    @if (_fulfillment == "Pickup")
                                    {
                                        <small class="d-block text-success">Tự đến lấy — miễn phí</small>
                                    }
                                    else if (_fee > 0 && _shopSettings.FreeShipThreshold > 0)
                                    {
                                        <small class="d-block">Miễn phí cho đơn từ @FormatPrice(_shopSettings.FreeShipThreshold)</small>
                                    }
                                </td>
                                <td class="text-right @(_fee == 0 ? "text-success" : null)">
                                    @(_fee == 0 ? "Miễn phí" : FormatPrice(_fee))
                                </td>
                            </tr>
                            @if (_fulfillment == "Delivery" && !string.IsNullOrEmpty(_etaText))
                            {
                                <tr>
                                    <td colspan="3" class="text-muted"><small>⏱️ @_etaText</small></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2"><strong>@I18n.T("total")</strong></td>
                                <td class="text-right"><strong class="text-danger">@FormatPrice(_grandTotal)</strong></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="form-group">
                        <label>Mã giảm giá</label>
                        <div class="input-group">
                            <input class="form-control" @bind="_discountCodeInput" placeholder="Nhập mã (nếu có)"
                                   disabled="@_applyingDiscount" />
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" @onclick="ApplyDiscount" disabled="@_applyingDiscount">
                                    @(_applyingDiscount ? "Đang kiểm tra..." : "Áp dụng")
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_discountMessage))
                        {
                            <small class="@(_discountAmount > 0 ? "text-success" : "text-danger")">@_discountMessage</small>
                        }
                    </div>

                    @if (_loyalty != null)
                    {
                        <div class="alert alert-light border py-2">
                            <small>
                                ⭐ Bạn có <strong>@_loyalty.Points điểm</strong>
                                <span class="badge badge-info ml-1">Hạng @_loyalty.Tier</span>
                                @if (!string.IsNullOrWhiteSpace(_loyalty.ReferralCode))
                                {
                                    <span class="d-block mt-1">
                                        Mã giới thiệu của bạn: <strong>@_loyalty.ReferralCode</strong>
                                        <small class="text-muted">(bạn bè dùng mã này, cả hai cùng được +@_shopSettings.ReferralBonusPoints điểm)</small>
                                    </span>
                                }
                            </small>
                            @if (_loyalty.Points >= _shopSettings.PointsRedeemUnit && _shopSettings.PointsRedeemUnit > 0)
                            {
                                <div class="input-group input-group-sm mt-2">
                                    <input type="number" class="form-control" @bind="_redeemPointsInput"
                                           min="0" max="@_loyalty.Points" step="@_shopSettings.PointsRedeemUnit"
                                           placeholder="Số điểm muốn đổi" />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-success" @onclick="ApplyRedeem">Đổi điểm</button>
                                    </div>
                                </div>
                                <small class="text-muted">@_shopSettings.PointsRedeemUnit điểm = @FormatPrice(_shopSettings.PointsRedeemValue)</small>
                                @if (!string.IsNullOrEmpty(_redeemMessage))
                                {
                                    <small class="d-block @(_redeemDiscountPreview > 0 ? "text-success" : "text-danger")">@_redeemMessage</small>
                                }
                            }
                        </div>
                    }

                    @* Item 105: referrals are feature-flagged. *@
                    @if (_referralsEnabled)
                    {
                        <div class="form-group">
                            <label>Mã giới thiệu <small class="text-muted">(nếu có)</small></label>
                            <input class="form-control" @bind="_order.ReferralCode" placeholder="VD: PT-AB12CD" />
                        </div>
                    }

                    @if (_depositPreview > 0)
                    {
                        <div class="alert alert-warning py-2">
                            <small>
                                💰 Đơn chuyển khoản từ @FormatPrice(_shopSettings.DepositThreshold) cần đặt cọc trước:
                                <strong>@FormatPrice(_depositPreview)</strong> (@_shopSettings.DepositPercent%).
                                Shop sẽ liên hệ xác nhận cọc.
                            </small>
                        </div>
                    }

                    <button class="btn btn-success btn-block btn-lg" @onclick="PlaceOrder" disabled="@(_submitting || _minOrderBlocked || _orderingBlocked)">
                        @(_submitting ? "Đang xử lý..." : I18n.T("order_now"))
                    </button>
                    @if (_orderingBlocked && !string.IsNullOrEmpty(_closedNotice))
                    {
                        <div class="alert alert-warning mt-2 mb-0">🔴 @_closedNotice</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CreateOrderModel _order = new CreateOrderModel();
    private PlacedOrderModel _placedOrder;

    // Item 91: happy-hour promotion auto-applied by the server.
    private PhuThuongStickyRice.Web.Components.Admin.Models.PromotionModel _activePromotion;
    private decimal _promotionDiscountPreview =>
        _activePromotion != null ? Math.Round(_subtotal * _activePromotion.DiscountPercent / 100, 0) : 0;
    private BankTransferInfoModel _bankInfo;
    private ShopSettingModel _shopSettings = new ShopSettingModel();
    private bool _submitting;
    private bool _markingTransferred;
    private bool _payingMoMo;
    private bool _minOrderBlocked;

    /// <summary>
    /// Wave 6b (item 30): true when the shop paused orders or is outside
    /// open hours. Defense in depth — the server also rejects.
    /// </summary>
    private bool _orderingBlocked;

    private string _closedNotice;
    private string _error;

    // Fulfillment: "Delivery" or "Pickup".
    private string _fulfillment = "Delivery";

    // Wave 6a (item 23): delivery time slot — "now" (default) or "scheduled".
    private string _deliverySlotMode = "now";
    private string _selectedSlot;
    private System.Collections.Generic.List<string> _deliverySlots = new System.Collections.Generic.List<string>();
    private string _slotError;

    // Per-field validation messages.
    private string _nameError;
    private string _phoneError;
    private string _emailError;
    private string _addressError;
    private string _recipientNameError;
    private string _recipientPhoneError;
    private string _taxCodeError;
    private string _companyNameError;

    // Recipient / VAT / gift.
    private bool _orderForSomeoneElse;
    private bool _showVat;

    // Item 105: feature flags (UI gating; backend enforces too).
    private bool _giftWrapEnabled = true;
    private bool _referralsEnabled = true;
    private bool _luckySpinEnabled = true;

    // Item 109: branch selection.
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel> _branches;
    private Guid? _branchId;

    // Item 119: address book.
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.AddressBookModel> _addresses;
    private bool _savingAddress;
    private string _addressSavedMessage;

    // Item 120: freeship voucher state.
    private bool _isFreeship;

    // Loyalty.
    private LoyaltyAccountModel _loyalty;
    private int _redeemPointsInput;
    private int _redeemPoints;
    private string _redeemMessage;

    // Lucky spin.
    private static readonly string[] _spinSegments = { "5%", "10%", "15%", "Miễn ship", "20k", "May mắn" };
    private static readonly string[] _spinSegmentKeys = { "Percent5", "Percent10", "Percent15", "FreeShip", "Cash20k", "Miss" };
    private string _wheelStyle = string.Empty;
    private SpinResultModel _spinResult;
    private bool _spinning;
    private string _spinError;

    // Address auto-fill from phone history.
    private LastOrderInfoModel _addressSuggestion;
    private string _suggestedPhone;

    // Discount state.
    private string _discountCodeInput;
    private string _appliedCode;
    private decimal _discountAmount;
    private string _discountMessage;
    private bool _applyingDiscount;

    private string _transferMessage;
    private string _transferError;
    private string _momoError;

    private decimal _subtotal => CartState.TotalAmount;

    private decimal _fee
    {
        get
        {
            if (_fulfillment == "Pickup")
            {
                return 0;
            }

            // Item 120: freeship vouchers zero the fee.
            if (_isFreeship)
            {
                return 0;
            }

            if (_shopSettings.DeliveryFee <= 0)
            {
                return 0;
            }

            var afterDiscount = _subtotal - _discountAmount;
            if (_shopSettings.FreeShipThreshold > 0 && afterDiscount >= _shopSettings.FreeShipThreshold)
            {
                return 0;
            }

            return _shopSettings.DeliveryFee;
        }
    }

    private decimal _grandTotal => Math.Max(0,
        _subtotal - _discountAmount - _tierDiscountPreview - _redeemDiscountPreview + _fee + _giftFeePreview);

    /// <summary>Item 140: estimated total used to gate the ví payment option.</summary>
    private decimal _estimatedTotal => _grandTotal;

    /// <summary>Item 140: wallet balance of the entered phone (0 = no ví option).</summary>
    private decimal _walletBalance;

    /// <summary>Membership-tier discount preview (auto-applied for recognized phones).</summary>
    private decimal _tierDiscountPreview =>
        _loyalty != null && _loyalty.TotalSpent > 0 && _loyalty.TierDiscountPercent > 0
            ? Math.Round((_subtotal - _discountAmount) * _loyalty.TierDiscountPercent / 100, 0)
            : 0;

    /// <summary>Loyalty-points redemption preview.</summary>
    private decimal _redeemDiscountPreview
    {
        get
        {
            var unit = _shopSettings.PointsRedeemUnit;
            var value = _shopSettings.PointsRedeemValue;
            if (_redeemPoints <= 0 || unit <= 0 || value <= 0)
            {
                return 0;
            }

            return (_redeemPoints / unit) * value;
        }
    }

    private decimal _giftFeePreview => _order.IsGift ? Math.Max(0, _shopSettings.GiftFee) : 0;

    /// <summary>Deposit preview for large bank-transfer orders.</summary>
    private decimal _depositPreview
    {
        get
        {
            if (_order.PaymentMethod != "BankTransfer" || _shopSettings.DepositThreshold <= 0)
            {
                return 0;
            }

            var total = _grandTotal;
            return total >= _shopSettings.DepositThreshold
                ? Math.Round(total * _shopSettings.DepositPercent / 100, 0)
                : 0;
        }
    }

    /// <summary>"Dự kiến giao trong 30–45 phút" from the shop setting.</summary>
    private string _etaText
    {
        get
        {
            var minutes = _shopSettings.EstimatedDeliveryMinutes;
            if (minutes <= 0)
            {
                return null;
            }

            var from = Math.Max(10, minutes - 15);
            return $"Dự kiến giao trong {from}–{minutes} phút";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shopSettings = await ShopSettingsService.GetAsync() ?? new ShopSettingModel();
        }
        catch (Exception)
        {
            _shopSettings = new ShopSettingModel();
        }

        // Item 91: happy-hour promotion preview (auto-applied server-side).
        try
        {
            _activePromotion = await Wave3Service.GetActivePromotionAsync();
        }
        catch (Exception)
        {
            _activePromotion = null;
        }

        // Item 105: feature flags (fail open — a status check must never
        // block checkout).
        try
        {
            var flags = await Wave4Service.GetFeatureFlagMapAsync();
            _giftWrapEnabled = GetFlag(flags, "gift-wrap", true);
            _referralsEnabled = GetFlag(flags, "referrals", true);
            _luckySpinEnabled = GetFlag(flags, "lucky-spin", true);
        }
        catch (Exception)
        {
        }

        // Item 109: active branches for the branch picker.
        try
        {
            _branches = await Wave4Service.GetActiveBranchesAsync();
        }
        catch (Exception)
        {
            _branches = new System.Collections.Generic.List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel>();
        }

        RefreshMinOrderState();
        // Wave 6b (item 30): pause/hours notice for the submit button.
        RefreshOrderingState();
        CartState.OnChange += OnCartChanged;
        I18n.OnChange += OnLangChanged;
        await I18n.InitializeAsync();

        // Wave 6a (item 23): 30-min delivery slots from today's open hours;
        // only future slots are offered.
        _deliverySlots = ShopHours.BuildSlots(_shopSettings.OpenTime, _shopSettings.CloseTime);
    }

    private static bool GetFlag(System.Collections.Generic.Dictionary<string, bool> flags, string key, bool fallback)
    {
        return flags != null && flags.TryGetValue(key, out var enabled) ? enabled : fallback;
    }

    /// <summary>Item 109: branch picker.</summary>
    private void OnBranchChanged(ChangeEventArgs e)
    {
        _branchId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null;
    }

    /// <summary>Item 119: address book — load saved addresses with the phone lookup.</summary>
    private async Task LoadAddressBookAsync(string phone)
    {
        try
        {
            _addresses = await Wave4Service.GetAddressesAsync(phone);
        }
        catch (Exception)
        {
            _addresses = new System.Collections.Generic.List<PhuThuongStickyRice.Web.Components.Admin.Models.AddressBookModel>();
        }
    }

    private void UseSavedAddress(PhuThuongStickyRice.Web.Components.Admin.Models.AddressBookModel address)
    {
        _order.CustomerAddress = address.Address;
        _addressError = null;
        _addressSavedMessage = null;
    }

    /// <summary>Item 119: save the current address under a quick label.</summary>
    private async Task SaveCurrentAddressAsync()
    {
        _addressSavedMessage = null;
        var phone = (_order.CustomerPhone ?? "").Trim();
        var address = (_order.CustomerAddress ?? "").Trim();
        if (!IsValidPhone(phone))
        {
            _addressSavedMessage = "Vui lòng nhập số điện thoại hợp lệ trước.";
            return;
        }

        if (string.IsNullOrWhiteSpace(address))
        {
            _addressSavedMessage = "Vui lòng nhập địa chỉ trước.";
            return;
        }

        _savingAddress = true;
        try
        {
            var label = "Địa chỉ " + ((_addresses?.Count ?? 0) + 1);
            await Wave4Service.SaveAddressAsync(phone, label, address);
            await LoadAddressBookAsync(phone);
            _addressSavedMessage = $"Đã lưu \"{label}\".";
        }
        catch (Exception ex)
        {
            _addressSavedMessage = "Không lưu được: " + ex.Message;
        }
        finally
        {
            _savingAddress = false;
        }
    }

    private void OnCartChanged()
    {
        RefreshMinOrderState();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Wave 6a (item 25): quantity steppers on the checkout order summary.
    /// Reducing to 0 removes the line; totals update live via OnCartChanged.
    /// </summary>
    private void ChangeQty(CartItemModel item, int delta)
    {
        CartState.UpdateQuantity(item.LineKey, item.Quantity + delta);
    }

    private void RefreshMinOrderState()
    {
        _minOrderBlocked = _shopSettings.MinOrderAmount > 0 && _subtotal < _shopSettings.MinOrderAmount;
    }

    /// <summary>
    /// Wave 6b (item 30): pause toggle + open-hours check for the checkout
    /// notice and the disabled submit button. Mirrors the server gate in
    /// OrderAppService.CreateAsync.
    /// </summary>
    private void RefreshOrderingState()
    {
        _orderingBlocked = false;
        _closedNotice = null;

        if (!_shopSettings.AcceptingOrders)
        {
            _orderingBlocked = true;
            _closedNotice = "Quán đang tạm ngừng nhận đơn. Vui lòng quay lại sau.";
            return;
        }

        if (!ShopHours.IsOpen(_shopSettings.OpenTime, _shopSettings.CloseTime))
        {
            var open = ShopHours.ParseOpen(_shopSettings.OpenTime);
            var close = ShopHours.ParseClose(_shopSettings.CloseTime);
            _orderingBlocked = true;
            _closedNotice = $"Quán chỉ nhận đơn từ {open.Hours}:{open.Minutes:D2} đến {close.Hours}:{close.Minutes:D2}. " +
                            "Vui lòng quay lại trong giờ mở cửa.";
        }
    }

    /// <summary>VietQR image URL built from the shop's bank config + this order.</summary>
    private string QrUrl
    {
        get
        {
            if (_bankInfo == null || _placedOrder == null)
            {
                return string.Empty;
            }

            var template = string.IsNullOrWhiteSpace(_bankInfo.QrTemplate) || _bankInfo.QrTemplate == "xxx"
                ? "compact2"
                : _bankInfo.QrTemplate;
            var amount = (long)_placedOrder.TotalAmount;
            return $"https://img.vietqr.io/image/{_bankInfo.BankId}-{_bankInfo.AccountNumber}-{template}.png"
                + $"?amount={amount}&addInfo={Uri.EscapeDataString(_placedOrder.OrderNumber)}"
                + $"&accountName={Uri.EscapeDataString(_bankInfo.AccountName ?? string.Empty)}";
        }
    }

    /// <summary>
    /// When the phone field loses focus, look up the last order for that
    /// phone and offer a one-click address fill.
    /// </summary>
    private async Task LookupLastOrderAsync()
    {
        _addressSuggestion = null;
        var phone = (_order.CustomerPhone ?? "").Trim();
        if (phone == _suggestedPhone || !IsValidPhone(phone))
        {
            return;
        }

        _suggestedPhone = phone;
        try
        {
            var info = await ShopService.GetLastOrderInfoAsync(phone);
            if (info != null && !string.IsNullOrWhiteSpace(info.CustomerAddress)
                && !string.Equals(info.CustomerAddress.Trim(), (_order.CustomerAddress ?? "").Trim(),
                    StringComparison.OrdinalIgnoreCase))
            {
                _addressSuggestion = info;
            }
        }
        catch (Exception)
        {
            // Best effort only — the form works fine without the suggestion.
        }

        // Item 119: address book for this phone.
        await LoadAddressBookAsync(phone);

        // Loyalty summary (points, tier, referral code) for the phone.
        try
        {
            _loyalty = await Wave2Service.GetLoyaltyByPhoneAsync(phone);
            _redeemPoints = 0;
            _redeemPointsInput = 0;
            _redeemMessage = null;
        }
        catch (Exception)
        {
            _loyalty = null;
        }

        // Item 140: wallet balance for this phone (enables the ví option).
        try
        {
            var wallet = await Wave5Service.GetWalletBalanceAsync(phone);
            _walletBalance = wallet?.Balance ?? 0;
        }
        catch (Exception)
        {
            _walletBalance = 0;
        }
    }

    private void UseSuggestedAddress()
    {
        if (_addressSuggestion == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_order.CustomerName))
        {
            _order.CustomerName = _addressSuggestion.CustomerName;
        }

        _order.CustomerAddress = _addressSuggestion.CustomerAddress;
        _addressError = null;
        _addressSuggestion = null;
    }

    private void DismissSuggestion()
    {
        _addressSuggestion = null;
    }

    private async Task ApplyDiscount()
    {
        _discountMessage = null;
        var code = (_discountCodeInput ?? "").Trim();
        if (string.IsNullOrEmpty(code))
        {
            _discountAmount = 0;
            _appliedCode = null;
            _isFreeship = false;
            _discountMessage = "Vui lòng nhập mã giảm giá.";
            return;
        }

        _applyingDiscount = true;
        try
        {
            var result = await DiscountService.ValidateAsync(code, _subtotal, _order.CustomerPhone);
            if (result.Valid)
            {
                _discountAmount = result.DiscountAmount;
                _appliedCode = code.ToUpperInvariant();
                _isFreeship = result.IsFreeship;
                _discountMessage = result.Message;
            }
            else
            {
                _discountAmount = 0;
                _appliedCode = null;
                _isFreeship = false;
                _discountMessage = result.Message;
            }
        }
        catch (Exception)
        {
            _discountAmount = 0;
            _appliedCode = null;
            _isFreeship = false;
            _discountMessage = "Không kiểm tra được mã giảm giá. Vui lòng thử lại.";
        }
        finally
        {
            _applyingDiscount = false;
            RefreshMinOrderState();
        }
    }

    private void ApplyRedeem()
    {
        _redeemMessage = null;
        var unit = _shopSettings.PointsRedeemUnit;
        var balance = _loyalty?.Points ?? 0;

        if (unit <= 0 || balance < unit)
        {
            _redeemPoints = 0;
            _redeemMessage = "Bạn chưa đủ điểm để đổi.";
            return;
        }

        var requested = _redeemPointsInput;
        if (requested < unit)
        {
            _redeemPoints = 0;
            _redeemMessage = $"Cần ít nhất {unit} điểm để đổi.";
            return;
        }

        if (requested > balance)
        {
            _redeemPoints = 0;
            _redeemMessage = $"Bạn chỉ có {balance} điểm.";
            return;
        }

        // Round down to whole steps.
        _redeemPoints = (requested / unit) * unit;
        _redeemMessage = $"Đổi {_redeemPoints} điểm → giảm {FormatPrice(_redeemDiscountPreview)}.";
    }

    private bool ValidateFields()
    {
        _nameError = string.IsNullOrWhiteSpace(_order.CustomerName) ? "Vui lòng nhập họ tên." : null;
        _phoneError = !IsValidPhone(_order.CustomerPhone) ? "Số điện thoại không đúng định dạng (VD: 0901234567)." : null;
        _emailError = !string.IsNullOrWhiteSpace(_order.CustomerEmail) && !IsValidEmail(_order.CustomerEmail)
            ? "Email không đúng định dạng. Bạn có thể để trống nếu không có email."
            : null;
        _addressError = _fulfillment == "Delivery" && string.IsNullOrWhiteSpace(_order.CustomerAddress)
            ? "Vui lòng nhập địa chỉ giao hàng."
            : null;
        _recipientNameError = _orderForSomeoneElse && string.IsNullOrWhiteSpace(_order.RecipientName)
            ? "Vui lòng nhập tên người nhận."
            : null;
        _recipientPhoneError = _orderForSomeoneElse && !IsValidPhone(_order.RecipientPhone)
            ? "SĐT người nhận không đúng định dạng."
            : null;
        _taxCodeError = _showVat && string.IsNullOrWhiteSpace(_order.TaxCode)
            ? "Vui lòng nhập mã số thuế."
            : null;
        _companyNameError = _showVat && string.IsNullOrWhiteSpace(_order.CompanyName)
            ? "Vui lòng nhập tên công ty."
            : null;
        // Wave 6a (item 23): a scheduled delivery needs a chosen slot.
        _slotError = _fulfillment == "Delivery" && _deliverySlotMode == "scheduled" && string.IsNullOrWhiteSpace(_selectedSlot)
            ? "Vui lòng chọn khung giờ giao hàng."
            : null;

        return _nameError == null && _phoneError == null && _emailError == null && _addressError == null
            && _recipientNameError == null && _recipientPhoneError == null
            && _taxCodeError == null && _companyNameError == null
            && _slotError == null;
    }

    private async Task PlaceOrder()
    {
        _error = null;
        _slotError = null;

        if (!ValidateFields())
        {
            _error = "Vui lòng kiểm tra lại các thông tin được đánh dấu.";
            return;
        }

        if (_minOrderBlocked)
        {
            _error = $"Đơn hàng tối thiểu {FormatPrice(_shopSettings.MinOrderAmount)}. Vui lòng thêm món vào giỏ.";
            return;
        }

        // Wave 6b (item 30): client-side guard; the server is the real gate.
        if (_orderingBlocked)
        {
            _error = _closedNotice ?? "Quán đang tạm ngừng nhận đơn.";
            return;
        }

        _submitting = true;
        try
        {
            _order.DiscountCode = _appliedCode;
            _order.FulfillmentMethod = _fulfillment;
            _order.RedeemPoints = _redeemPoints;
            _order.BranchId = _branchId;

            // Wave 6a (item 23): scheduled delivery slot; null = giao ngay.
            _order.DeliverySlot = _fulfillment == "Delivery" && _deliverySlotMode == "scheduled"
                ? _selectedSlot?.Trim()
                : null;

            // Item 133: order source captured at shop entry.
            _order.Source = CartState.Source;

            // Item 97: fresh idempotency key per submit attempt, kept in memory.
            _order.IdempotencyKey = Guid.NewGuid().ToString("D");

            // Item 96: reCAPTCHA v3 token when enabled in shop settings.
            _order.RecaptchaToken = null;
            if (!string.IsNullOrWhiteSpace(_shopSettings.RecaptchaSiteKey))
            {
                try
                {
                    _order.RecaptchaToken = await JSRuntime.InvokeAsync<string>(
                        "interop.recaptchaToken", _shopSettings.RecaptchaSiteKey);
                }
                catch (Exception)
                {
                    _order.RecaptchaToken = null;
                }
            }
            if (_fulfillment == "Pickup")
            {
                _order.CustomerAddress = null;
            }

            if (!_orderForSomeoneElse)
            {
                _order.RecipientName = null;
                _order.RecipientPhone = null;
            }

            if (!_showVat)
            {
                _order.TaxCode = null;
                _order.CompanyName = null;
            }

            if (!_order.IsGift)
            {
                _order.GiftMessage = null;
            }

            _order.Lines = CartState.Items
                .Select(x => new CreateOrderLineModel
                {
                    ProductId = x.ProductId,
                    Quantity = x.Quantity,
                    SizeOptionId = x.SizeOptionId,
                    ToppingIds = x.ToppingIds ?? new System.Collections.Generic.List<Guid>(),
                    IsCombo = x.IsCombo,
                    // Wave 6a (item 24): per-item note persists to the order line.
                    Note = x.Note
                })
                .ToList();

            _placedOrder = await ShopService.CreateOrderAsync(_order);
            CartState.Clear();
            CartState.OnChange -= OnCartChanged;

            if (_placedOrder.PaymentMethod == "BankTransfer")
            {
                try
                {
                    _bankInfo = await ShopService.GetBankTransferInfoAsync();
                }
                catch (Exception)
                {
                    // Bank info is nice-to-have here; the track-order page
                    // shows the same info. Fall back to the placeholder box.
                    _bankInfo = new BankTransferInfoModel();
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message.Contains("tối thiểu") || ex.Message.Contains("Mã")
                ? ex.Message
                : "Đặt hàng thất bại. Vui lòng kiểm tra lại thông tin và thử lại.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task MarkTransferred()
    {
        _transferMessage = null;
        _transferError = null;
        _markingTransferred = true;
        try
        {
            var updated = await ShopService.MarkTransferredAsync(_placedOrder.Id, _placedOrder.CustomerPhone);
            _placedOrder.PaymentStatus = updated.PaymentStatus;
            _transferMessage = "Đã ghi nhận bạn đã chuyển khoản. Shop sẽ xác nhận thanh toán sớm.";
        }
        catch (Exception)
        {
            _transferError = "Không ghi nhận được. Vui lòng thử lại hoặc liên hệ shop.";
        }
        finally
        {
            _markingTransferred = false;
        }
    }

    private async Task PayWithMoMo()
    {
        _momoError = null;
        _payingMoMo = true;
        try
        {
            var result = await ShopService.CreateMoMoPaymentAsync(_placedOrder.Id);
            Navigation.NavigateTo(result.PayUrl);
        }
        catch (Exception)
        {
            _momoError = "Không tạo được thanh toán MoMo. Vui lòng thử lại.";
        }
        finally
        {
            _payingMoMo = false;
        }
    }

    private static string FieldClass(string error) => string.IsNullOrEmpty(error) ? null : "is-invalid";

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");

    private static bool IsValidEmail(string email)
    {
        var at = email.IndexOf('@');
        if (at <= 0 || at != email.LastIndexOf('@'))
        {
            return false;
        }

        var dot = email.LastIndexOf('.');
        return dot > at + 1 && dot < email.Length - 1 && !email.Contains(" ");
    }

    /// <summary>Positions a wheel label at the center of its 60° segment, text kept upright.</summary>
    private static string SpinLabelStyle(int index)
    {
        var angle = index * 60 + 30;
        return $"transform: translate(-50%, -50%) rotate({angle}deg) translateY(-70px) rotate(-{angle}deg);";
    }

    private async Task DoSpin()
    {
        _spinError = null;
        _spinning = true;
        try
        {
            var result = await Wave2Service.SpinAsync(_placedOrder.Id, _placedOrder.CustomerPhone);
            _spinResult = result;
            _placedOrder.LuckySpinUsed = true;

            var index = Array.IndexOf(_spinSegmentKeys, result.Segment);
            if (index < 0)
            {
                index = _spinSegmentKeys.Length - 1;
            }

            // 6 full turns + land the pointer on the middle of the segment.
            var target = 6 * 360 + (360 - (index * 60 + 30));
            _wheelStyle = $"transform: rotate({target}deg);";
        }
        catch (Exception ex)
        {
            _spinError = ex.Message.Contains("đã được sử dụng")
                ? ex.Message
                : "Không quay được lúc này. Vui lòng thử lại.";
        }
        finally
        {
            _spinning = false;
        }
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartState.OnChange -= OnCartChanged;
        I18n.OnChange -= OnLangChanged;
    }
