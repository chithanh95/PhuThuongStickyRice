        }
        finally
        {
            _payingMoMo = false;
        }
    }

    private static string FieldClass(string error) => string.IsNullOrEmpty(error) ? null : "is-invalid";

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");

    /// <summary>Item 90: composes the taste-preference note for the order.</summary>
    private static string BuildTasteNote(CustomerProfileModel profile)
    {
        if (profile == null)
        {
            return null;
        }

        var parts = new System.Collections.Generic.List<string>();
        if (profile.TasteTags != null && profile.TasteTags.Count > 0)
        {
            parts.Add(string.Join(", ", profile.TasteTags));
        }

        if (!string.IsNullOrWhiteSpace(profile.TasteNote))
        {
            parts.Add(profile.TasteNote.Trim());
        }

        return parts.Count == 0 ? null : "Khẩu vị: " + string.Join(" — ", parts);
    }

    private static bool IsValidEmail(string email)
    {
        var at = email.IndexOf('@');
        if (at <= 0 || at != email.LastIndexOf('@'))
        {
            return false;
        }

        var dot = email.LastIndexOf('.');
        return dot > at + 1 && dot < email.Length - 1 && !email.Contains(" ");
    }

    /// <summary>Positions a wheel label at the center of its 60° segment, text kept upright.</summary>
    private static string SpinLabelStyle(int index)
    {
        var angle = index * 60 + 30;
        return $"transform: translate(-50%, -50%) rotate({angle}deg) translateY(-70px) rotate(-{angle}deg);";
    }

    private async Task DoSpin()
    {
        _spinError = null;
        _spinning = true;
        try
        {
            var result = await ShopEngagementService.SpinAsync(_placedOrder.Id, _placedOrder.CustomerPhone);
            _spinResult = result;
            _placedOrder.LuckySpinUsed = true;

            var index = Array.IndexOf(_spinSegmentKeys, result.Segment);
            if (index < 0)
            {
                index = _spinSegmentKeys.Length - 1;
            }

            // 6 full turns + land the pointer on the middle of the segment.
            var target = 6 * 360 + (360 - (index * 60 + 30));
            _wheelStyle = $"transform: rotate({target}deg);";
        }
        catch (Exception ex)
        {
            _spinError = ex.Message.Contains("đã được sử dụng")
                ? ex.Message
                : "Không quay được lúc này. Vui lòng thử lại.";
        }
        finally
        {
            _spinning = false;
        }
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

