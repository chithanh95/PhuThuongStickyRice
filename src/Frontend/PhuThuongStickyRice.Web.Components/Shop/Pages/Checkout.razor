    // Item 91: happy-hour promotion auto-applied by the server.
    private PhuThuongStickyRice.Web.Components.Admin.Models.PromotionModel _activePromotion;
    private decimal _promotionDiscountPreview =>
        _activePromotion != null ? Math.Round(_subtotal * _activePromotion.DiscountPercent / 100, 0) : 0;
    private BankTransferInfoModel _bankInfo;
    private ShopSettingModel _shopSettings = new ShopSettingModel();
    private bool _submitting;
    private bool _markingTransferred;
    private bool _payingMoMo;
    private bool _minOrderBlocked;

    /// <summary>
    /// Wave 6b (item 30): true when the shop paused orders or is outside
