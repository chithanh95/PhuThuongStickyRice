    private string _momoError;

    private decimal _subtotal => CartState.TotalAmount;

    private decimal _fee
    {
        // The shop does not deliver — both ShipperPickup and Pickup are
        // always free of delivery fee.
        get => 0;
    }

    private decimal _grandTotal => Math.Max(0,
        _subtotal - _promotionDiscountPreview - _discountAmount - _tierDiscountPreview - _redeemDiscountPreview + _fee + _giftFeePreview);

    /// <summary>Item 140: estimated total used to gate the ví payment option.</summary>
    private decimal _estimatedTotal => _grandTotal;

    /// <summary>Item 140: wallet balance of the entered phone (0 = no ví option).</summary>
    private decimal _walletBalance;

    /// <summary>Membership-tier discount preview (auto-applied for recognized phones).</summary>
    private decimal _tierDiscountPreview =>
        _loyalty != null && _loyalty.TotalSpent > 0 && _loyalty.TierDiscountPercent > 0
            ? Math.Round((_subtotal - _discountAmount) * _loyalty.TierDiscountPercent / 100, 0)
