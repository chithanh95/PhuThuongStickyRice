@page "/quen-mat-khau"
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<style>
    .auth-page {
        min-height: 100vh; width: 100%;
        background: #f8f8fb;
        display: flex; align-items: center; justify-content: center;
        padding: 40px 20px; margin: 0; box-sizing: border-box;
    }
    html.dark .auth-page { background: #1a1a2e; }
    .auth-card {
        background: #fff; border-radius: 8px;
        box-shadow: 0 2px 20px rgba(0,0,0,.08);
        padding: 40px 35px; width: 100%;
    }
    html.dark .auth-card { background: #262640; box-shadow: 0 2px 20px rgba(0,0,0,.4); }
    html.dark .auth-card label { color: #f0eef5 !important; }
    html.dark .auth-card h4 { color: #f0eef5 !important; }
    html.dark .auth-card .auth-sub { color: #a5a2bd !important; }
    html.dark .auth-card .text-muted { color: #a5a2bd !important; }
    html.dark .auth-card .form-control {
        background: #1e1e36; border-color: #4a4a6e; color: #f0eef5;
    }
    html.dark .auth-card .form-control::placeholder { color: #8a87a3; }
    .auth-steps { display: flex; justify-content: center; margin-bottom: 25px; }
    .auth-step {
        width: 32px; height: 32px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 14px;
        background: #e9ecef; color: #6c757d; margin: 0 6px;
    }
    .auth-step.active { background: #7a6fbe; color: #fff; }
    .auth-step.done { background: #34c38f; color: #fff; } /* UIUX-1019 A3: xanh success Lexa (trước #28a745 Bootstrap) */
    html.dark .auth-step { background: #2c2c4e; color: #a5a2bd; }
    html.dark .auth-step.active { background: #7a6fbe; color: #fff; }
    html.dark .auth-step.done { background: #34c38f; color: #fff; } /* UIUX-1019 A3: xanh success Lexa (trước #28a745 Bootstrap) */
    .auth-theme-btn {
        position: fixed; top: 16px; right: 16px; z-index: 1000;
        width: 40px; height: 40px; border-radius: 50%;
        border: 1px solid #e0e0e0; background: #fff; cursor: pointer; font-size: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }
    html.dark .auth-theme-btn { background: #262640; border-color: #3a3a58; }
    /* UIUX-1019 A3: gom style inline vào class (đồng bộ Lexa, dễ maintain) */
    .auth-wrap { width: 100%; max-width: 440px; }
    .auth-brand { text-align: center; margin-bottom: 20px; }
    .auth-brand-emoji { font-size: 36px; }
    .auth-brand-name { font-size: 26px; font-weight: 600; margin-left: 8px; vertical-align: middle; }
    .auth-title { text-align: center; color: #1a1a2e; font-weight: 600; font-size: 22px; margin-bottom: 5px; }
    .auth-sub { text-align: center; color: #5a6c7d; font-size: 14px; margin-bottom: 20px; }
    .auth-label { color: #1a1a2e; font-weight: 600; font-size: 14px; }
    .auth-btn { background: #7a6fbe; border-color: #7a6fbe; padding: 10px; }
    .auth-link { color: #7a6fbe; }
    .auth-link-btn { color: #7a6fbe; }
    /* UIUX run 16:48 - Agent2 Dark: nút "← Nhập lại SĐT" giữ #7a6fbe trên
       card dark #262640 (~3.4:1, dưới chuẩn 4.5:1) — không rule dark nào phủ
       (đã grep xác minh). Sáng lên #a49de0 (~5.6:1), đồng bộ convention
       `html.dark .auth-card .auth-link` của trang Đăng nhập. */
    html.dark .auth-card .auth-link-btn { color: #a49de0 !important; }
    .auth-otp-input { letter-spacing: 4px; font-weight: 700; font-size: 18px; }
    .auth-success-emoji { font-size: 40px; }
    html.dark .auth-brand-name { color: #f0eef5; }
</style>

<div class="auth-page">
    <button class="auth-theme-btn" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">
        @(_isDark ? "☀️" : "🌙")
    </button>
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="auth-brand-emoji">🍚</span>
                <span class="brand-name auth-brand-name">Xôi Phú Thượng</span>
            </div>
            <h4 class="auth-title">Quên mật khẩu?</h4>
            <p class="auth-sub">
                Nhập SĐT để nhận mã OTP đặt lại mật khẩu.
            </p>

            <div class="auth-steps">
                <div class="auth-step @(_step > 1 ? "done" : _step == 1 ? "active" : "")">1</div>
                <div class="auth-step @(_step > 2 ? "done" : _step == 2 ? "active" : "")">2</div>
                <div class="auth-step @(_step == 3 ? "done" : "")">3</div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }
            @if (!string.IsNullOrEmpty(_infoMessage))
            {
                <div class="alert alert-success py-2" role="status">@_infoMessage</div>
            }

            @if (_step == 1)
            {
                <div class="form-group">
                    <label class="auth-label" for="qmk-phone">Số điện thoại *</label>
                    <input id="qmk-phone" name="phone" autocomplete="tel" class="form-control" @bind="_phone" inputmode="tel" placeholder="Nhập số điện thoại (VD: 0901234567)" />
                    <small class="text-muted">Mã OTP sẽ được gửi qua SMS đến số này.</small>
                </div>
                <button class="btn btn-primary btn-block auth-btn"
                        @onclick="RequestOtpAsync" disabled="@_busy">
                    @(_busy ? "Đang gửi..." : "Gửi mã OTP")
                </button>
            }
            else if (_step == 2)
            {
                <div class="form-group">
                    <label class="auth-label" for="qmk-otp">Mã OTP *</label>
                    <input id="qmk-otp" name="otp" autocomplete="one-time-code" class="form-control text-center auth-otp-input" @bind="_otp" inputmode="numeric" placeholder="Nhập mã 6 số"
                           maxlength="6" />
                    <small class="text-muted">Mã có hiệu lực 5 phút. Không nhận được? <a href="javascript:void(0)" class="auth-link" @onclick="RequestOtpAsync">Gửi lại</a></small>
                </div>
                <div class="form-group">
                    <label class="auth-label" for="qmk-pass">Mật khẩu mới * <small class="text-muted">(ít nhất 6 ký tự)</small></label>
                    <input id="qmk-pass" name="new-password" autocomplete="new-password" type="password" class="form-control" @bind="_newPassword" placeholder="Nhập mật khẩu mới" />
                </div>
                <div class="form-group">
                    <label class="auth-label" for="qmk-pass2">Nhập lại mật khẩu mới *</label>
                    <input id="qmk-pass2" name="new-password-confirm" autocomplete="new-password" type="password" class="form-control" @bind="_confirmPassword" placeholder="Nhập lại mật khẩu mới" />
                </div>
                <button class="btn btn-primary btn-block auth-btn"
                        @onclick="ResetPasswordAsync" disabled="@_busy">
                    @(_busy ? "Đang xử lý..." : "Đặt lại mật khẩu")
                </button>
                <button class="btn btn-link btn-block mt-2 auth-link-btn" @onclick="() => _step = 1">← Nhập lại SĐT</button>
            }
            else
            {
                <div class="alert alert-success text-center" role="status">
                    <div class="auth-success-emoji">✅</div>
                    <div class="mt-2"><strong>Đặt lại mật khẩu thành công!</strong></div>
                    <a href="/dang-nhap" class="auth-link font-weight-bold">Đăng nhập ngay →</a>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a href="/dang-nhap" class="text-muted small">← Về đăng nhập</a>
        </div>
        <p class="text-center text-muted small mt-3 mb-0">© 2026 Xôi Phú Thượng</p>
    </div>
</div>

@code {
    private int _step = 1;
    private string _phone;
    private string _otp;
    private string _newPassword;
    private string _confirmPassword;
    private string _error;
    private string _infoMessage;
    private bool _busy;
    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _isDark = await JSRuntime.InvokeAsync<string>("ptGetTheme", "pt-theme-shop") == "dark"; } catch { }
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        try { _isDark = await JSRuntime.InvokeAsync<string>("ptToggleTheme", "pt-theme-shop") == "dark"; } catch { }
    }

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");

    private async Task RequestOtpAsync()
    {
        // Chặn bấm đúp "Gửi lại": 2 request song song -> OTP đầu bị vô hiệu
        // (mã sau ghi đè) + đốt 2/3 quota rate-limit 3 req/giờ.
        if (_busy) return;
        _error = null;
        _infoMessage = null;
        if (!IsValidPhone(_phone))
        {
            _error = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }

        _busy = true;
        try
        {
            await AuthService.RequestPasswordResetOtpAsync(_phone.Trim());
            _infoMessage = "Đã gửi mã OTP. Vui lòng kiểm tra SMS.";
            _step = 2;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetPasswordAsync()
    {
        // Chặn bấm đúp như RequestOtpAsync: nút disabled chỉ có hiệu lực
        // sau re-render, 2 request song song có thể đổi pass rồi báo lỗi OTP.
        if (_busy) return;
        _error = null;
        _infoMessage = null;
        if (string.IsNullOrWhiteSpace(_otp) || _otp.Trim().Length != 6)
        {
            _error = "Vui lòng nhập mã OTP 6 số.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6)
        {
            _error = "Mật khẩu mới phải có ít nhất 6 ký tự.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _error = "Mật khẩu nhập lại không khớp.";
            return;
        }

        _busy = true;
        try
        {
            await AuthService.ResetPasswordWithOtpAsync(_phone.Trim(), _otp.Trim(), _newPassword);
            _step = 3;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Đặt lại mật khẩu thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }
}
