@page "/dang-nhap"
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Authorization
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject AuthService AuthService
@inject ITokenStore TokenStore
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime


<div class="auth-page">
    <button class="auth-theme-btn" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">
        @(_isDark ? "🌙" : "☀️")
    </button>
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="auth-brand-emoji">🍚</span>
                <span class="brand-name auth-brand-name">Xôi Phú Thượng</span>
            </div>
            <h4 class="auth-title">
                @(_tab == "login" ? "Chào mừng trở lại!" : "Tạo tài khoản mới")
            </h4>
            <p class="auth-sub">
                @(_tab == "login" ? "Đăng nhập để đặt xôi nhanh hơn." : "Đăng ký để đặt xôi nhanh hơn.")
            </p>

            <div class="auth-tabs" role="tablist" aria-label="Chọn chức năng tài khoản" @onkeydown="OnTablistKeyDown">
                @* A11y-1019: tab gắn với panel qua aria-controls — trước đây tablist
                   không có tabpanel, trình đọc màn hình không liên kết được nội dung
                   form với tab đã chọn. *@
                @* A11y-20261020: phím ←/→ chuyển tab theo ARIA tabs pattern — người
                   dùng bàn phím không cần Tab ra vào từng nút. *@
                <button type="button" role="tab" id="dn-tab-login" aria-controls="dn-panel-login" aria-selected="@(_tab == "login")" class="auth-tab @(_tab == "login" ? "active" : "")" @onclick='() => _tab = "login"'>Đăng nhập</button>
                <button type="button" role="tab" id="dn-tab-register" aria-controls="dn-panel-register" aria-selected="@(_tab == "register")" class="auth-tab @(_tab == "register" ? "active" : "")" @onclick='() => _tab = "register"'>Đăng ký</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }
            @if (!string.IsNullOrEmpty(_infoMessage))
            {
                <div class="alert alert-success py-2" role="status">@_infoMessage</div>
            }

            @if (_tab == "login")
            {
                <div role="tabpanel" id="dn-panel-login" aria-labelledby="dn-tab-login">
                <div class="form-group">
                    <label class="auth-label" for="dn-login-phone">Số điện thoại</label>
                    <input id="dn-login-phone" name="phone" autocomplete="tel" class="form-control" @bind="_phone" inputmode="tel" placeholder="Nhập số điện thoại (VD: 0901234567)" />
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-login-pass">Mật khẩu</label>
                    <input id="dn-login-pass" name="password" autocomplete="current-password" type="password" class="form-control" @bind="_password" placeholder="Nhập mật khẩu"
                           @onkeyup="OnLoginKeyUp" />
                </div>
                <button class="btn btn-primary btn-block auth-btn"
                        @onclick="LoginAsync" disabled="@_busy">
                    @(_busy ? "Đang xử lý..." : "Đăng nhập")
                </button>
                <div class="text-center mt-3">
                    <a href="/quen-mat-khau" class="auth-link">🔒 Quên mật khẩu?</a>
                </div>
                </div>
            }
            else
            {
                <div role="tabpanel" id="dn-panel-register" aria-labelledby="dn-tab-register">
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-name">Họ tên</label>
                    <input id="dn-reg-name" name="fullname" autocomplete="name" class="form-control" @bind="_fullName" placeholder="Nhập họ tên" />
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-phone">Số điện thoại *</label>
                    <input id="dn-reg-phone" name="phone" autocomplete="tel" class="form-control" @bind="_phone" inputmode="tel" placeholder="Nhập số điện thoại (VD: 0901234567)" />
                    <small class="text-muted">Dùng số điện thoại để đăng nhập những lần sau.</small>
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-pass">Mật khẩu * <small class="text-muted">(ít nhất 6 ký tự)</small></label>
                    <input id="dn-reg-pass" name="new-password" autocomplete="new-password" type="password" class="form-control" @bind="_password" placeholder="Nhập mật khẩu" />
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-pass2">Nhập lại mật khẩu *</label>
                    <input id="dn-reg-pass2" name="new-password-confirm" autocomplete="new-password" type="password" class="form-control" @bind="_confirmPassword" placeholder="Nhập lại mật khẩu" />
                </div>
                <button class="btn btn-primary btn-block auth-btn"
                        @onclick="RegisterAsync" disabled="@_busy">
                    @(_busy ? "Đang xử lý..." : "Đăng ký")
                </button>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a href="/" class="text-muted small">← Về trang chủ</a>
        </div>
        <p class="text-center text-muted small mt-3 mb-0">© 2026 Xôi Phú Thượng</p>
    </div>
</div>

@code {
    private string _tab = "login";

    /// <summary>
    /// A11y: điều hướng tab "Đăng nhập/Đăng ký" bằng phím ←/→ theo ARIA tabs
    /// pattern. Keydown đặt trên tablist, bubble từ nút đang focus.
    /// </summary>
    private void OnTablistKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight" || e.Key == "ArrowLeft")
            _tab = _tab == "login" ? "register" : "login";
    }
    private string _phone;
    private string _password;
    private string _confirmPassword;
    private string _fullName;
    private string _error;
    private string _infoMessage;
    private bool _busy;
    private string _returnUrl;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = GetQueryValue(Navigation.Uri, "returnUrl");
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(SafeReturnUrl(_returnUrl));
            }
        }
        catch (Exception)
        {
            // Bỏ qua lỗi khi đọc trạng thái đăng nhập có chủ ý: nếu auth check lỗi,
            // user chỉ đơn giản ở lại trang đăng nhập — không chặn hiển thị form.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Đồng bộ icon dark/light với theme đã lưu: nếu JS chưa sẵn sàng (prerender) thì giữ
            // mặc định, không ảnh hưởng chức năng đăng nhập/đăng ký.
            try { _isDark = await JSRuntime.InvokeAsync<bool>("ptIsDark", "pt-theme-shop"); } catch { }
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        // 2026-10-19: toggle NHỊ PHÂN Sáng↔Tối — 1 lần bấm = đổi giao diện ngay
        // (ptToggleTheme xoay vòng 3 chế độ khiến ban đêm bấm chỉ đổi icon mà màn vẫn đen).
        // _isDark chỉ dùng để vẽ icon nút bấm — nếu interop lỗi (JS chưa load) thì giữ nguyên, không báo user.
        try
        {
            _isDark = !_isDark;
            await JSRuntime.InvokeVoidAsync("ptSetTheme", "pt-theme-shop", _isDark ? "dark" : "light");
        }
        catch { }
    }


    private async Task OnLoginKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoginAsync();
        }
    }

    private async Task LoginAsync()
    {
        // Chặn bấm đúp / Enter 2 lần nhanh: nút disabled chỉ có hiệu lực sau
        // re-render, trong khi handler vẫn chạy song song -> 2 request login.
        if (_busy) return;
        _error = null;
        _infoMessage = null;
        if (!PhoneValidation.IsValidVnPhone(_phone))
        {
            _error = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_password))
        {
            _error = "Vui lòng nhập mật khẩu.";
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.LoginAsync(_phone, _password);
            await FinishAuthAsync(result);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        // Chặn submit đúp như LoginAsync: 2 request song song có thể tạo
        // đăng ký trùng SĐT (lần 1 thành công, lần 2 báo lỗi khó hiểu).
        if (_busy) return;
        _error = null;
        _infoMessage = null;
        if (!PhoneValidation.IsValidVnPhone(_phone))
        {
            _error = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 6)
        {
            _error = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }
        if (_password != _confirmPassword)
        {
            _error = "Mật khẩu nhập lại không khớp.";
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.RegisterAsync(_phone, _password, _fullName);
            await FinishAuthAsync(result);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinishAuthAsync(CustomerAuthResult result)
    {
        if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
        {
            _error = "Đăng nhập thất bại. Vui lòng thử lại.";
            return;
        }

        await TokenStore.StoreTokenAsync(result.AccessToken, result.ExpiresAt);
        // Reload so the JWT auth state provider picks up the new token.
        Navigation.NavigateTo(SafeReturnUrl(_returnUrl), forceLoad: true);
    }

    private static string SafeReturnUrl(string returnUrl) =>
        IsLocalUrl(returnUrl) ? returnUrl : "/tai-khoan";

    /// <summary>
    /// Chặn open redirect: chỉ chấp nhận URL nội bộ (bắt đầu bằng "/" đơn,
    /// không phải "//" hay "http"). Link /dang-nhap?returnUrl=https://evil.com
    /// của attacker sẽ bị ép về "/tai-khoan".
    /// </summary>
    private static bool IsLocalUrl(string url) =>
        !string.IsNullOrWhiteSpace(url)
        && url.StartsWith("/", StringComparison.Ordinal)
        && !url.StartsWith("//", StringComparison.Ordinal)
        && !url.StartsWith("/\\", StringComparison.Ordinal);

    private static string GetQueryValue(string uri, string key)
    {
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return null;
        }

        // bug-hunt 2026-10-20: query chứa % sai định dạng (vd /dang-nhap?returnUrl=%zz)
        // làm Uri.UnescapeDataString ném UriFormatException → OnInitializedAsync
        // nổ → trắng trang. Cùng pattern đã fix ở Shop.razor/Cart/TrackOrder:
        // URL hỏng thì bỏ qua êm (trả null) thay vì crash cả trang.
        try
        {
            return GetQueryValueCore(uri.Substring(question + 1), key);
        }
        catch (Exception)
        {
            return null;
        }
    }

    private static string GetQueryValueCore(string query, string key)
    {
        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            if (string.Equals(Uri.UnescapeDataString(pair.Substring(0, eq)), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
            }
        }

        return null;
    }
}
