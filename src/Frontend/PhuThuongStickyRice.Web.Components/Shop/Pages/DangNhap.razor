@page "/dang-nhap"
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Authorization
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject AuthService AuthService
@inject ITokenManager TokenManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<style>
    .auth-page {
        min-height: 100vh; width: 100%;
        background: #f8f8fb;
        display: flex; align-items: center; justify-content: center;
        padding: 40px 20px; margin: 0; box-sizing: border-box;
    }
    html.dark .auth-page { background: #1a1a2e; }
    .auth-card {
        background: #fff; border-radius: 8px;
        box-shadow: 0 2px 20px rgba(0,0,0,.08);
        padding: 40px 35px; width: 100%;
    }
    html.dark .auth-card { background: #262640; box-shadow: 0 2px 20px rgba(0,0,0,.4); }
    html.dark .auth-card label { color: #f0eef5 !important; }
    html.dark .auth-card h4 { color: #f0eef5 !important; }
    html.dark .auth-card .auth-sub { color: #a5a2bd !important; }
    html.dark .auth-card .text-muted { color: #a5a2bd !important; }
    html.dark .auth-card .form-control {
        background: #1e1e36; border-color: #4a4a6e; color: #f0eef5;
    }
    html.dark .auth-card .form-control::placeholder { color: #8a87a3; }
    .auth-tab {
        flex: 1; text-align: center; padding: 10px;
        font-weight: 600; font-size: 15px; color: #6c757d;
        background: transparent; border: none; border-bottom: 2px solid #e9ecef;
        cursor: pointer;
    }
    .auth-tab.active { color: #7a6fbe; border-bottom-color: #7a6fbe; }
    html.dark .auth-tab { color: #a5a2bd; border-bottom-color: #3a3a58; }
    html.dark .auth-tab.active { color: #fff; border-bottom-color: #7a6fbe; }
    .auth-theme-btn {
        position: fixed; top: 16px; right: 16px; z-index: 1000;
        width: 40px; height: 40px; border-radius: 50%;
        border: 1px solid #e0e0e0; background: #fff; cursor: pointer; font-size: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }
    html.dark .auth-theme-btn { background: #262640; border-color: #3a3a58; }
</style>

<div class="auth-page">
    <button class="auth-theme-btn" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">
        @(_isDark ? "☀️" : "🌙")
    </button>
    <div style="width:100%;max-width:440px;">
        <div class="auth-card">
            <div style="text-align:center;margin-bottom:20px;">
                <span style="font-size:36px;">🍚</span>
                <span style="font-size:26px;font-weight:600;color:#2b3a4a;margin-left:8px;vertical-align:middle;">Xôi Phú Thượng</span>
            </div>
            <h4 style="text-align:center;color:#1a1a2e;font-weight:600;font-size:22px;margin-bottom:5px;">
                @(_tab == "login" ? "Chào mừng trở lại!" : "Tạo tài khoản mới")
            </h4>
            <p class="auth-sub" style="text-align:center;color:#5a6c7d;font-size:14px;margin-bottom:25px;">
                @(_tab == "login" ? "Đăng nhập để đặt xôi nhanh hơn." : "Đăng ký để đặt xôi nhanh hơn.")
            </p>

            <div style="display:flex;margin-bottom:25px;">
                <button type="button" class="auth-tab @(_tab == "login" ? "active" : "")" @onclick='() => _tab = "login"'>Đăng nhập</button>
                <button type="button" class="auth-tab @(_tab == "register" ? "active" : "")" @onclick='() => _tab = "register"'>Đăng ký</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
            @if (!string.IsNullOrEmpty(_info))
            {
                <div class="alert alert-success py-2">@_info</div>
            }

            @if (_tab == "login")
            {
                <div class="form-group">
                    <label style="color:#1a1a2e;font-weight:600;font-size:14px;">Số điện thoại</label>
                    <input class="form-control" @bind="_phone" inputmode="tel" placeholder="Nhập số điện thoại (VD: 0901234567)" />
                </div>
                <div class="form-group">
                    <label style="color:#1a1a2e;font-weight:600;font-size:14px;">Mật khẩu</label>
                    <input type="password" class="form-control" @bind="_password" placeholder="Nhập mật khẩu"
                           @onkeyup="OnLoginKeyUp" />
                </div>
                <button class="btn btn-primary btn-block" style="background:#7a6fbe;border-color:#7a6fbe;padding:10px;"
                        @onclick="LoginAsync" disabled="@_busy">
                    @(_busy ? "Đang xử lý..." : "Đăng nhập")
                </button>
                <div class="text-center mt-3">
                    <a href="/quen-mat-khau" style="color:#7a6fbe;">🔒 Quên mật khẩu?</a>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label style="color:#1a1a2e;font-weight:600;font-size:14px;">Họ tên</label>
                    <input class="form-control" @bind="_fullName" placeholder="Nhập họ tên" />
                </div>
                <div class="form-group">
                    <label style="color:#1a1a2e;font-weight:600;font-size:14px;">Số điện thoại *</label>
                    <input class="form-control" @bind="_phone" inputmode="tel" placeholder="Nhập số điện thoại (VD: 0901234567)" />
                    <small class="text-muted">Dùng số điện thoại để đăng nhập những lần sau.</small>
                </div>
                <div class="form-group">
                    <label style="color:#1a1a2e;font-weight:600;font-size:14px;">Mật khẩu * <small class="text-muted">(ít nhất 6 ký tự)</small></label>
                    <input type="password" class="form-control" @bind="_password" placeholder="Nhập mật khẩu" />
                </div>
                <div class="form-group">
                    <label style="color:#1a1a2e;font-weight:600;font-size:14px;">Nhập lại mật khẩu *</label>
                    <input type="password" class="form-control" @bind="_confirmPassword" placeholder="Nhập lại mật khẩu" />
                </div>
                <button class="btn btn-primary btn-block" style="background:#7a6fbe;border-color:#7a6fbe;padding:10px;"
                        @onclick="RegisterAsync" disabled="@_busy">
                    @(_busy ? "Đang xử lý..." : "Đăng ký")
                </button>
            }
        </div>
        <div class="text-center mt-4">
            <a href="/" class="text-muted small">← Về trang chủ</a>
        </div>
        <p class="text-center text-muted small mt-3 mb-0">© 2026 Xôi Phú Thượng</p>
    </div>
</div>

@code {
    private string _tab = "login";
    private string _phone;
    private string _password;
    private string _confirmPassword;
    private string _fullName;
    private string _error;
    private string _info;
    private bool _busy;
    private string _returnUrl;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = GetQueryValue(Navigation.Uri, "returnUrl");
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(string.IsNullOrWhiteSpace(_returnUrl) ? "/tai-khoan" : _returnUrl);
            }
        }
        catch (Exception) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _isDark = await JSRuntime.InvokeAsync<string>("ptGetTheme") == "dark"; } catch { }
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        try { _isDark = await JSRuntime.InvokeAsync<string>("ptToggleTheme") == "dark"; } catch { }
    }

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");

    private async Task OnLoginKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoginAsync();
        }
    }

    private async Task LoginAsync()
    {
        _error = null;
        _info = null;
        if (!IsValidPhone(_phone))
        {
            _error = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_password))
        {
            _error = "Vui lòng nhập mật khẩu.";
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.LoginAsync(_phone, _password);
            await FinishAuthAsync(result);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        _error = null;
        _info = null;
        if (!IsValidPhone(_phone))
        {
            _error = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 6)
        {
            _error = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }
        if (_password != _confirmPassword)
        {
            _error = "Mật khẩu nhập lại không khớp.";
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.RegisterAsync(_phone, _password, _fullName);
            await FinishAuthAsync(result);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinishAuthAsync(CustomerAuthResult result)
    {
        if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
        {
            _error = "Đăng nhập thất bại. Vui lòng thử lại.";
            return;
        }

        await TokenManager.StoreTokenAsync(result.AccessToken, result.ExpiresAt);
        // Reload so the JWT auth state provider picks up the new token.
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(_returnUrl) ? "/tai-khoan" : _returnUrl, forceLoad: true);
    }

    private static string GetQueryValue(string uri, string key)
    {
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return null;
        }

        var query = uri.Substring(question + 1);
        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            if (string.Equals(Uri.UnescapeDataString(pair.Substring(0, eq)), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
            }
        }

        return null;
    }
}
