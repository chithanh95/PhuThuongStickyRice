@page "/dang-nhap"
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Authorization
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject AuthService AuthService
@inject ITokenStore TokenStore
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<style>
    .auth-page {
        min-height: 100vh; width: 100%;
        background: #f8f8fb;
        display: flex; align-items: center; justify-content: center;
        padding: 40px 20px; margin: 0; box-sizing: border-box;
    }
    html.dark .auth-page { background: #1a1a2e; }
    .auth-card {
        background: #fff; border-radius: 8px;
        box-shadow: 0 2px 20px rgba(0,0,0,.08);
        padding: 40px 35px; width: 100%;
    }
    html.dark .auth-card { background: #262640; box-shadow: 0 2px 20px rgba(0,0,0,.4); }
    html.dark .auth-card label { color: #f0eef5 !important; }
    html.dark .auth-card h4 { color: #f0eef5 !important; }
    html.dark .auth-card .auth-sub { color: #a5a2bd !important; }
    html.dark .auth-card .text-muted { color: #a5a2bd !important; }
    html.dark .auth-card .form-control {
        background: #1e1e36; border-color: #4a4a6e; color: #f0eef5;
    }
    html.dark .auth-card .form-control::placeholder { color: #8a87a3; }
    .auth-tab {
        flex: 1; text-align: center; padding: 10px;
        min-height: 48px; /* a11y (người cao tuổi): mục tiêu chạm ≥48px */
        font-weight: 600; font-size: 15px; color: #6c757d;
        background: transparent; border: none; border-bottom: 2px solid #e9ecef;
        cursor: pointer;
    }
    .auth-tab.active { color: #7a6fbe; border-bottom-color: #7a6fbe; }
    html.dark .auth-tab { color: #a5a2bd; border-bottom-color: #3a3a58; }
    html.dark .auth-tab.active { color: #fff; border-bottom-color: #7a6fbe; }
    .auth-theme-btn {
        position: fixed; top: 16px; right: 16px; z-index: 1000;
        width: 40px; height: 40px; border-radius: 50%;
        border: 1px solid #e0e0e0; background: #fff; cursor: pointer; font-size: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }
    html.dark .auth-theme-btn { background: #262640; border-color: #3a3a58; }
    /* UIUX-1019 A3: gom style inline vào class (đồng bộ Lexa, dễ maintain) */
    .auth-wrap { width: 100%; max-width: 440px; }
    .auth-brand { text-align: center; margin-bottom: 20px; }
    .auth-brand-emoji { font-size: 36px; }
    .auth-brand-name { font-size: 26px; font-weight: 600; margin-left: 8px; vertical-align: middle; }
    .auth-title { text-align: center; color: #1a1a2e; font-weight: 600; font-size: 22px; margin-bottom: 5px; }
    .auth-sub { text-align: center; color: #5a6c7d; font-size: 14px; margin-bottom: 25px; }
    .auth-tabs { display: flex; margin-bottom: 25px; }
    .auth-label { color: #1a1a2e; font-weight: 600; font-size: 14px; }
    .auth-btn { background: #7a6fbe; border-color: #7a6fbe; padding: 10px; }
    .auth-link { color: #7a6fbe; }
    /* a11y (WCAG 1.4.3): #7a6fbe trên nền card tối #262640 chỉ ~3:1 → #a49de0 (~5.6:1) */
    html.dark .auth-card .auth-link { color: #a49de0; }
    html.dark .auth-brand-name { color: #f0eef5; }
</style>

<div class="auth-page">
    <button class="auth-theme-btn" @onclick="ToggleTheme" title="Chế độ tối/sáng" aria-label="Chế độ tối/sáng">
        @(_isDark ? "☀️" : "🌙")
    </button>
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="auth-brand-emoji">🍚</span>
                <span class="brand-name auth-brand-name">Xôi Phú Thượng</span>
            </div>
            <h4 class="auth-title">
                @(_tab == "login" ? "Chào mừng trở lại!" : "Tạo tài khoản mới")
            </h4>
            <p class="auth-sub">
                @(_tab == "login" ? "Đăng nhập để đặt xôi nhanh hơn." : "Đăng ký để đặt xôi nhanh hơn.")
            </p>

            <div class="auth-tabs" role="tablist" aria-label="Chọn chức năng tài khoản">
                <button type="button" role="tab" aria-selected="@(_tab == "login")" class="auth-tab @(_tab == "login" ? "active" : "")" @onclick='() => _tab = "login"'>Đăng nhập</button>
                <button type="button" role="tab" aria-selected="@(_tab == "register")" class="auth-tab @(_tab == "register" ? "active" : "")" @onclick='() => _tab = "register"'>Đăng ký</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }
            @if (!string.IsNullOrEmpty(_info))
            {
                <div class="alert alert-success py-2" role="status">@_info</div>
            }

            @if (_tab == "login")
            {
                <div class="form-group">
                    <label class="auth-label" for="dn-login-phone">Số điện thoại</label>
                    <input id="dn-login-phone" name="phone" autocomplete="tel" class="form-control" @bind="_phone" inputmode="tel" placeholder="Nhập số điện thoại (VD: 0901234567)" />
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-login-pass">Mật khẩu</label>
                    <input id="dn-login-pass" name="password" autocomplete="current-password" type="password" class="form-control" @bind="_password" placeholder="Nhập mật khẩu"
                           @onkeyup="OnLoginKeyUp" />
                </div>
                <button class="btn btn-primary btn-block auth-btn"
                        @onclick="LoginAsync" disabled="@_busy">
                    @(_busy ? "Đang xử lý..." : "Đăng nhập")
                </button>
                <div class="text-center mt-3">
                    <a href="/quen-mat-khau" class="auth-link">🔒 Quên mật khẩu?</a>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-name">Họ tên</label>
                    <input id="dn-reg-name" name="fullname" autocomplete="name" class="form-control" @bind="_fullName" placeholder="Nhập họ tên" />
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-phone">Số điện thoại *</label>
                    <input id="dn-reg-phone" name="phone" autocomplete="tel" class="form-control" @bind="_phone" inputmode="tel" placeholder="Nhập số điện thoại (VD: 0901234567)" />
                    <small class="text-muted">Dùng số điện thoại để đăng nhập những lần sau.</small>
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-pass">Mật khẩu * <small class="text-muted">(ít nhất 6 ký tự)</small></label>
                    <input id="dn-reg-pass" name="new-password" autocomplete="new-password" type="password" class="form-control" @bind="_password" placeholder="Nhập mật khẩu" />
                </div>
                <div class="form-group">
                    <label class="auth-label" for="dn-reg-pass2">Nhập lại mật khẩu *</label>
                    <input id="dn-reg-pass2" name="new-password-confirm" autocomplete="new-password" type="password" class="form-control" @bind="_confirmPassword" placeholder="Nhập lại mật khẩu" />
                </div>
                <button class="btn btn-primary btn-block auth-btn"
                        @onclick="RegisterAsync" disabled="@_busy">
                    @(_busy ? "Đang xử lý..." : "Đăng ký")
                </button>
            }
        </div>
        <div class="text-center mt-4">
            <a href="/" class="text-muted small">← Về trang chủ</a>
        </div>
        <p class="text-center text-muted small mt-3 mb-0">© 2026 Xôi Phú Thượng</p>
    </div>
</div>

@code {
    private string _tab = "login";
    private string _phone;
    private string _password;
    private string _confirmPassword;
    private string _fullName;
    private string _error;
    private string _info;
    private bool _busy;
    private string _returnUrl;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = GetQueryValue(Navigation.Uri, "returnUrl");
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(SafeReturnUrl(_returnUrl));
            }
        }
        catch (Exception)
        {
            // Bỏ qua lỗi khi đọc trạng thái đăng nhập có chủ ý: nếu auth check lỗi,
            // user chỉ đơn giản ở lại trang đăng nhập — không chặn hiển thị form.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Đồng bộ icon dark/light với theme đã lưu: nếu JS chưa sẵn sàng (prerender) thì giữ
            // mặc định, không ảnh hưởng chức năng đăng nhập/đăng ký.
            try { _isDark = await JSRuntime.InvokeAsync<string>("ptGetTheme", "pt-theme-shop") == "dark"; } catch { }
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        // ptToggleTheme tự đổi class CSS ngay trong JS nên giao diện luôn đúng; _isDark chỉ dùng
        // để vẽ icon nút bấm — nếu interop lỗi (JS chưa load) thì giữ nguyên, không báo user.
        try { _isDark = await JSRuntime.InvokeAsync<string>("ptToggleTheme", "pt-theme-shop") == "dark"; } catch { }
    }

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");

    private async Task OnLoginKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoginAsync();
        }
    }

    private async Task LoginAsync()
    {
        _error = null;
        _info = null;
        if (!IsValidPhone(_phone))
        {
            _error = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_password))
        {
            _error = "Vui lòng nhập mật khẩu.";
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.LoginAsync(_phone, _password);
            await FinishAuthAsync(result);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        _error = null;
        _info = null;
        if (!IsValidPhone(_phone))
        {
            _error = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }
        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 6)
        {
            _error = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }
        if (_password != _confirmPassword)
        {
            _error = "Mật khẩu nhập lại không khớp.";
            return;
        }

        _busy = true;
        try
        {
            var result = await AuthService.RegisterAsync(_phone, _password, _fullName);
            await FinishAuthAsync(result);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Không kết nối được tới máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FinishAuthAsync(CustomerAuthResult result)
    {
        if (result == null || string.IsNullOrWhiteSpace(result.AccessToken))
        {
            _error = "Đăng nhập thất bại. Vui lòng thử lại.";
            return;
        }

        await TokenStore.StoreTokenAsync(result.AccessToken, result.ExpiresAt);
        // Reload so the JWT auth state provider picks up the new token.
        Navigation.NavigateTo(SafeReturnUrl(_returnUrl), forceLoad: true);
    }

    private static string SafeReturnUrl(string returnUrl) =>
        IsLocalUrl(returnUrl) ? returnUrl : "/tai-khoan";

    /// <summary>
    /// Chặn open redirect: chỉ chấp nhận URL nội bộ (bắt đầu bằng "/" đơn,
    /// không phải "//" hay "http"). Link /dang-nhap?returnUrl=https://evil.com
    /// của attacker sẽ bị ép về "/tai-khoan".
    /// </summary>
    private static bool IsLocalUrl(string url) =>
        !string.IsNullOrWhiteSpace(url)
        && url.StartsWith("/", StringComparison.Ordinal)
        && !url.StartsWith("//", StringComparison.Ordinal)
        && !url.StartsWith("/\\", StringComparison.Ordinal);

    private static string GetQueryValue(string uri, string key)
    {
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return null;
        }

        var query = uri.Substring(question + 1);
        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            if (string.Equals(Uri.UnescapeDataString(pair.Substring(0, eq)), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
            }
        }

        return null;
    }
}
