    /// <summary>
    /// Nút "Lưu thay đổi" — nút lưu DUY NHẤT của tab Hồ sơ (user chốt
    /// 2026-10-23: gộp thông tin + ngày sinh + khẩu vị + địa chỉ vào 1
    /// form, 1 lần bấm). Khẩu vị + ngày sinh cùng nằm trong 1 DTO hồ sơ
    /// nên chỉ 1 lần gọi UpdateAsync; ngày sinh trống/không đổi thì không
    /// chặn lưu (server chỉ xét khi ngày THẬT SỰ thay đổi). Panel địa chỉ
    /// đang mở thì lưu tiếp địa chỉ (service riêng — lời gọi thứ hai,
    /// lỗi của nó hiện ở vùng _addrError trong mục địa chỉ).
    /// </summary>
    private async Task SaveAllAsync()
    {
        await RunProfileSaveAsync(
            setBusy: b => _profileBusy = b,
            setMessage: (message, isSuccess) => { _profileMsg = message; _profileOk = isSuccess; },
            work: async () =>
            {
                _profile.TasteTags = _selectedTags.ToList();
                if (_dobValue.HasValue)
                {
                    // Chỉ lưu phần ngày (bỏ giờ).
                    _profile.DateOfBirth = _dobValue.Value.Date;
                }

                _profile = await CustomerProfileService.UpdateAsync(_profile);
                _selectedTags = new HashSet<string>(_profile.TasteTags ?? new List<string>());
                _dobValue = _profile.DateOfBirth;
            },
            successMessage: "Đã lưu thay đổi.",
            errorMessage: "Lưu thay đổi thất bại. Vui lòng thử lại.");

        if (_editing)
        {
            await SaveAddressAsync();
        }
    }

