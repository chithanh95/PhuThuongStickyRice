    /// <summary>
    /// Đổi mật khẩu: validate đủ 2 ô + tối thiểu 6 ký tự ở client trước khi
    /// gọi API để giảm request lỗi. Lỗi nghiệp vụ từ API (sai mật khẩu hiện
    /// tại) được ném dưới dạng InvalidOperationException nên hiện nguyên văn;
    /// lỗi khác hiện thông báo chung để không lộ chi tiết kỹ thuật.
    /// </summary>
    private async Task ChangePasswordAsync()
    {
        // Guard cứng chống bấm đúp ở đầu handler (tester A, 2026-10-22) —
        // không chỉ dựa vào disabled của nút như trước.
        if (_pwBusy) return;
        _pwError = null;
        _pwInfo = null;
        if (string.IsNullOrWhiteSpace(_currentPw) || string.IsNullOrWhiteSpace(_newPw))
        {
            _pwError = "Vui lòng nhập đủ mật khẩu hiện tại và mật khẩu mới.";
            return;
        }
        if (_newPw.Length < 6)
        {
            _pwError = "Mật khẩu mới phải có ít nhất 6 ký tự.";
            return;
        }

        _pwBusy = true;
        try
        {
            await AuthService.ChangePasswordAsync(_currentPw, _newPw);
            _pwInfo = "Đổi mật khẩu thành công.";
            _currentPw = _newPw = null;
        }
        catch (InvalidOperationException ex)
        {
            _pwError = ex.Message;
        }
        catch (Exception)
        {
            _pwError = "Đổi mật khẩu thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _pwBusy = false;
        }
    }

