@page "/tai-khoan"
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using PhuThuongStickyRice.Web.Components.Core.Services
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Shop.Models
@inject AuthService AuthService
@inject CustomerAddressService AddressService
@inject CustomerProfileService ProfileService
@inject ShopService ShopService
@inject CartState CartState
@inject CartSyncService CartSyncService
@inject ShopEngagementService ShopEngagementService
@inject ITokenStore TokenStore
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<TaiKhoan> Logger

<div class="container py-4 tk-page">
    <h3 class="tk-title">Tài khoản của tôi</h3>

    @if (!_checked)
    {
        <p class="text-muted"><em>Đang tải...</em></p>
    }
    else if (!_isAuthenticated)
    {
        <div class="alert alert-warning">
            Bạn cần <a href="/dang-nhap?returnUrl=%2Ftai-khoan">đăng nhập</a> để xem trang này.
        </div>
    }
    else
    {

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Thông tin cá nhân</h5>
                <p class="mb-1"><strong>Số điện thoại:</strong> @_userName</p>
                @if (!string.IsNullOrWhiteSpace(_email))
                {
                    <p class="mb-1"><strong>Email:</strong> @_email</p>
                }
                <p class="mb-0"><strong>Vai trò:</strong> @(string.Join(", ", _roles))</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">⭐ Hạng thành viên</h5>
                @if (_loyalty == null)
                {
                    <p class="text-muted"><em>Đang tải hạng thành viên...</em></p>
                }
                else
                {
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge tk-tier-badge @TierBadgeClass(_loyalty.Tier)">
                            @_loyalty.Tier
                        </span>
                        @if (_loyalty.TierDiscountPercent > 0)
                        {
                            <span class="text-success ml-2">Giảm @_loyalty.TierDiscountPercent.ToString("N0")% mỗi đơn</span>
                        }
                    </div>
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="h5 mb-0 text-primary">@_loyalty.Points.ToString("N0")</div>
                            <small class="text-muted">Điểm tích lũy</small>
                        </div>
                        <div class="col-4">
                            <div class="h5 mb-0">@_loyalty.TotalSpent.ToString("N0") ₫</div>
                            <small class="text-muted">Tổng đã mua</small>
                        </div>
                        <div class="col-4">
                            <div class="h5 mb-0">@_loyalty.TotalEarned.ToString("N0")</div>
                            <small class="text-muted">Tổng điểm đã kiếm</small>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        Hạng Bạc: từ 1.000.000₫ (giảm 2%) • Hạng Vàng: từ 5.000.000₫ (giảm 5%)
                    </small>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">🧾 Lịch sử đơn hàng</h5>
                @if (_orders == null)
                {
                    <p class="text-muted"><em>Đang tải lịch sử đơn hàng...</em></p>
                }
                else if (_orders.Count == 0)
                {
                    <p class="text-muted">Bạn chưa có đơn hàng nào. <a href="/shop">Đặt xôi ngay →</a></p>
                }
                else
                {
                    @foreach (var o in _orders.OrderByDescending(x => x.CreatedAt).Take(20))
                    {
                        <div class="border rounded p-3 mb-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@o.OrderNumber</strong>
                                    <span class="badge @OrderStatusBadge(o.Status) ml-2">@OrderStatusText(o.Status)</span>
                                </div>
                                <div class="text-right">
                                    <div class="font-weight-bold">@o.TotalAmount.ToString("N0") ₫</div>
                                    <small class="text-muted">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            <div class="mt-2">
                                <a href="/track-order?orderNumber=@Uri.EscapeDataString(o.OrderNumber)&phone=@Uri.EscapeDataString(_userName)"
                                   class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                                <button type="button" class="btn btn-sm btn-success ml-2"
                                        @onclick="() => ReorderAsync(o)" disabled="@_reorderBusy">
                                    @(_reorderBusy ? "Đang thêm..." : "🔁 Đặt lại")
                                </button>
                            </div>
                        </div>
                    }
                    @if (_orders.Count > 20)
                    {
                        <small class="text-muted">Hiển thị 20 đơn gần nhất (tổng @_orders.Count đơn).</small>
                    }
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">🍜 Khẩu vị của tôi</h5>
                <p class="text-muted small">Quán sẽ nhớ khẩu vị này và tự điền vào ghi chú mỗi lần bạn đặt hàng.</p>
                @if (!string.IsNullOrEmpty(_tasteMsg))
                {
                    <div class="alert @(_tasteOk ? "alert-success" : "alert-danger") py-2">@_tasteMsg</div>
                }
                <div class="mb-2">
                    @foreach (var tag in _tastePresets)
                    {
                        var currentTag = tag;
                        <button type="button"
                                class="btn btn-sm mr-2 mb-2 @(_selectedTags.Contains(currentTag) ? "btn-warning" : "btn-outline-secondary")"
                                aria-pressed="@_selectedTags.Contains(currentTag)"
                                @onclick="() => ToggleTag(currentTag)">@currentTag</button>
                    }
                </div>
                <div class="input-group mb-2 tk-form-narrow">
                    <input class="form-control" placeholder="Thêm khẩu vị khác..." aria-label="Thêm khẩu vị khác" @bind="_customTag" />
                    <div class="input-group-append">
                        <button class="btn btn-outline-primary" @onclick="AddCustomTag">Thêm</button>
                    </div>
                </div>
                <div class="form-group tk-form-narrow">
                    <label for="tk-taste-note">Ghi chú thêm</label>
                    <input id="tk-taste-note" class="form-control" @bind="_profile.TasteNote" placeholder="VD: xôi dẻo một chút" />
                </div>
                <button class="btn btn-primary"
                        @onclick="SaveTasteAsync" disabled="@_tasteBusy">
                    @(_tasteBusy ? "Đang lưu..." : "Lưu khẩu vị")
                </button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">🎂 Sinh nhật</h5>
                @if (!string.IsNullOrEmpty(_dobMsg))
                {
                    <div class="alert @(_dobOk ? "alert-success" : "alert-danger") py-2">@_dobMsg</div>
                }
                @if (!string.IsNullOrWhiteSpace(_profile.BirthdayGiftCode))
                {
                    <div class="alert alert-warning">
                        🎁 Quà sinh nhật năm nay của bạn: <strong>@_profile.BirthdayGiftCode</strong>
                        @if (_profile.BirthdayGiftAmount.HasValue)
                        {
                            <span> (giảm @_profile.BirthdayGiftAmount.Value.ToString("N0") ₫)</span>
                        }
                        @if (_profile.BirthdayGiftExpiresAt.HasValue)
                        {
                            <span> — HSD @_profile.BirthdayGiftExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        }
                        <div class="small mt-1">Nhập mã này ở bước thanh toán để được giảm giá.</div>
                    </div>
                }
                <div class="form-row align-items-end">
                    <div class="form-group col-md-6 mb-2">
                        <label for="tk-dob">Ngày sinh</label>
                        <input id="tk-dob" type="date" class="form-control" @bind="_dobValue" />
                        <small class="text-muted">
                            @(string.IsNullOrWhiteSpace(_profile.DateOfBirthChangeHint)
                                ? "Ngày sinh chỉ được thay đổi 1 lần mỗi năm."
                                : _profile.DateOfBirthChangeHint)
                        </small>
                    </div>
                    <div class="form-group col-md-6 mb-2">
                        <button class="btn btn-primary"
                                @onclick="SaveDobAsync" disabled="@(_dobBusy || !_profile.CanChangeDateOfBirth)">
                            @(_dobBusy ? "Đang lưu..." : "Lưu ngày sinh")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Đổi mật khẩu</h5>
                @if (!string.IsNullOrEmpty(_pwError))
                {
                    <div class="alert alert-danger">@_pwError</div>
                }
                @if (!string.IsNullOrEmpty(_pwInfo))
                {
                    <div class="alert alert-success">@_pwInfo</div>
                }
                <div class="form-group">
                    <label for="tk-current-pw">Mật khẩu hiện tại</label>
                    <input id="tk-current-pw" type="password" class="form-control" @bind="_currentPw" autocomplete="current-password" />
                </div>
                <div class="form-group">
                    <label for="tk-new-pw">Mật khẩu mới (ít nhất 6 ký tự)</label>
                    <input id="tk-new-pw" type="password" class="form-control" @bind="_newPw" autocomplete="new-password" />
                </div>
                <button class="btn btn-primary"
                        @onclick="ChangePasswordAsync" disabled="@_pwBusy">
                    @(_pwBusy ? "Đang đổi..." : "Đổi mật khẩu")
                </button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">📇 Địa chỉ đã lưu</h5>
                    <button class="btn btn-sm btn-outline-primary" @onclick="StartAdd">+ Thêm địa chỉ</button>
                </div>

                @if (!string.IsNullOrEmpty(_addrError))
                {
                    <div class="alert alert-danger">@_addrError</div>
                }

                @if (_editing)
                {
                    <div class="tk-addr-panel border rounded p-3 mb-3">
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label for="tk-addr-label">Tên gợi nhớ</label>
                                <input id="tk-addr-label" class="form-control" @bind="_form.Label" placeholder="Nhà, Công ty..." />
                            </div>
                            <div class="form-group col-md-8">
                                <label for="tk-addr-receiver">Tên người nhận *</label>
                                <input id="tk-addr-receiver" class="form-control" @bind="_form.ReceiverName" placeholder="Nguyễn Văn A" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="tk-addr-phone">SĐT người nhận *</label>
                                <input id="tk-addr-phone" class="form-control" @bind="_form.ReceiverPhone" inputmode="tel" placeholder="0901234567" />
                            </div>
                            <div class="form-group col-md-6">
                                <div class="form-check mt-4 pt-2">
                                    <input type="checkbox" class="form-check-input" id="addr-default" @bind="_form.IsDefault" />
                                    <label class="form-check-label" for="addr-default">Đặt làm mặc định</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="tk-addr-detail">Địa chỉ chi tiết *</label>
                            <input id="tk-addr-detail" class="form-control" @bind="_form.AddressDetail" placeholder="Số nhà, đường, phường/xã..." />
                        </div>
                        <div class="form-group">
                            <label for="tk-addr-note">Ghi chú</label>
                            <input id="tk-addr-note" class="form-control" @bind="_form.Note" placeholder="VD: gọi trước khi đến" />
                        </div>
                        <button class="btn btn-primary mr-2"
                                @onclick="SaveAddressAsync" disabled="@_addrBusy">
                            @(_addrBusy ? "Đang lưu..." : "Lưu địa chỉ")
                        </button>
                        <button class="btn btn-link" @onclick="CancelEdit">Hủy</button>
                    </div>
                }

                @if (_addresses == null)
                {
                    <p class="text-muted"><em>Đang tải địa chỉ...</em></p>
                }
                else if (_addresses.Count == 0 && !_editing)
                {
                    <p class="text-muted">Chưa có địa chỉ nào. Thêm địa chỉ để đặt hàng nhanh hơn.</p>
                }
                else
                {
                    @foreach (var address in _addresses)
                    {
                        <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-start">
                            <div>
                                <strong>
                                    @(!string.IsNullOrWhiteSpace(address.Label) ? address.Label + " — " : "")@address.ReceiverName
                                </strong>
                                @if (address.IsDefault)
                                {
                                    <span class="badge badge-success ml-1">Mặc định</span>
                                }
                                <div class="text-muted small">@address.ReceiverPhone</div>
                                <div>@address.AddressDetail</div>
                                @if (!string.IsNullOrWhiteSpace(address.Note))
                                {
                                    <div class="text-muted small"><em>@address.Note</em></div>
                                }
                            </div>
                            <div class="btn-group btn-group-sm">
                                @if (!address.IsDefault)
                                {
                                    <button class="btn btn-outline-secondary" title="Đặt mặc định" aria-label="Đặt làm địa chỉ mặc định" @onclick="() => SetDefaultAsync(address.Id)">★</button>
                                }
                                <button class="btn btn-outline-primary" @onclick="() => StartEdit(address)">Sửa</button>
                                <button class="btn btn-outline-danger" @onclick="() => DeleteAsync(address.Id)">Xóa</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <button class="btn btn-outline-secondary" @onclick="LogoutAsync">Đăng xuất</button>
    }
</div>

@code {
    private bool _checked;
    private bool _isAuthenticated;
    private string _userName;
    private string _email;
    private string[] _roles = System.Array.Empty<string>();

    private string _currentPw;
    private string _newPw;
    private string _pwError;
    private string _pwInfo;
    private bool _pwBusy;

    private List<CustomerAddressModel> _addresses;
    private bool _editing;
    private Guid _editingId;
    private CustomerAddressModel _form = new CustomerAddressModel();
    private string _addrError;
    private bool _addrBusy;

    // Item 90: taste preferences.
    private CustomerProfileModel _profile = new CustomerProfileModel();
    private readonly string[] _tastePresets = new[]
    {
        "Ít hành", "Nhiều hành", "Nhiều ruốc", "Ít ngọt",
        "Không cay", "Thêm dưa góp", "Ít mỡ", "Nhiều chả"
    };
    private HashSet<string> _selectedTags = new HashSet<string>();
    private string _customTag;
    private string _tasteMsg;
    private bool _tasteOk;
    private bool _tasteBusy;

    // Độ dài tối đa của 1 khẩu vị tự nhập (giao diện đơn giản cho khách lớn tuổi).
    private const int MaxCustomTagLength = 50;

    // Item 92: birthday.
    private DateTime? _dobValue;
    private string _dobMsg;
    private bool _dobOk;
    private bool _dobBusy;

    // Lịch sử đơn hàng + hạng thành viên.
    private LoyaltyAccountModel _loyalty;
    private List<TrackedOrderModel> _orders;
    private bool _reorderBusy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            if (_isAuthenticated)
            {
                _userName = authState.User.Identity.Name;
                _email = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                _roles = authState.User.FindAll(System.Security.Claims.ClaimTypes.Role)
                    .Select(c => c.Value).Distinct().ToArray();
                // Nhân viên (Admin/Cashier/Kitchen) dùng trang hồ sơ admin riêng
                if (_roles.Any(r => r == "Admin" || r == "Cashier" || r == "Kitchen"))
                {
                    Navigation.NavigateTo("/admin/ho-so", replace: true);
                    return;
                }
                // perf-hunt 2026-10-19: 4 read độc lập chạy song song (mỗi loader
                // fail-soft riêng như cũ, ghi field riêng). Riêng _addresses
                // giữ nguyên ngữ cảnh: lỗi ở đây vẫn rớt về catch ngoài như cũ.
                var addressesTask = AddressService.GetMineAsync();
                var profileTask = LoadProfileAsync();
                var loyaltyTask = LoadLoyaltyAsync();
                var ordersTask = LoadOrdersAsync();
                _addresses = await addressesTask;
                await Task.WhenAll(profileTask, loyaltyTask, ordersTask);

                // Item 137: đồng bộ giỏ hàng từ server (nếu có).
                // codequality-team 2026-10-20 run-0245 Agent3-BestPractices: ghi log
                // thay vì nuốt exception trong im lặng — vẫn fail-soft như cũ
                // (lỗi đồng bộ giỏ không được chặn luồng đăng nhập).
                try
                {
                    await CartSyncService.SyncOnLoginAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "TaiKhoan: đồng bộ giỏ hàng sau đăng nhập thất bại.");
                }
            }
        }
        catch (Exception)
        {
            _isAuthenticated = false;
        }
        finally
        {
            _checked = true;
        }
    }

    /// <summary>Tải hồ sơ khách (sở thích vị + ngày sinh) — lỗi thì dùng model trống.</summary>
    private async Task LoadProfileAsync()
    {
        // Item 90+92: load taste preferences + birthday.
        try
        {
            _profile = await ProfileService.GetMyAsync() ?? new CustomerProfileModel();
            _selectedTags = new HashSet<string>(_profile.TasteTags ?? new List<string>());
            _dobValue = _profile.DateOfBirth;
        }
        catch (Exception)
        {
            _profile = new CustomerProfileModel();
        }
    }

    /// <summary>Tải hạng thành viên theo SĐT đăng nhập — lỗi thì ẩn thẻ hạng.</summary>
    private async Task LoadLoyaltyAsync()
    {
        try
        {
            _loyalty = await ShopEngagementService.GetLoyaltyByPhoneAsync(_userName);
        }
        catch (Exception) { }
    }

    /// <summary>Tải lịch sử đơn hàng theo SĐT — lỗi thì hiện danh sách trống.</summary>
    private async Task LoadOrdersAsync()
    {
        try
        {
            _orders = await ShopService.GetOrdersByPhoneAsync(_userName) ?? new List<TrackedOrderModel>();
        }
        catch (Exception)
        {
            _orders = new List<TrackedOrderModel>();
        }
    }

    private async Task ChangePasswordAsync()
    {
        _pwError = null;
        _pwInfo = null;
        if (string.IsNullOrWhiteSpace(_currentPw) || string.IsNullOrWhiteSpace(_newPw))
        {
            _pwError = "Vui lòng nhập đủ mật khẩu hiện tại và mật khẩu mới.";
            return;
        }
        if (_newPw.Length < 6)
        {
            _pwError = "Mật khẩu mới phải có ít nhất 6 ký tự.";
            return;
        }

        _pwBusy = true;
        try
        {
            await AuthService.ChangePasswordAsync(_currentPw, _newPw);
            _pwInfo = "Đổi mật khẩu thành công.";
            _currentPw = _newPw = null;
        }
        catch (InvalidOperationException ex)
        {
            _pwError = ex.Message;
        }
        catch (Exception)
        {
            _pwError = "Đổi mật khẩu thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _pwBusy = false;
        }
    }

    private void StartAdd()
    {
        _editing = true;
        _editingId = Guid.Empty;
        _form = new CustomerAddressModel { ReceiverPhone = _userName };
        _addrError = null;
    }

    private void StartEdit(CustomerAddressModel address)
    {
        _editing = true;
        _editingId = address.Id;
        _form = new CustomerAddressModel
        {
            Id = address.Id,
            Label = address.Label,
            ReceiverName = address.ReceiverName,
            ReceiverPhone = address.ReceiverPhone,
            AddressDetail = address.AddressDetail,
            Note = address.Note,
            IsDefault = address.IsDefault
        };
        _addrError = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _addrError = null;
    }

    private async Task SaveAddressAsync()
    {
        // Guard chống double-tap: nút chỉ disabled="@_addrBusy" sau re-render,
        // tap đúp trước await đầu tiên sẽ gọi CreateAsync 2 lần → 2 địa chỉ trùng.
        if (_addrBusy) return;
        _addrError = null;
        if (string.IsNullOrWhiteSpace(_form.ReceiverName)
            || string.IsNullOrWhiteSpace(_form.ReceiverPhone)
            || string.IsNullOrWhiteSpace(_form.AddressDetail))
        {
            _addrError = "Vui lòng nhập tên người nhận, SĐT và địa chỉ.";
            return;
        }

        _addrBusy = true;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await AddressService.CreateAsync(_form);
            }
            else
            {
                await AddressService.UpdateAsync(_editingId, _form);
            }

            _editing = false;
            _addresses = await AddressService.GetMineAsync();
        }
        catch (Exception)
        {
            _addrError = "Lưu địa chỉ thất bại. Kiểm tra lại SĐT (VD: 0901234567).";
        }
        finally
        {
            _addrBusy = false;
        }
    }

    private async Task SetDefaultAsync(Guid id)
    {
        try
        {
            await AddressService.SetDefaultAsync(id);
            _addresses = await AddressService.GetMineAsync();
        }
        catch (Exception) { }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await AddressService.DeleteAsync(id);
            _addresses = await AddressService.GetMineAsync();
        }
        catch (Exception) { }
    }

    private async Task LogoutAsync()
    {
        try
        {
            await TokenStore.ClearTokenAsync();
        }
        catch (Exception) { }

        Navigation.NavigateTo("/", forceLoad: true);
    }

    /// <summary>
    /// Item 122: "Đặt lại" — thêm toàn bộ món của đơn cũ vào giỏ (kèm size/topping theo tên),
    /// rồi chuyển sang trang giỏ hàng.
    /// </summary>
    private void ReorderAsync(TrackedOrderModel order)
    {
        if (order?.Lines == null || order.Lines.Count == 0)
        {
            return;
        }

        _reorderBusy = true;
        try
        {
            foreach (var line in order.Lines.Where(l => l != null && l.Quantity > 0))
            {
                // Đơn giá đã bao gồm size/topping ở thời điểm đặt đơn.
                // SizeOptionId/ToppingIds không có trong lịch sử → dùng tên để hiển thị.
                CartState.AddConfigured(
                    line.ProductId,
                    line.ProductName,
                    productCode: null,
                    line.UnitPrice,
                    line.Quantity,
                    sizeOptionId: null,
                    line.SizeName,
                    toppingIds: new List<Guid>(),
                    line.ToppingNames,
                    line.ToppingsExtra,
                    line.IsCombo,
                    note: line.Note);
            }

            Navigation.NavigateTo("/cart");
        }
        finally
        {
            _reorderBusy = false;
        }
    }

    // Item 90: taste preferences.

    private void ToggleTag(string tag)
    {
        _tasteMsg = null;
        if (!_selectedTags.Add(tag))
        {
            _selectedTags.Remove(tag);
        }
    }

    private void AddCustomTag()
    {
        _tasteMsg = null;
        var tag = (_customTag ?? string.Empty).Trim();
        if (tag.Length == 0)
        {
            return;
        }

        if (tag.Length > MaxCustomTagLength)
        {
            _tasteMsg = $"Mỗi khẩu vị tối đa {MaxCustomTagLength} ký tự.";
            _tasteOk = false;
            return;
        }

        _selectedTags.Add(tag);
        _customTag = null;
    }

    private async Task SaveTasteAsync()
    {
        _tasteMsg = null;
        _tasteBusy = true;
        try
        {
            _profile.TasteTags = _selectedTags.ToList();
            _profile = await ProfileService.UpdateAsync(_profile);
            _selectedTags = new HashSet<string>(_profile.TasteTags ?? new List<string>());
            _tasteMsg = "Đã lưu khẩu vị. Quán sẽ tự điền vào ghi chú mỗi lần bạn đặt hàng.";
            _tasteOk = true;
        }
        catch (InvalidOperationException ex)
        {
            _tasteMsg = ex.Message;
            _tasteOk = false;
        }
        catch (Exception)
        {
            _tasteMsg = "Lưu khẩu vị thất bại. Vui lòng thử lại.";
            _tasteOk = false;
        }
        finally
        {
            _tasteBusy = false;
        }
    }

    // Item 92: birthday.

    private static string TierBadgeClass(string tier) => tier switch
    {
        "Vàng" => "badge-warning",
        "Bạc" => "badge-secondary",
        _ => "badge-info",
    };

    private static string OrderStatusBadge(string status) => status switch
    {
        "Completed" => "badge-success",
        "Cancelled" => "badge-danger",
        "Delivering" => "badge-info",
        "Preparing" => "badge-warning",
        "Confirmed" => "badge-primary",
        _ => "badge-secondary",
    };

    private static string OrderStatusText(string status) => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "Preparing" => "Đang chuẩn bị",
        "Delivering" => "Đang giao",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        _ => status,
    };

    private async Task SaveDobAsync()
    {
        _dobMsg = null;
        if (!_dobValue.HasValue)
        {
            _dobMsg = "Vui lòng chọn ngày sinh.";
            _dobOk = false;
            return;
        }

        _dobBusy = true;
        try
        {
            _profile.DateOfBirth = _dobValue.Value.Date;
            _profile = await ProfileService.UpdateAsync(_profile);
            _dobValue = _profile.DateOfBirth;
            _dobMsg = "Đã lưu ngày sinh. Chúc bạn luôn ngon miệng!";
            _dobOk = true;
        }
        catch (InvalidOperationException ex)
        {
            _dobMsg = ex.Message;
            _dobOk = false;
        }
        catch (Exception)
        {
            _dobMsg = "Lưu ngày sinh thất bại. Vui lòng thử lại.";
            _dobOk = false;
        }
        finally
        {
            _dobBusy = false;
        }
    }
}
