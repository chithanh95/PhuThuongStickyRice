    /// <summary>
    /// Thêm khẩu vị tự nhập: cắt khoảng trắng, bỏ qua chuỗi rỗng, giới hạn
    /// độ dài để ô hiển thị không vỡ giao diện.
    /// </summary>
    private void AddCustomTag()
    {
        _profileMsg = null;
        var tag = (_customTag ?? string.Empty).Trim();
        if (tag.Length == 0)
        {
            return;
        }

        if (tag.Length > MaxCustomTagLength)
        {
            _profileMsg = $"Mỗi khẩu vị tối đa {MaxCustomTagLength} ký tự.";
            _profileOk = false;
            return;
        }

        _selectedTags.Add(tag);
        _customTag = null;
    }

    /// <summary>
    /// Mẫu chung lưu hồ sơ (khẩu vị / ngày sinh): bật cờ busy, chạy
    /// thao tác lưu, rồi gán thông báo thành công/thất bại. Lỗi nghiệp vụ
    /// (InvalidOperationException) giữ nguyên message của backend để khách
    /// hiểu (vd hết lượt đổi ngày sinh); lỗi khác báo câu thân thiện.
    /// Cờ busy luôn được tắt trong finally nên nút không kẹt.
    /// </summary>
    private static async Task RunProfileSaveAsync(
        Action<bool> setBusy,
        Action<string, bool> setMessage,
        Func<Task> work,
        string successMessage,
        string errorMessage)
    {
        setMessage(null, false);
        setBusy(true);
        try
        {
            await work();
            setMessage(successMessage, true);
        }
        catch (InvalidOperationException ex)
        {
            setMessage(ex.Message, false);
        }
        catch (Exception)
        {
            setMessage(errorMessage, false);
        }
        finally
        {
            setBusy(false);
        }
    }

    /// <summary>Chuyển tab Hồ sơ / Đơn hàng / Bảo mật.</summary>
    /// <param name="tab">Tab đích: profile | orders | security.</param>
    private void SwitchTab(string tab) => _tab = tab;

    /// <summary>
    /// A11y: phím ←/→ chuyển tab theo ARIA tabs pattern (giống DangNhap).
    /// 3 tab nên ← và → đều đi vòng tròn profile → orders → security.
    /// </summary>
    private void OnTablistKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "ArrowRight" && e.Key != "ArrowLeft")
        {
            return;
        }

        var order = new[] { "profile", "orders", "security" };
        var index = System.Array.IndexOf(order, _tab);
        var next = e.Key == "ArrowRight"
            ? (index + 1) % order.Length
            : (index + order.Length - 1) % order.Length;
        _tab = order[next];
    }

