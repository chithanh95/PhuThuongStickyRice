    /// <summary>
    /// Item 122: "Đặt lại" — thêm toàn bộ món của đơn cũ vào giỏ (kèm size/topping theo tên),
    /// rồi chuyển sang trang giỏ hàng.
    /// </summary>
    private void ReorderAsync(TrackedOrderModel order)
    {
        if (order?.Lines == null || order.Lines.Count == 0)
        {
            return;
        }

        _reorderBusy = true;
        try
        {
            foreach (var line in order.Lines.Where(l => l != null && l.Quantity > 0))
            {
                // Đơn giá đã bao gồm size/topping ở thời điểm đặt đơn.
                // S25: đơn tạo sau migration AddOrderLineSizeAndToppingIds
                // có sẵn SizeOptionId/ToppingIds — khôi phục đúng lựa chọn
                // theo id; đơn cũ chưa có id thì để trống, chỉ dùng tên hiển thị.
                CartState.AddConfigured(
                    line.ProductId,
                    line.ProductName,
                    productCode: null,
                    line.UnitPrice,
                    line.Quantity,
                    sizeOptionId: line.SizeOptionId,
                    line.SizeName,
                    toppingIds: line.ToppingIds ?? new List<Guid>(),
                    line.ToppingNames,
                    line.ToppingsExtra,
                    line.IsCombo,
                    note: line.Note);
            }

            Navigation.NavigateTo("/cart");
        }
        finally
        {
            _reorderBusy = false;
        }
    }

