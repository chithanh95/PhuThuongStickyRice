    /// <summary>zalo.me link with the phone normalized to 84xxxxxxxxx and a pre-filled question about the dish.</summary>
    private string ZaloChatUrl(string productName)
    {
        var digits = new string((ZaloChatPhone ?? "").Where(char.IsDigit).ToArray());
        if (digits.StartsWith("0"))
            digits = "84" + digits.Substring(1);
        else if (!digits.StartsWith("84"))
            digits = "84" + digits;
        var text = Uri.EscapeDataString($"Chào quán, cho mình hỏi về món {productName}");
        return $"https://zalo.me/{digits}?text={text}";
    }
    private bool _openNow;

    protected override async Task OnInitializedAsync()
    {
        I18n.OnChange += OnLangChanged;
        // SH1: re-render the sticky cart bar when items are added/removed.
        CartState.OnChange += OnCartChanged;
        await I18n.InitializeAsync();
        Funnel.Track(FunnelService.Events.ShopView, new Uri(Navigation.Uri).AbsolutePath);
        _tableLabel = GetQueryValue(Navigation.Uri, "ban");

        // Item 133: order source from shop entry params.
        // ?ban= → "QR bàn", ?share= → "Link chia sẻ", ?nhom= → "Nhóm", else "Web".
        if (!string.IsNullOrWhiteSpace(_tableLabel))
        {
            CartState.Source = "QR bàn";
        }
        else if (!string.IsNullOrWhiteSpace(GetQueryValue(Navigation.Uri, "share")))
        {
            CartState.Source = "Link chia sẻ";
        }
        else if (!string.IsNullOrWhiteSpace(GetQueryValue(Navigation.Uri, "nhom")))
        {
            CartState.Source = "Nhóm";
        }
        else
        {
            CartState.Source = "Web";
        }

        // Wave 6a (item 22): open-hours badge in the hero (fail-safe —
        // the shop works fine with the built-in defaults).
        try
        {
            _shopSettings = await ShopSettingsService.GetPublicAsync();
        }
        catch (Exception)
        {
            _shopSettings = null;
        }

        if (_shopSettings != null)
        {
            var (isOpen, text) = ShopHours.StatusText(_shopSettings.OpenTime, _shopSettings.CloseTime);
            _openNow = isOpen;
            _openStatusText = text;
        }

        try
        {
            // Wave 6d (item 38): products are the critical load — their
            // failure gets the full-page error state with a retry button.
            try
            {
                var paged = await ShopService.GetProductsAsync();
                _products = paged.Items ?? new List<ShopProductModel>();
            }
            catch (Exception)
            {
                _loadFailed = true;
                _products = new List<ShopProductModel>();
            }

            var branchesTask = Wave4Service.GetActiveBranchesAsync();
            var combosTask = ShopService.GetCombosAsync();
            var toppingsTask = ShopService.GetToppingsAsync();
            var todaySoldTask = ShopService.GetTodaySoldAsync();
            var bestSellersTask = ShopService.GetBestSellerIdsAsync();

            await Task.WhenAll(branchesTask, combosTask, toppingsTask, todaySoldTask, bestSellersTask);

            // Wave 6b (item 26): rating aggregates are fail-soft — the shop
            // hides the stars when the call fails.
            try
            {
                var ratings = await ShopService.GetProductRatingsAsync();
                _ratings = (ratings ?? new List<ProductRatingModel>())
                    .Where(r => r.ReviewCount > 0)
                    .ToDictionary(r => r.ProductId, r => (r.AverageRating, r.ReviewCount));
            }
            catch (Exception)
            {
                _ratings = new Dictionary<Guid, (double Avg, int Count)>();
            }

            // Item 165: daily-limit status ("Còn N suất") — fail-soft, the
            // badge simply hides when the call fails.
            try
            {
                var remaining = await ShopService.GetDailyRemainingAsync();
                var byId = (remaining ?? new List<ProductDailyRemainingModel>())
                    .ToDictionary(r => r.ProductId);
                foreach (var p in _products)
                {
                    if (byId.TryGetValue(p.Id, out var r))
                    {
                        p.RemainingToday = r.RemainingToday;
                    }
                }
            }
            catch (Exception)
            {
            }

            _branches = branchesTask.Result ?? new List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel>();
            _combos = combosTask.Result ?? new List<ComboModel>();
            _toppings = toppingsTask.Result ?? new List<ToppingModel>();
            _todaySold = todaySoldTask.Result;

            var rank = 0;
            foreach (var id in bestSellersTask.Result ?? new List<Guid>())
            {
                _rank[id] = rank++;
            }

            foreach (var p in _products)
            {
                _quantities[p.Id] = 1;
                _cardSizes[p.Id] = DefaultSizeId(p);
                if (p.Sizes == null)
                {
                    p.Sizes = new List<ProductSizeOptionModel>();
                }
            }

            _categories = _products
                .Select(p => p.Category)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .OrderBy(c => c)
                .ToList();

            ApplyFilters();
            BuildSuggestions();

            // Item 116: ?tim={productCode} opens the quick-view directly
            // (target of the short links created from the quick-view).
            var tim = GetQueryValue(Navigation.Uri, "tim");
            if (!string.IsNullOrWhiteSpace(tim))
            {
                var match = _products.FirstOrDefault(p =>
                    string.Equals(p.Code, tim.Trim(), StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    OpenQuickView(match);
                }
            }
        }
        catch (Exception)
        {
            // Non-critical extras (combos, toppings, best-sellers) failed;
            // products have their own _loadFailed flag (item 38).
            _error = "Một số thông tin bổ sung không tải được. Vui lòng thử lại sau.";
            _products ??= new List<ShopProductModel>();
        }
    }

    /// <summary>Wave 6d (item 38): full reload after a failed initial load.</summary>
    private void RetryLoad()
    {
        Navigation.NavigateTo("/shop", forceLoad: true);
    }

    /// <summary>
    /// Item 118: time-based suggestions, pure client-side by local hour:
    /// 5h–10h → savory (tag "man") products; 17h–23h → evening picks.
    /// </summary>
    private void BuildSuggestions()
    {
        _suggestions = new List<ShopProductModel>();
        _suggestionTitle = null;

        if (_products == null || _products.Count == 0)
        {
            return;
        }

        var hour = DateTime.Now.Hour;
        if (hour >= 5 && hour < 10)
        {
            _suggestionTitle = "☀️ Gợi ý buổi sáng";
            _suggestions = _products
                .Where(p => (p.Tags ?? string.Empty).Contains("man"))
                .Take(3)
                .ToList();
        }
        else if (hour >= 17 && hour < 23)
        {
            _suggestionTitle = "🌙 Gợi ý buổi tối";
            _suggestions = _products.Take(3).ToList();
        }
    }

