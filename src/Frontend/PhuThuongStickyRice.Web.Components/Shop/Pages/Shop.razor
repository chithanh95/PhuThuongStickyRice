    // ---------- Quick view ----------

    private void OpenQuickView(ShopProductModel product)
    {
        _quickView = product;
        _quickViewQty = _quantities.TryGetValue(product.Id, out var q) && q > 0 ? q : 1;
        _quickViewSizeId = SelectedSizeId(product);
        _quickViewToppings = new HashSet<Guid>();
        _quickViewNote = null;
        _quickViewShortLink = null;
        _shortLinkCopied = null;
    }

    private void CloseQuickView()
    {
        _quickView = null;
    }

    /// <summary>
    /// Item 116: creates a short link to /shop?tim={code} and copies it.
    /// </summary>
    private async Task CreateQuickViewShortLink()
    {
        if (_quickView == null || _creatingShortLink)
        {
            return;
        }

        _creatingShortLink = true;
        _shortLinkCopied = null;
        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var target = $"{baseUrl}/shop?tim={Uri.EscapeDataString(_quickView.Code)}";
            var link = await Wave4Service.CreateShortLinkAsync(target);
            _quickViewShortLink = $"{baseUrl}/s/{link.Code}";
            try
            {
                await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _quickViewShortLink);
                _shortLinkCopied = "Đã sao chép link ngắn: " + _quickViewShortLink;
            }
            catch (Exception)
            {
                _shortLinkCopied = _quickViewShortLink;
            }
        }
        catch (Exception)
        {
            _shortLinkCopied = "Không tạo được link ngắn, vui lòng thử lại.";
        }
        finally
        {
            _creatingShortLink = false;
        }
    }

    private void ToggleQuickViewTopping(Guid toppingId, bool on)
    {
        if (on)
        {
            _quickViewToppings.Add(toppingId);
        }
        else
        {
            _quickViewToppings.Remove(toppingId);
        }
    }

    private decimal QuickViewUnitPrice()
    {
        if (_quickView == null)
        {
            return 0;
        }

        var size = _quickViewSizeId.HasValue
            ? _quickView.Sizes.FirstOrDefault(s => s.Id == _quickViewSizeId.Value)
            : null;
        var basePrice = size?.Price ?? _quickView.Price;
        var toppingsTotal = (_toppings ?? new List<ToppingModel>())
            .Where(t => _quickViewToppings.Contains(t.Id))
            .Sum(t => t.ExtraPrice);
        return basePrice + toppingsTotal;
    }

    private void AddQuickViewToCart()
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.");
            return;
        }
        if (_quickView == null)
        {
            return;
        }
        if (IsSoldOut(_quickView))
        {
            Toasts.Show($"'{_quickView.Name}' tạm hết, vui lòng chọn món khác.");
            return;
        }
        // SH4: same as sold-out — the button is already disabled via CanOrder.
        if (IsDailyLimitReached(_quickView))
        {
            Toasts.Show($"'{_quickView.Name}' đã hết suất hôm nay, vui lòng quay lại ngày mai.");
            return;
        }

        var qty = _quickViewQty > 0 ? _quickViewQty : 1;
        var size = _quickViewSizeId.HasValue
            ? _quickView.Sizes.FirstOrDefault(s => s.Id == _quickViewSizeId.Value)
            : null;
        var chosenToppings = (_toppings ?? new List<ToppingModel>()).Where(t => _quickViewToppings.Contains(t.Id)).ToList();
        var toppingIds = chosenToppings.Select(t => t.Id).ToList();
        var toppingNames = chosenToppings.Count == 0 ? null : string.Join(", ", chosenToppings.Select(t => t.Name));
        var toppingsTotal = chosenToppings.Sum(t => t.ExtraPrice);
        var unitPrice = (size?.Price ?? _quickView.Price) + toppingsTotal;

        CartState.AddConfigured(
            _quickView.Id, _quickView.Name, _quickView.Code,
            unitPrice, qty,
            size?.Id, size?.Name,
            toppingIds, toppingNames, toppingsTotal,
            isCombo: false,
            note: _quickViewNote);

        _quantities[_quickView.Id] = qty;
        if (size != null)
        {
            _cardSizes[_quickView.Id] = size.Id;
        }

        Toasts.Show($"Đã thêm {_quickView.Name} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
        CloseQuickView();
    }

