    private void ClearFilters()
    {
        _categoryFilter = null;
        _needFilter = null;
        _sort = "popular";
        ClearSearch();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (_products == null)
        {
            _filteredProducts = new List<ShopProductModel>();
            return;
        }

        var query = _products.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_categoryFilter))
        {
            query = query.Where(p => string.Equals(p.Category?.Trim(), _categoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        // SH2: quick-filter by customer need, mapped onto existing product data.
        if (!string.IsNullOrWhiteSpace(_needFilter))
        {
            query = query.Where(p => MatchesNeed(p, _needFilter));
        }

        // Tìm kiếm: tên + mô tả + tag + danh mục (không dấu vẫn ra).
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            var termNoDiacritics = RemoveDiacritics(term);
            query = query.Where(p =>
                (p.Name ?? string.Empty).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0 ||
                (p.Description ?? string.Empty).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0 ||
                (p.Tags ?? string.Empty).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0 ||
                (p.Category ?? string.Empty).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0 ||
                RemoveDiacritics(p.Name ?? string.Empty).IndexOf(termNoDiacritics, StringComparison.OrdinalIgnoreCase) >= 0);
        }

        _filteredProducts = _sort switch
        {
            "priceAsc" => query.OrderBy(p => MinPrice(p)).ToList(),
            "priceDesc" => query.OrderByDescending(p => MinPrice(p)).ToList(),
            "newest" => query.OrderByDescending(p => p.CreatedDateTime).ToList(),
            // Item 146: manual display order (drag & drop on /products) first;
            // best-seller rank and name are the tiebreaks (all zero by default).
            _ => query.OrderBy(p => p.SortOrder)
                .ThenBy(p => _productRank.TryGetValue(p.Id, out var r) ? r : int.MaxValue)
                .ThenBy(p => p.Name).ToList()
        };
    }

    private string CategoryTabClass(string category) =>
        string.Equals(_categoryFilter, category, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    /// <summary>Badge ưu tiên cao nhất trước; card chỉ hiện tối đa 2.</summary>
    private List<(string Text, string Css)> GetCardBadges(ShopProductModel product)
    {
        var badges = new List<(string, string)>();
        // 1. Tình trạng hàng (quan trọng nhất)
        if (IsSoldOut(product))
            badges.Add(("Tạm hết", "badge-secondary"));
        else if (IsDailyLimitReached(product))
            badges.Add(("Hết hôm nay", "badge-secondary"));
        else if (!IsInSaleHours(product))
            badges.Add(($"⏰ Chỉ bán {SaleHoursLabel(product)}", "badge-info"));
        else if (product.RemainingToday.HasValue && product.RemainingToday.Value < 10)
            badges.Add(($"Còn {product.RemainingToday} suất", "badge-warning"));
        // 2. Marketing
        if (product.IsNew)
            badges.Add(("Món mới", "badge-success"));
        if (product.IsSignature)
            badges.Add(("Signature", "badge-warning"));
        // 3. Tag ăn chay/mặn/cay
        foreach (var tag in ProductTags(product))
            badges.Add((TagLabel(tag), "badge-info"));
        return badges;
    }

    private static List<string> ProductTags(ShopProductModel product) =>
        (product.Tags ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().ToLowerInvariant())
            .Where(x => x.Length > 0)
            .Distinct()
            .ToList();

    private static string TagLabel(string tag) => tag switch
    {
        "chay" => "🥬 Chay",
        "man" => "🍖 Mặn",
        "cay" => "🌶️ Cay",
        _ => tag
    };

    private static decimal MinPrice(ShopProductModel product) =>
        product.Sizes != null && product.Sizes.Count > 0
            ? product.Sizes.Min(s => s.Price)
            : product.Price;

    // ---------- Sizes ----------

    private static Guid? DefaultSizeId(ShopProductModel product)
    {
        if (product.Sizes == null || product.Sizes.Count == 0)
        {
            return null;
        }

        // Sắp xếp 1 lần rồi tái dùng cho cả 2 nhánh — tránh OrderBy chạy 2 lần
        // (deferred execution nên mỗi lần gọi OrderBy là một lần sort mới).
        var ordered = product.Sizes.OrderBy(s => s.SortOrder).ToList();
        return ordered.FirstOrDefault(s => s.Price == product.Price)?.Id
            ?? ordered.First().Id;
    }

    private Guid? SelectedSizeId(ShopProductModel product)
    {
        if (_cardSizes.TryGetValue(product.Id, out var id) && id.HasValue
            && product.Sizes.Any(s => s.Id == id.Value))
        {
            return id;
        }

        return DefaultSizeId(product);
    }

    private void SelectCardSize(ShopProductModel product, Guid sizeId)
    {
        _cardSizes[product.Id] = sizeId;
    }

    private decimal DisplayPrice(ShopProductModel product)
    {
        var sizeId = SelectedSizeId(product);
        var size = sizeId.HasValue ? product.Sizes.FirstOrDefault(s => s.Id == sizeId.Value) : null;
        return size?.Price ?? product.Price;
    }

    /// <summary>
    /// Item 256: giá KM hiển thị trên card — chỉ khi có giá trị và rẻ hơn
    /// giá đang hiện (giá gốc hoặc giá size đã chọn).
    /// </summary>
    private decimal? CardPromoPrice(ShopProductModel product)
    {
        var price = DisplayPrice(product);
        return product.PromoPrice.HasValue && product.PromoPrice.Value > 0
            && product.PromoPrice.Value < price
            ? product.PromoPrice.Value
            : null;
    }

    /// <summary>
    /// Item 256 fix (bug-hunt 2026-10-19): giá bán hiệu dụng đưa vào giỏ.
    /// Giá KM hiển thị trên card phải là giá khách thực sự trả — trước đây
    /// giỏ và đơn hàng tính theo giá gốc trong khi card hiện giá KM.
    /// Gom về helper dùng chung <see cref="ShopProductModel.EffectivePrice"/>
    /// để mọi đường thêm vào giỏ (upsell, gợi ý, trang chủ) cùng một luật.
    /// </summary>
    /// <param name="product">Món hàng (có thể mang giá KM từ API).</param>
    /// <param name="basePrice">Giá đang xét (giá gốc hoặc giá size đã chọn).</param>
    /// <returns>Giá KM nếu có và rẻ hơn, ngược lại giá gốc.</returns>
    private static decimal EffectivePrice(ShopProductModel product, decimal basePrice) =>
        ShopProductModel.EffectivePrice(product, basePrice);

    // ---------- Cart ----------

    private void AddToCart(ShopProductModel product)
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.");
            return;
        }
        if (IsSoldOut(product))
        {
            Toasts.Show($"'{product?.Name}' tạm hết, vui lòng chọn món khác.");
            return;
        }
        // SH4: same as sold-out — the button is already disabled via CanOrder.
        if (IsDailyLimitReached(product))
        {
            Toasts.Show($"'{product?.Name}' đã hết suất hôm nay, vui lòng quay lại ngày mai.");
            return;
        }
        var qty = _quantities.TryGetValue(product.Id, out var q) && q > 0 ? q : 1;
        var sizeId = SelectedSizeId(product);
        var size = sizeId.HasValue ? product.Sizes.FirstOrDefault(s => s.Id == sizeId.Value) : null;

        CartState.AddConfigured(
            product.Id, product.Name, product.Code,
            EffectivePrice(product, size?.Price ?? product.Price), qty,
            size?.Id, size?.Name,
            toppingIds: null, toppingNames: null, toppingsTotal: 0,
            isCombo: false,
            imageUrl: ProductImage(product));

        // Upsell: when a xôi is added, suggest Chả cốm / Chả giò.
        if (IsXoi(product))
        {
            ShowUpsell(product.Name);
            return;
        }

        var detail = size != null ? $" (size {size.Name})" : "";
        Toasts.Show($"Đã thêm {product.Name}{detail} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
    }

    /// <summary>True for xôi products (upsell trigger). Chả cốm / Chả giò excluded.</summary>
    private static bool IsXoi(ShopProductModel product)
    {
        return (product?.Code ?? "").StartsWith("XOI", StringComparison.OrdinalIgnoreCase);
    }

    // ---------- Upsell popup ----------

    private bool _upsellVisible;
    private string _upsellAddedName;
    private List<ShopProductModel> _upsellProducts;

    private void ShowUpsell(string addedProductName)
    {
        if (_products == null || _products.Count == 0)
        {
            return;
        }
        // bug-hunt 2026-10-19 (run 12:35): popup upsell trước đây chỉ lọc
        // Status == "Active" nên vẫn đề xuất món đã "Hết hôm nay" (hết suất
        // ngày) hoặc ngoài giờ bán, trong khi nút thêm trên card đã bị disable
        // bởi CanOrder. Dùng đúng CanOrder để popup không bao giờ đề xuất
        // món khách không đặt được.
        _upsellProducts = _products
            .Where(p => !IsXoi(p) && CanOrder(p))
            .OrderBy(p => p.Code == "CHA-COM" ? 0 : p.Code == "CHA-GIO" ? 1 : 2)
            .ThenBy(p => p.Price)
            .Take(4)
            .ToList();
        if (_upsellProducts.Count == 0)
        {
            return;
        }
        _upsellAddedName = addedProductName;
        _upsellVisible = true;
    }

    private void AddUpsell(ShopProductModel product)
    {
        // bug-hunt 2026-10-19 (run 12:35): guard phòng thủ — nếu món vừa hết
        // suất/giờ bán sau khi popup đã mở, từ chối thay vì cho vào giỏ.
        if (!CanOrder(product))
        {
            Toasts.Show("Món này vừa hết suất hôm nay, bạn chọn món khác nhé.");
            return;
        }
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void CloseUpsell()
    {
        _upsellVisible = false;
    }

    private void AddComboToCart(ComboModel combo)
