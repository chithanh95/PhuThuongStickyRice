@page "/shop"
<PageTitle>Thực đơn — Xôi Phú Thượng</PageTitle>
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject Wave4Service Wave4Service
@inject Wave5Service Wave5Service
@inject CartState CartState
@inject ShopI18n I18n
@implements IDisposable
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject FunnelService Funnel

<div class="jumbotron jumbotron-fluid bg-warning text-dark rounded p-4 mb-4">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div>
                <h1 class="display-5">Xôi Làng Nghề Phú Thượng</h1>
                <p class="lead mb-1">Xôi dẻo thơm chuẩn vị làng nghề — đặt hàng online, giao tận nơi.</p>
                @if (!string.IsNullOrWhiteSpace(_tableLabel))
                {
                    <p class="mb-1"><span class="badge badge-info" style="font-size: 1rem;">🍽 @I18n.T("table_order") @_tableLabel</span></p>
                }
                @if (_todaySold > 0)
                {
                    <p class="mb-0"><span class="badge badge-danger" style="font-size: 1rem;">🔥 @I18n.T("sold_today"): @_todaySold</span></p>
                }
                @* Wave 6a (item 22): open-hours display (VN time). *@
                @if (!string.IsNullOrEmpty(_openStatusText))
                {
                    <p class="mb-0 mt-1"><span class="badge @(_openNow ? "badge-success" : "badge-danger")" style="font-size: 1rem;">@_openStatusText</span></p>
                }
                @if (OrdersPaused)
                {
                    <div class="alert alert-warning mt-2 mb-0" role="alert">
                        ⏸ @(HolidayPaused ? _shopSettings.PausedReason : "Quán tạm ngưng nhận đơn" + (string.IsNullOrWhiteSpace(_shopSettings.PausedReason) ? "." : ": " + _shopSettings.PausedReason))
                    </div>
                }
            </div>
            <a class="btn btn-dark mt-2" href="/menu-print" target="_blank" title="Mở thực đơn để in / lưu PDF">
                📄 Tải menu (PDF)
            </a>
        </div>
    </div>
</div>

@* SH3: delivery info strip from shop settings (fail-soft defaults). *@
<div class="shop-info-strip mb-3">🚚 @DeliveryInfoText()</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "products" ? "active" : "")" @onclick='() => _activeTab = "products"' style="cursor: pointer;">🍚 Tất cả món</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "compare" ? "active" : "")" @onclick='() => _activeTab = "compare"' style="cursor: pointer;">📊 Xôi nào hợp bạn?</a>
    </li>
</ul>

@if (_activeTab == "compare")
{
    <div class="card mb-4">
        <div class="card-body">
            <h4 class="card-title">Xôi nào hợp bạn?</h4>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="thead-dark"><tr><th>Món</th><th>Vị</th><th>Giá</th><th>Hợp với</th></tr></thead>
                    <tbody>
                        <tr><td><strong>Xôi gấc</strong></td><td>Ngọt nhẹ, béo</td><td>35k</td><td>Tiệc, cúng, biếu</td></tr>
                        <tr><td><strong>Xôi xéo</strong></td><td>Mặn, thơm hành</td><td>25k</td><td>Ăn sáng mỗi ngày</td></tr>
                        <tr><td><strong>Xôi đỗ</strong></td><td>Bùi, dẻo</td><td>25k</td><td>Người thích vị quê</td></tr>
                        <tr><td><strong>Xôi vò</strong></td><td>Tơi, không ngán</td><td>30k</td><td>Ăn trưa văn phòng</td></tr>
                        <tr><td><strong>Xôi ngũ sắc</strong></td><td>Đẹp mắt, dẻo</td><td>40k</td><td>Mâm cỗ, chụp ảnh</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
@if (_loadFailed)
{
    @* Wave 6d (item 38): friendly full-page error, PWA offline.html look. *@
    <div class="card" style="background: #f5ebcd; border: none;">
        <div class="card-body text-center py-5">
            <div style="font-size: 4rem;">😞</div>
            <h2 style="font-family: Georgia, serif; color: #7a1b2e;">Không kết nối được tới máy chủ</h2>
            <p class="mb-4" style="color: #4a2b1a;">Kiểm tra mạng rồi thử lại.</p>
            <button class="btn" style="background: #7a1b2e; color: #fff; padding: 12px 28px; border-radius: 6px;" @onclick="RetryLoad">Thử lại</button>
        </div>
    </div>
}
else
{
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
}

@if (_combos != null && _combos.Count > 0)
{
    <h4 class="mb-3">🎉 Combo gia đình <small class="text-muted">— tiết kiệm hơn gọi lẻ</small></h4>
    <div class="row">
        @foreach (var combo in _combos)
        {
            <div class="col-md-6 mb-4" @key="combo.Id">
                <div class="card h-100 border-warning">
                    <div class="card-body">
                        <h5 class="card-title">
                            @combo.Name
                            <span class="badge badge-warning ml-1">COMBO</span>
                        </h5>
                        <p class="card-text text-muted small">@combo.Description</p>
                        <ul class="list-unstyled small mb-2">
                            @foreach (var item in combo.Items)
                            {
                                <li>• @item.ProductName <span class="text-muted">× @item.Quantity</span></li>
                            }
                        </ul>
                        <div class="d-flex align-items-center justify-content-between">
                            <strong class="text-danger" style="font-size: 1.3rem;">@FormatPrice(combo.Price)</strong>
                            <button class="btn btn-warning" @onclick="() => AddComboToCart(combo)">
                                Thêm combo vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_products == null)
{
    <p><em>Đang tải sản phẩm...</em></p>
}
else
{
    <!-- Filters: categories + dietary tags + sort + branch -->
    <div class="card mb-4">
        <div class="card-body py-3">
            @if (_branches != null && _branches.Count > 0)
            {
                <div class="mb-2">
                    <span class="text-muted small mr-2">Chi nhánh:</span>
                    <div class="btn-group btn-group-sm flex-wrap" role="group">
                        <button class="btn @BranchChipClass(null)" @onclick="() => SetBranch(null)">Tất cả</button>
                        @foreach (var b in _branches)
                        {
                            <button class="btn @BranchChipClass(b.Id)" @onclick="() => SetBranch(b.Id)">@b.Name</button>
                        }
                    </div>
                </div>
            }
            <div class="mb-2">
                <span class="text-muted small mr-2">Nhu cầu:</span>
                <div class="btn-group btn-group-sm flex-wrap" role="group">
                    <button class="btn @NeedChipClass(null)" @onclick="() => SetNeedFilter(null)">Tất cả</button>
                    <button class="btn @NeedChipClass("ansang")" @onclick='() => SetNeedFilter("ansang")'>☀️ Ăn sáng</button>
                    <button class="btn @NeedChipClass("cungtiec")" @onclick='() => SetNeedFilter("cungtiec")'>🕯️ Cúng &amp; tiệc</button>
                    <button class="btn @NeedChipClass("bieutang")" @onclick='() => SetNeedFilter("bieutang")'>🎁 Biếu tặng</button>
                    <button class="btn @NeedChipClass("itbeo")" @onclick='() => SetNeedFilter("itbeo")'>🥬 Ít béo</button>
                </div>
            </div>
            <div class="mb-2">
                <span class="text-muted small mr-2">Danh mục:</span>
                <div class="btn-group btn-group-sm flex-wrap" role="group">
                    <button class="btn @CategoryChipClass(null)" @onclick="() => SetCategory(null)">Tất cả</button>
                    @foreach (var cat in _categories)
                    {
                        <button class="btn @CategoryChipClass(cat)" @onclick="() => SetCategory(cat)">@cat</button>
                    }
                </div>
            </div>
            <div class="form-inline">
                <label class="text-muted small mr-2" for="sort-select">Sắp xếp:</label>
                <select id="sort-select" class="form-control form-control-sm" @onchange="OnSortChanged">
                    <option value="popular" selected="@(_sort == "popular")">Bán chạy</option>
                    <option value="priceAsc" selected="@(_sort == "priceAsc")">Giá tăng dần</option>
                    <option value="priceDesc" selected="@(_sort == "priceDesc")">Giá giảm dần</option>
                    <option value="newest" selected="@(_sort == "newest")">Mới nhất</option>
                </select>
            </div>
            @* Wave 6b (item 29): client-side search by name, debounced. *@
            <div class="mt-2" style="max-width: 420px;">
                <div class="input-group input-group-sm">
                    <input class="form-control" placeholder="Tìm món ăn..." aria-label="Tìm món ăn"
                           value="@_searchTerm" @oninput="OnSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(_searchTerm))
                    {
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary" type="button" title="Xóa tìm kiếm" @onclick="ClearSearch">✕</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Item 118: time-based suggestions — pure client-side by hour. *@
    @if (_suggestions.Count > 0)
    {
        <h4 class="mb-3">@_suggestionTitle</h4>
        <div class="row">
            @foreach (var product in _suggestions)
            {
                <div class="col-6 col-md-4 mb-4" @key="product.Id">
                    <div class="card h-100 border-info">
                        <a href="javascript:void(0)" @onclick="() => OpenQuickView(product)" title="Xem nhanh @product.Name">
                            <img class="card-img-top" src="@ProductImage(product)" alt="@product.Name" loading="lazy" />
                        </a>
                        <div class="card-body py-2">
                            <a href="javascript:void(0)" class="text-dark" @onclick="() => OpenQuickView(product)"><strong>@product.Name</strong></a>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <strong class="text-danger">@FormatPrice(product.Price)</strong>
                                <button class="btn btn-sm btn-warning" @onclick="() => AddToCart(product)" disabled="@(!CanOrder(product))">@AddButtonLabel(product, "+ Thêm")</button>
                            </div>
                            @* Item 101: ask about this dish on Zalo. *@
                            @if (ShowZaloButton)
                            {
                                <a class="btn btn-sm btn-outline-success btn-block mt-1" href="@ZaloChatUrl(product.Name)"
                                   target="_blank" rel="noopener" title="Hỏi về @product.Name qua Zalo">💬 Hỏi qua Zalo</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (_filtered.Count == 0)
    {
        <div class="alert alert-info">Không có món nào phù hợp với bộ lọc. <a href="javascript:void(0)" @onclick="ClearFilters">Xóa bộ lọc</a></div>
    }
    else
    {
        <div class="row">
            @foreach (var product in _filtered)
            {
                <div class="col-6 col-md-4 mb-4" @key="product.Id">
                    <div class="card h-100">
                        <a href="javascript:void(0)" @onclick="() => OpenQuickView(product)" title="Xem nhanh @product.Name">
                            <img class="card-img-top" src="@ProductImage(product)" alt="@product.Name" loading="lazy" style="height: 200px; object-fit: cover;" />
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a href="javascript:void(0)" class="text-dark" @onclick="() => OpenQuickView(product)">@product.Name</a>
                            </h5>
                            @* Wave 6b (item 26): "★ 4.8 (12)" — hidden when no reviews. *@
                            @if (RatingText(product) is string cardRating)
                            {
                                <div class="small text-muted mb-1">@cardRating</div>
                            }
                            <div class="mb-1">
                                @if (product.IsNew)
                                {
                                    <span class="badge badge-success mr-1">Món mới</span>
                                }
                                @if (product.IsSignature)
                                {
                                    <span class="badge badge-warning mr-1">Signature</span>
                                }
                                @if (IsSoldOut(product))
                                {
                                    <span class="badge badge-secondary mr-1">Tạm hết</span>
                                }
                                else if (IsDailyLimitReached(product))
                                {
                                    @* SH4: daily limit exhausted but product still Active. *@
                                    <span class="badge badge-secondary mr-1">Hết hôm nay</span>
                                }
                                @* Item 164: outside the sale time windows. *@
                                @if (!IsSoldOut(product) && !IsInSaleHours(product))
                                {
                                    <span class="badge badge-info mr-1">⏰ Chỉ bán @SaleHoursLabel(product)</span>
                                }
                                @* Item 165: low daily stock (only when some portions remain). *@
                                @if (!IsSoldOut(product) && !IsDailyLimitReached(product) && product.RemainingToday.HasValue && product.RemainingToday.Value < 10)
                                {
                                    <span class="badge badge-warning mr-1">Còn @product.RemainingToday suất</span>
                                }
                                @foreach (var tag in ProductTags(product))
                                {
                                    <span class="badge badge-info mr-1">@TagLabel(tag)</span>
                                }
                            </div>
                            <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                            <p class="card-text mb-1">
                                <strong class="text-danger" style="font-size: 1.2rem;">@FormatPrice(DisplayPrice(product))<small class="text-muted">@UnitSuffix(product)</small></strong>
                            </p>
                            @if (product.Sizes != null && product.Sizes.Count > 0)
                            {
                                <div class="shop-size-chips mb-2">
                                    @foreach (var size in product.Sizes)
                                    {
                                        <button type="button"
                                                class="shop-size-chip @(SelectedSizeId(product) == size.Id ? "active" : "")"
                                                @onclick="() => SelectCardSize(product, size.Id)"
                                                title="@size.Name">
                                            @size.Name <span class="shop-size-price">@FormatPrice(size.Price)</span>
                                        </button>
                                    }
                                </div>
                            }
                            <div class="d-flex align-items-center shop-add-row">
                                <input type="number" min="1" max="99" class="form-control mr-2" style="width: 80px;"
                                       @bind="_quantities[product.Id]" />
                                <button class="btn btn-primary flex-grow-1" @onclick="() => AddToCart(product)" disabled="@(!CanOrder(product))">
                                    @AddButtonLabel(product)
                                </button>
                            </div>
                            @* Item 101: ask about this dish on Zalo. *@
                            @if (ShowZaloButton)
                            {
                                <a class="btn btn-sm btn-outline-success btn-block mt-2" href="@ZaloChatUrl(product.Name)"
                                   target="_blank" rel="noopener" title="Hỏi về @product.Name qua Zalo">💬 Hỏi qua Zalo</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

@if (_quickView != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" @onclick="CloseQuickView">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @_quickView.Name
                        @if (_quickView.IsNew)
                        {
                            <span class="badge badge-success ml-1">Món mới</span>
                        }
                        @if (_quickView.IsSignature)
                        {
                            <span class="badge badge-warning ml-1">Signature</span>
                        }
                    </h5>
                    <button type="button" class="close" aria-label="Đóng" @onclick="CloseQuickView">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <img src="@ProductImage(_quickView)" alt="@_quickView.Name" loading="lazy"
                         class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;" />
                    <p class="text-muted">@_quickView.Description</p>
                    @* Wave 6b (item 26): "★ 4.8 (12)" — hidden when no reviews. *@
                    @if (RatingText(_quickView) is string quickViewRating)
                    {
                        <p class="mb-2"><span class="text-muted">@quickViewRating</span></p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_quickView.AllergenInfo))
                    {
                        <div class="alert alert-warning py-2">
                            <small>⚠️ <strong>Thông tin dị ứng:</strong> @_quickView.AllergenInfo</small>
                        </div>
                    }
                    @if (_quickView.Sizes != null && _quickView.Sizes.Count > 0)
                    {
                        <p class="mb-1"><strong>Chọn size:</strong></p>
                        @foreach (var size in _quickView.Sizes)
                        {
                            <div class="form-check" @key="size.Id">
                                <input class="form-check-input" type="radio" name="qv-size" id="qv-size-@size.Id"
                                       checked="@(_quickViewSizeId == size.Id)"
                                       @onchange="() => _quickViewSizeId = size.Id" />
                                <label class="form-check-label" for="qv-size-@size.Id">
                                    @size.Name — <strong class="text-danger">@FormatPrice(size.Price)</strong>
                                </label>
                            </div>
                        }
                    }
                    @if (_toppings != null && _toppings.Count > 0)
                    {
                        <p class="mb-1 mt-2"><strong>Ăn kèm thêm:</strong></p>
                        @foreach (var topping in _toppings)
                        {
                            <div class="form-check" @key="topping.Id">
                                <input class="form-check-input" type="checkbox" id="qv-top-@topping.Id"
                                       checked="@_quickViewToppings.Contains(topping.Id)"
                                       @onchange="(e) => ToggleQuickViewTopping(topping.Id, (bool)e.Value)" />
                                <label class="form-check-label" for="qv-top-@topping.Id">
                                    @topping.Name <span class="text-muted">+@FormatPrice(topping.ExtraPrice)</span>
                                </label>
                            </div>
                        }
                    }
                    <p class="mt-3">
                        <strong class="text-danger" style="font-size: 1.4rem;">@FormatPrice(QuickViewUnitPrice())</strong>
                        <small class="text-muted">@UnitSuffix(_quickView)</small>
                        @if (IsSoldOut(_quickView))
                        {
                            <span class="badge badge-secondary ml-2">Tạm hết</span>
                        }
                        else if (IsDailyLimitReached(_quickView))
                        {
                            @* SH4: daily limit exhausted but product still Active. *@
                            <span class="badge badge-secondary ml-2">Hết hôm nay</span>
                        }
                        @if (!IsSoldOut(_quickView) && !IsInSaleHours(_quickView))
                        {
                            <span class="badge badge-info ml-2">⏰ Chỉ bán @SaleHoursLabel(_quickView)</span>
                        }
                        @* Item 165: low daily stock (only when some portions remain). *@
                        @if (!IsSoldOut(_quickView) && !IsDailyLimitReached(_quickView) && _quickView.RemainingToday.HasValue && _quickView.RemainingToday.Value < 10)
                        {
                            <span class="badge badge-warning ml-2">Còn @_quickView.RemainingToday suất</span>
                        }
                    </p>
                    <div class="d-flex align-items-center">
                        <label class="mr-2 mb-0" for="qv-qty">Số lượng:</label>
                        <input id="qv-qty" type="number" min="1" max="99" class="form-control" style="width: 90px;"
                               @bind="_quickViewQty" />
                    </div>
                    @* Wave 6a (item 24): per-item note flows into the order line. *@
                    <div class="form-group mt-2 mb-0">
                        <label for="qv-note"><small class="text-muted">📝 Ghi chú món <span class="text-muted">(vd: ít hành, nhiều đậu)</span></small></label>
                        <input id="qv-note" class="form-control form-control-sm" maxlength="500"
                               placeholder="Ghi chú cho món này (tùy chọn)" @bind="_quickViewNote" />
                    </div>
                </div>
                <div class="modal-footer">
                    @* Item 116: short link to /shop?tim={code} *@
                    <button type="button" class="btn btn-outline-secondary" @onclick="CreateQuickViewShortLink" disabled="@_creatingShortLink">
                        @(_creatingShortLink ? "Đang tạo..." : "🔗 Link ngắn")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseQuickView">Đóng</button>
                    @* Item 101: ask about this dish on Zalo. *@
                    @if (ShowZaloButton)
                    {
                        <a class="btn btn-outline-success" href="@ZaloChatUrl(_quickView.Name)" target="_blank" rel="noopener">💬 Hỏi qua Zalo</a>
                    }
                    <button type="button" class="btn btn-primary" @onclick="AddQuickViewToCart" disabled="@(!CanOrder(_quickView))">
                        @(CanOrder(_quickView) ? $"{I18n.T("add_to_cart")} — {FormatPrice(QuickViewUnitPrice() * (_quickViewQty > 0 ? _quickViewQty : 1))}" : AddButtonLabel(_quickView))
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_shortLinkCopied))
                {
                    <div class="alert alert-success m-3">@_shortLinkCopied</div>
                }
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
<PhuThuongStickyRice.Web.Components.Shop.Components.UpsellPopup
    Visible="@_upsellVisible"
    Products="@_upsellProducts"
    AddedProductName="@_upsellAddedName"
    OnAdd="AddUpsell"
    OnClose="CloseUpsell" />
} @* /_loadFailed else *@
} @* /_activeTab else *@

@* SH1: sticky cart bar — visible whenever the cart has items. *@
@if (CartState.TotalQuantity > 0)
{
    <a href="/cart" class="shop-sticky-cart">
        <span class="shop-sticky-cart-info">🛒 @CartState.TotalQuantity món · @FormatPrice(CartState.TotalAmount)</span>
        <span class="shop-sticky-cart-cta">Xem giỏ →</span>
    </a>
    <div class="shop-sticky-cart-spacer" aria-hidden="true"></div>
}

@code {
    private string _activeTab = "products";
    private List<ShopProductModel> _products;
    private List<ShopProductModel> _filtered = new List<ShopProductModel>();
    private List<string> _categories = new List<string>();
    private List<ComboModel> _combos;
    private List<ToppingModel> _toppings;
    private Dictionary<Guid, int> _rank = new Dictionary<Guid, int>();
    private long _todaySold;
    private Dictionary<Guid, int> _quantities = new Dictionary<Guid, int>();
    private Dictionary<Guid, Guid?> _cardSizes = new Dictionary<Guid, Guid?>();
    private string _error;

    // Wave 6d (item 38): initial product load failed → full-page error state.
    private bool _loadFailed;

    // Filters.
    private string _categoryFilter;
    private string _sort = "popular";

    // SH2: quick-filter preset by customer need (null = off).
    private string _needFilter;

    // Wave 6b (item 29): client-side product search, debounced 300ms.
    private string _searchTerm = string.Empty;
    private System.Threading.CancellationTokenSource _searchCts;

