    /// <summary>
    /// SH2: "Lọc theo nhu cầu" presets — client-side only, mapped onto
    /// existing product data (tags / IsSignature / price). A preset with no
    /// matching products simply shows the existing empty state.
    /// </summary>
    private void SetNeedFilter(string need)
    {
        _needFilter = need;
        ApplyFilters();
    }

    private string NeedChipClass(string need) =>
        string.Equals(_needFilter, need, StringComparison.OrdinalIgnoreCase)
            ? "btn-primary" : "btn-outline-primary";

    private static bool MatchesNeed(ShopProductModel product, string need) => need switch
    {
        // Savory breakfast items (same rule as the morning suggestions).
        "ansang" => ProductTags(product).Contains("man"),
        // Đẹp mắt, hợp mâm cỗ / tiệc.
        "cungtiec" => product?.IsSignature == true,
        // Món cao cấp để biếu tặng.
        "bieutang" => MinPrice(product) >= 35000,
        // Chay = nhẹ, ít béo.
        "itbeo" => ProductTags(product).Contains("chay"),
        _ => true,
    };

    /// <summary>
    /// SH3: delivery info line from shop settings. Fail-soft — when settings
    /// failed to load, sensible defaults are shown.
    /// </summary>
    private string DeliveryInfoText()
    {
        var parts = new List<string>();
        var fee = _shopSettings?.DeliveryFee ?? 10000;
        parts.Add(fee > 0 ? $"Phí giao từ {FormatPrice(fee)}" : "Miễn phí giao hàng");
        var freeShip = _shopSettings?.FreeShipThreshold ?? 200000;
        if (freeShip > 0)
        {
            parts.Add($"Miễn phí đơn từ {FormatPrice(freeShip)}");
        }
        parts.Add($"Giao {FormatHour(ShopHours.ParseOpen(_shopSettings?.OpenTime))}–{FormatHour(ShopHours.ParseClose(_shopSettings?.CloseTime))}");
        return string.Join(" · ", parts);
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "popular";
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _categoryFilter = null;
        _needFilter = null;
        _sort = "popular";
        ClearSearch();
    }

    /// <summary>
    /// Wave 6b (item 29): debounced search input (300ms) over the loaded
    /// product list; combined with the category/tag chips and sort.
    /// </summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new System.Threading.CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!token.IsCancellationRequested)
        {
            ApplyFilters();
            StateHasChanged();
        }
    }

    private void ClearSearch()
    {
        _searchCts?.Cancel();
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (_products == null)
        {
            _filtered = new List<ShopProductModel>();
            return;
        }

        var query = _products.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_categoryFilter))
        {
            query = query.Where(p => string.Equals(p.Category?.Trim(), _categoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        // SH2: quick-filter by customer need, mapped onto existing product data.
        if (!string.IsNullOrWhiteSpace(_needFilter))
        {
            query = query.Where(p => MatchesNeed(p, _needFilter));
        }

        // Wave 6b (item 29): name search (diacritics-sensitive).
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(p => (p.Name ?? string.Empty).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0);
        }

        _filtered = _sort switch
        {
            "priceAsc" => query.OrderBy(p => MinPrice(p)).ToList(),
            "priceDesc" => query.OrderByDescending(p => MinPrice(p)).ToList(),
            "newest" => query.OrderByDescending(p => p.CreatedDateTime).ToList(),
            // Item 146: manual display order (drag & drop on /products) first;
            // best-seller rank and name are the tiebreaks (all zero by default).
            _ => query.OrderBy(p => p.SortOrder)
                .ThenBy(p => _rank.TryGetValue(p.Id, out var r) ? r : int.MaxValue)
                .ThenBy(p => p.Name).ToList()
        };
    }

    private string CategoryChipClass(string category) =>
        string.Equals(_categoryFilter, category, StringComparison.OrdinalIgnoreCase)
            ? "btn-primary" : "btn-outline-primary";

    private static List<string> ProductTags(ShopProductModel product) =>
        (product.Tags ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().ToLowerInvariant())
            .Where(x => x.Length > 0)
            .Distinct()
            .ToList();

    private static string TagLabel(string tag) => tag switch
    {
        "chay" => "🥬 Chay",
        "man" => "🍖 Mặn",
        "cay" => "🌶️ Cay",
        _ => tag
    };

    private static decimal MinPrice(ShopProductModel product) =>
        product.Sizes != null && product.Sizes.Count > 0
            ? product.Sizes.Min(s => s.Price)
            : product.Price;

    // ---------- Sizes ----------

    private static Guid? DefaultSizeId(ShopProductModel product)
    {
        if (product.Sizes == null || product.Sizes.Count == 0)
        {
            return null;
        }

        return product.Sizes.OrderBy(s => s.SortOrder)
            .FirstOrDefault(s => s.Price == product.Price)?.Id
            ?? product.Sizes.OrderBy(s => s.SortOrder).First().Id;
    }

    private Guid? SelectedSizeId(ShopProductModel product)
    {
        if (_cardSizes.TryGetValue(product.Id, out var id) && id.HasValue
            && product.Sizes.Any(s => s.Id == id.Value))
        {
            return id;
        }

        return DefaultSizeId(product);
    }

    private void OnCardSizeChanged(ShopProductModel product, ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var sizeId))
        {
            _cardSizes[product.Id] = sizeId;
        }
    }

    private decimal DisplayPrice(ShopProductModel product)
    {
        var sizeId = SelectedSizeId(product);
        var size = sizeId.HasValue ? product.Sizes.FirstOrDefault(s => s.Id == sizeId.Value) : null;
        return size?.Price ?? product.Price;
    }

    // ---------- Cart ----------

    private void AddToCart(ShopProductModel product)
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.");
            return;
        }
        if (IsSoldOut(product))
        {
            Toasts.Show($"'{product?.Name}' tạm hết, vui lòng chọn món khác.");
            return;
        }
        // SH4: same as sold-out — the button is already disabled via CanOrder.
        if (IsDailyLimitReached(product))
        {
            Toasts.Show($"'{product?.Name}' đã hết suất hôm nay, vui lòng quay lại ngày mai.");
            return;
        }
        var qty = _quantities.TryGetValue(product.Id, out var q) && q > 0 ? q : 1;
        var sizeId = SelectedSizeId(product);
        var size = sizeId.HasValue ? product.Sizes.FirstOrDefault(s => s.Id == sizeId.Value) : null;

        CartState.AddConfigured(
            product.Id, product.Name, product.Code,
            size?.Price ?? product.Price, qty,
            size?.Id, size?.Name,
            toppingIds: null, toppingNames: null, toppingsTotal: 0,
            isCombo: false);

        // Upsell: when a xôi is added, suggest Chả cốm / Chả giò.
        if (IsXoi(product))
        {
            ShowUpsell(product.Name);
            return;
        }

        var detail = size != null ? $" (size {size.Name})" : "";
        Toasts.Show($"Đã thêm {product.Name}{detail} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
    }

    /// <summary>True for xôi products (upsell trigger). Chả cốm / Chả giò excluded.</summary>
    private static bool IsXoi(ShopProductModel product)
    {
        return (product?.Code ?? "").StartsWith("XOI", StringComparison.OrdinalIgnoreCase);
    }

    // ---------- Upsell popup ----------

    private bool _upsellVisible;
    private string _upsellAddedName;
    private List<ShopProductModel> _upsellProducts;

    private void ShowUpsell(string addedProductName)
    {
        if (_products == null || _products.Count == 0)
        {
            return;
        }
        _upsellProducts = _products
            .Where(p => !IsXoi(p) && string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Code == "CHA-COM" ? 0 : p.Code == "CHA-GIO" ? 1 : 2)
            .ThenBy(p => p.Price)
            .Take(4)
            .ToList();
        if (_upsellProducts.Count == 0)
        {
            return;
        }
        _upsellAddedName = addedProductName;
        _upsellVisible = true;
    }

    private void AddUpsell(ShopProductModel product)
    {
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void CloseUpsell()
    {
        _upsellVisible = false;
    }

    private void AddComboToCart(ComboModel combo)
    {
        CartState.AddCombo(combo);
        Toasts.Show($"Đã thêm {combo.Name} vào giỏ", "Xem giỏ hàng", "/cart");
