    private static string FirstImageUrl(string imageUrlsJson)
    {
        if (string.IsNullOrWhiteSpace(imageUrlsJson))
        {
            return null;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(imageUrlsJson);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return null;
            }

            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var url = el.GetString()?.Trim();
                    if (!string.IsNullOrEmpty(url))
                    {
                        return url;
                    }
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return null;
    }

    /// <summary>
    /// Item 164: true when the current browser-local time is inside one of
    /// the product's sale windows, or when no windows are set. Fails open.
    /// </summary>
    private static bool IsInSaleHours(ShopProductModel product)
    {
        var json = product?.AvailableHoursJson;
        if (string.IsNullOrWhiteSpace(json))
        {
            return true;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return true;
            }

            var now = DateTime.Now.TimeOfDay;
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind != System.Text.Json.JsonValueKind.Object)
                {
                    continue;
                }

                if (el.TryGetProperty("from", out var fromEl)
                    && el.TryGetProperty("to", out var toEl)
                    && TimeSpan.TryParse(fromEl.GetString(), out var from)
                    && TimeSpan.TryParse(toEl.GetString(), out var to)
                    && now >= from && now < to)
                {
                    return true;
                }
            }

            return false;
        }
        catch (System.Text.Json.JsonException)
        {
            return true;
        }
    }

    /// <summary>Item 164: "6h–10h, 17h–20h" label for the sale-hours badge.</summary>
    private static string SaleHoursLabel(ShopProductModel product)
    {
        var json = product?.AvailableHoursJson;
        if (string.IsNullOrWhiteSpace(json))
        {
            return string.Empty;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return string.Empty;
            }

            var parts = new System.Collections.Generic.List<string>();
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.TryGetProperty("from", out var fromEl)
                    && el.TryGetProperty("to", out var toEl)
                    && TimeSpan.TryParse(fromEl.GetString(), out var from)
                    && TimeSpan.TryParse(toEl.GetString(), out var to))
                {
                    parts.Add($"{FormatHour(from)}–{FormatHour(to)}");
                }
            }

            return string.Join(", ", parts);
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private static string FormatHour(TimeSpan t) =>
        t.Minutes == 0 ? $"{t.Hours}h" : $"{t.Hours}:{t.Minutes:D2}";

    /// <summary>Item 165: true when today's portion limit is exhausted.</summary>
    private static bool IsDailyLimitReached(ShopProductModel product) =>
        product?.RemainingToday.HasValue == true && product.RemainingToday.Value <= 0;

    /// <summary>
    /// Items 85/164/165: the add-to-cart button is enabled only when the
    /// shop accepts orders, the product is not sold out, it is inside its
    /// sale hours and its daily limit is not exhausted.
    /// </summary>
    private bool CanOrder(ShopProductModel product) =>
        !OrdersPaused && !IsSoldOut(product) && IsInSaleHours(product) && !IsDailyLimitReached(product);

    /// <summary>
    /// Button label explaining WHY ordering is blocked, or the normal
    /// "add to cart" text. Items 85/164/165.
    /// </summary>
    private string AddButtonLabel(ShopProductModel product, string defaultLabel = null)
    {
        if (IsSoldOut(product))
        {
            return "Tạm hết";
        }

        if (!IsInSaleHours(product))
        {
            return "Chưa tới giờ bán";
        }

        if (IsDailyLimitReached(product))
        {
            return "Hết suất hôm nay";
        }

        return defaultLabel ?? I18n.T("add_to_cart");
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    /// <summary>Item 81: "/kg" for weight products, "/suất" otherwise.</summary>
    private static string UnitSuffix(ShopProductModel product) =>
        string.Equals(product?.Unit, "kg", StringComparison.OrdinalIgnoreCase) ? "/kg" : "/suất";

    /// <summary>Item 85: true when the product is sold out (Inactive).</summary>
    private static bool IsSoldOut(ShopProductModel product) =>
        !string.Equals(product?.Status, "Active", StringComparison.OrdinalIgnoreCase);

    /// <summary>Reads a query string value (item 95: ?ban={label}).</summary>
    private static string GetQueryValue(string uri, string key)
    {
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return null;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            if (string.Equals(Uri.UnescapeDataString(pair.Substring(0, eq)), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
            }
        }

        return null;
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        I18n.OnChange -= OnLangChanged;
        CartState.OnChange -= OnCartChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
