    private decimal QuickViewBasePrice()
    {
        if (_quickView == null)
        {
            return 0;
        }

        var size = _quickViewSizeId.HasValue
            ? _quickView.Sizes?.FirstOrDefault(s => s.Id == _quickViewSizeId.Value)
            : null;
        return size?.Price ?? _quickView.Price;
    }

    private decimal QuickViewToppingsTotal() =>
        (_toppings ?? new List<ToppingModel>())
            .Where(t => _quickViewToppings.Contains(t.Id))
            .Sum(t => t.ExtraPrice);

    private decimal QuickViewUnitPrice()
    {
        if (_quickView == null)
        {
            return 0;
        }

        return EffectivePrice(_quickView, QuickViewBasePrice()) + QuickViewToppingsTotal();
    }

    /// <summary>
    /// bug-hunt 2026-10-20: giá KM đơn vị trong popup xem nhanh, ĐÃ gồm
    /// topping đã chọn (khớp số giỏ hàng thực tính) — null khi món không có
    /// KM. Trước đây popup mobile hiện giá KM món lẻ (không topping) trong
    /// khi <see cref="AddQuickViewToCart"/> cộng cả topping → giá hiển thị
    /// ≠ giá khách thực trả; giá gạch bỏ lại là giá đã KM.
    /// </summary>
    private decimal? QuickViewPromoUnitPrice()
    {
        if (_quickView == null)
        {
            return null;
        }

        var basePrice = QuickViewBasePrice();
        var effective = EffectivePrice(_quickView, basePrice);
        return effective < basePrice
            ? effective + QuickViewToppingsTotal()
            : null;
    }

    private void AddQuickViewToCart()
    {
        if (OrdersPaused)
        {
            Toasts.Show("⏸ Quán đang tạm ngưng nhận đơn. Vui lòng quay lại sau.");
            return;
        }
        if (_quickView == null)
        {
            return;
        }
        if (IsSoldOut(_quickView))
        {
            Toasts.Show($"'{_quickView.Name}' tạm hết, vui lòng chọn món khác.");
            return;
        }
        // SH4: same as sold-out — the button is already disabled via CanOrder.
        if (IsDailyLimitReached(_quickView))
        {
            Toasts.Show($"'{_quickView.Name}' đã hết suất hôm nay, vui lòng quay lại ngày mai.");
            return;
        }

        var qty = _quickViewQty > 0 ? _quickViewQty : 1;
        var size = _quickViewSizeId.HasValue
            ? _quickView.Sizes.FirstOrDefault(s => s.Id == _quickViewSizeId.Value)
            : null;
        var chosenToppings = (_toppings ?? new List<ToppingModel>()).Where(t => _quickViewToppings.Contains(t.Id)).ToList();
        var toppingIds = chosenToppings.Select(t => t.Id).ToList();
        var toppingNames = chosenToppings.Count == 0 ? null : string.Join(", ", chosenToppings.Select(t => t.Name));
        var toppingsTotal = chosenToppings.Sum(t => t.ExtraPrice);
        var unitPrice = EffectivePrice(_quickView, size?.Price ?? _quickView.Price) + toppingsTotal;

        CartState.AddConfigured(
            _quickView.Id, _quickView.Name, _quickView.Code,
            unitPrice, qty,
            size?.Id, size?.Name,
            toppingIds, toppingNames, toppingsTotal,
            isCombo: false,
            note: _quickViewNote,
            imageUrl: ProductImage(_quickView));

        _quantities[_quickView.Id] = qty;
        if (size != null)
        {
            _cardSizes[_quickView.Id] = size.Id;
        }

        Toasts.Show($"Đã thêm {_quickView.Name} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
        CloseQuickView();
    }

