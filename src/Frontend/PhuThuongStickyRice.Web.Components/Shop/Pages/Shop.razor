    /// <summary>
    /// Item 164: true when the current browser-local time is inside one of
    /// the product's sale windows, or when no windows are set. Fails open.
    /// </summary>
    private static bool IsInSaleHours(ShopProductModel product)
    {
        var json = product?.AvailableHoursJson;
        if (string.IsNullOrWhiteSpace(json))
        {
            return true;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return true;
            }

            var now = DateTime.Now.TimeOfDay;
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind != System.Text.Json.JsonValueKind.Object)
                {
                    continue;
                }

                if (el.TryGetProperty("from", out var fromEl)
                    && el.TryGetProperty("to", out var toEl)
                    && TimeSpan.TryParse(fromEl.GetString(), out var from)
                    && TimeSpan.TryParse(toEl.GetString(), out var to)
                    && now >= from && now < to)
                {
                    return true;
                }
            }

            return false;
        }
        catch (System.Text.Json.JsonException)
        {
            return true;
        }
    }

    /// <summary>Item 164: "6h–10h, 17h–20h" label for the sale-hours badge.</summary>
    private static string SaleHoursLabel(ShopProductModel product)
    {
        var json = product?.AvailableHoursJson;
        if (string.IsNullOrWhiteSpace(json))
        {
            return string.Empty;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return string.Empty;
            }

            var parts = new System.Collections.Generic.List<string>();
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.TryGetProperty("from", out var fromEl)
                    && el.TryGetProperty("to", out var toEl)
                    && TimeSpan.TryParse(fromEl.GetString(), out var from)
                    && TimeSpan.TryParse(toEl.GetString(), out var to))
                {
                    parts.Add($"{FormatHour(from)}–{FormatHour(to)}");
                }
            }

            return string.Join(", ", parts);
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private static string FormatHour(TimeSpan t) =>
        t.Minutes == 0 ? $"{t.Hours}h" : $"{t.Hours}:{t.Minutes:D2}";

    /// <summary>Item 165: true when today's portion limit is exhausted.</summary>
    private static bool IsDailyLimitReached(ShopProductModel product) =>
        product?.RemainingToday.HasValue == true && product.RemainingToday.Value <= 0;

    /// <summary>
    /// Items 85/164/165: the add-to-cart button is enabled only when the
    /// shop accepts orders, the product is not sold out, it is inside its
    /// sale hours and its daily limit is not exhausted.
    /// </summary>
    private bool CanOrder(ShopProductModel product) =>
        !OrdersPaused && !IsSoldOut(product) && IsInSaleHours(product) && !IsDailyLimitReached(product);

    /// <summary>
    /// Button label explaining WHY ordering is blocked, or the normal
    /// "add to cart" text. Items 85/164/165.
    /// </summary>
    private string AddButtonLabel(ShopProductModel product, string defaultLabel = null)
    {
        if (IsSoldOut(product))
        {
            return "Tạm hết";
        }

        if (!IsInSaleHours(product))
        {
            return "Chưa tới giờ bán";
        }

        if (IsDailyLimitReached(product))
        {
            return "Hết suất hôm nay";
        }

        return defaultLabel ?? ShopI18n.Translate("add_to_cart");
    }

    /// <summary>Bỏ dấu tiếng Việt để tìm kiếm không dấu vẫn ra.</summary>
    private static string RemoveDiacritics(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        var normalized = text.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalized)
        {
            var uc = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (uc != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC)
            .Replace('đ', 'd').Replace('Đ', 'D');
    }

