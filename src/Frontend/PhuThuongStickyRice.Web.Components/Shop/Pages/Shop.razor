@code {
    // codequality-team 2026-10-20 run-0245 Agent2-CleanCode: FormatPrice dùng chung từ Core.Helpers.PriceFormatter — xóa bản copy local trong file này.
    private string _activeTab = "products";
    private List<ShopProductModel> _products;
    private List<ShopProductModel> _filteredProducts = new List<ShopProductModel>();
    private List<string> _categories = new List<string>();
    private List<ComboModel> _combos;
    private List<ToppingModel> _toppings;
    private Dictionary<Guid, int> _productRank = new Dictionary<Guid, int>();
    private long _todaySold;
    private Dictionary<Guid, int> _quantities = new Dictionary<Guid, int>();
    private Dictionary<Guid, Guid?> _cardSizes = new Dictionary<Guid, Guid?>();
    private string _loadError;

    // Wave 6d (item 38): initial product load failed → full-page error state.
    private bool _loadFailed;

    // Filters.
    private string _categoryFilter;
    private string _sort = "popular";

    // SH2: quick-filter preset by customer need (null = off).
    private string _needFilter;

    // Wave 6b (item 29): client-side product search, debounced 300ms.
    private string _searchTerm = string.Empty;

    // Wave 6b (item 26): per-product rating aggregates {avg, count}.
    private Dictionary<Guid, (double Avg, int Count)> _ratings = new Dictionary<Guid, (double Avg, int Count)>();

    // BA shop item 4: total quantity sold per product ("Đã bán N suất").
    private Dictionary<Guid, long> _soldQuantities = new Dictionary<Guid, long>();

    private string RatingText(ShopProductModel product)
    {
        if (product == null || !_ratings.TryGetValue(product.Id, out var r) || r.Count <= 0)
        {
            return null;
        }

        return $"★ {r.Avg:0.0} ({r.Count})";
    }

    // A11y: nhãn tiếng Việt cho screen reader khi hiển thị đánh giá sao.
    private string RatingAriaLabel(ShopProductModel product)
    {
        if (product == null || !_ratings.TryGetValue(product.Id, out var r) || r.Count <= 0)
        {
            return null;
        }

        return $"Đánh giá trung bình {r.Avg:0.0} trên 5, {r.Count} đánh giá";
    }

    // Item 109: branch picker.
    private List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel> _branches;

    // Item 118: time-based suggestions (pure client-side by hour).
    private List<ShopProductModel> _suggestions = new List<ShopProductModel>();
    private string _suggestionTitle;

    // Item 95: table QR — ?ban={label} shows a "đang đặt tại bàn" chip.
    private string _tableLabel;

    // Item 143: mã giảm giá cho khách mới (banner đơn đầu tiên).
    private FirstOrderVoucherModel _firstOrderVoucher;

    // Quick-view state.
    private ShopProductModel _quickView;
    private int _quickViewQty = 1;
    private Guid? _quickViewSizeId;
    private HashSet<Guid> _quickViewToppings = new HashSet<Guid>();
    private string _quickViewNote;

    // Wave 6a (item 22): open-hours display.
    private ShopSettingModel _shopSettings;
    private string _openStatusText;

    /// <summary>True when the shop paused order intake (AcceptingOrders = false).</summary>
    private bool OrdersPaused => _shopSettings != null && !_shopSettings.AcceptingOrders;
    private bool HolidayPaused => _shopSettings != null && _shopSettings.IsHolidayPaused;

    // Item 101: per-product "Hỏi qua Zalo" button.
    private string ZaloChatPhone => !string.IsNullOrWhiteSpace(_shopSettings?.ZaloPhone)
        ? _shopSettings.ZaloPhone
        : _shopSettings?.Hotline;

    private bool ShowZaloButton => _shopSettings != null
        && _shopSettings.ShowZaloChatButton
        && !string.IsNullOrWhiteSpace(ZaloChatPhone);

    /// <summary>zalo.me link with the phone normalized to 84xxxxxxxxx and a pre-filled question about the dish.</summary>
    private string ZaloChatUrl(string productName)
    {
        var digits = new string((ZaloChatPhone ?? "").Where(char.IsDigit).ToArray());
        if (digits.StartsWith("0"))
            digits = "84" + digits.Substring(1);
        else if (!digits.StartsWith("84"))
            digits = "84" + digits;
        var text = Uri.EscapeDataString($"Chào quán, cho mình hỏi về món {productName}");
        return $"https://zalo.me/{digits}?text={text}";
    }
    private bool _openNow;

    protected override async Task OnInitializedAsync()
    {
        ShopI18n.OnChange += OnLangChanged;
        // SH1: re-render the sticky cart bar when items are added/removed.
        CartState.OnChange += OnCartChanged;
        await ShopI18n.InitializeAsync();
        Funnel.Track(FunnelService.Events.ShopView, new Uri(Navigation.Uri).AbsolutePath);
        _tableLabel = GetQueryValue(Navigation.Uri, "ban");

        // Item 238: nhớ lựa chọn chế độ "Gọn" cho lần sau.
        _compactMode = await LoadCompactModePreferenceAsync();

        // Item 133: nguồn đơn từ tham số khi vào shop.
        ResolveOrderSource();

        // Wave 6a (item 22): open-hours badge in the hero (fail-safe — the
        // shop works fine with the built-in defaults).
        await LoadShopSettingsAsync();

        // Item 143: banner mã giảm giá cho khách mới (fail-soft — shop vẫn
        // chạy bình thường khi không lấy được).
        // perf-hunt 2026-10-20: 2 loader độc lập → song song bằng Task.WhenAll
        // (cắt ~1 round-trip cho khách hàng cũ). LoadFirstOrderVoucherAsync chỉ
        // ghi _firstOrderVoucher; LoadCatalogAsync quản lý _loadFailed của riêng
        // nó → không race, không đổi xử lý lỗi.
        await Task.WhenAll(LoadFirstOrderVoucherAsync(), LoadCatalogAsync());
    }

    /// <summary>
    /// Item 238: đọc lựa chọn chế độ "Gọn" đã lưu trong localStorage. Lỗi
    /// (JS chưa sẵn sàng) thì mặc định tắt — chỉ là giao diện, không chặn shop.
    /// </summary>
    private async Task<bool> LoadCompactModePreferenceAsync()
    {
        try
        {
            return string.Equals(
                await JSRuntime.InvokeAsync<string>("localStorage.getItem", CompactModeStorageKey),
                "1", StringComparison.Ordinal);
        }
        catch (Exception)
        {
            return false;
        }
    }

    /// <summary>
    /// Item 133: suy ra nguồn đơn từ tham số khi vào shop —
    /// ?ban= → "QR bàn", ?share= → "Link chia sẻ", ?nhom= → "Nhóm", còn lại "Web".
    /// </summary>
    private void ResolveOrderSource()
    {
        if (!string.IsNullOrWhiteSpace(_tableLabel))
        {
            CartState.Source = "QR bàn";
        }
        else if (!string.IsNullOrWhiteSpace(GetQueryValue(Navigation.Uri, "share")))
        {
            CartState.Source = "Link chia sẻ";
        }
        else if (!string.IsNullOrWhiteSpace(GetQueryValue(Navigation.Uri, "nhom")))
        {
            CartState.Source = "Nhóm";
        }
        else
        {
            CartState.Source = "Web";
        }
    }

    /// <summary>
    /// Wave 6a (item 22): tải setting shop để hiện badge trạng thái mở/đóng
    /// cửa trên hero. Fail-safe — shop dùng giá trị mặc định khi không lấy được.
    /// </summary>
    private async Task LoadShopSettingsAsync()
    {
        try
        {
            _shopSettings = await ShopSettingsService.GetPublicAsync();
        }
        catch (Exception)
        {
            _shopSettings = null;
        }

        if (_shopSettings != null)
        {
            // bug-hunt 2026-10-20: khi admin tạm ngưng nhận đơn, badge hero phải báo nghỉ.
            // Trước đây chỉ tính giờ mở/đóng nên badge vẫn xanh "Đang mở cửa" chồng lên
            // alert vàng "tạm ngưng nhận đơn" ngay trên cùng hero — mâu thuẫn.
            if (OrdersPaused)
            {
                _openNow = false;
                _openStatusText = "⏸ Quán tạm ngưng nhận đơn";
            }
            else
            {
                var (isOpen, text) = ShopHours.StatusText(_shopSettings.OpenTime, _shopSettings.CloseTime);
                _openNow = isOpen;
                _openStatusText = text;
            }
        }
    }

    /// <summary>
    /// Item 143: voucher đơn đầu cho khách mới. Fail-soft — shop vẫn chạy
    /// bình thường khi không lấy được.
    /// </summary>
    private async Task LoadFirstOrderVoucherAsync()
    {
        try
        {
            var phone = await ResolveCustomerPhoneAsync();
            if (!string.IsNullOrWhiteSpace(phone))
            {
                var voucher = await ShopService.GetFirstOrderVoucherAsync(phone);
                if (voucher != null && voucher.IsNewCustomer && !string.IsNullOrWhiteSpace(voucher.Code))
                {
                    _firstOrderVoucher = voucher;
                }
            }
        }
        catch (Exception)
        {
        }
    }

    /// <summary>
    /// Wave 6d (item 38): tải sản phẩm là load quan trọng nhất — lỗi của riêng
    /// nó gắn cờ _loadFailed (màn hình lỗi toàn trang + nút thử lại). Combo,
    /// topping, bán chạy, đánh giá, tồn kho ngày tải song song trong 2 batch
    /// (fail-soft, shop vẫn chạy khi chúng lỗi).
    /// </summary>
    private async Task LoadCatalogAsync()
    {
        try
        {
            await LoadProductsAsync();
            await LoadCoreExtrasAsync();
            await LoadRatingAndStockExtrasAsync();
            InitializeProductCatalog();
            OpenQuickViewFromQuery();
        }
        catch (Exception)
        {
            // Non-critical extras (combos, toppings, best-sellers) failed;
            // products have their own _loadFailed flag (item 38).
            _loadError = "Một số thông tin bổ sung không tải được. Vui lòng thử lại sau.";
            _products ??= new List<ShopProductModel>();
            // Bug-hunt 2026-10-20: API phụ lỗi mà bỏ qua InitializeProductCatalog
            // thì _quantities rỗng → @bind="_quantities[product.Id]" ném
            // KeyNotFoundException, sập toàn trang /shop dù danh sách món đã tải
            // thành công. Khởi tạo state thẻ món ở đây để giữ đúng ý đồ fail-soft.
            InitializeProductCatalog();
        }
    }

    /// <summary>
    /// Tải danh sách sản phẩm chính của shop. Lỗi → đánh dấu
    /// <c>_loadFailed</c>, danh sách trống (không ném lên).
    /// </summary>
    private async Task LoadProductsAsync()
    {
        try
        {
            var paged = await ShopService.GetProductsAsync();
            _products = paged.Items ?? new List<ShopProductModel>();
        }
        catch (Exception)
        {
            _loadFailed = true;
            _products = new List<ShopProductModel>();
        }
    }

    /// <summary>
    /// Tải các thông tin phụ lõi (chi nhánh, combo, topping, tổng đã bán hôm
    /// nay, xếp hạng bán chạy) trong 1 batch song song. Lỗi → ném cho
    /// <see cref="LoadCatalogAsync"/> xử lý chung ở catch ngoài.
    /// </summary>
    private async Task LoadCoreExtrasAsync()
    {
        var branchesTask = AdminSystemService.GetActiveBranchesAsync();
        var combosTask = ShopService.GetCombosAsync();
        var toppingsTask = ShopService.GetToppingsAsync();
        var todaySoldTask = ShopService.GetTodaySoldAsync();
        var bestSellersTask = ShopService.GetBestSellerIdsAsync();

        await Task.WhenAll(branchesTask, combosTask, toppingsTask, todaySoldTask, bestSellersTask);

        _branches = branchesTask.Result ?? new List<PhuThuongStickyRice.Web.Components.Admin.Models.BranchModel>();
        _combos = combosTask.Result ?? new List<ComboModel>();
        _toppings = toppingsTask.Result ?? new List<ToppingModel>();
        _todaySold = todaySoldTask.Result;

        var rank = 0;
        foreach (var id in bestSellersTask.Result ?? new List<Guid>())
        {
            _productRank[id] = rank++;
        }
    }

    /// <summary>
    /// Tải đánh giá, số lượng đã bán và hạn mức/ngày trong 1 batch song song.
    /// Ratings và daily-remaining fail-soft (hàng tự ẩn khi lỗi); số lượng đã
    /// bán lỗi thì ném cho <see cref="LoadCatalogAsync"/> xử lý chung.
    /// </summary>
    private async Task LoadRatingAndStockExtrasAsync()
    {
        // Ratings / sold-quantities / daily-remaining are independent of
        // each other — start all three now so they resolve in one parallel
        // batch instead of three sequential round-trips. Each keeps its own
        // failure handling below, so semantics are unchanged.
        var ratingsTask = ShopService.GetProductRatingsAsync();
        var soldQuantitiesTask = ShopService.GetSoldQuantitiesAsync();
        var dailyRemainingTask = ShopService.GetDailyRemainingAsync();

        // Wave 6b (item 26): rating aggregates are fail-soft — the shop
        // hides the stars when the call fails.
        try
        {
            var ratings = await ratingsTask;
            _ratings = (ratings ?? new List<ProductRatingModel>())
                .Where(r => r.ReviewCount > 0)
                .ToDictionary(r => r.ProductId, r => (r.AverageRating, r.ReviewCount));
        }
        catch (Exception)
        {
            _ratings = new Dictionary<Guid, (double Avg, int Count)>();
        }

        // BA shop item 4: sold quantities for "Đã bán N suất" — fail-soft.
        _soldQuantities = await soldQuantitiesTask;

        // Item 165: daily-limit status ("Còn N suất") — fail-soft, the
        // badge simply hides when the call fails.
        try
        {
            var remaining = await dailyRemainingTask;
            var byId = (remaining ?? new List<ProductDailyRemainingModel>())
                .ToDictionary(r => r.ProductId);
            foreach (var p in _products)
            {
                if (byId.TryGetValue(p.Id, out var r))
                {
                    p.RemainingToday = r.RemainingToday;
                }
            }
        }
        catch (Exception)
        {
        }
    }

    /// <summary>
    /// Khởi tạo state card cho từng sản phẩm, dựng danh mục từ sản phẩm,
    /// áp filter/tìm kiếm và gợi ý món bán kèm.
    /// </summary>
    private void InitializeProductCatalog()
    {
        foreach (var p in _products)
        {
            InitCardState(p);
        }

        _categories = _products
            .Select(p => p.Category)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        ApplyFilters();
        BuildSuggestions();
    }

    /// <summary>
    /// Item 116: ?tim={productCode} opens the quick-view directly
    /// (target of the short links created from the quick-view).
    /// </summary>
    private void OpenQuickViewFromQuery()
    {
        var tim = GetQueryValue(Navigation.Uri, "tim");
        if (!string.IsNullOrWhiteSpace(tim))
        {
            var match = _products.FirstOrDefault(p =>
                string.Equals(p.Code, tim.Trim(), StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                OpenQuickView(match);
            }
        }
    }

