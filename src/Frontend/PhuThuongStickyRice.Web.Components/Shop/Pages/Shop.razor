    /// <summary>
    /// Item 118: time-based suggestions, pure client-side by local hour:
    /// 5h–10h → savory (tag "man") products; 17h–23h → evening picks.
    /// </summary>
    private void BuildSuggestions()
    {
        _suggestions = new List<ShopProductModel>();
        _suggestionTitle = null;

        if (_products == null || _products.Count == 0)
        {
            return;
        }

        var hour = DateTime.Now.Hour;
        if (hour >= SuggestMorningStartHour && hour < SuggestMorningEndHour)
        {
            _suggestionTitle = "☀️ Gợi ý buổi sáng";
            _suggestions = _products
                .Where(p => (p.Tags ?? string.Empty).Contains("man"))
                .Take(SuggestMaxItems)
                .ToList();
        }
        else if (hour >= SuggestEveningStartHour && hour < SuggestEveningEndHour)
        {
            _suggestionTitle = "🌙 Gợi ý buổi tối";
            _suggestions = _products.Take(SuggestMaxItems).ToList();
        }
    }

    /// <summary>
    /// Item 118: khung giờ gợi ý theo giờ địa phương — sáng: món mặn
    /// (tag "man"); tối: món bán chạy. Tách thành hằng số để dễ đổi khung giờ.
    /// </summary>
    private const int SuggestMorningStartHour = 5;
    private const int SuggestMorningEndHour = 10;
    private const int SuggestEveningStartHour = 17;
    private const int SuggestEveningEndHour = 23;
    private const int SuggestMaxItems = 3;

