    /// <summary>Reads a query string value (item 95: ?ban={label}).</summary>
    private static string GetQueryValue(string uri, string key)
    {
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return null;
        }

        // bug-hunt 2026-10-19: query chứa % sai định dạng (vd /shop?ban=%zz)
        // làm Uri.UnescapeDataString ném UriFormatException → OnInitializedAsync
        // nổ → trang trắng. Cùng pattern đã fix ở Cart.razor/TrackOrder.razor:
        // URL hỏng thì bỏ qua êm (trả null) thay vì crash cả trang.
        try
        {
            return GetQueryValueCore(uri.Substring(question + 1), key);
        }
        catch (Exception)
        {
            return null;
        }
    }

    private static string GetQueryValueCore(string query, string key)
    {
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            if (string.Equals(Uri.UnescapeDataString(pair.Substring(0, eq)), key, System.StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
            }
        }

        return null;
    }

    /// <summary>Item 143: 1 chạm sang checkout, mang theo mã giảm giá.</summary>
    private void UseVoucher()
    {
        if (_firstOrderVoucher != null && !string.IsNullOrWhiteSpace(_firstOrderVoucher.Code))
        {
            Navigation.NavigateTo($"/checkout?code={Uri.EscapeDataString(_firstOrderVoucher.Code)}");
        }
    }

    /// <summary>
    /// Item 143: SĐT khách — đã đăng nhập thì lấy từ tài khoản, chưa đăng
    /// nhập thì dùng SĐT đã lưu ở giỏ hàng (khóa "phuthuong.phone.v1" của Cart.razor).
    /// </summary>
    private async Task<string> ResolveCustomerPhoneAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var name = authState?.User?.Identity?.Name;
            if (IsValidVnPhone(name))
            {
                return name.Trim();
            }
        }
        catch (Exception)
        {
        }

        try
        {
            var saved = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "phuthuong.phone.v1");
            if (IsValidVnPhone(saved))
            {
                return saved.Trim();
            }
        }
        catch (Exception)
        {
        }

        return null;
    }

    private static bool IsValidVnPhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return false;
        }

        var digits = new string(phone.Trim().Where(char.IsDigit).ToArray());
        return digits.Length == 10 && digits[0] == '0' && "35789".Contains(digits[1]);
    }

