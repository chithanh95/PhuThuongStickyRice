@page "/shop"
<PageTitle>Thực đơn — Xôi Phú Thượng</PageTitle>
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Shop.Components
@using PhuThuongStickyRice.Web.Components.Core.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using static PhuThuongStickyRice.Web.Components.Core.Helpers.PriceFormatter;
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject AdminSystemService AdminSystemService
@inject AdminCommerceService AdminCommerceService
@inject CartState CartState
@inject ShopI18n ShopI18n
@implements IDisposable
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject FunnelService Funnel
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

@* Item 238: chế độ "Gọn" — ẩn banner KM/ticker/gợi ý, chỉ còn menu + nút đặt. *@
@* #199: Banner trạng thái quán đang mở/nghỉ — luôn hiện (thông tin quan trọng). *@
<ShopStatusBanner />

@if (!_compactMode)
{
<div class="jumbotron jumbotron-fluid bg-warning text-dark rounded p-4 mb-4">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div>
                <h1 class="display-5">Xôi Làng Nghề Phú Thượng</h1>
                <p class="lead mb-1">Xôi dẻo thơm chuẩn vị làng nghề — đặt hàng online, nhận ngay.</p>
                @if (!string.IsNullOrWhiteSpace(_tableLabel))
                {
                    <p class="mb-1"><span class="badge badge-info" style="font-size: 1rem;">🍽 @ShopI18n.Translate("table_order") @_tableLabel</span></p>
                }
                @if (_todaySold > 0)
                {
                    <p class="mb-0"><span class="badge badge-danger" style="font-size: 1rem;">🔥 @ShopI18n.Translate("sold_today"): @_todaySold</span></p>
                }
                @* Wave 6a (item 22): open-hours display (VN time). *@
                @if (!string.IsNullOrEmpty(_openStatusText))
                {
                    <p class="mb-0 mt-1"><span class="badge @(_openNow ? "badge-success" : "badge-danger")" style="font-size: 1rem;">@_openStatusText</span></p>
                }
                @if (OrdersPaused)
                {
                    <div class="alert alert-warning mt-2 mb-0" role="alert">
                        ⏸ @(HolidayPaused ? _shopSettings.PausedReason : "Quán tạm ngưng nhận đơn" + (string.IsNullOrWhiteSpace(_shopSettings.PausedReason) ? "." : ": " + _shopSettings.PausedReason))
                    </div>
                }
            </div>
            <a class="btn btn-dark mt-2" href="/menu-print" target="_blank" title="Mở thực đơn để in / lưu PDF">
                📄 Tải menu (PDF)
            </a>
        </div>
    </div>
</div>
}

@* Item 143 (UX người già): banner mã giảm giá đơn đầu tiên — chữ to,
   mã hiện to rõ, nút "Dùng ngay" lớn (≥48px), 1 chạm sang checkout.
   Item 238: ẩn ở chế độ "Gọn". *@
@if (_firstOrderVoucher != null && !_compactMode)
{
    <div class="alert alert-info mb-3" role="status" style="border-width: 2px;">
        <div class="font-weight-bold" style="font-size: 1.25rem;">🎉 Chào bạn mới! Quán tặng bạn mã giảm giá cho đơn đầu tiên:</div>
        <div class="mt-2 mb-2 font-weight-bold text-danger shp-voucher-code" style="font-size: 2rem; letter-spacing: 2px;">@_firstOrderVoucher.Code</div>
        <div class="mb-3" style="font-size: 1.1rem;">Được giảm <strong>@_firstOrderVoucher.DiscountPercent%</strong> khi đặt đơn đầu tiên.</div>
        <button class="btn btn-primary btn-block" style="min-height: 48px; font-size: 1.2rem; font-weight: bold;" @onclick="UseVoucher">Dùng ngay</button>
    </div>
}

@* Item 238: nút bật/tắt chế độ "Gọn" — nhớ lựa chọn cho lần sau. *@
<div class="d-flex justify-content-end mb-2">
    <button type="button" class="btn btn-sm @(_compactMode ? "btn-primary" : "btn-outline-secondary")"
            @onclick="ToggleCompactMode" aria-pressed="@_compactMode"
            title="Chế độ Gọn: ẩn banner khuyến mãi, chỉ hiện menu để đặt nhanh"
            style="min-height: 44px;">
        @(_compactMode ? "☑ Chế độ Gọn: Bật" : "☐ Chế độ Gọn")
    </button>
</div>

<ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item">
        <a href="javascript:void(0)" role="tab" aria-selected="@(_activeTab == "products" ? "true" : "false")" class="nav-link @(_activeTab == "products" ? "active" : "")" @onclick='() => _activeTab = "products"' style="cursor: pointer;">🍚 Tất cả món</a>
    </li>
    <li class="nav-item">
        <a href="javascript:void(0)" role="tab" aria-selected="@(_activeTab == "compare" ? "true" : "false")" class="nav-link @(_activeTab == "compare" ? "active" : "")" @onclick='() => _activeTab = "compare"' style="cursor: pointer;">📊 Xôi nào hợp bạn?</a>
    </li>
</ul>

@if (_activeTab == "compare")
{
    <div class="card mb-4">
        <div class="card-body">
            <h4 class="card-title">Xôi nào hợp bạn?</h4>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="thead-dark"><tr><th scope="col">Món</th><th scope="col">Vị</th><th scope="col">Giá</th><th scope="col">Hợp với</th></tr></thead>
                    <tbody>
                        <tr><td><strong>Xôi gấc</strong></td><td>Ngọt nhẹ, béo</td><td>35k</td><td>Tiệc, cúng, biếu</td></tr>
                        <tr><td><strong>Xôi xéo</strong></td><td>Mặn, thơm hành</td><td>25k</td><td>Ăn sáng mỗi ngày</td></tr>
                        <tr><td><strong>Xôi đỗ</strong></td><td>Bùi, dẻo</td><td>25k</td><td>Người thích vị quê</td></tr>
                        <tr><td><strong>Xôi vò</strong></td><td>Tơi, không ngán</td><td>30k</td><td>Ăn trưa văn phòng</td></tr>
                        <tr><td><strong>Xôi ngũ sắc</strong></td><td>Đẹp mắt, dẻo</td><td>40k</td><td>Mâm cỗ, chụp ảnh</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
@if (_loadFailed)
{
    @* Wave 6d (item 38): friendly full-page error, PWA offline.html look. *@
    <div class="card shp-err-card">
        <div class="card-body text-center py-5">
            <div class="shp-err-emoji">😞</div>
            <h2 class="shp-err-title">Không kết nối được tới máy chủ</h2>
            <p class="mb-4 shp-err-desc">Kiểm tra mạng rồi thử lại.</p>
            <button class="btn shp-err-retry" @onclick="RetryLoad">Thử lại</button>
        </div>
    </div>
}
else
{
@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="alert alert-danger">@_loadError</div>
}
}

@if (_combos != null && _combos.Count > 0)
{
    <h4 class="mb-3">🎉 Combo gia đình <small class="text-muted">— tiết kiệm hơn gọi lẻ</small></h4>
    <div class="row">
        @foreach (var combo in _combos)
        {
            <div class="col-md-6 mb-4" @key="combo.Id">
                <div class="card h-100 border-warning">
                    <div class="card-body">
                        <h5 class="card-title">
                            @combo.Name
                            <span class="badge badge-warning ml-1">COMBO</span>
                        </h5>
                        <p class="card-text text-muted small">@combo.Description</p>
                        <ul class="list-unstyled small mb-2">
                            @foreach (var comboItem in combo.Items)
                            {
                                <li>• @comboItem.ProductName <span class="text-muted">× @comboItem.Quantity</span></li>
                            }
                        </ul>
                        <div class="d-flex align-items-center justify-content-between">
                            <strong class="text-danger" style="font-size: 1.3rem;">@FormatPrice(combo.Price)</strong>
                            <button class="btn btn-primary" disabled="@OrdersPaused" @onclick="() => AddComboToCart(combo)">
                                Thêm combo vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_products == null)
{
    <p><em>Đang tải sản phẩm...</em></p>
}
else
{
    <!-- Filters: categories + dietary tags + sort + branch -->
    

    @* Item 118: time-based suggestions — pure client-side by hour. *@
    @if (_suggestions.Count > 0)
    {
        <h4 class="mb-3">@_suggestionTitle</h4>
        <div class="row">
            @foreach (var product in _suggestions)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4" @key="product.Id">
                    <div class="card h-100 border-info">
                        <a href="javascript:void(0)" @onclick="() => OpenQuickView(product)" title="Xem nhanh @product.Name">
                            <img class="card-img-top" src="@ProductImage(product)" alt="@product.Name" loading="lazy" />
                        </a>
                        <div class="card-body py-2">
                            <a href="javascript:void(0)" class="text-dark" @onclick="() => OpenQuickView(product)"><strong>@product.Name</strong></a>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                @* bug-hunt 2026-10-20: gợi ý từng hiện giá gốc (product.Price)
                                   trong khi card chính niêm yết giá KM (item 256) và AddToCart
                                   cũng cộng giỏ theo giá KM — khách thấy 25.000đ nhưng giỏ
                                   tính 20.000đ. Hiển thị cùng luật với card chính. *@
                                @if (CardPromoPrice(product) is decimal suggPromo)
                                {
                                    <span><s class="text-muted small mr-1">@FormatPrice(DisplayPrice(product))</s><strong class="text-danger">@FormatPrice(suggPromo)</strong></span>
                                }
                                else
                                {
                                    <strong class="text-danger">@FormatPrice(DisplayPrice(product))</strong>
                                }
                                <button class="btn btn-sm btn-primary" @onclick="() => AddToCart(product)" disabled="@(!CanOrder(product))"
                                        aria-label="@(CanOrder(product) ? $"Thêm {product.Name} vào giỏ hàng" : null)">@AddButtonLabel(product, "+ Thêm")</button>
                            </div>
                            @* Item 101: ask about this dish on Zalo. *@
                            @if (ShowZaloButton)
                            {
                                <a class="btn btn-sm btn-outline-success btn-block mt-1" href="@ZaloChatUrl(product.Name)"
                                   target="_blank" rel="noopener" title="Hỏi về @product.Name qua Zalo">💬 Hỏi qua Zalo</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (_filteredProducts.Count == 0)
    {
        <div class="alert alert-info">Không có món nào phù hợp với bộ lọc. <a href="javascript:void(0)" @onclick="ClearFilters">Xóa bộ lọc</a></div>
    }
    else
    {
        <div class="row shop-desktop-grid">
            @foreach (var product in _filteredProducts)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4" @key="product.Id">
                    <div class="card h-100">
                        <a href="javascript:void(0)" @onclick="() => OpenQuickView(product)" title="Xem nhanh @product.Name" class="shop-img-wrap">
                            <img class="card-img-top" src="@ProductImage(product)" alt="@product.Name" loading="lazy" style="height: 200px; object-fit: cover;" />
                            @if (!CanOrder(product))
                            {
                                <span class="shop-soldout-overlay">Hết hôm nay 😢</span>
                            }
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a href="javascript:void(0)" class="text-dark" @onclick="() => OpenQuickView(product)">@product.Name</a>
                            </h5>
                            @* Wave 6b (item 26): "★ 4.8 (12)" — hidden when no reviews. *@
                            @if (RatingText(product) is string cardRating)
                            {
                                <div class="small text-muted mb-1" role="img" aria-label="@RatingAriaLabel(product)"><span aria-hidden="true">@cardRating</span></div>
                            }
                            @* BA shop item 4: social proof — "Đã bán N suất". *@
                            @if (_soldQuantities.TryGetValue(product.Id, out var soldQty) && soldQty > 0)
                            {
                                <div class="small text-muted mb-1">🔥 Đã bán @soldQty.ToString("N0") suất</div>
                            }
                            <div class="mb-1">
                                @foreach (var badge in GetCardBadges(product).Take(2))
                                {
                                    <span class="badge @badge.Css mr-1">@badge.Text</span>
                                }
                            </div>
                            <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                            @* Item 256: giá KM hiện ngay trên card: "giá gốc → giá KM". *@
                            <p class="card-text mb-1">
                                @if (CardPromoPrice(product) is decimal promo)
                                {
                                    <s class="text-muted mr-1" style="font-size: 1rem;">@FormatPrice(DisplayPrice(product))</s>
                                    <strong class="text-danger" style="font-size: 1.2rem;">@FormatPrice(promo)<small class="text-muted">@ShopProductModel.UnitSuffix(product)</small></strong>
                                    <span class="badge badge-danger ml-1">−@((int)Math.Round((1 - promo / DisplayPrice(product)) * 100))%</span>
                                }
                                else
                                {
                                    <strong class="text-danger" style="font-size: 1.2rem;">@FormatPrice(DisplayPrice(product))<small class="text-muted">@ShopProductModel.UnitSuffix(product)</small></strong>
                                }
                            </p>
                            @if (product.Sizes != null && product.Sizes.Count > 0)
                            {
                                <div class="shop-size-chips mb-2">
                                    @foreach (var size in product.Sizes)
                                    {
                                        <button type="button"
                                                class="shop-size-chip @(SelectedSizeId(product) == size.Id ? "active" : "")"
                                                @onclick="() => SelectCardSize(product, size.Id)"
                                                title="@size.Name">
                                            @size.Name <span class="shop-size-price">@FormatPrice(size.Price)</span>
                                        </button>
                                    }
                                </div>
                            }
                            <div class="d-flex align-items-center shop-add-row">
                                <input type="number" min="1" max="99" class="form-control mr-2" style="width: 80px;"
                                       aria-label="Số lượng" @bind="_quantities[product.Id]" />
                                <button class="btn btn-primary flex-grow-1" @onclick="() => AddToCart(product)" disabled="@(!CanOrder(product))"
                                        aria-label="@(CanOrder(product) ? $"Thêm {product.Name} vào giỏ hàng" : null)">
                                    @AddButtonLabel(product)
                                </button>
                            </div>
                            @* Item 101: ask about this dish on Zalo. *@
                            @if (ShowZaloButton)
                            {
                                <a class="btn btn-sm btn-outline-success btn-block mt-2" href="@ZaloChatUrl(product.Name)"
                                   target="_blank" rel="noopener" title="Hỏi về @product.Name qua Zalo">💬 Hỏi qua Zalo</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Mobile kiểu ShopeeFood: sidebar danh mục + món hàng ngang (ẩn trên PC). *@
        <div class="shop-mobile-wrap">
            <div class="shop-mobile-body">
                <aside class="shop-cat-sidebar">
                    <button type="button" class="shop-cat-item @CategoryTabClass(null)" @onclick="() => SetCategory(null)"
                            aria-pressed="@(_categoryFilter == null)">Tất cả</button>
                    @foreach (var cat in _categories)
                    {
                        <button type="button" class="shop-cat-item @CategoryTabClass(cat)" @onclick="() => SetCategory(cat)"
                                aria-pressed="@string.Equals(_categoryFilter, cat, StringComparison.OrdinalIgnoreCase)">@cat</button>
                    }
                </aside>
                <div class="shop-mobile-items">
                    @foreach (var product in _filteredProducts)
                    {
                        <div class="shop-row-item" @key="product.Id">
                            <a href="javascript:void(0)" @onclick="() => OpenQuickView(product)" class="shop-row-img">
                                <img src="@ProductImage(product)" alt="@product.Name" loading="lazy" />
                                @if (!CanOrder(product))
                                {
                                    <span class="shop-soldout-overlay">Hết</span>
                                }
                            </a>
                            <div class="shop-row-info">
                                <a href="javascript:void(0)" class="shop-row-name" @onclick="() => OpenQuickView(product)">@product.Name</a>
                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <div class="shop-row-desc">@product.Description</div>
                                }
                                <div class="shop-row-meta">
                                    @if (_soldQuantities.TryGetValue(product.Id, out var sq) && sq > 0)
                                    {
                                        <span>@FormatSoldShort(sq) đã bán</span>
                                    }
                                    @if (RatingText(product) is string r)
                                    {
                                        <span class="shop-row-dot">·</span><span>@r</span>
                                    }
                                </div>
                                @* Item 256: giá KM trên hàng mobile. *@
                                <div class="shop-row-price">
                                    @if (CardPromoPrice(product) is decimal rowPromo)
                                    {
                                        <s class="text-muted mr-1" style="font-size: 0.85rem;">@FormatPrice(DisplayPrice(product))</s>
                                        <span class="text-danger font-weight-bold">@FormatPrice(rowPromo)</span>
                                    }
                                    else
                                    {
                                        @FormatPrice(DisplayPrice(product))
                                    }
                                    <small>@ShopProductModel.UnitSuffix(product)</small>
                                </div>
                            </div>
                            <div class="shop-row-action">
                                @{
                                    var cartQty = CartQtyFor(product.Id);
                                }
                                @if (cartQty > 0)
                                {
                                    <div class="shop-row-stepper">
                                        <button type="button" @onclick="() => DecRowQty(product)" aria-label="Giảm số lượng @product.Name">−</button>
                                        <span>@cartQty</span>
                                        <button type="button" @onclick="() => IncRowQty(product)" aria-label="Tăng số lượng @product.Name">+</button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="shop-row-add" @onclick="() => QuickAddRow(product)" disabled="@(!CanOrder(product))" aria-label="Thêm @product.Name">+</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

@if (_quickView != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="qv-modal-title" @onclick="CloseQuickView" @onkeydown="QuickViewKeyDown">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable shop-quickview-dialog" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="qv-modal-title">
                        @_quickView.Name
                        @if (_quickView.IsNew)
                        {
                            <span class="badge badge-success ml-1">Món mới</span>
                        }
                        @if (_quickView.IsSignature)
                        {
                            <span class="badge badge-warning ml-1">Signature</span>
                        }
                    </h5>
                    <button type="button" class="close" aria-label="Đóng" @onclick="CloseQuickView">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <img src="@ProductImage(_quickView)" alt="@_quickView.Name" loading="lazy"
                         class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;" />
                    <p class="text-muted">@_quickView.Description</p>
                    @* Wave 6b (item 26): "★ 4.8 (12)" — hidden when no reviews. *@
                    @if (RatingText(_quickView) is string quickViewRating)
                    {
                        <p class="mb-2"><span class="text-muted" role="img" aria-label="@RatingAriaLabel(_quickView)"><span aria-hidden="true">@quickViewRating</span></span></p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_quickView.AllergenInfo))
                    {
                        <div class="alert alert-warning py-2">
                            <small>⚠️ <strong>Thông tin dị ứng:</strong> @_quickView.AllergenInfo</small>
                        </div>
                    }
                    @if (_quickView.Sizes != null && _quickView.Sizes.Count > 0)
                    {
                        <p class="mb-1"><strong>Chọn size:</strong></p>
                        @foreach (var size in _quickView.Sizes)
                        {
                            <div class="form-check" @key="size.Id">
                                <input class="form-check-input" type="radio" name="qv-size" id="qv-size-@size.Id"
                                       checked="@(_quickViewSizeId == size.Id)"
                                       @onchange="() => _quickViewSizeId = size.Id" />
                                <label class="form-check-label" for="qv-size-@size.Id">
                                    @size.Name — <strong class="text-danger">@FormatPrice(size.Price)</strong>
                                </label>
                            </div>
                        }
                    }
                    @if (_toppings != null && _toppings.Count > 0)
                    {
                        <p class="mb-1 mt-2"><strong>Ăn kèm thêm:</strong></p>
                        @foreach (var topping in _toppings)
                        {
                            <div class="form-check" @key="topping.Id">
                                <input class="form-check-input" type="checkbox" id="qv-top-@topping.Id"
                                       checked="@_quickViewToppings.Contains(topping.Id)"
                                       @onchange="(e) => ToggleQuickViewTopping(topping.Id, (bool)e.Value)" />
                                <label class="form-check-label" for="qv-top-@topping.Id">
                                    @topping.Name <span class="text-muted">+@FormatPrice(topping.ExtraPrice)</span>
                                </label>
                            </div>
                        }
                    }
                    <p class="mt-3">
                        @* bug-hunt 2026-10-20: hiện "giá gốc → giá KM" (đã gồm
                           topping) như card và popup mobile — trước đây modal PC
                           chỉ hiện một giá duy nhất. *@
                        @if (QuickViewPromoUnitPrice() is decimal qvPromoPc)
                        {
                            <s class="text-muted mr-2" style="font-size: 1rem;">@FormatPrice(QuickViewBasePrice() + QuickViewToppingsTotal())</s>
                            <strong class="text-danger" style="font-size: 1.4rem;">@FormatPrice(qvPromoPc)</strong>
                        }
                        else
                        {
                            <strong class="text-danger" style="font-size: 1.4rem;">@FormatPrice(QuickViewUnitPrice())</strong>
                        }
                        <small class="text-muted">@ShopProductModel.UnitSuffix(_quickView)</small>
                        @if (IsSoldOut(_quickView))
                        {
                            <span class="badge badge-secondary ml-2">Tạm hết</span>
                        }
                        else if (IsDailyLimitReached(_quickView))
                        {
                            @* SH4: daily limit exhausted but product still Active. *@
                            <span class="badge badge-secondary ml-2">Hết hôm nay</span>
                        }
                        @if (!IsSoldOut(_quickView) && !IsInSaleHours(_quickView))
                        {
                            <span class="badge badge-info ml-2">⏰ Chỉ bán @SaleHoursLabel(_quickView)</span>
                        }
                        @* Item 165: low daily stock (only when some portions remain). *@
                        @if (!IsSoldOut(_quickView) && !IsDailyLimitReached(_quickView) && _quickView.RemainingToday.HasValue && _quickView.RemainingToday.Value < 10)
                        {
                            <span class="badge badge-warning ml-2">Còn @_quickView.RemainingToday suất</span>
                        }
                    </p>
                    <div class="d-flex align-items-center">
                        <label class="mr-2 mb-0">Số lượng:</label>
                        <QuantitySpinner @bind-Value="_quickViewQty" Min="1" Max="99" />
                    </div>
                    @* Wave 6a (item 24): per-item note flows into the order line. *@
                    <div class="form-group mt-2 mb-0">
                        <label for="qv-note"><small class="text-muted">📝 Ghi chú món <span class="text-muted">(vd: ít hành, nhiều đậu)</span></small></label>
                        <input id="qv-note" class="form-control form-control-sm" maxlength="500"
                               placeholder="Ghi chú cho món này (tùy chọn)" @bind="_quickViewNote" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseQuickView">Đóng</button>
                    @* Item 237: chia sẻ món lên Zalo/Facebook. *@
                    <div class="btn-group" role="group" aria-label="Chia sẻ món">
                        <button type="button" class="btn btn-outline-primary" @onclick="ShareDishAsync" title="Chia sẻ món này">
                            📤 Chia sẻ
                        </button>
                    </div>
                    @if (_showShareRow)
                    {
                        <div class="w-100 d-flex mt-2" style="gap: 8px;">
                            <a class="btn btn-sm btn-outline-primary flex-fill" style="min-height: 44px; display: flex; align-items: center; justify-content: center;"
                               href="@FacebookShareUrl(_quickView)" target="_blank" rel="noopener" title="Chia sẻ lên Facebook">
                                <i class="fa-brands fa-facebook mr-1"></i> Facebook
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-info flex-fill" style="min-height: 44px;"
                                    @onclick="ShareToZaloAsync" title="Chia sẻ lên Zalo">
                                💬 Zalo
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" style="min-height: 44px;"
                                    @onclick="CopyDishLinkAsync" title="Sao chép link món">
                                🔗 Copy link
                            </button>
                        </div>
                    }
                    @* Item 101: ask about this dish on Zalo. *@
                    @if (ShowZaloButton)
                    {
                        <a class="btn btn-outline-success" href="@ZaloChatUrl(_quickView.Name)" target="_blank" rel="noopener">💬 Hỏi qua Zalo</a>
                    }
                    <button type="button" class="btn btn-primary" @onclick="AddQuickViewToCart" disabled="@(!CanOrder(_quickView))">
                        @(CanOrder(_quickView) ? $"{ShopI18n.Translate("add_to_cart")} — {FormatPrice(QuickViewUnitPrice() * (_quickViewQty > 0 ? _quickViewQty : 1))}" : AddButtonLabel(_quickView))
                    </button>
                </div>
            </div>
            @* Mobile bottom sheet kiểu ShopeeFood (ẩn trên PC). *@
            <div class="qv-sheet" @onclick:stopPropagation="true">
                <div class="qv-sheet-banner">
                    <img src="@ProductImage(_quickView)" alt="@_quickView.Name" />
                </div>
                <div class="qv-sheet-top">
                    <span class="qv-sheet-title">Thêm món mới</span>
                    <button type="button" class="qv-sheet-close" @onclick="CloseQuickView" aria-label="Đóng">×</button>
                </div>
                <div class="qv-sheet-body">
                    <div class="qv-sheet-product">
                        <img src="@ProductImage(_quickView)" alt="@_quickView.Name" class="qv-sheet-thumb" />
                        <div class="qv-sheet-pinfo">
                            <div class="qv-sheet-pname">@_quickView.Name</div>
                            @if (_soldQuantities.TryGetValue(_quickView.Id, out var qvSold) && qvSold > 0)
                            {
                                <div class="qv-sheet-meta">@FormatSoldShort(qvSold) đã bán</div>
                            }
                            @* Item 256: giá KM trong popup xem nhanh.
                               bug-hunt 2026-10-20: giá KM phải gồm topping đã chọn
                               (khớp số giỏ hàng thực tính ở AddQuickViewToCart);
                               giá gạch bỏ là giá GỐC (trước đây gạch bỏ giá đã KM
                               và hiện giá KM món lẻ không topping). *@
                            <div class="qv-sheet-price">
                                @if (QuickViewPromoUnitPrice() is decimal qvPromoUnit)
                                {
                                    <s class="text-muted mr-1" style="font-size: 0.9rem;">@FormatPrice(QuickViewBasePrice() + QuickViewToppingsTotal())</s>
                                    <span class="text-danger">@FormatPrice(qvPromoUnit)</span>
                                }
                                else
                                {
                                    @FormatPrice(QuickViewUnitPrice())
                                }
                            </div>
                        </div>
                        <QuantitySpinner @bind-Value="_quickViewQty" Min="1" Max="99" />
                    </div>
                    @if (_quickView.Sizes != null && _quickView.Sizes.Count > 0)
                    {
                        <div class="qv-sheet-section">Chọn size</div>
                        @foreach (var size in _quickView.Sizes)
                        {
                            <div class="qv-sheet-opt" @key="size.Id" @onclick="() => _quickViewSizeId = size.Id"
                                 role="button" tabindex="0" aria-pressed="@(_quickViewSizeId == size.Id)"
                                 @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") _quickViewSizeId = size.Id; })">
                                <span>@size.Name <span class="qv-sheet-opt-price">@FormatPrice(size.Price)</span></span>
                                <input type="radio" name="qv-sheet-size" checked="@(_quickViewSizeId == size.Id)" readonly tabindex="-1" />
                            </div>
                        }
                    }
                    @if (_toppings != null && _toppings.Count > 0)
                    {
                        <div class="qv-sheet-section">Thêm (Topping)</div>
                        @foreach (var topping in _toppings)
                        {
                            <div class="qv-sheet-opt" @key="topping.Id" @onclick="() => ToggleQuickViewTopping(topping.Id, !_quickViewToppings.Contains(topping.Id))"
                                 role="button" tabindex="0" aria-pressed="@(_quickViewToppings.Contains(topping.Id))"
                                 @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleQuickViewTopping(topping.Id, !_quickViewToppings.Contains(topping.Id)); })">
                                <span>@topping.Name <span class="qv-sheet-opt-price">@FormatPrice(topping.ExtraPrice)</span></span>
                                <input type="checkbox" checked="@_quickViewToppings.Contains(topping.Id)" readonly tabindex="-1" />
                            </div>
                        }
                    }
                    <div class="qv-sheet-note">
                        <span class="qv-sheet-note-icon">📝</span>
                        <input class="qv-sheet-note-input" maxlength="500"
                               aria-label="Ghi chú cho quán" placeholder="Ghi chú cho quán" @bind="_quickViewNote" />
                    </div>
                </div>
                <div class="qv-sheet-footer">
                    @* Item 237: chia sẻ món (mobile). *@
                    <button type="button" class="qv-sheet-share" @onclick="ShareDishAsync" aria-label="Chia sẻ món này" title="Chia sẻ">
                        📤
                    </button>
                    <button type="button" class="qv-sheet-add" @onclick="AddQuickViewToCart" disabled="@(!CanOrder(_quickView))">
                        Thêm vào giỏ hàng - @FormatPrice(QuickViewUnitPrice() * (_quickViewQty > 0 ? _quickViewQty : 1))
                    </button>
                </div>
                @if (_showShareRow)
                {
                    <div class="qv-sheet-share-row">
                        <a class="qv-sheet-share-btn" href="@FacebookShareUrl(_quickView)" target="_blank" rel="noopener">
                            <i class="fa-brands fa-facebook"></i> Facebook
                        </a>
                        <button type="button" class="qv-sheet-share-btn" @onclick="ShareToZaloAsync">💬 Zalo</button>
                        <button type="button" class="qv-sheet-share-btn" @onclick="CopyDishLinkAsync">🔗 Copy link</button>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
