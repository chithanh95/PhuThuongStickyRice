            <textarea class="form-control form-control-sm mb-3" rows="2" @bind="_surveyComment"
                      aria-label="Góp ý thêm (tùy chọn)"
                      placeholder="Góp ý thêm (tùy chọn)..."></textarea>
            @if (!string.IsNullOrEmpty(_surveyError))
            {
                <div class="alert alert-danger py-1 small">@_surveyError</div>
            }
            <div class="d-flex to-survey-actions">
                <button class="btn flex-fill to-survey-submit"
                        @onclick="SubmitSurveyAsync" disabled="@(_surveySubmitting || _surveyRating == 0)">
                    @(_surveySubmitting ? "Đang gửi..." : "Gửi đánh giá")
                </button>
                <button class="btn btn-outline-secondary flex-fill to-survey-cancel"
                        @onclick="DismissSurveyAsync" disabled="@_surveySubmitting">
                    Để sau
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string _orderNumber;
    private string _phone;
