    private static int ParseQty(object value)
    {
        return int.TryParse(value?.ToString(), out var qty) ? Math.Max(0, Math.Min(100, qty)) : 0;
    }

    /// <summary>
    /// Wave 6a (item 21): "Đặt lại đơn này" — restores the given order's
    /// lines into the cart by matching ProductId against the current
    /// catalog. Size/toppings are best-effort (matched by name); products
    /// that no longer exist are skipped and reported via toast.
    /// </summary>
    private async Task ReorderAsync(TrackedOrderModel order)
    {
        _reorderMessage = null;
        if (order == null || _reordering)
        {
            return;
        }

        _reordering = true;
        try
        {
            var productsTask = ShopService.GetProductsAsync();
            var combosTask = ShopService.GetCombosAsync();
            var toppingsTask = ShopService.GetToppingsAsync();
            await Task.WhenAll(productsTask, combosTask, toppingsTask);

            var products = (productsTask.Result?.Items ?? new System.Collections.Generic.List<ShopProductModel>())
                .ToDictionary(p => p.Id);
            var combos = (combosTask.Result ?? new System.Collections.Generic.List<ComboModel>())
                .ToDictionary(c => c.Id);
            var toppings = toppingsTask.Result ?? new System.Collections.Generic.List<ToppingModel>();

            var restored = 0;
            var skipped = 0;
            foreach (var line in order.Lines)
            {
                if (line.Quantity < 1)
                {
                    continue;
                }

                var qty = Math.Min(line.Quantity, 99);

                if (line.IsCombo)
                {
                    if (combos.TryGetValue(line.ProductId, out var combo) && combo.IsActive)
                    {
                        CartState.AddCombo(combo, qty);
                        restored++;
                    }
                    else
                    {
                        skipped++;
                    }

                    continue;
                }

                if (!products.TryGetValue(line.ProductId, out var product) || product.Status != "Active")
                {
                    skipped++;
                    continue;
                }

                // Best-effort size match by name.
                ProductSizeOptionModel size = null;
                if (!string.IsNullOrWhiteSpace(line.SizeName))
                {
                    size = product.Sizes?.FirstOrDefault(s =>
                        string.Equals(s.Name?.Trim(), line.SizeName.Trim(),
                            StringComparison.OrdinalIgnoreCase));
                }

                // Best-effort topping match by name (comma-separated).
                var chosen = new System.Collections.Generic.List<ToppingModel>();
                if (!string.IsNullOrWhiteSpace(line.ToppingNames))
                {
                    foreach (var name in line.ToppingNames.Split(
                        new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        var trimmed = name.Trim();
                        if (trimmed.Length == 0)
                        {
                            continue;
                        }

                        var topping = toppings.FirstOrDefault(t =>
                            !chosen.Contains(t)
                            && string.Equals(t.Name?.Trim(), trimmed,
                                StringComparison.OrdinalIgnoreCase));
                        if (topping != null)
                        {
                            chosen.Add(topping);
                        }
                    }
                }

                var toppingsTotal = chosen.Sum(t => t.ExtraPrice);
                CartState.AddConfigured(
                    product.Id, product.Name, product.Code,
                    (size?.Price ?? product.Price) + toppingsTotal, qty,
                    size?.Id, size?.Name ?? line.SizeName,
                    chosen.Select(t => t.Id).ToList(),
                    line.ToppingNames, toppingsTotal,
                    isCombo: false,
                    note: line.Note);
                restored++;
            }

            if (restored > 0)
            {
                var message = $"Đã khôi phục {restored} món vào giỏ";
                if (skipped > 0)
                {
                    message += $" ({skipped} món không còn bán nên đã bỏ qua)";
                }

                Toasts.Show(message, "Xem giỏ hàng", "/cart");
                Navigation.NavigateTo("/cart");
            }
            else
            {
                _reorderMessage = "Không khôi phục được món nào (các món trong đơn đã ngừng bán).";
            }
        }
        catch (Exception)
        {
            _reorderMessage = "Không khôi phục được giỏ hàng. Vui lòng thử lại.";
        }
        finally
        {
            _reordering = false;
        }
    }

    private async Task SaveEditedLines()
    {
        _editError = null;
        _savingLines = true;
        try
        {
            var lines = _editQuantities
                .Select(kv => new { LineId = kv.Key, Quantity = kv.Value })
                .Cast<object>()
                .ToList();
            _order = await Wave2Service.UpdateOrderLinesAsync(
                _order.OrderNumber, _order.CustomerPhone, lines);
            _editingLines = false;
        }
        catch (Exception ex)
        {
            _editError = ex.Message.Contains("tối thiểu") || ex.Message.Contains("ít nhất")
                ? ex.Message
                : "Không lưu được thay đổi. Vui lòng thử lại.";
        }
        finally
        {
            _savingLines = false;
        }
    }

    private async Task SubmitReview()
    {
        _reviewError = null;
        if (_rating < 1)
        {
            _reviewError = "Vui lòng chọn số sao đánh giá.";
            return;
        }

        _submittingReview = true;
        try
        {
            // Wave 6b (item 26): per-dish stars for lines the customer rated.
            var dishRatings = _order.Lines?
                .Where(l => _lineRatings.TryGetValue(l.Id, out var r) && r >= 1)
                .Select(l => (object)new { ProductId = l.ProductId, Rating = _lineRatings[l.Id] })
                .ToList() ?? new List<object>();
            await Wave2Service.SubmitReviewAsync(
                _order.OrderNumber, _order.CustomerPhone, _rating, _reviewComment, dishRatings);
            _reviewSubmitted = true;
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message.Contains("đã được đánh giá") || ex.Message.Contains("hoàn thành")
                ? ex.Message
                : "Không gửi được đánh giá. Vui lòng thử lại.";
        }
        finally
        {
            _submittingReview = false;
        }
    }

    private void StartPolling()
    {
        StopPolling();
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                var fresh = await ShopService.TrackOrderAsync(_order.OrderNumber, _order.CustomerPhone);
                await InvokeAsync(() =>
                {
                    _order = fresh;
                    if (fresh.PaymentStatus != "Unpaid" && fresh.PaymentStatus != "PendingConfirmation")
                    {
                        StopPolling();
                    }

                    StateHasChanged();
                });
            }
            catch (Exception)
            {
                // Polling is best-effort; the manual lookup still works.
            }
        }, null, 5000, 5000);
    }

    private void StopPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private async Task MarkTransferred()
    {
        _transferMessage = null;
        _transferError = null;
        _markingTransferred = true;
        try
        {
            var updated = await ShopService.MarkTransferredAsync(_order.Id, _order.CustomerPhone);
            _order.PaymentStatus = updated.PaymentStatus;
            _transferMessage = "Đã ghi nhận bạn đã chuyển khoản. Shop sẽ xác nhận thanh toán sớm.";
            StartPolling();
        }
        catch (Exception)
        {
            _transferError = "Không ghi nhận được. Vui lòng thử lại hoặc liên hệ shop.";
        }
        finally
        {
            _markingTransferred = false;
        }
    }

    private async Task PayWithMoMo()
    {
        _momoError = null;
        _payingMoMo = true;
        try
