        try
        {
            var link = $"{Navigation.BaseUri.TrimEnd('/')}/track-order"
                + $"?orderNumber={Uri.EscapeDataString(_order.OrderNumber)}";
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);
            _copyMessage = "Đã sao chép link thanh toán! Mở link này trên thiết bị khác để thanh toán sau.";
        }
