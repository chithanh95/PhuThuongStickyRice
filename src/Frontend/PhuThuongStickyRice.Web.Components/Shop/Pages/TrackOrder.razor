@page "/track-order"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using Microsoft.JSInterop
@inject ShopService ShopService
@inject CartState CartState
@inject ToastService Toasts
@inject Wave2Service Wave2Service
@inject Wave4Service Wave4Service
@inject Wave5Service Wave5Service
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<h3>Tra cứu đơn hàng</h3>

@* Item 121: daily check-in — one per phone per day, awards loyalty points. *@
<div class="card mb-3">
    <div class="card-body py-2 d-flex flex-wrap align-items-center">
        <strong class="mr-2">📅 Điểm danh hôm nay</strong>
        <input class="form-control form-control-sm mr-2" style="max-width:160px" @bind="_checkInPhone"
               placeholder="SĐT của bạn" inputmode="tel" />
        <button class="btn btn-sm btn-outline-success" @onclick="CheckInAsync" disabled="@_checkingIn">
            @(_checkingIn ? "Đang điểm danh..." : "Điểm danh")
        </button>
        @if (_checkInResult != null)
        {
            <span class="ml-2">
                @if (_checkInResult.AlreadyCheckedIn)
                {
                    <span class="badge badge-info">Đã điểm danh hôm nay</span>
                }
                else
                {
                    <span class="badge badge-success">+@_checkInResult.PointsAwarded điểm</span>
                }
                <small class="text-muted ml-1">🔥 @_checkInResult.StreakDays ngày liên tiếp • @_checkInResult.LoyaltyPoints điểm</small>
            </span>
        }
        @if (!string.IsNullOrEmpty(_checkInError))
        {
            <small class="text-danger ml-2">@_checkInError</small>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row">
            <div class="col-md-4">
                <label>Mã đơn hàng</label>
                <input class="form-control" @bind="_orderNumber" placeholder="PX-20261014-0001" />
            </div>
            <div class="col-md-4">
                <label>Số điện thoại đặt hàng</label>
                <input class="form-control" @bind="_phone" placeholder="0901234567" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary" @onclick="Lookup" disabled="@_loading">
                    @(_loading ? "Đang tra cứu..." : "Tra cứu")
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mt-3 mb-0">@_error</div>
        }
    </div>
</div>

@* Lịch sử đơn hàng theo SĐT — không cần đăng nhập. *@
<div class="card mb-3">
    <div class="card-body">
        <h5>📋 Lịch sử đơn hàng</h5>
        <p class="text-muted"><small>Nhập số điện thoại đã dùng để đặt hàng để xem toàn bộ đơn cũ và đặt lại 1 chạm.</small></p>
        <div class="form-row">
            <div class="col-md-4">
                <input class="form-control" @bind="_historyPhone" placeholder="0901234567" inputmode="tel" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-outline-primary" @onclick="LoadHistoryAsync" disabled="@_historyLoading">
                    @(_historyLoading ? "Đang tải..." : "Xem lịch sử")
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_historyError))
        {
            <div class="alert alert-danger mt-3 mb-0">@_historyError</div>
        }
        @if (_history != null)
        {
            if (_history.Count == 0)
            {
                <p class="text-muted mt-3 mb-0"><em>Số này chưa có đơn hàng nào.</em></p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Mã đơn</th><th>Ngày đặt</th><th class="text-right">Tổng tiền</th><th>Trạng thái</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var h in _history)
                            {
                                <tr>
                                    <td><strong>@h.OrderNumber</strong></td>
                                    <td>@h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-right">@FormatPrice(h.TotalAmount)</td>
                                    <td>@OrderStatusBadge(h.Status)</td>
                                    <td class="text-right text-nowrap">
                                        <button class="btn btn-sm btn-outline-info mr-1" @onclick="() => ViewHistoryDetail(h)">Chi tiết</button>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ReorderAsync(h)" disabled="@_reordering">🔄 Đặt lại</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@if (_order != null)
{
    <div class="card mb-3">
        <div class="card-header">
            Đơn hàng <strong>@_order.OrderNumber</strong>
            <span class="float-right">@OrderStatusBadge(_order.Status)</span>
        </div>
        <div class="card-body">
            @* Wave 6a (item 21): reorder — restores the order's lines into the cart. *@
            <div class="mb-2">
                <button class="btn btn-outline-success btn-sm" @onclick="() => ReorderAsync(_order)" disabled="@_reordering">
                    @(_reordering ? "Đang khôi phục..." : "🔄 Đặt lại đơn này")
                </button>
                @if (!string.IsNullOrEmpty(_reorderMessage))
                {
                    <small class="text-danger ml-2">@_reorderMessage</small>
                }
            </div>
            <p>
                Ngày đặt: <strong>@_order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong><br />
                Khách hàng: <strong>@_order.CustomerName</strong> — @_order.CustomerPhone<br />
                @if (!string.IsNullOrWhiteSpace(_order.RecipientName))
                {
                    <span>Người nhận: <strong>@_order.RecipientName</strong> — @_order.RecipientPhone<br /></span>
                }
                Địa chỉ: @_order.CustomerAddress
                @if (!string.IsNullOrWhiteSpace(_order.TaxCode))
                {
                    <br /><span>Hóa đơn VAT: @_order.CompanyName (MST: @_order.TaxCode)</span>
                }
                @if (_order.IsGift)
                {
                    <br /><span>🎁 Gói quà@(!string.IsNullOrWhiteSpace(_order.GiftMessage) ? $": {_order.GiftMessage}" : "")</span>
                }
            </p>
            @if (_loyalty != null)
            {
                <p>
                    <small>
                        ⭐ Bạn có <strong>@_loyalty.Points điểm</strong>
                        <span class="badge badge-info">Hạng @_loyalty.Tier</span>
                        @if (!string.IsNullOrWhiteSpace(_loyalty.ReferralCode))
                        {
                            <span class="ml-1">Mã giới thiệu: <strong>@_loyalty.ReferralCode</strong></span>
                        }
                    </small>
                </p>
                <div class="form-row align-items-end mb-2">
                    <div class="col-auto">
                        <label><small>Ngày sinh <small class="text-muted">(để nhận voucher sinh nhật)</small></small></label>
                        <input type="date" class="form-control form-control-sm" @bind="_birthdayInput" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SaveBirthday" disabled="@_savingBirthday">
                            @(_savingBirthday ? "Đang lưu..." : "Lưu ngày sinh")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_birthdayMessage))
                    {
                        <div class="col-12"><small class="text-success">@_birthdayMessage</small></div>
                    }
                </div>
            }
            @if (_order.RequiresDeposit && _order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "Unpaid")
            {
                <div class="alert alert-warning py-2">
                    <small>💰 Đơn này cần <strong>đặt cọc trước</strong> để shop xác nhận. Shop sẽ liên hệ với bạn.</small>
                </div>
            }
            @* Item 119: address book management from the track-order profile. *@
            <div class="card mt-2 mb-2">
                <div class="card-body py-2">
                    <small class="text-muted d-block mb-1">📒 <strong>Sổ địa chỉ</strong> của số @_order.CustomerPhone</small>
                    @if (_addresses == null)
                    {
                        <small><em>Đang tải...</em></small>
                    }
                    else if (_addresses.Count == 0)
                    {
                        <small class="text-muted">Chưa có địa chỉ nào được lưu.</small>
                    }
                    else
                    {
                        @foreach (var a in _addresses)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                                <small><strong>@a.Label:</strong> @a.Address</small>
                                <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteAddressAsync(a)">Xóa</button>
                            </div>
                        }
                    }
                    <div class="form-row mt-2">
                        <div class="col-4">
                            <input class="form-control form-control-sm" @bind="_newAddressLabel" placeholder="Nhãn (Nhà/Cty)" />
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <input class="form-control form-control-sm" @bind="_newAddressText" placeholder="Địa chỉ mới..." />
                                <div class="input-group-append">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="AddAddressAsync" disabled="@_savingAddress">Lưu</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_addressBookMessage))
                    {
                        <small class="text-success">@_addressBookMessage</small>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Món</th><th class="text-right">Đơn giá</th><th class="text-right">SL</th><th class="text-right">Thành tiền</th></tr>
                    </thead>
                <tbody>
                    @foreach (var line in _order.Lines)
                    {
                        <tr>
                            <td>
                                @line.ProductName
                                @if (line.IsCombo)
                                {
                                    <span class="badge badge-warning ml-1">COMBO</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.SizeName))
                                {
                                    <br /><small class="text-muted">Size: @line.SizeName</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.ToppingNames))
                                {
                                    <br /><small class="text-muted">Ăn kèm: @line.ToppingNames</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.Note))
                                {
                                    <br /><small class="text-info">📝 @line.Note</small>
                                }
                            </td>
                            <td class="text-right">@FormatPrice(line.UnitPrice)</td>
                            <td class="text-right">@line.Quantity</td>
                            <td class="text-right">@FormatPrice(line.LineTotal)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (_order.DiscountAmount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-success">Giảm giá @(!string.IsNullOrWhiteSpace(_order.DiscountCode) ? $"({_order.DiscountCode})" : "")</td>
                            <td class="text-right text-success">−@FormatPrice(_order.DiscountAmount)</td>
                        </tr>
                    }
                    @if (_order.TierDiscount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-success">Ưu đãi hạng thành viên</td>
                            <td class="text-right text-success">−@FormatPrice(_order.TierDiscount)</td>
                        </tr>
                    }
                    @if (_order.LoyaltyDiscount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-success">Đổi @_order.LoyaltyPointsRedeemed điểm</td>
                            <td class="text-right text-success">−@FormatPrice(_order.LoyaltyDiscount)</td>
                        </tr>
                    }
                    @if (_order.GiftFee > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-muted">🎁 Phí gói quà</td>
                            <td class="text-right text-muted">+@FormatPrice(_order.GiftFee)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3"><strong>Tổng cộng</strong></td>
                        <td class="text-right"><strong class="text-danger">@FormatPrice(_order.TotalAmount)</strong></td>
                    </tr>
                </tfoot>
            </table>
            </div>
            @if (!string.IsNullOrWhiteSpace(_order.Notes))
            {
                <p><em>Ghi chú: @_order.Notes</em></p>
            }

            @if (_order.Status == "Pending")
            {
                <div class="mb-3">
                    @if (!_editingLines)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="StartEditLines">✏️ Sửa đơn (số lượng)</button>
                        <button class="btn btn-outline-danger btn-sm ml-2" @onclick="CancelOrder" disabled="@_cancelling">
                            @(_cancelling ? "Đang hủy..." : "Hủy đơn")
                        </button>
                        @if (!string.IsNullOrEmpty(_cancelError))
                        {
                            <div class="alert alert-danger mt-2 mb-0">@_cancelError</div>
                        }
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-header py-2"><strong>Sửa số lượng</strong> <small class="text-muted">(0 = bỏ món)</small></div>
                            <div class="card-body py-2">
                                @foreach (var line in _order.Lines)
                                {
                                    <div class="form-row align-items-center mb-1">
                                        <div class="col-8"><small>@line.ProductName</small></div>
                                        <div class="col-4">
                                            <input type="number" class="form-control form-control-sm"
                                                   min="0" max="100" value="@_editQuantities[line.Id]"
                                                   @onchange="(e => _editQuantities[line.Id] = ParseQty(e.Value))" />
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_editError))
                                {
                                    <div class="alert alert-danger mt-2 mb-1">@_editError</div>
                                }
                                <button class="btn btn-success btn-sm mt-2" @onclick="SaveEditedLines" disabled="@_savingLines">
                                    @(_savingLines ? "Đang lưu..." : "Lưu thay đổi")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm mt-2 ml-2" @onclick="() => _editingLines = false">Bỏ qua</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_order.Status == "Completed")
            {
                <div class="card mb-3">
                    <div class="card-header py-2"><strong>Đánh giá đơn hàng</strong></div>
                    <div class="card-body py-2">
                        @if (_reviewSubmitted)
                        {
                            <div class="alert alert-success mb-0">Cảm ơn bạn đã đánh giá! ⭐</div>
                        }
                        else
                        {
                            @* Wave 6b (item 26): per-dish star inputs, one row per order line. *@
                            @if (_order.Lines != null && _order.Lines.Count > 0)
                            {
                                <p class="mb-1"><strong>Đánh giá từng món:</strong> <small class="text-muted">(tùy chọn)</small></p>
                                @foreach (var line in _order.Lines)
                                {
                                    var l = line;
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small text-truncate mr-2" style="max-width: 60%;">@l.ProductName</span>
                                        <span style="white-space: nowrap;">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                var s = star;
                                                <button type="button" class="btn btn-link p-0"
                                                        style="font-size: 20px; color: @(s <= LineRating(l.Id) ? "#f6c453" : "#ccc"); text-decoration: none;"
                                                        @onclick="() => SetLineRating(l.Id, s)">★</button>
                                            }
                                        </span>
                                    </div>
                                }
                                <hr class="my-2" />
                            }
                            <p class="mb-1"><strong>Đánh giá chung:</strong></p>
                            <div class="mb-2">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    var s = star;
                                    <button type="button" class="btn btn-link p-0 mr-1"
                                            style="font-size: 28px; color: @(s <= _rating ? "#f6c453" : "#ccc"); text-decoration: none;"
                                            @onclick="() => _rating = s">★</button>
                                }
                            </div>
                            <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_reviewComment"
                                      placeholder="Chia sẻ cảm nhận của bạn (tùy chọn)..."></textarea>
                            @if (!string.IsNullOrEmpty(_reviewError))
                            {
                                <div class="alert alert-danger py-1">@_reviewError</div>
                            }
                            <button class="btn btn-primary btn-sm" @onclick="SubmitReview" disabled="@(_submittingReview || _rating == 0)">
                                @(_submittingReview ? "Đang gửi..." : "Gửi đánh giá")
                            </button>
                        }
                    </div>
                </div>
            }
            <p>
                Phương thức thanh toán: <strong>@PaymentMethodLabel(_order.PaymentMethod)</strong><br />
                Trạng thái thanh toán: @PaymentStatusBadge(_order.PaymentStatus)<br />
                Hình thức nhận hàng: <strong>@FulfillmentLabel(_order.FulfillmentMethod)</strong>
                @if (_order.FulfillmentMethod == "ShipperPickup")
                {
                    @if (_order.PickedUpAt.HasValue)
                    {
                        <br /><span class="text-success">✅ Đã lấy hàng lúc <strong>@_order.PickedUpAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</strong></span>
                    }
                    else
                    {
                        <br /><span class="text-info">🛵 Chờ shipper đến lấy — quán chuẩn bị sẵn, shipper đọc mã đơn <strong>@_order.OrderNumber</strong> để lấy.</span>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(_order.DeliverySlot))
                {
                    <br /><span>🕖 Giờ giao hẹn: <strong>@_order.DeliverySlot</strong></span>
                }
                @if (_order.ScheduledFor.HasValue)
                {
                    <br /><span>📅 <strong>Đơn đặt trước</strong> — giờ lấy hẹn: <strong class="text-primary">@_order.ScheduledFor.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                }
            </p>
            @* Item 130: refund status visible to the customer. *@
            @if (!string.IsNullOrEmpty(_order.RefundStatus) && _order.RefundStatus != "None")
            {
                <div class="alert @(_order.RefundStatus == "Refunded" ? "alert-success" : "alert-warning") py-2">
                    ↩️ Hoàn tiền <strong>@_order.RefundAmount.ToString("N0") ₫</strong> —
                    @(_order.RefundStatus == "Refunded" ? "shop đã hoàn thành." : "đang chờ shop xử lý, shop sẽ liên hệ với bạn.")
                </div>
            }

            @if (_order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "Unpaid")
            {
                <div class="card mb-3">
                    <div class="card-header">Chuyển khoản ngân hàng</div>
                    <div class="card-body">
                        @if (_bankInfo == null)
                        {
                            <p><em>Đang tải thông tin chuyển khoản...</em></p>
                        }
                        else if (!_bankInfo.IsConfigured)
                        {
                            <div class="alert alert-warning">
                                <strong>QR sẽ hiện khi shop cấu hình ngân hàng.</strong>
                                <p class="mb-0">Tạm thời bạn vui lòng chuyển khoản với nội dung: <strong>@_order.OrderNumber</strong>.</p>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-5 text-center">
                                    <img src="@QrUrl" alt="QR chuyển khoản" style="max-width: 260px; width: 100%;" />
                                </div>
                                <div class="col-md-7">
                                    <table class="table table-sm">
                                        <tr><td><strong>Ngân hàng</strong></td><td>@_bankInfo.BankName</td></tr>
                                        <tr><td><strong>Số tài khoản</strong></td><td><strong>@_bankInfo.AccountNumber</strong></td></tr>
                                        <tr><td><strong>Chủ tài khoản</strong></td><td>@_bankInfo.AccountName</td></tr>
                                        <tr><td><strong>Số tiền</strong></td><td><strong class="text-danger">@FormatPrice(_order.TotalAmount)</strong></td></tr>
                                        <tr><td><strong>Nội dung</strong></td><td><strong>@_order.OrderNumber</strong></td></tr>
                                    </table>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_transferMessage))
                        {
                            <div class="alert alert-success">@_transferMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(_transferError))
                        {
                            <div class="alert alert-danger">@_transferError</div>
                        }
                        <button class="btn btn-success" @onclick="MarkTransferred" disabled="@_markingTransferred">
                            @(_markingTransferred ? "Đang gửi..." : "Tôi đã chuyển khoản")
                        </button>
                        <button class="btn btn-outline-primary ml-2" @onclick="CopyPaymentLinkAsync" title="Sao chép link để thanh toán sau từ thiết bị khác">
                            🔗 Sao chép link thanh toán
                        </button>
                        @if (!string.IsNullOrEmpty(_copyMessage))
                        {
                            <div class="alert alert-success mt-2 mb-0">@_copyMessage</div>
                        }
                    </div>
                </div>
            }
            else if (_order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "PendingConfirmation")
            {
                <div class="alert alert-info">Đã ghi nhận bạn đã chuyển khoản. Shop đang xác nhận thanh toán — trang này tự cập nhật khi shop xác nhận.</div>
            }
            else if (_order.PaymentStatus == "Paid")
            {
                <div class="alert alert-success">Thanh toán thành công! Cảm ơn bạn.</div>
            }

            @if (_order.PaymentMethod == "MoMo" && (_order.PaymentStatus == "Unpaid" || _order.PaymentStatus == "Failed"))
            {
                @if (!string.IsNullOrEmpty(_momoError))
                {
                    <div class="alert alert-danger">@_momoError</div>
                }
                <button class="btn btn-primary" @onclick="PayWithMoMo" disabled="@_payingMoMo">
                    @(_payingMoMo ? "Đang xử lý..." : "Thanh toán MoMo (TEST)")
                </button>
            }
            else if (_order.PaymentMethod == "MoMo" && _order.PaymentStatus == "Failed")
            {
                <div class="alert alert-danger">Thanh toán MoMo thất bại.</div>
            }
        </div>
    </div>

    @* Item 123: share a photo of the received dish → moderation → public gallery. *@
    <div class="card mb-3">
        <div class="card-header py-2"><strong>📸 Chia sẻ ảnh món bạn đã nhận</strong></div>
        <div class="card-body py-2">
            @if (!string.IsNullOrEmpty(_photoMessage))
            {
                <div class="alert @(_photoError ? "alert-danger" : "alert-success") py-2 mb-2">@_photoMessage</div>
            }
            <div class="form-row align-items-end">
                <div class="col-md-5 mb-2">
                    <InputFile id="share-photo-input" OnChange="OnPhotoSelected" accept="image/*" class="form-control-file" />
                    <small class="text-muted">Ảnh sẽ được duyệt trước khi hiện ở gallery.</small>
                </div>
                <div class="col-md-5 mb-2">
                    <input class="form-control form-control-sm" @bind="_photoCaption" maxlength="300"
                           placeholder="Chú thích (tùy chọn) — vd: Xôi gấc dẻo thơm!" />
                </div>
                <div class="col-md-2 mb-2">
                    <button class="btn btn-sm btn-primary btn-block" @onclick="UploadPhotoAsync"
                            disabled="@(_uploadingPhoto || _selectedPhoto == null)">
                        @(_uploadingPhoto ? "Đang tải..." : "Chia sẻ")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Khảo sát hài lòng sau mua: popup nhỏ, không làm phiền, chỉ hiện 1 lần/đơn. *@
@if (_showSurveyPopup && _order != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 16px;"
         @onclick="DismissSurveyAsync">
        <div style="background: #fff; border-radius: 16px; max-width: 420px; width: 100%; padding: 28px 24px; text-align: center; box-shadow: 0 12px 40px rgba(0,0,0,0.25);"
             @onclick:stopPropagation="true">
            <div style="font-size: 40px; margin-bottom: 8px;">😋</div>
            <h5 style="font-family: Lora, Georgia, serif; color: #763434; font-weight: 700; margin-bottom: 6px;">
                Bạn hài lòng về món ăn chứ?
            </h5>
            <p class="text-muted small mb-3">Đánh giá của bạn giúp Xôi Phú Thượng phục vụ tốt hơn.</p>
            <div class="mb-3">
                @for (var star = 1; star <= 5; star++)
                {
                    var s = star;
                    <button type="button" class="btn btn-link p-0 mr-1"
                            style="font-size: 36px; color: @(s <= _surveyRating ? "#f6c453" : "#ddd"); text-decoration: none;"
                            @onclick="() => _surveyRating = s">★</button>
                }
            </div>
            <textarea class="form-control form-control-sm mb-3" rows="2" @bind="_surveyComment"
                      placeholder="Góp ý thêm (tùy chọn)..."></textarea>
            @if (!string.IsNullOrEmpty(_surveyError))
            {
                <div class="alert alert-danger py-1 small">@_surveyError</div>
            }
            <div class="d-flex" style="gap: 10px;">
                <button class="btn flex-fill" style="background: #FFBA31; color: #fff; font-weight: 700; border-radius: 10px;"
                        @onclick="SubmitSurveyAsync" disabled="@(_surveySubmitting || _surveyRating == 0)">
                    @(_surveySubmitting ? "Đang gửi..." : "Gửi đánh giá")
                </button>
                <button class="btn btn-outline-secondary flex-fill" style="border-radius: 10px;"
                        @onclick="DismissSurveyAsync" disabled="@_surveySubmitting">
                    Để sau
                </button>
            </div>
        </div>
    </div>
}

