    // Customer self-service: cancel.
    private bool _cancelling;
    private string _cancelError;

    // Customer self-service: edit quantities.
    private bool _editingLines;
    private System.Collections.Generic.Dictionary<Guid, int> _editQuantities
        = new System.Collections.Generic.Dictionary<Guid, int>();
    private bool _savingLines;
    private string _editError;

    // TC3: customer self-service — change address / delivery slot (Pending only).
    private bool _editingAddress;
    private string _editAddress;
    private string _editDeliverySlot;
    private bool _savingAddrForm;
    private string _editAddressError;

    // Item 138: customer self-service — update recipient phone + notes (Pending only).
    private bool _editingContact;
    private string _editRecipientPhone;
    private string _editNotes;
    private bool _savingContactForm;
    private string _editContactError;

    // TC3: shop hotline for the "call hotline to change" note (fail-soft).
    private string _hotline;

    /// <summary>TC2: status timeline steps for the 5-step order pipeline.</summary>
    private sealed record StatusStep(string Status, string Label, string Icon);

    private static readonly StatusStep[] StatusSteps =
    {
        new StatusStep("Pending", "Chờ xác nhận", "fa-hourglass-half"),
        new StatusStep("Confirmed", "Đã xác nhận", "fa-check"),
        new StatusStep("Preparing", "Đang chuẩn bị", "fa-fire"),
        new StatusStep("Delivering", "Đang giao", "fa-motorcycle"),
        new StatusStep("Completed", "Hoàn thành", "fa-circle-check"),
    };

    /// <summary>TC2: 0-based index of the order's current step in the pipeline.</summary>
    private int CurrentStatusIndex
    {
        get
        {
            if (_order == null)
            {
                return 0;
            }

            for (var i = 0; i < StatusSteps.Length; i++)
            {
                if (string.Equals(StatusSteps[i].Status, _order.Status, StringComparison.OrdinalIgnoreCase))
                {
                    return i;
                }
            }

            return 0;
        }
    }

    /// <summary>
    /// TC2: expected delivery text. Uses the order's delivery slot first,
    /// then the scheduled pickup time; omitted when unknown.
    /// </summary>
    private string ExpectedDeliveryText
    {
        get
        {
            if (_order == null || string.Equals(_order.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            {
                return null;
            }

            if (!string.IsNullOrWhiteSpace(_order.DeliverySlot))
            {
                return _order.DeliverySlot;
            }

            if (_order.ScheduledFor.HasValue)
            {
                return _order.ScheduledFor.Value.ToLocalTime().ToString("HH:mm dd/MM");
            }

            return null;
        }
    }

    /// <summary>TC3: true for statuses where the shop has taken over the order.</summary>
    private static bool IsActivePipelineStatus(string status) =>
        string.Equals(status, "Confirmed", StringComparison.OrdinalIgnoreCase)
        || string.Equals(status, "Preparing", StringComparison.OrdinalIgnoreCase)
        || string.Equals(status, "Delivering", StringComparison.OrdinalIgnoreCase);

    /// <summary>TC3: hotline note shown when self-service is no longer available.</summary>
    private string ChangeHotlineNote =>
        string.IsNullOrWhiteSpace(_hotline)
            ? "Vui lòng gọi hotline để thay đổi."
            : $"Vui lòng gọi hotline {_hotline} để thay đổi.";

    /// <summary>TC3: opens the address / delivery-slot form.</summary>
    /// <summary>
    /// Reset toàn bộ trạng thái sửa đơn khi chuyển sang đơn khác.
    /// Tránh 2 lỗi: (1) form sửa SĐT/ghi chú của đơn cũ vẫn mở và lưu đè dữ liệu
    /// lên đơn mới (dùng _order.OrderNumber mới + _editRecipientPhone/_editNotes cũ);
    /// (2) _editQuantities keyed theo line Id của đơn cũ → KeyNotFoundException
    /// khi render (_editQuantities[line.Id]) cho đơn mới.
    /// </summary>
    private void ResetEditStates()
    {
        _editingLines = false;
        _editingAddress = false;
        _editingContact = false;
        _editError = null;
        _editAddressError = null;
        _editContactError = null;
        _editQuantities = new System.Collections.Generic.Dictionary<Guid, int>();
    }

    private void StartEditAddress()
    {
        _editAddressError = null;
        _editAddress = _order.CustomerAddress;
        _editDeliverySlot = _order.DeliverySlot;
        _editingLines = false;
        _editingAddress = true;
    }

    /// <summary>Item 138: bắt đầu sửa SĐT người nhận + ghi chú.</summary>
    private void StartEditContact()
    {
        _editContactError = null;
        _editRecipientPhone = _order.RecipientPhone;
        _editNotes = _order.Notes;
        _editingLines = false;
        _editingAddress = false;
        _editingContact = true;
    }

    /// <summary>Item 138: lưu SĐT người nhận + ghi chú (Pending only, server-enforced).</summary>
    private async Task SaveEditedContact()
    {
        _editContactError = null;
        _savingContactForm = true;
        try
        {
            _order = await ShopEngagementService.UpdateContactByCustomerAsync(
                _order.OrderNumber, _order.CustomerPhone, _editRecipientPhone, _editNotes);
            _editingContact = false;
            Toasts.Show("Đã cập nhật SĐT / ghi chú.");
        }
        catch (Exception ex)
        {
            _editContactError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Không lưu được thay đổi. Vui lòng thử lại."
                : ex.Message;
        }
        finally
        {
            _savingContactForm = false;
        }
    }

    /// <summary>TC3: saves the new address / delivery slot (Pending only, server-enforced).</summary>
    private async Task SaveEditedAddress()
    {
        _editAddressError = null;
        _savingAddrForm = true;
        try
        {
            _order = await ShopEngagementService.UpdateAddressByCustomerAsync(
                _order.OrderNumber, _order.CustomerPhone, _editAddress, _editDeliverySlot);
            _editingAddress = false;
            Toasts.Show("Đã cập nhật địa chỉ / giờ giao.");
        }
        catch (Exception ex)
        {
            _editAddressError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Không lưu được thay đổi. Vui lòng thử lại."
                : ex.Message;
        }
        finally
        {
            _savingAddrForm = false;
        }
    }

    // Wave 6a (item 21): reorder.
    private bool _reordering;
    private string _reorderMessage;

    // Post-delivery survey.
    private int _rating;
    private string _reviewComment;
    private bool _submittingReview;
    private bool _reviewSubmitted;
    private string _reviewError;

    // Item 44: review photo reward.
    private IBrowserFile _reviewPhotoFile;
    private string _reviewPhotoPreviewUrl;
    private string _reviewRewardCode;

    // Khảo sát hài lòng sau mua (popup, hiện 1 lần/đơn đã xong).
    private bool _showSurveyPopup;
    private int _surveyRating;
    private string _surveyComment;
    private bool _surveySubmitting;
    private string _surveyError;

    private static string SurveyStorageKey(string orderNumber) =>
        $"pt_survey_{orderNumber}";

    /// <summary>
    /// Wave 6b (item 26): per-dish star ratings keyed by order line id.
    /// </summary>
    private readonly Dictionary<Guid, int> _lineRatings = new Dictionary<Guid, int>();

    private int LineRating(Guid lineId) =>
        _lineRatings.TryGetValue(lineId, out var r) ? r : 0;

    private void SetLineRating(Guid lineId, int stars)
    {
        _lineRatings[lineId] = stars;
    }

    /// <summary>
    /// Copies the track-order URL with ?orderNumber= prefilled so the
    /// customer can pay later from any device (reusable payment link).
    /// </summary>
    private async Task CopyPaymentLinkAsync()
    {
        _copyMessage = null;
        if (_order == null)
        {
            return;
        }

        try
        {
            var link = $"{Navigation.BaseUri.TrimEnd('/')}/track-order"
                + $"?orderNumber={Uri.EscapeDataString(_order.OrderNumber)}";
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);
            _copyMessage = "Đã sao chép link thanh toán! Mở link này trên thiết bị khác để thanh toán sau.";
        }
        catch (Exception)
        {
            _copyMessage = "Không sao chép được. Vui lòng copy link trên thanh địa chỉ.";
        }
    }

    private string QrUrl
    {
        get
        {
            if (_bankInfo == null || _order == null)
            {
                return string.Empty;
            }

            var template = string.IsNullOrWhiteSpace(_bankInfo.QrTemplate) || _bankInfo.QrTemplate == "xxx"
                ? "compact2"
                : _bankInfo.QrTemplate;
            var amount = (long)_order.TotalAmount;
            return $"https://img.vietqr.io/image/{_bankInfo.BankId}-{_bankInfo.AccountNumber}-{template}.png"
                + $"?amount={amount}&addInfo={Uri.EscapeDataString(_order.OrderNumber)}"
                + $"&accountName={Uri.EscapeDataString(_bankInfo.AccountName ?? string.Empty)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppI18n.OnChange += OnLangChanged;
        await AppI18n.InitializeAsync();
        Funnel.Track(FunnelService.Events.TrackView, new Uri(Navigation.Uri).AbsolutePath);
        var query = ParseQuery(Navigation.Uri);
        if (query.TryGetValue("orderNumber", out var orderNumber))
        {
            _orderNumber = orderNumber;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !string.IsNullOrWhiteSpace(_orderNumber))
        {
            return;
        }

        // Restore the last successful lookup so returning customers don't
        // have to retype the order number and phone.
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", TrackOrderStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var saved = System.Text.Json.JsonSerializer.Deserialize<TrackOrderMemory>(json);
                if (saved != null
                    && !string.IsNullOrWhiteSpace(saved.OrderNumber)
                    && !string.IsNullOrWhiteSpace(saved.Phone))
                {
                    _orderNumber = saved.OrderNumber;
                    _phone = saved.Phone;
                    await Lookup();
                    StateHasChanged();
                }
            }
        }
        catch (Exception)
        {
            // Best effort only.
        }
    }

    private async Task RememberLookupAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new TrackOrderMemory
            {
                OrderNumber = _orderNumber?.Trim(),
                Phone = _phone?.Trim()
            });
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", TrackOrderStorageKey, json);
        }
        catch (Exception)
        {
            // Best effort only.
        }
    }

    private sealed class TrackOrderMemory
    {
        public string OrderNumber { get; set; }

        public string Phone { get; set; }
    }

    private const string TrackOrderStorageKey = "phuthuong.track-order.v1";
    // Số lượng tối đa cho 1 dòng khi khôi phục đơn cũ vào giỏ (tránh giỏ phình quá lớn).
    private const int MaxQuantityPerLine = 99;

    private async Task Lookup()
    {
        _error = null;
        _transferMessage = null;
        _transferError = null;
        _momoError = null;
        _copyMessage = null;
