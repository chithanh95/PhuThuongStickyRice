    private bool _savingBirthday;
    private string _birthdayMessage;

    // Item 119: address book.
    private System.Collections.Generic.List<PhuThuongStickyRice.Web.Components.Admin.Models.AddressBookModel> _addresses;
    private string _newAddressLabel;
    private string _newAddressText;
    private bool _savingAddress;
    private string _addressBookMessage;

    // Lịch sử đơn hàng theo SĐT (không cần đăng nhập).
    private string _historyPhone;
    private System.Collections.Generic.List<TrackedOrderModel> _history;
