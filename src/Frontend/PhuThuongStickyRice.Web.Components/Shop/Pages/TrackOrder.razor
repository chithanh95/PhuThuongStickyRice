    /// <summary>Item 44: review photo selection + thumbnail preview (data URL).</summary>
    private async Task OnReviewPhotoSelected(InputFileChangeEventArgs e)
    {
        _reviewPhotoFile = e.FileCount > 0 ? e.File : null;
        _reviewPhotoPreviewUrl = null;
        if (_reviewPhotoFile == null)
        {
            return;
        }

        try
        {
            // Small preview only — the full image is compressed at submit time.
            using var stream = _reviewPhotoFile.OpenReadStream(maxAllowedSize: 512 * 1024);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            var mime = string.IsNullOrWhiteSpace(_reviewPhotoFile.ContentType)
                ? "image/jpeg"
                : _reviewPhotoFile.ContentType;
            _reviewPhotoPreviewUrl =
                $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch
        {
            // Preview is best-effort; upload still works without it.
            _reviewPhotoPreviewUrl = null;
        }
    }

    private async Task UploadPhotoAsync()
    {
        if (_selectedPhoto?.File == null || _order == null)
        {
            return;
        }

        _uploadingPhoto = true;
        _photoMessage = null;
        _photoError = false;
        try
        {
            // Compress client-side (same helper as the landing image upload).
            var compressed = await JSRuntime.InvokeAsync<CompressedImage>(
                "interop.compressImageFromInput", "share-photo-input", 1600, 0.85);
            using var stream = new System.IO.MemoryStream(Convert.FromBase64String(compressed.Base64));
            await AdminCommerceService.UploadCustomerPhotoAsync(
                stream, compressed.FileName, compressed.ContentType,
                _order.CustomerPhone, _photoCaption);
            _photoMessage = "Cảm ơn bạn! Ảnh đang chờ duyệt và sẽ sớm hiện ở gallery.";
            _photoCaption = null;
            _selectedPhoto = null;
        }
        catch (Exception ex)
        {
            _photoError = true;
            _photoMessage = ex.Message;
        }
        finally
        {
            _uploadingPhoto = false;
        }
    }

    /// <summary>Shape of the object returned by interop.compressImageFromInput.</summary>
    private sealed class CompressedImage
    {
        public string Base64 { get; set; } = "";
        public string FileName { get; set; } = "image.jpg";
        public string ContentType { get; set; } = "image/jpeg";
    }
}
