    private static string FormatOrderTime(DateTime createdAt)
    {
        var today = DateTime.Today;
        var date = createdAt.Date;
        var time = createdAt.ToString("HH:mm");
        if (date == today) return $"Hôm nay {time}";
        if (date == today.AddDays(-1)) return $"Hôm qua {time}";
        return createdAt.ToString("dd/MM/yyyy HH:mm");
    }

