@page "/track-order"
<PageTitle>Tra cứu đơn hàng — Xôi Phú Thượng</PageTitle>
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Core.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using Microsoft.JSInterop
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject CartState CartState
@inject ToastService Toasts
@inject ShopEngagementService ShopEngagementService
@inject AdminSystemService AdminSystemService
@inject AdminCommerceService AdminCommerceService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppI18n AppI18n
@inject FunnelService Funnel
@implements IDisposable

<h1>@AppI18n.T("shop.track_title")</h1>

<div class="card mb-3 to-lookup">
    <div class="card-body">
        <div class="form-row">
            <div class="col-md-4">
                <label for="to-order-number">@AppI18n.T("shop.order_number")</label>
                <input id="to-order-number" class="form-control" @bind="_orderNumber" placeholder="PX-20261014-0001" />
            </div>
            <div class="col-md-4">
                <label for="to-phone">@AppI18n.T("shop.order_phone")</label>
                <input id="to-phone" class="form-control" @bind="_phone" placeholder="0901234567" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary" @onclick="Lookup" disabled="@_loading">
                    @(_loading ? AppI18n.T("shop.looking_up") : AppI18n.T("shop.lookup"))
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">@_error</div>
        }
    </div>
</div>

@* Lịch sử đơn hàng theo SĐT — không cần đăng nhập. *@
<div class="card mb-3 to-history">
    <div class="card-body">
        <h5>@AppI18n.T("shop.order_history")</h5>
        <p class="text-muted"><small>@AppI18n.T("shop.history_hint")</small></p>
        <div class="form-row">
            <div class="col-md-4">
                <label for="to-history-phone">@AppI18n.T("shop.order_phone")</label>
                <input id="to-history-phone" class="form-control" @bind="_historyPhone" placeholder="0901234567" inputmode="tel" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-outline-primary" @onclick="LoadHistoryAsync" disabled="@_historyLoading">
                    @(_historyLoading ? AppI18n.T("common.loading") : AppI18n.T("shop.view_history"))
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_historyError))
        {
            <div class="alert alert-danger mt-3 mb-0">@_historyError</div>
        }
        @if (_history != null)
        {
            if (_history.Count == 0)
            {
                <p class="text-muted mt-3 mb-0"><em>@AppI18n.T("shop.no_orders")</em></p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>@AppI18n.T("shop.order_number")</th><th>@AppI18n.T("shop.order_date")</th><th class="text-right">@AppI18n.T("shop.order_total")</th><th>@AppI18n.T("common.status")</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var h in _history)
                            {
                                <tr>
                                    <td><strong>@h.OrderNumber</strong></td>
                                    <td>@h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-right">@FormatPrice(h.TotalAmount)</td>
                                    <td>@OrderStatusBadge(h.Status)</td>
                                    <td class="text-right text-nowrap">
                                        <button class="btn btn-sm btn-outline-info mr-1" @onclick="() => ViewHistoryDetail(h)">@AppI18n.T("shop.detail")</button>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ReorderAsync(h)" disabled="@_reordering">@AppI18n.T("shop.reorder")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@if (_order != null)
{
    <div class="card mb-3">
        <div class="card-header">
            Đơn hàng <strong>@_order.OrderNumber</strong>
            <span class="float-right">@OrderStatusBadge(_order.Status)</span>
        </div>
        <div class="card-body">
            @* TC2: visual status timeline. *@
            @if (string.Equals(_order.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            {
                <div class="to-timeline to-timeline-cancelled" role="list" aria-label="Trạng thái đơn hàng">
                    <div class="to-tl-step to-tl-cancelled" role="listitem" aria-current="step">
                        <span class="to-tl-dot"><i class="fa-solid fa-xmark" aria-hidden="true"></i></span>
                        <span class="to-tl-label">Đơn hàng đã bị hủy</span>
                    </div>
                </div>
            }
            else
            {
                <div class="to-timeline" role="list" aria-label="Tiến trình đơn hàng">
                    @for (var stepIndex = 0; stepIndex < StatusSteps.Length; stepIndex++)
                    {
                        var stepState = stepIndex < CurrentStatusIndex ? "done"
                            : stepIndex == CurrentStatusIndex ? "current" : "todo";
                        <div class="to-tl-step to-tl-@stepState" role="listitem"
                             aria-current="@(stepState == "current" ? "step" : null)">
                            <span class="to-tl-dot">
                                @if (stepState == "done")
                                {
                                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="fa-solid @StatusSteps[stepIndex].Icon" aria-hidden="true"></i>
                                }
                            </span>
                            <span class="to-tl-label">@StatusSteps[stepIndex].Label</span>
                        </div>
                        @if (stepIndex < StatusSteps.Length - 1)
                        {
                            var lineState = stepIndex < CurrentStatusIndex ? "done" : "todo";
                            <div class="to-tl-line to-tl-@lineState" aria-hidden="true"></div>
                        }
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(ExpectedDeliveryText))
                {
                    <p class="text-muted mb-2"><small>📅 Dự kiến giao: <strong>@ExpectedDeliveryText</strong></small></p>
                }
            }
            @* Wave 6a (item 21): reorder — restores the order's lines into the cart. *@
            <div class="mb-2">
                <button class="btn btn-outline-success btn-sm" @onclick="() => ReorderAsync(_order)" disabled="@_reordering">
                    @(_reordering ? AppI18n.T("shop.reordering") : AppI18n.T("shop.reorder"))
                </button>
                @if (!string.IsNullOrEmpty(_reorderMessage))
                {
                    <small class="text-danger ml-2">@_reorderMessage</small>
                }
            </div>
            <p>
                Ngày đặt: <strong>@_order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong><br />
                Khách hàng: <strong>@_order.CustomerName</strong> — @_order.CustomerPhone<br />
                @if (!string.IsNullOrWhiteSpace(_order.RecipientName))
                {
                    <span>Người nhận: <strong>@_order.RecipientName</strong> — @_order.RecipientPhone<br /></span>
                }
                Địa chỉ: @_order.CustomerAddress
                @if (!string.IsNullOrWhiteSpace(_order.TaxCode))
                {
                    <br /><span>Hóa đơn VAT: @_order.CompanyName (MST: @_order.TaxCode)</span>
                }
                @if (_order.IsGift)
                {
                    <br /><span>🎁 Gói quà@(!string.IsNullOrWhiteSpace(_order.GiftMessage) ? $": {_order.GiftMessage}" : "")</span>
                }
            </p>
            @if (_loyalty != null)
            {
                <p>
                    <small>
                        ⭐ Bạn có <strong>@_loyalty.Points điểm</strong>
                        <span class="badge badge-info">Hạng @_loyalty.Tier</span>
                        @if (!string.IsNullOrWhiteSpace(_loyalty.ReferralCode))
                        {
                            <span class="ml-1">Mã giới thiệu: <strong>@_loyalty.ReferralCode</strong></span>
                        }
                    </small>
                </p>
                <div class="form-row align-items-end mb-2">
                    <div class="col-auto">
                        <label for="to-birthday"><small>Ngày sinh <small class="text-muted">(để nhận voucher sinh nhật)</small></small></label>
                        <input id="to-birthday" type="date" class="form-control form-control-sm" @bind="_birthdayInput" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SaveBirthday" disabled="@_savingBirthday">
                            @(_savingBirthday ? "Đang lưu..." : "Lưu ngày sinh")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_birthdayMessage))
                    {
                        <div class="col-12"><small class="text-success">@_birthdayMessage</small></div>
                    }
                </div>
            }
            @if (_order.RequiresDeposit && _order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "Unpaid")
            {
                <div class="alert alert-warning py-2">
                    <small>💰 Đơn này cần <strong>đặt cọc trước</strong> để shop xác nhận. Shop sẽ liên hệ với bạn.</small>
                </div>
            }
            @* Item 119: address book management from the track-order profile. *@
            <div class="card mt-2 mb-2">
                <div class="card-body py-2">
                    <small class="text-muted d-block mb-1">📒 <strong>Sổ địa chỉ</strong> của số @_order.CustomerPhone</small>
                    @if (_addresses == null)
                    {
                        <small><em>Đang tải...</em></small>
                    }
                    else if (_addresses.Count == 0)
                    {
                        <small class="text-muted">Chưa có địa chỉ nào được lưu.</small>
                    }
                    else
                    {
                        @foreach (var a in _addresses)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                                <small><strong>@a.Label:</strong> @a.Address</small>
                                <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteAddressAsync(a)">Xóa</button>
                            </div>
                        }
                    }
                    <div class="form-row mt-2">
                        <div class="col-4">
                            <input class="form-control form-control-sm" @bind="_newAddressLabel" placeholder="Nhãn (Nhà/Cty)" aria-label="Nhãn địa chỉ, ví dụ Nhà hoặc Công ty" />
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <input class="form-control form-control-sm" @bind="_newAddressText" placeholder="Địa chỉ mới..." aria-label="Địa chỉ mới" />
                                <div class="input-group-append">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="AddAddressAsync" disabled="@_savingAddress">Lưu</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_addressBookMessage))
                    {
                        <small class="text-success">@_addressBookMessage</small>
                    }
                </div>
            </div>
            @* Tóm tắt đơn hàng kiểu ShopeeFood *@
            <div class="to-summary-card">
                <h5 class="to-card-title">Tóm tắt đơn hàng</h5>
                @foreach (var line in _order.Lines)
                {
                    <div class="to-item-row" @key="line.Id">
                        <div class="to-item-main">
                            <span class="to-item-qty">@line.Quantity x</span>
                            <span class="to-item-name">
                                @line.ProductName
                                @if (line.IsCombo)
                                {
                                    <span class="badge badge-warning ml-1">COMBO</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.SizeName))
                                {
                                    <small class="text-muted d-block">Size: @line.SizeName</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.ToppingNames))
                                {
                                    <small class="text-muted d-block">Ăn kèm: @line.ToppingNames</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.Note))
                                {
                                    <small class="text-info d-block">📝 @line.Note</small>
                                }
                            </span>
                        </div>
                        <span class="to-item-price">@FormatPrice(line.LineTotal)</span>
                    </div>
                }
                <div class="to-total-row">
                    <span><strong>Tổng (@_order.Lines.Sum(l => l.Quantity) món)</strong></span>
                    <span><strong>@FormatPrice(_order.Lines.Sum(l => l.LineTotal))</strong></span>
                </div>
                @if (_order.DiscountAmount > 0)
                {
                    <div class="to-fee-row text-success">
                        <span>Giảm giá @(!string.IsNullOrWhiteSpace(_order.DiscountCode) ? $"({_order.DiscountCode})" : "")</span>
                        <span>−@FormatPrice(_order.DiscountAmount)</span>
                    </div>
                }
                @if (_order.TierDiscount > 0)
                {
                    <div class="to-fee-row text-success">
                        <span>Ưu đãi hạng thành viên</span>
                        <span>−@FormatPrice(_order.TierDiscount)</span>
                    </div>
                }
                @if (_order.LoyaltyDiscount > 0)
                {
                    <div class="to-fee-row text-success">
                        <span>Đổi @_order.LoyaltyPointsRedeemed điểm</span>
                        <span>−@FormatPrice(_order.LoyaltyDiscount)</span>
                    </div>
                }
                @if (_order.GiftFee > 0)
                {
                    <div class="to-fee-row text-muted">
                        <span>🎁 Phí gói quà</span>
                        <span>+@FormatPrice(_order.GiftFee)</span>
                    </div>
                }
                <div class="to-grand-row">
                    <span></span>
                    <span class="to-grand-price">@FormatPrice(_order.TotalAmount)</span>
                </div>
            </div>
            @* Thông tin đơn hàng kiểu ShopeeFood *@
            <div class="to-info-card">
                <h5 class="to-card-title">Thông tin đơn hàng</h5>
                <div class="to-info-row">
                    <span class="to-info-label">Mã đơn hàng</span>
                    <span class="to-info-value">
                        @_order.OrderNumber
                        <button type="button" class="to-copy-btn" @onclick="CopyOrderNumber">Sao chép</button>
                    </span>
                </div>
                <div class="to-info-row">
                    <span class="to-info-label">Thời gian đặt hàng</span>
                    <span class="to-info-value">@FormatOrderTime(_order.CreatedAt)</span>
                </div>
                <div class="to-info-row">
                    <span class="to-info-label">Thanh toán</span>
                    <span class="to-info-value">@PaymentMethodLabel(_order.PaymentMethod)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_order.Notes))
                {
                    <div class="to-info-row">
                        <span class="to-info-label">Ghi chú</span>
                        <span class="to-info-value">@_order.Notes</span>
                    </div>
                }
            </div>

            @if (_order.Status == "Pending")
            {
                <div class="mb-3 to-selfservice">
                    @if (!_editingLines && !_editingAddress && !_editingContact)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="StartEditLines">✏️ Sửa đơn (số lượng)</button>
                        <button class="btn btn-outline-info btn-sm ml-2" @onclick="StartEditAddress">📍 Đổi địa chỉ / giờ giao</button>
                        <button class="btn btn-outline-primary btn-sm ml-2" @onclick="StartEditContact">📞 Sửa SĐT / ghi chú</button>
                        <button class="btn btn-outline-danger btn-sm ml-2" @onclick="CancelOrder" disabled="@_cancelling">
                            @(_cancelling ? "Đang hủy..." : "Hủy đơn")
                        </button>
                        @if (!string.IsNullOrEmpty(_cancelError))
                        {
                            <div class="alert alert-danger mt-2 mb-0">@_cancelError</div>
                        }
                    }
                    else if (_editingAddress)
                    {
                        @* TC3: đổi địa chỉ / giờ giao khi đơn còn chờ xác nhận. *@
                        <div class="card">
                            <div class="card-header py-2"><strong>📍 Đổi địa chỉ / giờ giao</strong></div>
                            <div class="card-body py-2">
                                <div class="form-group mb-2">
                                    <label for="to-edit-address"><small>Địa chỉ nhận hàng</small></label>
                                    <input id="to-edit-address" class="form-control form-control-sm" @bind="_editAddress"
                                           maxlength="500" placeholder="Số nhà, đường, phường..." />
                                </div>
                                <div class="form-group mb-2">
                                    <label for="to-edit-slot"><small>Giờ giao mong muốn <span class="text-muted">(tùy chọn)</span></small></label>
                                    <input id="to-edit-slot" class="form-control form-control-sm" @bind="_editDeliverySlot"
                                           maxlength="50" placeholder="VD: 6h30–7h00" />
                                </div>
                                @if (!string.IsNullOrEmpty(_editAddressError))
                                {
                                    <div class="alert alert-danger mt-2 mb-1">@_editAddressError</div>
                                }
                                <button class="btn btn-success btn-sm mt-1" @onclick="SaveEditedAddress" disabled="@_savingAddrForm">
                                    @(_savingAddrForm ? "Đang lưu..." : "Lưu thay đổi")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm mt-1 ml-2" @onclick="() => _editingAddress = false">Bỏ qua</button>
                            </div>
                        </div>
                    }
                    else if (_editingContact)
                    {
                        @* Item 138: sửa SĐT người nhận + ghi chú khi đơn còn Pending. *@
                        <div class="card">
                            <div class="card-header py-2"><strong>📞 Sửa SĐT / ghi chú</strong></div>
                            <div class="card-body py-2">
                                <div class="form-group mb-2">
                                    <label for="to-edit-phone"><small>SĐT người nhận</small></label>
                                    <input id="to-edit-phone" class="form-control form-control-sm" @bind="_editRecipientPhone"
                                           maxlength="11" inputmode="tel" placeholder="0901234567" />
                                </div>
                                <div class="form-group mb-2">
                                    <label for="to-edit-notes"><small>Ghi chú <span class="text-muted">(VD: ít hành, không cay...)</span></small></label>
                                    <input id="to-edit-notes" class="form-control form-control-sm" @bind="_editNotes"
                                           maxlength="500" placeholder="Ghi chú cho quán" />
                                </div>
                                @if (!string.IsNullOrEmpty(_editContactError))
                                {
                                    <div class="alert alert-danger mt-2 mb-1">@_editContactError</div>
                                }
                                <button class="btn btn-success btn-sm mt-1" @onclick="SaveEditedContact" disabled="@_savingContactForm">
                                    @(_savingContactForm ? "Đang lưu..." : "Lưu thay đổi")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm mt-1 ml-2" @onclick="() => _editingContact = false">Bỏ qua</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-header py-2"><strong>Sửa số lượng</strong> <small class="text-muted">(0 = bỏ món)</small></div>
                            <div class="card-body py-2">
                                @foreach (var line in _order.Lines)
                                {
                                    <div class="form-row align-items-center mb-1">
                                        <div class="col-8"><small>@line.ProductName</small></div>
                                        <div class="col-4">
                                            <input type="number" class="form-control form-control-sm"
                                                   min="0" max="100" value="@_editQuantities[line.Id]"
                                                   aria-label="Số lượng @line.ProductName"
                                                   @onchange="(e => _editQuantities[line.Id] = ParseQty(e.Value))" />
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_editError))
                                {
                                    <div class="alert alert-danger mt-2 mb-1">@_editError</div>
                                }
                                <button class="btn btn-success btn-sm mt-2" @onclick="SaveEditedLines" disabled="@_savingLines">
                                    @(_savingLines ? "Đang lưu..." : "Lưu thay đổi")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm mt-2 ml-2" @onclick="() => _editingLines = false">Bỏ qua</button>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (IsActivePipelineStatus(_order.Status))
            {
                @* TC3: đơn đã được shop xác nhận — chỉ còn cách gọi hotline. *@
                <div class="alert alert-info py-2 mb-3">
                    <small>📞 Đơn đã được shop xác nhận. @ChangeHotlineNote</small>
                </div>
            }

            @if (_order.Status == "Completed")
            {
                <div class="card mb-3">
                    <div class="card-header py-2">
                        <strong>Đánh giá đơn hàng</strong>
                        <small class="text-success ml-2">⭐ Đánh giá 5 sao được thưởng +20 điểm!</small>
                    </div>
                    <div class="card-body py-2">
                        @if (_reviewSubmitted)
                        {
                            <div class="alert alert-success mb-0">
                                Cảm ơn bạn đã đánh giá! ⭐
                                @if (!string.IsNullOrEmpty(_reviewRewardCode))
                                {
                                    <div class="mt-2">
                                        🎁 Bạn được <strong>tặng 1 phần xôi</strong> cho đơn sau!
                                        Nhập mã <strong class="text-danger">@_reviewRewardCode</strong> khi đặt hàng.
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @* Wave 6b (item 26): per-dish star inputs, one row per order line. *@
                            @if (_order.Lines != null && _order.Lines.Count > 0)
                            {
                                <p class="mb-1"><strong>Đánh giá từng món:</strong> <small class="text-muted">(tùy chọn)</small></p>
                                @foreach (var line in _order.Lines)
                                {
                                    var l = line;
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small text-truncate mr-2" style="max-width: 60%;">@l.ProductName</span>
                                        <span style="white-space: nowrap;">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                var s = star;
                                                <button type="button" class="btn btn-link p-0"
                                                        style="font-size: 20px; color: @(s <= LineRating(l.Id) ? "#f6c453" : "#ccc"); text-decoration: none;"
                                                        @onclick="() => SetLineRating(l.Id, s)">★</button>
                                            }
                                        </span>
                                    </div>
                                }
                                <hr class="my-2" />
                            }
                            <p class="mb-1"><strong>Đánh giá chung:</strong></p>
                            <div class="mb-2" role="radiogroup" aria-label="Chọn số sao đánh giá chung">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    var s = star;
                                    <button type="button" class="btn btn-link p-0 mr-1"
                                            role="radio" aria-checked="@(s == _rating)"
                                            aria-label="Đánh giá @s sao"
                                            style="font-size: 28px; color: @(s <= _rating ? "#f6c453" : "#ccc"); text-decoration: none;"
                                            @onclick="() => _rating = s">★</button>
                                }
                            </div>
                            <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_reviewComment"
                                      placeholder="Chia sẻ cảm nhận của bạn (tùy chọn)..." aria-label="Chia sẻ cảm nhận của bạn về món ăn"></textarea>
                            @* Item 44: review photo — tặng 1 phần xôi cho đơn sau. *@
                            <div class="alert alert-warning py-2 mb-2">
                                🎁 <strong>Đánh giá kèm ảnh được tặng 1 phần xôi</strong> cho đơn sau!
                            </div>
                            <div class="mb-2 shop-dropzone-wrap">
                                <label for="review-photo-input" class="shop-dropzone">
                                    <div class="shop-dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                                    <div class="shop-dropzone-text">Thả ảnh vào đây hoặc bấm để chọn.</div>
                                </label>
                                <InputFile id="review-photo-input" OnChange="OnReviewPhotoSelected" accept="image/*" style="position:absolute; width:1px; height:1px; opacity:0; overflow:hidden;" />
                                @if (!string.IsNullOrEmpty(_reviewPhotoPreviewUrl))
                                {
                                    <img src="@_reviewPhotoPreviewUrl" alt="Ảnh đánh giá" class="mt-2 rounded"
                                         style="max-width: 160px; max-height: 160px; object-fit: cover;" />
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_reviewError))
                            {
                                <div class="alert alert-danger py-1">@_reviewError</div>
                            }
                            <button class="btn btn-primary btn-sm" @onclick="SubmitReview" disabled="@(_submittingReview || _rating == 0)">
                                @(_submittingReview ? "Đang gửi..." : "Gửi đánh giá")
                            </button>
                        }
                    </div>
                </div>
            }
            <p>
                Phương thức thanh toán: <strong>@PaymentMethodLabel(_order.PaymentMethod)</strong><br />
                Trạng thái thanh toán: @PaymentStatusBadge(_order.PaymentStatus)<br />
                Hình thức nhận hàng: <strong>@FulfillmentLabel(_order.FulfillmentMethod)</strong>
                @if (_order.FulfillmentMethod == "ShipperPickup")
                {
                    @if (_order.PickedUpAt.HasValue)
                    {
                        <br /><span class="text-success">✅ Đã lấy hàng lúc <strong>@_order.PickedUpAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</strong></span>
                    }
                    else
                    {
                        <br /><span class="text-info">🛵 Chờ shipper đến lấy — quán chuẩn bị sẵn, shipper đọc mã đơn <strong>@_order.OrderNumber</strong> để lấy.</span>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(_order.DeliverySlot))
                {
                    <br /><span>🕖 Giờ giao hẹn: <strong>@_order.DeliverySlot</strong></span>
                }
                @if (_order.ScheduledFor.HasValue)
                {
                    <br /><span>📅 <strong>Đơn đặt trước</strong> — giờ lấy hẹn: <strong class="text-primary">@_order.ScheduledFor.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                }
            </p>
            @* Item 130: refund status visible to the customer. *@
            @if (!string.IsNullOrEmpty(_order.RefundStatus) && _order.RefundStatus != "None")
            {
                <div class="alert @(_order.RefundStatus == "Refunded" ? "alert-success" : "alert-warning") py-2">
                    ↩️ Hoàn tiền <strong>@_order.RefundAmount.ToString("N0") ₫</strong> —
                    @(_order.RefundStatus == "Refunded" ? "shop đã hoàn thành." : "đang chờ shop xử lý, shop sẽ liên hệ với bạn.")
                </div>
            }

            @if (_order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "Unpaid")
            {
                <div class="card mb-3">
                    <div class="card-header">Chuyển khoản ngân hàng</div>
                    <div class="card-body">
                        @if (_bankInfo == null)
                        {
                            <p><em>Đang tải thông tin chuyển khoản...</em></p>
                        }
                        else if (!_bankInfo.IsConfigured)
                        {
                            <div class="alert alert-warning">
                                <strong>QR sẽ hiện khi shop cấu hình ngân hàng.</strong>
                                <p class="mb-0">Tạm thời bạn vui lòng chuyển khoản với nội dung: <strong>@_order.OrderNumber</strong>.</p>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-5 text-center">
                                    <img src="@QrUrl" alt="QR chuyển khoản" style="max-width: 260px; width: 100%;" />
                                </div>
                                <div class="col-md-7">
                                    <table class="table table-sm">
                                        <tr><td><strong>Ngân hàng</strong></td><td>@_bankInfo.BankName</td></tr>
                                        <tr><td><strong>Số tài khoản</strong></td><td><strong>@_bankInfo.AccountNumber</strong></td></tr>
                                        <tr><td><strong>Chủ tài khoản</strong></td><td>@_bankInfo.AccountName</td></tr>
                                        <tr><td><strong>Số tiền</strong></td><td><strong class="text-danger">@FormatPrice(_order.TotalAmount)</strong></td></tr>
                                        <tr><td><strong>Nội dung</strong></td><td><strong>@_order.OrderNumber</strong></td></tr>
                                    </table>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_transferMessage))
                        {
                            <div class="alert alert-success">@_transferMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(_transferError))
                        {
                            <div class="alert alert-danger">@_transferError</div>
                        }
                        <button class="btn btn-success" @onclick="MarkTransferred" disabled="@_markingTransferred">
                            @(_markingTransferred ? "Đang gửi..." : "Tôi đã chuyển khoản")
                        </button>
                        <button class="btn btn-outline-primary ml-2" @onclick="CopyPaymentLinkAsync" title="Sao chép link để thanh toán sau từ thiết bị khác">
                            🔗 Sao chép link thanh toán
                        </button>
                        @if (!string.IsNullOrEmpty(_copyMessage))
                        {
                            <div class="alert alert-success mt-2 mb-0">@_copyMessage</div>
                        }
                    </div>
                </div>
            }
            else if (_order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "PendingConfirmation")
            {
                <div class="alert alert-info">Đã ghi nhận bạn đã chuyển khoản. Shop đang xác nhận thanh toán — trang này tự cập nhật khi shop xác nhận.</div>
            }
            else if (_order.PaymentStatus == "Paid")
            {
                <div class="alert alert-success">Thanh toán thành công! Cảm ơn bạn.</div>
            }

            @if (_order.PaymentMethod == "MoMo" && (_order.PaymentStatus == "Unpaid" || _order.PaymentStatus == "Failed"))
            {
                @if (!string.IsNullOrEmpty(_momoError))
                {
                    <div class="alert alert-danger">@_momoError</div>
                }
                <button class="btn btn-primary" @onclick="PayWithMoMo" disabled="@_payingMoMo">
                    @(_payingMoMo ? "Đang xử lý..." : "Thanh toán MoMo (TEST)")
                </button>
            }
            else if (_order.PaymentMethod == "MoMo" && _order.PaymentStatus == "Failed")
            {
                <div class="alert alert-danger">Thanh toán MoMo thất bại.</div>
            }
        </div>
    </div>

    @* Item 123: share a photo of the received dish → moderation → public gallery. *@
    <div class="card mb-3">
        <div class="card-header py-2"><strong>📸 Chia sẻ ảnh món bạn đã nhận</strong></div>
        <div class="card-body py-2">
            @if (!string.IsNullOrEmpty(_photoMessage))
