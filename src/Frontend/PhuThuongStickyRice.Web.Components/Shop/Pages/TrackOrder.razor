    // ---------- Item 123: share a photo ----------

    private InputFileChangeEventArgs _selectedPhoto;
    private string _photoCaption;
    private bool _uploadingPhoto;
    private string _photoMessage;
    private bool _photoError;

    private void OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _selectedPhoto = e;
        _photoMessage = null;
    }

    private async Task UploadPhotoAsync()
    {
        if (_selectedPhoto?.File == null || _order == null)
        {
            return;
        }

        _uploadingPhoto = true;
        _photoMessage = null;
        _photoError = false;
        try
        {
            // Compress client-side (same helper as the landing image upload).
            var compressed = await JSRuntime.InvokeAsync<CompressedImage>(
                "interop.compressImageFromInput", "share-photo-input", 1600, 0.85);
            using var stream = new System.IO.MemoryStream(compressed.Bytes);
            await Wave5Service.UploadCustomerPhotoAsync(
                stream, compressed.FileName, compressed.ContentType,
                _order.CustomerPhone, _photoCaption);
            _photoMessage = "Cảm ơn bạn! Ảnh đang chờ duyệt và sẽ sớm hiện ở gallery.";
            _photoCaption = null;
            _selectedPhoto = null;
        }
        catch (Exception ex)
        {
            _photoError = true;
            _photoMessage = ex.Message;
        }
        finally
        {
            _uploadingPhoto = false;
        }
    }

    /// <summary>Shape of the object returned by interop.compressImageFromInput.</summary>
    private sealed class CompressedImage
    {
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
        public string FileName { get; set; } = "image.jpg";
        public string ContentType { get; set; } = "image/jpeg";
    }
