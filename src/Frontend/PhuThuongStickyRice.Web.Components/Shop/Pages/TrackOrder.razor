@* Khảo sát hài lòng sau mua: popup nhỏ, không làm phiền, chỉ hiện 1 lần/đơn. *@
@if (_showSurveyPopup && _order != null)
{
    <div class="to-survey-overlay"
         @onclick="DismissSurveyAsync">
        <div class="to-survey-sheet"
             @onclick:stopPropagation="true">
            <div class="to-survey-emoji">😋</div>
            <h5 class="to-survey-title">
                Bạn hài lòng về món ăn chứ?
            </h5>
            <p class="text-muted small mb-3">Đánh giá của bạn giúp Xôi Phú Thượng phục vụ tốt hơn.</p>
            <div class="mb-3" role="radiogroup" aria-label="Chọn số sao đánh giá món ăn">
                @for (var star = 1; star <= 5; star++)
                {
                    var s = star;
                    <button type="button" class="btn btn-link p-0 mr-1 to-survey-star @(s <= _surveyRating ? "on" : "")"
                            role="radio" aria-checked="@(s == _surveyRating)"
