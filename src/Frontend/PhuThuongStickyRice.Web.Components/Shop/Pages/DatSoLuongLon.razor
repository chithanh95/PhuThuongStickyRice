    private decimal EstimatedPerDelivery
    {
        get
        {
            var unit = _subSelectedProduct?.Price ?? 0;
            if (_sub.SizeOptionId.HasValue && _subSelectedProduct != null)
            {
                var size = _subSelectedProduct.Sizes.FirstOrDefault(s => s.Id == _sub.SizeOptionId.Value);
                if (size != null)
                {
                    unit = size.Price;
                }
