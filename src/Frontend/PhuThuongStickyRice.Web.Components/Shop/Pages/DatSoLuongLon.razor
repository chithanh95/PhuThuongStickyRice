        if (!IsValidPhone(_sub.Phone))
        {
            _subError = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }
        if (_sub.ProductId == Guid.Empty)
        {
            _subError = "Vui lòng chọn món xôi.";
            return;
        }
        if (_sub.StartDate.Date < DateTime.Today)
        {
            _subError = "Ngày bắt đầu không được trong quá khứ.";
            return;
        }
        if (_subWeekdays.Count == 0)
        {
            _subError = "Vui lòng chọn ít nhất một ngày giao trong tuần.";
            return;
