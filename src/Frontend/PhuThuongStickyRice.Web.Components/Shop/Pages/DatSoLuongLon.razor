    private const int BulkTier2MinQty = 100;
    private const int BulkTier2MaxQty = 199;
    private const decimal BulkTier2DiscountPct = 8m;
    private const int BulkTier3MinQty = 200;
    private const decimal BulkTier3DiscountPct = 12m;

    private static decimal BulkTierDiscountPct(int qty) => qty >= BulkTier3MinQty ? BulkTier3DiscountPct
        : qty >= BulkTier2MinQty ? BulkTier2DiscountPct
        : qty >= BulkTier1MinQty ? BulkTier1DiscountPct
        : 0m;

    private decimal BulkSelectedUnitTotal => _products
        .Where(p => _bulkProductIds.Contains(p.Id))
        .Sum(p => p.Price);

    private decimal BulkOriginalTotal => BulkSelectedUnitTotal * Math.Max(0, _bulk.Quantity);

    private decimal BulkDiscountPct => BulkTierDiscountPct(_bulk.Quantity);

    private decimal BulkDiscountAmount => BulkOriginalTotal * BulkDiscountPct / 100m;

    private decimal BulkFinalTotal => BulkOriginalTotal - BulkDiscountAmount;

