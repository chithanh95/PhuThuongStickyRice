@* Form đặt số lượng lớn (đám tiệc/sự kiện): 3 bước (1-sự kiện & số lượng, 2-chọn món,
   3-thông tin liên hệ) → gửi yêu cầu báo giá → hiện QR cọc 30% qua VietQR (in được qua
   window.print). Đơn số lượng lớn áp giá chiết khấu theo bậc (tier) tự động. *@
@page "/dat-so-luong-lon"
<PageTitle>Đặt số lượng lớn — Xôi Phú Thượng</PageTitle>
@using System
@using static PhuThuongStickyRice.Web.Components.Core.Helpers.PriceFormat;
@using System.Collections.Generic
@using System.Linq
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopService ShopService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject PhuThuongStickyRice.Web.Components.Core.Services.ToastService Toasts

<h1>Đặt số lượng lớn</h1>
<p class="text-muted">
    Công ty, đám tiệc, cúng giỗ hay quán ăn cần số lượng lớn —
    để lại thông tin, shop sẽ liên hệ báo giá trong thời gian sớm nhất.
</p>

@* SL4: print-only quote (visible only when printing) *@
<div class="bulk-print-only" aria-hidden="true">
    <h2>Báo giá đặt số lượng lớn</h2>
    <p><strong>Xôi Phú Thượng</strong> — Ngày báo giá: @DateTime.Today.ToString("dd/MM/yyyy")</p>
    <table>
        <thead><tr><th>Món</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
        <tbody>
            @foreach (var product in _products.Where(x => _bulkProductIds.Contains(x.Id)))
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@FormatPrice(product.Price)</td>
                    <td>@_bulk.Quantity gói</td>
                    <td>@FormatPrice(product.Price * Math.Max(0, _bulk.Quantity))</td>
                </tr>
            }
        </tbody>
    </table>
    <p>Giá gốc: @FormatPrice(BulkOriginalTotal)</p>
    <p>Chiết khấu (@(BulkDiscountPct.ToString("0"))% theo số lượng): −@FormatPrice(BulkDiscountAmount)</p>
    <p><strong>Thành tiền ước tính: @FormatPrice(BulkFinalTotal)</strong></p>
    <p>Ngày muốn nhận hàng: @(_bulkDate?.ToString("dd/MM/yyyy") ?? "—") · Loại sự kiện: @_bulkEventType</p>
    <p>Hình thức nhận hàng: quý khách tự đến lấy tại quán hoặc tự book shipper đến lấy. Shop liên hệ xác nhận báo giá và phương thức thanh toán sau khi nhận yêu cầu.</p>
    <p><small>Báo giá tham khảo — giá chính thức do shop xác nhận. Cam kết phản hồi trong 2 giờ làm việc.</small></p>
</div>

<style>
    @@media (max-width: 576px) {
        .bulk-submit { width: 100%; min-height: 50px; font-size: 1.05rem; }
    }
    .bulk-prod { display: flex; align-items: center; gap: 12px; border: 1px solid #e9dfcb; border-radius: 12px; padding: 8px 12px; margin-bottom: 8px; cursor: pointer; background: #fff; }
    .bulk-prod.selected { border-color: #a67c3d; background: #fdf8ef; }
    .bulk-prod img { width: 52px; height: 52px; object-fit: cover; border-radius: 8px; flex: none; }
    .bulk-prod .nm { font-weight: 700; color: #2e2620; }
    .bulk-prod .pr { color: #7d6c58; font-size: .9rem; }
    .bulk-prod input { width: 20px; height: 20px; flex: none; }
    /* SL4: print-only quote */
    .bulk-print-only { display: none; }
    @@media print {
        .bulk-print-only { display: block !important; position: absolute; left: 0; top: 0; width: 100%; background: #fff !important; color: #000 !important; padding: 24px; }
        .bulk-print-only table { width: 100%; border-collapse: collapse; margin: 12px 0; }
        .bulk-print-only th, .bulk-print-only td { border: 1px solid #999; padding: 6px 10px; text-align: left; }
        body * { visibility: hidden; }
        .bulk-print-only, .bulk-print-only * { visibility: visible; }
    }
</style>

@* ============ FORM SỐ LƯỢNG LỚN — 3 bước (SL3) ============ *@
@if (_bulkDone)
{
    <div class="alert alert-success">
        <h4>Cảm ơn bạn!</h4>
        <p class="mb-0">
            Shop đã nhận yêu cầu đặt số lượng lớn và sẽ liên hệ qua số
            <strong>@_bulk.CustomerPhone</strong> để báo giá trong thời gian sớm nhất.
        </p>
    </div>
    @* SL2: đặt cọc 30% qua VietQR *@
    <div class="card mt-3">
        <div class="card-header"><strong>💰 Đặt cọc 30% giữ chỗ</strong></div>
        <div class="card-body text-center">
            <p class="mb-2">
                Quét mã QR để chuyển khoản đặt cọc
                <strong class="text-danger">@FormatPrice(_depositAmount)</strong>
                (30% của @FormatPrice(BulkFinalTotal)).
            </p>
            @if (!string.IsNullOrEmpty(DepositQrUrl))
            {
                <img src="@DepositQrUrl" alt="QR đặt cọc" class="bulk-qr" />
                <p class="mt-2 mb-1">Nội dung chuyển khoản: <strong>@_depositCode</strong></p>
                <table class="table table-sm text-left bulk-bank-table">
                    <tr><td><strong>Ngân hàng</strong></td><td>@_bankInfo.BankName</td></tr>
                    <tr><td><strong>Số tài khoản</strong></td><td><strong>@_bankInfo.AccountNumber</strong></td></tr>
                    <tr><td><strong>Chủ tài khoản</strong></td><td>@_bankInfo.AccountName</td></tr>
                </table>
            }
            else
            {
                <p class="text-muted">Shop chưa cấu hình tài khoản nhận cọc — vui lòng gọi hotline để được hướng dẫn.</p>
            }
            <button class="btn btn-success mt-2" @onclick="ConfirmDeposit" disabled="@_depositConfirmed">
                @(_depositConfirmed ? "✓ Đã ghi nhận chuyển khoản" : "Tôi đã chuyển khoản")
            </button>
            @if (_depositConfirmed)
            {
                <p class="text-muted mt-2 mb-0"><small>Shop sẽ kiểm tra và xác nhận cọc qua số điện thoại của bạn.</small></p>
            }
        </div>
    </div>
    <a class="btn btn-primary mt-3" href="/shop">Xem thực đơn</a>
}
else
{
    @if (!string.IsNullOrEmpty(_bulkError))
    {
        <div class="alert alert-danger" role="alert">@_bulkError</div>
    }
    <div class="bulk-steps">
        <div class="bulk-step @(_bulkStep > 1 ? "done" : "") @(_bulkStep == 1 ? "active" : "")" aria-current="@(_bulkStep == 1 ? "step" : null)"><span>1</span><em>Sự kiện &amp; số lượng</em></div>
        <div class="bulk-step @(_bulkStep > 2 ? "done" : "") @(_bulkStep == 2 ? "active" : "")" aria-current="@(_bulkStep == 2 ? "step" : null)"><span>2</span><em>Thực đơn</em></div>
        <div class="bulk-step @(_bulkStep == 3 ? "active" : "")" aria-current="@(_bulkStep == 3 ? "step" : null)"><span>3</span><em>Liên hệ</em></div>
    </div>

    @if (_bulkStep == 1)
    {
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label for="bsl-event-type">Loại sự kiện *</label>
                    <select id="bsl-event-type" class="form-control" @bind="_bulkEventType">
                        <option>Đám tiệc</option>
                        <option>Công ty / văn phòng</option>
                        <option>Cúng giỗ</option>
                        <option>Quán ăn / đại lý</option>
                        <option>Khác</option>
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="bsl-date">Ngày muốn nhận hàng *</label>
                        <input id="bsl-date" type="date" class="form-control" @bind="_bulkDate"
                               min="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" />
                        <small class="form-text text-muted">Đơn số lượng lớn cần đặt trước ít nhất 3 ngày để quán chuẩn bị.</small>
                    </div>
                    <div class="form-group col-md-6">
                        <label for="bsl-qty">Số lượng dự kiến (gói) *</label>
                        <input id="bsl-qty" type="number" min="50" class="form-control" @bind="_bulk.Quantity" />
                        <small class="form-text text-muted">Đơn số lượng lớn từ 50 gói trở lên.</small>
                    </div>
                </div>
                <button class="btn btn-primary bulk-submit" @onclick="BulkNextFromStep1">Tiếp tục →</button>
            </div>
        </div>
    }
    else if (_bulkStep == 2)
    {
        <div class="card">
            <div class="card-body">
                <div class="form-group" role="group" aria-labelledby="bsl-products">
                    <label id="bsl-products">Chọn món *</label>
                    @if (_loadFailed)
                    {
                        <div class="alert alert-warning d-flex align-items-center justify-content-between">
                            <span>Không tải được danh sách món. Kiểm tra kết nối mạng rồi thử lại nhé.</span>
                            <button type="button" class="btn btn-sm btn-outline-primary ms-2" @onclick="LoadProductsAsync">Tải lại</button>
                        </div>
                    }
                    else if (_products.Count == 0)
                    {
                        <p class="text-muted">Đang tải danh sách món...</p>
                    }
                    @foreach (var product in _products)
                    {
                        <label class="bulk-prod @(_bulkProductIds.Contains(product.Id) ? "selected" : "")">
                            <input type="checkbox" checked="@_bulkProductIds.Contains(product.Id)"
                                   @onchange="e => ToggleBulkProduct(product.Id, (bool)e.Value)" />
                            <img loading="lazy" src="@ProductImage(product)" alt="" />
                            <span>
                                <span class="nm">@product.Name</span><br />
                                <span class="pr">@FormatPrice(product.Price)/gói</span>
                            </span>
                        </label>
                    }
                </div>
                <div class="alert alert-info mb-3">
                    <strong>Bảng chiết khấu theo số lượng:</strong><br />
                    <small>50–99 gói: giảm 5% &nbsp;|&nbsp; 100–199 gói: giảm 8% &nbsp;|&nbsp; Từ 200 gói: giảm 12%</small>
                </div>
                <div class="card bg-light mb-3">
                    <div class="card-body py-2">
                        <div class="form-row align-items-end mb-2">
                            <div class="form-group col-6 col-md-4 mb-0">
                                <label class="mb-1" for="bsl-qty2">Số lượng (gói)</label>
                                <input id="bsl-qty2" type="number" min="50" class="form-control" @bind="_bulk.Quantity" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between"><span>Giá gốc</span><strong>@FormatPrice(BulkOriginalTotal)</strong></div>
                        <div class="d-flex justify-content-between"><span>Chiết khấu (@(BulkDiscountPct.ToString("0"))%)</span><strong class="text-success">−@FormatPrice(BulkDiscountAmount)</strong></div>
                        <hr class="my-1" />
                        <div class="d-flex justify-content-between"><span><strong>Thành tiền ước tính</strong></span><strong class="text-danger bulk-total">@FormatPrice(BulkFinalTotal)</strong></div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PrintQuote">🖨 In / Lưu báo giá</button>
                        </div>
                    </div>
                </div>
                <button class="btn btn-outline-secondary" @onclick="() => _bulkStep = 1">← Quay lại</button>
                <button class="btn btn-primary bulk-submit ml-2" @onclick="BulkNextFromStep2">Tiếp tục →</button>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="bsl-name">Họ tên *</label>
                        <input id="bsl-name" class="form-control" @bind="_bulk.CustomerName" placeholder="Nguyễn Văn A" />
                    </div>
                    <div class="form-group col-md-6">
                        <label for="bsl-phone">Số điện thoại *</label>
                        <input id="bsl-phone" inputmode="tel" class="form-control" @bind="_bulk.CustomerPhone" placeholder="0901234567" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="bsl-location">Địa điểm tổ chức</label>
                    <input id="bsl-location" class="form-control" @bind="_bulk.EventLocation" placeholder="VD: Nhà văn hóa phường..." />
                </div>
                <div class="form-group">
                    <label for="bsl-budget">Ngân sách dự kiến (không bắt buộc)</label>
                    <input id="bsl-budget" class="form-control" @bind="_bulk.Budget" placeholder="VD: khoảng 2 triệu" />
                </div>
                <div class="form-group">
                    <label for="bsl-notes">Ghi chú thêm</label>
                    <textarea id="bsl-notes" class="form-control" rows="3" @bind="_bulkNotes"
                              placeholder="VD: giao trước 9h sáng, chia 2 đợt, cần hóa đơn..."></textarea>
                </div>
                <p class="text-muted">📞 <strong>Cam kết phản hồi báo giá trong 2 giờ làm việc.</strong></p>
                <button class="btn btn-outline-secondary" @onclick="() => _bulkStep = 2">← Quay lại</button>
                <button class="btn btn-success btn-lg bulk-submit ml-2" @onclick="SubmitBulk" disabled="@_submitting">
                    @(_submitting ? "Đang gửi..." : "Gửi yêu cầu báo giá")
                </button>
            </div>
        </div>
    }
}

@code {
    private bool _submitting;

    private List<ShopProductModel> _products = new List<ShopProductModel>();
    private bool _loadFailed;

    // ---- Bulk (QuoteRequest) ----
    private readonly QuoteRequestModel _bulk = new QuoteRequestModel { QuoteType = "SoLuongLon", Quantity = 50 };
    private readonly HashSet<Guid> _bulkProductIds = new HashSet<Guid>();
    private DateTime? _bulkDate;
    private string _bulkNotes;
    private bool _bulkDone;
    private string _bulkError;
    // SL3: 3-step bulk form (1 = event/qty, 2 = menu, 3 = contact)
    private int _bulkStep = 1;
    private string _bulkEventType = "Đám tiệc";

    // ---- SL1: Chiết khấu theo bậc số lượng (mua càng nhiều giảm càng sâu) ----
    // Bậc: 50–99 gói giảm 5%, 100–199 gói giảm 8%, từ 200 gói giảm 12%.
    // Con số là chính sách bán của shop — đổi phải hỏi lại chủ shop.
    private const int BulkTier1MinQty = 50;
    private const int BulkTier1MaxQty = 99;
    private const decimal BulkTier1DiscountPct = 5m;
    private const int BulkTier2MinQty = 100;
    private const int BulkTier2MaxQty = 199;
    private const decimal BulkTier2DiscountPct = 8m;
    private const int BulkTier3MinQty = 200;
    private const decimal BulkTier3DiscountPct = 12m;

    /// <summary>
    /// Tra mức chiết khấu % theo số lượng: từ 50 gói trở lên mới có chiết khấu,
    /// bậc cao hơn luôn thắng (không cộng dồn các bậc).
    /// </summary>
    /// <param name="qty">Số gói đặt.</param>
    /// <returns>% chiết khấu (0 khi dưới 50 gói).</returns>
    private static decimal BulkTierDiscountPct(int qty) => qty >= BulkTier3MinQty ? BulkTier3DiscountPct
        : qty >= BulkTier2MinQty ? BulkTier2DiscountPct
        : qty >= BulkTier1MinQty ? BulkTier1DiscountPct
        : 0m;

    private decimal BulkSelectedUnitTotal => _products
        .Where(p => _bulkProductIds.Contains(p.Id))
        .Sum(p => p.Price);

    private decimal BulkOriginalTotal => BulkSelectedUnitTotal * Math.Max(0, _bulk.Quantity);

    private decimal BulkDiscountPct => BulkTierDiscountPct(_bulk.Quantity);

    private decimal BulkDiscountAmount => BulkOriginalTotal * BulkDiscountPct / 100m;

    private decimal BulkFinalTotal => BulkOriginalTotal - BulkDiscountAmount;

    // ---- SL2: 30% deposit via VietQR ----
    private BankTransferInfoModel _bankInfo;
    private decimal _depositAmount;
    private string _depositCode = string.Empty;
    private bool _depositConfirmed;

    /// <summary>
    /// Tải món còn bán cho bước 2 (chọn món). Lỗi mạng → hiện nút "Tải lại"
    /// thay vì kẹt ở chữ "Đang tải..." vĩnh viễn.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _loadFailed = false;
        try
        {
            var paged = await ShopService.GetProductsAsync();
            _products = paged?.Items?.Where(p => p.Status == "Active").ToList()
                ?? new List<ShopProductModel>();
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    /// <summary>Chọn/bỏ chọn 1 món ở bước 2 (giá tạm tính cập nhật ngay trên màn hình).</summary>
    /// <param name="id">Id món.</param>
    /// <param name="selected">true = chọn, false = bỏ chọn.</param>
    private void ToggleBulkProduct(Guid id, bool selected)
    {
        if (selected) { _bulkProductIds.Add(id); }
        else { _bulkProductIds.Remove(id); }
    }

    /// <summary>
    /// Validate bước 1 (sự kiện & số lượng): bắt chọn loại sự kiện, ngày nhận phải
    /// trước ít nhất 3 ngày (shop cần thời gian chuẩn bị nguyên liệu số lượng lớn),
    /// và tối thiểu 50 gói (đơn nhỏ hơn đặt trực tiếp ở /shop).
    /// </summary>
    private void BulkNextFromStep1()
    {
        _bulkError = null;
        if (string.IsNullOrWhiteSpace(_bulkEventType))
        {
            _bulkError = "Vui lòng chọn loại sự kiện.";
            return;
        }
        if (_bulkDate == null)
        {
            _bulkError = "Vui lòng chọn ngày muốn nhận hàng.";
            return;
        }
        if (_bulkDate.Value.Date < DateTime.Today.AddDays(3))
        {
            _bulkError = "Vui lòng đặt trước ít nhất 3 ngày.";
            return;
        }
        if (_bulk.Quantity < 50)
        {
            _bulkError = "Đơn số lượng lớn từ 50 gói trở lên. Đơn nhỏ hơn vui lòng đặt tại cửa hàng.";
            return;
        }
        _bulkStep = 2;
    }

    /// <summary>
    /// Validate bước 2: bắt chọn ít nhất 1 món rồi mới sang bước 3
    /// (thông tin liên hệ).
    /// </summary>
    private void BulkNextFromStep2()
    {
        _bulkError = null;
        if (_bulkProductIds.Count == 0)
        {
            _bulkError = "Vui lòng chọn ít nhất một món.";
            return;
        }
        // bug-hunt 2026-10-19: bước 2 cho sửa lại số lượng (@bind:event="oninput")
        // nhưng không re-validate -> đổi 50 thành 10 ở bước 2 vẫn qua được, qua mặt
        // điều kiện "tối thiểu 50 gói" của bước 1. Validate lại ở đây.
        if (_bulk.Quantity < 50)
        {
            _bulkError = "Đơn số lượng lớn từ 50 gói trở lên. Đơn nhỏ hơn vui lòng đặt tại cửa hàng.";
            return;
        }
        _bulkStep = 3;
    }

    /// <summary>
    /// Gửi yêu cầu báo giá số lượng lớn: validate tên + SĐT, ghép tên món và loại
    /// sự kiện vào ghi chú, gọi API CreateQuoteAsync. Khi thành công: tính cọc 30%
    /// trên tổng đã chiết khấu, sinh mã cọc "COC" + SĐT (dễ tra soát), tải thông
    /// tin chuyển khoản và hiện QR VietQR.
    /// </summary>
    private async Task SubmitBulk()
    {
        _bulkError = null;
        if (string.IsNullOrWhiteSpace(_bulk.CustomerName))
        {
            _bulkError = "Vui lòng nhập họ tên.";
            return;
        }
        if (!IsValidPhone(_bulk.CustomerPhone))
        {
            _bulkError = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }

        _submitting = true;
        try
        {
            var names = string.Join(", ", _products
                .Where(p => _bulkProductIds.Contains(p.Id))
                .Select(p => p.Name));
            _bulk.EventDate = _bulkDate;
            _bulk.Notes = $"Loại sự kiện: {_bulkEventType}. Món: {names}."
                + (string.IsNullOrWhiteSpace(_bulkNotes) ? "" : $" Ghi chú: {_bulkNotes.Trim()}");
            await ShopService.CreateQuoteAsync(_bulk);
            // SL2: cọc 30% trên tổng ĐÃ chiết khấu theo bậc — giữ chân khách đơn lớn,
            // shop có cơ sở chuẩn bị nguyên liệu; 30% là quy định chung của shop.
            _depositAmount = BulkFinalTotal * 0.30m;
            // Mã cọc tra soát: "COC" + SĐT khách (dễ đối chiếu trên sao kê).
            _depositCode = "COC" + new string((_bulk.CustomerPhone ?? "").Where(char.IsDigit).ToArray());
            _depositConfirmed = false;
            await LoadBankInfoAsync();
            _bulkDone = true;
        }
        catch (Exception)
        {
            _bulkError = "Gửi yêu cầu thất bại. Vui lòng thử lại hoặc gọi trực tiếp cho shop.";
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>Tải thông tin tài khoản ngân hàng của shop để dựng QR VietQR tiền cọc.</summary>
    private async Task LoadBankInfoAsync()
    {
        try
        {
            _bankInfo = await ShopService.GetBankTransferInfoAsync();
        }
        catch (Exception)
        {
            _bankInfo = new BankTransferInfoModel();
        }
    }

    /// <summary>SL2: VietQR URL for the 30% deposit, same pattern as Checkout.</summary>
    private string DepositQrUrl
    {
        get
        {
            if (_bankInfo == null || !_bankInfo.IsConfigured || string.IsNullOrEmpty(_depositCode))
            {
                return string.Empty;
            }

            var template = string.IsNullOrWhiteSpace(_bankInfo.QrTemplate) || _bankInfo.QrTemplate == "xxx"
                ? "compact2"
                : _bankInfo.QrTemplate;
            var amount = (long)Math.Round(_depositAmount);
            return $"https://img.vietqr.io/image/{_bankInfo.BankId}-{_bankInfo.AccountNumber}-{template}.png"
                + $"?amount={amount}&addInfo={Uri.EscapeDataString(_depositCode)}"
                + $"&accountName={Uri.EscapeDataString(_bankInfo.AccountName ?? string.Empty)}";
        }
    }

    /// <summary>
    /// Khách bấm "Tôi đã chuyển cọc": ghi nhận trạng thái trên màn hình (shop sẽ
    /// kiểm tra và xác nhận cọc thủ công sau — không trừ tiền tự động).
    /// </summary>
    private void ConfirmDeposit()
    {
        _depositConfirmed = true;
        Toasts.Show("Đã ghi nhận chuyển khoản của bạn. Shop sẽ kiểm tra và xác nhận cọc trong thời gian sớm nhất.");
    }

    /// <summary>SL4: print-friendly quote via the browser (print-to-PDF).</summary>
    private async Task PrintQuote()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception)
        {
            // Printing is a nice-to-have; the estimate stays on screen.
        }
    }


    /// <summary>SĐT VN di động hợp lệ: 10 số, đầu 03/05/07/08/09 (định dạng mạng VN).</summary>
    /// <param name="phone">Số điện thoại nhập vào.</param>
    /// <returns>true khi đúng định dạng di động VN.</returns>
    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");

