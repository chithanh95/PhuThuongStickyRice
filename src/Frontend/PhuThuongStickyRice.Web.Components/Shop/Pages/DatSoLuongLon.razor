    private void BulkNextFromStep2()
    {
        _bulkError = null;
        if (_bulkProductIds.Count == 0)
        {
            _bulkError = "Vui lòng chọn ít nhất một món.";
            return;
        }
        _bulkStep = 3;
    }

    private async Task SubmitBulk()
    {
        _bulkError = null;
        if (string.IsNullOrWhiteSpace(_bulk.CustomerName))
        {
            _bulkError = "Vui lòng nhập họ tên.";
            return;
        }
        if (!IsValidPhone(_bulk.CustomerPhone))
        {
            _bulkError = "Số điện thoại không đúng định dạng (VD: 0901234567).";
            return;
        }

        _submitting = true;
        try
        {
            var names = string.Join(", ", _products
                .Where(p => _bulkProductIds.Contains(p.Id))
                .Select(p => p.Name));
            _bulk.EventDate = _bulkDate;
            _bulk.Notes = $"Loại sự kiện: {_bulkEventType}. Món: {names}."
                + (string.IsNullOrWhiteSpace(_bulkNotes) ? "" : $" Ghi chú: {_bulkNotes.Trim()}");
            await ShopService.CreateQuoteAsync(_bulk);
            // SL2: 30% deposit on the discounted estimate
            _depositAmount = BulkFinalTotal * 0.30m;
            _depositCode = "COC" + new string((_bulk.CustomerPhone ?? "").Where(char.IsDigit).ToArray());
            _depositConfirmed = false;
            await LoadBankInfoAsync();
            _bulkDone = true;
        }
        catch (Exception)
        {
            _bulkError = "Gửi yêu cầu thất bại. Vui lòng thử lại hoặc gọi trực tiếp cho shop.";
        }
        finally
