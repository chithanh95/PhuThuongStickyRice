    };

    private static string LongDayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Thứ 2",
        DayOfWeek.Tuesday => "Thứ 3",
        DayOfWeek.Wednesday => "Thứ 4",
        DayOfWeek.Thursday => "Thứ 5",
        DayOfWeek.Friday => "Thứ 6",
        DayOfWeek.Saturday => "Thứ 7",
        DayOfWeek.Sunday => "Chủ nhật",
        _ => "",
    };

    private void SetWeekdayPreset(string preset)
    {
        _weekdayPreset = preset;
        _subWeekdays.Clear();
        if (preset == "daily")
        {
            foreach (var d in WeekdayOrder)
            {
                _subWeekdays.Add(d);
            }
        }
        else if (preset == "weekdays")
        {
            _subWeekdays.Add(DayOfWeek.Monday);
            _subWeekdays.Add(DayOfWeek.Tuesday);
            _subWeekdays.Add(DayOfWeek.Wednesday);
            _subWeekdays.Add(DayOfWeek.Thursday);
            _subWeekdays.Add(DayOfWeek.Friday);
        }
        // "custom": keep the user's current picks
    }

    private void ToggleSubWeekday(DayOfWeek d, bool on)
    {
        if (on)
        {
            _subWeekdays.Add(d);
        }
        else
        {
            _subWeekdays.Remove(d);
        }
        _weekdayPreset = "custom";
    }

    private string SubscriptionScheduleLabel => _subWeekdays.Count == 0 ? "Chưa chọn ngày giao"
        : _subWeekdays.Count == 7 ? "Hằng ngày"
        : string.Join(", ", WeekdayOrder.Where(d => _subWeekdays.Contains(d)).Select(LongDayName));

    // ---- DK4: deliveries + monthly estimate for the next 30 days ----
    private int DeliveriesNext30Days
    {
        get
        {
            if (_subWeekdays.Count == 0)
            {
                return 0;
            }

            var start = _sub.StartDate.Date < DateTime.Today ? DateTime.Today : _sub.StartDate.Date;
            var count = 0;
            for (var d = start; d < start.AddDays(30); d = d.AddDays(1))
            {
                if (_subWeekdays.Contains(d.DayOfWeek))
                {
                    count++;
                }
            }

            return count;
        }
    }

    private decimal MonthlyEstimate => EstimatedPerDelivery * DeliveriesNext30Days;

    private async Task SubmitSub()
    {
        _subError = null;
        if (string.IsNullOrWhiteSpace(_sub.CustomerName)
            || string.IsNullOrWhiteSpace(_sub.DeliveryAddress))
        {
