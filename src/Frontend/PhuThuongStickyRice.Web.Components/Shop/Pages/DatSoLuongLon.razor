        _submitting = true;
        try
        {
            var notes = _sub.Notes?.Trim();
            _sub.Notes = $"[Lịch giao: {SubscriptionScheduleLabel}]" + (string.IsNullOrEmpty(notes) ? "" : $" {notes}");
            _created = await Wave2Service.CreateSubscriptionAsync(_sub);
            // SL2: 30% deposit on the first month's estimate
