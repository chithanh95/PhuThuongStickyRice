@page "/anh-khach-hang"
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject AdminCommerceService AdminCommerceService
@inject ShopI18n ShopI18n
@implements IDisposable

<h3>@ShopI18n.Translate("gallery")</h3>
<p class="text-muted">Những món xôi do chính khách hàng của chúng tôi chụp 📸</p>

@if (_photos == null)
{
    <p><em>@ShopI18n.Translate("loading")</em></p>
}
else if (_photos.Count == 0)
{
    <div class="alert alert-info">Chưa có ảnh nào. Hãy là người đầu tiên chia sẻ sau khi nhận món nhé!</div>
}
else
{
    <div class="row xo-gallery">
        @foreach (var p in _photos)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-3">
                <div class="card h-100">
                    <img src="@AdminCommerceService.ResolveImageUrl(p.ImageUrl)" class="card-img-top xo-gallery-img" alt="Ảnh món ăn của khách hàng" loading="lazy" />
                    @if (!string.IsNullOrWhiteSpace(p.Caption))
                    {
                        <div class="card-body p-2">
                            <p class="card-text small mb-0">@p.Caption</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<CustomerPhotoModel> _photos;

    protected override async Task OnInitializedAsync()
    {
        ShopI18n.OnChange += OnLangChanged;
        await ShopI18n.InitializeAsync();
        try
        {
            // Bug-hunt 2026-10-19 (17:55): GetApprovedPhotosAsync trả null khi
            // API trả body rỗng (ReadAs<T> trả default, không ném) — không guard
            // thì trang kẹt "Đang tải..." vĩnh viễn.
            _photos = await AdminCommerceService.GetApprovedPhotosAsync() ?? new List<CustomerPhotoModel>();
        }
        catch (Exception)
        {
            _photos = new List<CustomerPhotoModel>();
        }
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ShopI18n.OnChange -= OnLangChanged;
    }
}
