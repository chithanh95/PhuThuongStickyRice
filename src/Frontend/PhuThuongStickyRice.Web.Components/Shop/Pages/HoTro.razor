@page "/ho-tro"
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopEngagementService ShopEngagementService

<h1>Hỗ trợ khách hàng</h1>
<p class="text-muted">Gửi yêu cầu hỗ trợ, shop sẽ liên hệ lại với bạn sớm nhất.</p>

@if (_sent)
{
    <div class="alert alert-success" role="status">
        <strong>Đã gửi yêu cầu hỗ trợ!</strong> Shop sẽ liên hệ lại qua số <strong>@_ticket.Phone</strong> sớm nhất.
    </div>
    <button class="btn btn-outline-primary ht-submit" @onclick="ResetSupportForm">Gửi yêu cầu khác</button>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="ht-name">Họ tên *</label>
                    <input id="ht-name" class="form-control" @bind="_model.Name" placeholder="Nguyễn Văn A" aria-required="true" />
                </div>
                <div class="form-group col-md-6">
                    <label for="ht-phone">Số điện thoại *</label>
                    <input id="ht-phone" inputmode="tel" class="form-control" @bind="_model.Phone" placeholder="0901234567" aria-required="true" />
                </div>
            </div>
            <div class="form-group">
                <label for="ht-order">Mã đơn hàng <small class="text-muted">(nếu có)</small></label>
                <input id="ht-order" class="form-control" @bind="_model.OrderNumber" placeholder="PX-20261014-0001" />
            </div>
            <div class="form-group">
                <label for="ht-message">Nội dung cần hỗ trợ *</label>
                <textarea id="ht-message" class="form-control" rows="5" @bind="_model.Message"
                          placeholder="Mô tả vấn đề bạn gặp phải..." aria-required="true"></textarea>
            </div>
            <button class="btn btn-primary ht-submit" @onclick="SubmitSupportTicketAsync" disabled="@_submitting">
                @(_submitting ? "Đang gửi..." : "Gửi yêu cầu")
            </button>
        </div>
    </div>
}

@code {
    private readonly CreateSupportTicketModel _model = new CreateSupportTicketModel();
    private SupportTicketModel _ticket;
    private bool _sent;
    private bool _submitting;
    private string _error;

    private async Task SubmitSupportTicketAsync()
    {
        // Bug-hunt 2026-10-19 (17:55): chặn bấm đúp tạo 2 ticket hỗ trợ trùng.
        // disabled="@_submitting" chỉ có hiệu lực sau lần re-render đầu tiên.
        if (_submitting) return;

        _error = null;
        if (string.IsNullOrWhiteSpace(_model.Name)
            || string.IsNullOrWhiteSpace(_model.Phone)
            || string.IsNullOrWhiteSpace(_model.Message))
        {
            _error = "Vui lòng nhập đầy đủ họ tên, số điện thoại và nội dung.";
            return;
        }

        _submitting = true;
        try
        {
            _ticket = await ShopEngagementService.CreateTicketAsync(_model);
            _sent = true;
        }
        catch (Exception)
        {
            _error = "Không gửi được yêu cầu. Vui lòng thử lại.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetSupportForm()
    {
        _sent = false;
        _ticket = null;
        _model.Name = null;
        _model.Phone = null;
        _model.OrderNumber = null;
        _model.Message = null;
    }
}
