@page "/dat-tiec"
<PageTitle>Đặt tiệc — Xôi Phú Thượng</PageTitle>
@using System
@using System.Linq
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService

<h1>Đặt tiệc / Đặt số lượng lớn</h1>
<p class="text-muted">
    Đám cưới, đám giỗ, liên hoan công ty hay đặt cỗ số lượng lớn — để lại thông tin,
    shop sẽ gọi lại báo giá tốt nhất. <strong>Không cần thanh toán trước.</strong><br />
    <a href="/cung-gio">🕯️ Đặt xôi cúng giỗ riêng tại đây</a>
</p>

@if (_submitted)
{
    <div class="alert alert-success" role="status">
        <h4>Cảm ơn bạn!</h4>
        <p class="mb-0">
            Shop đã nhận được yêu cầu đặt tiệc của bạn và sẽ liên hệ qua số
            <strong>@_model.CustomerPhone</strong> để báo giá trong thời gian sớm nhất.
        </p>
    </div>
    <a class="btn btn-primary" href="/shop">Xem thực đơn</a>
    @* DT3: chat Zalo ngay sau khi đặt tiệc thành công. *@
    @if (!string.IsNullOrWhiteSpace(_zaloUrl))
    {
        <a class="btn btn-success ml-2 mt-2 mt-sm-0" href="@_zaloUrl" target="_blank" rel="noopener">💬 Trao đổi thêm qua Zalo</a>
    }
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="form-group">
                <label for="dt-name">Họ tên *</label>
                <input id="dt-name" class="form-control @FieldClass(_nameError)" @bind="_model.CustomerName" placeholder="Nguyễn Văn A"
                       aria-invalid="@(!string.IsNullOrEmpty(_nameError) ? "true" : null)"
                       aria-describedby="@(!string.IsNullOrEmpty(_nameError) ? "dt-name-error" : null)" />
                @if (!string.IsNullOrEmpty(_nameError))
                {
                    <small class="text-danger" id="dt-name-error">@_nameError</small>
                }
            </div>
            <div class="form-group">
                <label for="dt-phone">Số điện thoại *</label>
                <input id="dt-phone" inputmode="tel" class="form-control @FieldClass(_phoneError)" @bind="_model.CustomerPhone" placeholder="0901234567"
                       aria-invalid="@(!string.IsNullOrEmpty(_phoneError) ? "true" : null)"
                       aria-describedby="@(!string.IsNullOrEmpty(_phoneError) ? "dt-phone-error" : null)" />
                @if (!string.IsNullOrEmpty(_phoneError))
                {
                    <small class="text-danger" id="dt-phone-error">@_phoneError</small>
                }
            </div>
            @* DT2: loại tiệc điều chỉnh gợi ý & placeholder. *@
            <div class="form-group">
                <label for="dt-party-type">Loại tiệc</label>
                <select id="dt-party-type" class="form-control" @bind="_partyType">
                    <option value="">— Chọn loại tiệc —</option>
                    <option>Cưới hỏi</option>
                    <option>Giỗ</option>
                    <option>Sinh nhật</option>
                    <option>Công ty / Liên hoan</option>
                    <option>Khác</option>
                </select>
                @if (!string.IsNullOrEmpty(PartyTypeHint))
                {
                    <small class="form-text text-muted">@PartyTypeHint</small>
                }
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="dt-date">Ngày tổ chức (dự kiến)</label>
                    <input id="dt-date" type="date" class="form-control" @bind="_model.EventDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group col-md-6">
                    <label for="dt-qty">Số lượng (gói/mâm) *</label>
                    @* DT1: gói mẫu theo số khách — điền sẵn, sửa lại được. *@
                    <div class="mb-2">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Gói mẫu theo số khách">
                            <button type="button" class="btn btn-outline-primary" @onclick="() => ApplyGuestPreset(30)">30 khách</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => ApplyGuestPreset(50)">50 khách</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => ApplyGuestPreset(100)">100 khách</button>
                        </div>
                    </div>
                    <input id="dt-qty" type="number" min="30" class="form-control @FieldClass(_qtyError)" @bind="_model.Quantity"
                           aria-invalid="@(!string.IsNullOrEmpty(_qtyError) ? "true" : null)"
                           aria-describedby="@(!string.IsNullOrEmpty(_qtyError) ? "dt-qty-error" : null)" />
                    @if (!string.IsNullOrEmpty(_qtyError))
                    {
                        <small class="text-danger" id="dt-qty-error">@_qtyError</small>
                    }
                </div>
            </div>
            <div class="form-group">
                <label for="dt-location">Địa điểm tổ chức</label>
                <input id="dt-location" class="form-control" @bind="_model.EventLocation" placeholder="VD: 123 Phố Huế, Hai Bà Trưng, Hà Nội" />
            </div>
            <div class="form-group">
                <label for="dt-notes">Ghi chú món ăn</label>
                <textarea id="dt-notes" class="form-control" rows="3" @bind="_model.Notes"
                          placeholder="@NotesPlaceholder"></textarea>
            </div>
            <button class="btn btn-success btn-lg" @onclick="SubmitAsync" disabled="@_submitting">
                @(_submitting ? "Đang gửi..." : "Gửi yêu cầu báo giá")
            </button>
        </div>
    </div>
}

@code {
    private readonly QuoteRequestModel _model = new QuoteRequestModel { Quantity = 30, QuoteType = "DatTiec" };
    private bool _submitting;
    private bool _submitted;
    private string _error;
    private string _nameError;
    private string _phoneError;
    private string _qtyError;

    // DT2: loại tiệc điều chỉnh gợi ý.
    private string _partyType;
    private ShopSettingModel _shopSettings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shopSettings = await ShopSettingsService.GetPublicAsync();
        }
        catch (Exception)
        {
            _shopSettings = null;
        }
    }

    private string PartyTypeHint => _partyType switch
    {
        "Cưới hỏi" => "Tiệc cưới thường chọn xôi gấc (màu đỏ may mắn) kết hợp xôi ngũ sắc — shop sẽ gợi ý tỉ lệ theo số mâm.",
        "Giỗ" => "Mâm giỗ thường chọn xôi đỗ, xôi vò — dẻo bùi, hợp cúng gia tiên.",
        "Sinh nhật" => "Tiệc sinh nhật hay chọn xôi ngũ sắc — màu sắc đẹp, lên hình bắt mắt.",
        "Công ty / Liên hoan" => "Liên hoan công ty thường chọn xôi xéo, xôi vò — gọn nhẹ, dễ chia suất.",
        _ => null
    };

    private string NotesPlaceholder => _partyType switch
    {
        "Cưới hỏi" => "VD: tiệc cưới 30 mâm, cần giao trước 10h sáng, 20 mâm xôi gấc + 10 mâm xôi ngũ sắc...",
        "Giỗ" => "VD: giỗ 50 khách, 30 gói xôi đỗ + 20 gói xôi vò, giao trước 9h...",
        "Sinh nhật" => "VD: sinh nhật bé 20 khách, 20 gói xôi ngũ sắc, trang trí thêm...",
        "Công ty / Liên hoan" => "VD: liên hoan 100 suất văn phòng, 60 xôi xéo + 40 xôi vò, giao 11h30...",
        _ => "VD: tiệc cưới 30 mâm, cần giao trước 10h sáng, 20 mâm xôi gấc + 10 mâm xôi xéo..."
    };

    // DT1: gói mẫu theo số khách — số lượng + gợi ý món điền sẵn (sửa được).
    private void ApplyGuestPreset(int guests)
    {
        _model.Quantity = guests;
        var suggestion = _partyType switch
        {
            "Cưới hỏi" => $"Gói mẫu {guests} khách (cưới hỏi): ~{(guests * 3 / 5)} gói xôi gấc + ~{(guests * 2 / 5)} gói xôi ngũ sắc — bạn sửa lại cho hợp ý nhé.",
            "Giỗ" => $"Gói mẫu {guests} khách (giỗ): ~{(guests / 2)} gói xôi đỗ + ~{(guests / 2)} gói xôi vò — bạn sửa lại cho hợp ý nhé.",
            "Sinh nhật" => $"Gói mẫu {guests} khách (sinh nhật): {guests} gói xôi ngũ sắc — bạn sửa lại cho hợp ý nhé.",
            "Công ty / Liên hoan" => $"Gói mẫu {guests} suất (liên hoan): ~{(guests / 2)} xôi xéo + ~{(guests / 2)} xôi vò — bạn sửa lại cho hợp ý nhé.",
            _ => $"Gói mẫu {guests} khách: gợi ý {guests} gói xôi (VD: xôi gấc, xôi xéo, xôi ngũ sắc) — bạn sửa lại cho hợp ý nhé."
        };
        if (string.IsNullOrWhiteSpace(_model.Notes))
        {
            _model.Notes = suggestion;
        }
    }

    // DT3: Zalo chat sau khi gửi thành công (pattern từ Shop.razor).
    private string ZaloPhone => !string.IsNullOrWhiteSpace(_shopSettings?.ZaloPhone)
        ? _shopSettings.ZaloPhone
        : _shopSettings?.Hotline;

    private string _zaloUrl;
    private void BuildZaloUrl()
    {
        if (string.IsNullOrWhiteSpace(ZaloPhone))
        {
            _zaloUrl = null;
            return;
        }
        var digits = new string(ZaloPhone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("0"))
            digits = "84" + digits.Substring(1);
        else if (!digits.StartsWith("84"))
            digits = "84" + digits;
        var text = Uri.EscapeDataString($"Chào quán, mình vừa gửi yêu cầu đặt tiệc ({_partyType ?? "tiệc"}, {_model.Quantity} gói/mâm), cần trao đổi thêm");
        _zaloUrl = $"https://zalo.me/{digits}?text={text}";
    }

    private async Task SubmitAsync()
    {
        // Bug-hunt 2026-10-19 (17:55): chặn bấm đúp tạo 2 yêu cầu trùng.
        // disabled="@_submitting" chỉ có hiệu lực sau lần re-render đầu tiên.
        if (_submitting) return;

        _error = null;
        _nameError = string.IsNullOrWhiteSpace(_model.CustomerName) ? "Vui lòng nhập họ tên." : null;
        _phoneError = !IsValidPhone(_model.CustomerPhone) ? "Số điện thoại không đúng định dạng (VD: 0901234567)." : null;
        _qtyError = _model.Quantity < 30 ? "Đơn đặt tiệc từ 30 gói/mâm trở lên. Đơn nhỏ hơn vui lòng đặt tại cửa hàng." : null;

        if (_nameError != null || _phoneError != null || _qtyError != null)
        {
            _error = "Vui lòng kiểm tra lại các thông tin được đánh dấu.";
            return;
        }

        // Gắn loại tiệc vào ghi chú (model không có field riêng).
        if (!string.IsNullOrWhiteSpace(_partyType)
            && (_model.Notes == null || !_model.Notes.Contains("Loại tiệc:")))
        {
            _model.Notes = $"Loại tiệc: {_partyType}\n" + (_model.Notes ?? "");
        }

        _submitting = true;
        try
        {
            await ShopService.CreateQuoteAsync(_model);
            BuildZaloUrl();
            _submitted = true;
        }
        catch (Exception)
        {
            _error = "Gửi yêu cầu thất bại. Vui lòng thử lại hoặc gọi trực tiếp cho shop.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string FieldClass(string error) => string.IsNullOrEmpty(error) ? null : "is-invalid";

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");
}
