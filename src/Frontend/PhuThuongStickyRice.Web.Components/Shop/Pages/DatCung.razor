@page "/dat-cung"
@using System
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopService ShopService

<h3>🙏 Đặt xôi cúng Rằm &amp; mùng 1</h3>
<p class="text-muted">
    Xôi gấc đỏ, xôi xéo, xôi vò thơm dẻo cho mâm cúng Rằm và mùng 1 —
    để lại thông tin, shop sẽ gọi lại xác nhận. <strong>Không cần thanh toán trước.</strong>
</p>

@if (_submitted)
{
    <div class="alert alert-success">
        <h4>Cảm ơn bạn!</h4>
        <p class="mb-0">
            Shop đã nhận được yêu cầu đặt xôi cúng của bạn và sẽ liên hệ qua số
            <strong>@_model.CustomerPhone</strong> để xác nhận trong thời gian sớm nhất.
        </p>
        @if (_reminderSaved)
        {
            <p class="mb-0 mt-2">🔔 Đã đăng ký <strong>nhắc mỗi tháng</strong> — shop sẽ nhắc bạn trước mỗi dịp cúng.</p>
        }
    </div>
    <a class="btn btn-primary" href="/shop">Xem thực đơn</a>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="form-group">
                <label for="dc-name">Họ tên *</label>
                <input id="dc-name" class="form-control @FieldClass(_nameError)" @bind="_model.CustomerName" placeholder="Nguyễn Văn A" />
                @if (!string.IsNullOrEmpty(_nameError))
                {
                    <small class="text-danger" role="alert">@_nameError</small>
                }
            </div>
            <div class="form-group">
                <label for="dc-phone">Số điện thoại *</label>
                <input id="dc-phone" class="form-control @FieldClass(_phoneError)" @bind="_model.CustomerPhone" placeholder="0901234567" inputmode="tel" />
                @if (!string.IsNullOrEmpty(_phoneError))
                {
                    <small class="text-danger" role="alert">@_phoneError</small>
                }
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label id="dc-dipcung-label">Dịp cúng *</label>
                    <div role="radiogroup" aria-labelledby="dc-dipcung-label">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="dip-ram" name="dipcung"
                                   checked="@(_dipCung == "Ram")" @onchange="@(() => _dipCung = "Ram")" />
                            <label class="form-check-label" for="dip-ram">🌕 Rằm (15 âm lịch)</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="dip-mung1" name="dipcung"
                                   checked="@(_dipCung == "Mung1")" @onchange="@(() => _dipCung = "Mung1")" />
                            <label class="form-check-label" for="dip-mung1">🌑 Mùng 1 (âm lịch)</label>
                        </div>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label for="dc-month">Tháng *</label>
                    <select id="dc-month" class="form-control" @bind="_thangCung">
                        @foreach (var m in _thangOptions)
                        {
                            <option value="@m.Value">@m.Text</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="dc-qty">Số suất *</label>
                    <input id="dc-qty" type="number" min="1" class="form-control @FieldClass(_qtyError)" @bind="_model.Quantity" />
                    @if (!string.IsNullOrEmpty(_qtyError))
                    {
                        <small class="text-danger" role="alert">@_qtyError</small>
                    }
                </div>
                <div class="form-group col-md-6">
                    <label id="dc-loaimam-label">Loại mâm *</label>
                    <div role="radiogroup" aria-labelledby="dc-loaimam-label">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="mam-chay" name="loaimam"
                                   checked="@(_loaiMam == "Chay")" @onchange="@(() => _loaiMam = "Chay")" />
                            <label class="form-check-label" for="mam-chay">🥬 Mâm chay</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="mam-man" name="loaimam"
                                   checked="@(_loaiMam == "Mặn")" @onchange="@(() => _loaiMam = "Mặn")" />
                            <label class="form-check-label" for="mam-man">🍗 Mâm mặn</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="dc-notes">Ghi chú</label>
                <textarea id="dc-notes" class="form-control" rows="3" @bind="_model.Notes"
                          placeholder="VD: cúng Rằm tháng 7, cần giao trước 9h sáng, thêm chè đỗ đen..."></textarea>
            </div>
            <div class="form-group form-check">
                <input type="checkbox" class="form-check-input" id="remind-monthly" @bind="_remindMonthly" />
                <label class="form-check-label" for="remind-monthly">
                    🔔 <strong>Nhắc tôi mỗi tháng</strong> <small class="text-muted">(shop sẽ nhắc bạn trước mỗi dịp Rằm/mùng 1)</small>
                </label>
            </div>
            <button class="btn btn-success btn-lg" @onclick="SubmitAsync" disabled="@_submitting">
                @(_submitting ? "Đang gửi..." : "Gửi yêu cầu đặt cúng")
            </button>
        </div>
    </div>
}

@code {
    private readonly QuoteRequestModel _model = new QuoteRequestModel { Quantity = 5, QuoteType = "DatCung" };
    private string _dipCung = "Ram";
    private string _loaiMam = "Chay";
    private string _thangCung;
    private bool _remindMonthly;
    private bool _submitting;
    private bool _submitted;
    private bool _reminderSaved;
    private string _error;
    private string _nameError;
    private string _phoneError;
    private string _qtyError;

    private sealed class ThangOption
    {
        public string Value { get; set; }
        public string Text { get; set; }
    }

    private readonly System.Collections.Generic.List<ThangOption> _thangOptions = new();

    protected override void OnInitialized()
    {
        var now = DateTime.Now;
        for (var i = 0; i < 3; i++)
        {
            var d = now.AddMonths(i);
            var value = $"{d.Year}-{d.Month:D2}";
            _thangOptions.Add(new ThangOption
            {
                Value = value,
                Text = $"Tháng {d.Month}/{d.Year}" + (i == 0 ? " (tháng này)" : string.Empty)
            });
        }
        _thangCung = _thangOptions[0].Value;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _nameError = string.IsNullOrWhiteSpace(_model.CustomerName) ? "Vui lòng nhập họ tên." : null;
        _phoneError = !IsValidPhone(_model.CustomerPhone) ? "Số điện thoại không đúng định dạng (VD: 0901234567)." : null;
        _qtyError = _model.Quantity < 1 ? "Số suất phải từ 1 trở lên." : null;

        if (_nameError != null || _phoneError != null || _qtyError != null)
        {
            _error = "Vui lòng kiểm tra lại các thông tin được đánh dấu.";
            return;
        }

        var dipLabel = _dipCung == "Ram" ? "Rằm (15 âm lịch)" : "Mùng 1 (âm lịch)";
        var thangLabel = _thangOptions.Find(t => t.Value == _thangCung)?.Text ?? _thangCung;
        _model.Notes = $"[Cúng {dipLabel} — {thangLabel} — Mâm {_loaiMam}]"
            + (string.IsNullOrWhiteSpace(_model.Notes) ? string.Empty : " " + _model.Notes.Trim());

        _submitting = true;
        try
        {
            await ShopService.CreateQuoteAsync(_model);

            if (_remindMonthly)
            {
                try
                {
                    await ShopService.CreateCungReminderAsync(new CungReminderModel
                    {
                        CustomerName = _model.CustomerName,
                        CustomerPhone = _model.CustomerPhone,
                        ReminderType = _dipCung
                    });
                    _reminderSaved = true;
                }
                catch
                {
                    // Reminder is best-effort; the quote itself succeeded.
                    _reminderSaved = false;
                }
            }

            _submitted = true;
        }
        catch (Exception)
        {
            _error = "Gửi yêu cầu thất bại. Vui lòng thử lại hoặc gọi trực tiếp cho shop.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string FieldClass(string error) => string.IsNullOrEmpty(error) ? null : "is-invalid";

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");
}
