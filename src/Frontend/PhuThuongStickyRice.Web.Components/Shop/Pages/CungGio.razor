@page "/cung-gio"
@using System
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopService ShopService

<h3>🕯️ Đặt xôi cúng giỗ</h3>
<p class="text-muted">
    Mâm cúng giỗ đầy đặn, xôi dẻo thơm đúng vị Phú Thượng — để lại thông tin,
    shop sẽ gọi lại xác nhận. <strong>Không cần thanh toán trước.</strong>
</p>

@if (_submitted)
{
    <div class="alert alert-success" role="status">
        <h4>Cảm ơn bạn!</h4>
        <p class="mb-0">
            Shop đã nhận được yêu cầu đặt xôi cúng giỗ của bạn và sẽ liên hệ qua số
            <strong>@_model.CustomerPhone</strong> để xác nhận trong thời gian sớm nhất.
        </p>
    </div>
    <a class="btn btn-primary" href="/shop">Xem thực đơn</a>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="form-group">
                <label for="cg-name">Họ tên *</label>
                <input id="cg-name" class="form-control @FieldClass(_nameError)" @bind="_model.CustomerName" placeholder="Nguyễn Văn A" />
                @if (!string.IsNullOrEmpty(_nameError))
                {
                    <small class="text-danger">@_nameError</small>
                }
            </div>
            <div class="form-group">
                <label for="cg-phone">Số điện thoại *</label>
                <input id="cg-phone" inputmode="tel" class="form-control @FieldClass(_phoneError)" @bind="_model.CustomerPhone" placeholder="0901234567" />
                @if (!string.IsNullOrEmpty(_phoneError))
                {
                    <small class="text-danger">@_phoneError</small>
                }
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="cg-date">Ngày giỗ *</label>
                    <input id="cg-date" type="date" class="form-control @FieldClass(_dateError)" @bind="_model.EventDate"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    @if (!string.IsNullOrEmpty(_dateError))
                    {
                        <small class="text-danger">@_dateError</small>
                    }
                </div>
                <div class="form-group col-md-6">
                    <label for="cg-qty">Số mâm *</label>
                    <input id="cg-qty" type="number" min="1" class="form-control @FieldClass(_qtyError)" @bind="_model.Quantity" />
                    @if (!string.IsNullOrEmpty(_qtyError))
                    {
                        <small class="text-danger">@_qtyError</small>
                    }
                </div>
            </div>
            <div class="form-group">
                <label id="cg-loaimam">Loại mâm *</label>
                <div role="group" aria-labelledby="cg-loaimam">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="mam-chay" name="loaimam"
                               checked="@(_loaiMam == "Chay")" @onchange="@(() => _loaiMam = "Chay")" />
                        <label class="form-check-label" for="mam-chay">🥬 Mâm chay</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="mam-man" name="loaimam"
                               checked="@(_loaiMam == "Mặn")" @onchange="@(() => _loaiMam = "Mặn")" />
                        <label class="form-check-label" for="mam-man">🍗 Mâm mặn</label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="cg-notes">Ghi chú</label>
                <textarea id="cg-notes" class="form-control" rows="3" @bind="_model.Notes"
                          placeholder="VD: giỗ ông nội, cần giao trước 9h sáng, thêm chè đỗ đen..."></textarea>
            </div>
            <button class="btn btn-success btn-lg" @onclick="SubmitAsync" disabled="@_submitting">
                @(_submitting ? "Đang gửi..." : "Gửi yêu cầu đặt cúng giỗ")
            </button>
        </div>
    </div>
}

@code {
    private readonly QuoteRequestModel _model = new QuoteRequestModel { Quantity = 3, QuoteType = "CungGio", EventDate = DateTime.Today };
    private string _loaiMam = "Mặn";
    private bool _submitting;
    private bool _submitted;
    private string _error;
    private string _nameError;
    private string _phoneError;
    private string _dateError;
    private string _qtyError;

    private async Task SubmitAsync()
    {
        _error = null;
        _nameError = string.IsNullOrWhiteSpace(_model.CustomerName) ? "Vui lòng nhập họ tên." : null;
        _phoneError = !IsValidPhone(_model.CustomerPhone) ? "Số điện thoại không đúng định dạng (VD: 0901234567)." : null;
        _dateError = !_model.EventDate.HasValue ? "Vui lòng chọn ngày giỗ." : null;
        _qtyError = _model.Quantity < 1 ? "Số mâm phải từ 1 trở lên." : null;

        if (_nameError != null || _phoneError != null || _dateError != null || _qtyError != null)
        {
            _error = "Vui lòng kiểm tra lại các thông tin được đánh dấu.";
            return;
        }

        var ngayGio = _model.EventDate.Value.ToString("dd/MM/yyyy");
        _model.Notes = $"[Cúng giỗ — ngày {ngayGio} — {_model.Quantity} mâm — Mâm {_loaiMam}]"
            + (string.IsNullOrWhiteSpace(_model.Notes) ? string.Empty : " " + _model.Notes.Trim());

        _submitting = true;
        try
        {
            await ShopService.CreateQuoteAsync(_model);
            _submitted = true;
        }
        catch (Exception)
        {
            _error = "Gửi yêu cầu thất bại. Vui lòng thử lại hoặc gọi trực tiếp cho shop.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string FieldClass(string error) => string.IsNullOrEmpty(error) ? null : "is-invalid";

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");
}
