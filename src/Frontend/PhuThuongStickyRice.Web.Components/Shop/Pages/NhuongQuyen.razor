@page "/nhuong-quyen"
<PageTitle>Nhượng quyền — Xôi Phú Thượng</PageTitle>
@using System
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopService ShopService

<div class="nq-hero">
    <div class="xo-container">
        <h1 class="nq-title">Nhượng quyền Xôi Phú Thượng</h1>
        <div class="xo-sec-div"><span></span><em>Cùng lan tỏa hương vị xôi Việt</em><span></span></div>
        <p class="nq-tagline">
            Mô hình quán xôi tinh gọn, vốn đầu tư hợp lý, hoàn vốn nhanh —
            phù hợp mặt bằng nhỏ, khu dân cư, trường học, văn phòng.
        </p>
        <a href="#nq-form" class="xo-btn xo-btn-red nq-cta">Đăng ký tư vấn</a>
    </div>
</div>

<div class="xo-container nq-section">
    <h2 class="xo-sec-title">Quyền lợi đối tác</h2>
    <div class="xo-sec-div"><span></span><em>Đồng hành từ A đến Z</em><span></span></div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="nq-card">
                <div class="nq-card-icon">📋</div>
                <h4>Công thức chuẩn vị</h4>
                <p>Chuyển giao toàn bộ công thức, định lượng và quy trình chế biến xôi Phú Thượng.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="nq-card">
                <div class="nq-card-icon">🎓</div>
                <h4>Đào tạo tận nơi</h4>
                <p>Đào tạo đội ngũ 7–10 ngày tại quán chính, kèm tài liệu vận hành chi tiết.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="nq-card">
                <div class="nq-card-icon">📦</div>
                <h4>Nguồn nguyên liệu</h4>
                <p>Kết nối nhà cung cấp nếp, đậu, thịt giá gốc, đảm bảo chất lượng đồng đều.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="nq-card">
                <div class="nq-card-icon">🎨</div>
                <h4>Thiết kế & setup</h4>
                <p>Hỗ trợ thiết kế mặt bằng, biển hiệu, quầy kệ theo nhận diện thương hiệu.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="nq-card">
                <div class="nq-card-icon">📣</div>
                <h4>Marketing khai trương</h4>
                <p>Kế hoạch truyền thông khai trương: banner, fanpage, quảng cáo khu vực.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="nq-card">
                <div class="nq-card-icon">💻</div>
                <h4>Phần mềm bán hàng</h4>
                <p>Bàn giao website đặt món + quản trị đơn hàng, doanh thu theo thời gian thực.</p>
            </div>
        </div>
    </div>
</div>

<div class="nq-section nq-cream">
    <div class="xo-container">
        <h2 class="xo-sec-title">Chi phí đầu tư dự kiến</h2>
        <div class="xo-sec-div"><span></span><em>Minh bạch từ đầu</em><span></span></div>
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="nq-table-wrap">
                    <table class="table nq-table">
                    <tbody>
                        @* NQ1: chi phí minh bạch — chưa chốt thì ghi "Liên hệ", không bịa số. *@
                        <tr><td>Phí nhượng quyền một lần</td><td class="text-right"><strong>Liên hệ</strong></td></tr>
                        <tr><td>Phí duy trì thương hiệu hàng tháng</td><td class="text-right"><strong>Liên hệ</strong></td></tr>
                        <tr><td>Chia sẻ doanh thu</td><td class="text-right"><strong>Liên hệ</strong></td></tr>
                        <tr><td>Setup quầy kệ, biển hiệu, thiết bị</td><td class="text-right"><strong>80 – 150 triệu</strong></td></tr>
                        <tr><td>Nguyên liệu & vốn lưu động ban đầu</td><td class="text-right"><strong>20 – 40 triệu</strong></td></tr>
                        <tr><td>Đào tạo & chuyển giao công thức</td><td class="text-right"><strong class="nq-free">Miễn phí</strong></td></tr>
                    </tbody>
                    </table>
                </div>
                <p class="text-muted small text-center">* Chi phí thực tế tùy diện tích mặt bằng và khu vực. Để lại thông tin để được tư vấn chi tiết.</p>
            </div>
        </div>
    </div>
</div>

<div class="xo-container nq-section">
    <h2 class="xo-sec-title">Quy trình 5 bước</h2>
    <div class="xo-sec-div"><span></span><em>Nhanh gọn trong 30 ngày</em><span></span></div>
    @* NQ2: quy trình hợp tác 5 bước dạng stepper. *@
    <div class="nq-steps">
        <div class="nq-step"><div class="nq-step-num">1</div><h5>Tìm hiểu</h5><p>Để lại thông tin, đội ngũ gửi tài liệu & gọi tư vấn trong 24h.</p></div>
        <div class="nq-step"><div class="nq-step-num">2</div><h5>Gặp gỡ</h5><p>Gặp trực tiếp, trao đổi mô hình và khảo sát mặt bằng dự kiến.</p></div>
        <div class="nq-step"><div class="nq-step-num">3</div><h5>Ký kết</h5><p>Thống nhất điều khoản, ký hợp đồng nhượng quyền.</p></div>
        <div class="nq-step"><div class="nq-step-num">4</div><h5>Setup & đào tạo</h5><p>Thi công quầy kệ, đào tạo đội ngũ 7–10 ngày tại quán chính.</p></div>
        <div class="nq-step"><div class="nq-step-num">5</div><h5>Khai trương</h5><p>Hỗ trợ truyền thông và vận hành tuần đầu tiên.</p></div>
    </div>
</div>

<div class="xo-container nq-section">
    @* NQ4: hỏi đáp nhượng quyền. *@
    <h2 class="xo-sec-title">Hỏi đáp nhượng quyền</h2>
    <div class="xo-sec-div"><span></span><em>Giải đáp trước khi quyết định</em><span></span></div>
    <div class="row justify-content-center">
        <div class="col-md-9">
            @foreach (var faq in _nqFaqs)
            {
                var open = _nqOpenIndex == faq.Key;
                <div class="card mb-2 nq-faq-card" @key="faq.Key">
                    <div class="card-header p-2">
                        <button class="btn btn-link btn-block text-left p-1 nq-faq-q" type="button"
                                @onclick="() => _nqOpenIndex = open ? -1 : faq.Key">
                            <strong>@(open ? "▾" : "▸") @faq.Value.Question</strong>
                        </button>
                    </div>
                    @if (open)
                    {
                        <div class="card-body nq-faq-a">@faq.Value.Answer</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="nq-section nq-cream" id="nq-form">
    <div class="xo-container">
        <h2 class="xo-sec-title">Đăng ký tư vấn nhượng quyền</h2>
        <div class="xo-sec-div"><span></span><em>Miễn phí, không ràng buộc</em><span></span></div>
        <div class="row justify-content-center">
            <div class="col-md-7">
                @if (_submitted)
                {
                    <div class="alert alert-success">
                        <h4>Cảm ơn bạn đã quan tâm!</h4>
                        <p class="mb-0">
                            Xôi Phú Thượng đã nhận được đăng ký của bạn và sẽ liên hệ qua số
                            <strong>@_model.CustomerPhone</strong> trong 24 giờ làm việc.
                        </p>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger">@_error</div>
                    }
                    <div class="card nq-form-card">
                        <div class="card-body">
                            <div class="form-group">
                                <label>Họ tên *</label>
                                <input class="form-control @FieldClass(_nameError)" @bind="_model.CustomerName" placeholder="Nguyễn Văn A" />
                                @if (!string.IsNullOrEmpty(_nameError)) { <small class="text-danger">@_nameError</small> }
                            </div>
                            <div class="form-group">
                                <label>Số điện thoại *</label>
                                <input class="form-control @FieldClass(_phoneError)" @bind="_model.CustomerPhone" placeholder="0901234567" />
                                @if (!string.IsNullOrEmpty(_phoneError)) { <small class="text-danger">@_phoneError</small> }
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Tỉnh / Thành phố dự kiến mở *</label>
                                    <input class="form-control @FieldClass(_provinceError)" @bind="_model.EventLocation" placeholder="VD: Hà Nội" />
                                    @if (!string.IsNullOrEmpty(_provinceError)) { <small class="text-danger">@_provinceError</small> }
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Vốn dự kiến *</label>
                                    <select class="form-control @FieldClass(_budgetError)" @bind="_model.Budget">
                                        <option value="">— Chọn mức vốn —</option>
                                        <option>Dưới 100 triệu</option>
                                        <option>100 – 200 triệu</option>
                                        <option>200 – 500 triệu</option>
                                        <option>Trên 500 triệu</option>
                                    </select>
                                    @if (!string.IsNullOrEmpty(_budgetError)) { <small class="text-danger">@_budgetError</small> }
                                </div>
                            </div>
                            @* NQ3: câu hỏi sàng lọc trước khi tư vấn. *@
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Tình trạng mặt bằng *</label>
                                    <select class="form-control @FieldClass(_premisesError)" @bind="_premises">
                                        <option value="">— Chọn tình trạng —</option>
                                        <option>Đã có mặt bằng</option>
                                        <option>Đang tìm mặt bằng</option>
                                        <option>Chưa có mặt bằng</option>
                                    </select>
                                    @if (!string.IsNullOrEmpty(_premisesError)) { <small class="text-danger">@_premisesError</small> }
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Kinh nghiệm F&B *</label>
                                    <select class="form-control @FieldClass(_experienceError)" @bind="_experience">
                                        <option value="">— Chọn mức kinh nghiệm —</option>
                                        <option>Đang kinh doanh ăn uống</option>
                                        <option>Đã từng kinh doanh ăn uống</option>
                                        <option>Chưa có kinh nghiệm</option>
                                    </select>
                                    @if (!string.IsNullOrEmpty(_experienceError)) { <small class="text-danger">@_experienceError</small> }
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Lời nhắn</label>
                                <textarea class="form-control" rows="3" @bind="_model.Notes"
                                          placeholder="VD: Tôi có mặt bằng 30m² ở mặt phố, muốn tìm hiểu thêm..."></textarea>
                            </div>
                            <button class="btn btn-block nq-submit" @onclick="SubmitAsync" disabled="@_submitting">
                                @(_submitting ? "Đang gửi..." : "Gửi đăng ký tư vấn")
                            </button>
                            <p class="text-muted small text-center mt-2 mb-0">Thông tin của bạn được bảo mật tuyệt đối.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private readonly QuoteRequestModel _model = new QuoteRequestModel { Quantity = 1, QuoteType = "NhuongQuyen" };
    private bool _submitting;
    private bool _submitted;
    private string _error;
    private string _nameError;
    private string _phoneError;
    private string _provinceError;
    private string _budgetError;
    private string _premisesError;
    private string _experienceError;

    // NQ3: câu hỏi sàng lọc (gộp vào Notes vì model không có field riêng).
    private string _premises;
    private string _experience;

    // NQ4: hỏi đáp nhượng quyền (không bịa số — chưa chốt thì ghi liên hệ).
    private int _nqOpenIndex = -1;
    private readonly Dictionary<int, (string Question, string Answer)> _nqFaqs = new()
    {
        [0] = ("Phí nhượng quyền bao gồm những gì?",
               "Bao gồm: quyền sử dụng thương hiệu Xôi Phú Thượng, toàn bộ công thức & định lượng, đào tạo đội ngũ 7–10 ngày tại quán chính, hỗ trợ thiết kế mặt bằng & biển hiệu, kế hoạch marketing khai trương. Mức phí cụ thể vui lòng liên hệ để được tư vấn chi tiết."),
        [1] = ("Tôi chưa có kinh nghiệm kinh doanh ăn uống, có làm được không?",
               "Được. Mô hình quán xôi tinh gọn, quy trình chuẩn hóa sẵn; bạn và nhân sự được đào tạo tận nơi 7–10 ngày kèm tài liệu vận hành chi tiết. Điều quan trọng là sự nghiêm túc và mặt bằng phù hợp."),
        [2] = ("Yêu cầu mặt bằng như thế nào?",
               "Phù hợp mặt bằng nhỏ, khu dân cư, trường học, văn phòng — nơi có lưu lượng người qua lại vào buổi sáng. Nếu chưa có mặt bằng, đội ngũ sẽ tư vấn tiêu chí chọn điểm khi gặp gỡ."),
        [3] = ("Bao lâu thì hoàn vốn?",
               "Tùy vị trí, quy mô và cách vận hành của từng điểm bán. Mô hình vốn đầu tư hợp lý nên thời gian hoàn vốn thường nhanh hơn mặt bằng chung ngành F&B — liên hệ để được tư vấn chi tiết theo khu vực của bạn."),
        [4] = ("Nguyên liệu có phải nhập từ hệ thống không?",
               "Hệ thống kết nối nhà cung cấp nếp, đậu, thịt giá gốc để đảm bảo chất lượng đồng đều. Chi tiết cơ chế cung ứng sẽ được thống nhất khi ký kết."),
        [5] = ("Tôi có được độc quyền khu vực không?",
               "Chính sách độc quyền khu vực được trao đổi cụ thể theo từng trường hợp — vui lòng liên hệ để biết chi tiết."),
        [6] = ("Sau khai trương có được hỗ trợ tiếp không?",
               "Có. Tuần đầu khai trương được hỗ trợ vận hành trực tiếp; sau đó đội ngũ đồng hành qua kênh tư vấn thường xuyên khi bạn cần.")
    };

    private async Task SubmitAsync()
    {
        _error = null;
        _nameError = string.IsNullOrWhiteSpace(_model.CustomerName) ? "Vui lòng nhập họ tên." : null;
        _phoneError = !IsValidPhone(_model.CustomerPhone) ? "Số điện thoại không đúng định dạng (VD: 0901234567)." : null;
        _provinceError = string.IsNullOrWhiteSpace(_model.EventLocation) ? "Vui lòng nhập tỉnh/thành phố dự kiến." : null;
        _budgetError = string.IsNullOrWhiteSpace(_model.Budget) ? "Vui lòng chọn mức vốn dự kiến." : null;
        _premisesError = string.IsNullOrWhiteSpace(_premises) ? "Vui lòng chọn tình trạng mặt bằng." : null;
        _experienceError = string.IsNullOrWhiteSpace(_experience) ? "Vui lòng chọn mức kinh nghiệm F&B." : null;

        if (_nameError != null || _phoneError != null || _provinceError != null
            || _budgetError != null || _premisesError != null || _experienceError != null)
        {
            _error = "Vui lòng kiểm tra lại các thông tin được đánh dấu.";
            return;
        }

        // NQ3: gộp câu trả lời sàng lọc vào ghi chú.
        var screen = $"[Sàng lọc] Mặt bằng: {_premises}; Kinh nghiệm F&B: {_experience}.";
        if (_model.Notes == null || !_model.Notes.Contains("[Sàng lọc]"))
        {
            _model.Notes = screen + "\n" + (_model.Notes ?? "");
        }

        _submitting = true;
        try
        {
            await ShopService.CreateQuoteAsync(_model);
            _submitted = true;
        }
        catch (Exception)
        {
            _error = "Gửi đăng ký thất bại. Vui lòng thử lại hoặc gọi trực tiếp cho shop.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string FieldClass(string error) => string.IsNullOrEmpty(error) ? null : "is-invalid";

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");
}
