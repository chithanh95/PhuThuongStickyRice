@* Lexa-style TouchSpin quantity selector *@

<div class="qty-spinner">
    <button type="button" class="qty-btn qty-minus" @onclick="Decrement" disabled="@(Value <= Min)" aria-label="Giảm số lượng">−</button>
    <input type="text" class="qty-input" value="@Value" readonly aria-label="Số lượng" />
    <button type="button" class="qty-btn qty-plus" @onclick="Increment" disabled="@(Value >= Max)" aria-label="Tăng số lượng">+</button>
</div>


@code {
    [Parameter] public int Value { get; set; } = 1;
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int Min { get; set; } = 1;
    [Parameter] public int Max { get; set; } = 99;

    private async Task Increment()
    {
        if (Value < Max)
        {
            Value++;
            await ValueChanged.InvokeAsync(Value);
        }
    }

    private async Task Decrement()
    {
        if (Value > Min)
        {
            Value--;
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
