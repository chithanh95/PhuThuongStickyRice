@using PhuThuongStickyRice.Web.Components.Shop.Models

@* Upsell popup shown right after a xôi is added to the cart.
   Non-blocking: closes via X, backdrop click, or "Không, cảm ơn". *@
@if (Visible && Products != null && Products.Count > 0)
{
    @* A11y-20261020: @onkeydown để đóng popup bằng phím Escape —
       người dùng bàn phím cần cách thoát chuẩn (đồng bộ pattern
       ConfirmDialog.razor). Keydown từ nút đang focus sẽ bubble lên div. *@
    <div class="modal fade show d-block upsell-popup" tabindex="-1" role="dialog" aria-modal="true" @ref="_modalRef" @onclick="Close" @onkeydown="HandleKeyDown">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">😋 Ăn kèm ngon hơn với:</h6>
                    <button type="button" class="close" aria-label="Đóng" @onclick="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-2">
                    @if (!string.IsNullOrWhiteSpace(AddedProductName))
                    {
                        <small class="text-muted d-block mb-2 px-1">Bạn vừa thêm <strong>@AddedProductName</strong> — thêm món ăn kèm:</small>
                    }
                    @foreach (var p in Products)
                    {
                        <div class="d-flex align-items-center justify-content-between border rounded p-2 mb-2" @key="p.Id">
                            <div class="mr-2">
                                <div><strong>@p.Name</strong></div>
                                @* bug-hunt 2026-10-19: hiện giá KM (giá thực trả khi bấm + Thêm) thay vì giá gốc. *@
                                <small class="text-danger">@ShopProductModel.EffectivePrice(p, p.Price).ToString("N0") ₫</small>
                            </div>
                            <button class="btn btn-sm btn-warning" @onclick="() => Add(p)" disabled="@_adding"
                                    aria-label="Thêm @p.Name vào giỏ hàng">
                                + Thêm
                            </button>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-link text-muted" @onclick="Close">Không, cảm ơn</button>
                    <a href="/cart" class="btn btn-sm btn-primary">Xem giỏ hàng</a>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool Visible { get; set; }

    [Parameter] public List<ShopProductModel> Products { get; set; } = new List<ShopProductModel>();

    [Parameter] public string AddedProductName { get; set; }

    [Parameter] public EventCallback<ShopProductModel> OnAdd { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool _adding;

    // A11y: đưa focus vào popup khi mở — screen reader đọc ngay role="dialog" +
    // tiêu đề, người dùng bàn phím tab từ trong popup đi ra thay vì kẹt ở nút
    // phía sau (đồng bộ pattern modal tiền cọc ở Quotes.razor).
    private ElementReference _modalRef;
    private bool _wasVisible;
    private bool _focusOnOpen;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible) _focusOnOpen = true;
        _wasVisible = Visible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOnOpen && Visible)
        {
            _focusOnOpen = false;
            await _modalRef.FocusAsync();
        }
    }

    private async Task Add(ShopProductModel product)
    {
        if (_adding) return;
        _adding = true;
        try
        {
            await OnAdd.InvokeAsync(product);
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    /// <summary>
    /// Đóng popup khi bấm Escape — cùng pattern ConfirmDialog.cs
    /// (người dùng bàn phím thoát chuẩn, không phải tab tới nút Đóng).
    /// </summary>
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e?.Key == "Escape")
        {
            _ = Close();
        }
    }
}
