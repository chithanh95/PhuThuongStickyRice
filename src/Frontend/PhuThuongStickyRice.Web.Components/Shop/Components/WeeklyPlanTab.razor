@* Tab "Gói ăn sáng tuần" — UX đơn giản cho người lớn tuổi:
   chữ to, nút lớn (tối thiểu 48px), mỗi bước 1 việc, thông báo bằng chữ rõ ràng. *@
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject WeeklyPlanService WeeklyPlanService

<div class="wpt">
    @if (_loading)
    {
        <p class="wpt-big"><em>Đang tải...</em></p>
    }
    else if (_plan == null)
    {
        @* Load lỗi (mạng/API sập) cũng rơi vào nhánh này vì _plan vẫn null:
           hiện đúng lỗi thay vì báo nhầm "chưa có gói ăn sáng". *@
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="wpt-error">@_error</p>
        }
        else
        {
            <p class="wpt-big">Tuần này chưa có gói ăn sáng.<br />Quay lại sau nhé.</p>
        }
    }
    else if (_bought != null)
    {
        <div class="wpt-success">
            <p class="wpt-title">Mua gói thành công!</p>
            <p class="wpt-big">Mã đơn của bạn là:</p>
            <p class="wpt-code">@_bought.OrderCode</p>
            <p class="wpt-big"><strong>Mỗi sáng đưa mã này cho quán để nhận món.</strong></p>
            <button type="button" class="wpt-btn wpt-btn-outline" @onclick="GoToMyOrders">
                Xem gói của tôi
            </button>
        </div>
    }
    else
    {
        <h3 class="wpt-title">Gói ăn sáng tuần này</h3>
        <p class="wpt-big">Từ thứ 2 ngày @_plan.WeekStart.ToString("dd/MM/yyyy")</p>

        @foreach (var d in _plan.Days)
        {
            <div class="wpt-day">
                <span class="wpt-dayname">@DayLabel(d.DayOfWeek):</span>
                <span>@d.ProductName</span>
                <span class="wpt-price">@d.Price.ToString("N0")đ</span>
            </div>
        }

        <p class="wpt-big">Mua lẻ từng món: <s>@OriginalTotal.ToString("N0")đ</s></p>
        <p class="wpt-total">Giá gói (giảm 10%): <strong>@_plan.Price.ToString("N0")đ</strong></p>

        <div class="wpt-form">
            <label class="wpt-label" for="wpt-name">Tên của bạn</label>
            <input id="wpt-name" class="wpt-input" @bind="_name" maxlength="100"
                   placeholder="Ví dụ: Nguyễn Văn A" autocomplete="name" />

            <label class="wpt-label" for="wpt-phone">Số điện thoại</label>
            <input id="wpt-phone" class="wpt-input" @bind="_phone" maxlength="10"
                   inputmode="numeric" placeholder="Ví dụ: 0912345678" autocomplete="tel" />

            <button type="button" class="wpt-btn wpt-btn-primary" @onclick="BuyAsync" disabled="@_buying">
                @(_buying ? "Đang mua..." : "Mua ngay")
            </button>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="wpt-error">@_error</p>
            }
        </div>
    }

    <hr class="wpt-hr" />

    <div id="wpt-my-orders">
        <h3 class="wpt-title">Gói của tôi</h3>
        <p class="wpt-big">Nhập số điện thoại đã mua gói:</p>
        <input class="wpt-input" @bind="_lookupPhone" maxlength="10" inputmode="numeric"
               placeholder="Ví dụ: 0912345678" autocomplete="tel" aria-label="Số điện thoại đã dùng mua gói tuần" />
        <div>
            <button type="button" class="wpt-btn wpt-btn-outline" @onclick="LookupAsync" disabled="@_lookingUp">
                @(_lookingUp ? "Đang xem..." : "Xem gói của tôi")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_lookupError))
        {
            <p class="wpt-error">@_lookupError</p>
        }

        @if (_orders != null)
        {
            if (!_orders.Any())
            {
                <p class="wpt-big">Không tìm thấy gói nào với số điện thoại này.</p>
            }
            else
            {
                @foreach (var o in _orders)
                {
                    <div class="wpt-order">
                        <p class="wpt-order-code">Mã đơn: <strong>@o.OrderCode</strong></p>
                        <p class="wpt-big">Đã mua: @o.PaidAmount.ToString("N0")đ — <strong>@StatusText(o.Status)</strong></p>
                        @foreach (var d in PlanDays)
                        {
                            var claimed = o.ClaimedDays != null
                                && o.ClaimedDays.TryGetValue(d.DayOfWeek, out var v) && v;
                            <div class="wpt-day">
                                <span class="wpt-dayname">@DayLabel(d.DayOfWeek):</span>
                                <span>@d.ProductName</span>
                                @if (claimed)
                                {
                                    <span class="wpt-claimed">Đã nhận</span>
                                }
                                else if (o.Status == "Paid")
                                {
                                    <button type="button" class="wpt-btn wpt-btn-claim"
                                            @onclick="() => ClaimAsync(o, d.DayOfWeek)"
                                            disabled="@_claiming.Contains(o.Id)">
                                        Đã nhận món hôm nay
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    private WeeklyPlanModel _plan;
    private WeeklyPlanOrderModel _bought;
    private List<WeeklyPlanOrderModel> _orders;
    private bool _loading = true;
    private bool _buying;
    private bool _lookingUp;
    private string _name;
    private string _phone;
    private string _lookupPhone;
    private string _error;
    private string _lookupError;
    private readonly HashSet<Guid> _claiming = new();

    private decimal OriginalTotal => _plan?.Days?.Sum(d => d.Price) ?? 0;

    private List<WeeklyPlanDayModel> PlanDays => _plan?.Days ?? new List<WeeklyPlanDayModel>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _plan = await WeeklyPlanService.GetActiveAsync();
        }
        catch (Exception ex)
        {
            _error = "Không tải được gói ăn sáng: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BuyAsync()
    {
        // Chặn double-tap (2 event dispatch trước khi Blazor re-render kịp disable nút)
        // — mỗi lần bấm chỉ tạo đúng 1 đơn, tránh ghi 2 lần tiền thanh toán.
        if (_buying) return;
        _error = null;
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Vui lòng nhập tên của bạn.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_phone))
        {
            _error = "Vui lòng nhập số điện thoại.";
            return;
        }

        _buying = true;
        try
        {
            _bought = await WeeklyPlanService.BuyAsync(_plan.Id, _name.Trim(), _phone.Trim());
            // Mở sẵn "Gói của tôi" cho số điện thoại vừa mua.
            _lookupPhone = _phone.Trim();
            _orders = await WeeklyPlanService.GetMyOrdersAsync(_lookupPhone);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _buying = false;
        }
    }

    private void GoToMyOrders()
    {
        _bought = null;
    }

    private async Task LookupAsync()
    {
        _lookupError = null;
        if (string.IsNullOrWhiteSpace(_lookupPhone))
        {
            _lookupError = "Vui lòng nhập số điện thoại.";
            return;
        }

        _lookingUp = true;
        try
        {
            _orders = await WeeklyPlanService.GetMyOrdersAsync(_lookupPhone.Trim());
        }
        catch (Exception ex)
        {
            _lookupError = ex.Message;
        }
        finally
        {
            _lookingUp = false;
        }
    }

    private async Task ClaimAsync(WeeklyPlanOrderModel order, string day)
    {
        if (!_claiming.Add(order.Id))
        {
            return;
        }

        _lookupError = null;
        try
        {
            var updated = await WeeklyPlanService.ClaimAsync(order.Id, day, _lookupPhone);
            var idx = _orders.FindIndex(o => o.Id == order.Id);
            if (idx >= 0)
            {
                _orders[idx] = updated;
            }
        }
        catch (Exception ex)
        {
            _lookupError = ex.Message;
        }
        finally
        {
            _claiming.Remove(order.Id);
        }
    }

    private static string DayLabel(string day) => day switch
    {
        "Mon" => "Thứ 2",
        "Tue" => "Thứ 3",
        "Wed" => "Thứ 4",
        "Thu" => "Thứ 5",
        "Fri" => "Thứ 6",
        _ => day,
    };

    private static string StatusText(string status) => status switch
    {
        "Completed" => "Đã nhận đủ 5 ngày",
        "Cancelled" => "Đã hủy",
        _ => "Đang dùng",
    };
}
