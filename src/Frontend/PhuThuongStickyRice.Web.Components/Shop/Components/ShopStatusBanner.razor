@* #199: Banner "Quán đang mở / nghỉ" — gọn 1 dòng ở đầu trang /shop. *@
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Shop.Models
@inject ShopSettingsService ShopSettingsService

@if (_loaded)
{
    <div class="shop-status-banner @(_isOpen ? "open" : "closed")" role="status">
        @if (_isOpen)
        {
            <span class="dot"></span>
            <span>Quán đang mở — hôm nay bán đến @_closeTime</span>
        }
        else if (_isPaused)
        {
            <span class="dot"></span>
            <span>⏸ @_pausedText</span>
        }
        else
        {
            <span class="dot"></span>
            <span>Quán đang nghỉ — mở lại lúc @_openTime@(_isTomorrow ? " sáng mai" : "")</span>
        }
    </div>
}

@code {
    private bool _loaded;
    private bool _isOpen;
    private bool _isTomorrow;
    /// <summary>bug-hunt 2026-10-20: true khi admin tạm ngưng nhận đơn (AcceptingOrders = false) hoặc nghỉ lễ hôm nay.</summary>
    private bool _isPaused;
    /// <summary>bug-hunt 2026-10-20: text banner khi _isPaused — dùng lý do admin nhập thay vì "mở lại lúc ..." theo giờ.</summary>
    private string _pausedText = "Quán tạm ngưng nhận đơn";
    private string _openTime = "06:00";
    private string _closeTime = "10:30";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await ShopSettingsService.GetPublicAsync();
            if (settings != null)
            {
                if (!string.IsNullOrWhiteSpace(settings?.OpenTime)) _openTime = settings.OpenTime;
                if (!string.IsNullOrWhiteSpace(settings?.CloseTime)) _closeTime = settings.CloseTime;
                // bug-hunt 2026-10-20: admin pause quán thì banner phải báo nghỉ. Trước đây chỉ tính giờ
                // wall-clock nên banner vẫn xanh "Quán đang mở" chồng lên alert vàng "tạm ngưng nhận đơn"
                // của Shop.razor — mâu thuẫn khi khách nhìn trang /shop.
                if (!settings.AcceptingOrders || settings.IsHolidayPaused)
                {
                    _isPaused = true;
                    var reason = (settings.PausedReason ?? "").Trim();
                    _pausedText = string.IsNullOrEmpty(reason)
                        ? "Quán tạm ngưng nhận đơn"
                        : "Quán tạm ngưng nhận đơn: " + reason;
                }
            }
        }
        catch { }

        UpdateStatus();
        _loaded = true;
    }

    private void UpdateStatus()
    {
        // Giờ VN (UTC+7) — dùng helper chung để khỏi hardcode múi giờ ở nhiều nơi.
        if (_isPaused)
        {
            // bug-hunt 2026-10-20: admin đã tạm ngưng nhận đơn — không tính giờ mở/đóng nữa.
            _isOpen = false;
            return;
        }
        var now = ShopHours.NowInVietnam();
        if (TimeSpan.TryParse(_openTime, out var open) && TimeSpan.TryParse(_closeTime, out var close))
        {
            if (open <= close)
            {
                _isOpen = now >= open && now < close;
                _isTomorrow = now >= close;
            }
            else
            {
                // Ca qua đêm (vd 18:00–06:00).
                _isOpen = now >= open || now < close;
                _isTomorrow = now >= close && now < open;
            }
        }
        else
        {
            _isOpen = true;
        }
    }
}
