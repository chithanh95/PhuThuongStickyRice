@page "/dashboard"
@attribute [Authorize(Roles = "Admin,Cashier")]
@implements IDisposable
@using System.Threading
@using Microsoft.JSInterop
@using PhuThuongStickyRice.Web.Components.Dashboard.Services
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject DashboardService DashboardService
@inject Wave5Service Wave5Service
@inject IJSRuntime JSRuntime

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <h3 class="mb-2 mb-md-0">Dashboard</h3>
    <div class="d-flex align-items-center flex-wrap">
        @if (_stats != null)
        {
            <small class="text-muted mr-3 mb-1 mb-md-0">Cập nhật: @_lastUpdated.ToString("HH:mm:ss")</small>
        }
        <button class="btn btn-sm btn-outline-secondary mr-2 mb-1 mb-md-0" @onclick="RefreshNow" disabled="@_refreshing">⟳ Làm mới</button>
        <div class="form-check form-check-inline mb-1 mb-md-0">
            <input class="form-check-input" type="checkbox" id="autoRefreshToggle" @bind="_autoRefresh" />
            <label class="form-check-label" for="autoRefreshToggle">Tự động (30s)</label>
        </div>
    </div>
</div>

@if (_newOrderCount > 0)
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">🔔</span>
        <div>
            <strong>Có @_newOrderCount đơn hàng mới!</strong>
            <a href="/orders?status=Pending" class="alert-link ml-2">Xem ngay →</a>
        </div>
        <button type="button" class="close ml-auto" aria-label="Đóng" @onclick="DismissNewOrderAlert">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (_stats != null && !_staleDismissed && _stats.StalePendingOrders > 0)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">🚨</span>
        <div>
            <strong>KHẨN: @_stats.StalePendingOrders đơn chờ xác nhận quá @_stats.StalePendingMinutes phút!</strong>
            <a href="/orders?status=Pending" class="alert-link ml-2">Xử lý ngay →</a>
        </div>
        <button type="button" class="close ml-auto" aria-label="Đóng" @onclick="DismissStaleAlert">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(_newIpWarning))
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">⚠️</span>
        <div>
            <strong>Đăng nhập mới từ IP lạ:</strong> @_newIpWarning.
            Nếu không phải bạn, hãy đổi mật khẩu ngay.
        </div>
        <button type="button" class="close ml-auto" aria-label="Đóng" @onclick="DismissIpWarning">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@* Wave 5 widgets: daily target, source stats, corporate due, forecast. *@
<div class="row mb-3">
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">🎯 Mục tiêu hôm nay</h6>
                @if (_dailyTarget == null)
                {
                    <small class="text-muted">Đang tải...</small>
                }
                else
                {
                    var pct = Math.Min(100, _dailyTarget.Percent);
                    <div class="d-flex justify-content-between mb-1">
                        <small>@_dailyTarget.TodayRevenue.ToString("N0") ₫ / @_dailyTarget.Target.ToString("N0") ₫</small>
                        <small><strong>@_dailyTarget.Percent.ToString("0")%</strong></small>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar @(pct >= 100 ? "bg-success" : "bg-primary")" role="progressbar"
                             style="width: @pct.ToString("0")%" aria-valuenow="@pct.ToString("0")" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">📍 Đơn theo nguồn</h6>
                @if (_sourceStats == null)
                {
                    <small class="text-muted">Đang tải...</small>
                }
                else if (_sourceStats.Count == 0)
                {
                    <small class="text-muted">Chưa có đơn trong kỳ.</small>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                @foreach (var s in _sourceStats)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrEmpty(s.Source) ? "Web" : s.Source)</td>
                                        <td class="text-right">@s.OrderCount đơn</td>
                                        <td class="text-right">@s.Revenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Wave 6d (item 36): today vs yesterday comparison card. *@
<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">📊 Hôm nay vs hôm qua</h6>
                @if (_todayVsYesterday == null)
                {
                    <small class="text-muted">Đang tải...</small>
                }
                else
                {
                    <div class="row text-center">
                        <div class="col-6 col-md-3 mb-2">
                            <div class="h5 mb-0">@FormatPrice(_todayVsYesterday.TodayRevenue)</div>
                            <small class="text-muted">Doanh thu hôm nay<br />Hôm qua: @FormatPrice(_todayVsYesterday.YesterdayRevenue)</small>
                            <div class="mt-1">@DeltaBadge(_todayVsYesterday.RevenueDeltaPercent)</div>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <div class="h5 mb-0">@_todayVsYesterday.TodayOrders đơn</div>
                            <small class="text-muted">Đơn hàng hôm nay<br />Hôm qua: @_todayVsYesterday.YesterdayOrders đơn</small>
                            <div class="mt-1">@DeltaBadge(_todayVsYesterday.OrdersDeltaPercent)</div>
                        </div>
                        <div class="col-12 col-md-6 mb-2 d-flex align-items-center">
                            <small class="text-muted">
                                Đơn đã hủy không được tính. Ngày theo giờ Việt Nam (UTC+7).
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mb-3">
    @if (_corporateDue != null && _corporateDue.Count > 0)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <h6 class="card-title">🏢 Đơn doanh nghiệp tuần này <span class="badge badge-info">@_corporateDue.Count</span></h6>
                    <ul class="list-unstyled mb-2">
                        @foreach (var c in _corporateDue.Take(5))
                        {
                            <li class="mb-1">
                                <strong>@c.CompanyName</strong> <small class="text-muted">(@c.Phone)</small><br />
                                <small>@c.ItemsJson</small>
                            </li>
                        }
                    </ul>
                    <a href="admin/doanh-nghiep" class="btn btn-sm btn-outline-info">Quản lý →</a>
                </div>
            </div>
        </div>
    }
    @if (_forecast != null)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h6 class="card-title">🌾 Dự báo nếp sáng mai</h6>
                    <div class="h4 mb-1 text-success">@_forecast.NepKg.ToString("0.#") kg</div>
                    <small class="text-muted">@_forecast.Heuristic</small><br />
                    <a href="admin/du-bao-nguyen-lieu" class="btn btn-sm btn-outline-success mt-2">Chi tiết →</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="col-6 col-md-3">
                <label for="dash-from"><small class="text-muted">Từ ngày</small></label>
                <input id="dash-from" type="date" class="form-control" @bind="_from" />
            </div>
            <div class="col-6 col-md-3">
                <label for="dash-to"><small class="text-muted">Đến ngày</small></label>
                <input id="dash-to" type="date" class="form-control" @bind="_to" />
            </div>
            <div class="col-12 col-md-3 mt-2 mt-md-0">
                <button class="btn btn-primary mr-2" @onclick="ApplyDateRange" disabled="@_refreshing">Áp dụng</button>
                <button class="btn btn-outline-secondary" @onclick="ResetDateRange" disabled="@_refreshing">7 ngày qua</button>
            </div>
        </div>
    </div>
</div>

@if (_stats == null)
{
    <p><em>Đang tải thống kê...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="lx-mini-stat">
                <p class="lx-mini-label">Tổng đơn hàng</p>
                <h2 class="lx-mini-value">@_stats.TotalOrders</h2>
                <span class="lx-mini-foot">Chờ xác nhận: @_stats.PendingOrders</span>
                <span class="lx-mini-icon"><span class="oi oi-cart" aria-hidden="true"></span></span>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="lx-mini-stat">
                <p class="lx-mini-label">Doanh thu</p>
                <h2 class="lx-mini-value">@FormatPrice(_stats.TotalRevenue)</h2>
                <span class="lx-mini-foot">Không tính đơn đã hủy</span>
                <span class="lx-mini-icon"><span class="oi oi-dollar" aria-hidden="true"></span></span>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="lx-mini-stat">
                <p class="lx-mini-label">Món xôi đã bán</p>
                <h2 class="lx-mini-value">@_stats.TotalProductsSold</h2>
                <span class="lx-mini-foot">@_stats.TotalProducts món đang kinh doanh</span>
                <span class="lx-mini-icon"><span class="oi oi-tag" aria-hidden="true"></span></span>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="lx-mini-stat">
                <p class="lx-mini-label">Đơn chờ xử lý</p>
                <h2 class="lx-mini-value">@_stats.PendingOrders</h2>
                <span class="lx-mini-foot"><a href="/orders?status=Pending" class="text-white"><u>Xem ngay</u></a></span>
                <span class="lx-mini-icon"><span class="oi oi-clock" aria-hidden="true"></span></span>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Đơn hàng theo trạng thái</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tbody>
                            @foreach (var item in _stats.OrdersByStatus)
                            {
                                <tr>
                                    <td>@StatusBadge(item.Status)</td>
                                    <td class="text-right"><strong>@item.Count</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Doanh thu theo ngày</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Ngày</th><th class="text-right">Đơn</th><th class="text-right">Doanh thu</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var day in _stats.RevenueByDay)
                            {
                                <tr>
                                    <td>@day.Date.ToString("dd/MM")</td>
                                    <td class="text-right">@day.Orders</td>
                                    <td class="text-right">@FormatPrice(day.Revenue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Món bán chạy nhất</div>
                <div class="card-body">
                    @if (_topProducts == null)
                    {
                        <p class="text-muted mb-0"><em>Đang tải...</em></p>
                    }
                    else if (_topProducts.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu trong khoảng thời gian này.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr><th>#</th><th>Món</th><th class="text-right">Đã bán</th><th class="text-right">Doanh thu</th></tr>
                            </thead>
                            <tbody>
                                @{
                                    var rank = 0;
                                }
                                @foreach (var p in _topProducts)
                                {
                                    rank++;
                                    <tr>
                                        <td><strong>@rank</strong></td>
                                        <td>@p.ProductName</td>
                                        <td class="text-right">@p.QuantitySold</td>
                                        <td class="text-right">@FormatPrice(p.Revenue)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Khách mới / khách quay lại</div>
                <div class="card-body">
                    @if (_newReturning == null)
                    {
                        <p class="text-muted mb-0"><em>Đang tải...</em></p>
                    }
                    else
                    {
                        <div class="row text-center">
                            <div class="col-6">
                                <h3 class="text-success mb-0">@_newReturning.NewCustomers</h3>
                                <small class="text-muted">Khách mới<br />@_newReturning.NewCustomerOrders đơn</small>
                            </div>
                            <div class="col-6">
                                <h3 class="text-info mb-0">@_newReturning.ReturningCustomers</h3>
                                <small class="text-muted">Khách quay lại<br />@_newReturning.ReturningCustomerOrders đơn</small>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">Khách mới = lần đầu đặt trong khoảng thời gian đã chọn.</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            Đơn hàng mới nhất
            <a href="/orders" class="btn btn-sm btn-outline-primary float-right">Xem tất cả</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>SĐT</th>
                            <th class="text-right">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _stats.RecentOrders)
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td>@order.CustomerName</td>
                                <td>@order.CustomerPhone</td>
                                <td class="text-right">@FormatPrice(order.TotalAmount)</td>
                                <td>@StatusBadge(order.Status)</td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private DashboardStatsModel _stats;

    // Wave 5 widgets (items 122/124/133/139).
    private DailyTargetModel _dailyTarget;
    private List<SourceStatModel> _sourceStats;
    private List<CorporateClientModel> _corporateDue;
    private IngredientForecastModel _forecast;
    private List<TopProductModel> _topProducts;
    private NewReturningCustomersModel _newReturning;

    // Wave 6d (item 36): today-vs-yesterday comparison card.
    private TodayVsYesterdayModel _todayVsYesterday;
    private bool _autoRefresh = true;
    private bool _refreshing;
    private DateTime _lastUpdated = DateTime.Now;
    private CancellationTokenSource _cts;

    private DateTime _from = DateTime.Today.AddDays(-6);
    private DateTime _to = DateTime.Today;

    // New-order alert state.
    private long _baselineOrderCount = -1;
    private int _newOrderCount;

    // Item 86: urgent stale-pending alert state.
    private long _lastStaleCount;
    private bool _staleDismissed;

    // Item 99: new-IP login warning (set by the login page in localStorage).
    private string _newIpWarning;
    private const string IpWarningKey = "phuthuong.last-login-ip-warning";

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();

        try
        {
            _newIpWarning = await JSRuntime.InvokeAsync<string>("localStorage.getItem", IpWarningKey);
        }
        catch (Exception)
        {
        }

        _cts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            var stats = await DashboardService.GetStatsAsync(_from, _to);
            var top = await DashboardService.GetTopProductsAsync(_from, _to);
            NewReturningCustomersModel newReturning = null;
            try
            {
                newReturning = await DashboardService.GetNewReturningCustomersAsync(_from, _to);
            }
            catch (Exception)
            {
                // Non-critical section.
            }

            DetectNewOrders(stats);
            DetectStaleOrders(stats);
            _stats = stats;
            _topProducts = top;
            _newReturning = newReturning;
            _lastUpdated = DateTime.Now;

            // Wave 5 widgets: daily target, source stats, corporate due, forecast.
            await LoadWave5WidgetsAsync();

            // Wave 6d (item 36): today-vs-yesterday card (fail-soft).
            try
            {
                _todayVsYesterday = await DashboardService.GetTodayVsYesterdayAsync();
            }
            catch (Exception)
            {
                _todayVsYesterday = null;
            }
        }
        catch (Exception)
        {
            _stats ??= new DashboardStatsModel();
        }
    }

    private async Task LoadWave5WidgetsAsync()
    {
        try
        {
            _dailyTarget = await Wave5Service.GetDailyTargetAsync();
        }
        catch (Exception)
        {
        }

        try
        {
            _sourceStats = await Wave5Service.GetSourceStatsAsync(_from, _to);
        }
        catch (Exception)
        {
        }

        // Admin-only widgets (server enforces roles; cashier simply sees nothing).
        try
        {
            _corporateDue = await Wave5Service.GetCorporateDueAsync();
        }
        catch (Exception)
        {
            _corporateDue = null;
        }

        try
        {
            _forecast = await Wave5Service.GetForecastAsync();
        }
        catch (Exception)
        {
            _forecast = null;
        }
    }

    private void DetectNewOrders(DashboardStatsModel stats)
    {
        if (_baselineOrderCount < 0)
        {
            // First load: establish the baseline, no alert.
            _baselineOrderCount = stats.TotalOrders;
            return;
        }

        var delta = stats.TotalOrders - _baselineOrderCount;
        if (delta > 0)
        {
            _newOrderCount += (int)delta;
            _baselineOrderCount = stats.TotalOrders;
            _ = PlayBeepAsync();
        }
    }

    private async Task PlayBeepAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("interop.playBeep");
        }
        catch (Exception)
        {
            // Audio is best-effort.
        }
    }

    private void DismissNewOrderAlert()
    {
        _newOrderCount = 0;
    }

    /// <summary>
    /// Item 86: distinct urgent sound + banner when stale pending orders
    /// appear or grow.
    /// </summary>
    private void DetectStaleOrders(DashboardStatsModel stats)
    {
        if (_staleDismissed)
        {
            _lastStaleCount = stats.StalePendingOrders;
            return;
        }

        if (stats.StalePendingOrders > 0 && stats.StalePendingOrders != _lastStaleCount)
        {
            _ = PlayUrgentAsync();
        }

        _lastStaleCount = stats.StalePendingOrders;
    }

    private void DismissStaleAlert()
    {
        _staleDismissed = true;
    }

    private async Task PlayUrgentAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("interop.playUrgent");
        }
        catch (Exception)
        {
            // Audio is best-effort.
        }
    }

    private async Task DismissIpWarning()
    {
        _newIpWarning = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", IpWarningKey);
        }
        catch (Exception)
        {
        }
    }

    private async Task ApplyDateRange()
    {
        if (_from > _to)
        {
            (_from, _to) = (_to, _from);
        }

        // Re-baseline so the range change itself doesn't trigger the alert.
        _baselineOrderCount = -1;
        _newOrderCount = 0;
        _staleDismissed = false;
        _lastStaleCount = 0;
        await RefreshNow();
    }

    private async Task ResetDateRange()
    {
        _from = DateTime.Today.AddDays(-6);
        _to = DateTime.Today;
        _baselineOrderCount = -1;
        _newOrderCount = 0;
        _staleDismissed = false;
        _lastStaleCount = 0;
        await RefreshNow();
    }

    private async Task RefreshNow()
    {
        _refreshing = true;
        try
        {
            await LoadStatsAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), token);
                if (_autoRefresh && !token.IsCancellationRequested)
                {
                    await LoadStatsAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    /// <summary>
    /// Wave 6d (item 36): signed delta badge, green ▲ when up, red ▼ when down.
    /// </summary>
    private static RenderFragment DeltaBadge(double delta) => builder =>
    {
        var up = delta >= 0;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", up ? "badge badge-success" : "badge badge-danger");
        builder.AddContent(2, $"{(up ? "▲" : "▼")} {Math.Abs(delta):0.#}%");
        builder.CloseElement();
    };

    private static RenderFragment StatusBadge(string status) => builder =>
    {
        var css = status switch
        {
            "Pending" => "badge badge-warning",
            "Confirmed" => "badge badge-info",
            "Preparing" => "badge badge-primary",
            "Delivering" => "badge badge-secondary",
            "Completed" => "badge badge-success",
            "Cancelled" => "badge badge-danger",
            _ => "badge badge-light"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, status);
        builder.CloseElement();
    };
}
