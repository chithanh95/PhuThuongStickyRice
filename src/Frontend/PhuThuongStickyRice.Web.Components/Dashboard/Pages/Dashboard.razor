@page "/dashboard"
@attribute [Authorize(Roles = "Admin,Cashier")]
@implements IDisposable
@using System.Threading
@using static PhuThuongStickyRice.Web.Components.Core.Helpers.PriceFormatter;
@using Microsoft.JSInterop
@using PhuThuongStickyRice.Web.Components.Dashboard.Models
@using PhuThuongStickyRice.Web.Components.Dashboard.Services
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject DashboardService DashboardService
@inject AdminCommerceService AdminCommerceService
@inject PhuThuongStickyRice.Web.Components.Shop.Services.ShopService ShopService
@inject IJSRuntime JSRuntime
<div class="lx-page-head">
    <div>
        <h4 class="lx-page-title">Dashboard</h4>
        <ol class="lx-breadcrumb">
            <li><a href="/dashboard">Xôi Phú Thượng</a></li>
            <li><a href="/dashboard">Tổng quan</a></li>
            <li class="current">Dashboard</li>
        </ol>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center flex-wrap">
        @if (_stats != null)
        {
            <small class="text-muted mr-3 mb-1 mb-md-0">Cập nhật: @_lastUpdated.ToString("HH:mm:ss")</small>
        }
        <button class="btn btn-sm btn-outline-secondary mr-2 mb-1 mb-md-0" @onclick="RefreshNow" disabled="@_refreshing">⟳ Làm mới</button>
        @if (_stats != null)
        {
            @if (_speaking)
            {
                <button class="btn btn-sm btn-outline-danger mr-2 mb-1 mb-md-0" @onclick="StopSpeaking">⏹ Dừng đọc</button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-primary mr-2 mb-1 mb-md-0" @onclick="SpeakReport" title="Đọc báo cáo doanh thu">🔊 Đọc báo cáo</button>
            }
        }
        <div class="form-check form-check-inline mb-1 mb-md-0">
            <input class="form-check-input" type="checkbox" id="autoRefreshToggle" @bind="_autoRefresh" />
            <label class="form-check-label" for="autoRefreshToggle">Tự động (30s)</label>
        </div>
    </div>
</div>

@if (_newOrderCount > 0)
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">🔔</span>
        <div>
            <strong>Có @_newOrderCount đơn hàng mới!</strong>
            <a href="/orders?status=Pending" class="alert-link ml-2">Xem ngay →</a>
        </div>
        <button type="button" class="close ml-auto" aria-label="Đóng" @onclick="DismissNewOrderAlert">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (_stats != null && !_staleDismissed && _stats.StalePendingOrders > 0)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">🚨</span>
        <div>
            <strong>KHẨN: @_stats.StalePendingOrders đơn chờ xác nhận quá @_stats.StalePendingMinutes phút!</strong>
            <a href="/orders?status=Pending" class="alert-link ml-2">Xử lý ngay →</a>
        </div>
        <button type="button" class="close ml-auto" aria-label="Đóng" @onclick="DismissStaleAlert">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@* Item 135: cảnh báo món hết suất hôm nay. *@
@if (_soldOutToday != null && _soldOutToday.Count > 0)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">⚠️</span>
        <div>
            <strong>Hết suất hôm nay (@_soldOutToday.Count món):</strong>
            @string.Join(", ", _soldOutToday)
            <a href="/products" class="alert-link ml-2">Kiểm tra tồn kho →</a>
        </div>
    </div>
}

@if (_stats != null && _stats.UpcomingPreOrders != null && _stats.UpcomingPreOrders.Count > 0)
{
    <div class="alert alert-info d-flex align-items-start" role="alert">
        <span class="mr-2" aria-hidden="true">📅</span>
        <div class="flex-grow-1">
            <strong>Đơn đặt trước sắp đến giờ (@_stats.UpcomingPreOrders.Count):</strong>
            <div class="table-responsive mt-2">
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var o in _stats.UpcomingPreOrders)
                        {
                            <tr>
                                <td><strong>@o.OrderNumber</strong></td>
                                <td>@o.CustomerName<br /><small class="text-muted">@o.CustomerPhone</small></td>
                                <td><span class="badge badge-primary">📅 @o.ScheduledFor?.ToLocalTime().ToString("dd/MM HH:mm")</span></td>
                                <td class="text-right">@FormatPrice(o.TotalAmount)</td>
                                <td><a href="/orders?search=@Uri.EscapeDataString(o.OrderNumber)" class="btn btn-sm btn-outline-primary">Xem</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_newIpWarning))
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">⚠️</span>
        <div>
            <strong>Đăng nhập mới từ IP lạ:</strong> @_newIpWarning.
            Nếu không phải bạn, hãy đổi mật khẩu ngay.
        </div>
        <button type="button" class="close ml-auto" aria-label="Đóng" @onclick="DismissIpWarning">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (_stats == null)
{
    <p><em>Đang tải thống kê...</em></p>
}
else
{
    @* 4 stat cards tím kiểu Lexa — dữ liệu thật *@
    <div class="row">
        <div class="col-md-6 col-xl-3">
            <div class="card lexa-stat-card">
                <div class="card-body">
                    <p class="lexa-stat-label"><span class="fa-solid fa-cart-shopping" aria-hidden="true"></span> Tổng đơn hàng</p>
                    <h3 class="lexa-stat-value">@_stats.TotalOrders</h3>
                    <p class="mb-0">
                        @if (_todayVsYesterday != null)
                        {
                            @DeltaBadge(_todayVsYesterday.OrdersDeltaPercent)
                        }
                        <small class="lexa-stat-foot"> Chờ xác nhận: @_stats.PendingOrders</small>
                    </p>
                </div>
            </div>
        </div>
        <AuthorizeView Roles="Admin">
            <Authorized>
        <div class="col-md-6 col-xl-3">
            <div class="card lexa-stat-card">
                <div class="card-body">
                    <p class="lexa-stat-label"><span class="fa-solid fa-dollar-sign" aria-hidden="true"></span> Doanh thu</p>
                    <h3 class="lexa-stat-value">@FormatPrice(_stats.TotalRevenue)</h3>
                    <p class="mb-0">
                        @if (_todayVsYesterday != null)
                        {
                            @DeltaBadge(_todayVsYesterday.RevenueDeltaPercent)
                        }
                        <small class="lexa-stat-foot"> Không tính đơn đã hủy</small>
                    </p>
                </div>
            </div>
        </div>
            </Authorized>
        </AuthorizeView>
        <div class="col-md-6 col-xl-3">
            <div class="card lexa-stat-card">
                <div class="card-body">
                    <p class="lexa-stat-label"><span class="fa-solid fa-tag" aria-hidden="true"></span> Món xôi đã bán</p>
                    <h3 class="lexa-stat-value">@_stats.TotalProductsSold</h3>
                    <p class="mb-0"><small class="lexa-stat-foot">@_stats.TotalProducts món đang kinh doanh</small></p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card lexa-stat-card">
                <div class="card-body">
                    <p class="lexa-stat-label"><span class="fa-solid fa-clock" aria-hidden="true"></span> Đơn chờ xử lý</p>
                    <h3 class="lexa-stat-value">@_stats.PendingOrders</h3>
                    <p class="mb-0"><small class="lexa-stat-foot"><a href="/orders?status=Pending" class="text-white"><u>Xem ngay →</u></a></small></p>
                </div>
            </div>
        </div>
    </div>

@* Wave 5 widgets: daily target, source stats — revenue, Admin only. *@
<AuthorizeView Roles="Admin">
    <Authorized>
<div class="row mb-3">
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h4 class="card-title">🎯 Mục tiêu hôm nay</h4>
                @if (_dailyTarget == null)
                {
                    <small class="text-muted">Đang tải...</small>
                }
                else if (_dailyTarget.Target <= 0)
                {
                    <div class="lx-empty-state">
                        <small class="text-muted">Chưa thiết lập mục tiêu doanh thu ngày.</small>
                    </div>
                }
                else
                {
                    var pct = Math.Min(100, _dailyTarget.Percent);
                    var barClass = pct >= 100 ? "lx-progress-success" : pct >= 70 ? "lx-progress-warning" : "lx-progress-primary";
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <div>
                            <h5 class="mb-0">@_dailyTarget.TodayRevenue.ToString("N0") ₫</h5>
                            <small class="text-muted">Mục tiêu: @_dailyTarget.Target.ToString("N0") ₫</small>
                        </div>
                        <span class="lx-target-pct">@_dailyTarget.Percent.ToString("0")%</span>
                    </div>
                    <div class="progress lx-target-progress">
                        <div class="progress-bar @barClass" role="progressbar"
                             style="width: @pct.ToString("0")%" aria-valuenow="@pct.ToString("0")" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    @if (pct >= 100)
                    {
                        <small class="text-success mt-1 d-block">🎉 Đã đạt mục tiêu!</small>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h4 class="card-title">📍 Đơn theo nguồn</h4>
                @if (_sourceStats == null)
                {
                    <small class="text-muted">Đang tải...</small>
                }
                else if (_sourceStats.Count == 0)
                {
                    <div class="lx-empty-state">
                        <div class="lx-empty-icon">📭</div>
                        <p class="mb-0">Chưa có đơn hàng trong kỳ</p>
                        <small class="text-muted">Dữ liệu sẽ hiển thị khi có đơn hàng mới.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <tbody>
                                @foreach (var s in _sourceStats)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrEmpty(s.Source) ? "Web" : s.Source)</td>
                                        <td class="text-right">@s.OrderCount đơn</td>
                                        <td class="text-right">@s.Revenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
    </Authorized>
</AuthorizeView>

@* Wave 6d (item 36): today vs yesterday comparison card — revenue, Admin only. *@
<AuthorizeView Roles="Admin">
    <Authorized>
<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">📊 Hôm nay vs hôm qua</h4>
                @if (_todayVsYesterday == null)
                {
                    <small class="text-muted">Đang tải...</small>
                }
                else
                {
                    <div class="row text-center">
                        <div class="col-6 col-md-3 mb-2">
                            <div class="h5 mb-0">@FormatPrice(_todayVsYesterday.TodayRevenue)</div>
                            <small class="text-muted">Doanh thu hôm nay<br />Hôm qua: @FormatPrice(_todayVsYesterday.YesterdayRevenue)</small>
                            <div class="mt-1">@DeltaBadge(_todayVsYesterday.RevenueDeltaPercent)</div>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <div class="h5 mb-0">@_todayVsYesterday.TodayOrders đơn</div>
                            <small class="text-muted">Đơn hàng hôm nay<br />Hôm qua: @_todayVsYesterday.YesterdayOrders đơn</small>
                            <div class="mt-1">@DeltaBadge(_todayVsYesterday.OrdersDeltaPercent)</div>
                        </div>
                        <div class="col-12 col-md-6 mb-2 d-flex align-items-center">
                            <small class="text-muted">
                                Đơn đã hủy không được tính. Ngày theo giờ Việt Nam (UTC+7).
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
    </Authorized>
</AuthorizeView>


<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">Khoảng thời gian</h4>
        <div class="form-row align-items-end">
            <div class="col-6 col-md-3">
                <label for="dash-from"><small class="text-muted">Từ ngày</small></label>
                <input id="dash-from" type="date" class="form-control" @bind="_from" />
            </div>
            <div class="col-6 col-md-3">
                <label for="dash-to"><small class="text-muted">Đến ngày</small></label>
                <input id="dash-to" type="date" class="form-control" @bind="_to" />
            </div>
            <div class="col-12 col-md-6 mt-2 mt-md-0">
                <button class="btn btn-primary mr-2" @onclick="ApplyDateRange" disabled="@_refreshing">Áp dụng</button>
                <button class="btn btn-outline-secondary" @onclick="ResetDateRange" disabled="@_refreshing">7 ngày qua</button>
            </div>
        </div>
    </div>
</div>


    <AuthorizeView Roles="Admin">
        <Authorized>
    <div class="row">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Doanh thu theo ngày</h4>
                    @if (_stats.RevenueByDay == null || _stats.RevenueByDay.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu trong khoảng thời gian này.</p>
                    }
                    else
                    {
                        var maxRev = _stats.RevenueByDay.Max(d => d.Revenue);
                        <div class="lexa-area-chart">
                            @foreach (var day in _stats.RevenueByDay)
                            {
                                var barHeight = maxRev > 0 ? Math.Max(4, (int)(day.Revenue / maxRev * 130)) : 4;
                                <div class="lexa-area-bar" style="height:@(barHeight)px" title="@day.Date.ToString("dd/MM"): @FormatPrice(day.Revenue)"></div>
                            }
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-1">
                            @foreach (var day in _stats.RevenueByDay)
                            {
                                <span>@day.Date.ToString("dd/MM")</span>
                            }
                        </div>
                        <div class="table-responsive mt-3">
                            <table class="table table-hover table-sm mb-0">
                                <thead>
                                    <tr><th>Ngày</th><th class="text-right">Đơn</th><th class="text-right">Doanh thu</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var day in _stats.RevenueByDay)
                                    {
                                        <tr>
                                            <td>@day.Date.ToString("dd/MM")</td>
                                            <td class="text-right">@day.Orders</td>
                                            <td class="text-right">@FormatPrice(day.Revenue)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Đơn hàng theo trạng thái</h4>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <tbody>
                                @foreach (var item in _stats.OrdersByStatus)
                                {
                                    <tr>
                                        <td>@StatusBadge(item.Status)</td>
                                        <td class="text-right"><strong>@item.Count</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
        </Authorized>
        <NotAuthorized>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Đơn hàng theo trạng thái</h4>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <tbody>
                                @foreach (var item in _stats.OrdersByStatus)
                                {
                                    <tr>
                                        <td>@StatusBadge(item.Status)</td>
                                        <td class="text-right"><strong>@item.Count</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
        </NotAuthorized>
    </AuthorizeView>

    <div class="row">
    <AuthorizeView Roles="Admin">
        <Authorized>
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title">Món bán chạy nhất</h4>
                    @if (_topProducts == null)
                    {
                        <p class="text-muted mb-0"><em>Đang tải...</em></p>
                    }
                    else if (_topProducts.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu trong khoảng thời gian này.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead>
                                    <tr><th>#</th><th>Món</th><th class="text-right">Đã bán</th><th class="text-right">Doanh thu</th></tr>
                                </thead>
                                <tbody>
                                    @{
                                        var rank = 0;
                                    }
                                    @foreach (var p in _topProducts)
                                    {
                                        rank++;
                                        <tr>
                                            <td><strong>@rank</strong></td>
                                            <td>@p.ProductName</td>
                                            <td class="text-right">@p.QuantitySold</td>
                                            <td class="text-right">@FormatPrice(p.Revenue)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
        </Authorized>
    </AuthorizeView>
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title">Khách mới / khách quay lại</h4>
                    @if (_newReturning == null)
                    {
                        <p class="text-muted mb-0"><em>Đang tải...</em></p>
                    }
                    else
                    {
                        <div class="row text-center">
                            <div class="col-6">
                                <h3 class="text-success mb-0">@_newReturning.NewCustomers</h3>
                                <small class="text-muted">Khách mới<br />@_newReturning.NewCustomerOrders đơn</small>
                            </div>
                            <div class="col-6">
                                <h3 class="text-info mb-0">@_newReturning.ReturningCustomers</h3>
                                <small class="text-muted">Khách quay lại<br />@_newReturning.ReturningCustomerOrders đơn</small>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">Khách mới = lần đầu đặt trong khoảng thời gian đã chọn.</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <AuthorizeView Roles="Admin">
        <Authorized>
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                    <h4 class="card-title mb-0">📊 Báo cáo tuần — gửi Zalo chủ quán</h4>
                    <div class="mt-1 mt-md-0">
                        <button class="btn btn-sm btn-outline-secondary mr-2" @onclick="CopyWeeklyReportAsync" disabled="@(_weeklyReport == null)">📋 Sao chép nội dung</button>
                        <button class="btn btn-sm btn-primary" @onclick="SendWeeklyReportAsync" disabled="@(_sendingWeekly || _weeklyReport == null)">
                            @(_sendingWeekly ? "Đang gửi..." : "📤 Gửi qua Zalo")
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_weeklySendNote))
                {
                    <div class="alert @(_weeklySendIsError ? "alert-warning" : "alert-success") mb-2">@_weeklySendNote</div>
                }
                @if (!string.IsNullOrEmpty(_weeklyCopied))
                {
                    <div class="alert alert-info py-1 mb-2">@_weeklyCopied</div>
                }
                @if (_weeklyReport == null)
                {
                    <p class="text-muted mb-0"><em>Đang tải...</em></p>
                }
                else
                {
                    <h5 class="mb-2">@_weeklyReport.WeekLabel</h5>
                    <div class="row text-center mb-2">
                        <div class="col-6 col-md-3 mb-2">
                            <h4 class="text-primary mb-0">@FormatPrice(_weeklyReport.TotalRevenue)</h4>
                            <small class="text-muted">Doanh thu @ChangeBadgeHtml(_weeklyReport.RevenueChangePercent)</small>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <h4 class="mb-0">@_weeklyReport.OrderCount</h4>
                            <small class="text-muted">Số đơn @ChangeBadgeHtml(_weeklyReport.OrderChangePercent)</small>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <h4 class="text-danger mb-0">@_weeklyReport.CancelledCount</h4>
                            <small class="text-muted">Đơn hủy</small>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <h4 class="mb-0">@FormatPrice(_weeklyReport.AverageOrderValue)</h4>
                            <small class="text-muted">Giá trị TB/đơn</small>
                        </div>
                    </div>
                    @if (_weeklyReport.TopProducts.Count > 0)
                    {
                        <strong>🏆 Món bán chạy:</strong>
                        <ol class="mb-0 mt-1">
                            @foreach (var p in _weeklyReport.TopProducts)
                            {
                                <li>@p.ProductName — <strong>@p.Quantity</strong> suất</li>
                            }
                        </ol>
                    }
                }
                <small class="text-muted d-block mt-2">Tự động gửi 08:00 sáng thứ 2 hàng tuần (cần chạy BackgroundServer). Cấu hình token ở Cài đặt cửa hàng → "Báo cáo tuần qua Zalo".</small>
            </div>
        </div>
        </Authorized>
    </AuthorizeView>

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="card-title mb-0">Đơn hàng mới nhất</h4>
                <a href="/orders" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>SĐT</th>
                            <th class="text-right">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _stats.RecentOrders)
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td>@order.CustomerName</td>
                                <td>@order.CustomerPhone</td>
                                <td class="text-right">@FormatPrice(order.TotalAmount)</td>
                                <td>@StatusBadge(order.Status)</td>
                                <td class="text-muted">@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}



@code {
    private DashboardStatsModel _stats;

    // Wave 5 widgets (items 122/124/133/139).
    private DailyTargetModel _dailyTarget;
    private List<SourceStatModel> _sourceStats;
    private List<TopProductModel> _topProducts;
    private NewAndReturningCustomersModel _newReturning;

    // Wave 6d (item 36): today-vs-yesterday comparison card.
    private TodayVsYesterdayModel _todayVsYesterday;

    // Item 138: weekly owner report card (Admin-only API).
    private WeeklyReportModel _weeklyReport;
    private bool _sendingWeekly;
    private string _weeklySendNote;
    private bool _weeklySendIsError;
    private string _weeklyCopied;
    private bool _autoRefresh = true;
    private bool _refreshing;
    private DateTime _lastUpdated = DateTime.Now;
    private CancellationTokenSource _cts;

    private DateTime _from = DateTime.Today.AddDays(-6);
    private DateTime _to = DateTime.Today;

    // New-order alert state.
    private long _baselineOrderCount = -1;
    private int _newOrderCount;

    // Item 86: urgent stale-pending alert state.
    private long _lastStaleCount;
    private bool _staleDismissed;

    // Item 99: new-IP login warning (set by the login page in localStorage).
    private string _newIpWarning;
    private const string IpWarningKey = "phuthuong.last-login-ip-warning";

    // Item 135: món hết suất hôm nay (từ DailyInventory).
    private List<string> _soldOutToday = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();

        try
        {
            _newIpWarning = await JSRuntime.InvokeAsync<string>("localStorage.getItem", IpWarningKey);
        }
        catch (Exception)
        {
        }

        _cts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            var stats = await DashboardService.GetStatsAsync(_from, _to);
            var top = await DashboardService.GetTopProductsAsync(_from, _to);
            NewAndReturningCustomersModel newReturning = null;
            try
            {
                newReturning = await DashboardService.GetNewReturningCustomersAsync(_from, _to);
            }
            catch (Exception)
            {
                // Non-critical section.
            }

            DetectNewOrders(stats);
            DetectStaleOrders(stats);
            _stats = stats;
            _topProducts = top;
            _newReturning = newReturning;
            _lastUpdated = DateTime.Now;

            // Wave 5 widgets: daily target, source stats, corporate due, forecast.
            await LoadDashboardWidgetsAsync();

            // Wave 6d (item 36): today-vs-yesterday card (fail-soft).
            await LoadTodayVsYesterdayAsync();

            // Item 138: weekly report card (fail-soft; Admin-only API).
            await LoadWeeklyReportAsync();

            // Item 135: món hết suất hôm nay (fail-soft — alert ẩn khi lỗi).
            await LoadSoldOutTodayAsync();
        }
        catch (Exception)
        {
            _stats ??= new DashboardStatsModel();
        }
    }

    /// <summary>Thẻ so sánh hôm nay/hôm qua — lỗi thì ẩn thẻ.</summary>
    private async Task LoadTodayVsYesterdayAsync()
    {
        try
        {
            _todayVsYesterday = await DashboardService.GetTodayVsYesterdayAsync();
        }
        catch (Exception)
        {
            _todayVsYesterday = null;
        }
    }

    /// <summary>Thẻ báo cáo tuần — lỗi thì ẩn thẻ.</summary>
    private async Task LoadWeeklyReportAsync()
    {
        try
        {
            _weeklyReport = await DashboardService.GetWeeklyReportAsync();
        }
        catch (Exception)
        {
            _weeklyReport = null;
        }
    }

    /// <summary>Danh sách món hết suất hôm nay — lỗi thì hiện rỗng.</summary>
    private async Task LoadSoldOutTodayAsync()
    {
        try
        {
            var remaining = await ShopService.GetDailyRemainingAsync();
            _soldOutToday = (remaining ?? new List<PhuThuongStickyRice.Web.Components.Shop.Models.ProductDailyRemainingModel>())
                .Where(r => r.RemainingToday <= 0)
                .Select(r => r.ProductName)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .ToList();
        }
        catch (Exception)
        {
            _soldOutToday = new List<string>();
        }
    }

    private async Task LoadDashboardWidgetsAsync()
    {
        try
        {
            _dailyTarget = await AdminCommerceService.GetDailyTargetAsync();
        }
        catch (Exception)
        {
        }

        try
        {
            _sourceStats = await AdminCommerceService.GetSourceStatsAsync(_from, _to);
        }
        catch (Exception)
        {
        }

    }

    private void DetectNewOrders(DashboardStatsModel stats)
    {
        if (_baselineOrderCount < 0)
        {
            // First load: establish the baseline, no alert.
            _baselineOrderCount = stats.TotalOrders;
            return;
        }

        var delta = stats.TotalOrders - _baselineOrderCount;
        if (delta > 0)
        {
            _newOrderCount += (int)delta;
            _baselineOrderCount = stats.TotalOrders;
            _ = PlayBeepAsync();
        }
    }

    private async Task PlayBeepAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("interop.playBeep");
        }
        catch (Exception)
        {
            // Audio is best-effort.
        }
    }

    private void DismissNewOrderAlert()
    {
        _newOrderCount = 0;
    }

    /// <summary>
    /// Item 86: distinct urgent sound + banner when stale pending orders
    /// appear or grow.
    /// </summary>
    private void DetectStaleOrders(DashboardStatsModel stats)
    {
        if (_staleDismissed)
        {
            _lastStaleCount = stats.StalePendingOrders;
            return;
        }

        if (stats.StalePendingOrders > 0 && stats.StalePendingOrders != _lastStaleCount)
        {
            _ = PlayUrgentAsync();
        }

        _lastStaleCount = stats.StalePendingOrders;
    }

    private void DismissStaleAlert()
    {
        _staleDismissed = true;
    }

    private async Task PlayUrgentAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("interop.playUrgent");
        }
        catch (Exception)
        {
            // Audio is best-effort.
        }
    }

    private async Task DismissIpWarning()
    {
        _newIpWarning = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", IpWarningKey);
        }
        catch (Exception)
        {
        }
    }

    private async Task ApplyDateRange()
    {
        if (_from > _to)
        {
            (_from, _to) = (_to, _from);
        }

        // Re-baseline so the range change itself doesn't trigger the alert.
        _baselineOrderCount = -1;
        _newOrderCount = 0;
        _staleDismissed = false;
        _lastStaleCount = 0;
        await RefreshNow();
    }

    private async Task ResetDateRange()
    {
        _from = DateTime.Today.AddDays(-6);
        _to = DateTime.Today;
        _baselineOrderCount = -1;
        _newOrderCount = 0;
        _staleDismissed = false;
        _lastStaleCount = 0;
        await RefreshNow();
    }

    private async Task RefreshNow()
    {
        _refreshing = true;
        try
        {
            await LoadStatsAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    // Item 160: đọc báo cáo doanh thu bằng giọng nói (Web Speech API, vi-VN).
    private bool _speaking;

    private async Task SpeakReport()
    {
        if (_stats == null) return;
        var text = $"Hôm nay có {_stats.TotalOrders} đơn hàng, " +
                   $"doanh thu {(long)_stats.TotalRevenue:N0} đồng, " +
                   $"{_stats.PendingOrders} đơn đang chờ xử lý.";
        try
        {
            var ok = await JSRuntime.InvokeAsync<bool>("interop.speak", text);
            _speaking = ok;
            if (!ok)
            {
                // Trình duyệt không hỗ trợ đọc giọng nói.
                _speaking = false;
            }
        }
        catch { _speaking = false; }
        StateHasChanged();
    }

    private async Task StopSpeaking()
    {
        try { await JSRuntime.InvokeVoidAsync("interop.stopSpeak"); } catch { }
        _speaking = false;
    }

    // Item 138: weekly owner report actions.
    private async Task SendWeeklyReportAsync()
    {
        _sendingWeekly = true;
        _weeklySendNote = null;
        _weeklyCopied = null;
        try
        {
            var result = await DashboardService.SendWeeklyReportAsync();
            _weeklySendIsError = !result.IsSent;
            _weeklySendNote = result.Note;
        }
        catch (Exception ex)
        {
            _weeklySendIsError = true;
            _weeklySendNote = "Gửi thất bại: " + ex.Message;
        }
        finally
        {
            _sendingWeekly = false;
        }
    }

    private async Task CopyWeeklyReportAsync()
    {
        if (_weeklyReport == null || string.IsNullOrEmpty(_weeklyReport.MessageText))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _weeklyReport.MessageText);
            _weeklyCopied = "Đã sao chép nội dung báo cáo.";
        }
        catch (Exception)
        {
            _weeklyCopied = null;
        }
    }

    private static MarkupString ChangeBadgeHtml(decimal? change)
    {
        if (!change.HasValue)
        {
            return new MarkupString("<span class=\"badge badge-secondary\">chưa có số liệu tuần trước</span>");
        }

        var arrow = change.Value > 0 ? "▲" : change.Value < 0 ? "▼" : "＝";
        var sign = change.Value > 0 ? "+" : "";
        var cls = change.Value > 0 ? "badge-success" : change.Value < 0 ? "badge-danger" : "badge-secondary";
        return new MarkupString($"<span class=\"badge {cls}\">{arrow}{sign}{change.Value:N1}%</span>");
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), token);
                if (_autoRefresh && !token.IsCancellationRequested)
                {
                    await LoadStatsAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        try { JSRuntime.InvokeVoidAsync("interop.stopSpeak"); } catch { }
    }

    /// <summary>
    /// Wave 6d (item 36): signed delta badge, green ▲ when up, red ▼ when down.
    /// </summary>
    private static RenderFragment DeltaBadge(double delta) => builder =>
    {
        var up = delta >= 0;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", up ? "badge badge-success" : "badge badge-danger");
        builder.AddContent(2, $"{(up ? "▲" : "▼")} {Math.Abs(delta):0.#}%");
        builder.CloseElement();
    };

    private static RenderFragment StatusBadge(string status) => builder =>
    {
        var css = status switch
        {
            "Pending" => "badge badge-warning",
            "Confirmed" => "badge badge-info",
            "Preparing" => "badge badge-primary",
            "Delivering" => "badge badge-secondary",
            "Completed" => "badge badge-success",
            "Cancelled" => "badge badge-danger",
            _ => "badge badge-light"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, status);
        builder.CloseElement();
    };
}
