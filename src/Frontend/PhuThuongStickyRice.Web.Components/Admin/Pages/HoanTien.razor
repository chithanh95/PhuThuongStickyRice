@page "/admin/hoan-tien"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Core.Components
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using PhuThuongStickyRice.Web.Components.Orders.Services
@using PhuThuongStickyRice.Web.Components.Orders.Models
@inject Wave5Service Wave5Service
@inject OrderService OrderService

<h3>↩️ Hoàn tiền</h3>
<p class="text-muted">Ghi nhận hoàn tiền cho đơn hàng. Việc chuyển tiền thực tế (tiền mặt / chuyển khoản / cộng ví) làm thủ công — đây chỉ là sổ ghi nhận.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="card mb-3">
    <div class="card-header">Tạo yêu cầu hoàn tiền</div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-4">
                <label>Mã đơn *</label>
                <input class="form-control text-uppercase" @bind="_orderNumber" placeholder="VD: PX-20261014-4821" />
            </div>
            <div class="form-group col-md-3">
                <label>Số tiền hoàn (₫) *</label>
                <input type="number" min="1000" step="1000" class="form-control" @bind="_amount" />
            </div>
            <div class="form-group col-md-5">
                <label>Lý do</label>
                <input class="form-control" @bind="_reason" placeholder="VD: giao thiếu món, khách đổi ý" />
            </div>
        </div>
        <button class="btn btn-warning" @onclick="RequestAsync" disabled="@_busy">Ghi nhận yêu cầu hoàn tiền</button>
        @if (_foundOrder != null)
        {
            <div class="mt-2">
                <small class="text-muted">Đơn @_foundOrder.OrderNumber — @_foundOrder.CustomerName — tổng @_foundOrder.TotalAmount.ToString("N0") ₫ — trạng thái hoàn: @_foundOrder.RefundStatus</small>
                @if (_foundOrder.RefundStatus == "Requested")
                {
                    <button class="btn btn-sm btn-success ml-2" @onclick="ConfirmAsync" disabled="@_busy">Xác nhận đã hoàn tiền</button>
                }
            </div>
        }
    </div>
</div>

<h5>Sổ hoàn tiền</h5>
@if (_report == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_report.Count == 0)
{
    <div class="alert alert-info">Chưa có yêu cầu hoàn tiền nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách</th>
                    <th class="text-right">Tổng đơn</th>
                    <th class="text-right">Tiền hoàn</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _report)
                {
                    <tr>
                        <td><strong>@r.OrderNumber</strong></td>
                        <td>@r.CustomerName<br /><small class="text-muted">@r.CustomerPhone</small></td>
                        <td class="text-right">@r.TotalAmount.ToString("N0") ₫</td>
                        <td class="text-right">@r.RefundAmount.ToString("N0") ₫</td>
                        <td>
                            @if (r.RefundStatus == "Requested")
                            {
                                <span class="badge badge-warning">Chờ hoàn</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Đã hoàn</span>
                            }
                        </td>
                        <td class="text-right">
                            @if (r.RefundStatus == "Requested")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => ConfirmByIdAsync(r.Id)" disabled="@_busy">Xác nhận đã hoàn</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string _orderNumber;
    private decimal _amount;
    private string _reason;
    private OrderModel _foundOrder;
    private List<RefundReportRowModel> _report;
    private bool _busy;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        try
        {
            _report = await Wave5Service.GetRefundReportAsync();
        }
        catch (Exception ex)
        {
            _error = "Không tải được sổ hoàn tiền: " + ex.Message;
        }
    }

    private async Task RequestAsync()
    {
        _error = null;
        _success = null;
        _foundOrder = null;
        if (string.IsNullOrWhiteSpace(_orderNumber) || _amount <= 0)
        {
            _error = "Vui lòng nhập mã đơn và số tiền hoàn.";
            return;
        }

        _busy = true;
        try
        {
            var number = _orderNumber.Trim().ToUpperInvariant();
            var paged = await OrderService.GetOrdersAsync(1, 5, number);
            _foundOrder = paged?.Items?.FirstOrDefault(x =>
                string.Equals(x.OrderNumber, number, StringComparison.OrdinalIgnoreCase));
            if (_foundOrder == null)
            {
                _error = "Không tìm thấy đơn hàng.";
                return;
            }

            await Wave5Service.RequestRefundAsync(_foundOrder.Id, _amount, _reason);
            var refreshed = await OrderService.GetByIdAsync(_foundOrder.Id);
            _foundOrder = refreshed;
            _success = $"Đã ghi nhận yêu cầu hoàn {_amount:N0} ₫ cho đơn {_foundOrder.OrderNumber}. Nhớ chuyển tiền thủ công cho khách.";
            await LoadReportAsync();
        }
        catch (Exception ex)
        {
            _error = "Thất bại: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_foundOrder == null)
        {
            return;
        }

        await ConfirmByIdAsync(_foundOrder.Id);
        _foundOrder = null;
    }

    private async Task ConfirmByIdAsync(Guid orderId)
    {
        _busy = true;
        _error = null;
        try
        {
            await Wave5Service.ConfirmRefundAsync(orderId);
            _success = "Đã xác nhận hoàn tiền.";
            await LoadReportAsync();
        }
        catch (Exception ex)
        {
            _error = "Thất bại: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
