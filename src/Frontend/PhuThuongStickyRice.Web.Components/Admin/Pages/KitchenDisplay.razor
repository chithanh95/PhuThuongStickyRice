@page "/bep"
@layout PhuThuongStickyRice.Web.Components.Core.Layouts.EmptyLayout
@attribute [Authorize(Roles = "Kitchen,Admin")]
@implements IDisposable
@using System.Threading
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Orders.Services
@inject Wave3Service Wave3Service
@inject OrderService OrderService

<style>
    .kds-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
    .kds-card { border-left: 6px solid #ffc107; }
    .kds-card.kds-confirmed { border-left-color: #17a2b8; }
    .kds-card.kds-preparing { border-left-color: #007bff; }
    .kds-advance { min-height: 56px; font-size: 1.15rem; font-weight: 600; }
    .kds-item { font-size: 1.05rem; }
    .kds-time { font-variant-numeric: tabular-nums; }
    .kds-timeline { border-left: 2px solid #dee2e6; padding-left: 10px; margin: 8px 0 0 2px; }
    .kds-timeline li { padding: 2px 0; }
    .kds-section-title { font-size: 1.25rem; font-weight: 700; }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <h3 class="mb-2 mb-md-0">🍳 Màn hình bếp</h3>
    <div class="d-flex align-items-center">
        <small class="text-muted mr-3">Tự động làm mới 20s • Cập nhật: @_lastUpdated.ToString("HH:mm:ss")</small>
        @* Item 130 (đúng): VIP orders first. *@
        <div class="form-check form-check-inline mb-0 mr-3">
            <input class="form-check-input" type="checkbox" id="kds-vipfirst" @bind="_vipFirst" />
            <label class="form-check-label font-weight-bold text-warning" for="kds-vipfirst">👑 VIP trước</label>
        </div>
        <div class="form-check form-check-inline mb-0">
            <input class="form-check-input" type="checkbox" id="kds-auto" @bind="_autoRefresh" />
            <label class="form-check-label" for="kds-auto">Tự động</label>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_orders == null)
{
    <p><em>Đang tải đơn bếp...</em></p>
}
else if (_orders.Count == 0)
{
    <div class="alert alert-success">🎉 Bếp đang rảnh — không có đơn nào cần làm.</div>
}
else
{
    @* Item 98: scheduled (pre-order) orders on top, nearest pickup time first. *@
    @if (_scheduledOrders.Count > 0)
    {
        <div class="d-flex align-items-center mb-2">
            <span class="kds-section-title">📅 Đơn đặt trước</span>
            <span class="badge badge-primary ml-2">@_scheduledOrders.Count</span>
        </div>
        <div class="kds-grid mb-4">
            @foreach (var order in _scheduledOrders)
            {
                <KdsOrderCard @key="order.Id" Order="order"
                              History="@HistoryFor(order.Id)"
                              OnAdvance="Advance" Advancing="_advancing" />
            }
        </div>
        @if (_regularOrders.Count > 0)
        {
            <div class="d-flex align-items-center mb-2">
                <span class="kds-section-title">🧾 Đơn thường</span>
                <span class="badge badge-secondary ml-2">@_regularOrders.Count</span>
            </div>
        }
    }
    @if (_regularOrders.Count > 0)
    {
        <div class="kds-grid">
            @foreach (var order in _regularOrders)
            {
                <KdsOrderCard @key="order.Id" Order="order"
                              History="@HistoryFor(order.Id)"
                              OnAdvance="Advance" Advancing="_advancing" />
            }
        </div>
    }
}

@code {
    private List<OrderModel> _orders;
    private List<OrderModel> _scheduledOrders = new List<OrderModel>();
    private List<OrderModel> _regularOrders = new List<OrderModel>();
    private string _error;
    private bool _autoRefresh = true;
    // Item 130 (đúng): sort VIP orders first.
    private bool _vipFirst;
    private bool _advancing;
    private DateTime _lastUpdated = DateTime.Now;
    private CancellationTokenSource _cts;

    // Wave 6c (item 34): per-card status timeline (order id → transitions).
    private Dictionary<Guid, List<OrderStatusHistoryModel>> _history
        = new Dictionary<Guid, List<OrderStatusHistoryModel>>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _cts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task LoadAsync()
    {
        try
        {
            _orders = await Wave3Service.GetKitchenOrdersAsync() ?? new List<OrderModel>();

            // Item 98: pre-orders (ScheduledFor set) go on top,
            // nearest scheduled pickup time first. Status logic unchanged.
            var scheduled = _orders
                .Where(o => o.ScheduledFor.HasValue)
                .OrderBy(o => o.ScheduledFor.Value);
            var regular = _orders
                .Where(o => !o.ScheduledFor.HasValue)
                .OrderBy(o => o.CreatedAt);

            // Item 130 (đúng): VIP orders jump to the top of each section.
            _scheduledOrders = (_vipFirst
                ? scheduled.OrderByDescending(o => o.IsVip).ThenBy(o => o.ScheduledFor.Value)
                : scheduled).ToList();
            _regularOrders = (_vipFirst
                ? regular.OrderByDescending(o => o.IsVip).ThenBy(o => o.CreatedAt)
                : regular).ToList();

            _lastUpdated = DateTime.Now;
            _error = null;

            // Wave 6c (item 34): compact timelines for the visible cards,
            // fetched in parallel (cards are few by design).
            var tasks = _orders.Select(async o =>
            {
                try
                {
                    return (o.Id, History: await OrderService.GetStatusHistoryAsync(o.Id)
                        ?? new List<OrderStatusHistoryModel>());
                }
                catch (Exception)
                {
                    return (o.Id, History: new List<OrderStatusHistoryModel>());
                }
            });
            var results = await Task.WhenAll(tasks);
            _history = results.ToDictionary(x => x.Id, x => x.History);
        }
        catch (Exception)
        {
            _error = "Không tải được đơn bếp. Vui lòng thử lại.";
        }
    }

    private List<OrderStatusHistoryModel> HistoryFor(Guid orderId) =>
        _history.TryGetValue(orderId, out var h) ? h : new List<OrderStatusHistoryModel>();

    private async Task Advance(OrderModel order)
    {
        _advancing = true;
        _error = null;
        try
        {
            await Wave3Service.AdvanceKitchenStatusAsync(order.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _advancing = false;
        }
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(20), token);
                if (_autoRefresh && !token.IsCancellationRequested && !_advancing)
                {
                    await LoadAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
