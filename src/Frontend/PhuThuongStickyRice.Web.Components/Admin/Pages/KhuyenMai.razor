@* Trang khuyến mãi giờ vàng (admin): chương trình giảm giá theo khung giờ + ngày trong
   tuần. Ngày áp dụng lưu dạng bitmask DaysOfWeekFlags (T2=1, T3=2, T4=4, T5=8, T6=16,
   T7=32, CN=64; 127 = cả tuần). Server tự áp giá KM khi đơn rơi vào khung giờ. *@
@page "/admin/khuyen-mai"
@attribute [Authorize(Roles = "Admin")]
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject AdminOperationsService AdminOperationsService

<div class="lx-page-head">
    <h4 class="lx-page-title">Khuyến mãi</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Khuyến mãi</li>
    </ol>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Chương trình khuyến mãi giờ vàng</h4>
                    <button class="btn btn-primary" @onclick="ShowAdd">
                        <span class="fa-solid fa-plus"></span> Thêm mới
                    </button>
                </div>
                @if (_loading)
                {
                    <p><em>Đang tải...</em></p>
                }
                else if (_promotions.Count == 0)
                {
                    <div class="alert alert-info">Chưa có chương trình khuyến mãi nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Tên chương trình</th>
                                    <th scope="col">Giảm giá</th>
                                    <th scope="col">Giờ áp dụng</th>
                                    <th scope="col">Ngày áp dụng</th>
                                    <th scope="col">Trạng thái</th>
                                    <th scope="col" class="km-actions-col">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _promotions)
                                {
                                    <tr>
                                        <td><strong>@p.Name</strong></td>
                                        <td><span class="badge badge-success">@p.DiscountPercent%</span></td>
                                        <td>@p.StartTime - @p.EndTime</td>
                                        <td>@FormatDays(p.DaysOfWeekFlags)</td>
                                        <td>
                                            @if (p.IsActive)
                                            {
                                                <span class="badge badge-success">Đang chạy</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Tạm dừng</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEdit(p)">Sửa</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(p)">Xóa</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_showForm)
{
    @* UIUX-1019 Agent4 (run 18:35): role="dialog" + aria-modal + aria-labelledby
       để trình đọc màn hình nhận diện đây là hộp thoại và đọc đúng tiêu đề. *@
    <div class="modal show d-block lx-modal-veil" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="km-modal-title" @ref="_modalRef" @onkeydown="ModalKeyDown">
        @* UIUX-1020 Agent4 (a11y): @onkeydown trên lớp phủ modal — bấm Esc đóng
           modal, đồng bộ với modal Mã giảm giá (người dùng bàn phím). *@
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="km-modal-title">@(_editing == null ? "Thêm khuyến mãi" : "Sửa khuyến mãi")</h5>
                    <button type="button" class="close" @onclick="HideForm" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger">@_error</div>
                    }
                    <div class="form-group">
                        @* UIUX-1020 Agent4 (a11y): for/id liên kết label với ô nhập —
                           trình đọc màn hình đọc đúng tên trường khi focus. *@
                        <label for="km-name">Tên chương trình</label>
                        <input id="km-name" class="form-control" @bind="_form.Name" placeholder="VD: Giờ vàng buổi trưa" />
                    </div>
                    <div class="form-group">
                        <label for="km-pct">Giảm giá (%)</label>
                        <input id="km-pct" type="number" class="form-control" @bind="_form.DiscountPercent" min="1" max="100" />
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="km-start">Giờ bắt đầu</label>
                            <input id="km-start" class="form-control" @bind="_form.StartTime" placeholder="11:00" />
                        </div>
                        <div class="form-group col-6">
                            <label for="km-end">Giờ kết thúc</label>
                            <input id="km-end" class="form-control" @bind="_form.EndTime" placeholder="14:00" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Ngày áp dụng</label>
                        <div>
                            @foreach (var day in _days)
                            {
                                <div class="custom-control custom-checkbox custom-control-inline">
                                    <input type="checkbox" class="custom-control-input" id="day_@day.Value"
                                           checked="@((_form.DaysOfWeekFlags & day.Value) != 0)"
                                           @onchange="(e) => ToggleDay(day.Value, (bool)e.Value)" />
                                    <label class="custom-control-label" for="day_@day.Value">@day.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="lexa-switch lexa-switch-success mb-0">
                            <input type="checkbox" id="promo_active" @bind="_form.IsActive" />
                            <span class="lexa-slider"></span>
                        </label>
                        <label class="mb-0" for="promo_active">Kích hoạt</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="HideForm">Hủy</button>
                    <button class="btn btn-primary" @onclick="SavePromotionAsync" disabled="@_saving">
                        @(_saving ? "Đang lưu..." : "Lưu")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="DeleteDialog" Title="Xóa khuyến mãi" YesText="Xóa" NoText="Hủy" ConfirmEventCallback="ConfirmedDelete">
    <Message>
        Bạn có chắc muốn xóa chương trình <strong>@_deleting?.Name</strong>? Khuyến mãi đang chạy sẽ dừng áp dụng ngay và không thể hoàn tác.
    </Message>
</ConfirmDialog>

@code {
    private bool _loading = true;
    private bool _showForm;
    @* UIUX-1020 Agent4 (a11y): đưa focus vào modal khi mở — screen reader đọc ngay
       role="dialog" + tiêu đề, người dùng bàn phím tab từ trong modal đi ra thay vì
       kẹt ở nút nền phía sau. tabindex="-1" trên lớp phủ cho phép FocusAsync() lập trình. *@
    private ElementReference _modalRef;
    private bool _focusModalOnOpen;
    private bool _saving;
    private string _error;
    private List<PromotionModel> _promotions = new();
    private PromotionModel _editing;
    private PromotionModel _form = new();

    private ConfirmDialog DeleteDialog;
    private PromotionModel _deleting;

    // Bitmask ngày trong tuần: T2=1, T3=2, T4=4, T5=8, T6=16, T7=32, CN=64.
    // Mặc định 127 (= tất cả 7 bit cộng lại) nghĩa là áp dụng cả tuần.
    private readonly List<(int Value, string Name)> _days = new()
    {
        (1, "T2"), (2, "T3"), (4, "T4"), (8, "T5"), (16, "T6"), (32, "T7"), (64, "CN")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPromotionsAsync();
    }

    private async Task LoadPromotionsAsync()
    {
        _loading = true;
        try
        {
            _promotions = await AdminOperationsService.GetPromotionsAsync() ?? new();
        }
        catch (Exception ex)
        {
            // Hiện lỗi thật thay vì nuốt im lặng (tester 2026-10-22):
            // danh sách trống kèm lý do, tránh tưởng chưa có khuyến mãi.
            _promotions = new();
            _error = $"Không tải được danh sách khuyến mãi: {ex.Message}";
        }
        _loading = false;
    }

    private string FormatDays(int flags)
    {
        if (flags == 127) return "Cả tuần";
        var names = _days.Where(d => (flags & d.Value) != 0).Select(d => d.Name);
        return string.Join(", ", names);
    }

    private void ShowAdd()
    {
        _editing = null;
        _form = new PromotionModel { IsActive = true, DaysOfWeekFlags = 127, StartTime = "11:00", EndTime = "14:00" };
        _error = null;
        _showForm = true;
        _focusModalOnOpen = true;
    }

    private void ShowEdit(PromotionModel p)
    {
        _editing = p;
        _form = new PromotionModel
        {
            Id = p.Id, Name = p.Name, DiscountPercent = p.DiscountPercent,
            StartTime = p.StartTime, EndTime = p.EndTime,
            DaysOfWeekFlags = p.DaysOfWeekFlags, IsActive = p.IsActive
        };
        _error = null;
        _showForm = true;
        _focusModalOnOpen = true;
    }

    private void HideForm() => _showForm = false;

    /// <summary>
    /// UIUX-1020 Agent4 (a11y): sau khi modal render xong, chuyển focus vào lớp phủ
    /// modal (đã có tabindex="-1"). Không gọi trong lúc render để tránh lỗi
    /// ElementReference chưa gắn — cờ _focusModalOnOpen chỉ bật khi vừa mở modal.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModalOnOpen && _showForm)
        {
            _focusModalOnOpen = false;
            await _modalRef.FocusAsync();
        }
    }

    /// <summary>
    /// Đóng modal khi người dùng bấm Esc (điều hướng bàn phím).
    /// </summary>
    private void ModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") HideForm();
    }

    private void ToggleDay(int value, bool checked_)
    {
        if (checked_) _form.DaysOfWeekFlags |= value;
        else _form.DaysOfWeekFlags &= ~value;
    }

    private async Task SavePromotionAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = "Vui lòng nhập tên chương trình.";
            return;
        }
        _saving = true;
        try
        {
            if (_editing == null)
                await AdminOperationsService.CreatePromotionAsync(_form);
            else
                await AdminOperationsService.UpdatePromotionAsync(_editing.Id, _form);
            _showForm = false;
            await LoadPromotionsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }

    /// <summary>
    /// Hỏi xác nhận trước khi xóa khuyến mãi giờ vàng (bug hunt 2026-10-19:
    /// trước đây xóa ngay không hỏi + nuốt lỗi im lặng). Khuyến mãi đang chạy
    /// ảnh hưởng giá toàn site nên bấm nhầm rất nguy hiểm.
    /// </summary>
    private void AskDelete(PromotionModel p)
    {
        _deleting = p;
        _error = null;
        DeleteDialog.Show();
    }

    private async Task ConfirmedDelete()
    {
        if (_deleting == null)
        {
            return;
        }

        try
        {
            await AdminOperationsService.DeletePromotionAsync(_deleting.Id);
            DeleteDialog.Close();
            _deleting = null;
            await LoadPromotionsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
