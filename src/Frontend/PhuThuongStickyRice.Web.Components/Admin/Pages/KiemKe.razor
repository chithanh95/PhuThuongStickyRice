@layout PhuThuongStickyRice.Web.Components.Core.Layouts.AdminLayout
@page "/admin/kiem-ke"
@attribute [Authorize(Roles = "Admin")]
@using System
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using PhuThuongStickyRice.Web.Components.Products.Models
@using PhuThuongStickyRice.Web.Components.Products.Services
@inject InventoryService InventoryService
@inject ProductService ProductService

<h3>📋 Kiểm kê cuối ngày</h3>
<p class="text-muted">Mỗi tối nhập số suất còn lại của từng món. Lưu lại cho một ngày sẽ ghi đè số liệu cũ của ngày đó.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (_saved)
{
    <div class="alert alert-success">Đã lưu kiểm kê ngày @_date.ToString("dd/MM/yyyy").</div>
}

<div class="card mb-4">
    <div class="card-header d-flex align-items-center">
        <strong>Nhập kiểm kê</strong>
        <input type="date" class="form-control ml-3" style="width: 200px;" @bind="_date" @bind:after="OnDateChanged"
               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>
    <div class="card-body p-0">
        @if (_products == null)
        {
            <p class="p-3"><em>Đang tải danh sách món...</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Món</th>
                            <th style="width: 140px;">Còn lại (suất)</th>
                            <th>Ghi chú</th>
                            <th style="width: 130px;" class="text-right">Hôm trước</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr @key="row.ProductId">
                                <td>@row.ProductName</td>
                                <td>
                                    <input type="number" min="0" class="form-control form-control-sm"
                                           @bind="row.RemainingQty" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" maxlength="500"
                                           placeholder="VD: còn nguyên khay" @bind="row.Note" />
                                </td>
                                <td class="text-right text-muted">
                                    @(row.LastQty.HasValue ? row.LastQty.Value.ToString("N0") : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_saving || _products == null)">
            @(_saving ? "Đang lưu..." : "💾 Lưu kiểm kê")
        </button>
    </div>
</div>

<h4>Lịch sử 30 ngày gần nhất</h4>
@if (_history == null)
{
    <p><em>Đang tải lịch sử...</em></p>
}
else if (_history.Count == 0)
{
    <p class="text-muted">Chưa có dữ liệu kiểm kê nào.</p>
}
else
{
    @foreach (var day in _history)
    {
        <div class="card mb-3" @key="day.Date">
            <div class="card-header py-2">
                <strong>@day.Date.ToString("dddd, dd/MM/yyyy")</strong>
                <span class="text-muted ml-2">(@day.Lines.Count món)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Món</th>
                                <th class="text-right">Còn lại</th>
                                <th class="text-right">Chênh lệch</th>
                                <th>Ghi chú</th>
                                <th>Người nhập</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in day.Lines)
                            {
                                <tr @key="line.ProductId">
                                    <td>@line.ProductName</td>
                                    <td class="text-right"><strong>@line.RemainingQty.ToString("N0")</strong></td>
                                    <td class="text-right">@DiffBadge(line.DiffVsPrevious)</td>
                                    <td><small class="text-muted">@line.Note</small></td>
                                    <td><small class="text-muted">@line.CreatedBy</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private DateTime _date = DateTime.Today;
    private List<ProductModel> _products;
    private List<InventoryRow> _rows = new();
    private List<InventoryHistoryDayModel> _history;
    private bool _saving;
    private bool _saved;
    private string _error;

    private sealed class InventoryRow
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; }
        public int RemainingQty { get; set; }
        public string Note { get; set; }
        public int? LastQty { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await ProductService.GetProductsAsync();
            _products = (all ?? new List<ProductModel>())
                .Where(p => !string.Equals(p.Status, "Discontinued", StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Name)
                .ToList();

            await LoadHistoryAsync();
            BuildRows();
        }
        catch (Exception)
        {
            _error = "Không tải được dữ liệu. Vui lòng thử lại.";
        }
    }

    private async Task LoadHistoryAsync()
    {
        _history = await InventoryService.GetHistoryAsync(30) ?? new List<InventoryHistoryDayModel>();
    }

    private void BuildRows()
    {
        var savedForDate = _history?
            .FirstOrDefault(d => d.Date.Date == _date.Date);

        _rows = (_products ?? new List<ProductModel>()).Select(p =>
        {
            var saved = savedForDate?.Lines.FirstOrDefault(l => l.ProductId == p.Id);

            // Most recent count strictly before the selected date.
            int? lastQty = saved != null
                ? saved.PreviousRemainingQty
                : _history?
                    .SelectMany(d => d.Lines.Select(l => (Day: d.Date.Date, Line: l)))
                    .Where(x => x.Line.ProductId == p.Id && x.Day < _date.Date)
                    .OrderByDescending(x => x.Day)
                    .Select(x => (int?)x.Line.RemainingQty)
                    .FirstOrDefault();

            return new InventoryRow
            {
                ProductId = p.Id,
                ProductName = p.Name,
                RemainingQty = saved?.RemainingQty ?? 0,
                Note = saved?.Note,
                LastQty = lastQty
            };
        }).ToList();
    }

    private async Task OnDateChanged()
    {
        _saved = false;
        BuildRows();
        await Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saved = false;

        if (_rows.Any(r => r.RemainingQty < 0))
        {
            _error = "Số lượng còn lại không được âm.";
            return;
        }

        _saving = true;
        try
        {
            await InventoryService.SaveAsync(new SaveInventoryModel
            {
                Date = _date.Date,
                Lines = _rows.Select(r => new InventoryLineModel
                {
                    ProductId = r.ProductId,
                    ProductName = r.ProductName,
                    RemainingQty = r.RemainingQty,
                    Note = string.IsNullOrWhiteSpace(r.Note) ? null : r.Note.Trim()
                }).ToList()
            });
            await LoadHistoryAsync();
            BuildRows();
            _saved = true;
        }
        catch (Exception)
        {
            _error = "Lưu kiểm kê thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static RenderFragment DiffBadge(int? diff) => builder =>
    {
        if (!diff.HasValue)
        {
            builder.AddContent(0, "—");
            return;
        }

        var css = diff.Value == 0 ? "text-muted" : diff.Value > 0 ? "text-success" : "text-danger";
        var text = diff.Value == 0 ? "±0" : $"{(diff.Value > 0 ? "+" : "")}{diff.Value:N0}";
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, text);
        builder.CloseElement();
    };
}
