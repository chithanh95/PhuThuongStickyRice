@page "/admin/shippers"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject Wave3Service Wave3Service

<h3>Shipper giao hàng</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success">@_message</div>
}

<div class="card mb-3">
    <div class="card-header">Thêm shipper</div>
    <div class="card-body">
        <div class="form-row">
            <div class="col-md-4 mb-2">
                <input class="form-control" placeholder="Tên shipper *" @bind="_name" />
            </div>
            <div class="col-md-4 mb-2">
                <input class="form-control" placeholder="Số điện thoại" @bind="_phone" />
            </div>
            <div class="col-md-4 mb-2">
                <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_saving">Thêm</button>
            </div>
        </div>
    </div>
</div>

@if (_shippers == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_shippers.Count == 0)
{
    <div class="alert alert-info">Chưa có shipper nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr><th>Tên</th><th>SĐT</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _shippers)
                {
                    <tr @key="s.Id">
                        <td><strong>@s.Name</strong></td>
                        <td>@s.Phone</td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge badge-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Tạm nghỉ</span>
                            }
                        </td>
                        <td class="text-right">
                            <button class="btn btn-sm btn-outline-secondary mr-1"
                                    @onclick="() => ToggleActive(s)">
                                @(s.IsActive ? "Tạm nghỉ" : "Kích hoạt")
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteAsync(s)">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ShipperModel> _shippers;
    private string _name;
    private string _phone;
    private string _error;
    private string _message;
    private bool _saving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _shippers = await Wave3Service.GetShippersAsync() ?? new List<ShipperModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách shipper.";
            _shippers = new List<ShipperModel>();
        }
    }

    private async Task CreateAsync()
    {
        _error = null;
        _message = null;
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Vui lòng nhập tên shipper.";
            return;
        }

        _saving = true;
        try
        {
            await Wave3Service.CreateShipperAsync(_name.Trim(), _phone?.Trim());
            _name = null;
            _phone = null;
            _message = "Đã thêm shipper.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleActive(ShipperModel s)
    {
        _error = null;
        try
        {
            await Wave3Service.UpdateShipperAsync(s.Id, s.Name, s.Phone, !s.IsActive);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(ShipperModel s)
    {
        _error = null;
        try
        {
            await Wave3Service.DeleteShipperAsync(s.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
