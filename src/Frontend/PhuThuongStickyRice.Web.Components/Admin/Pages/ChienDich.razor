@page "/admin/chien-dich"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject Wave5Service Wave5Service
@inject IJSRuntime JSRuntime

<h3>🎯 Chiến dịch voucher</h3>
<p class="text-muted">
    Chọn đối tượng → cấu hình giảm giá → hệ thống tạo <strong>một mã voucher riêng cho mỗi SĐT</strong>.
    Gửi hàng loạt cần kênh Zalo OA / SMS (tích hợp sau) — hiện tại sao chép danh sách mã để gửi thủ công.
</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-4">
                <label>Đối tượng</label>
                <select class="form-control" @bind="_audience" @bind:after="LoadAudiencesAsync">
                    <option value="inactive30">Không mua 30+ ngày</option>
                    <option value="tier">Theo hạng thành viên</option>
                    <option value="all">Tất cả khách</option>
                </select>
            </div>
            @if (_audience == "tier")
            {
                <div class="form-group col-md-2">
                    <label>Hạng</label>
                    <select class="form-control" @bind="_tier" @bind:after="LoadAudiencesAsync">
                        <option value="Bạc">Bạc</option>
                        <option value="Vàng">Vàng</option>
                    </select>
                </div>
            }
            <div class="form-group col-md-2">
                <label>Giảm % </label>
                <input type="number" min="1" max="100" class="form-control" @bind="_discountPercent" disabled="@(_discountAmount > 0)" />
            </div>
            <div class="form-group col-md-2">
                <label>Hoặc giảm (₫)</label>
                <input type="number" min="0" step="1000" class="form-control" @bind="_discountAmount" />
            </div>
            <div class="form-group col-md-2">
                <label>Hiệu lực (ngày)</label>
                <input type="number" min="1" max="365" class="form-control" @bind="_validDays" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-4">
                <label>Tiền tố mã</label>
                <input class="form-control text-uppercase" @bind="_prefix" placeholder="VC" maxlength="10" />
            </div>
            <div class="form-group col-md-8 d-flex align-items-end">
                <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@_generating">
                    @(_generating ? "Đang tạo..." : $"Tạo voucher cho {_recipientCount} khách")
                </button>
            </div>
        </div>
    </div>
</div>

@if (_result != null)
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
            <strong>Kết quả: @_result.Count mã đã tạo</strong>
            <button class="btn btn-sm btn-outline-primary" @onclick="CopyAllAsync">📋 Sao chép tất cả</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>SĐT</th>
                            <th>Mã voucher</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _result)
                        {
                            <tr>
                                <td>@v.Phone</td>
                                <td><code>@v.Code</code></td>
                                <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyOneAsync(v.Code)">Sao chép</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private string _audience = "inactive30";
    private string _tier = "Vàng";
    private decimal _discountPercent = 10;
    private decimal _discountAmount;
    private int _validDays = 30;
    private string _prefix = "VC";
    private int _recipientCount;
    private List<GeneratedVoucherModel> _result;
    private bool _generating;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        await LoadAudiencesAsync();
    }

    private async Task LoadAudiencesAsync()
    {
        try
        {
            var audiences = await Wave5Service.GetVoucherAudiencesAsync(_audience == "tier" ? _tier : null);
            _recipientCount = audiences?.FirstOrDefault(x => x.Key == _audience)?.RecipientCount ?? 0;
        }
        catch (Exception ex)
        {
            _error = "Không tải được đối tượng: " + ex.Message;
        }
    }

    private async Task GenerateAsync()
    {
        _error = null;
        _success = null;
        _result = null;
        if (_discountAmount <= 0 && (_discountPercent < 1 || _discountPercent > 100))
        {
            _error = "Vui lòng nhập % giảm giá (1–100) hoặc số tiền giảm.";
            return;
        }

        _generating = true;
        try
        {
            _result = await Wave5Service.GenerateVouchersAsync(
                _audience, _audience == "tier" ? _tier : null,
                _discountAmount > 0 ? 0 : _discountPercent, _discountAmount,
                _validDays, _prefix);
            _success = $"Đã tạo {_result.Count} mã voucher (dùng 1 lần, hết hạn sau {_validDays} ngày).";
        }
        catch (Exception ex)
        {
            _error = "Tạo voucher thất bại: " + ex.Message;
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task CopyOneAsync(string code)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
        }
        catch (Exception)
        {
        }
    }

    private async Task CopyAllAsync()
    {
        if (_result == null)
        {
            return;
        }

        var text = string.Join("\n", _result.Select(x => $"{x.Phone}\t{x.Code}"));
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _success = "Đã sao chép danh sách mã.";
        }
        catch (Exception)
        {
            _error = "Không sao chép được (trình duyệt chặn clipboard).";
        }
    }
}
