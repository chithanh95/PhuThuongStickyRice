@page "/ban-hang"
@layout PhuThuongStickyRice.Web.Components.Core.Layouts.EmptyLayout
@attribute [Authorize(Roles = "Admin,Cashier")]
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using PhuThuongStickyRice.Web.Components.Orders.Models
@inject ShopService ShopService
@inject Wave5Service Wave5Service
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<h3>🧾 Bán hàng tại quầy (POS)</h3>
<p class="text-muted">Chạm để thêm món → nhập SĐT khách (để tích điểm) → thu tiền mặt → đơn hoàn thành ngay, in hóa đơn.</p>

@if (_offlineQueue.Count > 0)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between">
        <div><strong>⚠️ Đang offline</strong> — @_offlineQueue.Count đơn chờ đồng bộ lên server.</div>
        <button class="btn btn-sm btn-warning mt-2 mt-md-0" @onclick="SyncQueueAsync" disabled="@_syncing">
            @(_syncing ? "Đang đồng bộ..." : "🔄 Đồng bộ ngay")
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="row">
    <div class="col-lg-7">
        <h5>Món ăn</h5>
        @if (_products == null)
        {
            <p><em>Đang tải...</em></p>
        }
        else
        {
            <div class="row">
                @foreach (var p in _products)
                {
                    <div class="col-6 col-md-4 mb-2">
                        <button class="btn btn-outline-primary btn-block text-left h-100" @onclick="() => AddProduct(p)">
                            <strong>@p.Name</strong><br />
                            <span class="text-muted">@p.Price.ToString("N0") ₫</span>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
    <div class="col-lg-5">
        <h5>Đơn hiện tại</h5>
        <div class="card">
            <div class="card-body">
                @if (_lines.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có món nào — chạm vào món bên trái để thêm.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var l in _lines)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <strong>@l.ProductName</strong><br />
                                    <small class="text-muted">@l.UnitPrice.ToString("N0") ₫</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQty(l, -1)">−</button>
                                    <span class="mx-2"><strong>@l.Quantity</strong></span>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQty(l, 1)">+</button>
                                    <button class="btn btn-sm btn-link text-danger ml-1" @onclick="() => RemoveLine(l)">✕</button>
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="form-group">
                        <label>SĐT khách <small class="text-muted">(để tích điểm; bỏ trống = khách vãng lai)</small></label>
                        <input class="form-control" @bind="_phone" placeholder="09xxxxxxxx" inputmode="tel" />
                    </div>
                    <div class="form-group">
                        <label>Tên khách</label>
                        <input class="form-control" @bind="_customerName" placeholder="Khách vãng lai" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <strong>Tổng thu:</strong>
                        <strong class="h4 mb-0 text-primary">@_lines.Sum(x => x.UnitPrice * x.Quantity).ToString("N0") ₫</strong>
                    </div>
                    <button class="btn btn-success btn-lg btn-block" @onclick="CheckoutAsync" disabled="@(_busy || _lines.Count == 0)">
                        @(_busy ? "Đang xử lý..." : "💵 Thu tiền & hoàn thành")
                    </button>
                }
            </div>
        </div>
        @if (_lastOrder != null)
        {
            <div class="alert alert-success mt-3">
                ✅ Đã tạo đơn <strong>@_lastOrder.OrderNumber</strong> — @_lastOrder.TotalAmount.ToString("N0") ₫ (đã thu).
                <a class="btn btn-sm btn-outline-primary ml-2" href="@($"orders/print/{_lastOrder.Id}")" target="_blank">🖨 In hóa đơn</a>
            </div>
        }
    </div>
</div>

@code {
    private const string OfflineQueueKey = "pt-pos-offline-queue";

    private List<ShopProductModel> _products;
    private List<PosLine> _lines = new List<PosLine>();
    private string _phone;
    private string _customerName;
    private bool _busy;
    private bool _syncing;
    private string _error;
    private string _success;
    private OrderModel _lastOrder;
    private List<QueuedPosOrder> _offlineQueue = new List<QueuedPosOrder>();

    protected override async Task OnInitializedAsync()
    {
        await LoadQueueAsync();
        try
        {
            var paged = await ShopService.GetProductsAsync();
            _products = paged?.Items?
                .Where(x => x.Status == "Active")
                .OrderBy(x => x.Name)
                .ToList() ?? new List<ShopProductModel>();
        }
        catch (Exception ex)
        {
            _error = "Không tải được món ăn: " + ex.Message;
        }

        // Item 159: có mạng trở lại thì tự thử đồng bộ đơn chờ.
        if (_offlineQueue.Count > 0)
        {
            await SyncQueueAsync();
        }
    }

    private void AddProduct(ShopProductModel p)
    {
        var line = _lines.FirstOrDefault(x => x.ProductId == p.Id);
        if (line == null)
        {
            _lines.Add(new PosLine { ProductId = p.Id, ProductName = p.Name, UnitPrice = p.Price, Quantity = 1 });
        }
        else
        {
            line.Quantity++;
        }

        _success = null;
        _lastOrder = null;
    }

    private void ChangeQty(PosLine line, int delta)
    {
        line.Quantity += delta;
        if (line.Quantity <= 0)
        {
            _lines.Remove(line);
        }
    }

    private void RemoveLine(PosLine line)
    {
        _lines.Remove(line);
    }

    private async Task CheckoutAsync()
    {
        _error = null;
        _success = null;
        _busy = true;
        try
        {
            var input = new PosOrderInput
            {
                CustomerName = string.IsNullOrWhiteSpace(_customerName) ? "Khách vãng lai" : _customerName.Trim(),
                CustomerPhone = _phone?.Trim(),
                Note = "Bán tại quầy (POS)",
                Lines = _lines.Select(x => new PosOrderLineInput
                {
                    ProductId = x.ProductId,
                    Quantity = x.Quantity
                }).ToList()
            };

            _lastOrder = await Wave5Service.CreatePosOrderAsync<OrderModel>(input);
            _success = $"Đã thu {_lastOrder.TotalAmount:N0} ₫ — đơn {_lastOrder.OrderNumber} hoàn thành.";
            _lines.Clear();
            _phone = null;
            _customerName = null;
        }
        catch (Exception ex) when (IsNetworkError(ex))
        {
            // Item 159: mất mạng → lưu đơn vào hàng chờ offline.
            await EnqueueOfflineAsync();
            _error = null;
            _success = $"⚠️ Mất kết nối — đơn đã lưu offline ({_offlineQueue.Count} đơn chờ đồng bộ).";
            _lines.Clear();
            _phone = null;
            _customerName = null;
        }
        catch (Exception ex)
        {
            _error = "Tạo đơn thất bại: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsNetworkError(Exception ex)
    {
        // HttpRequestException (không tới được server) hoặc TaskCanceled do timeout.
        for (var e = ex; e != null; e = e.InnerException)
        {
            if (e is System.Net.Http.HttpRequestException) return true;
        }
        return ex is TaskCanceledException;
    }

    private PosOrderInput BuildInput()
    {
        return new PosOrderInput
        {
            CustomerName = string.IsNullOrWhiteSpace(_customerName) ? "Khách vãng lai" : _customerName.Trim(),
            CustomerPhone = _phone?.Trim(),
            Note = "Bán tại quầy (POS)",
            Lines = _lines.Select(x => new PosOrderLineInput
            {
                ProductId = x.ProductId,
                Quantity = x.Quantity
            }).ToList()
        };
    }

    private async Task EnqueueOfflineAsync()
    {
        _offlineQueue.Add(new QueuedPosOrder
        {
            LocalId = Guid.NewGuid().ToString("N"),
            CreatedAt = DateTime.Now,
            Input = BuildInput()
        });
        await SaveQueueAsync();
    }

    private async Task SyncQueueAsync()
    {
        if (_syncing || _offlineQueue.Count == 0) return;
        _syncing = true;
        _error = null;
        try
        {
            var ok = 0;
            var failed = new List<QueuedPosOrder>();
            foreach (var q in _offlineQueue.ToList())
            {
                try
                {
                    var order = await Wave5Service.CreatePosOrderAsync<OrderModel>(q.Input);
                    ok++;
                    _lastOrder = order;
                }
                catch (Exception ex) when (IsNetworkError(ex))
                {
                    // Vẫn mất mạng — giữ lại toàn bộ phần còn lại.
                    failed.Add(q);
                    failed.AddRange(_offlineQueue.Skip(_offlineQueue.IndexOf(q) + 1));
                    break;
                }
                catch
                {
                    // Lỗi nghiệp vụ — giữ lại đơn này, tiếp tục đơn khác.
                    failed.Add(q);
                }
            }
            _offlineQueue = failed;
            await SaveQueueAsync();
            _success = ok > 0
                ? $"Đã đồng bộ {ok} đơn lên server." + (failed.Count > 0 ? $" Còn {failed.Count} đơn lỗi/chờ." : "")
                : (_offlineQueue.Count > 0 ? "Vẫn chưa có mạng — các đơn tiếp tục chờ." : null);
        }
        finally
        {
            _syncing = false;
        }
    }

    private async Task LoadQueueAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", OfflineQueueKey);
            if (!string.IsNullOrEmpty(json))
            {
                _offlineQueue = System.Text.Json.JsonSerializer.Deserialize<List<QueuedPosOrder>>(json)
                    ?? new List<QueuedPosOrder>();
            }
        }
        catch { _offlineQueue = new List<QueuedPosOrder>(); }
    }

    private async Task SaveQueueAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", OfflineQueueKey,
                System.Text.Json.JsonSerializer.Serialize(_offlineQueue));
        }
        catch { }
    }

    private class PosLine
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; }
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; }
    }

    private class PosOrderInput
    {
        public string CustomerName { get; set; }
        public string CustomerPhone { get; set; }
        public string Note { get; set; }
        public List<PosOrderLineInput> Lines { get; set; } = new List<PosOrderLineInput>();
    }

    private class PosOrderLineInput
    {
        public Guid ProductId { get; set; }
        public int Quantity { get; set; }
    }

    private class QueuedPosOrder
    {
        public string LocalId { get; set; }
        public DateTime CreatedAt { get; set; }
        public PosOrderInput Input { get; set; }
    }
}
