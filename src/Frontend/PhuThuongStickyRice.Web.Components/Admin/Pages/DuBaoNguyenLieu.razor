@page "/admin/du-bao-nguyen-lieu"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject Wave5Service Wave5Service

<h3>📊 Dự báo nguyên liệu</h3>
<p class="text-muted">Ước tính lượng nếp cần chuẩn bị cho sáng mai.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_forecast == null && string.IsNullOrEmpty(_error))
{
    <p><em>Đang tính...</em></p>
}
else if (_forecast != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Sáng @_forecast.Date.ToString("dd/MM/yyyy") (@_forecast.WeekdayName)</h5>
            <div class="display-4 text-success">@_forecast.NepKg.ToString("0.#") <small class="text-muted" style="font-size:1.2rem">kg nếp</small></div>
            <p class="mt-2 mb-1"><strong>Cách tính:</strong></p>
            <p class="text-muted">@_forecast.Heuristic</p>
            <ul class="small text-muted mb-0">
                <li>Trung bình @_forecast.AveragePortions.ToString("0.#") suất/ngày @_forecast.WeekdayName?.ToLower() trong 4 tuần qua.</li>
                <li>Định mức @_forecast.NepPerPortionGrams g nếp/suất (đổi ở <a href="admin/shop-settings">Cài đặt bán hàng</a>).</li>
                <li>Đơn đã hủy không được tính. Ngày lễ/tiệc lớn nên cộng thêm dự phòng.</li>
            </ul>
        </div>
    </div>
}

@code {
    private IngredientForecastModel _forecast;
    private string _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _forecast = await Wave5Service.GetForecastAsync();
        }
        catch (Exception ex)
        {
            _error = "Không tính được dự báo: " + ex.Message;
        }
    }
}
