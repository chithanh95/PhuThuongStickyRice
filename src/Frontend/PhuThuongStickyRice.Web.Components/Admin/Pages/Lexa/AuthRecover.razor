@page "/admin/lexa/auth-recover"

<div style="min-height:100vh;background:#f8f8fb;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div style="width:100%;max-width:420px;">
        <div style="background:#fff;border-radius:8px;box-shadow:0 2px 20px rgba(0,0,0,.08);padding:40px 35px;">
            <div class="text-center mb-4">
                <span style="font-size:36px;">🍚</span>
                <span style="font-size:28px;font-weight:600;color:#2b3a4a;margin-left:8px;">Lexa</span>
            </div>
            <h5 class="text-center">Reset Password</h5>
            <p class="text-center text-muted small mb-4">Enter your email to reset password.</p>
            <div class="form-group">
                <label>Email</label>
                <input type="email" class="form-control" @bind="_email" placeholder="Enter email" />
            </div>
            <button class="btn btn-primary btn-block" style="background:#7a6fbe;border-color:#7a6fbe;" @onclick="Send">Send Reset Link</button>
            @if (_message != null)
            {
                <div class="alert alert-info mt-3 py-2 mb-0">@_message</div>
            }
            <div class="text-center mt-3">
                <a href="/admin/lexa/auth-login" class="text-muted small">← Back to login</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string _email, _message;
    private void Send() => _message = "Đây là trang demo.";
}
