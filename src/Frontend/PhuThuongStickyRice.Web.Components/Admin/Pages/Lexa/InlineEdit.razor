@* Component sửa inline kiểu Xeditable *@

@if (!_editing)
{
    <span class="lexa-xedit" @onclick="StartEdit" title="Bấm để sửa">
        @if (string.IsNullOrWhiteSpace(Value))
        {
            @if (Required)
            {
                <em class="lexa-xedit-empty">Empty</em>
            }
            else
            {
                <em class="text-muted">@(Placeholder ?? "Trống")</em>
            }
        }
        else
        {
            @Value
        }
    </span>
}
else
{
    <span class="d-inline-flex align-items-center" style="gap:4px;">
        @if (Multiline)
        {
            <textarea class="form-control form-control-sm" rows="2" @bind="_draftValue" @onkeydown="OnKeyDown" style="min-width:200px;"></textarea>
        }
        else
        {
            <input type="@InputType" class="form-control form-control-sm" @bind="_draftValue" @bind:event="oninput" @onkeydown="OnKeyDown" style="min-width:150px;" />
        }
        <button type="button" class="btn btn-sm btn-success" @onclick="Confirm" title="Lưu">✓</button>
        <button type="button" class="btn btn-sm btn-danger" @onclick="Cancel" title="Hủy">✕</button>
    </span>
}

<style>
    .lexa-xedit { color: #7a6fbe; border-bottom: 1px dashed #7a6fbe; cursor: pointer; }
    .lexa-xedit:hover { color: #5a4fae; background: #f0efff; }
    html.dark .lexa-xedit:hover { background: #2c2c4e; }
    .lexa-xedit-empty { color: #f46a6a; border-bottom: 1px dashed #f46a6a; font-style: italic; }
</style>

@code {
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; }
    [Parameter] public string InputType { get; set; } = "text";
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public bool Required { get; set; }

    private bool _editing;
    private string _draftValue;

    private void StartEdit()
    {
        _draftValue = Value;
        _editing = true;
    }

    private async Task Confirm()
    {
        _editing = false;
        await ValueChanged.InvokeAsync(_draftValue);
    }

    private void Cancel()
    {
        _editing = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !Multiline) await Confirm();
        else if (e.Key == "Escape") Cancel();
    }
}
