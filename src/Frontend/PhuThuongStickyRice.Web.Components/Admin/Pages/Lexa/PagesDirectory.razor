@page "/admin/lexa/pages-directory"
@attribute [Authorize(Roles = "Admin,Cashier,Kitchen")]

<div class="lx-page-head">
    <h4 class="lx-page-title">Danh bạ</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/admin">Lexa</a></li>
        <li>Extra Pages</li>
        <li class="current">Directory</li>
    </ol>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <input class="form-control" @bind="_search" @bind:event="oninput" placeholder="Tìm nhân viên..." />
    </div>
</div>

<div class="row">
    @foreach (var p in Filtered)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card">
                <div class="card-body text-center">
                    <div class="lexa-avatar-lg mb-3" style="background:@p.Color;">@p.Name.Substring(0, 1)</div>
                    <h5 class="mb-1">@p.Name</h5>
                    <p class="text-muted small mb-2">@p.Role</p>
                    <p class="mb-1 small">📞 @p.Phone</p>
                    <p class="mb-3 small text-muted">✉️ @p.Email</p>
                    <div style="display:flex;gap:8px;justify-content:center;">
                        <button class="btn btn-primary btn-sm">Nhắn tin</button>
                        <button class="btn btn-secondary btn-sm">Hồ sơ</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Filtered.Any())
    {
        <div class="col-12"><div class="alert alert-info">Không tìm thấy nhân viên.</div></div>
    }
</div>

<style>
    .lexa-avatar-lg { width: 80px; height: 80px; border-radius: 50%; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 700; }
</style>

@code {
    private string _search = "";
    private List<Person> _people = new()
    {
        new("Minh Anh", "Thu ngân", "0901111111", "minhanh@phuthuong.vn", "#7a6fbe"),
        new("Thu Hằng", "Bếp trưởng", "0902222222", "thuhang@phuthuong.vn", "#3ac9d6"),
        new("Đức Anh", "Bếp phó", "0903333333", "ducanh@phuthuong.vn", "#f5b225"),
        new("Lan Phương", "Marketing", "0904444444", "lanphuong@phuthuong.vn", "#ec536c"),
        new("Hoàng Nam", "Giao nhận", "0905555555", "hoangnam@phuthuong.vn", "#29bbe3"),
        new("Thu Thảo", "Kế toán", "0906666666", "thuthao@phuthuong.vn", "#6a5fae"),
    };
    private IEnumerable<Person> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _people
        : _people.Where(p => p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
    private record Person(string Name, string Role, string Phone, string Email, string Color);
}
