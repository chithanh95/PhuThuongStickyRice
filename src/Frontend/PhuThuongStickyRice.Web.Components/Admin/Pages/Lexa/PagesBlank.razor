@page "/admin/lexa/pages-blank"
@attribute [Authorize(Roles = "Admin,Cashier,Kitchen")]

<div class="lx-page-head">
    <h4 class="lx-page-title">Trang trống</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/admin">Lexa</a></li>
        <li>Extra Pages</li>
        <li class="current">Blank</li>
    </ol>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center py-5">
                <div style="font-size:64px;">📄</div>
                <h4 class="mt-3">Trang trống mẫu</h4>
                <p class="text-muted">Dùng làm điểm bắt đầu cho trang mới.<br />Thêm nội dung của bạn vào đây.</p>
                <button class="btn btn-primary">Bắt đầu</button>
            </div>
        </div>
    </div>
</div>
