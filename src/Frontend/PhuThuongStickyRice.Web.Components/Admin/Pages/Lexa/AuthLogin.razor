@page "/admin/lexa/auth-login"

<div style="min-height:100vh;background:#f8f8fb;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div style="width:100%;max-width:420px;">
        <div style="background:#fff;border-radius:8px;box-shadow:0 2px 20px rgba(0,0,0,.08);padding:40px 35px;">
            <div class="text-center mb-4">
                <span style="font-size:36px;">🍚</span>
                <span style="font-size:28px;font-weight:600;color:#2b3a4a;margin-left:8px;">Lexa</span>
            </div>
            <h5 class="text-center">Welcome Back!</h5>
            <p class="text-center text-muted small mb-4">Sign in to continue to Lexa.</p>
            @if (_error != null)
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
            <div class="form-group">
                <label>Username</label>
                <input class="form-control" @bind="_user" placeholder="Enter username" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" class="form-control" @bind="_pass" placeholder="Enter password" />
            </div>
            <div class="form-group row align-items-center">
                <div class="col-6">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="rm" @bind="_remember" />
                        <label class="custom-control-label" for="rm">Remember me</label>
                    </div>
                </div>
                <div class="col-6 text-right">
                    <button class="btn btn-primary" style="background:#7a6fbe;border-color:#7a6fbe;" @onclick="Login">Log In</button>
                </div>
            </div>
            <div class="text-center mt-3">
                <a href="/admin/lexa/auth-recover" class="text-muted small">🔒 Forgot your password?</a>
            </div>
        </div>
        <p class="text-center text-muted small mt-4">Don't have an account? <a href="/admin/lexa/auth-register" style="color:#7a6fbe;">Signup Now</a></p>
        <p class="text-center text-muted small">© 2026 Lexa - Crafted with ❤️ by Themesbrand.</p>
    </div>
</div>

@code {
    private string _user, _pass, _error;
    private bool _remember;
    private void Login()
    {
        if (string.IsNullOrWhiteSpace(_user) || string.IsNullOrWhiteSpace(_pass))
            _error = "Vui lòng nhập đầy đủ thông tin.";
        else
            _error = "Đây là trang demo, không đăng nhập thật.";
    }
}
