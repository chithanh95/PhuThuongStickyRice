@page "/admin/lexa/auth-lock"

<div style="min-height:100vh;background:#f8f8fb;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div style="width:100%;max-width:420px;">
        <div style="background:#fff;border-radius:8px;box-shadow:0 2px 20px rgba(0,0,0,.08);padding:40px 35px;text-align:center;">
            <div class="lexa-avatar-lg mb-3" style="background:#7a6fbe;">A</div>
            <h5>Admin</h5>
            <p class="text-muted small mb-4">Enter your password to unlock the screen!</p>
            <div class="form-group text-left">
                <label>Password</label>
                <input type="password" class="form-control" @bind="_pass" placeholder="Enter password" />
            </div>
            <button class="btn btn-primary btn-block" style="background:#7a6fbe;border-color:#7a6fbe;" @onclick="Unlock">Unlock</button>
            @if (_msg != null)
            {
                <div class="alert alert-info mt-3 py-2 mb-0">@_msg</div>
            }
            <div class="mt-3">
                <a href="/admin/lexa/auth-login" class="text-muted small">Not you? Sign in as different user</a>
            </div>
        </div>
    </div>
</div>

<style>
    .lexa-avatar-lg { width: 80px; height: 80px; border-radius: 50%; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 700; }
</style>

@code {
    private string _pass, _msg;
    private void Unlock() => _msg = "Đây là trang demo.";
}
