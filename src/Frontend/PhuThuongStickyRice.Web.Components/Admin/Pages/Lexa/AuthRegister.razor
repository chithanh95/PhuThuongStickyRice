@page "/admin/lexa/auth-register"

<div style="min-height:100vh;background:#f8f8fb;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div style="width:100%;max-width:420px;">
        <div style="background:#fff;border-radius:8px;box-shadow:0 2px 20px rgba(0,0,0,.08);padding:40px 35px;">
            <div class="text-center mb-4">
                <span style="font-size:36px;">🍚</span>
                <span style="font-size:28px;font-weight:600;color:#2b3a4a;margin-left:8px;">Lexa</span>
            </div>
            <h5 class="text-center">Create Account</h5>
            <p class="text-center text-muted small mb-4">Get your free Lexa account now.</p>
            <div class="form-group">
                <label>Username</label>
                <input class="form-control" @bind="_user" placeholder="Enter username" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" class="form-control" @bind="_email" placeholder="Enter email" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" class="form-control" @bind="_pass" placeholder="Enter password" />
            </div>
            <button class="btn btn-primary btn-block" style="background:#7a6fbe;border-color:#7a6fbe;" @onclick="Register">Register</button>
            @if (_msg != null)
            {
                <div class="alert alert-success mt-3 py-2 mb-0">@_msg</div>
            }
        </div>
        <p class="text-center text-muted small mt-4">Already have an account? <a href="/admin/lexa/auth-login" style="color:#7a6fbe;">Login</a></p>
    </div>
</div>

@code {
    private string _user, _email, _pass, _msg;
    private void Register() => _msg = "Đây là trang demo.";
}
