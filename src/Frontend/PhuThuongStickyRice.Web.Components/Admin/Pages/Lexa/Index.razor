@page "/admin/lexa"
@attribute [Authorize(Roles = "Admin,Cashier,Kitchen")]

<div class="lx-page-head">
    <h4 class="lx-page-title">Lexa Template Demos</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/admin">Lexa</a></li>
        <li class="current">Demos</li>
    </ol>
</div>

<div class="alert alert-info">
    <strong>Thư viện mẫu Lexa</strong> — các trang demo đã clone từ template Lexa. Sau này sẽ apply từng mẫu vào các trang thật của web.
</div>

@foreach (var g in _groups)
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@g.Title</h4>
            <div class="row">
                @foreach (var p in g.Pages)
                {
                    <div class="col-md-4 col-xl-3 mb-2">
                        <a href="@p.Url" class="btn btn-outline-primary btn-block text-left">
                            <span class="mr-1">@p.Icon</span> @p.Name
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Group> _groups = new()
    {
        new("📊 Dashboard", new()
        {
            new("Dashboard demo", "/admin/lexa/dashboard", "📊"),
