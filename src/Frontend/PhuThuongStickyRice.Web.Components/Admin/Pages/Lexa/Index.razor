            new("Cards", "/admin/lexa/ui-cards", "🃏"),
            new("Modals & Sweet Alert", "/admin/lexa/ui-modals", "💬"),
            new("Tabs & Accordions", "/admin/lexa/ui-tabs", "📑"),
            new("General (Alerts, Badges)", "/admin/lexa/ui-general", "🎨"),
