        new("fa-solid fa-credit-card", "Thẻ"), new("fa-solid fa-envelope", "Thư"), new("fa-solid fa-bell", "Chuông"),
        new("fa-solid fa-lock", "Khóa"), new("fa-solid fa-key", "Chìa khóa"), new("fa-solid fa-star", "Sao"),
        new("fa-solid fa-heart", "Tim"), new("fa-solid fa-thumbs-up", "Thích"), new("fa-solid fa-comment", "Bình luận"),
        new("fa-solid fa-image", "Ảnh"), new("fa-solid fa-video", "Video"), new("fa-solid fa-music", "Nhạc"),
        new("fa-solid fa-location-dot", "Vị trí"), new("fa-solid fa-phone", "Điện thoại"), new("fa-solid fa-print", "In"),
        new("fa-solid fa-share", "Chia sẻ"), new("fa-solid fa-cloud-arrow-down", "Tải xuống"), new("fa-solid fa-cloud-arrow-up", "Tải lên"),
        new("fa-solid fa-file", "File"), new("fa-solid fa-folder", "Thư mục"), new("fa-solid fa-tag", "Nhãn"),
