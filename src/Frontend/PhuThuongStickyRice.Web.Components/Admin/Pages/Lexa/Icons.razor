        new("fa-solid fa-users", "Nhóm"), new("fa-solid fa-plus", "Thêm"), new("fa-solid fa-minus", "Trừ"),
        new("fa-solid fa-check", "Đúng"), new("fa-solid fa-xmark", "Đóng"), new("fa-solid fa-trash", "Xóa"),
        new("fa-solid fa-pencil", "Sửa"), new("fa-solid fa-eye", "Xem"), new("fa-solid fa-magnifying-glass", "Tìm kiếm"),
        new("fa-solid fa-gear", "Cài đặt"), new("fa-solid fa-clock", "Đồng hồ"), new("fa-solid fa-calendar", "Lịch"),
