@* Trang báo cáo doanh thu (admin): chọn khoảng ngày → xuất Excel 2 sheet
   (Tổng hợp theo ngày + Chi tiết đơn). Đơn đã hủy không tính vào doanh thu.
   Có chế độ "So sánh cùng kỳ" (doanh thu/số đơn/TB đơn + top món, 2 kỳ đặt
   cạnh nhau với biểu đồ cột đôi) và bảng lý do hủy đơn (item 233) luôn đồng
   bộ theo khoảng thời gian đang chọn ở trên. *@
@page "/admin/bao-cao"
@attribute [Authorize(Roles = "Admin")]
@using PhuThuongStickyRice.Web.Components.Orders.Services
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using static PhuThuongStickyRice.Web.Components.Core.Helpers.PriceFormatter;
@inject OrderService OrderService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

<div class="lx-page-head">
    <h4 class="lx-page-title">Báo cáo doanh thu</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Báo cáo doanh thu</li>
    </ol>
</div>
<p class="text-muted">
    Xuất file Excel gồm 2 sheet: <strong>Tổng hợp</strong> (doanh thu, số đơn, giá trị trung bình theo ngày)
    và <strong>Chi tiết đơn</strong>. Đơn đã hủy không tính vào doanh thu.
</p>

<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">Khoảng thời gian</h4>
        <div class="form-row align-items-end">
            <div class="col-md-3 col-6">
                @* uiux-a11y 2026-10-19: gắn label với input qua for/id để screen reader đọc đúng *@
                <label class="mb-1" for="bc-from-date"><small class="text-muted">Từ ngày</small></label>
                <input type="date" id="bc-from-date" class="form-control" @bind="_fromDate" />
            </div>
            <div class="col-md-3 col-6">
                <label class="mb-1" for="bc-to-date"><small class="text-muted">Đến ngày</small></label>
                <input type="date" id="bc-to-date" class="form-control" @bind="_toDate" />
            </div>
            <div class="col-md-6 col-12 text-right mt-2 mt-md-0">
                <button class="btn btn-outline-secondary mr-2" @onclick="SetThisMonth">Tháng này</button>
                <button class="btn btn-outline-secondary mr-2" @onclick="SetLast7Days">7 ngày qua</button>
                <button class="btn btn-outline-info mr-2" @onclick="ToggleCompare">
                    @(_compareMode ? "Ẩn so sánh" : "⚖️ So sánh cùng kỳ")
                </button>
                <button class="btn btn-primary" @onclick="ExportExcel" disabled="@_exporting">
                    @(_exporting ? "Đang xuất..." : "⬇ Xuất Excel")
                </button>
            </div>
        </div>
    </div>
</div>

@if (_compareMode)
{
    <div class="card mb-3 border-info">
        <div class="card-body">
            <h4 class="card-title">⚖️ So sánh cùng kỳ</h4>
            <p class="card-title-desc">So sánh doanh thu, số đơn, giá trị TB/đơn và top món giữa 2 kỳ. Đơn đã hủy không tính.</p>
            <div class="mb-3">
                <button class="btn btn-outline-secondary btn-sm mr-2 mb-1" @onclick="CompareThisMonth" disabled="@_comparing">Tháng này vs tháng trước</button>
                <button class="btn btn-outline-secondary btn-sm mr-2 mb-1" @onclick="CompareLast7Days" disabled="@_comparing">7 ngày qua vs 7 ngày trước đó</button>
                <button class="btn btn-outline-secondary btn-sm mr-2 mb-1" @onclick="CompareThisWeek" disabled="@_comparing">Tuần này vs tuần trước</button>
            </div>
            @if (!string.IsNullOrEmpty(_compareError))
            {
                <div class="alert alert-danger">@_compareError</div>
            }
            @if (_comparing)
            {
                <p><em>Đang tải số liệu...</em></p>
            }
            else if (_current != null && _previous != null)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h4 class="card-title text-success">Kỳ hiện tại <small class="text-muted">— @_currentLabel</small></h4>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="h5 mb-0 text-success">@FormatPrice(_current.TotalRevenue)</div>
                                        <small class="text-muted">Doanh thu</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="h5 mb-0">@_current.OrderCount</div>
                                        <small class="text-muted">Số đơn</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="h5 mb-0">@FormatPrice(_current.AvgOrderValue)</div>
                                        <small class="text-muted">TB/đơn</small>
                                    </div>
                                </div>
                                <hr />
                                <strong>Top món:</strong>
                                @if (_current.TopProducts.Count == 0)
                                {
                                    <p class="text-muted mb-0"><small>Chưa có dữ liệu.</small></p>
                                }
                                else
                                {
                                    <ol class="mb-0 pl-3">
                                        @foreach (var p in _current.TopProducts)
                                        {
                                            <li><small>@p.ProductName — <strong>@p.Quantity</strong> suất (@FormatPrice(p.Revenue))</small></li>
                                        }
                                    </ol>
                                    <p class="text-muted mt-1 mb-0"><small><em>Ghi chú: doanh thu theo món tính theo đơn giá trên đơn (chưa trừ giảm giá/khuyến mãi), nên cộng lại có thể cao hơn số "Doanh thu" ở đầu trang.</em></small></p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h4 class="card-title text-secondary">Kỳ so sánh <small class="text-muted">— @_previousLabel</small></h4>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="h5 mb-0 text-success">@FormatPrice(_previous.TotalRevenue)</div>
                                        <small class="text-muted">Doanh thu</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="h5 mb-0">@_previous.OrderCount</div>
                                        <small class="text-muted">Số đơn</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="h5 mb-0">@FormatPrice(_previous.AvgOrderValue)</div>
                                        <small class="text-muted">TB/đơn</small>
                                    </div>
                                </div>
                                <hr />
                                <strong>Top món:</strong>
                                @if (_previous.TopProducts.Count == 0)
                                {
                                    <p class="text-muted mb-0"><small>Chưa có dữ liệu.</small></p>
                                }
                                else
                                {
                                    <ol class="mb-0 pl-3">
                                        @foreach (var p in _previous.TopProducts)
                                        {
                                            <li><small>@p.ProductName — <strong>@p.Quantity</strong> suất (@FormatPrice(p.Revenue))</small></li>
                                        }
                                    </ol>
                                    <p class="text-muted mt-1 mb-0"><small><em>Ghi chú: doanh thu theo món tính theo đơn giá trên đơn (chưa trừ giảm giá/khuyến mãi), nên cộng lại có thể cao hơn số "Doanh thu" ở đầu trang.</em></small></p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">📊 Chênh lệch (kỳ hiện tại so với kỳ so sánh)</h4>
                        @{
                            // Chuẩn hóa chiều cao cột theo giá trị lớn nhất của từng chỉ số
                            // (2 kỳ nhìn tương đối với nhau, không theo giá trị tuyệt đối).
                            // Cột có giá trị 0 vẫn vẽ 4px để không "biến mất" khỏi biểu đồ.
                            var maxRevenueForCompare = Math.Max(_current.TotalRevenue, _previous.TotalRevenue);
                            var maxOrderCountForCompare = Math.Max((decimal)_current.OrderCount, (decimal)_previous.OrderCount);
                            var maxAvgOrderValueForCompare = Math.Max(_current.AvgOrderValue, _previous.AvgOrderValue);
                        }
                        <div class="lexa-chart">
                            <div class="lexa-col-wrap">
                                <div class="bc-compare-pair">
                                    <div class="lexa-col lexa-col-current" style="height:@((maxRevenueForCompare > 0 ? (double)(_current.TotalRevenue / maxRevenueForCompare) * 150 : 4).ToString("0"))px;" title="Kỳ này: @FormatPrice(_current.TotalRevenue)"></div>
                                    <div class="lexa-col lexa-col-compare" style="height:@((maxRevenueForCompare > 0 ? (double)(_previous.TotalRevenue / maxRevenueForCompare) * 150 : 4).ToString("0"))px;" title="Kỳ trước: @FormatPrice(_previous.TotalRevenue)"></div>
                                </div>
                                <small>Doanh thu</small>
                            </div>
                            <div class="lexa-col-wrap">
                                <div class="bc-compare-pair">
                                    <div class="lexa-col lexa-col-current" style="height:@((maxOrderCountForCompare > 0 ? (double)((decimal)_current.OrderCount / maxOrderCountForCompare) * 150 : 4).ToString("0"))px;" title="Kỳ này: @_current.OrderCount đơn"></div>
                                    <div class="lexa-col lexa-col-compare" style="height:@((maxOrderCountForCompare > 0 ? (double)((decimal)_previous.OrderCount / maxOrderCountForCompare) * 150 : 4).ToString("0"))px;" title="Kỳ trước: @_previous.OrderCount đơn"></div>
                                </div>
                                <small>Số đơn</small>
                            </div>
                            <div class="lexa-col-wrap">
                                <div class="bc-compare-pair">
                                    <div class="lexa-col lexa-col-current" style="height:@((maxAvgOrderValueForCompare > 0 ? (double)(_current.AvgOrderValue / maxAvgOrderValueForCompare) * 150 : 4).ToString("0"))px;" title="Kỳ này: @FormatPrice(_current.AvgOrderValue)"></div>
                                    <div class="lexa-col lexa-col-compare" style="height:@((maxAvgOrderValueForCompare > 0 ? (double)(_previous.AvgOrderValue / maxAvgOrderValueForCompare) * 150 : 4).ToString("0"))px;" title="Kỳ trước: @FormatPrice(_previous.AvgOrderValue)"></div>
                                </div>
                                <small>TB/đơn</small>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span class="lexa-dot lexa-dot-primary"></span> Kỳ hiện tại
                            <span class="lexa-dot lexa-dot-compare ml-3"></span> Kỳ so sánh
                        </div>
                        <div class="row mt-3 text-center">
                            <div class="col-4">
                                <div class="h5 mb-0 @ChangeClass(_current.TotalRevenue, _previous.TotalRevenue)">@ChangeText(_current.TotalRevenue, _previous.TotalRevenue)</div>
                                <small class="text-muted">Doanh thu</small>
                            </div>
                            <div class="col-4">
                                <div class="h5 mb-0 @ChangeClass((decimal)_current.OrderCount, (decimal)_previous.OrderCount)">@ChangeText((decimal)_current.OrderCount, (decimal)_previous.OrderCount)</div>
                                <small class="text-muted">Số đơn</small>
                            </div>
                            <div class="col-4">
                                <div class="h5 mb-0 @ChangeClass(_current.AvgOrderValue, _previous.AvgOrderValue)">@ChangeText(_current.AvgOrderValue, _previous.AvgOrderValue)</div>
                                <small class="text-muted">TB/đơn</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* Item 233: báo cáo lý do hủy đơn theo khoảng thời gian đã chọn. *@
<div class="card mt-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="card-title mb-0">🚫 Lý do hủy đơn</h4>
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadCancelReport" disabled="@_loadingCancelReport">
                @(_loadingCancelReport ? "Đang tải..." : "↻ Tải lại")
            </button>
        </div>
        <p class="card-title-desc">Biết chính xác vì sao mất đơn để sửa đúng chỗ. Theo khoảng thời gian đã chọn ở trên.</p>
        @if (_loadingCancelReport)
        {
            <p><em>Đang tải...</em></p>
        }
        else if (_cancelReport == null || _cancelReport.Count == 0)
        {
            <p class="text-muted mb-0">Không có đơn hủy nào trong kỳ này. 🎉</p>
        }
        else
        {
            var cancelTotal = _cancelReport.Sum(x => x.Count);
            var cancelMax = _cancelReport.Max(x => x.Count);
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Lý do</th>
                            <th scope="col" class="text-right bc-col-count">Số đơn</th>
                            <th scope="col" class="bc-col-ratio">Tỉ lệ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _cancelReport)
                        {
                            <tr @key="row.Reason">
                                <td>@row.Reason</td>
                                <td class="text-right font-weight-bold">@row.Count</td>
                                <td>
                                    <div class="progress bc-cancel-bar">
                                        <div class="progress-bar bg-warning" role="progressbar"
                                             style="width: @((cancelMax > 0 ? (double)row.Count / cancelMax * 100 : 0).ToString("0"))%;"
                                             aria-valuenow="@row.Count" aria-valuemin="0" aria-valuemax="@cancelMax">
                                            @((cancelTotal > 0 ? (double)row.Count / cancelTotal * 100 : 0).ToString("0"))%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mb-0 mt-2">Tổng: <strong>@cancelTotal</strong> đơn hủy trong kỳ.</p>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@code {
    // codequality-team 2026-10-20 run-0245 Agent2-CleanCode: FormatPrice dùng chung từ Core.Helpers.PriceFormatter — xóa bản copy local trong file này.
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _exporting;
    private string _error;

    // Item 233: báo cáo lý do hủy đơn.
    private List<PhuThuongStickyRice.Web.Components.Orders.Models.CancelReasonReportModel> _cancelReport;
    private bool _loadingCancelReport;

    // Item 169: compare mode.
    private bool _compareMode;
    private bool _comparing;
    private string _compareError;
    private RevenueSummaryModel _current;
    private RevenueSummaryModel _previous;
    private string _currentLabel;
    private string _previousLabel;

    protected override void OnInitialized()
    {
        SetThisMonth();
    }

    // perf-hunt 2026-10-20: bỏ OnAfterRenderAsync(firstRender) gọi
    // LoadCancelReport() lần 2 — SetThisMonth() ở trên đã load đúng 1 lần
    // lúc init (các nút "Tháng này"/"7 ngày" cũng gọi lại khi đổi khoảng
    // ngày). Trước đây mỗi lần mở trang bắn 2 request HTTP giống hệt nhau
    // tới GetCancelReasonReportAsync cùng khoảng ngày.

    /// <summary>
    /// Item 233: tải báo cáo hủy đơn theo khoảng thời gian đang chọn.
    /// </summary>
    private async Task LoadCancelReport()
    {
        _loadingCancelReport = true;
        try
        {
            _cancelReport = await OrderService.GetCancelReasonReportAsync(_fromDate, _toDate);
        }
        catch
        {
            _cancelReport = new List<PhuThuongStickyRice.Web.Components.Orders.Models.CancelReasonReportModel>();
        }
        finally
        {
            _loadingCancelReport = false;
            StateHasChanged();
        }
    }

    private void SetThisMonth()
    {
        var today = DateTime.Today;
        _fromDate = new DateTime(today.Year, today.Month, 1);
        _toDate = today;
        // Báo cáo lý do hủy (item 233) phải luôn đồng bộ khoảng ngày đang
        // chọn nên tải lại ở đây, giống 2 nút khoảng ngày còn lại.
        _ = LoadCancelReport();
    }

    private void SetLast7Days()
    {
        _toDate = DateTime.Today;
        _fromDate = DateTime.Today.AddDays(-6);
        _ = LoadCancelReport();
    }

    private void ToggleCompare()
    {
        _compareMode = !_compareMode;
        _compareError = null;
        // Bật lần đầu thì tự tải so sánh mặc định "tháng này vs tháng trước"
        // để màn hình không trống rỗng.
        if (_compareMode && _current == null)
        {
            _ = CompareThisMonth();
        }
    }

    /// <summary>Item 169: this month-to-date vs the same days of last month.</summary>
    private async Task CompareThisMonth()
    {
        var today = DateTime.Today;
        var curFrom = new DateTime(today.Year, today.Month, 1);
        var prevMonth = curFrom.AddMonths(-1);
        var days = (today - curFrom).Days;
        // Kỳ trước lấy đúng số ngày đã qua của tháng này; Math.Min để không
        // vượt quá số ngày thực của tháng trước (vd so sánh ngày 31/3 → kỳ
        // trước là 1–28/2, tránh tạo ngày 29–31/2 không tồn tại).
        var prevFrom = prevMonth;
        var prevTo = prevMonth.AddDays(Math.Min(days, DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month) - 1));
        await RunCompare(curFrom, today, prevFrom, prevTo,
            $"{curFrom:dd/MM}–{today:dd/MM}",
            $"{prevFrom:dd/MM}–{prevTo:dd/MM}");
    }

    /// <summary>Item 169: last 7 days vs the 7 days before that.</summary>
    private async Task CompareLast7Days()
    {
        var today = DateTime.Today;
        await RunCompare(today.AddDays(-6), today, today.AddDays(-13), today.AddDays(-7),
            $"{today.AddDays(-6):dd/MM}–{today:dd/MM}",
            $"{today.AddDays(-13):dd/MM}–{today.AddDays(-7):dd/MM}");
    }

    /// <summary>Item 169: this week (Mon–today) vs the same weekdays last week.</summary>
    private async Task CompareThisWeek()
    {
        var today = DateTime.Today;
        // Tìm thứ Hai đầu tuần: DayOfWeek enum coi Chủ nhật = 0 nên phải
        // dịch +6 trước khi mod 7 (tuần Việt Nam bắt đầu từ thứ Hai).
        var monday = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        var days = (today - monday).Days;
        var prevMonday = monday.AddDays(-7);
        await RunCompare(monday, today, prevMonday, prevMonday.AddDays(days),
            $"{monday:dd/MM}–{today:dd/MM}",
            $"{prevMonday:dd/MM}–{prevMonday.AddDays(days):dd/MM}");
    }

    private async Task RunCompare(DateTime curFrom, DateTime curTo,
        DateTime prevFrom, DateTime prevTo, string curLabel, string prevLabel)
    {
        // Guard cứng chống race: bấm nhanh 2 nút khác nhau khi request đầu chưa về
        // sẽ làm _current/_previous/_currentLabel/_previousLabel lẫn của 2 kỳ.
        if (_comparing) return;
        _compareError = null;
        _comparing = true;
        _current = null;
        _previous = null;
        try
        {
            _current = await OrderService.GetRevenueSummaryAsync(curFrom, curTo);
            _previous = await OrderService.GetRevenueSummaryAsync(prevFrom, prevTo);
            _currentLabel = curLabel;
            _previousLabel = prevLabel;
        }
        catch (Exception ex)
        {
            _compareError = "Tải số liệu thất bại: " + ex.Message;
        }
        finally
        {
            _comparing = false;
        }
    }

    private static decimal ChangePct(decimal current, decimal previous)
    {
        // Kỳ so sánh không có doanh thu (previous = 0) mà kỳ này có → coi như
        // tăng 100% để tránh lỗi chia 0 và vẫn hiện được màu xanh.
        if (previous == 0)
        {
            return current > 0 ? 100 : 0;
        }

        return (current - previous) / previous * 100;
    }

    private static string ChangeText(decimal current, decimal previous)
    {
        var pct = ChangePct(current, previous);
        // Giữ dấu + cho số dương để dễ đọc ("+12,5%" thay vì "12,5%").
        var sign = pct > 0 ? "+" : "";
        return $"{sign}{pct:0.0}%";
    }

    private static string ChangeClass(decimal current, decimal previous)
    {
        var pct = ChangePct(current, previous);
        return pct > 0 ? "text-success" : pct < 0 ? "text-danger" : "text-muted";
    }

    private async Task ExportExcel()
    {
        _error = null;
        _exporting = true;
        try
        {
            // Validate khoảng ngày trước khi xuất để file không rỗng/khó hiểu.
            if (_fromDate > _toDate)
            {
                _error = "Từ ngày phải trước hoặc bằng đến ngày.";
                return;
            }

            var token = await OrderService.GetAccessToken();
            var url = OrderService.GetExportRevenueUrl(_fromDate, _toDate);
            var from = (_fromDate ?? DateTime.Today).ToString("yyyy-MM-dd");
            var to = (_toDate ?? DateTime.Today).ToString("yyyy-MM-dd");
            // Tải file qua JS interop kèm access token (API export yêu cầu
            // quyền Admin, không cho link trực tiếp vào href).
            await JSRuntime.InvokeVoidAsync("interop.downloadFile", url, token, $"bao-cao-doanh-thu-{from}_{to}.xlsx");
        }
        catch (Exception ex)
        {
            _error = "Xuất file thất bại: " + ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }
}
