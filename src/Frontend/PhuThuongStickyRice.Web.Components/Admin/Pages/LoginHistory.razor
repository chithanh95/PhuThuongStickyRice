@page "/admin/lich-su-dang-nhap"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject Wave3Service Wave3Service

<h3>Lịch sử đăng nhập</h3>
<p class="text-muted">Mọi lần đăng nhập (thành công / thất bại) đều được ghi lại.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_paged == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_paged.Items.Count == 0)
{
    <div class="alert alert-info">Chưa có lịch sử đăng nhập.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr><th>Thời gian</th><th>Tài khoản</th><th>IP</th><th>Kết quả</th><th>Lý do</th></tr>
            </thead>
            <tbody>
                @foreach (var log in _paged.Items)
                {
                    <tr @key="log.Id">
                        <td><small>@log.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</small></td>
                        <td>@log.UserName</td>
                        <td><code>@log.IpAddress</code></td>
                        <td>
                            @if (log.Success)
                            {
                                <span class="badge badge-success">Thành công</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Thất bại</span>
                            }
                        </td>
                        <td><small class="text-muted">@log.FailureReason</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <span>Tổng: @_paged.TotalCount lượt</span>
        <div>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="() => LoadAsync(_page - 1)">Trước</button>
            <span class="mx-2">Trang @_page</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadAsync(_page + 1)">Sau</button>
        </div>
    </div>
}

@code {
    private PagedLoginAuditModel _paged;
    private int _page = 1;
    private string _error;

    protected override async Task OnInitializedAsync() => await LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        _page = page < 1 ? 1 : page;
        _error = null;
        try
        {
            _paged = await Wave3Service.GetLoginAuditsAsync(_page, 50)
                ?? new PagedLoginAuditModel();
        }
        catch (Exception)
        {
            _error = "Không tải được lịch sử đăng nhập.";
            _paged = new PagedLoginAuditModel();
        }
    }
}
