@page "/admin/ho-so"
@attribute [Authorize(Roles = "Admin,Cashier,Kitchen")]
@using PhuThuongStickyRice.Web.Components.Core.Services
@inject AuthService AuthService

<div class="lx-page-head">
    <h4 class="lx-page-title">Hồ sơ</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Hồ sơ</li>
    </ol>
</div>
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Hồ sơ của tôi</h5>
    </div>
    <div class="card-body" style="max-width: 500px;">
        @if (_loading)
        {
            <p><em>Đang tải...</em></p>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input class="form-control" @bind="_userName" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" @bind="_email" type="email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Số điện thoại</label>
                <input class="form-control" @bind="_phone" placeholder="VD: 0901234567" />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="text-danger mt-1">@_error</div>
                }
                @if (!string.IsNullOrEmpty(_success))
                {
                    <div class="text-success mt-1">@_success</div>
                }
            </div>
            <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                @(_saving ? "Đang lưu..." : "Lưu")
            </button>
        }
    </div>
</div>

@code {
    private bool _loading = true;
    private bool _saving;
    private string _userName;
    private string _email;
    private string _phone;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var p = await AuthService.GetProfileAsync();
            _userName = p?.UserName;
            _email = p?.Email;
            _phone = p?.PhoneNumber;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async Task Save()
    {
        _error = null; _success = null; _saving = true;
        try
        {
            await AuthService.UpdateProfileAsync(_userName, _email, _phone);
            _success = "Đã cập nhật thông tin.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }
}
