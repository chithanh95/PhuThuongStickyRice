@page "/admin/lich-nghi"
@attribute [Authorize(Roles = "Admin")]
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject HolidayService HolidayService
@inject PhuThuongStickyRice.Web.Components.Core.Services.ToastService Toasts

<div class="lx-page-head">
    <h4 class="lx-page-title">Lịch nghỉ lễ / Tết</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li>Vận hành</li>
        <li class="current">Lịch nghỉ</li>
    </ol>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">@(_editingId == null ? "Thêm ngày nghỉ" : "Sửa ngày nghỉ")</h4>
                <p class="card-title-desc">Vào đúng ngày nghỉ <strong>cả ngày</strong>, web tự động chuyển sang chế độ "tạm ngưng nhận đơn" với lý do từ lịch — không cần bật/tắt tay.</p>
        <div class="form-row align-items-end">
            <div class="col-md-3 mb-2">
                <label class="mb-1"><small class="text-muted">Ngày nghỉ</small></label>
                <input type="date" class="form-control" @bind="_model.HolidayDate" />
            </div>
            <div class="col-md-5 mb-2">
                <label class="mb-1"><small class="text-muted">Lý do</small></label>
                <input type="text" class="form-control" @bind="_model.Reason"
                       maxlength="200" placeholder="VD: Nghỉ Tết Nguyên đán" />
            </div>
            <div class="col-md-2 mb-2">
                <div class="custom-control custom-switch mt-4">
                    <input type="checkbox" class="custom-control-input" id="holiday-fullday" @bind="_model.IsFullDay" />
                    <label class="custom-control-label" for="holiday-fullday">Nghỉ cả ngày</label>
                </div>
            </div>
            <div class="col-md-2 mb-2 text-right">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Đang lưu..." : (_editingId == null ? "Thêm" : "Lưu"))
                </button>
                @if (_editingId != null)
                {
                    <button class="btn btn-secondary ml-2" @onclick="CancelEdit">Hủy</button>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mt-3 mb-0">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <div class="alert alert-success mt-3 mb-0">@_success</div>
        }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Danh sách ngày nghỉ</h4>
                <p class="card-title-desc">Các ngày nghỉ sắp tới, hôm nay và đã qua.</p>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th scope="col">Ngày</th>
                        <th scope="col">Thứ</th>
                        <th scope="col">Lý do</th>
                        <th scope="col">Hình thức</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Đang tải...</td></tr>
                    }
                    else if (_holidays.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có ngày nghỉ nào.</td></tr>
                    }
                    else
                    {
                        @foreach (var holiday in _holidays)
                        {
                            var isPast = holiday.HolidayDate.Date < DateTime.Today;
                            var isToday = holiday.HolidayDate.Date == DateTime.Today;
                            <tr class="@(isPast ? "text-muted" : "") @(isToday ? "table-warning" : "")">
                                <td><strong>@holiday.HolidayDate.ToString("dd/MM/yyyy")</strong></td>
                                <td>@VnWeekday(holiday.HolidayDate)</td>
                                <td>@holiday.Reason</td>
                                <td>@(holiday.IsFullDay ? "Nghỉ cả ngày" : "Nghỉ một phần")</td>
                                <td>
                                    @if (isToday)
                                    {
                                        <span class="badge badge-warning">Hôm nay — đang nghỉ</span>
                                    }
                                    else if (isPast)
                                    {
                                        <span class="badge badge-secondary">Đã qua</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Sắp tới</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <button class="btn btn-sm btn-outline-primary mr-1" @onclick="() => StartEdit(holiday)">Sửa</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(holiday)">Xóa</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
            </div>
        </div>
    </div>
</div>

@* Bug-hunt 2026-10-20: hỏi xác nhận trước khi xóa ngày nghỉ (tránh bấm nhầm
   mất lịch nghỉ khiến web không tự chuyển chế độ tạm ngưng nhận đơn),
   dùng chung ConfirmDialog như trang Chi nhánh. *@
<ConfirmDialog @ref="DeleteDialog" Title="Xóa ngày nghỉ" YesText="Xóa" NoText="Hủy" ConfirmEventCallback="ConfirmedDelete">
    <Message>
        Bạn có chắc muốn xóa ngày nghỉ <strong>@_deleting?.HolidayDate.ToString("dd/MM/yyyy")</strong>? Thao tác này không thể hoàn tác.
    </Message>
</ConfirmDialog>

@code {
    private List<HolidayModel> _holidays = new();
    private HolidayModel _deleting;
    private ConfirmDialog DeleteDialog;
    private CreateHolidayModel _model = new() { HolidayDate = DateTime.Today };
    private Guid? _editingId;
    private bool _loading = true;
    private bool _saving;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _holidays = await HolidayService.GetListAsync() ?? new();
        }
        catch (Exception ex)
        {
            _error = "Không tải được lịch nghỉ: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartEdit(HolidayModel holiday)
    {
        _editingId = holiday.Id;
        _model = new CreateHolidayModel
        {
            HolidayDate = holiday.HolidayDate.Date,
            Reason = holiday.Reason,
            IsFullDay = holiday.IsFullDay
        };
        _error = null;
        _success = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _model = new() { HolidayDate = DateTime.Today };
        _error = null;
        _success = null;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _success = null;
        if (string.IsNullOrWhiteSpace(_model.Reason))
        {
            _error = "Vui lòng nhập lý do nghỉ.";
            return;
        }

        _saving = true;
        try
        {
            if (_editingId == null)
            {
                await HolidayService.CreateAsync(_model);
                _success = "Đã thêm ngày nghỉ.";
                Toasts.Show("Đã thêm ngày nghỉ thành công!");
            }
            else
            {
                await HolidayService.UpdateAsync(_editingId.Value, _model);
                _success = "Đã cập nhật ngày nghỉ.";
                Toasts.Show("Đã cập nhật ngày nghỉ thành công!");
            }
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Hỏi xác nhận trước khi xóa ngày nghỉ (tránh bấm nhầm).
    /// </summary>
    private void AskDelete(HolidayModel holiday)
    {
        _deleting = holiday;
        _error = null;
        DeleteDialog.Show();
    }

    private async Task ConfirmedDelete()
    {
        if (_deleting == null)
        {
            return;
        }

        _error = null;
        try
        {
            await HolidayService.DeleteAsync(_deleting.Id);
            DeleteDialog.Close();
            _success = $"Đã xóa ngày nghỉ {_deleting.HolidayDate:dd/MM/yyyy}.";
            _deleting = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "Không xóa được: " + ex.Message;
        }
    }

    private static string VnWeekday(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday => "Thứ 2",
        DayOfWeek.Tuesday => "Thứ 3",
        DayOfWeek.Wednesday => "Thứ 4",
        DayOfWeek.Thursday => "Thứ 5",
        DayOfWeek.Friday => "Thứ 6",
        DayOfWeek.Saturday => "Thứ 7",
        _ => "Chủ nhật",
    };
}
