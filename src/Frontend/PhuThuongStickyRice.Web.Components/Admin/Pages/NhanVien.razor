@page "/admin/nhan-vien"
@attribute [Authorize(Roles = "Admin")]
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using PhuThuongStickyRice.Web.Components.Core.Components
@inject StaffService StaffService

<div class="lx-page-head">
    <h4 class="lx-page-title">Nhân viên</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Huyền</a></li>
        <li>Hệ thống</li>
        <li class="current">Nhân viên</li>
    </ol>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Tạo tài khoản mới</h4>
                <p class="card-title-desc">
                    Tài khoản đăng nhập trang quản trị. <strong>Admin</strong> thấy tất cả,
                    <strong>Thu ngân (Cashier)</strong> chỉ thấy Đơn hàng, Bán POS và Dashboard cơ bản (không doanh thu),
                    <strong>Bếp (Kitchen)</strong> chỉ thấy Màn hình bếp.
                </p>
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>Tên đăng nhập</label>
                        <input class="form-control" @bind="_userName" placeholder="thungan1" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Email</label>
                        <input class="form-control" @bind="_email" placeholder="thungan1@phuthuong.vn" />
                    </div>
                    <div class="form-group col-md-2">
                        <label>Mật khẩu</label>
                        <input type="password" class="form-control" @bind="_password" placeholder="Tối thiểu 6 ký tự" />
                    </div>
                    <div class="form-group col-md-2">
                        <label>Vai trò</label>
                        <select class="form-control" @bind="_role">
                            <option value="Cashier">Thu ngân (Cashier)</option>
                            <option value="Kitchen">Bếp (Kitchen)</option>
                            <option value="Admin">Quản trị (Admin)</option>
                        </select>
                    </div>
                    <div class="form-group col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary btn-block" @onclick="CreateUser" disabled="@_saving">
                            @(_saving ? "Đang tạo..." : "Tạo tài khoản")
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger mb-0">@_error</div>
                }
                @if (!string.IsNullOrEmpty(_success))
                {
                    <div class="alert alert-success mb-0">@_success</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Danh sách tài khoản</h4>
                <p class="card-title-desc">Gán thêm hoặc gỡ vai trò của từng tài khoản trực tiếp trên bảng.</p>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Tên đăng nhập</th>
                                <th scope="col">Email</th>
                                <th scope="col">Vai trò</th>
                                <th scope="col" class="text-center">Gán vai trò</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_users == null)
                            {
                                <tr><td colspan="4" class="text-center"><em>Đang tải...</em></td></tr>
                            }
                            else
                            {
                                @foreach (var user in _users)
                                {
                                    <tr @key="user.Id">
                                        <td>
                                            <strong>@user.UserName</strong>
                                            @if (user.IsLocked)
                                            {
                                                <span class="lx-pill lx-pill-danger ml-2">Đã khóa</span>
                                            }
                                        </td>
                                        <td>@user.Email</td>
                                        <td>
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="lx-pill @RolePillClass(role) mr-1">
                                                    @RoleLabel(role)
                                                    <button type="button" class="close ml-1" aria-label="Gỡ"
                                                            title="Gỡ vai trò @role"
                                                            @onclick="() => AskRemoveRole(user, role)">×</button>
                                                </span>
                                            }
                                            @if (user.Roles.Count == 0)
                                            {
                                                <span class="text-muted"><em>Chưa có vai trò</em></span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <select class="form-control form-control-sm d-inline-block" style="width:auto;"
                                                    value="" @onchange="(e) => AssignRole(user, e.Value?.ToString())">
                                                <option value="">+ Gán vai trò...</option>
                                                @foreach (var role in AllRoles.Where(x => !user.Roles.Contains(x)))
                                                {
                                                    <option value="@role">@RoleLabel(role)</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<ConfirmDialog @ref="RemoveRoleDialog" Title="Gỡ vai trò" YesText="Gỡ" NoText="Hủy" ConfirmEventCallback="ConfirmedRemoveRole">
    <Message>
        Gỡ vai trò <strong>@RoleLabel(_removingRole)</strong> khỏi nhân viên <strong>@_removingUser?.UserName</strong>?
    </Message>
</ConfirmDialog>

@code {
    private List<StaffUserModel> _users;
    private string _userName, _email, _password;
    private string _role = "Cashier";
    private bool _saving;
    private string _error, _success;

    private static readonly string[] AllRoles = { "Admin", "Cashier", "Kitchen" };

    private static string RoleLabel(string role) => role switch
    {
        "Admin" => "Quản trị",
        "Cashier" => "Thu ngân",
        "Kitchen" => "Bếp",
        _ => role
    };

    private static string RolePillClass(string role) => role switch
    {
        "Admin" => "lx-pill-danger",
        "Cashier" => "lx-pill-primary",
        "Kitchen" => "lx-pill-warning",
        _ => "lx-pill-secondary"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            _users = await StaffService.GetUsersAsync();
        }
        catch (Exception ex)
        {
            _error = "Không tải được danh sách: " + ex.Message;
        }
    }

    private async Task CreateUser()
    {
        _error = null;
        _success = null;
        if (string.IsNullOrWhiteSpace(_userName) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Nhập tên đăng nhập và mật khẩu.";
            return;
        }

        _saving = true;
        try
        {
            await StaffService.CreateUserAsync(_userName.Trim(), _email?.Trim(), _password, _role);
            _success = $"Đã tạo tài khoản {_userName} với vai trò {RoleLabel(_role)}.";
            _userName = _email = _password = null;
            await LoadUsers();
        }
        catch (Exception ex)
        {
            _error = "Tạo thất bại: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AssignRole(StaffUserModel user, string role)
    {
        if (string.IsNullOrEmpty(role)) return;
        try
        {
            await StaffService.AssignRoleAsync(user.Id, role);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            _error = "Gán vai trò thất bại: " + ex.Message;
        }
    }

    private ConfirmDialog RemoveRoleDialog;
    private StaffUserModel _removingUser;
    private string _removingRole;

    // Gỡ vai trò phải qua hộp thoại xác nhận — tránh bấm nhầm 1 click làm
    // mất quyền của nhân viên. Backend (StaffController.RemoveRole) đã chặn
    // tự gỡ quyền Admin của chính mình; dialog này là lớp bảo vệ ở UI.
    private void AskRemoveRole(StaffUserModel user, string role)
    {
        _removingUser = user;
        _removingRole = role;
        _error = null;
        RemoveRoleDialog.Show();
    }

    private async Task ConfirmedRemoveRole()
    {
        var removingUser = _removingUser;
        var role = _removingRole;
        if (removingUser == null || string.IsNullOrEmpty(role))
        {
            return;
        }

        try
        {
            await StaffService.RemoveRoleAsync(removingUser.Id, role);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            _error = "Gỡ vai trò thất bại: " + ex.Message;
        }
        finally
        {
            _removingUser = null;
            _removingRole = null;
            RemoveRoleDialog.Close();
        }
    }
}
