@page "/admin/shop-settings"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject ShopSettingsService ShopSettingsService
@inject PhuThuongStickyRice.Web.Components.Core.Services.ToastService Toasts

<div class="lx-page-head">
    <h4 class="lx-page-title">Cài đặt bán hàng</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li>Hệ thống</li>
        <li class="current">Cài đặt bán hàng</li>
    </ol>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_model == null)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center text-muted"><em>Đang tải...</em></div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Phí giao hàng &amp; đơn hàng</h4>
                    <p class="card-title-desc">Phí giao hàng và đơn tối thiểu áp dụng cho mọi đơn đặt qua web.</p>
                    <div class="form-group">
                        <label>Phí giao hàng (₫)</label>
                        <input type="number" min="0" step="1000" class="form-control" @bind="_model.DeliveryFee" />
                        <small class="form-text text-muted">Đặt 0 để luôn miễn phí giao hàng.</small>
                    </div>
                    <div class="form-group">
                        <label>Miễn phí ship cho đơn từ (₫)</label>
                        <input type="number" min="0" step="1000" class="form-control" @bind="_model.FreeShipThreshold" />
                        <small class="form-text text-muted">Đơn có (tạm tính − giảm giá) từ mức này trở lên được miễn phí ship. Đặt 0 để tắt miễn phí ship.</small>
                    </div>
                    <div class="form-group">
                        <label>Giá trị đơn tối thiểu (₫)</label>
                        <input type="number" min="0" step="1000" class="form-control" @bind="_model.MinOrderAmount" />
                        <small class="form-text text-muted">Đặt 0 để không giới hạn. Khách không thể đặt đơn dưới mức này.</small>
                    </div>
                    <div class="form-group mb-0">
                        <label>Thời gian giao hàng dự kiến (phút)</label>
                        <input type="number" min="0" max="600" step="5" class="form-control" @bind="_model.EstimatedDeliveryMinutes" />
                        <small class="form-text text-muted">Hiển thị ở trang đặt hàng, VD: 45 → “Dự kiến giao trong 30–45 phút”. Đặt 0 để ẩn.</small>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Chống spam</h4>
                    <p class="card-title-desc">Giới hạn số đơn mỗi số điện thoại để chặn đơn ảo.</p>
                    <div class="form-group mb-0">
                        <label>Số đơn tối đa / SĐT / ngày</label>
                        <input type="number" min="0" max="1000" class="form-control" @bind="_model.MaxOrdersPerPhonePerDay" />
                        <small class="form-text text-muted">Mặc định 10. Đặt 0 = không giới hạn. Đơn đã hủy không tính. Ngày theo giờ Việt Nam.</small>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Chatbot Messenger</h4>
                    <p class="card-title-desc">Tự động trả lời tin nhắn fanpage khi khách inbox.</p>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Page Access Token</label>
                            <input type="password" class="form-control" @bind="_model.FacebookPageAccessToken" autocomplete="off" />
                            <small class="form-text text-muted">Token của Fanpage (Facebook App → Messenger → Generate Token). Để trống = chatbot chờ cấu hình (không gửi tin nhắn).</small>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Verify Token</label>
                            <input class="form-control" @bind="_model.FacebookVerifyToken" />
                            <small class="form-text text-muted">Chuỗi tự chọn, nhập trùng khi đăng ký webhook trên Facebook.</small>
                        </div>
                        <div class="form-group col-md-6">
                            <label>App Secret</label>
                            <input type="password" class="form-control" @bind="_model.FacebookAppSecret" autocomplete="off" />
                            <small class="form-text text-muted">Facebook App → Settings → Basic → App Secret. Dùng để xác thực chữ ký webhook, chống giả mạo tin nhắn tạo đơn ảo. Để trống = không kiểm tra chữ ký.</small>
                        </div>
                    </div>
                    <div class="alert alert-info mb-0">
                        <strong>Cách bật chatbot:</strong>
                        <ol class="mb-0">
                            <li>Tạo App tại <em>developers.facebook.com</em>, thêm sản phẩm Messenger, liên kết Fanpage.</li>
                            <li>Lấy <em>Page Access Token</em> → dán vào ô trên.</li>
                            <li>Chọn một <em>Verify Token</em> → dán vào ô trên.</li>
                            <li>Lấy <em>App Secret</em> (Settings → Basic) → dán vào ô trên → <strong>Lưu</strong> (bật xác thực chữ ký webhook).</li>
                            <li>Trong App → Messenger → Webhooks: Callback URL = <code>https://&lt;tên-miền&gt;/api/webhooks/messenger</code>, Verify Token = chuỗi ở bước 3, đăng ký field <em>messages</em>.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Chuyển khoản &amp; đặt cọc</h4>
                    <p class="card-title-desc">Tài khoản nhận chuyển khoản QR (VietQR) và quy định đặt cọc.</p>
                    <div class="form-group">
                        <label>Tự động hủy đơn chuyển khoản chưa thanh toán sau (phút)</label>
                        <input type="number" min="1" max="10080" class="form-control" @bind="_model.BankTransferExpiryMinutes" />
                        <small class="form-text text-muted">Mặc định 30 phút. Worker chạy mỗi 5 phút.</small>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Tên ngân hàng</label>
                            <input class="form-control" @bind="_model.BankName" placeholder="VD: Vietcombank" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Mã ngân hàng VietQR</label>
                            <input class="form-control" @bind="_model.BankId" placeholder="VD: VCB" />
                            <small class="form-text text-muted">Mã BIN của ngân hàng theo chuẩn VietQR (VD: VCB, TCB, MBB).</small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Số tài khoản</label>
                            <input class="form-control" @bind="_model.BankAccountNumber" placeholder="VD: 0123456789" inputmode="numeric" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Chủ tài khoản</label>
                            <input class="form-control" @bind="_model.BankAccountName" placeholder="VD: NGUYEN VAN A" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Mẫu ảnh QR</label>
                        <input class="form-control" @bind="_model.BankQrTemplate" placeholder="compact2" />
                        <small class="form-text text-muted">Để trống = compact2. Các mẫu VietQR: qr_only, compact, compact2.</small>
                    </div>
                    <small class="form-text text-muted mb-3">Để trống các ô trên = tắt thanh toán QR (khách chỉ thấy hướng dẫn chuyển khoản thủ công).</small>
                    <div class="form-row mb-0">
                        <div class="form-group col-md-6">
                            <label>Ngưỡng yêu cầu đặt cọc (₫)</label>
                            <input type="number" min="0" step="10000" class="form-control" @bind="_model.DepositThreshold" />
                            <small class="form-text text-muted">Đơn chuyển khoản từ mức này phải đặt cọc. Đặt 0 để tắt.</small>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Tỷ lệ đặt cọc (%)</label>
                            <input type="number" min="0" max="100" class="form-control" @bind="_model.DepositPercent" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Điểm tích lũy</h4>
                    <p class="card-title-desc">Quy đổi chi tiêu thành điểm và điểm thành tiền giảm.</p>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>₫ chi tiêu / 1 điểm</label>
                            <input type="number" min="1" step="1000" class="form-control" @bind="_model.PointsPerVnd" />
                        </div>
                        <div class="form-group col-md-4">
                            <label>Điểm cho 1 lần đổi</label>
                            <input type="number" min="1" class="form-control" @bind="_model.PointsRedeemUnit" />
                        </div>
                        <div class="form-group col-md-4">
                            <label>₫ giảm / 1 lần đổi</label>
                            <input type="number" min="0" step="1000" class="form-control" @bind="_model.PointsRedeemValue" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Điểm thưởng giới thiệu (cho cả người giới thiệu và người mua)</label>
                        <input type="number" min="0" class="form-control" @bind="_model.ReferralBonusPoints" />
                        <small class="form-text text-muted">Thưởng khi đơn đầu tiên có mã giới thiệu được hoàn thành.</small>
                    </div>
                    <div class="form-row mb-0">
                        <div class="form-group col-md-4">
                            <label>Điểm thưởng điểm danh mỗi ngày</label>
                            <input type="number" min="0" max="1000" class="form-control" @bind="_model.CheckInPoints" />
                            <small class="form-text text-muted">Mỗi SĐT điểm danh 1 lần/ngày ở trang tra cứu đơn.</small>
                        </div>
                        <div class="form-group col-md-4">
                            <label>Định mức nếp (g/suất)</label>
                            <input type="number" min="1" max="1000" class="form-control" @bind="_model.NepPerPortionGrams" />
                            <small class="form-text text-muted">Dùng cho dự báo nguyên liệu.</small>
                        </div>
                        <div class="form-group col-md-4">
                            <label>Mục tiêu doanh thu ngày (₫)</label>
                            <input type="number" min="0" step="100000" class="form-control" @bind="_model.DailyTargetAmount" />
                            <small class="form-text text-muted">Hiện thanh tiến độ trên dashboard.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Gói quà &amp; báo cáo chủ quán</h4>
                    <p class="card-title-desc">Phí gói quà và email nhận báo cáo định kỳ.</p>
                    <div class="form-group">
                        <label>Phí gói quà (₫)</label>
                        <input type="number" min="0" step="1000" class="form-control" @bind="_model.GiftFee" />
                    </div>
                    <div class="form-group mb-0">
                        <label>Email nhận báo cáo</label>
                        <input type="email" class="form-control" @bind="_model.OwnerReportEmail" placeholder="chu-quan@example.com" />
                        <small class="form-text text-muted">Báo cáo tự động gửi thứ 2 hàng tuần và mùng 1 hàng tháng lúc 7:00. Để trống = tắt.</small>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">reCAPTCHA chống spam</h4>
                    <p class="card-title-desc">Chặn bot tạo đơn ảo ở trang đặt hàng.</p>
                    <div class="form-row mb-0">
                        <div class="form-group col-md-6">
                            <label>Site key</label>
                            <input class="form-control" @bind="_model.RecaptchaSiteKey" placeholder="6L..." />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Secret key</label>
                            <input type="password" class="form-control" @bind="_model.RecaptchaSecretKey" placeholder="6L..." />
                        </div>
                    </div>
                    <small class="form-text text-muted">Để trống cả hai = tắt reCAPTCHA. Khi bật, trang đặt hàng chạy reCAPTCHA v3 (yêu cầu điểm ≥ 0.5) trước khi tạo đơn.</small>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Giờ mở cửa &amp; nhận đơn</h4>
                    <p class="card-title-desc">Điều khiển khi nào quán nhận đơn đặt hàng.</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>
                            <strong>Nhận đơn hàng</strong><br />
                            <small class="text-muted">Tắt để tạm ngừng nhận đơn (trang đặt hàng hiển thị thông báo, server từ chối đơn mới)</small>
                        </span>
                        <label class="lexa-switch lexa-switch-primary mb-0 ml-2 flex-shrink-0">
                            <input type="checkbox" @bind="_model.AcceptingOrders" />
                            <span class="lexa-slider"></span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Lý do tạm ngưng nhận đơn</label>
                        <input class="form-control" @bind="_model.PausedReason" maxlength="500"
                               placeholder="VD: Hết nếp, mở lại lúc 14:00" />
                        <small class="form-text text-muted">Hiển thị cho khách khi tắt "Nhận đơn hàng". Bỏ trống thì hiện thông báo chung.</small>
                    </div>
                    <div class="form-row mb-0">
                        <div class="form-group col-md-6">
                            <label>Giờ mở cửa (HH:mm)</label>
                            <input class="form-control" @bind="_model.OpenTime" placeholder="06:00" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Giờ đóng cửa (HH:mm)</label>
                            <input class="form-control" @bind="_model.CloseTime" placeholder="10:30" />
                        </div>
                    </div>
                    <small class="form-text text-muted">Ngoài giờ này khách không thể đặt đơn, kể cả khi đang bật "Nhận đơn hàng". Giờ Việt Nam (UTC+7).</small>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Nút gọi/Zalo trên di động</h4>
                    <p class="card-title-desc">Các nút liên hệ nhanh hiện trên điện thoại.</p>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Hotline</label>
                            <input class="form-control" @bind="_model.Hotline" placeholder="0901 234 567" />
                            <small class="form-text text-muted">Nút "📞 Gọi ngay" (tel: link).</small>
                        </div>
                        <div class="form-group col-md-6">
                            <label>SĐT Zalo</label>
                            <input class="form-control" @bind="_model.ZaloPhone" placeholder="0901 234 567" />
                            <small class="form-text text-muted">Nút chat Zalo (zalo.me/số-điện-thoại).</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span><small class="text-muted">Hiện nút "💬 Hỏi qua Zalo" ở từng món trên trang /shop</small></span>
                        <label class="lexa-switch lexa-switch-primary mb-0 ml-2 flex-shrink-0">
                            <input type="checkbox" @bind="_model.ShowZaloChatButton" />
                            <span class="lexa-slider"></span>
                        </label>
                    </div>
                    <div class="form-group mb-0">
                        <label>Link Google Maps của quán</label>
                        <input class="form-control" @bind="_model.GoogleMapsUrl" placeholder="https://maps.google.com/?q=Xôi+Phú+Thượng" />
                        <small class="form-text text-muted">Hiện section "Đánh giá trên Google" trên trang chủ, kèm điểm trung bình từ đánh giá thật.</small>
                    </div>
                    <small class="form-text text-muted">Để trống = dùng số điện thoại trong chân trang landing. Các nút chỉ hiện trên điện thoại.</small>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Báo cáo tuần qua Zalo</h4>
                    <p class="card-title-desc">Tự động gửi báo cáo tuần cho chủ quán qua Zalo OA.</p>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Zalo OA Access Token</label>
                            <input type="password" class="form-control" @bind="_model.ZaloOaAccessToken" autocomplete="off" />
                            <small class="form-text text-muted">Token của Zalo Official Account. Để trống = chỉ xem báo cáo trong admin + nút "Sao chép" (không giả vờ đã gửi).</small>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Zalo User ID của chủ quán</label>
                            <input class="form-control" @bind="_model.OwnerZaloUserId" placeholder="VD: 1234567890123456789" />
                            <small class="form-text text-muted">Zalo OA gửi tin theo user ID (không phải SĐT). Chủ quán cần follow OA 1 lần để lấy được ID.</small>
                        </div>
                    </div>
                    <div class="form-group mb-0">
                        <label>SĐT chủ quán</label>
                        <input class="form-control" @bind="_model.OwnerPhone" placeholder="0901 234 567" />
                        <small class="form-text text-muted">Dùng khi chưa có Zalo User ID. Báo cáo tự gửi 08:00 sáng thứ 2 hàng tuần (cần chạy BackgroundServer).</small>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Webhook báo đơn mới</h4>
                    <p class="card-title-desc">Gửi thông báo tức thì tới hệ thống khác khi có đơn mới.</p>
                    <div class="form-group">
                        <label>URL webhook</label>
                        <input class="form-control" @bind="_model.NewOrderWebhookUrl" placeholder="https://..." />
                        <small class="form-text text-muted">Khi có đơn mới, hệ thống POST JSON <code>{maDon, sdt, tongTien, trangThai, thoiGian}</code> tới URL này (timeout 5 giây, lỗi chỉ ghi log — không làm hỏng việc tạo đơn).</small>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span><small class="text-muted">Bật webhook báo đơn mới</small></span>
                        <label class="lexa-switch lexa-switch-primary mb-0 ml-2 flex-shrink-0">
                            <input type="checkbox" @bind="_model.NewOrderWebhookEnabled" />
                            <span class="lexa-slider"></span>
                        </label>
                    </div>
                    <div class="d-flex align-items-center">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="TestWebhookAsync" disabled="@_testingWebhook">
                            @(_testingWebhook ? "Đang gửi..." : "Gửi thử")
                        </button>
                        @if (!string.IsNullOrEmpty(_webhookTestResult))
                        {
                            <small class="ml-2 @(_webhookTestOk ? "text-success" : "text-danger")">@_webhookTestResult</small>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Hạng thành viên</h4>
                    <p class="card-title-desc">Ngưỡng chi tiêu và mức giảm giá theo hạng.</p>
                    <div class="form-row mb-0">
                        <div class="form-group col-md-3">
                            <label>Chi tiêu hạng Bạc (₫)</label>
                            <input type="number" min="0" step="100000" class="form-control" @bind="_model.TierSilverMin" />
                        </div>
                        <div class="form-group col-md-3">
                            <label>Giảm giá hạng Bạc (%)</label>
                            <input type="number" min="0" max="100" class="form-control" @bind="_model.TierSilverDiscount" />
                        </div>
                        <div class="form-group col-md-3">
                            <label>Chi tiêu hạng Vàng (₫)</label>
                            <input type="number" min="0" step="100000" class="form-control" @bind="_model.TierGoldMin" />
                        </div>
                        <div class="form-group col-md-3">
                            <label>Giảm giá hạng Vàng (%)</label>
                            <input type="number" min="0" max="100" class="form-control" @bind="_model.TierGoldDiscount" />
                        </div>
                    </div>
                    <small class="form-text text-muted">Hạng Đồng: dưới ngưỡng Bạc (không giảm giá).</small>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Cảnh báo đơn chưa xác nhận</h4>
                    <p class="card-title-desc">Thông báo khẩn khi đơn chờ xác nhận quá lâu.</p>
                    <div class="form-group mb-0">
                        <label>Cảnh báo khẩn khi đơn Pending quá (phút)</label>
                        <input type="number" min="1" max="1440" class="form-control" @bind="_model.UnconfirmedAlertMinutes" />
                        <small class="form-text text-muted">Mặc định 15 phút — dashboard hiện banner đỏ + phát âm thanh khẩn.</small>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Website &amp; QR bàn</h4>
                    <p class="card-title-desc">Địa chỉ web công khai dùng tạo mã QR bàn.</p>
                    <div class="form-group mb-0">
                        <label>Địa chỉ web công khai</label>
                        <input class="form-control" @bind="_model.WebBaseUrl" placeholder="https://phuthuong.vn" />
                        <small class="form-text text-muted">Dùng để tạo mã QR bàn — VD: https://phuthuong.vn/shop?ban=5.</small>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Bảo trì &amp; giám sát</h4>
                    <p class="card-title-desc">Chế độ bảo trì, cảnh báo Telegram và giới hạn giám sát.</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>
                            <strong>Chế độ bảo trì</strong><br />
                            <small class="text-muted">Trang công khai hiển thị trang bảo trì (/login, /admin/*, /bep vẫn hoạt động)</small>
                        </span>
                        <label class="lexa-switch lexa-switch-primary mb-0 ml-2 flex-shrink-0">
                            <input type="checkbox" @bind="_model.MaintenanceMode" />
                            <span class="lexa-slider"></span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Thông báo bảo trì</label>
                        <input class="form-control" @bind="_model.MaintenanceMessage" />
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Telegram bot token <small class="text-muted">(để trống = tắt cảnh báo Telegram)</small></label>
                            <input type="password" class="form-control" @bind="_model.TelegramBotToken" autocomplete="off" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Telegram chat id</label>
                            <input class="form-control" @bind="_model.TelegramChatId" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Ngưỡng lỗi/giờ để cảnh báo</label>
                            <input type="number" min="1" class="form-control" @bind="_model.ErrorRateThreshold" />
                        </div>
                        <div class="form-group col-md-4">
                            <label>Ngưỡng cảnh báo uploads (MB)</label>
                            <input type="number" min="1" class="form-control" @bind="_model.UploadsSizeWarningMb" />
                        </div>
                        <div class="form-group col-md-4">
                            <label>Nhà cung cấp sao lưu ảnh</label>
                            <input class="form-control" @bind="_model.ImageBackupProvider" placeholder="None" />
                            <small class="form-text text-muted">"None" = không sao lưu. Xem README để thêm S3.</small>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Cấu hình JSON cho sao lưu ảnh</label>
                        <input class="form-control" @bind="_model.ImageBackupSettingsJson" placeholder='{"connectionString": "..."}' />
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><small class="text-muted">Gửi cảnh báo sức khỏe (Telegram/email). Tắt = chỉ ghi log.</small></span>
                        <label class="lexa-switch lexa-switch-primary mb-0 ml-2 flex-shrink-0">
                            <input type="checkbox" @bind="_model.HealthAlertsEnabled" />
                            <span class="lexa-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body d-flex flex-column flex-md-row align-items-md-center">
                    <div class="mb-3 mb-md-0">
                        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                            @(_saving ? "Đang lưu..." : "Lưu thay đổi")
                        </button>
                    </div>
                    <p class="small text-muted mb-0 ml-md-3">
                        Cấu hình thanh toán (ngân hàng, MoMo) xem ở trang
                        <a href="/admin/doi-soat-momo">Đối soát MoMo</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .lexa-switch { position: relative; display: inline-block; width: 46px; height: 24px; margin: 0; }
    .lexa-switch input { opacity: 0; width: 0; height: 0; }
    .lexa-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: #ccc; border-radius: 24px; transition: .2s; }
    .lexa-slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: .2s; }
    .lexa-switch input:checked + .lexa-slider { background: #7a6fbe; } /* UIUX-1019 A3: tím primary Lexa (trước #3ac9d6 cyan lạ) — đồng nhất với .lexa-switch-primary */
    .lexa-switch-primary input:checked + .lexa-slider { background: #7a6fbe; }
    .lexa-switch input:checked + .lexa-slider:before { transform: translateX(22px); }
    html.dark .lexa-slider { background: #4a4a6e; }
</style>

@code {
    private ShopSettingModel _model;
    private bool _saving;
    private string _error;
    private string _success;

    // Item 180: "Gửi thử" state.
    private bool _testingWebhook;
    private string _webhookTestResult;
    private bool _webhookTestOk;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await ShopSettingsService.GetAsync() ?? new ShopSettingModel();
        }
        catch (Exception)
        {
            _error = "Không tải được cài đặt. Vui lòng thử lại.";
        }
    }

    /// <summary>
    /// Item 180: "Gửi thử" — posts a sample new-order payload to the
    /// webhook URL (the textbox value, or the saved setting if empty).
    /// </summary>
    private async Task TestWebhookAsync()
    {
        _testingWebhook = true;
        _webhookTestResult = null;
        try
        {
            var result = await ShopSettingsService.TestOrderWebhookAsync(_model.NewOrderWebhookUrl);
            _webhookTestOk = result?.IsSuccess == true;
            _webhookTestResult = result?.Message ?? "Không có phản hồi.";
        }
        catch (Exception ex)
        {
            _webhookTestOk = false;
            _webhookTestResult = "Lỗi: " + ex.Message;
        }
        finally
        {
            _testingWebhook = false;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _success = null;

        if (_model.DeliveryFee < 0 || _model.FreeShipThreshold < 0 || _model.MinOrderAmount < 0)
        {
            _error = "Các mức tiền không được âm.";
            return;
        }

        if (_model.EstimatedDeliveryMinutes < 0)
        {
            _model.EstimatedDeliveryMinutes = 0;
        }

        if (_model.MaxOrdersPerPhonePerDay < 0)
        {
            _model.MaxOrdersPerPhonePerDay = 0;
        }

        _saving = true;
        try
        {
            _model = await ShopSettingsService.UpdateAsync(_model);
            _success = "Đã lưu cài đặt bán hàng.";
            Toasts.Show("Đã lưu cài đặt bán hàng thành công!");
        }
        catch (Exception)
        {
            _error = "Lưu thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }
}
