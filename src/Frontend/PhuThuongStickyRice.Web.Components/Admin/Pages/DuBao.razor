@* Trang dự báo doanh thu (admin): đọc dự báo từ API (dựa trên 30 ngày lịch sử
   + mẫu hình theo thứ trong tuần) → 3 thẻ tổng quan (7 ngày, 30 ngày, trung
   bình ngày), biểu đồ SVG vẽ tay (30 ngày thực tế đường liền + 7 ngày dự báo
   nét đứt nối tiếp nhau), bảng mẫu hình theo thứ và chi tiết 7 ngày tới.
   Cột "Suất nên chuẩn bị" giúp quán ước lượng nguyên liệu cần làm. *@
@page "/admin/du-bao"
@attribute [Authorize(Roles = "Admin")]
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Orders.Services
@inject OrderService OrderService

<div class="lx-page-head">
    <h4 class="lx-page-title">Dự báo doanh thu</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Dự báo doanh thu</li>
    </ol>
</div>

<div class="alert alert-info">
    <strong>ℹ️ Lưu ý:</strong> @_forecast?.Disclaimer
    <br /><small class="text-muted">@_forecast?.MethodNote</small>
</div>

@if (_loading)
{
    <p><em>Đang tính toán dự báo...</em></p>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_forecast != null)
{
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="lx-mini-stat">
                <p class="lx-mini-label">Dự báo 7 ngày tới</p>
                <h2 class="lx-mini-value">@FormatMoney(_forecast.Next7DaysTotal.ForecastRevenue)</h2>
                <span class="lx-mini-foot">@_forecast.Next7DaysTotal.ForecastOrders.ToString("0.#") đơn · @_forecast.Next7DaysTotal.SuggestedPortions.ToString("N0") suất nên chuẩn bị</span>
                <span class="lx-mini-icon"><span class="fa-solid fa-heart-pulse" aria-hidden="true"></span></span>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="lx-mini-stat">
                <p class="lx-mini-label">Dự báo 30 ngày tới</p>
                <h2 class="lx-mini-value">@FormatMoney(_forecast.Next30DaysTotal.ForecastRevenue)</h2>
                <span class="lx-mini-foot">@_forecast.Next30DaysTotal.ForecastOrders.ToString("0.#") đơn · @_forecast.Next30DaysTotal.SuggestedPortions.ToString("N0") suất nên chuẩn bị</span>
                <span class="lx-mini-icon"><span class="fa-solid fa-calendar" aria-hidden="true"></span></span>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="lx-mini-stat">
                <p class="lx-mini-label">Trung bình ngày (30 ngày qua)</p>
                <h2 class="lx-mini-value">@FormatMoney(_forecast.AvgDailyRevenue30d)</h2>
                <span class="lx-mini-foot">7 ngày gần nhất: @FormatMoney(_forecast.AvgDailyRevenue7d) · @_forecast.DaysWithOrders/@_forecast.HistoryDays ngày có đơn</span>
                <span class="lx-mini-icon"><span class="fa-solid fa-chart-line" aria-hidden="true"></span></span>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h4 class="card-title">Biểu đồ doanh thu — 30 ngày qua &amp; dự báo 7 ngày tới</h4>
            <div class="d-flex mb-2">
                <span class="mr-3"><span class="lexa-dot lexa-dot-primary"></span> Thực tế</span>
                <span><span class="lexa-dash-line"></span> Dự báo</span>
            </div>
            @* Biểu đồ vẽ bằng SVG thô (string) thay vì thẻ Blazor — Blazor cấm
               đặt attribute trên thẻ <text>, mà biểu đồ này cần nhiều text/label. *@
            @((MarkupString)_svgMarkup)
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body p-0">
            <h4 class="card-title px-3 pt-3">Mẫu hình theo thứ trong tuần</h4>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Thứ</th>
                            <th scope="col" class="text-right">Doanh thu TB</th>
                            <th scope="col" class="text-right">Đơn TB</th>
                            <th scope="col" class="text-right">Suất TB</th>
                            <th scope="col" class="text-right">So với TB chung</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in _forecast.WeekdayPattern)
                        {
                            <tr>
                                <td><strong>@w.WeekdayName</strong> <small class="text-muted">(@w.Occurrences lần)</small></td>
                                <td class="text-right">@FormatMoney(w.AvgRevenue)</td>
                                <td class="text-right">@w.AvgOrders.ToString("0.#")</td>
                                <td class="text-right">@w.AvgPortions.ToString("0.#")</td>
                                <td class="text-right">
                                    <span class="lx-pill @RatioClass(w.RatioVsAverage)">@w.RatioVsAverage.ToString("0.##")×</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <h4 class="card-title px-3 pt-3">Chi tiết dự báo 7 ngày tới</h4>
            @* Cột "Cơ sở": con số dựa trên TB của đúng thứ đó (vd thứ 2 dự theo
               các thứ 2 trước đây); thứ nào chưa đủ dữ liệu lịch sử thì dùng
               TB chung 30 ngày — vẫn ra số để quán chuẩn bị. *@
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Ngày</th>
                            <th scope="col">Thứ</th>
                            <th scope="col" class="text-right">Dự báo doanh thu</th>
                            <th scope="col" class="text-right">Dự báo đơn</th>
                            <th scope="col" class="text-right">Suất nên chuẩn bị</th>
                            <th scope="col">Cơ sở</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _forecast.Next7Days)
                        {
                            <tr>
                                <td>@d.Date.ToString("dd/MM/yyyy")</td>
                                <td>@d.WeekdayName</td>
                                <td class="text-right"><strong>@FormatMoney(d.ForecastRevenue)</strong></td>
                                <td class="text-right">@d.ForecastOrders.ToString("0.#")</td>
                                <td class="text-right"><span class="lx-pill lx-pill-primary">@d.SuggestedPortions.ToString("N0") suất</span></td>
                                <td><small class="text-muted">@(d.BasedOnWeekdayPattern ? "TB đúng thứ này" : "TB chung 30 ngày")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private RevenueForecastModel _forecast;
    private bool _loading = true;
    private string _error;

    // Chart geometry
    private const double W = 720, H = 270, PadL = 58, PadR = 14, PadT = 16, PadB = 32;
    private string _svgMarkup = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _forecast = await OrderService.GetRevenueForecastAsync();
            // Vẽ biểu đồ SVG sau khi có dữ liệu (BuildChart đọc _forecast) —
            // tách riêng để lỗi tải dữ liệu không làm crash trang.
            BuildChart();
        }
        catch (Exception ex)
        {
            _error = "Không tải được dự báo: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Định dạng số tiền triệu đồng, không thập phân, kèm ký hiệu ₫ (vd: 1.250.000₫).</summary>
    private static string FormatMoney(decimal value) => value.ToString("N0") + "₫";

    // Ngưỡng tô màu cột "So với TB chung": ≥1,5× là ngày đông bất thường
    // (xanh lá), 1,0–1,5× là trên TB (xanh dương), dưới TB (vàng cảnh báo).
    private static string RatioClass(double ratio) =>
        ratio >= 1.5 ? "lx-pill-success" : ratio >= 1.0 ? "lx-pill-info" : "lx-pill-warning";

    /// <summary>
    /// Builds the whole chart as raw SVG. A raw string is used because
    /// Blazor reserves the &lt;text&gt; tag name and forbids attributes on it.
    /// </summary>
    private void BuildChart()
    {
        var sb = new System.Text.StringBuilder();
        var history = _forecast.History.Select(x => (x.Date, x.Revenue)).ToList();
        var forecast = _forecast.Next7Days.Select(x => (x.Date, x.ForecastRevenue)).ToList();
        var pointCount = history.Count + forecast.Count;

        sb.Append("<svg class=\"db-chart\" viewBox=\"0 0 720 270\" style=\"width:100%;height:auto\" role=\"img\" aria-label=\"Bieu do doanh thu\">");
        if (pointCount > 0)
        {
            var maxValue = history.Concat(forecast).Max(x => x.Item2);
            // Chưa có dữ liệu (tất cả = 0): ép maxValue = 1 để không chia 0 —
            // mọi điểm nằm sát trục X, biểu đồ vẫn vẽ được khung.
            if (maxValue <= 0) maxValue = 1;

            // Ánh xạ chỉ số ngày → tọa độ px (trừ padding 2 biên); Math.Max
            // tránh chia 0 khi chỉ có 1 điểm dữ liệu.
            double X(int i) => PadL + i * (W - PadL - PadR) / Math.Max(pointCount - 1, 1);
            // Ánh xạ doanh thu → tọa độ px: trục Y của SVG đi xuống dưới nên
            // phải đảo (1 − v/maxValue) để giá trị lớn nằm trên cao.
            double Y(decimal v) => PadT + (H - PadT - PadB) * (1 - (double)v / (double)maxValue);
            // Định dạng số cho attribute SVG: bắt buộc InvariantCulture vì SVG
            // yêu cầu dấu chấm thập phân, bất kể locale vi-VN của trình duyệt.
            string F(double d) => d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

            AppendGridlines(sb, maxValue, Y, F);
            AppendHistoryArea(sb, history, X, Y, F);
            AppendForecastLine(sb, history, forecast, X, Y, F);
            AppendXAxisLabels(sb, history, forecast, pointCount, X, F);
        }
        sb.Append("</svg>");
        _svgMarkup = sb.ToString();
    }

    /// <summary>Vẽ 5 đường lưới ngang và nhãn tiền rút gọn bên trái.</summary>
    private void AppendGridlines(System.Text.StringBuilder sb, decimal maxValue,
        Func<decimal, double> Y, Func<double, string> F)
    {
        for (var gridIndex = 0; gridIndex <= 4; gridIndex++)
        {
            var gridValue = maxValue * gridIndex / 4;
            var pixelY = Y((decimal)gridValue);
            sb.Append($"<line x1=\"{F(PadL)}\" y1=\"{F(pixelY)}\" x2=\"{F(W - PadR)}\" y2=\"{F(pixelY)}\" stroke=\"#e9ecef\" stroke-width=\"1\"/>");
            sb.Append($"<text x=\"{F(PadL - 8)}\" y=\"{F(pixelY + 4)}\" text-anchor=\"end\" font-size=\"11\" fill=\"#6c757d\">{CompactMoney((decimal)gridValue)}</text>");
        }
    }

    /// <summary>Vẽ vùng tô dưới đường doanh thu thực tế + đường kẻ liền.</summary>
    private void AppendHistoryArea(System.Text.StringBuilder sb,
        List<(DateTime Date, decimal Revenue)> history,
        Func<int, double> X, Func<decimal, double> Y, Func<double, string> F)
    {
        var historyPoints = string.Join(" ", history.Select((p, i) => $"{F(X(i))},{F(Y(p.Revenue))}"));
        var lastHistoryIndex = history.Count - 1;
        sb.Append($"<polygon points=\"{historyPoints} {F(X(lastHistoryIndex))},{F(H - PadB)} {F(X(0))},{F(H - PadB)}\" fill=\"rgba(122,111,190,0.12)\"/>");
        sb.Append($"<polyline points=\"{historyPoints}\" fill=\"none\" stroke=\"#7a6fbe\" stroke-width=\"2.5\"/>");
    }

    /// <summary>Vẽ đường dự báo nét đứt nối tiếp điểm thực tế cuối + chấm tròn từng ngày.</summary>
    private void AppendForecastLine(System.Text.StringBuilder sb,
        List<(DateTime Date, decimal Revenue)> history,
        List<(DateTime Date, decimal ForecastRevenue)> forecast,
        Func<int, double> X, Func<decimal, double> Y, Func<double, string> F)
    {
        var lastHistoryIndex = history.Count - 1;
        // Nối chuỗi trong vòng lặp nên dùng StringBuilder (tránh tạo string mới mỗi vòng).
        // Đường dự báo bắt đầu từ ĐIỂM THỰC TẾ CUỐI CÙNG để 2 đoạn nối liền
        // nhau, không bị khoảng trống giữa quá khứ và tương lai.
        var forecastPoints = new System.Text.StringBuilder($"{F(X(lastHistoryIndex))},{F(Y(history[lastHistoryIndex].Revenue))}");
        var dots = new System.Text.StringBuilder();
        for (var i = 0; i < forecast.Count; i++)
        {
            var pixelX = X(history.Count + i);
            var pixelY = Y(forecast[i].ForecastRevenue);
            forecastPoints.Append($" {F(pixelX)},{F(pixelY)}");
            dots.Append($"<circle cx=\"{F(pixelX)}\" cy=\"{F(pixelY)}\" r=\"4\" fill=\"#f1b44c\" stroke=\"#fff\" stroke-width=\"1.5\"/>");
        }
        sb.Append($"<polyline points=\"{forecastPoints}\" fill=\"none\" stroke=\"#f1b44c\" stroke-width=\"2.5\" stroke-dasharray=\"7 4\"/>");
        sb.Append(dots);
    }

    /// <summary>Vẽ nhãn ngày (dd/MM) trên trục X, cách đều khoảng 7 nhãn.</summary>
    private void AppendXAxisLabels(System.Text.StringBuilder sb,
        List<(DateTime Date, decimal Revenue)> history,
        List<(DateTime Date, decimal ForecastRevenue)> forecast,
        int pointCount, Func<int, double> X, Func<double, string> F)
    {
        var all = history.Select(x => x.Date).Concat(forecast.Select(x => x.Date)).ToList();
        // Chỉ hiện khoảng 7 nhãn ngày (dd/MM) trên trục X để nhãn không đè
        // lên nhau khi có ~37 điểm dữ liệu.
        var step = Math.Max(1, pointCount / 7);
        for (var i = 0; i < pointCount; i += step)
        {
            sb.Append($"<text x=\"{F(X(i))}\" y=\"{F(H - 8)}\" text-anchor=\"middle\" font-size=\"11\" style=\"fill:var(--db-axis,#6c757d)\">{all[i]:dd/MM}</text>");
        }
    }

    // Nhãn tiền rút gọn trên trục Y của biểu đồ (vd 1,5tr / 20K) để nhãn
    // không tràn ra ngoài vùng padding trái.
    private static string CompactMoney(decimal amount)
    {
        if (amount >= 1_000_000m) return (amount / 1_000_000m).ToString("0.#") + "tr";
        if (amount >= 1_000m) return (amount / 1_000m).ToString("0.#") + "K";
        return amount.ToString("0");
    }
}
