@page "/admin/khuyen-mai"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject Wave3Service Wave3Service

<h3>Khuyến mãi giờ vàng</h3>
<p class="text-muted">Khung giờ giảm giá tự áp dụng ở checkout (giờ Việt Nam). Khi nhiều chương trình cùng khung giờ, chương trình giảm nhiều nhất được áp dụng.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success">@_message</div>
}

<div class="card mb-3">
    <div class="card-header">@(_editing == null ? "Thêm chương trình" : "Sửa chương trình")</div>
    <div class="card-body">
        <div class="form-row">
            <div class="col-md-4 mb-2">
                <label><small class="text-muted">Tên chương trình *</small></label>
                <input class="form-control" placeholder="VD: Giờ vàng buổi chiều" @bind="_form.Name" />
            </div>
            <div class="col-md-2 mb-2">
                <label><small class="text-muted">Giảm (%) *</small></label>
                <input type="number" min="1" max="100" step="1" class="form-control" @bind="_form.DiscountPercent" />
            </div>
            <div class="col-md-2 mb-2">
                <label><small class="text-muted">Bắt đầu *</small></label>
                <input type="time" class="form-control" value="@_form.StartTime"
                       @onchange="(e) => _form.StartTime = NormalizeTime(e.Value?.ToString())" />
            </div>
            <div class="col-md-2 mb-2">
                <label><small class="text-muted">Kết thúc *</small></label>
                <input type="time" class="form-control" value="@_form.EndTime"
                       @onchange="(e) => _form.EndTime = NormalizeTime(e.Value?.ToString())" />
            </div>
            <div class="col-md-2 mb-2">
                <label><small class="text-muted">Trạng thái</small></label>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="promo-active" @bind="_form.IsActive" />
                    <label class="form-check-label" for="promo-active">Đang chạy</label>
                </div>
            </div>
        </div>
        <div class="mb-2">
            <small class="text-muted">Áp dụng các ngày:</small>
            <div class="d-flex flex-wrap">
                @foreach (var d in DayOptions)
                {
                    var flag = d.Flag;
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@($"day-{flag}")"
                               checked="@((_form.DaysOfWeekFlags & flag) != 0)"
                               @onchange="e => ToggleDay(flag, (bool)e.Value)" />
                        <label class="form-check-label" for="@($"day-{flag}")">@d.Label</label>
                    </div>
                }
            </div>
        </div>
        <button class="btn btn-primary mr-2" @onclick="SaveAsync" disabled="@_saving">
            @(_editing == null ? "Thêm" : "Lưu")
        </button>
        @if (_editing != null)
        {
            <button class="btn btn-outline-secondary" @onclick="CancelEdit">Hủy</button>
        }
    </div>
</div>

@if (_items == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_items.Count == 0)
{
    <div class="alert alert-info">Chưa có chương trình khuyến mãi nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr><th>Tên</th><th class="text-right">Giảm</th><th>Khung giờ</th><th>Ngày</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in _items)
                {
                    <tr @key="p.Id">
                        <td><strong>@p.Name</strong></td>
                        <td class="text-right text-success"><strong>−@p.DiscountPercent.ToString("N0")%</strong></td>
                        <td>@p.StartTime – @p.EndTime</td>
                        <td><small>@DayLabels(p.DaysOfWeekFlags)</small></td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge badge-success">Đang chạy</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Tắt</span>
                            }
                        </td>
                        <td class="text-right">
                            <button class="btn btn-sm btn-outline-primary mr-1" @onclick="() => StartEdit(p)">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(p)">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly (int Flag, string Label)[] DayOptions =
    {
        (1, "T2"), (2, "T3"), (4, "T4"), (8, "T5"), (16, "T6"), (32, "T7"), (64, "CN")
    };

    private List<PromotionModel> _items;
    private PromotionModel _form = NewForm();
    private PromotionModel _editing;
    private string _error;
    private string _message;
    private bool _saving;

    private static PromotionModel NewForm() => new PromotionModel
    {
        DiscountPercent = 10,
        StartTime = "14:00",
        EndTime = "17:00",
        DaysOfWeekFlags = 127,
        IsActive = true
    };

    /// <summary>Normalizes a time-input value to "HH:mm".</summary>
    private static string NormalizeTime(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        // Blazor time inputs give "HH:mm" (or "HH:mm:ss"); the server
        // parses "HH:mm".
        var parts = value.Trim().Split(':');
        if (parts.Length >= 2
            && int.TryParse(parts[0], out var h)
            && int.TryParse(parts[1], out var m))
        {
            return $"{h:00}:{m:00}";
        }

        return value.Trim();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private static string DayLabels(int flags) =>
        string.Join(", ", DayOptions.Where(d => (flags & d.Flag) != 0).Select(d => d.Label));

    private void ToggleDay(int flag, bool on)
    {
        _form.DaysOfWeekFlags = on
            ? _form.DaysOfWeekFlags | flag
            : _form.DaysOfWeekFlags & ~flag;
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = await Wave3Service.GetPromotionsAsync() ?? new List<PromotionModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách khuyến mãi.";
            _items = new List<PromotionModel>();
        }
    }

    private void StartEdit(PromotionModel p)
    {
        _editing = p;
        _form = new PromotionModel
        {
            Id = p.Id,
            Name = p.Name,
            DiscountPercent = p.DiscountPercent,
            StartTime = p.StartTime,
            EndTime = p.EndTime,
            DaysOfWeekFlags = p.DaysOfWeekFlags,
            IsActive = p.IsActive
        };
    }

    private void CancelEdit()
    {
        _editing = null;
        _form = NewForm();
    }

    private async Task SaveAsync()
    {
        _error = null;
        _message = null;
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = "Vui lòng nhập tên chương trình.";
            return;
        }

        if (_form.DiscountPercent <= 0 || _form.DiscountPercent > 100)
        {
            _error = "Phần trăm giảm phải từ 1 đến 100.";
            return;
        }

        if (_form.DaysOfWeekFlags == 0)
        {
            _error = "Vui lòng chọn ít nhất một ngày áp dụng.";
            return;
        }

        _saving = true;
        try
        {
            if (_editing == null)
            {
                await Wave3Service.CreatePromotionAsync(_form);
                _message = "Đã thêm chương trình khuyến mãi.";
            }
            else
            {
                await Wave3Service.UpdatePromotionAsync(_editing.Id, _form);
                _message = "Đã lưu thay đổi.";
            }

            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(PromotionModel p)
    {
        _error = null;
        try
        {
            await Wave3Service.DeletePromotionAsync(p.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
