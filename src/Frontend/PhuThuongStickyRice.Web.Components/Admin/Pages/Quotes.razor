@page "/admin/dat-tiec"
@page "/admin/quotes"
@attribute [Authorize]
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using PhuThuongStickyRice.Web.Components.Shop.Models
@inject CatalogAdminService CatalogAdminService

<div class="lx-page-head">
    <h4 class="lx-page-title">Yêu cầu báo giá đặt tiệc</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Báo giá</li>
    </ol>
</div>
<p class="text-muted">Đơn đặt cỗ / số lượng lớn từ trang <a href="/dat-tiec">/dat-tiec</a> và form đặt xôi ở trang chủ. Không thu tiền trước — shop gọi lại báo giá.</p>

@if (!string.IsNullOrEmpty(_error))
{
    @* UIUX-1020 Agent4 (a11y): role="alert" để screen reader tự đọc lỗi
       khi nó xuất hiện sau thao tác bất đồng bộ. *@
    <div class="alert alert-danger" role="alert">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="mb-3">
    @* Tab lọc dạng pill (làm lại theo yêu cầu user 2026-10-21, thay
       btn-group Bootstrap cũ). A11y: tab là toggle — aria-pressed để trình
       đọc màn hình biết trạng thái đang lọc. *@
    <div class="quote-tabs" role="group" aria-label="Lọc yêu cầu theo trạng thái">
        <button class="quote-tab @(_statusFilter == null ? "active" : "")" aria-pressed="@(_statusFilter == null)" @onclick="() => SetStatus(null)">Tất cả</button>
        <button class="quote-tab @(_statusFilter == "New" ? "active" : "")" aria-pressed='@(_statusFilter == "New")' @onclick='() => SetStatus("New")'>Mới</button>
        <button class="quote-tab @(_statusFilter == "Contacted" ? "active" : "")" aria-pressed='@(_statusFilter == "Contacted")' @onclick='() => SetStatus("Contacted")'>Đã liên hệ</button>
        <button class="quote-tab @(_statusFilter == QuoteStatusConfirmed ? "active" : "")" aria-pressed='@(_statusFilter == QuoteStatusConfirmed)' @onclick='() => SetStatus(QuoteStatusConfirmed)'>Đã chốt</button>
        <button class="quote-tab @(_statusFilter == "Cancelled" ? "active" : "")" aria-pressed='@(_statusFilter == "Cancelled")' @onclick='() => SetStatus("Cancelled")'>Hủy</button>
    </div>
</div>

@if (_quotes == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_quotes.Count == 0)
{
    <div class="alert alert-info">Chưa có yêu cầu báo giá nào.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Danh sách yêu cầu báo giá</h4>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Ngày gửi</th>
                            <th scope="col">Loại</th>
                            <th scope="col">Khách hàng</th>
                            <th scope="col">SĐT</th>
                            <th scope="col">Ngày tiệc</th>
                            <th scope="col" class="text-right">Số lượng</th>
                            <th scope="col">Địa điểm / Vốn dự kiến</th>
                            <th scope="col">Ghi chú</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in _quotes)
                        {
                            <tr @key="q.Id">
                                <td class="text-nowrap">@q.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td>@QuoteTypeBadge(q.QuoteType)</td>
                                <td><strong>@q.CustomerName</strong></td>
                                <td class="text-nowrap"><a href="tel:@q.CustomerPhone">@q.CustomerPhone</a></td>
                                <td>@(q.EventDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="text-right">@q.Quantity</td>
                                <td><small>@(string.IsNullOrWhiteSpace(q.EventLocation) ? "—" : q.EventLocation)@(string.IsNullOrWhiteSpace(q.Budget) ? "" : $" · Vốn: {q.Budget}")</small></td>
                                <td><small>@q.Notes</small></td>
                                <td>@StatusBadge(q.Status)@if (q.Status == QuoteStatusConfirmed && q.DepositAmount > 0)
                                    {<br /><span class="badge badge-warning">Cọc @q.DepositAmount.Value.ToString("N0")đ</span>}</td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary mr-1" href="tel:@q.CustomerPhone">📞 Gọi</a>
                                    @if (q.Status == "New")
                                    {
                                        <button class="btn btn-sm btn-outline-info mr-1" @onclick='() => ChangeStatusAsync(q, "Contacted")'>Đã liên hệ</button>
                                    }
                                    @if (q.Status == "New" || q.Status == "Contacted")
                                    {
                                        <button class="btn btn-sm btn-outline-success mr-1" @onclick='() => OpenDepositModal(q)'>Duyệt &amp; cọc</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick='() => ChangeStatusAsync(q, "Cancelled")'>Hủy</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<hr class="my-4" />

<h4 class="mb-1">🔔 Nhắc cúng hàng tháng</h4>
<p class="text-muted">Khách đã đăng ký "Nhắc tôi mỗi tháng" ở trang <a href="/dat-cung">/dat-cung</a>. Tắt khi khách yêu cầu dừng nhắc.</p>

@if (_reminders == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_reminders.Count == 0)
{
    <div class="alert alert-info">Chưa có ai đăng ký nhắc cúng.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">🔔 Danh sách đăng ký nhắc cúng</h4>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Đăng ký</th>
                            <th scope="col">Khách hàng</th>
                            <th scope="col">SĐT</th>
                            <th scope="col">Dịp</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _reminders)
                        {
                            <tr @key="r.Id">
                                <td class="text-nowrap">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td><strong>@r.CustomerName</strong></td>
                                <td class="text-nowrap"><a href="tel:@r.CustomerPhone">@r.CustomerPhone</a></td>
                                <td>@(r.ReminderType == "Mung1" ? "🌑 Mùng 1" : "🌕 Rằm")</td>
                                <td>
                                    @if (r.IsActive)
                                    {
                                        <span class="badge badge-success">Đang nhắc</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Đã tắt</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary mr-1" href="tel:@r.CustomerPhone">📞 Gọi</a>
                                    <button class="btn btn-sm @(r.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                            @onclick="() => ToggleReminderAsync(r)">
                                        @(r.IsActive ? "Tắt nhắc" : "Bật lại")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* Item 161: modal duyệt & gửi link cọc *@
@if (_depositQuote != null)
{
    @* UIUX-1019 Agent4 (run 18:35): role="dialog" + aria-modal + aria-labelledby
       để trình đọc màn hình nhận diện đây là hộp thoại và đọc đúng tiêu đề;
       span × thêm aria-hidden để SR không đọc "times". *@
    <div class="modal fade show d-block lx-modal-veil" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="quotes-deposit-modal-title" @ref="_modalRef" @onkeydown="DepositModalKeyDown">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="quotes-deposit-modal-title">Duyệt &amp; gửi cọc — @_depositQuote.CustomerName</h5>
                    <button type="button" class="close" aria-label="Đóng" @onclick="CloseDepositModal"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    @if (!_depositSaved)
                    {
                        <div class="form-group">
                            <label>Số tiền cọc (₫) *</label>
                            <input type="number" class="form-control" min="0" step="1000" @bind="_depositAmount" />
                        </div>
                        <div class="form-group">
                            <label>Nội dung chuyển khoản gửi khách</label>
                            <input class="form-control" @bind="_depositInfo" placeholder="VD: Cọc tiệc 20/10 - Anh Tuấn" />
                            <small class="form-text text-muted">Để trống sẽ tự tạo: "Cọc báo giá [SĐT khách]".</small>
                        </div>
                        @if (!string.IsNullOrEmpty(_depositError))
                        {
                            <div class="alert alert-danger" role="alert">@_depositError</div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-success">Đã duyệt và lưu cọc. Gửi thông tin này cho khách:</div>
                        @if (!string.IsNullOrEmpty(_depositQrUrl))
                        {
                            <div class="text-center mb-3">
                                <img src="@_depositQrUrl" alt="QR cọc VietQR" class="quotes-deposit-qr" />
                            </div>
                        }
                        <table class="table table-sm">
                            <tr><td><strong>Số tiền cọc</strong></td><td><strong class="text-danger">@_depositAmount.ToString("N0")đ</strong></td></tr>
                            <tr><td><strong>Nội dung CK</strong></td><td>@_depositInfo</td></tr>
                        </table>
                        <small class="text-muted">Khách tự quét mã chuyển khoản như luồng cọc hiện tại của shop.</small>
                    }
                </div>
                <div class="modal-footer">
                    @if (!_depositSaved)
                    {
                        <button class="btn btn-secondary" @onclick="CloseDepositModal">Đóng</button>
                        <button class="btn btn-success" @onclick="SaveDepositAsync" disabled="@_savingDeposit">
                            @(_savingDeposit ? "Đang lưu..." : "Duyệt & lưu cọc")
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="CloseDepositModal">Xong</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<QuoteRequestAdminModel> _quotes;
    private List<XoiCungReminderModel> _reminders;
    private string _statusFilter;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        // Chạy TUẦN TỰ, không Task.WhenAll: 2 loader dùng chung 1
        // CatalogAdminService/HttpClient và cùng đi qua SetBearerToken —
        // khi access token vừa hết hạn, 2 call song song cùng refresh
        // token sẽ race nhau (refresh token chỉ dùng 1 lần, call đến sau
        // bị server từ chối) làm 1 trong 2 danh sách rỗng/lỗi ngay khi mở
        // màn. Project đã dính đúng lớp lỗi Task.WhenAll này trước đây.
        // Mỗi loader vẫn giữ try/catch fail-soft riêng.
        await LoadAsync();
        await LoadRemindersAsync();
    }

    private async Task LoadRemindersAsync()
    {
        try
        {
            _reminders = await CatalogAdminService.GetXoiCungRemindersAsync()
                ?? new List<XoiCungReminderModel>();
        }
        catch (Exception)
        {
            _reminders = new List<XoiCungReminderModel>();
        }
    }

    private async Task ToggleReminderAsync(XoiCungReminderModel reminder)
    {
        _error = null;
        _success = null;
        try
        {
            var updated = await CatalogAdminService.ToggleXoiCungReminderAsync(reminder.Id);
            reminder.IsActive = updated.IsActive;
            _success = $"Đã {(updated.IsActive ? "bật" : "tắt")} nhắc cúng cho {reminder.CustomerName}.";
        }
        catch (Exception)
        {
            _error = "Cập nhật trạng thái nhắc thất bại. Vui lòng thử lại.";
        }
    }

    private async Task SetStatus(string status)
    {
        _statusFilter = status;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _quotes = await CatalogAdminService.GetQuotesAsync(_statusFilter)
                ?? new List<QuoteRequestAdminModel>();
        }
        catch (Exception ex)
        {
            _quotes = new List<QuoteRequestAdminModel>();
            // Kèm message lỗi THẬT (mã HTTP/exception) để chẩn đoán được
            // nguyên nhân gốc — trước đây chỉ hiện câu chung chung nên
            // không biết server lỗi gì (user phản ánh 2026-10-20).
            _error = $"Không tải được danh sách yêu cầu báo giá. ({ex.Message})";
        }
    }

    private async Task ChangeStatusAsync(QuoteRequestAdminModel quote, string status)
    {
        _error = null;
        _success = null;
        try
        {
            var updated = await CatalogAdminService.UpdateQuoteStatusAsync(quote.Id, status);
            quote.Status = updated.Status;
            _success = $"Đã cập nhật trạng thái yêu cầu của {quote.CustomerName}.";
        }
        catch (Exception)
        {
            _error = "Cập nhật trạng thái thất bại. Vui lòng thử lại.";
        }
    }

    // Item 161: duyệt & gửi link cọc.
    private QuoteRequestAdminModel _depositQuote;
    @* UIUX-1020 Agent4 (a11y): đưa focus vào modal tiền cọc khi mở — screen reader đọc ngay
       role="dialog" + tiêu đề, người dùng bàn phím tab từ trong modal đi ra thay vì
       kẹt ở nút nền phía sau. tabindex="-1" trên lớp phủ cho phép FocusAsync() lập trình. *@
    private ElementReference _modalRef;
    private bool _focusModalOnOpen;
    private decimal _depositAmount;
    private string _depositInfo;
    private string _depositError;
    private bool _savingDeposit;
    private bool _depositSaved;
    private string _depositQrUrl;

    /// <summary>
    /// Template ảnh QR VietQR mặc định khi admin chưa đặt template riêng ở
    /// cài đặt ngân hàng. (codequality-team 2026-10-20 run-1905 Agent2-CleanCode:
    /// hằng số có tên thay magic string "compact2" rải trong code.)
    /// </summary>
    private const string DefaultQrTemplate = "compact2";

    /// <summary>
    /// Trạng thái báo giá đã chốt cọc — dùng 1 chỗ để sai chính tả không làm
    /// hỏng luồng lọc/chuyển trạng thái. (codequality-team 2026-10-20 run-1905
    /// Agent2-CleanCode: hằng số có tên thay magic string "Confirmed" dùng 5 nơi.)
    /// </summary>
    private const string QuoteStatusConfirmed = "Confirmed";

    private void OpenDepositModal(QuoteRequestAdminModel quote)
    {
        _depositQuote = quote;
        _depositAmount = 0;
        _depositInfo = null;
        _depositError = null;
        _depositSaved = false;
        _depositQrUrl = null;
        _focusModalOnOpen = true;
    }

    private void CloseDepositModal()
    {
        _depositQuote = null;
    }

    /// <summary>
    /// UIUX-1020 Agent4 (a11y): sau khi modal tiền cọc render xong, chuyển focus vào
    /// lớp phủ modal (đã có tabindex="-1"). Cờ _focusModalOnOpen chỉ bật khi vừa mở modal.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModalOnOpen && _depositQuote != null)
        {
            _focusModalOnOpen = false;
            await _modalRef.FocusAsync();
        }
    }

    /// <summary>
    /// UIUX-1020 Agent4 (a11y): đóng modal tiền cọc khi người dùng bấm Escape —
    /// @onkeydown đặt trên lớp phủ modal, sự kiện bàn phím bubble từ các ô nhập
    /// bên trong lên đây (người dùng bàn phím không phải tab tới nút Đóng).
    /// </summary>
    private void DepositModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseDepositModal();
    }

    private async Task SaveDepositAsync()
    {
        _depositError = null;
        if (_depositAmount <= 0)
        {
            _depositError = "Vui lòng nhập số tiền cọc lớn hơn 0.";
            return;
        }

        _savingDeposit = true;
        try
        {
            var depositNote = string.IsNullOrWhiteSpace(_depositInfo)
                ? $"Coc bao gia {_depositQuote.CustomerPhone}"
                : _depositInfo.Trim();

            // 1. Lưu cọc + 2. Chuyển trạng thái sang "Đã chốt".
            var updated = await CatalogAdminService.SetQuoteDepositAsync(_depositQuote.Id, _depositAmount, depositNote);
            await CatalogAdminService.UpdateQuoteStatusAsync(_depositQuote.Id, QuoteStatusConfirmed);
            _depositQuote.Status = QuoteStatusConfirmed;
            _depositQuote.DepositAmount = updated.DepositAmount;
            _depositQuote.DepositInfo = updated.DepositInfo;
            _depositInfo = depositNote;

            // 3. Tạo QR VietQR để gửi khách.
            _depositQrUrl = await BuildDepositQrUrlAsync(depositNote);

            _depositSaved = true;
            _success = $"Đã duyệt báo giá của {_depositQuote.CustomerName} với cọc {_depositAmount:N0}đ.";
        }
        catch (Exception)
        {
            _depositError = "Lưu cọc thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _savingDeposit = false;
        }
    }

    /// <summary>
    /// Item 161: dựng URL ảnh QR VietQR để gửi khách thanh toán tiền cọc.
    /// Tách khỏi <see cref="SaveDepositAsync"/> để method lưu cọc chỉ còn 1
    /// việc điều phối 3 bước (fail-soft: lỗi/không cấu hình → trả null, không
    /// làm hỏng bước lưu cọc; logic giữ nguyên).
    /// </summary>
    /// <param name="depositNote">Nội dung chuyển khoản (ghi vào addInfo của QR).</param>
    /// <returns>URL ảnh QR, hoặc null khi không lấy được thông tin ngân hàng.</returns>
    private async Task<string> BuildDepositQrUrlAsync(string depositNote)
    {
        try
        {
            var bank = await CatalogAdminService.GetBankTransferInfoAsync();
            if (bank == null || !bank.IsConfigured)
            {
                return null;
            }

            var template = string.IsNullOrWhiteSpace(bank.QrTemplate) ? DefaultQrTemplate : bank.QrTemplate;
            return $"https://img.vietqr.io/image/{bank.BankId}-{bank.AccountNumber}-{template}.png"
                + $"?amount={(long)_depositAmount}&addInfo={Uri.EscapeDataString(depositNote)}";
        }
        catch (Exception)
        {
            // Fail-soft: không có QR thì cọc vẫn lưu thành công, admin gửi tay.
            return null;
        }
    }

    private static RenderFragment QuoteTypeBadge(string quoteType) => builder =>
    {
        var (css, label) = quoteType?.Trim() switch
        {
            "DatTiec" => ("lx-pill lx-pill-warning", "🎉 Tiệc"),
            "SoLuongLon" => ("lx-pill lx-pill-warning", "📦 Số lượng lớn"),
            "DatCung" => ("lx-pill lx-pill-primary", "🙏 Cúng"),
            "CungGio" => ("lx-pill lx-pill-primary", "🕯️ Cúng giỗ"),
            "NhuongQuyen" => ("lx-pill lx-pill-primary", "🏪 Nhượng quyền"),
            _ => ("lx-pill lx-pill-secondary", "Web"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, label);
        builder.CloseElement();
    };

    private static RenderFragment StatusBadge(string status) => builder =>
    {
        var (css, label) = status switch
        {
            "New" => ("badge badge-warning", "Mới"),
            "Contacted" => ("badge badge-info", "Đã liên hệ"),
            QuoteStatusConfirmed => ("badge badge-success", "Đã chốt"),
            "Cancelled" => ("badge badge-danger", "Hủy"),
            _ => ("badge badge-light", status)
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}
