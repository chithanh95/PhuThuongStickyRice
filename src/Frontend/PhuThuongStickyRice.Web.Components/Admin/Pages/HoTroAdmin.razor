@page "/admin/ho-tro"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject Wave2Service Wave2Service

<h3>Yêu cầu hỗ trợ</h3>

<div class="btn-group mb-3" role="group">
    @foreach (var s in _statusFilters)
    {
        <button class="btn btn-sm @(_statusFilter == s.Key ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => SetFilter(s.Key)">@s.Value</button>
    }
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_tickets == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_tickets.Count == 0)
{
    <div class="alert alert-info">Không có yêu cầu nào.</div>
}
else
{
    @foreach (var t in _tickets)
    {
        <div class="card mb-2">
            <div class="card-header p-2 d-flex justify-content-between align-items-center">
                <span>
                    <strong>@t.Name</strong> — @t.Phone
                    @if (!string.IsNullOrWhiteSpace(t.OrderNumber))
                    {
                        <small class="text-muted ml-2">Đơn: @t.OrderNumber</small>
                    }
                </span>
                @TicketBadge(t.Status)
            </div>
            <div class="card-body p-2">
                <p class="mb-1">@t.Message</p>
                <small class="text-muted">@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                @if (!string.IsNullOrWhiteSpace(t.ReplyNote))
                {
                    <div class="alert alert-light border mt-2 mb-1 py-1">
                        <small><strong>Phản hồi:</strong> @t.ReplyNote</small>
                    </div>
                }
                @if (_replying?.Id == t.Id)
                {
                    <div class="form-group mt-2">
                        <label>Ghi chú phản hồi</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_replyNote"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="col-auto">
                            <button class="btn btn-sm btn-warning" @onclick='() => SaveReply("InProgress")' disabled="@_saving">Đang xử lý</button>
                            <button class="btn btn-sm btn-success ml-1" @onclick='() => SaveReply("Done")' disabled="@_saving">Đã xong</button>
                            <button class="btn btn-sm btn-outline-secondary ml-1" @onclick="() => _replying = null">Đóng</button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_replyError))
                    {
                        <div class="alert alert-danger mt-2 mb-0 py-1">@_replyError</div>
                    }
                }
                else
                {
                    <button class="btn btn-sm btn-outline-primary mt-1" @onclick="() => OpenReply(t)">Trả lời / cập nhật</button>
                }
            </div>
        </div>
    }
}

@code {
    private readonly System.Collections.Generic.Dictionary<string, string> _statusFilters =
        new System.Collections.Generic.Dictionary<string, string>
        {
            { "", "Tất cả" },
            { "New", "Mới" },
            { "InProgress", "Đang xử lý" },
            { "Done", "Đã xong" }
        };

    private List<SupportTicketModel> _tickets;
    private string _statusFilter = "";
    private string _error;
    private SupportTicketModel _replying;
    private string _replyNote;
    private string _replyError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task SetFilter(string status)
    {
        _statusFilter = status;
        await Load();
    }

    private async Task Load()
    {
        _error = null;
        try
        {
            _tickets = await Wave2Service.GetTicketsAsync(_statusFilter)
                ?? new List<SupportTicketModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách.";
            _tickets = new List<SupportTicketModel>();
        }
    }

    private void OpenReply(SupportTicketModel ticket)
    {
        _replying = ticket;
        _replyNote = ticket.ReplyNote;
        _replyError = null;
    }

    private async Task SaveReply(string status)
    {
        _replyError = null;
        if (string.IsNullOrWhiteSpace(_replyNote))
        {
            _replyError = "Vui lòng nhập ghi chú phản hồi.";
            return;
        }

        _saving = true;
        try
        {
            await Wave2Service.ReplyTicketAsync(_replying.Id, _replyNote, status);
            _replying = null;
            await Load();
        }
        catch (Exception)
        {
            _replyError = "Không lưu được. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static RenderFragment TicketBadge(string status) => builder =>
    {
        var (css, label) = status switch
        {
            "New" => ("badge badge-danger", "Mới"),
            "InProgress" => ("badge badge-warning", "Đang xử lý"),
            "Done" => ("badge badge-success", "Đã xong"),
            _ => ("badge badge-light", status)
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}
