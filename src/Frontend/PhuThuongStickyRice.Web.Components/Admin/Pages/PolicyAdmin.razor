@page "/admin/chinh-sach"
@attribute [Authorize]
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject PolicyService PolicyService

<h3>Trang chính sách</h3>
<p class="text-muted">Hiển thị tại <code>/chinh-sach/{slug}</code>. Slug không đổi được — chỉ sửa tiêu đề và nội dung.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_pages == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>Tiêu đề</th><th>Slug</th><th>Thứ tự</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _pages)
                {
                    <tr @key="p.Id">
                        <td>@p.Title</td>
                        <td><code>/chinh-sach/@p.Slug</code></td>
                        <td>@p.SortOrder</td>
                        <td class="text-right" style="white-space: nowrap;">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(p)">Sửa</button>
                            <a class="btn btn-sm btn-outline-secondary ml-1" href="/chinh-sach/@p.Slug" target="_blank">Xem</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_editing != null)
{
    <div class="card mb-3">
        <div class="card-header">Sửa: <code>/chinh-sach/@_editing.Slug</code></div>
        <div class="card-body">
            <div class="form-group">
                <label>Tiêu đề *</label>
                <input class="form-control" @bind="_editing.Title" maxlength="200" />
            </div>
            <div class="form-group">
                <label>Nội dung *</label>
                <textarea class="form-control" rows="14" @bind="_editing.Body"></textarea>
                <small class="form-text text-muted">Văn bản thuần — mỗi dòng trống tách thành một đoạn.</small>
            </div>
            <div class="form-group" style="max-width: 160px;">
                <label>Thứ tự</label>
                <input type="number" class="form-control" @bind="_editing.SortOrder" />
            </div>
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="alert alert-danger">@_saveError</div>
            }
            <button class="btn btn-success" @onclick="Save" disabled="@_saving">
                @(_saving ? "Đang lưu..." : "Lưu")
            </button>
            <button class="btn btn-outline-secondary ml-2" @onclick="() => _editing = null">Hủy</button>
        </div>
    </div>
}

@code {
    private List<PolicyPageModel> _pages;
    private PolicyPageModel _editing;
    private bool _saving;
    private string _error;
    private string _success;
    private string _saveError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _pages = await PolicyService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"Không tải được danh sách: {ex.Message}";
            _pages = new List<PolicyPageModel>();
        }
    }

    private void Edit(PolicyPageModel p)
    {
        _success = null;
        _saveError = null;
        _editing = new PolicyPageModel
        {
            Id = p.Id,
            Slug = p.Slug,
            Title = p.Title,
            Body = p.Body,
            SortOrder = p.SortOrder
        };
    }

    private async Task Save()
    {
        _saveError = null;
        if (string.IsNullOrWhiteSpace(_editing.Title) || string.IsNullOrWhiteSpace(_editing.Body))
        {
            _saveError = "Tiêu đề và nội dung không được để trống.";
            return;
        }

        _saving = true;
        try
        {
            var saved = await PolicyService.UpdateAsync(_editing.Id, _editing);
            var existing = _pages.Find(x => x.Id == saved.Id);
            if (existing != null)
            {
                existing.Title = saved.Title;
                existing.Body = saved.Body;
                existing.SortOrder = saved.SortOrder;
                _pages.Sort((a, b) => a.SortOrder.CompareTo(b.SortOrder));
            }

            _editing = null;
            _success = "Đã lưu thay đổi.";
        }
        catch (Exception ex)
        {
            _saveError = $"Không lưu được: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
