@page "/admin/dinh-ky"
@attribute [Authorize]
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@inject Wave2Service Wave2Service

<h3>Đặt định kỳ</h3>
<p class="text-muted">
    Danh sách đăng ký giao xôi định kỳ. Hệ thống tự tạo đơn COD mỗi sáng cho các
    đăng ký <strong>đang bật</strong>.
</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="mb-3">
    <div class="btn-group" role="group">
        <button class="btn @FilterClass(null)" @onclick="() => SetFilter(null)">Tất cả</button>
        <button class="btn @FilterClass(true)" @onclick="() => SetFilter(true)">Đang bật</button>
        <button class="btn @FilterClass(false)" @onclick="() => SetFilter(false)">Tạm dừng</button>
    </div>
    <button class="btn btn-outline-secondary ml-2" @onclick="Load">↻ Tải lại</button>
</div>

@if (_loading)
{
    <p class="text-muted">Đang tải...</p>
}
else if (_items.Count == 0)
{
    <div class="alert alert-info">Chưa có đăng ký nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Khách</th>
                    <th>Món</th>
                    <th>SL/lần</th>
                    <th>Đơn giá</th>
                    <th>Địa chỉ giao</th>
                    <th>Bắt đầu</th>
                    <th>Đơn cuối</th>
                    <th>Ghi chú</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _items)
                {
                    <tr>
                        <td>@s.CustomerName<br /><small class="text-muted">@s.Phone</small></td>
                        <td>
                            @s.ProductName
                            @if (!string.IsNullOrWhiteSpace(s.SizeName))
                            {
                                <small class="text-muted">(@s.SizeName)</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.ToppingNames))
                            {
                                <br /><small class="text-muted">+ @s.ToppingNames</small>
                            }
                        </td>
                        <td>@s.Quantity</td>
                        <td>@($"{s.UnitPrice:N0} ₫")</td>
                        <td><small>@s.DeliveryAddress</small></td>
                        <td>@s.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@(s.LastOrderDate?.ToString("dd/MM") ?? "—")</td>
                        <td><small>@s.Notes</small></td>
                        <td>
                            <button class="btn btn-sm @(s.Active ? "btn-success" : "btn-secondary")"
                                    @onclick="() => ToggleActive(s)" disabled="@_toggling">
                                @(s.Active ? "Đang bật" : "Tạm dừng")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SubscriptionModel> _items = new List<SubscriptionModel>();
    private bool? _activeOnly = true;
    private bool _loading;
    private bool _toggling;
    private string _error;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task SetFilter(bool? activeOnly)
    {
        _activeOnly = activeOnly;
        await Load();
    }

    private string FilterClass(bool? v) =>
        _activeOnly == v ? "btn-primary" : "btn-outline-primary";

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Wave2Service.GetSubscriptionsAsync(_activeOnly)
                ?? new List<SubscriptionModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách. Vui lòng thử lại.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleActive(SubscriptionModel s)
    {
        _toggling = true;
        try
        {
            var updated = await Wave2Service.SetSubscriptionActiveAsync(s.Id, !s.Active);
            s.Active = updated?.Active ?? !s.Active;
            if (_activeOnly.HasValue && s.Active != _activeOnly.Value)
            {
                _items.Remove(s);
            }
        }
        catch (Exception)
        {
            _error = "Đổi trạng thái thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _toggling = false;
        }
    }
}
