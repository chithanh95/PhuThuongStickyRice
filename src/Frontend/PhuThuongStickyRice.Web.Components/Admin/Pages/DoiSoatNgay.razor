@page "/admin/doi-soat-ngay"
@attribute [Authorize(Roles = "Admin")]
@using PhuThuongStickyRice.Web.Components.Orders.Models
@using PhuThuongStickyRice.Web.Components.Orders.Services
@inject OrderService OrderService

<div class="lx-page-head">
    <h4 class="lx-page-title">Đối soát theo ngày</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li class="current">Đối soát theo ngày</li>
    </ol>
</div>
<p class="text-muted">
    Doanh thu theo kênh thanh toán trong ngày (giờ Việt Nam). Đơn đã hủy không tính vào doanh thu.
</p>

<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">Chọn ngày</h4>
        <div class="form-row align-items-end">
            <div class="col-md-3 col-8">
                <label class="mb-1"><small class="text-muted">Ngày</small></label>
                <input type="date" class="form-control" @bind="_date" @bind:after="LoadAsync" />
            </div>
            <div class="col-md-9 col-4 text-right">
                <button class="btn btn-primary" @onclick="LoadAsync" disabled="@_loading">
                    @(_loading ? "Đang tải..." : "Xem")
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_data == null)
{
    @if (!_loading)
    {
        <p><em>Chọn ngày và bấm "Xem".</em></p>
    }
}
else
{
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Đối soát ngày @_data.Date.ToString("dd/MM/yyyy")</h4>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Kênh thanh toán</th>
                            <th scope="col" class="text-right">Số đơn</th>
                            <th scope="col" class="text-right">Doanh thu</th>
                            <th scope="col" class="text-right">Đã thanh toán</th>
                            <th scope="col" class="text-right">Chưa thanh toán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _data.Channels)
                        {
                            <tr @key="c.PaymentMethod">
                                <td><strong>@c.Label</strong></td>
                                <td class="text-right">@c.OrderCount</td>
                                <td class="text-right"><strong>@FormatPrice(c.Revenue)</strong></td>
                                <td class="text-right text-success">@FormatPrice(c.PaidAmount)</td>
                                <td class="text-right @(c.UnpaidAmount > 0 ? "text-danger" : "")">@FormatPrice(c.UnpaidAmount)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="lx-total-row">
                            <th scope="row">Tổng cộng</th>
                            <th class="text-right">@_data.TotalOrderCount</th>
                            <th class="text-right">@FormatPrice(_data.TotalRevenue)</th>
                            <th class="text-right">@FormatPrice(_data.TotalPaidAmount)</th>
                            <th class="text-right">@FormatPrice(_data.TotalUnpaidAmount)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    @if (_data.TotalOrderCount == 0)
    {
        <div class="alert alert-info mt-3">Không có đơn nào trong ngày đã chọn.</div>
    }
}

<style>
    .lx-total-row th { background: #7a6fbe; color: #fff; border-color: #7a6fbe; }
    html.dark .lx-total-row th { background: #5a4fa0; border-color: #5a4fa0; }
</style>

@code {
    // Wave 6c (item 31): daily payment-channel reconciliation.
    private DateTime _date = DateTime.Now.Date;
    private DailyReconciliationModel _data;
    private bool _loading;
    private string _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await OrderService.GetReconciliationAsync(_date);
        }
        catch (Exception ex)
        {
            _error = "Không tải được dữ liệu: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";
}
