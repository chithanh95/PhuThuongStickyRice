@page "/admin/danh-gia"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Orders.Services
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject ShopEngagementService ShopEngagementService
@inject OrderService OrderService
@inject AdminCommerceService AdminCommerceService

<div class="lx-page-head">
    <h4 class="lx-page-title">Đánh giá đơn hàng</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Huyền</a></li>
        <li>Nội dung</li>
        <li class="current">Đánh giá</li>
    </ol>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success">@_message</div>
}

@* Item 234: món bị chê nhiều (≥3 đánh giá 1–2 sao trong 30 ngày). *@
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="card-title mb-0">⚠️ Món bị chê nhiều</h4>
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadPoorlyRated" disabled="@_loadingPoorlyRated">
                @(_loadingPoorlyRated ? "Đang tải..." : "↻ Tải lại")
            </button>
        </div>
        <p class="card-title-desc">Món có từ 3 đánh giá 1–2 sao trở lên trong 30 ngày qua — nên xem lại công thức/chất lượng sớm.</p>
        @if (_loadingPoorlyRated)
        {
            <p><em>Đang tải...</em></p>
        }
        else if (_poorlyRated == null || _poorlyRated.Count == 0)
        {
            <p class="text-success mb-0">✅ Không có món nào bị chê nhiều trong 30 ngày qua.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Món</th>
                            <th scope="col" class="dg-col-che">Lượt chê</th>
                            <th scope="col" class="dg-col-avg">Điểm TB</th>
                            <th scope="col">Khách chê gì</th>
                            <th scope="col" class="dg-col-latest">Gần nhất</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dish in _poorlyRated)
                        {
                            <tr @key="dish.ProductName">
                                <td class="font-weight-bold">@dish.ProductName</td>
                                <td><span class="badge badge-danger">@dish.BadCount lượt</span></td>
                                <td>@dish.AvgRating.ToString("0.0") ★</td>
                                <td>
                                    @if (dish.SampleComments.Count == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <ul class="mb-0 pl-3">
                                            @foreach (var c in dish.SampleComments)
                                            {
                                                <li class="small">@c</li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td class="text-nowrap small">@dish.LastBadAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_reviews == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_reviews.Count == 0)
{
    <div class="alert alert-info">Chưa có đánh giá nào.</div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Danh sách đánh giá</h4>
                    <p class="card-title-desc">Đánh giá bị ẩn không hiển thị công khai. Phản hồi của quán hiển thị dưới đánh giá trên trang chủ.</p>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th scope="col">Đơn hàng</th><th scope="col">SĐT</th><th scope="col">Sao</th><th scope="col">Nhận xét</th><th scope="col">Ảnh</th><th scope="col">Quà tặng</th><th scope="col">Phản hồi</th><th scope="col">Ngày</th><th scope="col"></th></tr>
            </thead>
            <tbody>
                @foreach (var review in _reviews)
                {
                    <tr class="@(review.IsHidden ? "table-secondary" : "")">
                        <td><a href="/orders">@review.OrderNumber</a></td>
                        <td>@review.CustomerPhone</td>
                        @* A11y uiux-2026-10-20: sao là chữ ★ thuần — trình đọc màn hình
                           sẽ đọc từng ký tự vô nghĩa. role="img" + aria-label
                           để đọc "Đánh giá X trên 5 sao". *@
                        <td class="dg-stars" role="img" aria-label="Đánh giá @review.Rating trên 5 sao">
                            @(new string('★', review.Rating))<span class="dg-stars-off">@(new string('★', 5 - review.Rating))</span>
                        </td>
                        <td>
                            @review.Comment
                            @if (review.IsHidden)
                            {
                                <span class="badge badge-dark ml-1">Đã ẩn</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(review.PhotoUrl))
                            {
                                <a href="@review.PhotoUrl" target="_blank" rel="noopener">
                                    <img src="@review.PhotoUrl" alt="Ảnh đánh giá" class="dg-photo-thumb" />
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(review.RewardCode))
                            {
                                <span class="badge badge-success" title="Đã tặng 1 phần xôi (mã giảm giá)">
                                    🎁 @review.RewardCode
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(review.PhotoUrl))
                            {
                                <span class="badge badge-warning" title="Có ảnh nhưng chưa có mã quà">⏳ Chưa có mã</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (_replyingId == review.Id)
                            {
                                <div class="input-group">
                                    <input class="form-control form-control-sm" placeholder="Phản hồi của quán..."
                                           @bind="_replyText" />
                                    <div class="input-group-append">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveReply(review)">Lưu</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelReply">Hủy</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <small class="text-muted">@review.AdminReply</small>
                            }
                        </td>
                        <td><small>@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td class="text-right dg-actions">
                            <button class="btn btn-sm btn-outline-secondary mr-1" @onclick="() => StartReply(review)">
                                💬 Phản hồi
                            </button>
                            @if (review.IsHidden)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SetHidden(review, false)">Hiện</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => SetHidden(review, true)">Ẩn</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Ảnh check-in chờ duyệt</h4>
                <p class="card-title-desc">Ảnh khách đăng ở trang <a href="/check-in" target="_blank">/check-in</a>. Duyệt mới hiện trên tường ảnh.</p>

@if (_pendingPhotos == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_pendingPhotos.Count == 0)
{
    <div class="alert alert-info">Không có ảnh nào chờ duyệt.</div>
}
else
{
    <div class="row">
        @foreach (var p in _pendingPhotos)
        {
            <div class="col-6 col-md-3 mb-3" @key="p.Id">
                <div class="card h-100">
                    <a href="@AdminCommerceService.ResolveImageUrl(p.ImageUrl)" target="_blank" rel="noopener">
                        <img loading="lazy" decoding="async" src="@AdminCommerceService.ResolveImageUrl(p.ImageUrl)" class="card-img-top dg-checkin-photo" alt="Ảnh check-in chờ duyệt" />
                    </a>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrWhiteSpace(p.Name))
                        {
                            <p class="mb-1"><strong>@p.Name</strong></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.Caption))
                        {
                            <p class="small text-muted mb-1">@p.Caption</p>
                        }
                        <small class="text-muted">@p.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                    </div>
                    <div class="card-footer p-2 d-flex">
                        <button class="btn btn-sm btn-success flex-fill mr-1" @onclick="() => ApprovePhoto(p)">Duyệt</button>
                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => AskRejectPhoto(p)">Xóa</button>
                    </div>
                </div>
            </div>
        }
    </div>
}
            </div>
        </div>
    </div>
</div>

@* Bug-hunt 2026-10-20: hỏi xác nhận trước khi lưu phản hồi TRỐNG đè lên
   phản hồi đã có — trước đây bấm Lưu với ô trống là xóa vĩnh viễn phản hồi
   cũ mà không hỏi, không báo. Dùng chung ConfirmDialog như trang Khuyến mãi. *@
<ConfirmDialog @ref="EmptyReplyDialog" Title="Xóa phản hồi" YesText="Xóa phản hồi" NoText="Giữ lại" ConfirmEventCallback="ConfirmedEmptyReply">
    <Message>
        Nội dung phản hồi đang để trống — bấm <strong>Xóa phản hồi</strong> sẽ xóa vĩnh viễn phản hồi hiện tại của đánh giá này.
    </Message>
</ConfirmDialog>

@* Bug-hunt 2026-10-20: hỏi xác nhận trước khi xóa ảnh check-in của khách —
   trước đây bấm Xóa là xóa vĩnh viễn ngay, không hỏi. *@
<ConfirmDialog @ref="RejectPhotoDialog" Title="Xóa ảnh check-in" YesText="Xóa ảnh" NoText="Giữ lại" ConfirmEventCallback="ConfirmedRejectPhoto">
    <Message>
        Bạn có chắc muốn xóa ảnh check-in@(string.IsNullOrWhiteSpace(_pendingRejectPhoto?.Name) ? "" : $" của <strong>{_pendingRejectPhoto.Name}</strong>")? Thao tác này không thể hoàn tác.
    </Message>
</ConfirmDialog>

@code {
    private List<OrderReviewModel> _reviews;
    private string _error;
    private string _message;

    // Reply-in-progress state.
    private Guid _replyingId;
    private string _replyText;

    // Bug-hunt 2026-10-20: review đang chờ xác nhận xóa phản hồi (dialog
    // "Xóa phản hồi") — tránh bấm Lưu với ô trống xóa nhầm phản hồi cũ.
    private ConfirmDialog EmptyReplyDialog;
    private OrderReviewModel _pendingEmptyReply;

    // Bug-hunt 2026-10-20: ảnh check-in đang chờ xác nhận xóa (dialog
    // "Xóa ảnh check-in") — tránh bấm nhầm mất ảnh của khách.
    private ConfirmDialog RejectPhotoDialog;
    private CustomerPhotoModel _pendingRejectPhoto;

    // Check-in photos pending moderation (item 93).
    private List<CustomerPhotoModel> _pendingPhotos;

    // Item 234: món bị chê nhiều.
    private List<PhuThuongStickyRice.Web.Components.Orders.Models.PoorlyRatedDishModel> _poorlyRated;
    private bool _loadingPoorlyRated;

    protected override async Task OnInitializedAsync()
    {
        // 3 loader độc lập (reviews, ảnh chờ duyệt, món bị chê) -> chạy song song cắt ~2 round-trip nối tiếp;
        // mỗi loader giữ try/catch fail-soft riêng, ghi field khác nhau nên không race.
        await Task.WhenAll(LoadAsync(), LoadPoorlyRated());
    }

    /// <summary>Item 234: tải danh sách món bị chê nhiều.</summary>
    private async Task LoadPoorlyRated()
    {
        _loadingPoorlyRated = true;
        try
        {
            _poorlyRated = await OrderService.GetPoorlyRatedDishesAsync()
                ?? new List<PhuThuongStickyRice.Web.Components.Orders.Models.PoorlyRatedDishModel>();
        }
        catch
        {
            _poorlyRated = new List<PhuThuongStickyRice.Web.Components.Orders.Models.PoorlyRatedDishModel>();
        }
        finally
        {
            _loadingPoorlyRated = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _reviews = await ShopEngagementService.GetReviewsAsync() ?? new List<OrderReviewModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được đánh giá.";
            _reviews = new List<OrderReviewModel>();
        }
        await LoadPendingPhotosAsync();
    }

    private async Task LoadPendingPhotosAsync()
    {
        try
        {
            _pendingPhotos = await AdminCommerceService.GetCustomerPhotosAsync(pendingOnly: true)
                ?? new List<CustomerPhotoModel>();
        }
        catch (Exception)
        {
            _pendingPhotos = new List<CustomerPhotoModel>();
        }
    }

    private async Task ApprovePhoto(CustomerPhotoModel p)
    {
        try
        {
            await AdminCommerceService.ApproveCustomerPhotoAsync(p.Id);
            _pendingPhotos.Remove(p);
            _message = "Đã duyệt ảnh check-in.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Hỏi xác nhận trước khi xóa ảnh check-in của khách (tránh bấm nhầm).
    /// </summary>
    private void AskRejectPhoto(CustomerPhotoModel p)
    {
        _pendingRejectPhoto = p;
        _error = null;
        RejectPhotoDialog.Show();
    }

    private async Task ConfirmedRejectPhoto()
    {
        if (_pendingRejectPhoto == null)
        {
            return;
        }

        try
        {
            await AdminCommerceService.RejectCustomerPhotoAsync(_pendingRejectPhoto.Id);
            _pendingPhotos.Remove(_pendingRejectPhoto);
            RejectPhotoDialog.Close();
            _pendingRejectPhoto = null;
            _message = "Đã xóa ảnh check-in.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SetHidden(OrderReviewModel review, bool hidden)
    {
        _error = null;
        _message = null;
        try
        {
            await OrderService.SetReviewHiddenAsync(review.Id, hidden);
            review.IsHidden = hidden;
            _message = hidden ? "Đã ẩn đánh giá khỏi công khai." : "Đã hiển thị lại đánh giá.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void StartReply(OrderReviewModel review)
    {
        _replyingId = review.Id;
        _replyText = review.AdminReply;
    }

    private void CancelReply()
    {
        _replyingId = Guid.Empty;
        _replyText = null;
    }

    /// <summary>
    /// Lưu phản hồi admin cho một đánh giá: kiểm tra nội dung trống thì hỏi
    /// xác nhận trước, có phản hồi cũ thì hỏi xác nhận ghi đè.
    /// </summary>
    /// <param name="review">Đánh giá cần lưu phản hồi.</param>
    private async Task SaveReply(OrderReviewModel review)
    {
        _error = null;
        _message = null;

        // Bug-hunt 2026-10-20: ô phản hồi để trống —
        // - chưa từng có phản hồi: chặn luôn (lưu trống là vô nghĩa);
        // - đã có phản hồi: hỏi xác nhận vì bấm Lưu = xóa vĩnh viễn phản hồi cũ.
        if (string.IsNullOrWhiteSpace(_replyText))
        {
            if (!string.IsNullOrWhiteSpace(review.AdminReply))
            {
                _pendingEmptyReply = review;
                EmptyReplyDialog.Show();
                return;
            }

            _error = "Vui lòng nhập nội dung phản hồi.";
            return;
        }

        await SaveReplyAsync(review);
    }

    /// <summary>
    /// Bug-hunt 2026-10-20: admin đã xác nhận xóa phản hồi ở dialog —
    /// lưu nội dung trống (server trim thành null) đè lên phản hồi cũ.
    /// </summary>
    private async Task ConfirmedEmptyReply()
    {
        var review = _pendingEmptyReply;
        _pendingEmptyReply = null;
        EmptyReplyDialog.Close();
        if (review == null)
        {
            return;
        }

        _replyText = string.Empty;
        await SaveReplyAsync(review);
        _message = "Đã xóa phản hồi.";
    }

    /// <summary>
    /// Gọi API lưu phản hồi admin cho đánh giá rồi cập nhật lại dòng hiển thị
    /// (không reload cả bảng) để giữ nguyên vị trí cuộn của trang.
    /// </summary>
    /// <param name="review">Đánh giá cần lưu phản hồi.</param>
    private async Task SaveReplyAsync(OrderReviewModel review)
    {
        _error = null;
        _message = null;
        try
        {
            await OrderService.ReplyReviewAsync(review.Id, _replyText ?? string.Empty);
            review.AdminReply = _replyText?.Trim();
            CancelReply();
            _message = "Đã lưu phản hồi.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
