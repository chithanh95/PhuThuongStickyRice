@page "/admin/danh-gia"
@attribute [Authorize]
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Shop.Services
@using PhuThuongStickyRice.Web.Components.Orders.Services
@using PhuThuongStickyRice.Web.Components.Admin.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@inject Wave2Service Wave2Service
@inject OrderService OrderService
@inject Wave5Service Wave5Service

<div class="lx-page-head">
    <h4 class="lx-page-title">Đánh giá đơn hàng</h4>
    <ol class="lx-breadcrumb">
        <li><a href="/dashboard">Xôi Phú Thượng</a></li>
        <li>Nội dung</li>
        <li class="current">Đánh giá</li>
    </ol>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success">@_message</div>
}

@if (_reviews == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_reviews.Count == 0)
{
    <div class="alert alert-info">Chưa có đánh giá nào.</div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Danh sách đánh giá</h4>
                    <p class="card-title-desc">Đánh giá bị ẩn không hiển thị công khai. Phản hồi của quán hiển thị dưới đánh giá trên trang chủ.</p>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Đơn hàng</th><th>SĐT</th><th>Sao</th><th>Nhận xét</th><th>Ảnh</th><th>Quà tặng</th><th>Phản hồi</th><th>Ngày</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in _reviews)
                {
                    <tr class="@(r.IsHidden ? "table-secondary" : "")">
                        <td><a href="/orders">@r.OrderNumber</a></td>
                        <td>@r.CustomerPhone</td>
                        <td style="color: #f6c453; font-size: 16px; white-space: nowrap;">
                            @(new string('★', r.Rating))<span style="color: #ddd;">@(new string('★', 5 - r.Rating))</span>
                        </td>
                        <td>
                            @r.Comment
                            @if (r.IsHidden)
                            {
                                <span class="badge badge-dark ml-1">Đã ẩn</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.PhotoUrl))
                            {
                                <a href="@r.PhotoUrl" target="_blank" rel="noopener">
                                    <img src="@r.PhotoUrl" alt="Ảnh đánh giá"
                                         style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;" />
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.RewardCode))
                            {
                                <span class="badge badge-success" title="Đã tặng 1 phần xôi (mã giảm giá)">
                                    🎁 @r.RewardCode
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(r.PhotoUrl))
                            {
                                <span class="badge badge-warning" title="Có ảnh nhưng chưa có mã quà">⏳ Chưa có mã</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (_replyingId == r.Id)
                            {
                                <div class="input-group">
                                    <input class="form-control form-control-sm" placeholder="Phản hồi của quán..."
                                           @bind="_replyText" />
                                    <div class="input-group-append">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveReply(r)">Lưu</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelReply">Hủy</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <small class="text-muted">@r.AdminReply</small>
                            }
                        </td>
                        <td><small>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td class="text-right" style="white-space: nowrap;">
                            <button class="btn btn-sm btn-outline-secondary mr-1" @onclick="() => StartReply(r)">
                                💬 Phản hồi
                            </button>
                            @if (r.IsHidden)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SetHidden(r, false)">Hiện</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => SetHidden(r, true)">Ẩn</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Ảnh check-in chờ duyệt</h4>
                <p class="card-title-desc">Ảnh khách đăng ở trang <a href="/check-in" target="_blank">/check-in</a>. Duyệt mới hiện trên tường ảnh.</p>

@if (_pendingPhotos == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_pendingPhotos.Count == 0)
{
    <div class="alert alert-info">Không có ảnh nào chờ duyệt.</div>
}
else
{
    <div class="row">
        @foreach (var p in _pendingPhotos)
        {
            <div class="col-6 col-md-3 mb-3" @key="p.Id">
                <div class="card h-100">
                    <a href="@Wave5Service.ResolveImageUrl(p.ImageUrl)" target="_blank" rel="noopener">
                        <img src="@Wave5Service.ResolveImageUrl(p.ImageUrl)" class="card-img-top" alt="Ảnh check-in chờ duyệt"
                             style="height: 160px; object-fit: cover;" />
                    </a>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrWhiteSpace(p.Name))
                        {
                            <p class="mb-1"><strong>@p.Name</strong></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.Caption))
                        {
                            <p class="small text-muted mb-1">@p.Caption</p>
                        }
                        <small class="text-muted">@p.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                    </div>
                    <div class="card-footer p-2 d-flex">
                        <button class="btn btn-sm btn-success flex-fill mr-1" @onclick="() => ApprovePhoto(p)">Duyệt</button>
                        <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => RejectPhoto(p)">Xóa</button>
                    </div>
                </div>
            </div>
        }
    </div>
}
            </div>
        </div>
    </div>
</div>

@code {
    private List<OrderReviewModel> _reviews;
    private string _error;
    private string _message;

    // Reply-in-progress state.
    private Guid _replyingId;
    private string _replyText;

    // Check-in photos pending moderation (item 93).
    private List<CustomerPhotoModel> _pendingPhotos;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _reviews = await Wave2Service.GetReviewsAsync() ?? new List<OrderReviewModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được đánh giá.";
            _reviews = new List<OrderReviewModel>();
        }
        await LoadPendingPhotosAsync();
    }

    private async Task LoadPendingPhotosAsync()
    {
        try
        {
            _pendingPhotos = await Wave5Service.GetCustomerPhotosAsync(pendingOnly: true)
                ?? new List<CustomerPhotoModel>();
        }
        catch (Exception)
        {
            _pendingPhotos = new List<CustomerPhotoModel>();
        }
    }

    private async Task ApprovePhoto(CustomerPhotoModel p)
    {
        try
        {
            await Wave5Service.ApproveCustomerPhotoAsync(p.Id);
            _pendingPhotos.Remove(p);
            _message = "Đã duyệt ảnh check-in.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RejectPhoto(CustomerPhotoModel p)
    {
        try
        {
            await Wave5Service.RejectCustomerPhotoAsync(p.Id);
            _pendingPhotos.Remove(p);
            _message = "Đã xóa ảnh check-in.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SetHidden(OrderReviewModel r, bool hidden)
    {
        _error = null;
        _message = null;
        try
        {
            await OrderService.SetReviewHiddenAsync(r.Id, hidden);
            r.IsHidden = hidden;
            _message = hidden ? "Đã ẩn đánh giá khỏi công khai." : "Đã hiển thị lại đánh giá.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void StartReply(OrderReviewModel r)
    {
        _replyingId = r.Id;
        _replyText = r.AdminReply;
    }

    private void CancelReply()
    {
        _replyingId = Guid.Empty;
        _replyText = null;
    }

    private async Task SaveReply(OrderReviewModel r)
    {
        _error = null;
        _message = null;
        try
        {
            await OrderService.ReplyReviewAsync(r.Id, _replyText ?? string.Empty);
            r.AdminReply = _replyText?.Trim();
            CancelReply();
            _message = "Đã lưu phản hồi.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
