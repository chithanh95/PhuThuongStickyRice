@* Item 164: tab "Thẻ xôi" — nhúng trong trang /admin/goi-tra-truoc (chuẩn Lexa). *@
@using PhuThuongStickyRice.Web.Components.Shop.Models
@using PhuThuongStickyRice.Web.Components.Admin.Services
@using PhuThuongStickyRice.Web.Components.Core.Components
@inject PrepaidCardAdminService PrepaidCardAdminService

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Thẻ xôi sáng trả trước</h4>
        <div class="row mb-3">
            <div class="col-md-4 col-sm-6">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Tìm mã / SĐT / tên..."
                           @bind="SearchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-primary" @onclick="SearchAsync" disabled="@_loading">
                            <i class="fa-solid fa-magnifying-glass mr-1"></i>Tìm
                        </button>
                    </div>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_resultMessage))
        {
            <div class="alert alert-success">@_resultMessage</div>
        }
        <div class="table-responsive">
            @if (_loading)
            {
                <p><em>Đang tải...</em></p>
            }
            else if (_cards == null || !_cards.Any())
            {
                <p><em>Chưa có thẻ nào.</em></p>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Mã thẻ</th>
                            <th>Khách</th>
                            <th>SĐT</th>
                            <th class="text-center">Đã dùng / Tổng</th>
                            <th class="text-center">Còn lại</th>
                            <th>Trạng thái</th>
                            <th>Ngày mua</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _cards)
                        {
                            <tr @key="c.Id">
                                <td><strong>@c.CardCode</strong></td>
                                <td>@c.CustomerName</td>
                                <td>@c.CustomerPhone</td>
                                <td class="text-center">@c.UsedSuits / @c.TotalSuits</td>
                                <td class="text-center"><strong>@c.RemainingSuits</strong></td>
                                <td>
                                    @if (c.Status == 0)
                                    {
                                        <span class="badge badge-success">Đang dùng</span>
                                    }
                                    else if (c.Status == 1)
                                    {
                                        <span class="badge badge-secondary">Đã dùng hết</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Đã hủy</span>
                                    }
                                </td>
                                <td>@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-right text-nowrap">
                                    @if (c.Status == 0 && c.RemainingSuits > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" title="Trừ 1 suất"
                                                @onclick="() => AskRedeem(c)" disabled="@_redeeming">
                                            <i class="fa-solid fa-minus mr-1"></i>Trừ 1 suất
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <nav class="mt-3">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(_page == 0 ? "disabled" : "")">
                            <button class="page-link" @onclick="PrevPage" disabled="@(_page == 0 || _loading)">Trước</button>
                        </li>
                        <li class="page-item disabled"><span class="page-link">Trang @(_page + 1)</span></li>
                        <li class="page-item @(!_cards.Any() || _cards.Count < PageSize ? "disabled" : "")">
                            <button class="page-link" @onclick="NextPage" disabled="@(_loading || !_cards.Any() || _cards.Count < PageSize)">Sau</button>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<ConfirmDialog @ref="RedeemDialog" Title="Trừ 1 suất" YesText="Xác nhận" NoText="Hủy" ConfirmEventCallback="ConfirmedRedeem">
    <Message>
        Trừ 1 suất khỏi thẻ <strong>@_redeemingCard?.CardCode</strong> của @_redeemingCard?.CustomerName?
    </Message>
</ConfirmDialog>

@code {
    private const int PageSize = 20;

    private List<PrepaidCardModel> _cards = new();
    private string SearchText = "";
    private string _searchTerm = "";
    private int _page;
    private bool _loading;
    private bool _redeeming;
    private string _error;
    private string _resultMessage;

    private ConfirmDialog RedeemDialog;
    private PrepaidCardModel _redeemingCard;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _cards = await PrepaidCardAdminService.GetListAsync(_searchTerm, _page * PageSize, PageSize)
                     ?? new List<PrepaidCardModel>();
        }
        catch (Exception ex)
        {
            _error = $"Không tải được danh sách thẻ: {ex.Message}";
            _cards = new List<PrepaidCardModel>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAsync()
    {
        _searchTerm = SearchText?.Trim() ?? "";
        _page = 0;
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task PrevPage()
    {
        if (_page > 0)
        {
            _page--;
            await LoadAsync();
        }
    }

    private async Task NextPage()
    {
        _page++;
        await LoadAsync();
    }

    private void AskRedeem(PrepaidCardModel c)
    {
        _redeemingCard = c;
        _resultMessage = null;
        RedeemDialog.Show();
    }

    private async Task ConfirmedRedeem()
    {
        if (_redeemingCard == null)
        {
            return;
        }

        _redeeming = true;
        _error = null;
        _resultMessage = null;
        try
        {
            var updated = await PrepaidCardAdminService.RedeemAsync(_redeemingCard.CardCode);
            var index = _cards.FindIndex(c => c.Id == updated.Id);
            if (index >= 0)
            {
                _cards[index] = updated;
            }

            _resultMessage = $"Đã trừ 1 suất thẻ {updated.CardCode}. Còn {updated.RemainingSuits} suất.";
        }
        catch (Exception ex)
        {
            _error = string.IsNullOrWhiteSpace(ex.Message)
                ? "Không trừ được suất. Vui lòng thử lại."
                : ex.Message;
        }
        finally
        {
            _redeeming = false;
            RedeemDialog.Close();
        }
    }
}
