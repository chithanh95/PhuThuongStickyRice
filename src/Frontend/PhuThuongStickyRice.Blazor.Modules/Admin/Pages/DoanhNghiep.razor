@page "/admin/doanh-nghiep"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Core.Components
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@inject Wave5Service Wave5Service

<h3>🏢 Khách hàng doanh nghiệp</h3>
<p class="text-muted">Khách đặt định kỳ hàng tuần (vd: công ty đặt xôi sáng thứ 2). Admin tự tạo đơn từ gợi ý trên dashboard — không tự động trừ tiền.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="card mb-3">
    <div class="card-header">@(_editingId == null ? "Thêm khách doanh nghiệp" : "Sửa khách doanh nghiệp")</div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-4">
                <label>Tên công ty *</label>
                <input class="form-control" @bind="_form.CompanyName" placeholder="VD: Công ty ABC" />
            </div>
            <div class="form-group col-md-4">
                <label>Người liên hệ</label>
                <input class="form-control" @bind="_form.ContactName" />
            </div>
            <div class="form-group col-md-4">
                <label>SĐT *</label>
                <input class="form-control" @bind="_form.Phone" placeholder="09xxxxxxxx" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Địa chỉ giao</label>
                <input class="form-control" @bind="_form.Address" />
            </div>
            <div class="form-group col-md-3">
                <label>Ngày đặt hàng tuần *</label>
                <select class="form-control" @bind="_form.Weekday">
                    <option value="1">Thứ 2</option>
                    <option value="2">Thứ 3</option>
                    <option value="3">Thứ 4</option>
                    <option value="4">Thứ 5</option>
                    <option value="5">Thứ 6</option>
                    <option value="6">Thứ 7</option>
                    <option value="0">Chủ nhật</option>
                </select>
            </div>
            <div class="form-group col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="corp-active" @bind="_form.IsActive" />
                    <label class="form-check-label" for="corp-active">Đang hoạt động</label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label>Món đặt cố định (ghi chú tự do — vd: "20 xôi gấc, 15 xôi xéo")</label>
            <textarea class="form-control" rows="2" @bind="_form.ItemsJson" placeholder="20 xôi gấc, 15 xôi xéo"></textarea>
        </div>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Đang lưu..." : (_editingId == null ? "Thêm" : "Cập nhật"))
        </button>
        @if (_editingId != null)
        {
            <button class="btn btn-outline-secondary ml-2" @onclick="CancelEdit">Hủy</button>
        }
    </div>
</div>

@if (_clients == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_clients.Count == 0)
{
    <div class="alert alert-info">Chưa có khách doanh nghiệp nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Công ty</th>
                    <th>Liên hệ</th>
                    <th>SĐT</th>
                    <th>Ngày đặt</th>
                    <th>Món cố định</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _clients)
                {
                    <tr>
                        <td><strong>@c.CompanyName</strong></td>
                        <td>@c.ContactName</td>
                        <td>@c.Phone</td>
                        <td>@(string.IsNullOrEmpty(c.WeekdayName) ? WeekdayName(c.Weekday) : c.WeekdayName)</td>
                        <td><small>@c.ItemsJson</small></td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge badge-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Tạm ngưng</span>
                            }
                        </td>
                        <td class="text-right text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(c)">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger ml-1" @onclick="() => AskDelete(c)">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @ref="_deleteDialog" Title="Xóa khách doanh nghiệp" YesText="Xóa" NoText="Hủy" ConfirmEventCallback="ConfirmedDelete">
    <Message>Xóa <strong>@_deleting?.CompanyName</strong>?</Message>
</ConfirmDialog>

@code {
    private List<CorporateClientModel> _clients;
    private CorporateClientModel _form = new CorporateClientModel { Weekday = 1, IsActive = true };
    private Guid? _editingId;
    private bool _saving;
    private string _error;
    private string _success;
    private CorporateClientModel _deleting;
    private ConfirmDialog _deleteDialog;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _clients = await Wave5Service.GetCorporateClientsAsync();
        }
        catch (Exception ex)
        {
            _error = "Không tải được danh sách: " + ex.Message;
        }
    }

    private void Edit(CorporateClientModel c)
    {
        _editingId = c.Id;
        _form = new CorporateClientModel
        {
            CompanyName = c.CompanyName,
            ContactName = c.ContactName,
            Phone = c.Phone,
            Address = c.Address,
            Weekday = c.Weekday,
            ItemsJson = c.ItemsJson,
            IsActive = c.IsActive
        };
        _success = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new CorporateClientModel { Weekday = 1, IsActive = true };
    }

    private async Task SaveAsync()
    {
        _error = null;
        _success = null;
        if (string.IsNullOrWhiteSpace(_form.CompanyName) || string.IsNullOrWhiteSpace(_form.Phone))
        {
            _error = "Vui lòng nhập tên công ty và SĐT.";
            return;
        }

        _saving = true;
        try
        {
            if (_editingId == null)
            {
                await Wave5Service.CreateCorporateClientAsync(_form);
                _success = "Đã thêm khách doanh nghiệp.";
            }
            else
            {
                await Wave5Service.UpdateCorporateClientAsync(_editingId.Value, _form);
                _success = "Đã cập nhật.";
            }

            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "Lưu thất bại: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskDelete(CorporateClientModel c)
    {
        _deleting = c;
        _deleteDialog.Show();
    }

    private async Task ConfirmedDelete()
    {
        if (_deleting == null)
        {
            return;
        }

        try
        {
            await Wave5Service.DeleteCorporateClientAsync(_deleting.Id);
            _success = "Đã xóa.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "Xóa thất bại: " + ex.Message;
        }
        finally
        {
            _deleting = null;
        }
    }

    private static string WeekdayName(int weekday) => weekday switch
    {
        0 => "Chủ nhật",
        1 => "Thứ 2",
        2 => "Thứ 3",
        3 => "Thứ 4",
        4 => "Thứ 5",
        5 => "Thứ 6",
        6 => "Thứ 7",
        _ => ""
    };
}
