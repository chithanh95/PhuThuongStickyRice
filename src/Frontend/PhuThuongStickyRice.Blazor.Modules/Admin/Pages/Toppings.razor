@page "/admin/toppings"
@attribute [Authorize]
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Blazor.Modules.Core.Components
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@inject CatalogAdminService CatalogService

<h3>Topping / Ăn kèm thêm</h3>
<p class="text-muted">Khách chọn topping cho từng món trong cửa sổ xem nhanh. Phụ thu cộng vào đơn giá.</p>

<ConfirmDialog @ref="_deleteDialog"
               Title="Xóa topping"
               YesText="Xóa"
               NoText="Hủy"
               ConfirmEventCallback="ConfirmedDelete">
    <Message>Xóa topping <strong>@_deleting?.Name</strong>?</Message>
</ConfirmDialog>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="card mb-3">
    <div class="card-header">@(_editingId == null ? "Thêm topping" : "Sửa topping")</div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-5">
                <label>Tên *</label>
                <input class="form-control" @bind="_form.Name" placeholder="VD: Chả lụa" />
            </div>
            <div class="form-group col-md-3">
                <label>Phụ thu (₫)</label>
                <input type="number" min="0" step="1000" class="form-control" @bind="_form.ExtraPrice" />
            </div>
            <div class="form-group col-md-2">
                <label>Thứ tự</label>
                <input type="number" class="form-control" @bind="_form.SortOrder" />
            </div>
            <div class="form-group col-md-2 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="top-active" @bind="_form.IsActive" />
                    <label class="form-check-label" for="top-active">Đang bán</label>
                </div>
            </div>
        </div>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Đang lưu..." : (_editingId == null ? "Thêm topping" : "Cập nhật"))
        </button>
        @if (_editingId != null)
        {
            <button class="btn btn-outline-secondary ml-2" @onclick="CancelEdit">Hủy</button>
        }
    </div>
</div>

@if (_items == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_items.Count == 0)
{
    <div class="alert alert-info">Chưa có topping nào.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Tên</th>
                            <th class="text-right">Phụ thu</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _items.OrderBy(x => x.SortOrder))
                        {
                            <tr @key="t.Id">
                                <td><strong>@t.Name</strong></td>
                                <td class="text-right">@FormatPrice(t.ExtraPrice)</td>
                                <td>
                                    @if (t.IsActive)
                                    {
                                        <span class="badge badge-success">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Đã tắt</span>
                                    }
                                </td>
                                <td class="text-right" style="white-space: nowrap;">
                                    <button class="btn btn-sm btn-outline-primary mr-1" @onclick="() => StartEdit(t)">Sửa</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(t)">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<ToppingModel> _items;
    private ToppingModel _form = new ToppingModel();
    private Guid? _editingId;
    private bool _saving;
    private string _error;
    private string _success;
    private ConfirmDialog _deleteDialog;
    private ToppingModel _deleting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = await CatalogService.GetToppingsAsync() ?? new List<ToppingModel>();
        }
        catch (Exception)
        {
            _items = new List<ToppingModel>();
            _error = "Không tải được danh sách topping.";
        }
    }

    private void StartEdit(ToppingModel t)
    {
        _editingId = t.Id;
        _form = new ToppingModel
        {
            Name = t.Name,
            ExtraPrice = t.ExtraPrice,
            SortOrder = t.SortOrder,
            IsActive = t.IsActive
        };
        _error = null;
        _success = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new ToppingModel();
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = "Vui lòng nhập tên topping.";
            return;
        }

        if (_form.ExtraPrice < 0)
        {
            _error = "Phụ thu không được âm.";
            return;
        }

        _saving = true;
        try
        {
            if (_editingId == null)
            {
                await CatalogService.CreateToppingAsync(_form);
                _success = "Đã thêm topping.";
            }
            else
            {
                await CatalogService.UpdateToppingAsync(_editingId.Value, _form);
                _success = "Đã cập nhật topping.";
            }

            CancelEdit();
            await LoadAsync();
        }
        catch (Exception)
        {
            _error = "Lưu thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void DeleteAsync(ToppingModel t)
    {
        _deleting = t;
        _deleteDialog.Show();
    }

    private async Task ConfirmedDelete(bool confirmed)
    {
        _deleteDialog.Close();
        if (!confirmed || _deleting == null)
        {
            return;
        }

        try
        {
            await CatalogService.DeleteToppingAsync(_deleting.Id);
            _success = $"Đã xóa topping {_deleting.Name}.";
            _deleting = null;
            await LoadAsync();
        }
        catch (Exception)
        {
            _error = "Xóa thất bại. Vui lòng thử lại.";
        }
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";
}
