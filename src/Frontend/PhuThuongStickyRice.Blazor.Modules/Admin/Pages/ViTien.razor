@page "/admin/vi-tien"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@inject Wave5Service Wave5Service

<h3>💰 Ví khách hàng</h3>
<p class="text-muted">Nạp / trừ tiền ví thủ công (có ghi lý do). Mọi giao dịch được ghi vào sổ — kể cả trừ khi đặt hàng và hoàn khi hủy đơn.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="card mb-3">
    <div class="card-header">Nạp / trừ ví</div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-3">
                <label>SĐT *</label>
                <input class="form-control" @bind="_phone" placeholder="09xxxxxxxx" />
            </div>
            <div class="form-group col-md-3">
                <label>Số tiền (₫) * <small class="text-muted">(âm = trừ)</small></label>
                <input type="number" step="1000" class="form-control" @bind="_amount" placeholder="VD: 100000 hoặc -50000" />
            </div>
            <div class="form-group col-md-6">
                <label>Lý do *</label>
                <input class="form-control" @bind="_reason" placeholder="VD: khách nạp tiền mặt tại quầy" />
            </div>
        </div>
        <button class="btn btn-primary" @onclick="AdjustAsync" disabled="@_busy">
            @(_busy ? "Đang xử lý..." : "Thực hiện")
        </button>
        @if (_lastBalance != null)
        {
            <span class="ml-3">Số dư hiện tại của <strong>@_phone</strong>: <strong>@_lastBalance.Value.ToString("N0") ₫</strong></span>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="form-group col-md-4 mb-0">
                <label>Tìm ví theo SĐT</label>
                <input class="form-control" @bind="_search" placeholder="09xxxxxxxx" />
            </div>
            <div class="form-group col-md-8 mb-0">
                <button class="btn btn-outline-primary" @onclick="LoadWalletsAsync" disabled="@_busy">Tìm</button>
                <button class="btn btn-outline-secondary ml-1" @onclick="ViewTransactionsAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_search))">Xem sổ giao dịch</button>
            </div>
        </div>
    </div>
</div>

@if (_wallets != null && _wallets.Count > 0)
{
    <div class="table-responsive mb-3">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>SĐT</th>
                    <th class="text-right">Số dư</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in _wallets)
                {
                    <tr>
                        <td>@w.Phone</td>
                        <td class="text-right">@w.Balance.ToString("N0") ₫</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_transactions != null)
{
    <h5>Sổ giao dịch — @_search</h5>
    @if (_transactions.Count == 0)
    {
        <div class="alert alert-info">Chưa có giao dịch nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th class="text-right">Số tiền</th>
                        <th class="text-right">Số dư sau</th>
                        <th>Lý do</th>
                        <th>Người tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _transactions)
                    {
                        <tr>
                            <td><small>@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                            <td class="text-right @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                @(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("N0") ₫
                            </td>
                            <td class="text-right">@t.BalanceAfter.ToString("N0") ₫</td>
                            <td><small>@t.Reason</small></td>
                            <td><small>@t.CreatedBy</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private string _phone;
    private decimal _amount;
    private string _reason;
    private decimal? _lastBalance;
    private string _search;
    private List<WalletAccountModel> _wallets;
    private List<WalletTransactionModel> _transactions;
    private bool _busy;
    private string _error;
    private string _success;

    private async Task AdjustAsync()
    {
        _error = null;
        _success = null;
        _lastBalance = null;
        if (string.IsNullOrWhiteSpace(_phone) || _amount == 0 || string.IsNullOrWhiteSpace(_reason))
        {
            _error = "Vui lòng nhập SĐT, số tiền khác 0 và lý do.";
            return;
        }

        _busy = true;
        try
        {
            var account = await Wave5Service.AdjustWalletAsync(_phone.Trim(), _amount, _reason.Trim());
            _lastBalance = account.Balance;
            _success = _amount > 0
                ? $"Đã nạp {_amount:N0} ₫ vào ví {_phone}."
                : $"Đã trừ {Math.Abs(_amount):N0} ₫ khỏi ví {_phone}.";
            _amount = 0;
            _reason = null;
        }
        catch (Exception ex)
        {
            _error = "Thất bại: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadWalletsAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            _wallets = await Wave5Service.GetWalletsAsync(_search?.Trim());
        }
        catch (Exception ex)
        {
            _error = "Không tải được: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ViewTransactionsAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            _transactions = await Wave5Service.GetWalletTransactionsAsync(_search.Trim());
        }
        catch (Exception ex)
        {
            _error = "Không tải được sổ: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
