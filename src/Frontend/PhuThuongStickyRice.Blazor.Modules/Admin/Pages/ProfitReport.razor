@page "/admin/loi-nhuan"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@inject Wave3Service Wave3Service

<h3>Báo cáo lợi nhuận</h3>
<p class="text-muted">Doanh thu − giá vốn = lãi gộp (giá vốn lấy theo giá hiện tại của món).</p>

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="col-6 col-md-3">
                <label for="pl-from"><small class="text-muted">Từ ngày</small></label>
                <input id="pl-from" type="date" class="form-control" @bind="_from" />
            </div>
            <div class="col-6 col-md-3">
                <label for="pl-to"><small class="text-muted">Đến ngày</small></label>
                <input id="pl-to" type="date" class="form-control" @bind="_to" />
            </div>
            <div class="col-12 col-md-3 mt-2 mt-md-0">
                <button class="btn btn-primary" @onclick="LoadAsync" disabled="@_loading">Xem báo cáo</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_report == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h6 class="card-title">Doanh thu</h6>
                    <h2 class="card-text">@FormatPrice(_report.TotalRevenue)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h6 class="card-title">Giá vốn</h6>
                    <h2 class="card-text">@FormatPrice(_report.TotalCost)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h6 class="card-title">Lãi gộp</h6>
                    <h2 class="card-text">@FormatPrice(_report.TotalProfit)</h2>
                    @if (_report.TotalRevenue > 0)
                    {
                        <small>Biên lợi nhuận: @((_report.TotalProfit / _report.TotalRevenue * 100).ToString("N1"))%</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Theo ngày</div>
                <div class="card-body">
                    @if (_report.ByDay.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr><th>Ngày</th><th class="text-right">Đơn</th><th class="text-right">Doanh thu</th><th class="text-right">Giá vốn</th><th class="text-right">Lãi</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in _report.ByDay)
                                    {
                                        <tr>
                                            <td>@d.Date.ToString("dd/MM")</td>
                                            <td class="text-right">@d.Orders</td>
                                            <td class="text-right">@FormatPrice(d.Revenue)</td>
                                            <td class="text-right">@FormatPrice(d.Cost)</td>
                                            <td class="text-right"><strong class="text-success">@FormatPrice(d.Profit)</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Theo món</div>
                <div class="card-body">
                    @if (_report.ByProduct.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr><th>Món</th><th class="text-right">Đã bán</th><th class="text-right">Doanh thu</th><th class="text-right">Lãi</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in _report.ByProduct)
                                    {
                                        <tr>
                                            <td>@p.ProductName</td>
                                            <td class="text-right">@p.QuantitySold</td>
                                            <td class="text-right">@FormatPrice(p.Revenue)</td>
                                            <td class="text-right"><strong class="text-success">@FormatPrice(p.Profit)</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ProfitReportModel _report;
    private string _error;
    private bool _loading;
    private DateTime _from = DateTime.Today.AddDays(-6);
    private DateTime _to = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _loading = true;
        try
        {
            if (_from > _to)
            {
                (_from, _to) = (_to, _from);
            }

            _report = await Wave3Service.GetProfitReportAsync(_from, _to)
                ?? new ProfitReportModel();
        }
        catch (Exception)
        {
            _error = "Không tải được báo cáo lợi nhuận.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";
}
