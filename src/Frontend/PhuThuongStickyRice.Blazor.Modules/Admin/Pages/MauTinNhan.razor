@page "/admin/mau-tin-nhan"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Core.Components
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@inject Wave5Service Wave5Service
@inject IJSRuntime JSRuntime

<h3>✉️ Mẫu tin nhắn</h3>
<p class="text-muted">Soạn sẵn nội dung SMS / Zalo với {"{placeholder}"} (vd: {"{Ten}"}, {"{MaDon}"}, {"{TongTien}"}, {"{MaGiamGia}"}). Bấm "Sao chép" để dán vào công cụ gửi tin.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="card mb-3">
    <div class="card-header">@(_editingId == null ? "Thêm mẫu" : "Sửa mẫu")</div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Tên mẫu *</label>
                <input class="form-control" @bind="_form.Name" placeholder="VD: Xác nhận đơn" />
            </div>
            <div class="form-group col-md-6">
                <label>Kênh *</label>
                <select class="form-control" @bind="_form.Channel">
                    <option value="SMS">SMS</option>
                    <option value="Zalo">Zalo</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label>Nội dung * <small class="text-muted">(dùng {"{Ten}"}, {"{MaDon}"}, {"{TongTien}"}, {"{MaGiamGia}"})</small></label>
            <textarea class="form-control" rows="4" @bind="_form.Body" placeholder="Chào {Ten}, đơn {MaDon} của bạn trị giá {TongTien} đã được xác nhận."></textarea>
        </div>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Đang lưu..." : (_editingId == null ? "Thêm mẫu" : "Cập nhật"))
        </button>
        @if (_editingId != null)
        {
            <button class="btn btn-outline-secondary ml-2" @onclick="CancelEdit">Hủy</button>
        }
    </div>
</div>

<div class="mb-3">
    <div class="btn-group btn-group-sm" role="group">
        <button class="btn @(_channelFilter == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(null)">Tất cả</button>
        <button class="btn @(_channelFilter == "SMS" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetFilter("SMS")'>SMS</button>
        <button class="btn @(_channelFilter == "Zalo" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetFilter("Zalo")'>Zalo</button>
    </div>
</div>

@if (_templates == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_templates.Count == 0)
{
    <div class="alert alert-info">Chưa có mẫu tin nhắn nào.</div>
}
else
{
    <div class="row">
        @foreach (var t in _templates)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@t.Name</strong>
                        <span class="badge @(t.Channel == "Zalo" ? "badge-info" : "badge-secondary")">@t.Channel</span>
                    </div>
                    <div class="card-body">
                        <p class="card-text" style="white-space:pre-wrap">@t.Body</p>
                        <div class="d-flex flex-wrap">
                            <button class="btn btn-sm btn-outline-primary mr-1 mb-1" @onclick="() => CopyAsync(t)">📋 Sao chép</button>
                            <button class="btn btn-sm btn-outline-secondary mr-1 mb-1" @onclick="() => Edit(t)">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger mb-1" @onclick="() => AskDelete(t)">Xóa</button>
                        </div>
                        @if (_copiedId == t.Id)
                        {
                            <small class="text-success">Đã sao chép!</small>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<ConfirmDialog @ref="_deleteDialog" Title="Xóa mẫu tin nhắn" YesText="Xóa" NoText="Hủy" ConfirmEventCallback="ConfirmedDelete">
    <Message>Xóa mẫu <strong>@_deleting?.Name</strong>?</Message>
</ConfirmDialog>

@code {
    private List<MessageTemplateModel> _templates;
    private MessageTemplateModel _form = new MessageTemplateModel { Channel = "SMS" };
    private string _channelFilter;
    private Guid? _editingId;
    private Guid? _copiedId;
    private bool _saving;
    private string _error;
    private string _success;
    private MessageTemplateModel _deleting;
    private ConfirmDialog _deleteDialog;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task SetFilter(string channel)
    {
        _channelFilter = channel;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _templates = await Wave5Service.GetMessageTemplatesAsync(_channelFilter);
        }
        catch (Exception ex)
        {
            _error = "Không tải được mẫu: " + ex.Message;
        }
    }

    private void Edit(MessageTemplateModel t)
    {
        _editingId = t.Id;
        _form = new MessageTemplateModel { Name = t.Name, Channel = t.Channel, Body = t.Body };
        _success = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new MessageTemplateModel { Channel = "SMS" };
    }

    private async Task SaveAsync()
    {
        _error = null;
        _success = null;
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Body))
        {
            _error = "Vui lòng nhập tên và nội dung mẫu.";
            return;
        }

        _saving = true;
        try
        {
            if (_editingId == null)
            {
                await Wave5Service.CreateMessageTemplateAsync(_form);
                _success = "Đã thêm mẫu.";
            }
            else
            {
                await Wave5Service.UpdateMessageTemplateAsync(_editingId.Value, _form);
                _success = "Đã cập nhật mẫu.";
            }

            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "Lưu thất bại: " + ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CopyAsync(MessageTemplateModel t)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", t.Body);
            _copiedId = t.Id;
        }
        catch (Exception)
        {
            _error = "Không sao chép được (trình duyệt chặn clipboard).";
        }
    }

    private void AskDelete(MessageTemplateModel t)
    {
        _deleting = t;
        _deleteDialog.Show();
    }

    private async Task ConfirmedDelete()
    {
        if (_deleting == null)
        {
            return;
        }

        try
        {
            await Wave5Service.DeleteMessageTemplateAsync(_deleting.Id);
            _success = "Đã xóa mẫu.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "Xóa thất bại: " + ex.Message;
        }
        finally
        {
            _deleting = null;
        }
    }
}
