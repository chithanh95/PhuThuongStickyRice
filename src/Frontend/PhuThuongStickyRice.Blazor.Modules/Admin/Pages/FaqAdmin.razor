@page "/admin/faq"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Core.Components
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@inject Wave2Service Wave2Service

<h3>Quản lý FAQ</h3>

<ConfirmDialog @ref="_deleteDialog"
               Title="Xóa câu hỏi"
               YesText="Xóa"
               NoText="Hủy"
               ConfirmEventCallback="ConfirmedDelete">
    <Message>Xóa câu hỏi <strong>@_deleting?.Question</strong>?</Message>
</ConfirmDialog>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<button class="btn btn-primary mb-3" @onclick="NewFaq">+ Thêm câu hỏi</button>

@if (_editing != null)
{
    <div class="card mb-3">
        <div class="card-header">@(_editing.Id == Guid.Empty ? "Thêm câu hỏi" : "Sửa câu hỏi")</div>
        <div class="card-body">
            <div class="form-group">
                <label>Câu hỏi *</label>
                <input class="form-control" @bind="_editing.Question" />
            </div>
            <div class="form-group">
                <label>Trả lời *</label>
                <textarea class="form-control" rows="4" @bind="_editing.Answer"></textarea>
            </div>
            <div class="form-row">
                <div class="form-group col-md-3">
                    <label>Thứ tự</label>
                    <input type="number" class="form-control" @bind="_editing.SortOrder" />
                </div>
                <div class="form-group col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" @bind="_editing.IsActive" id="faq-active" />
                        <label class="form-check-label" for="faq-active">Hiển thị</label>
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="alert alert-danger">@_saveError</div>
            }
            <button class="btn btn-success" @onclick="Save" disabled="@_saving">Lưu</button>
            <button class="btn btn-outline-secondary ml-2" @onclick="() => _editing = null">Hủy</button>
        </div>
    </div>
}

@if (_faqs == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>#</th><th>Câu hỏi</th><th>Hiển thị</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in _faqs)
                {
                    <tr>
                        <td>@f.SortOrder</td>
                        <td>@f.Question</td>
                        <td>@(f.IsActive ? "✓" : "—")</td>
                        <td class="text-right" style="white-space: nowrap;">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(f)">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger ml-1" @onclick="() => AskDelete(f)">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<FaqItemModel> _faqs;
    private FaqItemModel _editing;
    private string _error;
    private string _saveError;
    private bool _saving;
    private FaqItemModel _deleting;
    private ConfirmDialog _deleteDialog;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _error = null;
        try
        {
            _faqs = await Wave2Service.GetAllFaqsAsync() ?? new List<FaqItemModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách.";
            _faqs = new List<FaqItemModel>();
        }
    }

    private void NewFaq()
    {
        _editing = new FaqItemModel { IsActive = true, SortOrder = (_faqs?.Count ?? 0) + 1 };
        _saveError = null;
    }

    private void Edit(FaqItemModel faq)
    {
        _editing = new FaqItemModel
        {
            Id = faq.Id,
            Question = faq.Question,
            Answer = faq.Answer,
            SortOrder = faq.SortOrder,
            IsActive = faq.IsActive
        };
        _saveError = null;
    }

    private async Task Save()
    {
        _saveError = null;
        if (string.IsNullOrWhiteSpace(_editing.Question) || string.IsNullOrWhiteSpace(_editing.Answer))
        {
            _saveError = "Vui lòng nhập câu hỏi và câu trả lời.";
            return;
        }

        _saving = true;
        try
        {
            await Wave2Service.SaveFaqAsync(_editing);
            _editing = null;
            await Load();
        }
        catch (Exception)
        {
            _saveError = "Không lưu được. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskDelete(FaqItemModel faq)
    {
        _deleting = faq;
        _deleteDialog.Show();
    }

    private async Task ConfirmedDelete()
    {
        if (_deleting == null)
        {
            return;
        }

        try
        {
            await Wave2Service.DeleteFaqAsync(_deleting.Id);
            await Load();
        }
        catch (Exception)
        {
            _error = "Không xóa được.";
        }
        finally
        {
            _deleting = null;
        }
    }
}
