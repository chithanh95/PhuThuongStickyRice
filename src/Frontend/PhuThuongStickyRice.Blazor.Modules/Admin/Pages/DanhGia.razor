@page "/admin/danh-gia"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@inject Wave2Service Wave2Service

<h3>Đánh giá đơn hàng</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_reviews == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_reviews.Count == 0)
{
    <div class="alert alert-info">Chưa có đánh giá nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr><th>Đơn hàng</th><th>SĐT</th><th>Sao</th><th>Nhận xét</th><th>Ngày</th></tr>
            </thead>
            <tbody>
                @foreach (var r in _reviews)
                {
                    <tr>
                        <td><a href="/orders">@r.OrderNumber</a></td>
                        <td>@r.CustomerPhone</td>
                        <td style="color: #f6c453; font-size: 16px; white-space: nowrap;">
                            @(new string('★', r.Rating))<span style="color: #ddd;">@(new string('★', 5 - r.Rating))</span>
                        </td>
                        <td>@r.Comment</td>
                        <td><small>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<OrderReviewModel> _reviews;
    private string _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reviews = await Wave2Service.GetReviewsAsync() ?? new List<OrderReviewModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được đánh giá.";
            _reviews = new List<OrderReviewModel>();
        }
    }
}
