@page "/admin/thanh-toan"
@attribute [Authorize(Roles = "Admin")]
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@inject ShopSettingsService ShopSettingsService

<h3>Cấu hình thanh toán</h3>
<p class="text-muted">
    Các giá trị hiển thị (không bí mật) — ưu tiên hơn appsettings.json.
    Khóa bí mật (MoMo AccessKey/SecretKey, bật/tắt TestMode) <strong>chỉ</strong> nằm trong
    <code>appsettings.json</code> / <code>appsettings.Production.json</code> và không bao giờ chỉnh ở đây.
</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_model == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="card mb-3">
        <div class="card-header">Chuyển khoản ngân hàng</div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Tên ngân hàng</label>
                    <input class="form-control" @bind="_model.BankName" placeholder="Vietcombank" />
                </div>
                <div class="form-group col-md-2">
                    <label>Mã VietQR</label>
                    <input class="form-control" @bind="_model.BankId" placeholder="VCB" />
                </div>
                <div class="form-group col-md-3">
                    <label>Số tài khoản</label>
                    <input class="form-control" @bind="_model.BankAccountNumber" />
                </div>
                <div class="form-group col-md-3">
                    <label>Chủ tài khoản</label>
                    <input class="form-control" @bind="_model.BankAccountName" placeholder="XOI PHU THUONG" />
                </div>
            </div>
            <div class="form-group">
                <label>Mẫu ảnh QR <small class="text-muted">(compact / compact2 / qr_only)</small></label>
                <input class="form-control" @bind="_model.BankQrTemplate" placeholder="compact2" style="max-width: 240px;" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">MoMo</div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Partner code</label>
                    <input class="form-control" @bind="_model.MoMoPartnerCode" />
                </div>
                <div class="form-group col-md-6">
                    <label>Endpoint tạo thanh toán <small class="text-muted">(để trống = appsettings)</small></label>
                    <input class="form-control" @bind="_model.MoMoEndpoint" placeholder="https://test-payment.momo.vn/v2/gateway/api/create" />
                </div>
            </div>
            <div class="alert alert-warning small">
                MoMo AccessKey/SecretKey và chế độ TestMode nằm trong <code>appsettings.Production.json</code>
                trên máy chủ IIS — không nhập khóa bí mật vào đây.
            </div>
        </div>
    </div>

    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
        @(_saving ? "Đang lưu..." : "Lưu thay đổi")
    </button>
}

@code {
    private ShopSettingModel _model;
    private bool _saving;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await ShopSettingsService.GetAsync() ?? new ShopSettingModel();
        }
        catch (Exception)
        {
            _error = "Không tải được cấu hình. Vui lòng thử lại.";
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _success = null;
        _saving = true;
        try
        {
            _model = await ShopSettingsService.UpdateAsync(_model);
            _success = "Đã lưu cấu hình thanh toán.";
        }
        catch (Exception)
        {
            _error = "Lưu thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }
}
