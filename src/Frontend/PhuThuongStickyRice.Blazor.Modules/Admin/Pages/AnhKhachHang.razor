@page "/admin/anh-khach-hang"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Core.Components
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@inject Wave5Service Wave5Service

<h3>📸 Ảnh khách hàng</h3>
<p class="text-muted">Duyệt ảnh khách chia sẻ từ trang tra cứu đơn. Ảnh đã duyệt hiển thị ở gallery công khai <a href="anh-khach-hang" target="_blank">/anh-khach-hang</a>.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="mb-3">
    <div class="btn-group btn-group-sm" role="group">
        <button class="btn @(_pendingOnly ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(true)">Chờ duyệt (@_pendingCount)</button>
        <button class="btn @(!_pendingOnly ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(false)">Tất cả</button>
    </div>
</div>

@if (_photos == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_photos.Count == 0)
{
    <div class="alert alert-info">Chưa có ảnh nào.</div>
}
else
{
    <div class="row">
        @foreach (var p in _photos)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-3">
                <div class="card h-100">
                    <img src="@Wave5Service.ResolveImageUrl(p.ImageUrl)" class="card-img-top" alt="Ảnh khách hàng" style="height:180px;object-fit:cover;" loading="lazy" />
                    <div class="card-body p-2">
                        <p class="card-text small mb-1">@(string.IsNullOrWhiteSpace(p.Caption) ? "(không có chú thích)" : p.Caption)</p>
                        <small class="text-muted">@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        <div class="mt-2 d-flex flex-wrap">
                            @if (!p.IsApproved)
                            {
                                <button class="btn btn-sm btn-success mr-1 mb-1" @onclick="() => ApproveAsync(p)" disabled="@_busy">Duyệt</button>
                                <button class="btn btn-sm btn-outline-danger mb-1" @onclick="() => RejectAsync(p)" disabled="@_busy">Từ chối</button>
                            }
                            else
                            {
                                <span class="badge badge-success">Đã duyệt</span>
                                <button class="btn btn-sm btn-outline-danger ml-1" @onclick="() => RejectAsync(p)" disabled="@_busy">Gỡ</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<CustomerPhotoModel> _photos;
    private bool _pendingOnly = true;
    private int _pendingCount;
    private bool _busy;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task SetFilter(bool pendingOnly)
    {
        _pendingOnly = pendingOnly;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _photos = await Wave5Service.GetCustomerPhotosAsync(_pendingOnly);
            if (_pendingOnly)
            {
                _pendingCount = _photos.Count;
            }
        }
        catch (Exception ex)
        {
            _error = "Không tải được ảnh: " + ex.Message;
        }
    }

    private async Task ApproveAsync(CustomerPhotoModel p)
    {
        _busy = true;
        _error = null;
        try
        {
            await Wave5Service.ApproveCustomerPhotoAsync(p.Id);
            _success = "Đã duyệt ảnh.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "Duyệt thất bại: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync(CustomerPhotoModel p)
    {
        _busy = true;
        _error = null;
        try
        {
            await Wave5Service.RejectCustomerPhotoAsync(p.Id);
            _success = "Đã gỡ/từ chối ảnh.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = "Thất bại: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
