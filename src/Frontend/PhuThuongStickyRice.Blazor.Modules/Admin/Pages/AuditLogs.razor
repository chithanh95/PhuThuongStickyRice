@page "/admin/audit-logs"
@attribute [Authorize]
@implements IDisposable
@using System.Threading
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@inject AuditLogService AuditLogService

<h3>Nhật ký thao tác</h3>
<p class="text-muted">Ai đã tạo / sửa / xóa dữ liệu gì trên hệ thống.</p>

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row">
            <div class="col-md-4">
                <input class="form-control" placeholder="Tìm theo hành động / mã đối tượng..."
                       @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
            </div>
        </div>
    </div>
</div>

@if (_paged == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_paged.Items.Count == 0)
{
    <div class="alert alert-info">Chưa có nhật ký nào.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Hành động</th>
                            <th>Mã đối tượng</th>
                            <th>Người thực hiện</th>
                            <th>Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _paged.Items)
                        {
                            <tr @key="log.Id">
                                <td style="white-space: nowrap;">@log.CreatedDateTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td><span class="badge badge-info">@log.Action</span></td>
                                <td><small class="text-monospace">@ShortId(log.ObjectId)</small></td>
                                <td><small class="text-monospace">@ShortId(log.UserId.ToString())</small></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetail(log.Id)">
                                        @(_expandedId == log.Id ? "Ẩn" : "Xem")
                                    </button>
                                    @if (_expandedId == log.Id)
                                    {
                                        <pre class="mt-2 mb-0 p-2 bg-light border rounded" style="max-height: 200px; overflow: auto; font-size: 0.75rem;">@PrettyJson(log.Log)</pre>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span>Tổng: @_paged.TotalCount bản ghi</span>
                <div>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="() => LoadPage(_page - 1)">Trước</button>
                    <span class="mx-2">Trang @_page</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadPage(_page + 1)">Sau</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<AuditLogEntryModel> _paged;
    private int _page = 1;
    private string _searchTerm;
    private Guid? _expandedId;
    private Timer _searchTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(1);
    }

    private async Task LoadPage(int page)
    {
        _page = page < 1 ? 1 : page;
        try
        {
            _paged = await AuditLogService.GetListAsync(_page, 20, _searchTerm);
        }
        catch (Exception)
        {
            _paged = new PagedResult<AuditLogEntryModel>();
        }
    }

    private void ToggleDetail(Guid id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private void OnSearchChanged()
    {
        _searchTimer?.Dispose();
        _searchTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadPage(1);
                StateHasChanged();
            });
        }, null, 500, Timeout.Infinite);
    }

    private static string ShortId(string id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return "—";
        }

        return id.Length > 8 ? id.Substring(0, 8) + "…" : id;
    }

    private static string PrettyJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return "(trống)";
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception)
        {
            return json;
        }
    }

    public void Dispose()
    {
        _searchTimer?.Dispose();
    }
}
