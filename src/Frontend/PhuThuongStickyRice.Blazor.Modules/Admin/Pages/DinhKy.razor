@page "/admin/dinh-ky"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@inject Wave2Service Wave2Service

<h3>Đặt xôi định kỳ</h3>
<p class="text-muted">Worker mỗi sáng tự tạo đơn COD cho các đăng ký đang hoạt động đến hạn.</p>

<div class="btn-group mb-3" role="group">
    <button class="btn btn-sm @(!_activeOnly.HasValue ? "btn-primary" : "btn-outline-primary")"
            @onclick="() => SetFilter(null)">Tất cả</button>
    <button class="btn btn-sm @(_activeOnly == true ? "btn-primary" : "btn-outline-primary")"
            @onclick="() => SetFilter(true)">Đang hoạt động</button>
    <button class="btn btn-sm @(_activeOnly == false ? "btn-primary" : "btn-outline-primary")"
            @onclick="() => SetFilter(false)">Đã tạm dừng</button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_subs == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_subs.Count == 0)
{
    <div class="alert alert-info">Chưa có đăng ký nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Khách hàng</th><th>SĐT</th><th>Món</th><th>SL/ngày</th>
                    <th>Ước tính</th><th>Từ ngày</th><th>Đơn cuối</th><th>Trạng thái</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _subs)
                {
                    <tr>
                        <td>@s.CustomerName</td>
                        <td>@s.Phone</td>
                        <td>
                            @s.ProductName
                            @if (!string.IsNullOrWhiteSpace(s.SizeName))
                            {
                                <small class="text-muted">(@s.SizeName)</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.ToppingNames))
                            {
                                <br /><small class="text-muted">+ @s.ToppingNames</small>
                            }
                        </td>
                        <td>@s.Quantity</td>
                        <td>@FormatPrice(s.UnitPrice * s.Quantity)</td>
                        <td>@s.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@(s.LastOrderDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            @if (s.Active)
                            {
                                <span class="badge badge-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Tạm dừng</span>
                            }
                        </td>
                        <td class="text-right" style="white-space: nowrap;">
                            @if (s.Active)
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => Toggle(s, false)">Tạm dừng</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => Toggle(s, true)">Kích hoạt</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SubscriptionModel> _subs;
    private bool? _activeOnly;
    private string _error;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task SetFilter(bool? activeOnly)
    {
        _activeOnly = activeOnly;
        await Load();
    }

    private async Task Load()
    {
        _error = null;
        try
        {
            _subs = await Wave2Service.GetSubscriptionsAsync(_activeOnly)
                ?? new List<SubscriptionModel>();
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách.";
            _subs = new List<SubscriptionModel>();
        }
    }

    private async Task Toggle(SubscriptionModel sub, bool active)
    {
        try
        {
            await Wave2Service.SetSubscriptionActiveAsync(sub.Id, active);
            await Load();
        }
        catch (Exception)
        {
            _error = "Không cập nhật được trạng thái.";
        }
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";
}
