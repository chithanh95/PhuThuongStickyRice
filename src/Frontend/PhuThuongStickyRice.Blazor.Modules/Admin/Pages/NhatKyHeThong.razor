@page "/admin/nhat-ky-he-thong"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@using PhuThuongStickyRice.Blazor.Modules.Core.Components
@inject Wave4Service Wave4Service

<h3>Nhật ký hệ thống</h3>
<p class="text-muted">Các bản ghi mức Warning trở lên (tối đa 2000 bản mới nhất).</p>

<div class="form-row align-items-end mb-3">
    <div class="form-group col-md-3 mb-0">
        <label>Mức độ</label>
        <select class="form-control" @bind="_level">
            <option value="">Tất cả</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
            <option value="Critical">Critical</option>
            <option value="Information">Information</option>
        </select>
    </div>
    <div class="form-group col-md-5 mb-0">
        <label>Tìm kiếm</label>
        <input class="form-control" @bind="_searchTerm" @bind:event="oninput" placeholder="Nội dung hoặc nguồn..." />
    </div>
    <div class="form-group col-md-4 mb-0">
        <button class="btn btn-primary" @onclick="() => LoadAsync(1)">Lọc</button>
        <button class="btn btn-outline-secondary ml-2" @onclick="ResetAsync">Xóa lọc</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_paged == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_paged.Items.Count == 0)
{
    <div class="alert alert-info">Không có bản ghi nào.</div>
}
else
{
    <p class="text-muted">Tổng @_paged.TotalCount bản ghi</p>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Mức</th>
                    <th>Nguồn</th>
                    <th>Nội dung</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in _paged.Items)
                {
                    <tr>
                        <td class="text-nowrap">@log.At.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                        <td>@LevelBadge(log.Level)</td>
                        <td><small class="text-muted text-break" style="max-width: 220px; display: inline-block;">@log.Source</small></td>
                        <td><small class="text-break">@log.Message</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pagination CurrentPage="_page" PageSize="_pageSize" TotalItems="_paged.TotalCount" PageChanged="LoadAsync" />
}

@code {
    private PagedAppLogsModel _paged;
    private string _level;
    private string _searchTerm;
    private string _error;
    private int _page = 1;
    private const int _pageSize = 50;

    protected override async Task OnInitializedAsync() => await LoadAsync(1);

    private async Task ResetAsync()
    {
        _level = null;
        _searchTerm = null;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        _error = null;
        _page = page < 1 ? 1 : page;
        try
        {
            _paged = await Wave4Service.GetAppLogsAsync(_level, _searchTerm, _page, _pageSize);
        }
        catch (Exception ex)
        {
            _error = "Không tải được nhật ký: " + ex.Message;
        }
    }

    private RenderFragment LevelBadge(string level) => builder =>
    {
        var css = level switch
        {
            "Critical" => "badge badge-danger",
            "Error" => "badge badge-danger",
            "Warning" => "badge badge-warning",
            _ => "badge badge-info"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, level);
        builder.CloseElement();
    };
}
