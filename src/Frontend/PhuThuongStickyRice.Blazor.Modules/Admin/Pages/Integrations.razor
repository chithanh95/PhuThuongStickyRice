@page "/admin/integrations"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@inject Wave2Service Wave2Service

<h3>Tích hợp bên thứ ba</h3>

<div class="card mb-3">
    <div class="card-header"><strong>Zalo OA</strong> — gửi hóa đơn điện tử qua Zalo</div>
    <div class="card-body">
        @if (_zalo == null)
        {
            <p><em>Đang tải...</em></p>
        }
        else
        {
            <table class="table table-sm">
                <tr><td>Trạng thái</td><td>@(_zalo.Configured ? "✅ Đã cấu hình" : "⚠️ Chưa cấu hình (chế độ stub)")</td></tr>
                <tr><td>OA ID</td><td><code>@_zalo.OaId</code></td></tr>
                <tr><td>Access token</td><td><code>@_zalo.AccessToken</code></td></tr>
            </table>
            @if (!string.IsNullOrWhiteSpace(_zalo.Note))
            {
                <p class="text-muted"><small>@_zalo.Note</small></p>
            }

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>SĐT test</label>
                    <input class="form-control" @bind="_testPhone" placeholder="0901234567" />
                </div>
                <div class="form-group col-md-6">
                    <label>Nội dung test</label>
                    <input class="form-control" @bind="_testMessage" placeholder="Tin nhắn kiểm tra..." />
                </div>
                <div class="form-group col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary" @onclick="TestZalo" disabled="@_testing">
                        @(_testing ? "Đang gửi..." : "Gửi test")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_testResult))
            {
                <div class="alert alert-info mb-0">@_testResult</div>
            }
            @if (!string.IsNullOrEmpty(_testError))
            {
                <div class="alert alert-danger mb-0">@_testError</div>
            }

            <hr />
            <h6>Các bước cấu hình (xem chi tiết trong README mục “Zalo OA”):</h6>
            <ol>
                <li>Tạo Official Account tại <code>oa.zalo.me</code> và được duyệt.</li>
                <li>Vào <em>Cài đặt → Thông tin OA</em> lấy <strong>OA ID</strong>.</li>
                <li>Tạo ứng dụng tại <code>developers.zalo.me</code>, liên kết với OA, lấy <strong>access token</strong>.</li>
                <li>Điền <code>AccessToken</code> và <code>OaId</code> vào mục <code>ZaloOa</code> trong <code>appsettings.json</code> của WebAPI rồi restart.</li>
                <li>Bấm “Gửi test” ở trên để kiểm tra (log server sẽ ghi “would send Zalo message” khi còn stub).</li>
            </ol>
        }
    </div>
</div>

@code {
    private ZaloStatusModel _zalo;
    private string _testPhone;
    private string _testMessage;
    private bool _testing;
    private string _testResult;
    private string _testError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _zalo = await Wave2Service.GetZaloStatusAsync();
        }
        catch (Exception)
        {
            _zalo = new ZaloStatusModel { OaId = "—", AccessToken = "—" };
        }
    }

    private async Task TestZalo()
    {
        _testResult = null;
        _testError = null;
        _testing = true;
        try
        {
            await Wave2Service.TestZaloAsync(_testPhone, _testMessage);
            _testResult = _zalo.Configured
                ? "Đã gửi yêu cầu test."
                : "Đã ghi log stub (\"would send Zalo message\") — cấu hình OA ID + access token thật để gửi tin nhắn thật.";
        }
        catch (Exception)
        {
            _testError = "Không gửi được. Vui lòng thử lại.";
        }
        finally
        {
            _testing = false;
        }
    }
}
