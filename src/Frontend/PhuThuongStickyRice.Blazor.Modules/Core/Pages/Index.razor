@page "/"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Blazor.Modules.Landing.Models
@using PhuThuongStickyRice.Blazor.Modules.Landing.Services
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@using PhuThuongStickyRice.Blazor.Modules.Core.Services
@inject LandingService LandingService
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject PolicyService PolicyService
@inject CartState CartState
@inject ToastService Toasts
@inject PhuThuongStickyRice.Blazor.Modules.Admin.Services.Wave4Service Wave4Service
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject NavigationManager Navigation

@* Wave 6d (item 38): friendly full-page error when the initial API load
   fails, reusing the PWA offline.html visual language. *@
@if (_loadFailed)
{
    <div class="card" style="background: #f5ebcd; border: none;">
        <div class="card-body text-center py-5">
            <div style="font-size: 4rem;">😞</div>
            <h2 style="font-family: Georgia, serif; color: #7a1b2e;">Không kết nối được tới máy chủ</h2>
            <p class="mb-4" style="color: #4a2b1a;">Kiểm tra mạng rồi thử lại.</p>
            <button class="btn" style="background: #7a1b2e; color: #fff; padding: 12px 28px; border-radius: 6px;" @onclick="RetryLoad">Thử lại</button>
        </div>
    </div>
}
else
{

<!-- 0. FLASH BANNER (item 94) -->
@if (!_bannerDismissed && _content.FlashBannerActive && !string.IsNullOrWhiteSpace(_content.FlashBannerText))
{
    <div class="lp-flash" role="alert">
        <span>⚡ @_content.FlashBannerText</span>
        <button type="button" class="lp-flash-close" aria-label="Đóng" @onclick="() => _bannerDismissed = true">×</button>
    </div>
}

<!-- 1. HERO -->
<section class="lp-hero">
    <div class="row align-items-center no-gutters">
        <div class="col-md-7 lp-hero-text">
            <h1 class="lp-brand">@_content.HeroTitle</h1>
            <div class="lp-oval lp-oval-dark"><span>@_content.HeroTagline</span></div>
            @* Wave 6a (item 22): open-hours display (VN time). *@
            @if (!string.IsNullOrEmpty(_openStatusText))
            {
                <div class="mb-2"><span class="badge @(_openNow ? "badge-success" : "badge-danger")" style="font-size: 1rem;">@_openStatusText</span></div>
            }
            <a href="/shop" class="lp-cta lp-cta-outline">@_content.HeroButtonText</a>
        </div>
        <div class="col-md-5 text-center">
            <img loading="lazy" src="@Img(_content.HeroImageUrl, "_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-gac.svg")"
                 alt="Xôi Phú Thượng" class="lp-hero-img" />
        </div>
    </div>
</section>

<!-- 2. PHOTO BANNER -->
<div class="lp-banner">
    <img loading="lazy" src="@Img(_content.BannerImageUrl, "_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-ngu-sac.svg")"
         alt="Xôi ngũ sắc" class="lp-banner-img" />
</div>

<!-- 3. STORY PANEL -->
<section class="lp-story">
    <div class="row no-gutters align-items-center">
        <div class="col-md-4">
            <h2 class="lp-panel-title">@_content.StoryTitle</h2>
        </div>
        <div class="col-md-8">
            <p class="lp-story-body">@_content.StoryBody</p>
        </div>
    </div>
</section>

<!-- 4. MENU SHOWCASE -->
<section class="lp-menu">
    <div class="lp-menu-band">
        <h2 class="lp-band-title">@_content.MenuTitle</h2>
    </div>
    <div class="row no-gutters">
        <div class="col-md-4 col-12 lp-menu-item">
            <img loading="lazy" src="@Img(_content.MenuImage1Url, "_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-gac.svg")"
                 alt="@_content.MenuLabel1" />
            <span class="lp-oval lp-oval-light">@_content.MenuLabel1</span>
        </div>
        <div class="col-md-4 col-12 lp-menu-item">
            <img loading="lazy" src="@Img(_content.MenuImage2Url, "_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-xeo.svg")"
                 alt="@_content.MenuLabel2" />
            <span class="lp-oval lp-oval-light">@_content.MenuLabel2</span>
        </div>
        <div class="col-md-4 col-12 lp-menu-item">
            <img loading="lazy" src="@Img(_content.MenuImage3Url, "_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-ngu-sac.svg")"
                 alt="@_content.MenuLabel3" />
            <span class="lp-oval lp-oval-light">@_content.MenuLabel3</span>
        </div>
    </div>
    <div class="text-center lp-menu-cta">
        <a href="/shop" class="lp-cta lp-cta-maroon">@_content.HeroButtonText</a>
    </div>
</section>

<!-- 4b. QUICK ORDER: Món bán chạy -->
<section class="lp-quick">
    <div class="lp-menu-band">
        <h2 class="lp-band-title">Món bán chạy</h2>
        @if (_todaySold > 0)
        {
            <p class="text-center mb-0"><span class="badge badge-danger" style="font-size: 0.95rem;">🔥 Hôm nay đã bán @_todaySold gói</span></p>
        }
    </div>
    <div class="lp-quick-row">
        @if (_quickProducts == null)
        {
            <p class="lp-quick-loading"><em>Đang tải món ngon...</em></p>
        }
        else if (_quickProducts.Count == 0)
        {
            <p class="lp-quick-loading"><em>Hiện chưa có món nào.</em></p>
        }
        else
        {
            @foreach (var product in _quickProducts)
            {
                <div class="lp-quick-card" @key="product.Id">
                    <img loading="lazy" src="@ProductImage(product.Code)" alt="@product.Name" />
                    <div class="lp-quick-name">@product.Name</div>
                    <div class="lp-quick-price">@FormatPrice(product.Price)</div>
                    <button class="lp-cta lp-cta-maroon lp-quick-btn" @onclick="() => QuickAdd(product)">
                        Thêm vào giỏ
                    </button>
                </div>
            }
        }
    </div>
    <div class="text-center lp-menu-cta">
        <a href="/cart" class="lp-cta lp-cta-outline">Xem giỏ hàng →</a>
    </div>
</section>

<!-- 5. NEWS / STORIES — item 93: published articles (latest 3), NewsItems JSON as fallback -->
<section class="lp-news">
    <div class="row no-gutters">
        <div class="col-md-5 lp-news-title-col">
            <h2 class="lp-panel-title">@_content.NewsTitle</h2>
        </div>
        <div class="col-md-7 lp-news-panel">
            @if (_articles != null && _articles.Count > 0)
            {
                @foreach (var item in _articles)
                {
                    <div class="lp-news-item" @key="item.Id">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img loading="lazy" src="@Img(item.ImageUrl, null)" alt="@item.Title" class="img-fluid mb-2" style="border-radius: 8px;" />
                        }
                        <h3 class="lp-news-item-title">@item.Title</h3>
                        <p class="lp-news-item-body">@item.Body</p>
                        <div class="lp-news-source">— @item.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    </div>
                }
            }
            else
            {
                @foreach (var item in _content.NewsItems)
                {
                    <div class="lp-news-item" @key="item.Title">
                        <h3 class="lp-news-item-title">@item.Title</h3>
                        <p class="lp-news-item-body">@item.Body</p>
                        <div class="lp-news-source">— @item.Source</div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- 5b. VIDEO -->
@if (!string.IsNullOrWhiteSpace(VideoEmbedUrl))
{
    <section class="lp-video">
        @if (!string.IsNullOrWhiteSpace(_content.VideoTitle))
        {
            <h2 class="lp-panel-title text-center">@_content.VideoTitle</h2>
        }
        <div class="lp-video-frame">
            <iframe src="@VideoEmbedUrl" title="@_content.VideoTitle"
                    frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    </section>
}

<!-- 5c. REVIEWS — item 87: public customer reviews (hidden reviews excluded) -->
@if (!string.IsNullOrWhiteSpace(_content.ReviewsEmbedHtml))
{
    <section class="lp-reviews">
        @((MarkupString)_content.ReviewsEmbedHtml)
    </section>
}
@if (_publicReviews != null && _publicReviews.Count > 0)
{
    <section class="lp-news">
        <div class="row no-gutters">
            <div class="col-md-5 lp-news-title-col">
                <h2 class="lp-panel-title">Khách hàng nói gì</h2>
            </div>
            <div class="col-md-7 lp-news-panel">
                @foreach (var r in _publicReviews)
                {
                    <div class="lp-news-item" @key="r.OrderNumber">
                        <div style="color: #f6c453; font-size: 18px; white-space: nowrap;">
                            @(new string('★', r.Rating))<span style="color: #ddd;">@(new string('★', 5 - r.Rating))</span>
                        </div>
                        <p class="lp-news-item-body mt-1">@r.Comment</p>
                        @if (!string.IsNullOrWhiteSpace(r.AdminReply))
                        {
                            <p class="mt-1"><small class="text-muted"><strong>Quán trả lời:</strong> @r.AdminReply</small></p>
                        }
                        <div class="lp-news-source">— SĐT @MaskPhone(r.CustomerPhone)</div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- 5d. PROMO POPUP — item 94: shown once per session (localStorage) -->
@if (_showPopup)
{
    <div class="lp-popup-overlay" @onclick="DismissPopup">
        <div class="lp-popup" @onclick:stopPropagation>
            <button type="button" class="lp-popup-close" aria-label="Đóng" @onclick="DismissPopup">×</button>
            @if (!string.IsNullOrWhiteSpace(_content.PopupImageUrl))
            {
                <img loading="lazy" src="@Img(_content.PopupImageUrl, null)" alt="@_content.PopupTitle" class="lp-popup-img" />
            }
            <h3 class="lp-popup-title">@_content.PopupTitle</h3>
            <p class="lp-popup-body">@_content.PopupBody</p>
            <a href="/shop" class="lp-cta lp-cta-maroon">Đặt ngay →</a>
        </div>
    </div>
}

<!-- 6. FOOTER -->
<footer class="lp-footer">
    <div class="row no-gutters">
        <div class="col-md-6 lp-footer-contact @(HasFooterBg ? "has-bg" : null)" style="@FooterBgStyle">
            <h2 class="lp-panel-title">@_content.FooterTitle</h2>
            <ul class="lp-contact-list">
                @if (!string.IsNullOrWhiteSpace(_content.ContactAddress))
                {
                    <li><span class="oi oi-home" aria-hidden="true"></span> @_content.ContactAddress</li>
                }
                @if (!string.IsNullOrWhiteSpace(_content.ContactPhone))
                {
                    <li><span class="oi oi-phone" aria-hidden="true"></span> @_content.ContactPhone</li>
                }
                @if (!string.IsNullOrWhiteSpace(_content.ContactEmail))
                {
                    <li><span class="oi oi-envelope-closed" aria-hidden="true"></span> @_content.ContactEmail</li>
                }
            </ul>
            <a href="/shop" class="lp-cta lp-cta-cream">@_content.FooterButtonText</a>
            @if (!string.IsNullOrWhiteSpace(_content.MapEmbedUrl))
            {
                <div class="lp-map">
                    <iframe src="@_content.MapEmbedUrl" title="Bản đồ" frameborder="0"
                            allowfullscreen loading="lazy"></iframe>
                </div>
            }
        </div>
        <div class="col-md-6">
            <div class="row no-gutters">
                <div class="col-6 lp-footer-img">
                    <img loading="lazy" src="_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-do.svg" alt="Xôi đỗ" />
                </div>
                <div class="col-6 lp-footer-img">
                    <img loading="lazy" src="_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-vo.svg" alt="Xôi vò" />
                </div>
                <div class="col-6 lp-footer-img">
                    <img loading="lazy" src="_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-xeo.svg" alt="Xôi xéo" />
                </div>
                <div class="col-6 lp-footer-img">
                    <img loading="lazy" src="_content/PhuThuongStickyRice.Blazor.Modules/images/xoi-gac.svg" alt="Xôi gấc" />
                </div>
            </div>
        </div>
    </div>
    @* Wave 6b (item 28): policy page links. *@
    @if (_policies.Count > 0)
    {
        <div class="lp-policy-bar">
            @foreach (var p in _policies)
            {
                <a href="/chinh-sach/@p.Slug">@p.Title</a>
            }
            <a href="/faq">Câu hỏi thường gặp</a>
        </div>
    }
</footer>
} @* /_loadFailed else *@

@code {
    private LandingContentModel _content = new LandingContentModel();
    private List<ShopProductModel> _quickProducts;
    private long _todaySold;

    // Wave 6d (item 38): initial API load failed → full-page error state.
    private bool _loadFailed;

    /// <summary>Wave 6d (item 38): full reload after a failed initial load.</summary>
    private void RetryLoad()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

    // Item 93: news CMS articles (latest 3 published).
    private List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.ArticleModel> _articles;

    // Item 87: public order reviews.
    private List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.PublicReviewModel> _publicReviews;

    // Item 94: flash banner + promo popup state.
    private bool _bannerDismissed;
    private bool _showPopup;
    private bool _popupChecked;
    private const string PopupSeenKey = "phuthuong.popup.seen";

    // Item 105: promo-popup feature flag.
    private bool _promoPopupEnabled = true;

    // Wave 6a (item 22): open-hours display in the hero.
    private string _openStatusText;
    private bool _openNow;

    // Wave 6b (item 28): policy pages for the footer links (fail-soft).
    private List<PolicyPageSummaryModel> _policies = new List<PolicyPageSummaryModel>();

    /// <summary>
    /// Converts a YouTube watch/share URL to an embed URL.
    /// Returns null when no video is configured.
    /// </summary>
    private string VideoEmbedUrl
    {
        get
        {
            var url = (_content.VideoUrl ?? "").Trim();
            if (string.IsNullOrEmpty(url))
            {
                return null;
            }

            if (url.Contains("/embed/"))
            {
                return url;
            }

            // youtu.be/VIDEO_ID
            var shortIdx = url.IndexOf("youtu.be/", StringComparison.OrdinalIgnoreCase);
            if (shortIdx >= 0)
            {
                var id = url.Substring(shortIdx + "youtu.be/".Length).Split('?', '&')[0];
                return $"https://www.youtube.com/embed/{id}";
            }

            // youtube.com/watch?v=VIDEO_ID
            var vIdx = url.IndexOf("v=", StringComparison.OrdinalIgnoreCase);
            if (vIdx >= 0)
            {
                var id = url.Substring(vIdx + 2).Split('?', '&')[0];
                return $"https://www.youtube.com/embed/{id}";
            }

            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Wave 6a (item 22): open-hours badge in the hero (fail-safe —
        // the landing works fine with the built-in defaults).
        try
        {
            var settings = await ShopSettingsService.GetAsync();
            if (settings != null)
            {
                var (isOpen, text) = ShopHours.StatusText(settings.OpenTime, settings.CloseTime);
                _openNow = isOpen;
                _openStatusText = text;
            }
        }
        catch (Exception)
        {
        }

        // Wave 6b (item 28): policy links for the footer (fail-soft).
        try
        {
            _policies = await PolicyService.GetPublicListAsync()
                ?? new List<PolicyPageSummaryModel>();
        }
        catch (Exception)
        {
            _policies = new List<PolicyPageSummaryModel>();
        }

        try
        {
            _content = await LandingService.GetContentAsync() ?? new LandingContentModel();
        }
        catch (Exception)
        {
            // Wave 6d (item 38): landing content is the critical load.
            _loadFailed = true;
            _content = new LandingContentModel();
        }

        // Item 93: published articles; NewsItems JSON stays as fallback.
        try
        {
            _articles = (await LandingService.GetArticlesAsync())
                ?.Take(3).ToList() ?? new List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.ArticleModel>();
        }
        catch (Exception)
        {
            _articles = new List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.ArticleModel>();
        }

        // Item 87: public reviews (hidden reviews are excluded server-side).
        try
        {
            _publicReviews = (await LandingService.GetPublicReviewsAsync())
                ?.Take(6).ToList() ?? new List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.PublicReviewModel>();
        }
        catch (Exception)
        {
            _publicReviews = new List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.PublicReviewModel>();
        }

        // Item 105: promo-popup feature flag (fail open).
        try
        {
            var flags = await Wave4Service.GetFeatureFlagMapAsync();
            _promoPopupEnabled = flags == null || !flags.TryGetValue("promo-popup", out var on) || on;
        }
        catch (Exception)
        {
        }

        try
        {
            var paged = await ShopService.GetProductsAsync();
            _quickProducts = (paged.Items ?? new List<ShopProductModel>()).Take(3).ToList();
        }
        catch (Exception)
        {
            // Wave 6d (item 38): quick-order strip needs products.
            _loadFailed = true;
            _quickProducts = new List<ShopProductModel>();
        }

        try
        {
            _todaySold = await ShopService.GetTodaySoldAsync();
        }
        catch (Exception)
        {
            _todaySold = 0;
        }
    }

    /// <summary>
    /// Item 94: shows the promo popup once per session. localStorage can only
    /// be touched after the first render (server-side prerendering safety).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_popupChecked && _content.PopupActive && _promoPopupEnabled)
        {
            _popupChecked = true;
            try
            {
                var seen = await JSRuntime.InvokeAsync<string>("localStorage.getItem", PopupSeenKey);
                if (string.IsNullOrEmpty(seen))
                {
                    _showPopup = true;
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                // localStorage unavailable — skip the popup silently.
            }
        }
    }

    private async Task DismissPopup()
    {
        _showPopup = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", PopupSeenKey, "1");
        }
        catch (Exception)
        {
        }
    }

    /// <summary>Masks a phone number for public display (090•…•5678).</summary>
    private static string MaskPhone(string phone)
    {
        var digits = new string((phone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length < 6)
        {
            return phone;
        }

        return $"{digits.Substring(0, 3)}•…•{digits.Substring(digits.Length - 4)}";
    }

    /// <summary>Add one item to the cart from the quick-order strip.</summary>
    private void QuickAdd(ShopProductModel product)
    {
        CartState.Add(product, 1);
        Toasts.Show($"Đã thêm {product.Name} × 1 vào giỏ", "Xem giỏ hàng", "/cart");
    }

    /// <summary>SVG placeholder per product code (matches the shop page).</summary>
    private static string ProductImage(string code)
    {
        var slug = (code ?? "").ToLowerInvariant()
            .Replace("xoi-", "xoi-")
            .Replace("_", "-");
        var file = slug switch
        {
            "xoi-gac" => "xoi-gac.svg",
            "xoi-do" => "xoi-do.svg",
            "xoi-xeo" => "xoi-xeo.svg",
            "xoi-vo" => "xoi-vo.svg",
            "xoi-ns" => "xoi-ngu-sac.svg",
            "xoi-ngu-sac" => "xoi-ngu-sac.svg",
            _ => "xoi-gac.svg"
        };
        return $"_content/PhuThuongStickyRice.Blazor.Modules/images/{file}";
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    /// <summary>Uploaded image URL if set, otherwise the SVG placeholder.</summary>
    private string Img(string uploadedUrl, string fallbackSvg) =>
        !string.IsNullOrWhiteSpace(uploadedUrl)
            ? LandingService.ResolveImageUrl(uploadedUrl)
            : fallbackSvg;

    private bool HasFooterBg => !string.IsNullOrWhiteSpace(_content.FooterBackgroundUrl);

    private string FooterBgStyle => HasFooterBg
        ? $"background-image: url('{LandingService.ResolveImageUrl(_content.FooterBackgroundUrl)}');"
        : null;
}
