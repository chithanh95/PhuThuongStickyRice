@page "/orders"
@attribute [Authorize(Roles = "Admin,Cashier")]
@using PhuThuongStickyRice.Blazor.Modules.Orders.Models
@using PhuThuongStickyRice.Blazor.Modules.Orders.Services
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject PhuThuongStickyRice.Blazor.Modules.Admin.Services.Wave3Service Wave3Service

<h3>Quản lý đơn hàng</h3>

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row">
            <div class="col-md-4">
                <input class="form-control" placeholder="Tìm mã đơn / tên / SĐT..."
                       @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
            </div>
            <div class="col-md-3">
                <select class="form-control" @bind="_statusFilter" @bind:after="() => LoadOrders(1)">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Pending">Chờ xác nhận</option>
                    <option value="Confirmed">Đã xác nhận</option>
                    <option value="Preparing">Đang chuẩn bị</option>
                    <option value="Delivering">Đang giao</option>
                    <option value="Completed">Hoàn thành</option>
                    <option value="Cancelled">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-control" @bind="_shipperFilter" @bind:after="() => LoadOrders(1)">
                    <option value="">Tất cả shipper</option>
                    @if (_shippers != null)
                    {
                        @foreach (var s in _shippers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (_paged == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Địa chỉ</th>
                            <th class="text-right">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thanh toán</th>
                            <th>Shipper</th>
                            <th>Ngày đặt</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _paged.Items)
                        {
                            <tr @key="order.Id">
                                <td>
                                    <a href="javascript:void(0)" @onclick="() => ToggleDetail(order)">
                                        <strong>@order.OrderNumber</strong>
                                    </a>
                                    @if (order.RequiresDeposit)
                                    {
                                        <span class="badge badge-warning ml-1" title="Đơn chuyển khoản cần đặt cọc">Cần cọc</span>
                                    }
                                    @if (order.IsGift)
                                    {
                                        <span class="badge badge-info ml-1" title="Gói quà">🎁</span>
                                    }
                                </td>
                                <td>@order.CustomerName<br /><small class="text-muted">@order.CustomerPhone</small></td>
                                <td><small>@order.CustomerAddress</small></td>
                                <td class="text-right"><strong>@FormatPrice(order.TotalAmount)</strong></td>
                                <td>@StatusBadge(order.Status)</td>
                                <td>@PaymentInfo(order)</td>
                                <td><small>@order.ShipperName</small></td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td class="text-right">@NextStatusButtons(order) @ConfirmPaymentButton(order)</td>
                            </tr>
                            @if (_expandedOrderId == order.Id)
                            {
                                <tr>
                                    <td colspan="9" class="bg-light">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                                            <strong>Chi tiết đơn @order.OrderNumber</strong>
                                            <div>
                                                <a class="btn btn-sm btn-outline-secondary mr-1" href="@($"/orders/print/{order.Id}")" target="_blank">🖨 In hóa đơn</a>
                                                <a class="btn btn-sm btn-outline-secondary" href="@($"/orders/nhan/{order.Id}")" target="_blank">🏷 In tem</a>
                                            </div>
                                        </div>
                                        @if (order.Status == "Delivering" && _shippers != null)
                                        {
                                            <div class="form-row align-items-center mb-2">
                                                <div class="col-md-4">
                                                    <select class="form-control form-control-sm"
                                                            value="@(order.ShipperId?.ToString() ?? "")"
                                                            @onchange="(e) => AssignShipper(order, e.Value?.ToString())">
                                                        <option value="">— Gán shipper —</option>
                                                        @foreach (var s in _shippers)
                                                        {
                                                            <option value="@s.Id">@s.Name — @s.Phone</option>
                                                        }
                                                    </select>
                                                </div>
                                                @if (!string.IsNullOrEmpty(_shipperMessage))
                                                {
                                                    <div class="col-md-8"><small class="text-success">@_shipperMessage</small></div>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.CustomerEmail))
                                        {
                                            <div>Email: @order.CustomerEmail</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.Notes))
                                        {
                                            <div><em>Ghi chú: @order.Notes</em></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.RecipientName))
                                        {
                                            <div>Người nhận: <strong>@order.RecipientName</strong> — @order.RecipientPhone</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.TaxCode))
                                        {
                                            <div>Hóa đơn VAT: @order.CompanyName (MST: @order.TaxCode)</div>
                                        }
                                        @if (order.IsGift)
                                        {
                                            <div>🎁 Gói quà@(!string.IsNullOrWhiteSpace(order.GiftMessage) ? $": {order.GiftMessage}" : "")</div>
                                        }
                                        @if (order.RequiresDeposit)
                                        {
                                            <div><span class="badge badge-warning">Cần đặt cọc — xác nhận qua nút “Đã thanh toán” sau khi nhận cọc</span></div>
                                        }
                                        @if (order.LoyaltyDiscount > 0 || order.TierDiscount > 0)
                                        {
                                            <div class="text-success">
                                                <small>
                                                    @if (order.TierDiscount > 0)
                                                    {
                                                        <span>Ưu đãi hạng: −@FormatPrice(order.TierDiscount) </span>
                                                    }
                                                    @if (order.LoyaltyDiscount > 0)
                                                    {
                                                        <span>Đổi @order.LoyaltyPointsRedeemed điểm: −@FormatPrice(order.LoyaltyDiscount)</span>
                                                    }
                                                </small>
                                            </div>
                                        }
                                        <table class="table table-sm mt-2 mb-0">
                                            <thead>
                                                <tr><th>Món</th><th class="text-right">Đơn giá</th><th class="text-right">SL</th><th class="text-right">Thành tiền</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in order.Lines)
                                                {
                                                    <tr>
                                                        <td>@line.ProductName</td>
                                                        <td class="text-right">@FormatPrice(line.UnitPrice)</td>
                                                        <td class="text-right">@line.Quantity</td>
                                                        <td class="text-right">@FormatPrice(line.LineTotal)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="3" class="text-right text-muted">Tạm tính</td>
                                                    <td class="text-right text-muted">@FormatPrice(order.Subtotal)</td>
                                                </tr>
                                                @if (order.DiscountAmount > 0)
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-right text-success">
                                                            Giảm giá @(!string.IsNullOrWhiteSpace(order.DiscountCode) ? $"({order.DiscountCode})" : "")
                                                        </td>
                                                        <td class="text-right text-success">−@FormatPrice(order.DiscountAmount)</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td colspan="3" class="text-right text-muted">Phí giao hàng</td>
                                                    <td class="text-right text-muted">@(order.DeliveryFee > 0 ? FormatPrice(order.DeliveryFee) : "Miễn phí")</td>
                                                </tr>
                                                <tr>
                                                    <td colspan="3" class="text-right"><strong>Tổng cộng</strong></td>
                                                    <td class="text-right"><strong>@FormatPrice(order.TotalAmount)</strong></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span>Tổng: @_paged.TotalCount đơn</span>
                <div>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="() => LoadOrders(_page - 1)">Trước</button>
                    <span class="mx-2">Trang @_page</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadOrders(_page + 1)">Sau</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<OrderModel> _paged;
    private int _page = 1;
    private string _searchTerm;
    private string _statusFilter;
    private string _shipperFilter;
    private Guid? _expandedOrderId;
    private System.Threading.Timer _searchTimer;

    // Item 82: shippers for the filter dropdown and assignment.
    private List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.ShipperModel> _shippers;
    private string _shipperMessage;

    private static readonly string[] Statuses =
        { "Pending", "Confirmed", "Preparing", "Delivering", "Completed", "Cancelled" };

    protected override async Task OnInitializedAsync()
    {
        // Support deep links like /orders?status=Pending or /orders?searchTerm=090...
        var query = ParseQuery(Navigation.Uri);
        if (query.TryGetValue("status", out var status) && !string.IsNullOrWhiteSpace(status))
        {
            _statusFilter = status;
        }

        if (query.TryGetValue("searchTerm", out var searchTerm) && !string.IsNullOrWhiteSpace(searchTerm))
        {
            _searchTerm = searchTerm;
        }

        try
        {
            _shippers = await Wave3Service.GetShippersAsync(false)
                ?? new List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.ShipperModel>();
        }
        catch (Exception)
        {
            _shippers = new List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.ShipperModel>();
        }

        await LoadOrders(1);
    }

    private Guid? ShipperFilterId
    {
        get
        {
            if (Guid.TryParse(_shipperFilter, out var id) && id != Guid.Empty)
            {
                return id;
            }

            return null;
        }
    }

    private async Task LoadOrders(int page)
    {
        _page = page < 1 ? 1 : page;
        _paged = await OrderService.GetOrdersAsync(_page, 20, _searchTerm, _statusFilter, ShipperFilterId);
    }

    private void OnSearchChanged()
    {
        _searchTimer?.Dispose();
        _searchTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => await LoadOrders(1));
        }, null, 500, System.Threading.Timeout.Infinite);
    }

    private void ToggleDetail(OrderModel order)
    {
        _expandedOrderId = _expandedOrderId == order.Id ? null : order.Id;
    }

    private async Task ChangeStatus(OrderModel order, string status)
    {
        await OrderService.UpdateStatusAsync(order.Id, status);
        await LoadOrders(_page);
    }

    private async Task ConfirmPayment(OrderModel order)
    {
        await OrderService.ConfirmPaymentAsync(order.Id);
        await LoadOrders(_page);
    }

    /// <summary>Item 82: assigns (or unassigns) a shipper to the order.</summary>
    private async Task AssignShipper(OrderModel order, string shipperIdText)
    {
        _shipperMessage = null;
        Guid? shipperId = null;
        if (Guid.TryParse(shipperIdText, out var id) && id != Guid.Empty)
        {
            shipperId = id;
        }

        try
        {
            var updated = await OrderService.AssignShipperAsync(order.Id, shipperId);
            order.ShipperId = updated.ShipperId;
            order.ShipperName = updated.ShipperName;
            _shipperMessage = shipperId.HasValue ? "Đã gán shipper." : "Đã bỏ gán shipper.";
        }
        catch (Exception ex)
        {
            _shipperMessage = ex.Message;
        }
    }

    private RenderFragment ConfirmPaymentButton(OrderModel order) => builder =>
    {
        if (order.PaymentStatus != "PendingConfirmation")
        {
            return;
        }

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", "btn btn-sm btn-outline-success mr-1");
        builder.AddAttribute(2, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ConfirmPayment(order)));
        builder.AddContent(3, "Xác nhận thanh toán");
        builder.CloseElement();
    };

    private static RenderFragment PaymentInfo(OrderModel order) => builder =>
    {
        var method = order.PaymentMethod switch
        {
            "Cod" => "COD",
            "BankTransfer" => "Chuyển khoản",
            "MoMo" => "MoMo",
            _ => order.PaymentMethod
        };
        var (css, label) = order.PaymentStatus switch
        {
            "Unpaid" => ("badge badge-warning", "Chưa thanh toán"),
            "PendingConfirmation" => ("badge badge-info", "Chờ xác nhận"),
            "Paid" => ("badge badge-success", "Đã thanh toán"),
            "Failed" => ("badge badge-danger", "Thất bại"),
            _ => ("badge badge-light", order.PaymentStatus)
        };
        builder.OpenElement(0, "div");
        builder.AddContent(1, method);
        builder.CloseElement();
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", css);
        builder.AddContent(4, label);
        builder.CloseElement();
    };

    private RenderFragment NextStatusButtons(OrderModel order) => builder =>
    {
        var next = order.Status switch
        {
            "Pending" => new[] { "Confirmed", "Cancelled" },
            "Confirmed" => new[] { "Preparing", "Cancelled" },
            "Preparing" => new[] { "Delivering", "Cancelled" },
            "Delivering" => new[] { "Completed", "Cancelled" },
            _ => System.Array.Empty<string>()
        };

        var seq = 0;
        foreach (var s in next)
        {
            var status = s;
            var css = status == "Cancelled" ? "btn btn-sm btn-outline-danger mr-1" : "btn btn-sm btn-outline-primary mr-1";
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", css);
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ChangeStatus(order, status)));
            builder.AddContent(seq++, ButtonLabel(status));
            builder.CloseElement();
        }
    };

    private static string ButtonLabel(string status) => status switch
    {
        "Confirmed" => "Xác nhận",
        "Preparing" => "Chuẩn bị",
        "Delivering" => "Giao hàng",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Hủy",
        _ => status
    };

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    private static System.Collections.Generic.Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new System.Collections.Generic.Dictionary<string, string>(System.StringComparer.OrdinalIgnoreCase);
        var question = uri.IndexOf('?');
        if (question < 0)
        {
            return result;
        }

        var query = uri.Substring(question + 1);
        var hash = query.IndexOf('#');
        if (hash >= 0)
        {
            query = query.Substring(0, hash);
        }

        foreach (var pair in query.Split('&', System.StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            result[Uri.UnescapeDataString(pair.Substring(0, eq))] =
                Uri.UnescapeDataString(pair.Substring(eq + 1).Replace('+', ' '));
        }

        return result;
    }

    private static RenderFragment StatusBadge(string status) => builder =>
    {
        var css = status switch
        {
            "Pending" => "badge badge-warning",
            "Confirmed" => "badge badge-info",
            "Preparing" => "badge badge-primary",
            "Delivering" => "badge badge-secondary",
            "Completed" => "badge badge-success",
            "Cancelled" => "badge badge-danger",
            _ => "badge badge-light"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, status);
        builder.CloseElement();
    };
}
