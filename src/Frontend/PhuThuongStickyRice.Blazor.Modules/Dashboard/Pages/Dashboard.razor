@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@using System.Threading
@using Microsoft.JSInterop
@using PhuThuongStickyRice.Blazor.Modules.Dashboard.Services
@using PhuThuongStickyRice.Blazor.Modules.Orders.Models
@using PhuThuongStickyRice.Blazor.Modules.Admin.Models
@inject DashboardService DashboardService
@inject IJSRuntime JSRuntime

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <h3 class="mb-2 mb-md-0">Dashboard</h3>
    <div class="d-flex align-items-center flex-wrap">
        @if (_stats != null)
        {
            <small class="text-muted mr-3 mb-1 mb-md-0">Cập nhật: @_lastUpdated.ToString("HH:mm:ss")</small>
        }
        <button class="btn btn-sm btn-outline-secondary mr-2 mb-1 mb-md-0" @onclick="RefreshNow" disabled="@_refreshing">⟳ Làm mới</button>
        <div class="form-check form-check-inline mb-1 mb-md-0">
            <input class="form-check-input" type="checkbox" id="autoRefreshToggle" @bind="_autoRefresh" />
            <label class="form-check-label" for="autoRefreshToggle">Tự động (30s)</label>
        </div>
    </div>
</div>

@if (_newOrderCount > 0)
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="mr-2" aria-hidden="true">🔔</span>
        <div>
            <strong>Có @_newOrderCount đơn hàng mới!</strong>
            <a href="/orders?status=Pending" class="alert-link ml-2">Xem ngay →</a>
        </div>
        <button type="button" class="close ml-auto" aria-label="Đóng" @onclick="DismissNewOrderAlert">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="col-6 col-md-3">
                <label for="dash-from"><small class="text-muted">Từ ngày</small></label>
                <input id="dash-from" type="date" class="form-control" @bind="_from" />
            </div>
            <div class="col-6 col-md-3">
                <label for="dash-to"><small class="text-muted">Đến ngày</small></label>
                <input id="dash-to" type="date" class="form-control" @bind="_to" />
            </div>
            <div class="col-12 col-md-3 mt-2 mt-md-0">
                <button class="btn btn-primary mr-2" @onclick="ApplyDateRange" disabled="@_refreshing">Áp dụng</button>
                <button class="btn btn-outline-secondary" @onclick="ResetDateRange" disabled="@_refreshing">7 ngày qua</button>
            </div>
        </div>
    </div>
</div>

@if (_stats == null)
{
    <p><em>Đang tải thống kê...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h6 class="card-title">Tổng đơn hàng</h6>
                    <h2 class="card-text">@_stats.TotalOrders</h2>
                    <small>Chờ xác nhận: @_stats.PendingOrders</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h6 class="card-title">Doanh thu</h6>
                    <h2 class="card-text">@FormatPrice(_stats.TotalRevenue)</h2>
                    <small>Không tính đơn đã hủy</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h6 class="card-title">Món xôi đã bán</h6>
                    <h2 class="card-text">@_stats.TotalProductsSold</h2>
                    <small>@_stats.TotalProducts món đang kinh doanh</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h6 class="card-title">Đơn chờ xử lý</h6>
                    <h2 class="card-text">@_stats.PendingOrders</h2>
                    <small><a href="/orders?status=Pending" class="text-white"><u>Xem ngay</u></a></small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Đơn hàng theo trạng thái</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tbody>
                            @foreach (var item in _stats.OrdersByStatus)
                            {
                                <tr>
                                    <td>@StatusBadge(item.Status)</td>
                                    <td class="text-right"><strong>@item.Count</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Doanh thu theo ngày</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Ngày</th><th class="text-right">Đơn</th><th class="text-right">Doanh thu</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var day in _stats.RevenueByDay)
                            {
                                <tr>
                                    <td>@day.Date.ToString("dd/MM")</td>
                                    <td class="text-right">@day.Orders</td>
                                    <td class="text-right">@FormatPrice(day.Revenue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">Món bán chạy nhất</div>
                <div class="card-body">
                    @if (_topProducts == null)
                    {
                        <p class="text-muted mb-0"><em>Đang tải...</em></p>
                    }
                    else if (_topProducts.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu trong khoảng thời gian này.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr><th>#</th><th>Món</th><th class="text-right">Đã bán</th><th class="text-right">Doanh thu</th></tr>
                            </thead>
                            <tbody>
                                @{
                                    var rank = 0;
                                }
                                @foreach (var p in _topProducts)
                                {
                                    rank++;
                                    <tr>
                                        <td><strong>@rank</strong></td>
                                        <td>@p.ProductName</td>
                                        <td class="text-right">@p.QuantitySold</td>
                                        <td class="text-right">@FormatPrice(p.Revenue)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            Đơn hàng mới nhất
            <a href="/orders" class="btn btn-sm btn-outline-primary float-right">Xem tất cả</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>SĐT</th>
                            <th class="text-right">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _stats.RecentOrders)
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td>@order.CustomerName</td>
                                <td>@order.CustomerPhone</td>
                                <td class="text-right">@FormatPrice(order.TotalAmount)</td>
                                <td>@StatusBadge(order.Status)</td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private DashboardStatsModel _stats;
    private List<TopProductModel> _topProducts;
    private bool _autoRefresh = true;
    private bool _refreshing;
    private DateTime _lastUpdated = DateTime.Now;
    private CancellationTokenSource _cts;

    private DateTime _from = DateTime.Today.AddDays(-6);
    private DateTime _to = DateTime.Today;

    // New-order alert state.
    private long _baselineOrderCount = -1;
    private int _newOrderCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();
        _cts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            var stats = await DashboardService.GetStatsAsync(_from, _to);
            var top = await DashboardService.GetTopProductsAsync(_from, _to);

            DetectNewOrders(stats);
            _stats = stats;
            _topProducts = top;
            _lastUpdated = DateTime.Now;
        }
        catch (Exception)
        {
            _stats ??= new DashboardStatsModel();
        }
    }

    private void DetectNewOrders(DashboardStatsModel stats)
    {
        if (_baselineOrderCount < 0)
        {
            // First load: establish the baseline, no alert.
            _baselineOrderCount = stats.TotalOrders;
            return;
        }

        var delta = stats.TotalOrders - _baselineOrderCount;
        if (delta > 0)
        {
            _newOrderCount += (int)delta;
            _baselineOrderCount = stats.TotalOrders;
            _ = PlayBeepAsync();
        }
    }

    private async Task PlayBeepAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("interop.playBeep");
        }
        catch (Exception)
        {
            // Audio is best-effort.
        }
    }

    private void DismissNewOrderAlert()
    {
        _newOrderCount = 0;
    }

    private async Task ApplyDateRange()
    {
        if (_from > _to)
        {
            (_from, _to) = (_to, _from);
        }

        // Re-baseline so the range change itself doesn't trigger the alert.
        _baselineOrderCount = -1;
        _newOrderCount = 0;
        await RefreshNow();
    }

    private async Task ResetDateRange()
    {
        _from = DateTime.Today.AddDays(-6);
        _to = DateTime.Today;
        _baselineOrderCount = -1;
        _newOrderCount = 0;
        await RefreshNow();
    }

    private async Task RefreshNow()
    {
        _refreshing = true;
        try
        {
            await LoadStatsAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), token);
                if (_autoRefresh && !token.IsCancellationRequested)
                {
                    await LoadStatsAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    private static RenderFragment StatusBadge(string status) => builder =>
    {
        var css = status switch
        {
            "Pending" => "badge badge-warning",
            "Confirmed" => "badge badge-info",
            "Preparing" => "badge badge-primary",
            "Delivering" => "badge badge-secondary",
            "Completed" => "badge badge-success",
            "Cancelled" => "badge badge-danger",
            _ => "badge badge-light"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, status);
        builder.CloseElement();
    };
}
