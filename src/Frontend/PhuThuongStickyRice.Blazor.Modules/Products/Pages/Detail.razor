@page "/products/{ProductId:guid}"
@attribute [Authorize]

<div class="card">
    <div class="card-header">
        Chi tiết sản phẩm: @Product.Name
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <div class="row">
                    <div class="col-md-4">Tên món:</div>
                    <div class="col-md-8">@Product.Name</div>
                </div>
                <div class="row">
                    <div class="col-md-4">Mã:</div>
                    <div class="col-md-8">@Product.Code?.ToUpper()</div>
                </div>
                <div class="row">
                    <div class="col-md-4">Mô tả:</div>
                    <div class="col-md-8">@Product.Description</div>
                </div>
                <div class="row">
                    <div class="col-md-4">Giá:</div>
                    <div class="col-md-8">

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <img class="center-block img-fluid"
                     style="max-width:200px; margin:2px;"
                     src="/images/logo.png"
                     title="@Product.Name" />
            </div>
        </div>
    </div>

    <div class="card-footer">
        <NavLink class="btn btn-outline-secondary" href="products">
            <i class="fa fa-chevron-left"></i> Quay lại
        </NavLink>
        &nbsp;
        <button @onclick="@(()=> NavManager.NavigateTo($"/products/edit/{ProductId}"))" class="btn btn-primary" title="Sửa">Sửa</button>
    </div>
</div>
