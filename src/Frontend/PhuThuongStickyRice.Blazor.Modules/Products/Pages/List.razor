@page "/products"
@attribute [Authorize]

<div class="card">
    <div class="card-header d-flex flex-wrap align-items-center">
        <span>Danh sách sản phẩm</span>

        <div class="d-flex flex-wrap ml-md-auto mt-2 mt-md-0">
            <button type="button" class="btn btn-secondary mr-2 mb-1" @onclick="ExportAsPdf">
                Xuất PDF
            </button>
            <button type="button" class="btn btn-secondary mr-2 mb-1" @onclick="ExportAsCsv">
                Xuất CSV
            </button>
            <button class="btn btn-primary mb-1" @onclick="QuickAddProduct">
                Thêm sản phẩm
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">

            @if (Products == null)
            {
                <p><em>Đang tải...</em></p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tên món</th>
                            <th>Mã</th>
                            <th>Mô tả</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Products)
                        {
                            <tr @key="product.Id">
                                <td><a href="@($"/products/{product.Id}")">@product.Name</a></td>
                                <td>@product.Code</td>
                                <td>@product.Description</td>
                                <td>
                                    <button @onclick="(()=> EditProduct(product))" class="btn btn-primary" title="Sửa">Sửa</button>
                                    <button @onclick="(()=> DeleteProduct(product))" class="btn btn-danger" title="Xóa">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<ConfirmDialog @ref="DeleteDialog" Title="Xóa sản phẩm" YesText="Có" NoText="Không" ConfirmEventCallback="ConfirmedDeleteProduct">
    <Message>
        Bạn có chắc muốn xóa sản phẩm: <strong>@DeletingProduct.Name</strong>?
    </Message>
</ConfirmDialog>
