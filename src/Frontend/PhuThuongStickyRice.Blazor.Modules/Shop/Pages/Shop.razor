@page "/shop"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@using PhuThuongStickyRice.Blazor.Modules.Core.Services
@inject ShopService ShopService
@inject CartState CartState
@inject ToastService Toasts
@inject NavigationManager Navigation

<div class="jumbotron jumbotron-fluid bg-warning text-dark rounded p-4 mb-4">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            <div>
                <h1 class="display-5">Xôi Làng Nghề Phú Thượng</h1>
                <p class="lead mb-1">Xôi dẻo thơm chuẩn vị làng nghề — đặt hàng online, giao tận nơi.</p>
                @if (_todaySold > 0)
                {
                    <p class="mb-0"><span class="badge badge-danger" style="font-size: 1rem;">🔥 Hôm nay đã bán @_todaySold gói</span></p>
                }
            </div>
            <a class="btn btn-dark mt-2" href="/menu-print" target="_blank" title="Mở thực đơn để in / lưu PDF">
                📄 Tải menu (PDF)
            </a>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_combos != null && _combos.Count > 0)
{
    <h4 class="mb-3">🎉 Combo gia đình <small class="text-muted">— tiết kiệm hơn gọi lẻ</small></h4>
    <div class="row">
        @foreach (var combo in _combos)
        {
            <div class="col-md-6 mb-4" @key="combo.Id">
                <div class="card h-100 border-warning">
                    <div class="card-body">
                        <h5 class="card-title">
                            @combo.Name
                            <span class="badge badge-warning ml-1">COMBO</span>
                        </h5>
                        <p class="card-text text-muted small">@combo.Description</p>
                        <ul class="list-unstyled small mb-2">
                            @foreach (var item in combo.Items)
                            {
                                <li>• @item.ProductName <span class="text-muted">× @item.Quantity</span></li>
                            }
                        </ul>
                        <div class="d-flex align-items-center justify-content-between">
                            <strong class="text-danger" style="font-size: 1.3rem;">@FormatPrice(combo.Price)</strong>
                            <button class="btn btn-warning" @onclick="() => AddComboToCart(combo)">
                                Thêm combo vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_products == null)
{
    <p><em>Đang tải sản phẩm...</em></p>
}
else
{
    <!-- Filters: categories + dietary tags + sort -->
    <div class="card mb-4">
        <div class="card-body py-3">
            <div class="mb-2">
                <span class="text-muted small mr-2">Danh mục:</span>
                <div class="btn-group btn-group-sm flex-wrap" role="group">
                    <button class="btn @CategoryChipClass(null)" @onclick="() => SetCategory(null)">Tất cả</button>
                    @foreach (var cat in _categories)
                    {
                        <button class="btn @CategoryChipClass(cat)" @onclick="() => SetCategory(cat)">@cat</button>
                    }
                </div>
            </div>
            <div class="mb-2">
                <span class="text-muted small mr-2">Khẩu vị:</span>
                <div class="btn-group btn-group-sm flex-wrap" role="group">
                    <button class="btn @TagChipClass(null)" @onclick="() => SetTag(null)">Tất cả</button>
                    <button class="btn @TagChipClass("chay")" @onclick='() => SetTag("chay")'>🥬 Chay</button>
                    <button class="btn @TagChipClass("man")" @onclick='() => SetTag("man")'>🍖 Mặn</button>
                    <button class="btn @TagChipClass("cay")" @onclick='() => SetTag("cay")'>🌶️ Cay</button>
                </div>
            </div>
            <div class="form-inline">
                <label class="text-muted small mr-2" for="sort-select">Sắp xếp:</label>
                <select id="sort-select" class="form-control form-control-sm" @onchange="OnSortChanged">
                    <option value="popular" selected="@(_sort == "popular")">Bán chạy</option>
                    <option value="priceAsc" selected="@(_sort == "priceAsc")">Giá tăng dần</option>
                    <option value="priceDesc" selected="@(_sort == "priceDesc")">Giá giảm dần</option>
                    <option value="newest" selected="@(_sort == "newest")">Mới nhất</option>
                </select>
            </div>
        </div>
    </div>

    @if (_filtered.Count == 0)
    {
        <div class="alert alert-info">Không có món nào phù hợp với bộ lọc. <a href="javascript:void(0)" @onclick="ClearFilters">Xóa bộ lọc</a></div>
    }
    else
    {
        <div class="row">
            @foreach (var product in _filtered)
            {
                <div class="col-6 col-md-4 mb-4" @key="product.Id">
                    <div class="card h-100">
                        <a href="javascript:void(0)" @onclick="() => OpenQuickView(product)" title="Xem nhanh @product.Name">
                            <img class="card-img-top" src="@ProductImage(product.Code)" alt="@product.Name" style="height: 200px; object-fit: cover;" />
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a href="javascript:void(0)" class="text-dark" @onclick="() => OpenQuickView(product)">@product.Name</a>
                            </h5>
                            <div class="mb-1">
                                @if (product.IsNew)
                                {
                                    <span class="badge badge-success mr-1">Món mới</span>
                                }
                                @if (product.IsSignature)
                                {
                                    <span class="badge badge-warning mr-1">Signature</span>
                                }
                                @foreach (var tag in ProductTags(product))
                                {
                                    <span class="badge badge-info mr-1">@TagLabel(tag)</span>
                                }
                            </div>
                            <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                            <p class="card-text mb-1">
                                <strong class="text-danger" style="font-size: 1.2rem;">@FormatPrice(DisplayPrice(product))</strong>
                            </p>
                            @if (product.Sizes != null && product.Sizes.Count > 0)
                            {
                                <select class="form-control form-control-sm mb-2" @onchange="(e) => OnCardSizeChanged(product, e)">
                                    @foreach (var size in product.Sizes)
                                    {
                                        <option value="@size.Id" selected="@(SelectedSizeId(product) == size.Id)">
                                            @size.Name — @FormatPrice(size.Price)
                                        </option>
                                    }
                                </select>
                            }
                            <div class="d-flex align-items-center">
                                <input type="number" min="1" max="99" class="form-control mr-2" style="width: 80px;"
                                       @bind="_quantities[product.Id]" />
                                <button class="btn btn-primary flex-grow-1" @onclick="() => AddToCart(product)">
                                    Thêm vào giỏ
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@if (_quickView != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" @onclick="CloseQuickView">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @_quickView.Name
                        @if (_quickView.IsNew)
                        {
                            <span class="badge badge-success ml-1">Món mới</span>
                        }
                        @if (_quickView.IsSignature)
                        {
                            <span class="badge badge-warning ml-1">Signature</span>
                        }
                    </h5>
                    <button type="button" class="close" aria-label="Đóng" @onclick="CloseQuickView">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <img src="@ProductImage(_quickView.Code)" alt="@_quickView.Name"
                         class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;" />
                    <p class="text-muted">@_quickView.Description</p>
                    @if (!string.IsNullOrWhiteSpace(_quickView.AllergenInfo))
                    {
                        <div class="alert alert-warning py-2">
                            <small>⚠️ <strong>Thông tin dị ứng:</strong> @_quickView.AllergenInfo</small>
                        </div>
                    }
                    @if (_quickView.Sizes != null && _quickView.Sizes.Count > 0)
                    {
                        <p class="mb-1"><strong>Chọn size:</strong></p>
                        @foreach (var size in _quickView.Sizes)
                        {
                            <div class="form-check" @key="size.Id">
                                <input class="form-check-input" type="radio" name="qv-size" id="qv-size-@size.Id"
                                       checked="@(_quickViewSizeId == size.Id)"
                                       @onchange="() => _quickViewSizeId = size.Id" />
                                <label class="form-check-label" for="qv-size-@size.Id">
                                    @size.Name — <strong class="text-danger">@FormatPrice(size.Price)</strong>
                                </label>
                            </div>
                        }
                    }
                    @if (_toppings != null && _toppings.Count > 0)
                    {
                        <p class="mb-1 mt-2"><strong>Ăn kèm thêm:</strong></p>
                        @foreach (var topping in _toppings)
                        {
                            <div class="form-check" @key="topping.Id">
                                <input class="form-check-input" type="checkbox" id="qv-top-@topping.Id"
                                       checked="@_quickViewToppings.Contains(topping.Id)"
                                       @onchange="(e) => ToggleQuickViewTopping(topping.Id, (bool)e.Value)" />
                                <label class="form-check-label" for="qv-top-@topping.Id">
                                    @topping.Name <span class="text-muted">+@FormatPrice(topping.ExtraPrice)</span>
                                </label>
                            </div>
                        }
                    }
                    <p class="mt-3">
                        <strong class="text-danger" style="font-size: 1.4rem;">@FormatPrice(QuickViewUnitPrice())</strong>
                        <small class="text-muted">/ gói</small>
                    </p>
                    <div class="d-flex align-items-center">
                        <label class="mr-2 mb-0" for="qv-qty">Số lượng:</label>
                        <input id="qv-qty" type="number" min="1" max="99" class="form-control" style="width: 90px;"
                               @bind="_quickViewQty" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseQuickView">Đóng</button>
                    <button type="button" class="btn btn-primary" @onclick="AddQuickViewToCart">
                        Thêm vào giỏ — @FormatPrice(QuickViewUnitPrice() * (_quickViewQty > 0 ? _quickViewQty : 1))
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<ShopProductModel> _products;
    private List<ShopProductModel> _filtered = new List<ShopProductModel>();
    private List<string> _categories = new List<string>();
    private List<ComboModel> _combos;
    private List<ToppingModel> _toppings;
    private Dictionary<Guid, int> _rank = new Dictionary<Guid, int>();
    private long _todaySold;
    private Dictionary<Guid, int> _quantities = new Dictionary<Guid, int>();
    private Dictionary<Guid, Guid?> _cardSizes = new Dictionary<Guid, Guid?>();
    private string _error;

    // Filters.
    private string _categoryFilter;
    private string _tagFilter;
    private string _sort = "popular";

    // Quick-view state.
    private ShopProductModel _quickView;
    private int _quickViewQty = 1;
    private Guid? _quickViewSizeId;
    private HashSet<Guid> _quickViewToppings = new HashSet<Guid>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pagedTask = ShopService.GetProductsAsync();
            var combosTask = ShopService.GetCombosAsync();
            var toppingsTask = ShopService.GetToppingsAsync();
            var todaySoldTask = ShopService.GetTodaySoldAsync();
            var bestSellersTask = ShopService.GetBestSellerIdsAsync();

            await Task.WhenAll(pagedTask, combosTask, toppingsTask, todaySoldTask, bestSellersTask);

            _products = pagedTask.Result.Items ?? new List<ShopProductModel>();
            _combos = combosTask.Result ?? new List<ComboModel>();
            _toppings = toppingsTask.Result ?? new List<ToppingModel>();
            _todaySold = todaySoldTask.Result;

            var rank = 0;
            foreach (var id in bestSellersTask.Result ?? new List<Guid>())
            {
                _rank[id] = rank++;
            }

            foreach (var p in _products)
            {
                _quantities[p.Id] = 1;
                _cardSizes[p.Id] = DefaultSizeId(p);
                if (p.Sizes == null)
                {
                    p.Sizes = new List<ProductSizeOptionModel>();
                }
            }

            _categories = _products
                .Select(p => p.Category)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .OrderBy(c => c)
                .ToList();

            ApplyFilters();
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách sản phẩm. Vui lòng thử lại sau.";
            _products = new List<ShopProductModel>();
        }
    }

    // ---------- Filtering & sorting ----------

    private void SetCategory(string category)
    {
        _categoryFilter = category;
        ApplyFilters();
    }

    private void SetTag(string tag)
    {
        _tagFilter = tag;
        ApplyFilters();
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "popular";
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _categoryFilter = null;
        _tagFilter = null;
        _sort = "popular";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (_products == null)
        {
            _filtered = new List<ShopProductModel>();
            return;
        }

        var query = _products.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_categoryFilter))
        {
            query = query.Where(p => string.Equals(p.Category?.Trim(), _categoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_tagFilter))
        {
            query = query.Where(p => ProductTags(p).Contains(_tagFilter));
        }

        _filtered = _sort switch
        {
            "priceAsc" => query.OrderBy(p => MinPrice(p)).ToList(),
            "priceDesc" => query.OrderByDescending(p => MinPrice(p)).ToList(),
            "newest" => query.OrderByDescending(p => p.CreatedDateTime).ToList(),
            _ => query.OrderBy(p => _rank.TryGetValue(p.Id, out var r) ? r : int.MaxValue).ThenBy(p => p.Name).ToList()
        };
    }

    private string CategoryChipClass(string category) =>
        string.Equals(_categoryFilter, category, StringComparison.OrdinalIgnoreCase)
            ? "btn-primary" : "btn-outline-primary";

    private string TagChipClass(string tag) =>
        string.Equals(_tagFilter, tag, StringComparison.OrdinalIgnoreCase)
            ? "btn-success" : "btn-outline-success";

    private static List<string> ProductTags(ShopProductModel product) =>
        (product.Tags ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().ToLowerInvariant())
            .Where(x => x.Length > 0)
            .Distinct()
            .ToList();

    private static string TagLabel(string tag) => tag switch
    {
        "chay" => "🥬 Chay",
        "man" => "🍖 Mặn",
        "cay" => "🌶️ Cay",
        _ => tag
    };

    private static decimal MinPrice(ShopProductModel product) =>
        product.Sizes != null && product.Sizes.Count > 0
            ? product.Sizes.Min(s => s.Price)
            : product.Price;

    // ---------- Sizes ----------

    private static Guid? DefaultSizeId(ShopProductModel product)
    {
        if (product.Sizes == null || product.Sizes.Count == 0)
        {
            return null;
        }

        return product.Sizes.OrderBy(s => s.SortOrder)
            .FirstOrDefault(s => s.Price == product.Price)?.Id
            ?? product.Sizes.OrderBy(s => s.SortOrder).First().Id;
    }

    private Guid? SelectedSizeId(ShopProductModel product)
    {
        if (_cardSizes.TryGetValue(product.Id, out var id) && id.HasValue
            && product.Sizes.Any(s => s.Id == id.Value))
        {
            return id;
        }

        return DefaultSizeId(product);
    }

    private void OnCardSizeChanged(ShopProductModel product, ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var sizeId))
        {
            _cardSizes[product.Id] = sizeId;
        }
    }

    private decimal DisplayPrice(ShopProductModel product)
    {
        var sizeId = SelectedSizeId(product);
        var size = sizeId.HasValue ? product.Sizes.FirstOrDefault(s => s.Id == sizeId.Value) : null;
        return size?.Price ?? product.Price;
    }

    // ---------- Cart ----------

    private void AddToCart(ShopProductModel product)
    {
        var qty = _quantities.TryGetValue(product.Id, out var q) && q > 0 ? q : 1;
        var sizeId = SelectedSizeId(product);
        var size = sizeId.HasValue ? product.Sizes.FirstOrDefault(s => s.Id == sizeId.Value) : null;

        CartState.AddConfigured(
            product.Id, product.Name, product.Code,
            size?.Price ?? product.Price, qty,
            size?.Id, size?.Name,
            toppingIds: null, toppingNames: null, toppingsTotal: 0,
            isCombo: false);

        var detail = size != null ? $" (size {size.Name})" : "";
        Toasts.Show($"Đã thêm {product.Name}{detail} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void AddComboToCart(ComboModel combo)
    {
        CartState.AddCombo(combo);
        Toasts.Show($"Đã thêm {combo.Name} vào giỏ", "Xem giỏ hàng", "/cart");
    }

    // ---------- Quick view ----------

    private void OpenQuickView(ShopProductModel product)
    {
        _quickView = product;
        _quickViewQty = _quantities.TryGetValue(product.Id, out var q) && q > 0 ? q : 1;
        _quickViewSizeId = SelectedSizeId(product);
        _quickViewToppings = new HashSet<Guid>();
    }

    private void CloseQuickView()
    {
        _quickView = null;
    }

    private void ToggleQuickViewTopping(Guid toppingId, bool on)
    {
        if (on)
        {
            _quickViewToppings.Add(toppingId);
        }
        else
        {
            _quickViewToppings.Remove(toppingId);
        }
    }

    private decimal QuickViewUnitPrice()
    {
        if (_quickView == null)
        {
            return 0;
        }

        var size = _quickViewSizeId.HasValue
            ? _quickView.Sizes.FirstOrDefault(s => s.Id == _quickViewSizeId.Value)
            : null;
        var basePrice = size?.Price ?? _quickView.Price;
        var toppingsTotal = (_toppings ?? new List<ToppingModel>())
            .Where(t => _quickViewToppings.Contains(t.Id))
            .Sum(t => t.ExtraPrice);
        return basePrice + toppingsTotal;
    }

    private void AddQuickViewToCart()
    {
        if (_quickView == null)
        {
            return;
        }

        var qty = _quickViewQty > 0 ? _quickViewQty : 1;
        var size = _quickViewSizeId.HasValue
            ? _quickView.Sizes.FirstOrDefault(s => s.Id == _quickViewSizeId.Value)
            : null;
        var chosenToppings = (_toppings ?? new List<ToppingModel>()).Where(t => _quickViewToppings.Contains(t.Id)).ToList();
        var toppingIds = chosenToppings.Select(t => t.Id).ToList();
        var toppingNames = chosenToppings.Count == 0 ? null : string.Join(", ", chosenToppings.Select(t => t.Name));
        var toppingsTotal = chosenToppings.Sum(t => t.ExtraPrice);
        var unitPrice = (size?.Price ?? _quickView.Price) + toppingsTotal;

        CartState.AddConfigured(
            _quickView.Id, _quickView.Name, _quickView.Code,
            unitPrice, qty,
            size?.Id, size?.Name,
            toppingIds, toppingNames, toppingsTotal,
            isCombo: false);

        _quantities[_quickView.Id] = qty;
        if (size != null)
        {
            _cardSizes[_quickView.Id] = size.Id;
        }

        Toasts.Show($"Đã thêm {_quickView.Name} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
        CloseQuickView();
    }

    private static string ProductImage(string code)
    {
        var slug = (code ?? "").ToLowerInvariant()
            .Replace("xoi-", "xoi-")
            .Replace("_", "-");
        var file = slug switch
        {
            "xoi-gac" => "xoi-gac.svg",
            "xoi-do" => "xoi-do.svg",
            "xoi-xeo" => "xoi-xeo.svg",
            "xoi-vo" => "xoi-vo.svg",
            "xoi-ns" => "xoi-ngu-sac.svg",
            "xoi-ngu-sac" => "xoi-ngu-sac.svg",
            _ => "xoi-gac.svg"
        };
        return $"_content/PhuThuongStickyRice.Blazor.Modules/images/{file}";
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";
}
