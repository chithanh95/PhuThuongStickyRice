@page "/shop"
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@using PhuThuongStickyRice.Blazor.Modules.Core.Services
@inject ShopService ShopService
@inject CartState CartState
@inject ToastService Toasts

<div class="jumbotron jumbotron-fluid bg-warning text-dark rounded p-4 mb-4">
    <div class="container">
        <h1 class="display-5">Xôi Làng Nghề Phú Thượng</h1>
        <p class="lead">Xôi dẻo thơm chuẩn vị làng nghề — đặt hàng online, giao tận nơi.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (_products == null)
{
    <p><em>Đang tải sản phẩm...</em></p>
}
else if (_products.Count == 0)
{
    <div class="alert alert-info">Hiện chưa có sản phẩm nào. Vui lòng quay lại sau.</div>
}
else
{
    <div class="row">
        @foreach (var product in _products)
        {
            <div class="col-6 col-md-4 mb-4" @key="product.Id">
                <div class="card h-100">
                    <a href="javascript:void(0)" @onclick="() => OpenQuickView(product)" title="Xem nhanh @product.Name">
                        <img class="card-img-top" src="@ProductImage(product.Code)" alt="@product.Name" style="height: 200px; object-fit: cover;" />
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <a href="javascript:void(0)" class="text-dark" @onclick="() => OpenQuickView(product)">@product.Name</a>
                        </h5>
                        <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                        <p class="card-text">
                            <strong class="text-danger" style="font-size: 1.2rem;">@FormatPrice(product.Price)</strong>
                        </p>
                        <div class="d-flex align-items-center">
                            <input type="number" min="1" max="99" class="form-control mr-2" style="width: 80px;"
                                   @bind="_quantities[product.Id]" />
                            <button class="btn btn-primary flex-grow-1" @onclick="() => AddToCart(product)">
                                Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_quickView != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" @onclick="CloseQuickView">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_quickView.Name</h5>
                    <button type="button" class="close" aria-label="Đóng" @onclick="CloseQuickView">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <img src="@ProductImage(_quickView.Code)" alt="@_quickView.Name"
                         class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;" />
                    <p class="text-muted">@_quickView.Description</p>
                    <p><strong class="text-danger" style="font-size: 1.4rem;">@FormatPrice(_quickView.Price)</strong></p>
                    <div class="d-flex align-items-center">
                        <label class="mr-2 mb-0" for="qv-qty">Số lượng:</label>
                        <input id="qv-qty" type="number" min="1" max="99" class="form-control" style="width: 90px;"
                               @bind="_quickViewQty" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseQuickView">Đóng</button>
                    <button type="button" class="btn btn-primary" @onclick="AddQuickViewToCart">
                        Thêm vào giỏ
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<ShopProductModel> _products;
    private Dictionary<Guid, int> _quantities = new Dictionary<Guid, int>();
    private string _error;
    private ShopProductModel _quickView;
    private int _quickViewQty = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var paged = await ShopService.GetProductsAsync();
            _products = paged.Items ?? new List<ShopProductModel>();
            foreach (var p in _products)
            {
                _quantities[p.Id] = 1;
            }
        }
        catch (Exception)
        {
            _error = "Không tải được danh sách sản phẩm. Vui lòng thử lại sau.";
            _products = new List<ShopProductModel>();
        }
    }

    private void AddToCart(ShopProductModel product)
    {
        var qty = _quantities.TryGetValue(product.Id, out var q) && q > 0 ? q : 1;
        CartState.Add(product, qty);
        Toasts.Show($"Đã thêm {product.Name} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
    }

    private void OpenQuickView(ShopProductModel product)
    {
        _quickView = product;
        _quickViewQty = _quantities.TryGetValue(product.Id, out var q) && q > 0 ? q : 1;
    }

    private void CloseQuickView()
    {
        _quickView = null;
    }

    private void AddQuickViewToCart()
    {
        if (_quickView == null)
        {
            return;
        }

        var qty = _quickViewQty > 0 ? _quickViewQty : 1;
        CartState.Add(_quickView, qty);
        _quantities[_quickView.Id] = qty;
        Toasts.Show($"Đã thêm {_quickView.Name} × {qty} vào giỏ", "Xem giỏ hàng", "/cart");
        CloseQuickView();
    }

    private static string ProductImage(string code)
    {
        var slug = (code ?? "").ToLowerInvariant()
            .Replace("xoi-", "xoi-")
            .Replace("_", "-");
        var file = slug switch
        {
            "xoi-gac" => "xoi-gac.svg",
            "xoi-do" => "xoi-do.svg",
            "xoi-xeo" => "xoi-xeo.svg",
            "xoi-vo" => "xoi-vo.svg",
            "xoi-ns" => "xoi-ngu-sac.svg",
            "xoi-ngu-sac" => "xoi-ngu-sac.svg",
            _ => "xoi-gac.svg"
        };
        return $"_content/PhuThuongStickyRice.Blazor.Modules/images/{file}";
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";
}
