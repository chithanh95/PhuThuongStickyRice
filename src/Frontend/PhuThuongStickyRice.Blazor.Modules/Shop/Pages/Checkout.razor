@page "/checkout"
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@implements IDisposable
@inject ShopService ShopService
@inject ShopSettingsService ShopSettingsService
@inject DiscountService DiscountService
@inject CartState CartState
@inject NavigationManager Navigation

<h3>Đặt hàng</h3>

@if (_placedOrder != null)
{
    <div class="alert alert-success">
        <h4>Đặt hàng thành công!</h4>
        <p>Mã đơn hàng của bạn: <strong>@_placedOrder.OrderNumber</strong></p>
        <table class="table table-sm mb-2">
            <tbody>
                <tr><td>Tạm tính</td><td class="text-right">@FormatPrice(_placedOrder.Subtotal)</td></tr>
                @if (_placedOrder.DiscountAmount > 0)
                {
                    <tr>
                        <td>Giảm giá @(!string.IsNullOrWhiteSpace(_placedOrder.DiscountCode) ? $"({_placedOrder.DiscountCode})" : "")</td>
                        <td class="text-right text-success">−@FormatPrice(_placedOrder.DiscountAmount)</td>
                    </tr>
                }
                @if (_placedOrder.DeliveryFee > 0)
                {
                    <tr><td>Phí giao hàng</td><td class="text-right">@FormatPrice(_placedOrder.DeliveryFee)</td></tr>
                }
                else
                {
                    <tr><td>Phí giao hàng</td><td class="text-right text-success">Miễn phí</td></tr>
                }
                <tr>
                    <td><strong>Tổng tiền</strong></td>
                    <td class="text-right"><strong class="text-danger">@FormatPrice(_placedOrder.TotalAmount)</strong></td>
                </tr>
            </tbody>
        </table>
        <p>Chúng tôi sẽ liên hệ với bạn qua số <strong>@_placedOrder.CustomerPhone</strong> để xác nhận.</p>
        <p>
            <a class="btn btn-outline-primary btn-sm" href="/track-order?orderNumber=@Uri.EscapeDataString(_placedOrder.OrderNumber)">Tra cứu đơn hàng</a>
            <a class="btn btn-primary btn-sm ml-2" href="/shop">Tiếp tục mua hàng</a>
        </p>
    </div>

    @if (_placedOrder.PaymentMethod == "Cod")
    {
        <div class="alert alert-info">
            <strong>Thanh toán khi nhận hàng (COD):</strong> bạn sẽ trả tiền mặt cho shipper khi nhận hàng.
        </div>
    }
    else if (_placedOrder.PaymentMethod == "BankTransfer")
    {
        <div class="card mb-3">
            <div class="card-header">Chuyển khoản ngân hàng</div>
            <div class="card-body">
                @if (_bankInfo == null)
                {
                    <p><em>Đang tải thông tin chuyển khoản...</em></p>
                }
                else if (!_bankInfo.IsConfigured)
                {
                    <div class="alert alert-warning">
                        <strong>QR sẽ hiện khi shop cấu hình ngân hàng.</strong>
                        <p class="mb-0">Tạm thời bạn vui lòng chuyển khoản với nội dung: <strong>@_placedOrder.OrderNumber</strong> rồi bấm “Tôi đã chuyển khoản” bên dưới để shop xác nhận.</p>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-5 text-center">
                            <img src="@QrUrl" alt="QR chuyển khoản" style="max-width: 260px; width: 100%;" />
                            <p class="text-muted mt-2"><small>Quét mã để chuyển khoản nhanh</small></p>
                        </div>
                        <div class="col-md-7">
                            <table class="table table-sm">
                                <tr><td><strong>Ngân hàng</strong></td><td>@_bankInfo.BankName</td></tr>
                                <tr><td><strong>Số tài khoản</strong></td><td><strong>@_bankInfo.AccountNumber</strong></td></tr>
                                <tr><td><strong>Chủ tài khoản</strong></td><td>@_bankInfo.AccountName</td></tr>
                                <tr><td><strong>Số tiền</strong></td><td><strong class="text-danger">@FormatPrice(_placedOrder.TotalAmount)</strong></td></tr>
                                <tr><td><strong>Nội dung</strong></td><td><strong>@_placedOrder.OrderNumber</strong></td></tr>
                            </table>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_transferMessage))
                {
                    <div class="alert alert-success">@_transferMessage</div>
                }
                @if (!string.IsNullOrEmpty(_transferError))
                {
                    <div class="alert alert-danger">@_transferError</div>
                }

                @if (_placedOrder.PaymentStatus == "Unpaid")
                {
                    <button class="btn btn-success" @onclick="MarkTransferred" disabled="@_markingTransferred">
                        @(_markingTransferred ? "Đang gửi..." : "Tôi đã chuyển khoản")
                    </button>
                    <p class="text-muted mt-2"><small>Sau khi bạn bấm nút này, shop sẽ xác nhận và trang tra cứu đơn hàng sẽ hiện “Đã thanh toán”.</small></p>
                }
                else if (_placedOrder.PaymentStatus == "PendingConfirmation")
                {
                    <div class="alert alert-info mb-0">Đã ghi nhận bạn đã chuyển khoản. Shop đang xác nhận thanh toán.</div>
                }
                else if (_placedOrder.PaymentStatus == "Paid")
                {
                    <div class="alert alert-success mb-0">Thanh toán thành công! Cảm ơn bạn.</div>
                }
            </div>
        </div>
    }
    else if (_placedOrder.PaymentMethod == "MoMo")
    {
        <div class="card mb-3">
            <div class="card-header">Thanh toán qua MoMo <span class="badge badge-warning">TEST</span></div>
            <div class="card-body">
                @if (_placedOrder.PaymentStatus == "Paid")
                {
                    <div class="alert alert-success mb-0">Thanh toán MoMo thành công! Cảm ơn bạn.</div>
                }
                else if (_placedOrder.PaymentStatus == "Failed")
                {
                    <div class="alert alert-danger">Thanh toán MoMo thất bại. Bạn có thể thử lại.</div>
                    <button class="btn btn-primary" @onclick="PayWithMoMo" disabled="@_payingMoMo">
                        @(_payingMoMo ? "Đang xử lý..." : "Thử thanh toán MoMo lại")
                    </button>
                }
                else
                {
                    <p>Đơn hàng của bạn sẽ được thanh toán qua ví MoMo (chế độ test — chưa trừ tiền thật).</p>
                    @if (!string.IsNullOrEmpty(_momoError))
                    {
                        <div class="alert alert-danger">@_momoError</div>
                    }
                    <button class="btn btn-primary" @onclick="PayWithMoMo" disabled="@_payingMoMo">
                        @(_payingMoMo ? "Đang xử lý..." : "Thanh toán MoMo")
                    </button>
                }
            </div>
        </div>
    }
}
else if (CartState.Items.Count == 0)
{
    <div class="alert alert-info">
        Giỏ hàng đang trống. <a href="/shop">Xem các món xôi</a>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_minOrderBlocked)
    {
        <div class="alert alert-warning">
            Đơn hàng tối thiểu <strong>@FormatPrice(_shopSettings.MinOrderAmount)</strong>.
            Vui lòng thêm món vào giỏ để tiếp tục.
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Thông tin giao hàng</div>
                <div class="card-body">
                    <div class="form-group">
                        <label>Họ tên *</label>
                        <input class="form-control @FieldClass(_nameError)" @bind="_order.CustomerName" placeholder="Nguyễn Văn A" />
                        @if (!string.IsNullOrEmpty(_nameError))
                        {
                            <small class="text-danger">@_nameError</small>
                        }
                    </div>
                    <div class="form-group">
                        <label>Số điện thoại *</label>
                        <input class="form-control @FieldClass(_phoneError)" @bind="_order.CustomerPhone" placeholder="0901234567" />
                        @if (!string.IsNullOrEmpty(_phoneError))
                        {
                            <small class="text-danger">@_phoneError</small>
                        }
                    </div>
                    <div class="form-group">
                        <label>Email (tùy chọn — để nhận mail xác nhận đơn)</label>
                        <input class="form-control @FieldClass(_emailError)" @bind="_order.CustomerEmail" placeholder="ban@example.com" />
                        @if (!string.IsNullOrEmpty(_emailError))
                        {
                            <small class="text-danger">@_emailError</small>
                        }
                    </div>
                    <div class="form-group">
                        <label>Địa chỉ giao hàng *</label>
                        <textarea class="form-control @FieldClass(_addressError)" @bind="_order.CustomerAddress" rows="3"
                                  placeholder="Số nhà, đường, phường..."></textarea>
                        @if (!string.IsNullOrEmpty(_addressError))
                        {
                            <small class="text-danger">@_addressError</small>
                        }
                    </div>
                    <div class="form-group">
                        <label>Ghi chú</label>
                        <textarea class="form-control" @bind="_order.Notes" rows="2"
                                  placeholder="Ví dụ: giao giờ hành chính..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Phương thức thanh toán *</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pm-cod"
                                   checked="@(_order.PaymentMethod == "Cod")" @onchange="@(() => _order.PaymentMethod = "Cod")" />
                            <label class="form-check-label" for="pm-cod">Thanh toán khi nhận hàng (COD)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pm-bank"
                                   checked="@(_order.PaymentMethod == "BankTransfer")" @onchange="@(() => _order.PaymentMethod = "BankTransfer")" />
                            <label class="form-check-label" for="pm-bank">Chuyển khoản ngân hàng (QR)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="pm-momo"
                                   checked="@(_order.PaymentMethod == "MoMo")" @onchange="@(() => _order.PaymentMethod = "MoMo")" />
                            <label class="form-check-label" for="pm-momo">Ví MoMo <span class="badge badge-warning">TEST</span></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Đơn hàng của bạn</div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tbody>
                            @foreach (var item in CartState.Items)
                            {
                                <tr @key="item.ProductId">
                                    <td>@item.ProductName <span class="text-muted">× @item.Quantity</span></td>
                                    <td class="text-right">@FormatPrice(item.LineTotal)</td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted">Tạm tính</td>
                                <td class="text-right text-muted">@FormatPrice(_subtotal)</td>
                            </tr>
                            @if (_discountAmount > 0)
                            {
                                <tr>
                                    <td class="text-success">Giảm giá (@_appliedCode)</td>
                                    <td class="text-right text-success">−@FormatPrice(_discountAmount)</td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted">
                                    Phí giao hàng
                                    @if (_fee > 0 && _shopSettings.FreeShipThreshold > 0)
                                    {
                                        <small class="d-block">Miễn phí cho đơn từ @FormatPrice(_shopSettings.FreeShipThreshold)</small>
                                    }
                                </td>
                                <td class="text-right @(_fee == 0 ? "text-success" : null)">
                                    @(_fee == 0 ? "Miễn phí" : FormatPrice(_fee))
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td><strong>Tổng cộng</strong></td>
                                <td class="text-right"><strong class="text-danger">@FormatPrice(_grandTotal)</strong></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="form-group">
                        <label>Mã giảm giá</label>
                        <div class="input-group">
                            <input class="form-control" @bind="_discountCodeInput" placeholder="Nhập mã (nếu có)"
                                   disabled="@_applyingDiscount" />
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" @onclick="ApplyDiscount" disabled="@_applyingDiscount">
                                    @(_applyingDiscount ? "Đang kiểm tra..." : "Áp dụng")
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_discountMessage))
                        {
                            <small class="@(_discountAmount > 0 ? "text-success" : "text-danger")">@_discountMessage</small>
                        }
                    </div>

                    <button class="btn btn-success btn-block btn-lg" @onclick="PlaceOrder" disabled="@(_submitting || _minOrderBlocked)">
                        @(_submitting ? "Đang xử lý..." : "Xác nhận đặt hàng")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CreateOrderModel _order = new CreateOrderModel();
    private PlacedOrderModel _placedOrder;
    private BankTransferInfoModel _bankInfo;
    private ShopSettingModel _shopSettings = new ShopSettingModel();
    private bool _submitting;
    private bool _markingTransferred;
    private bool _payingMoMo;
    private bool _minOrderBlocked;
    private string _error;

    // Per-field validation messages.
    private string _nameError;
    private string _phoneError;
    private string _emailError;
    private string _addressError;

    // Discount state.
    private string _discountCodeInput;
    private string _appliedCode;
    private decimal _discountAmount;
    private string _discountMessage;
    private bool _applyingDiscount;

    private string _transferMessage;
    private string _transferError;
    private string _momoError;

    private decimal _subtotal => CartState.TotalAmount;

    private decimal _fee
    {
        get
        {
            if (_shopSettings.DeliveryFee <= 0)
            {
                return 0;
            }

            var afterDiscount = _subtotal - _discountAmount;
            if (_shopSettings.FreeShipThreshold > 0 && afterDiscount >= _shopSettings.FreeShipThreshold)
            {
                return 0;
            }

            return _shopSettings.DeliveryFee;
        }
    }

    private decimal _grandTotal => Math.Max(0, _subtotal - _discountAmount + _fee);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shopSettings = await ShopSettingsService.GetAsync() ?? new ShopSettingModel();
        }
        catch (Exception)
        {
            _shopSettings = new ShopSettingModel();
        }

        RefreshMinOrderState();
        CartState.OnChange += OnCartChanged;
    }

    private void OnCartChanged()
    {
        RefreshMinOrderState();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshMinOrderState()
    {
        _minOrderBlocked = _shopSettings.MinOrderAmount > 0 && _subtotal < _shopSettings.MinOrderAmount;
    }

    /// <summary>VietQR image URL built from the shop's bank config + this order.</summary>
    private string QrUrl
    {
        get
        {
            if (_bankInfo == null || _placedOrder == null)
            {
                return string.Empty;
            }

            var template = string.IsNullOrWhiteSpace(_bankInfo.QrTemplate) || _bankInfo.QrTemplate == "xxx"
                ? "compact2"
                : _bankInfo.QrTemplate;
            var amount = (long)_placedOrder.TotalAmount;
            return $"https://img.vietqr.io/image/{_bankInfo.BankId}-{_bankInfo.AccountNumber}-{template}.png"
                + $"?amount={amount}&addInfo={Uri.EscapeDataString(_placedOrder.OrderNumber)}"
                + $"&accountName={Uri.EscapeDataString(_bankInfo.AccountName ?? string.Empty)}";
        }
    }

    private async Task ApplyDiscount()
    {
        _discountMessage = null;
        var code = (_discountCodeInput ?? "").Trim();
        if (string.IsNullOrEmpty(code))
        {
            _discountAmount = 0;
            _appliedCode = null;
            _discountMessage = "Vui lòng nhập mã giảm giá.";
            return;
        }

        _applyingDiscount = true;
        try
        {
            var result = await DiscountService.ValidateAsync(code, _subtotal);
            if (result.Valid)
            {
                _discountAmount = result.DiscountAmount;
                _appliedCode = code.ToUpperInvariant();
                _discountMessage = result.Message;
            }
            else
            {
                _discountAmount = 0;
                _appliedCode = null;
                _discountMessage = result.Message;
            }
        }
        catch (Exception)
        {
            _discountAmount = 0;
            _appliedCode = null;
            _discountMessage = "Không kiểm tra được mã giảm giá. Vui lòng thử lại.";
        }
        finally
        {
            _applyingDiscount = false;
            RefreshMinOrderState();
        }
    }

    private bool ValidateFields()
    {
        _nameError = string.IsNullOrWhiteSpace(_order.CustomerName) ? "Vui lòng nhập họ tên." : null;
        _phoneError = !IsValidPhone(_order.CustomerPhone) ? "Số điện thoại không đúng định dạng (VD: 0901234567)." : null;
        _emailError = !string.IsNullOrWhiteSpace(_order.CustomerEmail) && !IsValidEmail(_order.CustomerEmail)
            ? "Email không đúng định dạng. Bạn có thể để trống nếu không có email."
            : null;
        _addressError = string.IsNullOrWhiteSpace(_order.CustomerAddress) ? "Vui lòng nhập địa chỉ giao hàng." : null;

        return _nameError == null && _phoneError == null && _emailError == null && _addressError == null;
    }

    private async Task PlaceOrder()
    {
        _error = null;

        if (!ValidateFields())
        {
            _error = "Vui lòng kiểm tra lại các thông tin được đánh dấu.";
            return;
        }

        if (_minOrderBlocked)
        {
            _error = $"Đơn hàng tối thiểu {FormatPrice(_shopSettings.MinOrderAmount)}. Vui lòng thêm món vào giỏ.";
            return;
        }

        _submitting = true;
        try
        {
            _order.DiscountCode = _appliedCode;
            _order.Lines = CartState.Items
                .Select(x => new CreateOrderLineModel { ProductId = x.ProductId, Quantity = x.Quantity })
                .ToList();

            _placedOrder = await ShopService.CreateOrderAsync(_order);
            CartState.Clear();
            CartState.OnChange -= OnCartChanged;

            if (_placedOrder.PaymentMethod == "BankTransfer")
            {
                try
                {
                    _bankInfo = await ShopService.GetBankTransferInfoAsync();
                }
                catch (Exception)
                {
                    // Bank info is nice-to-have here; the track-order page
                    // shows the same info. Fall back to the placeholder box.
                    _bankInfo = new BankTransferInfoModel();
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message.Contains("tối thiểu") || ex.Message.Contains("Mã")
                ? ex.Message
                : "Đặt hàng thất bại. Vui lòng kiểm tra lại thông tin và thử lại.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task MarkTransferred()
    {
        _transferMessage = null;
        _transferError = null;
        _markingTransferred = true;
        try
        {
            var updated = await ShopService.MarkTransferredAsync(_placedOrder.Id, _placedOrder.CustomerPhone);
            _placedOrder.PaymentStatus = updated.PaymentStatus;
            _transferMessage = "Đã ghi nhận bạn đã chuyển khoản. Shop sẽ xác nhận thanh toán sớm.";
        }
        catch (Exception)
        {
            _transferError = "Không ghi nhận được. Vui lòng thử lại hoặc liên hệ shop.";
        }
        finally
        {
            _markingTransferred = false;
        }
    }

    private async Task PayWithMoMo()
    {
        _momoError = null;
        _payingMoMo = true;
        try
        {
            var result = await ShopService.CreateMoMoPaymentAsync(_placedOrder.Id);
            Navigation.NavigateTo(result.PayUrl);
        }
        catch (Exception)
        {
            _momoError = "Không tạo được thanh toán MoMo. Vui lòng thử lại.";
        }
        finally
        {
            _payingMoMo = false;
        }
    }

    private static string FieldClass(string error) => string.IsNullOrEmpty(error) ? null : "is-invalid";

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone)
        && System.Text.RegularExpressions.Regex.IsMatch(phone.Trim(), @"^(0)(3|5|7|8|9)\d{8}$");

    private static bool IsValidEmail(string email)
    {
        var at = email.IndexOf('@');
        if (at <= 0 || at != email.LastIndexOf('@'))
        {
            return false;
        }

        var dot = email.LastIndexOf('.');
        return dot > at + 1 && dot < email.Length - 1 && !email.Contains(" ");
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    public void Dispose()
    {
        CartState.OnChange -= OnCartChanged;
    }
}
