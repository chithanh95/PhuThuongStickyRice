@page "/track-order"
@using PhuThuongStickyRice.Blazor.Modules.Shop.Models
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@using PhuThuongStickyRice.Blazor.Modules.Admin.Services
@using Microsoft.JSInterop
@inject ShopService ShopService
@inject Wave2Service Wave2Service
@inject Wave4Service Wave4Service
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<h3>Tra cứu đơn hàng</h3>

<div class="card mb-3">
    <div class="card-body">
        <div class="form-row">
            <div class="col-md-4">
                <label>Mã đơn hàng</label>
                <input class="form-control" @bind="_orderNumber" placeholder="PX-20261014-0001" />
            </div>
            <div class="col-md-4">
                <label>Số điện thoại đặt hàng</label>
                <input class="form-control" @bind="_phone" placeholder="0901234567" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary" @onclick="Lookup" disabled="@_loading">
                    @(_loading ? "Đang tra cứu..." : "Tra cứu")
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mt-3 mb-0">@_error</div>
        }
    </div>
</div>

@if (_order != null)
{
    <div class="card mb-3">
        <div class="card-header">
            Đơn hàng <strong>@_order.OrderNumber</strong>
            <span class="float-right">@OrderStatusBadge(_order.Status)</span>
        </div>
        <div class="card-body">
            <p>
                Ngày đặt: <strong>@_order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong><br />
                Khách hàng: <strong>@_order.CustomerName</strong> — @_order.CustomerPhone<br />
                @if (!string.IsNullOrWhiteSpace(_order.RecipientName))
                {
                    <span>Người nhận: <strong>@_order.RecipientName</strong> — @_order.RecipientPhone<br /></span>
                }
                Địa chỉ: @_order.CustomerAddress
                @if (!string.IsNullOrWhiteSpace(_order.TaxCode))
                {
                    <br /><span>Hóa đơn VAT: @_order.CompanyName (MST: @_order.TaxCode)</span>
                }
                @if (_order.IsGift)
                {
                    <br /><span>🎁 Gói quà@(!string.IsNullOrWhiteSpace(_order.GiftMessage) ? $": {_order.GiftMessage}" : "")</span>
                }
            </p>
            @if (_loyalty != null)
            {
                <p>
                    <small>
                        ⭐ Bạn có <strong>@_loyalty.Points điểm</strong>
                        <span class="badge badge-info">Hạng @_loyalty.Tier</span>
                        @if (!string.IsNullOrWhiteSpace(_loyalty.ReferralCode))
                        {
                            <span class="ml-1">Mã giới thiệu: <strong>@_loyalty.ReferralCode</strong></span>
                        }
                    </small>
                </p>
                <div class="form-row align-items-end mb-2">
                    <div class="col-auto">
                        <label><small>Ngày sinh <small class="text-muted">(để nhận voucher sinh nhật)</small></small></label>
                        <input type="date" class="form-control form-control-sm" @bind="_birthdayInput" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SaveBirthday" disabled="@_savingBirthday">
                            @(_savingBirthday ? "Đang lưu..." : "Lưu ngày sinh")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_birthdayMessage))
                    {
                        <div class="col-12"><small class="text-success">@_birthdayMessage</small></div>
                    }
                </div>
            }
            @if (_order.RequiresDeposit && _order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "Unpaid")
            {
                <div class="alert alert-warning py-2">
                    <small>💰 Đơn này cần <strong>đặt cọc trước</strong> để shop xác nhận. Shop sẽ liên hệ với bạn.</small>
                </div>
            }
            @* Item 119: address book management from the track-order profile. *@
            <div class="card mt-2 mb-2">
                <div class="card-body py-2">
                    <small class="text-muted d-block mb-1">📒 <strong>Sổ địa chỉ</strong> của số @_order.CustomerPhone</small>
                    @if (_addresses == null)
                    {
                        <small><em>Đang tải...</em></small>
                    }
                    else if (_addresses.Count == 0)
                    {
                        <small class="text-muted">Chưa có địa chỉ nào được lưu.</small>
                    }
                    else
                    {
                        @foreach (var a in _addresses)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                                <small><strong>@a.Label:</strong> @a.Address</small>
                                <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteAddressAsync(a)">Xóa</button>
                            </div>
                        }
                    }
                    <div class="form-row mt-2">
                        <div class="col-4">
                            <input class="form-control form-control-sm" @bind="_newAddressLabel" placeholder="Nhãn (Nhà/Cty)" />
                        </div>
                        <div class="col-8">
                            <div class="input-group">
                                <input class="form-control form-control-sm" @bind="_newAddressText" placeholder="Địa chỉ mới..." />
                                <div class="input-group-append">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="AddAddressAsync" disabled="@_savingAddress">Lưu</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_addressBookMessage))
                    {
                        <small class="text-success">@_addressBookMessage</small>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Món</th><th class="text-right">Đơn giá</th><th class="text-right">SL</th><th class="text-right">Thành tiền</th></tr>
                    </thead>
                <tbody>
                    @foreach (var line in _order.Lines)
                    {
                        <tr>
                            <td>
                                @line.ProductName
                                @if (line.IsCombo)
                                {
                                    <span class="badge badge-warning ml-1">COMBO</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.SizeName))
                                {
                                    <br /><small class="text-muted">Size: @line.SizeName</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(line.ToppingNames))
                                {
                                    <br /><small class="text-muted">Ăn kèm: @line.ToppingNames</small>
                                }
                            </td>
                            <td class="text-right">@FormatPrice(line.UnitPrice)</td>
                            <td class="text-right">@line.Quantity</td>
                            <td class="text-right">@FormatPrice(line.LineTotal)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (_order.DiscountAmount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-success">Giảm giá @(!string.IsNullOrWhiteSpace(_order.DiscountCode) ? $"({_order.DiscountCode})" : "")</td>
                            <td class="text-right text-success">−@FormatPrice(_order.DiscountAmount)</td>
                        </tr>
                    }
                    @if (_order.TierDiscount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-success">Ưu đãi hạng thành viên</td>
                            <td class="text-right text-success">−@FormatPrice(_order.TierDiscount)</td>
                        </tr>
                    }
                    @if (_order.LoyaltyDiscount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-success">Đổi @_order.LoyaltyPointsRedeemed điểm</td>
                            <td class="text-right text-success">−@FormatPrice(_order.LoyaltyDiscount)</td>
                        </tr>
                    }
                    @if (_order.GiftFee > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-muted">🎁 Phí gói quà</td>
                            <td class="text-right text-muted">+@FormatPrice(_order.GiftFee)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3"><strong>Tổng cộng</strong></td>
                        <td class="text-right"><strong class="text-danger">@FormatPrice(_order.TotalAmount)</strong></td>
                    </tr>
                </tfoot>
            </table>
            </div>
            @if (!string.IsNullOrWhiteSpace(_order.Notes))
            {
                <p><em>Ghi chú: @_order.Notes</em></p>
            }

            @if (_order.Status == "Pending")
            {
                <div class="mb-3">
                    @if (!_editingLines)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="StartEditLines">✏️ Sửa đơn (số lượng)</button>
                        <button class="btn btn-outline-danger btn-sm ml-2" @onclick="CancelOrder" disabled="@_cancelling">
                            @(_cancelling ? "Đang hủy..." : "Hủy đơn")
                        </button>
                        @if (!string.IsNullOrEmpty(_cancelError))
                        {
                            <div class="alert alert-danger mt-2 mb-0">@_cancelError</div>
                        }
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-header py-2"><strong>Sửa số lượng</strong> <small class="text-muted">(0 = bỏ món)</small></div>
                            <div class="card-body py-2">
                                @foreach (var line in _order.Lines)
                                {
                                    <div class="form-row align-items-center mb-1">
                                        <div class="col-8"><small>@line.ProductName</small></div>
                                        <div class="col-4">
                                            <input type="number" class="form-control form-control-sm"
                                                   min="0" max="100" value="@_editQuantities[line.Id]"
                                                   @onchange="(e => _editQuantities[line.Id] = ParseQty(e.Value))" />
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_editError))
                                {
                                    <div class="alert alert-danger mt-2 mb-1">@_editError</div>
                                }
                                <button class="btn btn-success btn-sm mt-2" @onclick="SaveEditedLines" disabled="@_savingLines">
                                    @(_savingLines ? "Đang lưu..." : "Lưu thay đổi")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm mt-2 ml-2" @onclick="() => _editingLines = false">Bỏ qua</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_order.Status == "Completed")
            {
                <div class="card mb-3">
                    <div class="card-header py-2"><strong>Đánh giá đơn hàng</strong></div>
                    <div class="card-body py-2">
                        @if (_reviewSubmitted)
                        {
                            <div class="alert alert-success mb-0">Cảm ơn bạn đã đánh giá! ⭐</div>
                        }
                        else
                        {
                            <div class="mb-2">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    var s = star;
                                    <button type="button" class="btn btn-link p-0 mr-1"
                                            style="font-size: 28px; color: @(s <= _rating ? "#f6c453" : "#ccc"); text-decoration: none;"
                                            @onclick="() => _rating = s">★</button>
                                }
                            </div>
                            <textarea class="form-control form-control-sm mb-2" rows="2" @bind="_reviewComment"
                                      placeholder="Chia sẻ cảm nhận của bạn (tùy chọn)..."></textarea>
                            @if (!string.IsNullOrEmpty(_reviewError))
                            {
                                <div class="alert alert-danger py-1">@_reviewError</div>
                            }
                            <button class="btn btn-primary btn-sm" @onclick="SubmitReview" disabled="@(_submittingReview || _rating == 0)">
                                @(_submittingReview ? "Đang gửi..." : "Gửi đánh giá")
                            </button>
                        }
                    </div>
                </div>
            }
            <p>
                Phương thức thanh toán: <strong>@PaymentMethodLabel(_order.PaymentMethod)</strong><br />
                Trạng thái thanh toán: @PaymentStatusBadge(_order.PaymentStatus)<br />
                Hình thức nhận hàng: <strong>@(_order.FulfillmentMethod == "Pickup" ? "🏪 Tự đến lấy tại quán" : "🛵 Giao tận nơi")</strong>
            </p>

            @if (_order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "Unpaid")
            {
                <div class="card mb-3">
                    <div class="card-header">Chuyển khoản ngân hàng</div>
                    <div class="card-body">
                        @if (_bankInfo == null)
                        {
                            <p><em>Đang tải thông tin chuyển khoản...</em></p>
                        }
                        else if (!_bankInfo.IsConfigured)
                        {
                            <div class="alert alert-warning">
                                <strong>QR sẽ hiện khi shop cấu hình ngân hàng.</strong>
                                <p class="mb-0">Tạm thời bạn vui lòng chuyển khoản với nội dung: <strong>@_order.OrderNumber</strong>.</p>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-5 text-center">
                                    <img src="@QrUrl" alt="QR chuyển khoản" style="max-width: 260px; width: 100%;" />
                                </div>
                                <div class="col-md-7">
                                    <table class="table table-sm">
                                        <tr><td><strong>Ngân hàng</strong></td><td>@_bankInfo.BankName</td></tr>
                                        <tr><td><strong>Số tài khoản</strong></td><td><strong>@_bankInfo.AccountNumber</strong></td></tr>
                                        <tr><td><strong>Chủ tài khoản</strong></td><td>@_bankInfo.AccountName</td></tr>
                                        <tr><td><strong>Số tiền</strong></td><td><strong class="text-danger">@FormatPrice(_order.TotalAmount)</strong></td></tr>
                                        <tr><td><strong>Nội dung</strong></td><td><strong>@_order.OrderNumber</strong></td></tr>
                                    </table>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_transferMessage))
                        {
                            <div class="alert alert-success">@_transferMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(_transferError))
                        {
                            <div class="alert alert-danger">@_transferError</div>
                        }
                        <button class="btn btn-success" @onclick="MarkTransferred" disabled="@_markingTransferred">
                            @(_markingTransferred ? "Đang gửi..." : "Tôi đã chuyển khoản")
                        </button>
                        <button class="btn btn-outline-primary ml-2" @onclick="CopyPaymentLinkAsync" title="Sao chép link để thanh toán sau từ thiết bị khác">
                            🔗 Sao chép link thanh toán
                        </button>
                        @if (!string.IsNullOrEmpty(_copyMessage))
                        {
                            <div class="alert alert-success mt-2 mb-0">@_copyMessage</div>
                        }
                    </div>
                </div>
            }
            else if (_order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "PendingConfirmation")
            {
                <div class="alert alert-info">Đã ghi nhận bạn đã chuyển khoản. Shop đang xác nhận thanh toán — trang này tự cập nhật khi shop xác nhận.</div>
            }
            else if (_order.PaymentStatus == "Paid")
            {
                <div class="alert alert-success">Thanh toán thành công! Cảm ơn bạn.</div>
            }

            @if (_order.PaymentMethod == "MoMo" && (_order.PaymentStatus == "Unpaid" || _order.PaymentStatus == "Failed"))
            {
                @if (!string.IsNullOrEmpty(_momoError))
                {
                    <div class="alert alert-danger">@_momoError</div>
                }
                <button class="btn btn-primary" @onclick="PayWithMoMo" disabled="@_payingMoMo">
                    @(_payingMoMo ? "Đang xử lý..." : "Thanh toán MoMo (TEST)")
                </button>
            }
            else if (_order.PaymentMethod == "MoMo" && _order.PaymentStatus == "Failed")
            {
                <div class="alert alert-danger">Thanh toán MoMo thất bại.</div>
            }
        </div>
    </div>
}

@code {
    private string _orderNumber;
    private string _phone;
    private TrackedOrderModel _order;
    private BankTransferInfoModel _bankInfo;
    private bool _loading;
    private bool _markingTransferred;
    private bool _payingMoMo;
    private string _error;
    private string _transferMessage;
    private string _transferError;
    private string _momoError;
    private string _copyMessage;
    private System.Threading.Timer _pollTimer;

    // Loyalty profile.
    private LoyaltyAccountModel _loyalty;
    private DateTime? _birthdayInput;
    private bool _savingBirthday;
    private string _birthdayMessage;

    // Item 119: address book.
    private System.Collections.Generic.List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.AddressBookModel> _addresses;
    private string _newAddressLabel;
    private string _newAddressText;
    private bool _savingAddress;
    private string _addressBookMessage;

    // Customer self-service: cancel.
    private bool _cancelling;
    private string _cancelError;

    // Customer self-service: edit quantities.
    private bool _editingLines;
    private System.Collections.Generic.Dictionary<Guid, int> _editQuantities
        = new System.Collections.Generic.Dictionary<Guid, int>();
    private bool _savingLines;
    private string _editError;

    // Post-delivery survey.
    private int _rating;
    private string _reviewComment;
    private bool _submittingReview;
    private bool _reviewSubmitted;
    private string _reviewError;

    /// <summary>
    /// Copies the track-order URL with ?orderNumber= prefilled so the
    /// customer can pay later from any device (reusable payment link).
    /// </summary>
    private async Task CopyPaymentLinkAsync()
    {
        _copyMessage = null;
        if (_order == null)
        {
            return;
        }

        try
        {
            var link = $"{Navigation.BaseUri.TrimEnd('/')}/track-order"
                + $"?orderNumber={Uri.EscapeDataString(_order.OrderNumber)}";
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);
            _copyMessage = "Đã sao chép link thanh toán! Mở link này trên thiết bị khác để thanh toán sau.";
        }
        catch (Exception)
        {
            _copyMessage = "Không sao chép được. Vui lòng copy link trên thanh địa chỉ.";
        }
    }

    private string QrUrl
    {
        get
        {
            if (_bankInfo == null || _order == null)
            {
                return string.Empty;
            }

            var template = string.IsNullOrWhiteSpace(_bankInfo.QrTemplate) || _bankInfo.QrTemplate == "xxx"
                ? "compact2"
                : _bankInfo.QrTemplate;
            var amount = (long)_order.TotalAmount;
            return $"https://img.vietqr.io/image/{_bankInfo.BankId}-{_bankInfo.AccountNumber}-{template}.png"
                + $"?amount={amount}&addInfo={Uri.EscapeDataString(_order.OrderNumber)}"
                + $"&accountName={Uri.EscapeDataString(_bankInfo.AccountName ?? string.Empty)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var query = ParseQuery(Navigation.Uri);
        if (query.TryGetValue("orderNumber", out var orderNumber))
        {
            _orderNumber = orderNumber;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !string.IsNullOrWhiteSpace(_orderNumber))
        {
            return;
        }

        // Restore the last successful lookup so returning customers don't
        // have to retype the order number and phone.
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", TrackOrderStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var saved = System.Text.Json.JsonSerializer.Deserialize<TrackOrderMemory>(json);
                if (saved != null
                    && !string.IsNullOrWhiteSpace(saved.OrderNumber)
                    && !string.IsNullOrWhiteSpace(saved.Phone))
                {
                    _orderNumber = saved.OrderNumber;
                    _phone = saved.Phone;
                    await Lookup();
                    StateHasChanged();
                }
            }
        }
        catch (Exception)
        {
            // Best effort only.
        }
    }

    private async Task RememberLookupAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new TrackOrderMemory
            {
                OrderNumber = _orderNumber?.Trim(),
                Phone = _phone?.Trim()
            });
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", TrackOrderStorageKey, json);
        }
        catch (Exception)
        {
            // Best effort only.
        }
    }

    private sealed class TrackOrderMemory
    {
        public string OrderNumber { get; set; }

        public string Phone { get; set; }
    }

    private const string TrackOrderStorageKey = "phuthuong.track-order.v1";

    private async Task Lookup()
    {
        _error = null;
        _transferMessage = null;
        _transferError = null;
        _momoError = null;
        _copyMessage = null;
        _cancelError = null;
        _editError = null;
        _reviewError = null;
        _reviewSubmitted = false;
        _rating = 0;
        _reviewComment = null;
        _editingLines = false;
        _loyalty = null;
        _birthdayInput = null;
        _birthdayMessage = null;
        _order = null;
        _bankInfo = null;
        _addresses = null;
        _addressBookMessage = null;
        StopPolling();

        if (string.IsNullOrWhiteSpace(_orderNumber) || string.IsNullOrWhiteSpace(_phone))
        {
            _error = "Vui lòng nhập mã đơn hàng và số điện thoại.";
            return;
        }

        _loading = true;
        try
        {
            _order = await ShopService.TrackOrderAsync(_orderNumber.Trim(), _phone.Trim());
            await RememberLookupAsync();
            await AfterOrderLoadedAsync();
        }
        catch (Exception)
        {
            _error = "Không tìm thấy đơn hàng. Vui lòng kiểm tra mã đơn và số điện thoại.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AfterOrderLoadedAsync()
    {
        if (_order == null)
        {
            return;
        }

        if (_order.PaymentMethod == "BankTransfer" && _order.PaymentStatus == "Unpaid")
        {
            try
            {
                _bankInfo = await ShopService.GetBankTransferInfoAsync();
            }
            catch (Exception)
            {
                _bankInfo = new BankTransferInfoModel();
            }
        }

        // Poll for payment-status updates (e.g. admin confirms the transfer)
        // while the payment is still unsettled.
        if (_order.PaymentStatus == "Unpaid" || _order.PaymentStatus == "PendingConfirmation")
        {
            StartPolling();
        }

        // Loyalty profile for the order phone (points, tier, birthday).
        try
        {
            _loyalty = await Wave2Service.GetLoyaltyByPhoneAsync(_order.CustomerPhone);
            _birthdayInput = _loyalty?.DateOfBirth;
        }
        catch (Exception)
        {
            _loyalty = null;
        }

        // Item 119: address book for the order phone.
        await LoadAddressBookAsync();
    }

    /// <summary>Item 119: address book management in the profile section.</summary>
    private async Task LoadAddressBookAsync()
    {
        try
        {
            _addresses = await Wave4Service.GetAddressesAsync(_order?.CustomerPhone);
        }
        catch (Exception)
        {
            _addresses = new System.Collections.Generic.List<PhuThuongStickyRice.Blazor.Modules.Admin.Models.AddressBookModel>();
        }
    }

    private async Task AddAddressAsync()
    {
        _addressBookMessage = null;
        if (string.IsNullOrWhiteSpace(_newAddressLabel) || string.IsNullOrWhiteSpace(_newAddressText))
        {
            _addressBookMessage = "Vui lòng nhập nhãn và địa chỉ.";
            return;
        }

        _savingAddress = true;
        try
        {
            await Wave4Service.SaveAddressAsync(_order.CustomerPhone, _newAddressLabel.Trim(), _newAddressText.Trim());
            _newAddressLabel = null;
            _newAddressText = null;
            await LoadAddressBookAsync();
            _addressBookMessage = "Đã lưu địa chỉ.";
        }
        catch (Exception ex)
        {
            _addressBookMessage = "Không lưu được: " + ex.Message;
        }
        finally
        {
