    private void StartPolling()
    {
        StopPolling();
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                var fresh = await ShopService.TrackOrderAsync(_order.OrderNumber, _order.CustomerPhone);
                await InvokeAsync(() =>
                {
                    _order = fresh;
                    if (fresh.PaymentStatus != "Unpaid" && fresh.PaymentStatus != "PendingConfirmation")
                    {
                        StopPolling();
                    }

                    StateHasChanged();
                });
            }
            catch (Exception)
            {
                // Polling is best-effort; the manual lookup still works.
            }
        }, null, 5000, 5000);
    }

    private void StopPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

