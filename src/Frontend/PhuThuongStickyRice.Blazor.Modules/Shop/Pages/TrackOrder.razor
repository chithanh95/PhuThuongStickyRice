    private async Task CancelOrder()
    {
        _cancelError = null;
        if (_order == null)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Bạn chắc chắn muốn hủy đơn hàng {_order.OrderNumber}?");
        if (!confirmed)
        {
            return;
        }

        _cancelling = true;
        try
        {
            _order = await Wave2Service.CancelOrderByCustomerAsync(_order.OrderNumber, _order.CustomerPhone);
        }
        catch (Exception ex)
        {
            _cancelError = ex.Message.Contains("chờ xác nhận")
                ? ex.Message
                : "Không hủy được đơn hàng. Vui lòng thử lại.";
        }
        finally
        {
            _cancelling = false;
        }
    }

