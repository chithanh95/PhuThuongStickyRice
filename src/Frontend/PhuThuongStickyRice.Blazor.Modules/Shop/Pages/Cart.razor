@page "/cart"
@using PhuThuongStickyRice.Blazor.Modules.Shop.Services
@inject CartState CartState
@inject NavigationManager Navigation
@implements IDisposable

<h3>Giỏ hàng</h3>

@if (CartState.Items.Count == 0)
{
    <div class="alert alert-info">
        Giỏ hàng đang trống. <a href="/shop">Xem các món xôi</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th class="text-right">Đơn giá</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-right">Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in CartState.Items)
                {
                    <tr @key="item.ProductId">
                        <td>
                            <strong>@item.ProductName</strong><br />
                            <small class="text-muted">@item.ProductCode</small>
                        </td>
                        <td class="text-right">@FormatPrice(item.UnitPrice)</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQuantity(item, -1)">−</button>
                            <span class="mx-2">@item.Quantity</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQuantity(item, 1)">+</button>
                        </td>
                        <td class="text-right"><strong>@FormatPrice(item.LineTotal)</strong></td>
                        <td class="text-right">
                            <button class="btn btn-sm btn-danger" @onclick="() => CartState.Remove(item.ProductId)">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right"><strong>Tổng cộng:</strong></td>
                    <td class="text-right"><strong class="text-danger" style="font-size: 1.2rem;">@FormatPrice(CartState.TotalAmount)</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-between">
        <a class="btn btn-secondary" href="/shop">Tiếp tục mua</a>
        <button class="btn btn-success btn-lg" @onclick='() => Navigation.NavigateTo("/checkout")'>
            Đặt hàng (@CartState.TotalQuantity món)
        </button>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        CartState.OnChange += StateHasChanged;
    }

    private void ChangeQuantity(PhuThuongStickyRice.Blazor.Modules.Shop.Models.CartItemModel item, int delta)
    {
        CartState.UpdateQuantity(item.ProductId, item.Quantity + delta);
    }

    private static string FormatPrice(decimal price) => $"{price:N0} ₫";

    public void Dispose()
    {
        CartState.OnChange -= StateHasChanged;
    }
}
