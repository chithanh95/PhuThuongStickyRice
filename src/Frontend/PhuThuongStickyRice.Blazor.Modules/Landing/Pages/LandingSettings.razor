@page "/admin/landing"
@attribute [Authorize]
@using PhuThuongStickyRice.Blazor.Modules.Landing.Models
@using PhuThuongStickyRice.Blazor.Modules.Landing.Services
@inject LandingService LandingService

<h3>Cài đặt trang landing</h3>
<p class="text-muted">Nội dung bạn sửa ở đây sẽ hiển thị ngay trên trang chủ (landing page) của web.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_model == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="card mb-3">
        <div class="card-header">Phần mở đầu (Hero)</div>
        <div class="card-body">
            <div class="form-group">
                <label>Tên thương hiệu</label>
                <input class="form-control" @bind="_model.HeroTitle" />
            </div>
            <div class="form-group">
                <label>Câu khẩu hiệu (hiển thị trong khung oval)</label>
                <input class="form-control" @bind="_model.HeroTagline" />
            </div>
            <div class="form-group">
                <label>Chữ trên nút bấm</label>
                <input class="form-control" @bind="_model.HeroButtonText" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Câu chuyện làng nghề</div>
        <div class="card-body">
            <div class="form-group">
                <label>Tiêu đề</label>
                <input class="form-control" @bind="_model.StoryTitle" />
            </div>
            <div class="form-group">
                <label>Nội dung</label>
                <textarea class="form-control" rows="6" @bind="_model.StoryBody"></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Món ngon mỗi sáng</div>
        <div class="card-body">
            <div class="form-group">
                <label>Tiêu đề</label>
                <input class="form-control" @bind="_model.MenuTitle" />
            </div>
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Nhãn món 1</label>
                    <input class="form-control" @bind="_model.MenuLabel1" />
                </div>
                <div class="form-group col-md-4">
                    <label>Nhãn món 2</label>
                    <input class="form-control" @bind="_model.MenuLabel2" />
                </div>
                <div class="form-group col-md-4">
                    <label>Nhãn món 3</label>
                    <input class="form-control" @bind="_model.MenuLabel3" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Tin tức / chuyện nhà xôi</div>
        <div class="card-body">
            <div class="form-group">
                <label>Tiêu đề</label>
                <input class="form-control" @bind="_model.NewsTitle" />
            </div>
            @for (var i = 0; i < _news.Count; i++)
            {
                var index = i;
                <div class="border rounded p-3 mb-3">
                    <h6>Tin @(index + 1)</h6>
                    <div class="form-group">
                        <label>Tiêu đề tin</label>
                        <input class="form-control" @bind="_news[index].Title" />
                    </div>
                    <div class="form-group">
                        <label>Nội dung</label>
                        <textarea class="form-control" rows="3" @bind="_news[index].Body"></textarea>
                    </div>
                    <div class="form-group mb-0">
                        <label>Nguồn</label>
                        <input class="form-control" @bind="_news[index].Source" placeholder="VD: ShopeeFood, khách hàng..." />
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Chân trang & liên hệ</div>
        <div class="card-body">
            <div class="form-group">
                <label>Tiêu đề</label>
                <input class="form-control" @bind="_model.FooterTitle" />
            </div>
            <div class="form-group">
                <label>Địa chỉ</label>
                <input class="form-control" @bind="_model.ContactAddress" />
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Số điện thoại</label>
                    <input class="form-control" @bind="_model.ContactPhone" />
                </div>
                <div class="form-group col-md-6">
                    <label>Email</label>
                    <input class="form-control" @bind="_model.ContactEmail" />
                </div>
            </div>
            <div class="form-group">
                <label>Chữ trên nút đặt món</label>
                <input class="form-control" @bind="_model.FooterButtonText" />
            </div>
        </div>
    </div>

    <button class="btn btn-primary btn-lg" @onclick="SaveAsync" disabled="@_saving">
        @(_saving ? "Đang lưu..." : "Lưu thay đổi")
    </button>
    <a class="btn btn-outline-secondary btn-lg ml-2" href="/" target="_blank">Xem trang chủ</a>
}

@code {
    private LandingContentModel _model;
    private List<LandingNewsItemModel> _news = new List<LandingNewsItemModel>();
    private bool _saving;
    private string _error;
    private string _success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await LandingService.GetContentAsync() ?? new LandingContentModel();
            _news = _model.NewsItems ?? new List<LandingNewsItemModel>();
            while (_news.Count < 3)
            {
                _news.Add(new LandingNewsItemModel());
            }

            _model.NewsItems = _news;
        }
        catch (Exception)
        {
            _error = "Không tải được nội dung landing. Vui lòng thử lại.";
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _success = null;
        _saving = true;
        try
        {
            _model.NewsItems = _news
                .Where(x => !string.IsNullOrWhiteSpace(x.Title) || !string.IsNullOrWhiteSpace(x.Body))
                .ToList();
            await LandingService.UpdateContentAsync(_model);
            _success = "Đã lưu. Mở trang chủ để xem thay đổi.";
        }
        catch (Exception)
        {
            _error = "Lưu thất bại. Vui lòng thử lại.";
        }
        finally
        {
            _saving = false;
        }
    }
}
